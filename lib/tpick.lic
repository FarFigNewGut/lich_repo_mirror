  # =============================================================================
  # Show messages in game window.
  # =============================================================================
  def self.message(message)
    border = "#" * 40
    _respond <<~MSG
      #{monsterbold_start}

      #{border}
      #{border}
      #{border}
      #{message}
      #{border}
      #{border}
      #{border}

      #{monsterbold_end}
    MSG
  end

  # =============================================================================
  # Reads character settings from file using a file lock.
  # =============================================================================
  def self.load_the_data
    return unless File.exist?(@save_file)

    File.open(@save_file, File::RDWR | File::CREAT) do |file|
      file.flock(File::LOCK_EX)

      raw_content = file.read

      if raw_content.to_s.strip.empty?
        @all_load_data = {}
        @load_data = {}
      else
        @all_load_data  = JSON.parse(raw_content)
        @all_characters = @all_load_data.keys.sort
        @load_data      = @all_load_data[Char.name]

        @load_data&.delete_if { |_key, value| value.is_a?(String) && value.empty? }
      end

      @all_load_data
    end
  rescue JSON::ParserError
    message("Error: Save file configuration is corrupted. Rebuilding profile.")
    {}
  rescue StandardError => e
    message("Error message from ;#{@script_name}: #{e.message}")
  end

  # =============================================================================
  # Reads character stats and lifetime data using a lock.
  # =============================================================================
  def self.load_the_stats
    return unless File.exist?(@save_stats_file)

    File.open(@save_stats_file, File::RDWR | File::CREAT) do |file|
      file.flock(File::LOCK_EX)

      raw_content = file.read
      
      if raw_content.to_s.strip.empty?
        $tpick_stats_data = {}
      else
        all_stats = JSON.parse(raw_content)
        $tpick_stats_data = all_stats[Char.name]
      end
    end

    $tpick_stats_data
  rescue JSON::ParserError
    message("Error: Stats file is corrupted. Resetting data tracking metrics.")
    nil
  rescue StandardError => e
    message("Error message from ;#{@script_name}: #{e.message}")
  end

  load_the_data
  
  # =============================================================================
  # Saves character settings to the file.
  # =============================================================================
  def self.save_settings(save_type)
    File.open(@save_file, File::RDWR | File::CREAT) do |file|
      file.flock(File::LOCK_EX)

      raw_content = file.read
      save_data   = raw_content.empty? ? {} : JSON.parse(raw_content)
      
      character_data = save_data[Char.name] ||= {}

      if save_type == "All"
        @needed_values.each { |name, value| character_data[name] = value unless ["403", "404"].include?(name) }
        @spin_buttons.each { |name, button| character_data[name] = button.value.round(1) }

        @entries.each do |name, entry|
          cleaned_text = entry.text
          if LOCKPICK_TIERS.include?(name) || @repair_names.include?(name) || name =~ /^(Remove Armor|Gnomish Bracer)$/
            cleaned_text = cleaned_text.gsub(/^(a |an )/i, "")
          end
          character_data[name] = cleaned_text
        end

        @menus.each { |name, menu| character_data[name] = menu.active_text }
        @check_boxes.each { |name, box| character_data[name] = box.active? ? "Yes" : "No" }

        # Apply profession-specific baseline resetting mechanics
        case @reset_profession
        when "Rogue"
          @rogue_only_checkboxes.each { |name| character_data[name] = @defaults[name].dup }
          @rogue_only_entries.each    { |name| character_data[name] = "" }

          character_data["Lock Buffer"]     = @defaults["Lock Buffer"].dup
          character_data["Calibrate Count"] = @defaults["Calibrate Count"].dup
        when "Warrior"
          character_data["Bashing Weapon"]  = ""
        when "Bard"
          character_data["Use Loresinging"] = @defaults["Use Loresinging"].dup
        end

        # Audit learned spell systems and reset specific triggers
        # This handles BOTH an individual profession reset or a targeted "Spells" reset
        if @reset_profession
          @all_spells.each do |name|
            spell_number = name.match(/(\d+)/)[1].to_i

            # Reset the spell toggle if the user triggered a "Spells" audit failure,
            # or if the spell is simply not known to their active character.
            if @reset_profession == "Spells" || (!Spell[spell_number].known? && character_data[name] == "Yes")
              character_data[name] = @defaults[name].dup
            end
          end

          # Rogues are skipped here because Rogues also
          # use 403 and 404 settings for Lock Mastery Focus
          if @reset_profession == "Spells" || (!Spell[403].known? && Stats.prof != "Rogue")
            @settings_for_403.each { |name| character_data[name] = @defaults[name].dup }
          end

          if @reset_profession == "Spells" || (!Spell[404].known? && Stats.prof != "Rogue")
            @settings_for_404.each { |name| character_data[name] = @defaults[name].dup }
          end
        end
        
      elsif save_type == "Menu Only"
        character_data["Picking Options"] = @non_settings_menus["Picking Options"].active_text
        character_data["Picking Mode"]    = @non_settings_menus["Picking Mode"].active_text
        character_data["Tip Amount"]      = @spin_buttons["Tip Amount"].value
        character_data["Tip Percent"]     = @check_boxes["Tip Percent"].active? ? "Yes" : "No"
      end

      UserVars.tpick = nil if UserVars.tpick

      file.rewind
      file.write(JSON.pretty_generate(save_data))
      file.flush
      file.truncate(file.pos)

      message(";#{@script_name}: Data saved.") if save_type == "All"
    end
  rescue StandardError => e
    message("Save error from ;#{@script_name}: #{e.message}")
  end
  
  def self.download_needed_image(image_name)
	url = "https://raw.githubusercontent.com/Lord-Dreaven/tpick-images/main/#{image_name.gsub(' ', '%20')}"

    filepath = File.join(@images_folder, image_name)
    full_image_path = File.expand_path(@images_folder)
    @full_image_path_and_name = File.expand_path(filepath)
    unless File.exist?(filepath)

      if @downloading_warning.nil?
        respond "\n\nSome images are missing, downloading them now.\n" \
                "These images only need to be downloaded once so you shouldn't need to download them again.\n\n"
      end
	  
      puts "Downloading #{image_name} from #{url}"
      File.write(filepath, URI.open(url).read, mode: "wb")
      puts "Image saved as #{@full_image_path_and_name}"
      @downloading_warning = true
    end
  end

  @show_images = true if @load_data["Show Images"] == "Yes"

  if @show_images
    @downloading_warning = nil
    FileUtils.mkdir_p(@images_folder)
	
	@all_images.each do |image_name|
	  download_needed_image("#{image_name}.jpg")
	end
  end
  
  # =============================================================================
  # Saves character stats to the file.
  # =============================================================================
  def self.save_the_stats
    File.open(@save_stats_file, File::RDWR | File::CREAT) do |file|
      file.flock(File::LOCK_EX)

      raw_content = file.read
      save_data   = raw_content.empty? ? {} : JSON.parse(raw_content)

      save_data[Char.name] = $tpick_stats_data

      file.rewind
      file.write(JSON.pretty_generate(save_data))
      file.flush
      file.truncate(file.pos)
    end
  rescue StandardError => e
    message("Stats save error from ;#{@script_name}: #{e.message}")
  end

  # =============================================================================
  # Checks to see if a character has changed their profession
  # or unlearned spells. If these changes causes a conflict in
  # settings then reset those settings.
  # =============================================================================
  if Stats.prof != "Rogue"
    rogue_setting_changed =
      @rogue_only_checkboxes.any? { |name| @load_data[name] && @load_data[name] != @defaults[name] } ||
      @rogue_only_entries.any?    { |name| @load_data[name].to_s.strip.empty? == false } ||
      (@load_data["Lock Buffer"]     && @load_data["Lock Buffer"].to_i != @defaults["Lock Buffer"].to_i) ||
      (@load_data["Calibrate Count"] && @load_data["Calibrate Count"].to_i != @defaults["Calibrate Count"].to_i)

    @reset_profession ||= "Rogue" if rogue_setting_changed
  end

  if Stats.prof != "Warrior"
    @reset_profession ||= "Warrior" if @load_data["Bashing Weapon"].to_s.strip.empty? == false
  end

  if Stats.prof != "Bard"
    @reset_profession ||= "Bard" if @load_data["Use Loresinging"] && @load_data["Use Loresinging"] != @defaults["Use Loresinging"]
  end

  @all_spells.each do |name|
    spell_number = name.match(/(\d+)/)[1].to_i

    if !Spell[spell_number].known? && @load_data[name] == "Yes"
      @reset_profession ||= "Spells"
      break
    end
  end

  # =============================================================================
  # Rogues are skipped here because Rogues also
  # use 403 and 404 settings for Lock Mastery Focus.
  # =============================================================================
  if Stats.prof != "Rogue"
    if !Spell[403].known? && @settings_for_403.any? { |name| @load_data[name] && @load_data[name] != @defaults[name] }
      @reset_profession = "Spells"
    end
    
    if !Spell[404].known? && @settings_for_404.any? { |name| @load_data[name] && @load_data[name] != @defaults[name] }
      @reset_profession = "Spells"
    end
  end

  if @reset_profession
    save_settings("All")

    if @reset_profession == "Spells"
      message(
        "It looks like you unlearned some spells. Some or all of your spell settings " \
        "have been set to their default settings. You will need to restart the script. " \
        "You shouldn't see this error message again unless you unlearn spells again."
      )
    else
      message(
        "It looks like you changed your profession from #{@reset_profession} to #{Stats.prof}. " \
        "All of your #{@reset_profession}-only settings have been set to their default settings. " \
        "You will need to restart the script. You shouldn't see this error message again " \
        "unless you change your profession again."
      )
    end

    exit
  end

  # =============================================================================
  # Load default values if they are missing from saved character settings.
  # =============================================================================
  @defaults.each do |setting_name, value|
    loaded_value = @load_data[setting_name]

    @needed_values[setting_name] = if value.is_a?(Integer)
                                     loaded_value ? loaded_value.to_i : value
                                   else
                                     loaded_value || value
                                   end
  end
  
  def self.set_picking_flags(command_array)
    $tpick_vars ||= {}

    cmds = Array(command_array).flatten.compact.map { |v| v.to_s.strip.downcase }.reject(&:empty?)
    return if cmds.empty?

    has_arg = proc { |pattern| cmds.any? { |v| v.include?(pattern) } }
  
    $tpick_vars["Open Plinites"]     = true if has_arg.call("plin")
    $tpick_vars["Bash Open Boxes"]   = true if has_arg.call("bash")
    $tpick_vars["Disarm Only"]       = true if has_arg.call("disarm")
    $tpick_vars["Relock Boxes"]      = true if has_arg.call("relock")
    $tpick_vars["Always Use Wedge"]  = true if has_arg.call("wedge")
    $tpick_vars["Ground Loot"]       = true if has_arg.call("loot")
    $tpick_vars["Pop Boxes"]         = true if has_arg.call("pop")
    $tpick_vars["Drop Off Boxes"]    = true if has_arg.call("drop")
    $tpick_vars["Pick Up Boxes"]     = true if has_arg.call("pickup") || has_arg.call("return")
    $tpick_vars["Tip Is A Percent"]  = true if has_arg.call("percent") || has_arg.call("%")
    $tpick_vars["Start With Copper"] = true if cmds.include?("c")
    $tpick_vars["Always Use Vaalin"] = true if cmds.include?("v")

    cmds.each { |v| $tpick_vars["Tip Being Offered"] = v.to_i if v =~ /\d+/ }

    if has_arg.call("ground")
      $tpick_vars["Picking Mode"] = "ground"
    elsif has_arg.call("other")
      $tpick_vars["Picking Mode"] = "other"
    elsif has_arg.call("worker") || has_arg.call("pool")
      $tpick_vars["Picking Mode"] = "worker"
    elsif has_arg.call("solo")
      $tpick_vars["Picking Mode"] = "solo"
    end

    if has_arg.call("return") || has_arg.call("pickup") || has_arg.call("drop")
      $tpick_vars["Picking Mode"] = true
    end
  end

  # =============================================================================
  # Migrates legacy variables into the new profile framework.
  # =============================================================================
  def self.import_settings
    string_mappings = {
      "Lockpick Container"          => "lockpick_container",
      "Broken Lockpick Container"   => "broken_lockpick_container",
      "Wedge Container"             => "wedge_container",
      "Calipers Container"          => "calipers_container",
      "Scale Weapon Container"      => "scale_weapon_container",
      "Locksmith's Container"       => "locksmiths_container",
      "Other Containers"            => "all_other_containers",
      "Auto Deposit Silvers"        => "auto_deposit_silvers",
      "Bashing Weapon"              => "bashing_weapon",
      "Scale Trap Weapon"           => "scale_trap_weapon",
      "Remove Armor"                => "remove_armor",
      "Lock Pick Enhancement (403)" => "always_use_403",
      "Disarm Enhancement (404)"    => "always_use_404",
      "Ready"                       => "ready",
      "Can't Open Box"              => "cant_open_box",
      "Scarab Found"                => "scarab_found",
      "Scarab Safe"                 => "scarab_safe",
      "Rest When Fried"             => "pool_picking_rest_when_fried",
      "Picks On Level"              => "picks_to_use_based_on_critter_level",
      ";rogues Lockpick"            => "lockpick_to_use_for_rogues_tasks",
      "Detrimental"                 => "detrimental",
      "Ineffectual"                 => "ineffectual",
      "Copper"                      => "copper",
      "Steel"                       => "steel",
      "Gold"                        => "gold",
      "Silver"                      => "silver",
      "Mithril"                     => "mithril",
      "Ora"                         => "ora",
      "Glaes"                       => "glaes",
      "Laje"                        => "laje",
      "Vultite"                     => "vultite",
      "Mein"                        => "mein",
      "Rolaren"                     => "rolaren",
      "Accurate"                    => "accurate",
      "Veniom"                      => "veniom",
      "Invar"                       => "invar",
      "Alum"                        => "alum",
      "Golvern"                     => "golvern",
      "Kelyn"                       => "kelyn",
      "Vaalin"                      => "vaalin"
    }
    
    string_mappings.each do |new_key, old_key|
      if UserVars.tpick[old_key].to_s.strip.empty? == false
        @needed_values[new_key] = UserVars.tpick[old_key]
      end
    end

    integer_mappings = {
      "Max Lock"          => "max_lock",
      "Max Lock Roll"     => "max_lock_roll",
      "Trap Roll"         => "trap_roll",
      "Trap Check Count"  => "number_of_times_to_check_for_traps",
      "Lock Roll"         => "lock_roll",
      "Vaalin Lock Roll"  => "vaalin_lock_roll",
      "Number Of 416 Casts" => "number_of_416_casts",
      "Max Level"         => "max_critter_level",
      "Use 403 On Level"  => "use_403_based_on_critter_level",
      "Use 404 On Level"  => "use_404_based_on_critter_level",
      "Lock Buffer"       => "lock_buffer",
      "Percent Mana To Keep" => "percent_mana_to_keep"
    }
    
    integer_mappings.each do |new_key, old_key|
      if UserVars.tpick[old_key].to_s.strip.empty? == false
        @needed_values[new_key] = UserVars.tpick[old_key].to_i
      end
    end

    boolean_mappings = {
      "Trash Boxes"                => "trash_boxes",
      "Auto Bundle Vials"          => "auto_bundle_vials",
      "Auto Repair Bent Lockpicks" => "auto_repair_bent_lockpicks",
      "Keep Trying"                => "keep_trying_if_within_abilities",
      "Run Silently"               => "run_silently",
      "Use Monster Bold"           => "use_monster_bold",
      "Don't Show Commands"        => "do_not_show_commands",
      "Use Lmaster Focus"          => "use_lmaster_focus",
      "Light (205)"                => "always_use_205",
      "Presence (402)"             => "always_use_402",
      "Disarm (408)"               => "always_use_408",
      "Celerity (506)"             => "always_use_506",
      "Rapid Fire (515)"           => "always_use_515",
      "Self Control (613)"         => "always_use_613",
      "Song of Luck (1006)"        => "always_use_1006",
      "Song of Tonis (1035)"       => "always_use_1035",
      "Use Vaalin When Fried"      => "use_vaalin_when_fried",
      "Phase (704)"                => "always_use_704",
      "Only Disarm Safe"           => "only_disarm_safe",
      "Pick Enruned"               => "pick_enruned_and_mithril"
    }
    
    boolean_mappings.each do |new_key, old_key|
      @needed_values[new_key] = "Yes" if UserVars.tpick[old_key] =~ /yes/i
    end

    if UserVars.tpick["trick"].to_s.strip.empty? == false
      @needed_values["Trick"] = UserVars.tpick["trick"].downcase
    end
    
    if UserVars.tpick["always_use_407"].to_s.strip.empty? == false
      settings_407 = UserVars.tpick["always_use_407"].split(",")
      @needed_values["Unlock (407)"]      = settings_407[0].to_s.capitalize
      @needed_values["Unlock (407)"]      = "Never" if @needed_values["Unlock (407)"] =~ /no/i
      @needed_values["Unlock (407) Mana"] = settings_407[1].to_i
    end

    mind_state_map = {
      100 => "Must Rest (100%)",
      90  => "Numbed (90%)",
      75  => "Becoming Numbed (75%)",
      62  => "Muddled (62%)",
      50  => "Clear (50%)",
      25  => "Fresh And Clear (25%)",
      0   => "Clear As A Bell (0%)"
    }
    
    @needed_values["Rest At Percent"] = mind_state_map[UserVars.tpick["rest_percent"].to_i] || "Never"
    @needed_values["Pick At Percent"] = mind_state_map[UserVars.tpick["pick_percent"].to_i] || "Always"

    if UserVars.tpick["gnomish_bracer"].to_s.strip.empty? == false
      gnome_bracer = UserVars.tpick["gnomish_bracer"].split(",")
      @needed_values["Gnomish Bracer"]  = gnome_bracer[0]
      @needed_values["Bracer Tier 2"]   = "Yes" if UserVars.tpick["gnomish_bracer"] =~ /2|3/
      @needed_values["Bracer Override"] = "Yes" if UserVars.tpick["gnomish_bracer"] =~ /override/
    end
    
    if UserVars.tpick["calibrate"] =~ /yes/i
      @needed_values["Calibrate On Startup"] = "Yes"
    elsif UserVars.tpick["calibrate"] =~ /never/i
      @needed_values["Use Calipers"]         = "No"
      @needed_values["Use Loresinging"]      = "No"
    end
    
    if UserVars.tpick["calibratecount"] =~ /auto/i
      cal_count = UserVars.tpick["calibratecount"].split(" ")
      @needed_values["Calibrate Auto"]  = "Yes"
      @needed_values["Calibrate Count"] = cal_count[1].to_i
    elsif UserVars.tpick["calibratecount"].to_s.strip.empty? == false
      @needed_values["Calibrate Count"] = UserVars.tpick["calibratecount"].to_i
    end

    save_settings("All")
    create_settings_window
  end
  
  # =============================================================================
  # For Traps window: Loads needed image from cache if it already exists there.
  # =============================================================================
  def self.get_image_from_cache(image_name, type)
    image_widget = @window_assets[type]["ImageWidget"]
	current_visible = @window_assets[type]["CurrentVisible"]
	
    if @image_cache.key?(image_name)
      if @image_cache[image_name]
        image_widget.set_pixbuf(@image_cache[image_name])
        image_widget.queue_resize
        @windows[type].show_all
        current_visible = image_name
        return true
      else
        image_widget.clear
        current_visible = nil
        return true
      end
    end
    false
  end
  
  # =============================================================================
  # Updates the image in the Traps window with full caching.
  # =============================================================================
  def self.update_display_image(image_name, type)
    return unless @show_images
    image_widget = @window_assets[type]["ImageWidget"]
	current_visible = @window_assets[type]["CurrentVisible"]
	
    return unless @windows[type] && image_widget

    @image_cache          ||= {}

    return if current_visible == image_name
    return if get_image_from_cache(image_name, type)
	
    image_path = File.join(@images_folder, "#{image_name}.jpg")

    if !File.exist?(image_path)
      fallback_name = "No Trap Image Found"
 
      @image_cache[image_name] = @image_cache[fallback_name] if @image_cache.key?(fallback_name)

      return if get_image_from_cache(fallback_name, type)

      image_name = fallback_name
      image_path = File.join(@images_folder, "#{fallback_name}.jpg")
    end

    if File.exist?(image_path)
      begin
        pixbuf = GdkPixbuf::Pixbuf.new(file: image_path, width: 220, height: 188)
        @image_cache[image_name] = pixbuf

        image_widget.set_pixbuf(pixbuf)
        image_widget.queue_resize
        @windows[type].show_all
        current_visible = image_name
      rescue => e
        tpick_silent(true, "Error loading trap visual: #{e.message}")
        @image_cache[image_name] = nil
        image_widget.clear
        current_visible = nil
      end
    else
      @image_cache[image_name] = nil
      image_widget.clear
      current_visible = nil
    end
  end
  
  # =============================================================================
  # Update the text for the Trap image.
  # =============================================================================
  def self.update_window_label_text(new_text, type, loc)
    return unless @show_images
	
    case loc.downcase
	when "top"
      label_widget = @window_assets[type]["TopLabel"]
	when "bottom"
	  label_widget = @window_assets[type]["BottomLabel"]
	end
	
    return unless label_widget
    updated_markup = TpickMain.format_display_label_style(new_text)

    Gtk.queue do
      label_widget.set_markup(updated_markup)
    end
  end

  # =============================================================================
  # Reads data from a selected character profile and
  # populates them directly into the settings in the window.
  # =============================================================================
  def self.load_profile
    person = @non_settings_menus["Profiles"].active_text
    return unless person

    profile_data = @all_load_data[person]
    return unless profile_data

    @entries.each do |name, entry|
      entry.text = profile_data[name].to_s
    end

    @spin_buttons.each do |name, button|
      button.value = profile_data[name].to_f if profile_data[name]
    end

    @check_boxes.each do |name, checkbox|
      checkbox.active = (profile_data[name] == "Yes")
    end

    message(
      ";#{@script_name}: #{person} settings have been loaded. #{Char.name} saved settings " \
      "won't be changed until you click 'Save', so if you want to revert these changes " \
      "either load #{Char.name}'s profile or restart the script."
    )
  end

  # =============================================================================
  # Loads default values to the settings window.
  # =============================================================================
  def self.load_defaults
    @entries.each do |name, entry|
      entry.text = @defaults[name].to_s
    end

    @spin_buttons.each do |name, button|
      button.value = @defaults[name].to_f if @defaults[name]
    end

    @check_boxes.each do |name, checkbox|
      checkbox.active = (@defaults[name] == "Yes")
    end

    message(
      ";#{@script_name}: Default settings have been loaded. #{Char.name}'s saved settings " \
      "won't be changed until you click 'Save', so if you want to revert these changes " \
      "either load #{Char.name}'s profile or restart the script."
    )
  end
  
  # =============================================================================
  # Searches through menu data tree to find a literal string match.
  # If no match is found it sets the menu to index 0.
  # =============================================================================
  def self.match_menu_item(menu, item_needed)
    item_found = false
    
    menu.model.each do |_model, _path, iter|
      if item_needed == menu.model.get_value(iter, 0)
        menu.set_active_iter(iter)
        item_found = true
        break
      end
    end

    menu.set_active(0) unless item_found
  end
  
  # =============================================================================
  # Create a scrollable text view widget.
  # =============================================================================
  def self.create_text_view(name)
    @all_textviews[name] = Gtk::TextView.new
    @all_buffers[name]   = @all_textviews[name].buffer

    @all_textviews[name].editable  = false
    @all_textviews[name].wrap_mode = :word

    @scrolled_windows[name] = Gtk::ScrolledWindow.new
    @scrolled_windows[name].set_policy(:automatic, :automatic)
    @scrolled_windows[name].add(@all_textviews[name])
  end

  # =============================================================================
  # Creates and shows an initial greeting window.
  # Adjusts text based on whether the player is new to ;tpick
  # or a returning player and migrating legacy variables.
  # =============================================================================
  def self.create_welcome_window
    width  = 500
    height = 300
    
    @windows["Welcome"] = Gtk::Window.new(:toplevel)
	@windows["Welcome"].set_name("tpick_window")
	
	# =============================================================================
	# Custom Welcome graphics headerbar.
	# =============================================================================
    welcome_titlebar = Gtk::HeaderBar.new
    welcome_titlebar.set_show_close_button(true)

    welcome_label = Gtk::Label.new(" WELCOME TO TPICK! ")
    welcome_titlebar.set_custom_title(welcome_label)

    @windows["Welcome"].set_titlebar(welcome_titlebar)
    # =============================================================================
	
    @windows["Welcome"].set_keep_above(true)
    @windows["Welcome"].set_title("Welcome - #{Char.name}")
    @windows["Welcome"].resize(width, height)

    create_notebook("Welcome")
    
    all_tabs = ["Welcome"]
    all_tabs.each do |name|
      create_text_view(name)
      
      if name == "Welcome"
        if !File.exist?(@save_file)
          # First-time user greeting
          text = <<~TEXT
            Welcome to ;tpick! The script for all of your picking needs!
            
            This script has a lot of settings and features to customize your picking experience.
            
            Hover your mouse over anything in the settings window for more information on that setting.
            
            You can close this window when you're ready, but be sure to go through each tab at the top of the 'Settings' window and go over each setting.
            
            Only settings in red are required to be filled out to get started, but it's a good idea to read each setting.
            
            When you're all finished filling out the settings be sure to click the 'Save' button on the main tab.
          TEXT
        else
          # Returning user update message
          text = <<~TEXT
            A lot has changed since you last used this script!
            
            Most importantly is your settings are no longer saved to your ;vars, instead they are saved to a file in your Lich folder named 'Tpick Settings.'
            
            Also the settings window has changed and now requires you to click the 'Save' button to save your settings.
            
            You can now hover your mouse over every setting to see more information about that setting.
            
            Your old settings should have been properly moved over to your new settings, but go through each tab on the settings page and be sure all of your settings are filled our properly.
          TEXT
        end
      end
      
      @all_buffers[name].text = text
      @all_notebooks["Welcome"].append_page(@scrolled_windows[name], Gtk::Label.new(name))
    end

    @windows["Welcome"].signal_connect("destroy") do
      @windows["Welcome"].close
      @windows["Welcome"] = nil
    end

    @windows["Welcome"].add(@all_notebooks["Welcome"])
    @windows["Welcome"].show_all
  end

  # =============================================================================
  # Updates all stats shown in the Information window.
  # =============================================================================
  def self.set_stat_info
    stats_info = {}

    @stat_names.each do |name| 
      next if name =~ /^(Session Time Spent Picking|Session Boxes Picked|Loot Session)$/
      if $tpick_stats_data[name].is_a?(Hash)
        stats_info[name] = $tpick_stats_data[name].dup
      else
        stats_info[name] = $tpick_stats_data[name].to_i
      end
    end

    pool_picking_baseline = $tpick_stats_data["Pool Time Spent Picking"].to_i
    stats_info["Pool Time Spent Picking"]   = pool_picking_baseline - stats_info["Pool Time Spent Waiting"].to_i
    stats_info["Total Boxes Picked"]       = stats_info["Pool Boxes Picked"].to_i + stats_info["Non-Pool Boxes Picked"].to_i
    stats_info["Total Time Spent Picking"] = stats_info["Pool Time Spent Picking"].to_i + stats_info["Non-Pool Time Spent Picking"].to_i
    stats_info["Total Traps"]              = @trap_names_all.sum { |trap| stats_info[trap].to_i }

    @all_stats.each do |tab_name, names|
      if !@all_textviews.key?(tab_name)
        create_text_view(tab_name)
        tab_header_map = { "Loot Total" => "Loot", "Loot Session" => "Session" }
        display_title     = tab_header_map[tab_name] || tab_name
        @labels[tab_name] = Gtk::Label.new(display_title)

        if ["Loot Total", "Loot Session"].include?(tab_name)
          @all_notebooks["Stats"].append_page(@scrolled_windows[tab_name], @labels[tab_name])
        else
          @all_notebooks["Lockpicking"].append_page(@scrolled_windows[tab_name], @labels[tab_name])
        end

        @scrolled_windows[tab_name].show_all
      end
    end

    Gtk.queue do
      @all_stats.each do |tab_name, names|
        all_names    = []
        needed_stats = {}
        
        names.each do |name|
          if tab_name == "Loot Session"
            needed_stats[name] = (name == "Loot Session") ? $tpick_session_data["Loot Session"] : $tpick_session_data[name]
          else
            needed_stats[name] = stats_info[name]
          end
          if name =~ /^(Loot Session|Loot Total|Opened\/Broke For Each Pick)$/
            if name == "Loot Session"
              all_names.push("Silver", "Scarabs")
              $tpick_session_data["Loot Session"]&.each_key { |key| all_names.push(key) }
            elsif needed_stats[name].is_a?(Hash)
              needed_stats[name]&.each_key { |key| all_names.push(key) }
            end
          else
            all_names.push(name.gsub(/^(Non-Pool |Pool |Total |Loot |Session )/, ""))
          end
        end

        longest_name = all_names.map(&:length).max || 1
        scarab_silvers = stats_info["Pool Scarabs Received"].to_i * @needed_values["Scarab Value"].to_i
        total_silvers  = scarab_silvers + stats_info["Pool Tips Silvers"].to_i
        total_time     = stats_info["Pool Time Spent Picking"].to_i + stats_info["Pool Time Spent Waiting"].to_i

        text = names.map { |name|
          value = needed_stats[name]
          needed_value = ""
          case name
            when "Pool Scarab Silvers" then value = scarab_silvers
            when "Pool Total Silvers"  then value = total_silvers
            when "Pool Silvers/Hour"   then value = total_time > 0 ? ((total_silvers.to_f / total_time) * 3600).to_i : 0
          end
          if name =~ /^(Pool Time Spent Picking|Pool Time Spent Waiting|Non-Pool Time Spent Picking|Total Time Spent Picking|Session Time Spent Picking)$/
            if name == "Session Time Spent Picking"
              @current_session_picking += (Time.now - $tpick_session_data["Session Start Time"])
              $tpick_session_data["Session Start Time"] = Time.now
              t = @current_session_picking.to_i
            else
              t = value.to_i
            end
            needed_value = "%02d:%02d:%02d" % [t / 3600, (t / 60) % 60, t % 60]
          elsif value.is_a?(Integer)
            needed_value = add_commas(value)
          end

          if name =~ /^(Loot Session|Loot Total|Opened\/Broke For Each Pick)$/
            lines = []
            if name == "Loot Session"
              lines << "#{"Silver".ljust(longest_name)}  : #{add_commas($tpick_session_data["Silver"])}"
              lines << "#{"Scarabs".ljust(longest_name)}  : #{add_commas($tpick_session_data["Scarabs"])}"
              $tpick_session_data["Loot Session"].each { |k, v| lines << "#{k.ljust(longest_name)}  : #{add_commas(v)}" }
            elsif value.is_a?(Hash)
              lines << "#{"Silver".ljust(longest_name)}  : #{add_commas(value["Silver"])}" if value.key?("Silver")
              lines << "#{"Scarabs".ljust(longest_name)}  : #{add_commas(value["Scarabs"])}" if value.key?("Scarabs")
              value.each { |k, v| next if k =~ /^(Silver|Scarabs)$/; lines << "#{k.ljust(longest_name)}  : #{add_commas(v)}" }
            end
            lines.join("\n")
          else
            row_label = name.gsub(/^(Non-Pool |Pool |Total |Loot |Session )/, "")
            if @trap_names_all.include?(name)
              total_traps = stats_info["Total Traps"].to_i
              raw_count   = needed_value.delete(",").to_f
              percent     = total_traps.zero? ? 0.0 : ((raw_count / total_traps) * 100).round(2)
              "#{row_label.ljust(longest_name)}  : #{needed_value} (#{percent}%)"
            else
              display_value = needed_value.empty? ? add_commas(value.to_i) : needed_value
              "#{row_label.ljust(longest_name)}  : #{display_value}"
            end
          end
        }.join("\n").strip

        @all_buffers[tab_name].text = text
      end
    end
  end
  
  def self.update_tpick_var(key, value)
    $tpick_vars[key] = value
    TpickMain.update_box_for_window
  end

  # =============================================================================
  # Updates various stats for the current box and updates
  # the text values in the Information window.
  # Also updates the image for the current trap in the Trap window.
  # =============================================================================
  def self.update_box_for_window
    box_exists = !!$tpick_vars["Current Box"]
	max_messages = 100 # Maximum number of messages to keep in Messages tab
  
    # If a fresh message popped up, update the rolling log buffer queue automatically
    if $tpick_vars["Window Message"]
      @all_messages ||= []
      @all_messages.unshift($tpick_vars["Window Message"])
      @all_messages.pop if @all_messages.count > max_messages
      @all_buffers["Messages"].text = @all_messages.join("\n\n")
      $tpick_vars["Window Message"] = nil 
    end

    all_box_stats = {
      "Box Name"         => box_exists ? $tpick_vars["Current Box"].name : "None",
      "Box ID"           => box_exists ? $tpick_vars["Current Box"].id   : "None",
      "Lock Difficulty"  => $tpick_vars["Lock Difficulty"] || "",
      "Trap Difficulty"  => $tpick_vars["Trap Difficulty"] || "",
      "Current Trap"     => $tpick_vars["Current Trap Type"] || "",
      "Tip Amount"       => $tpick_vars["Offered Tip Amount"] || "",
      "Critter Name"     => $tpick_vars["Critter Name"] || "",
      "Critter Level"    => $tpick_vars["Critter Level"] || "",
      "Putty Remaining"  => $tpick_vars["Putty Remaining"] || "",
      "Cotton Remaining" => $tpick_vars["Cotton Remaining"] || "",
      "Vials Remaining"  => $tpick_vars["Vials Remaining"] || ""
    }
  
    longest_name = @box_info_labels.map(&:length).max || 1

    all_box_stats.each do |name, value|
      @labels[name].text = "#{name.ljust(longest_name)}  : #{value}"
    end
    
	# =============================================================================
	# Trap image update.
	# =============================================================================
    return if !$tpick_vars["Current Trap Type"]
    
    trap = $tpick_vars["Current Trap Type"]
    image_name = nil
    
    scarab_name = $tpick_vars["Scarab Name"].to_s.gsub(/glaes|miniature|tiny/i, "").squeeze(" ").strip if trap =~ /Scarab/i
    scarab_name = scarab_name.split(/(\s|-)/).map { |w| w =~ /\s|-/ ? w : w.capitalize }.join if scarab_name

    if trap == "Scarab"
      image_name = "#{scarab_name} Scarab Trap Found"
    elsif trap =~ /Scarab trap has already been disarmed with 408\./
      image_name = "#{scarab_name} Scarab Trap Disarmed With 408"
    elsif trap == "Sphere trap found, need to use lockpick to disarm."
      image_name = "Sphere Trap Found"
    elsif trap == "Scales trap found, need to use dagger to disarm."
      image_name = "Scales Trap Found"
    elsif trap =~ /(.*) trap has (?:already )?been disarmed\./
      image_name = "#{$1} Trap Disarmed"
    elsif trap =~ /(.*) trap has already been disarmed with 408\./
      image_name = "#{$1} Trap Disarmed With 408"
    elsif trap =~ /(.*) trap has already been set off\./
      image_name = "#{$1} Trap Already Set Off"
    elsif trap =~ /(.*) trap has been set off\./
      image_name = "#{$1} Trap Set Off"
    elsif trap == "No trap found."
      image_name = "No Trap Found"
    elsif trap == "Box is already open."
      image_name = "Box Already Open"
	elsif @trap_names_all.include?(trap)
	  image_name = "#{trap} Trap Found"
    else
      image_name = "No Trap Image Found" 
    end

    if image_name
	
	  case image_name
	  when /Scarab/
	    if image_name =~ /408/
		  image_text = "Scarab Trap Disarmed With 408"
		elsif image_name =~ /Scarab Trap Found/
		  image_text = "Scarab Trap Found"
		else
		  image_text = "Scarab Trap Disarmed"
		end
	  else
	    image_text = image_name
	  end

      TpickMain.update_window_label_text(image_text, "Traps", "bottom")
      TpickMain.update_display_image(image_name, "Traps")
    end
	# =============================================================================
  end
  
  # =============================================================================
  # Adds standard thousand-separator commas to raw integer values for layout readability.
  # =============================================================================
  def self.add_commas(number)
    number.to_s.reverse.gsub(/(\d{3})(?=\d)/, '\\1,').reverse
  end
  
  # =============================================================================
  # Wrapper for creating a new notebook page.
  # =============================================================================
  def self.create_notebook(name)
    @all_notebooks[name] = Gtk::Notebook.new
    @all_notebooks[name].set_hexpand(true)
    @all_notebooks[name].set_vexpand(true)
  end

  # =============================================================================
  # Dynamically updates the "Picking Options" dropdown menu based on the active 
  # "Picking Mode", checking character stats and known spells to restrict choice parameters.
  # =============================================================================
  def self.change_menu_options
    menu         = @non_settings_menus["Picking Options"]
    picking_mode = @non_settings_menus["Picking Mode"].active_text
    tip_amount   = @spin_buttons["Tip Amount"]
    percent      = @check_boxes["Tip Percent"]

    menu.remove_all

    is_drop_off = (picking_mode == "Drop Off Boxes")
    tip_amount.set_sensitive(is_drop_off)
    percent.set_sensitive(is_drop_off)

    if picking_mode !~ /Drop Off Boxes|Pick Up Boxes|Refill Locksmith's Container|Repair Lockpicks/
      options = ["None", "Always Use Vaalin", "Start With Copper"]

      options << "Relock Boxes" if picking_mode =~ /^(Ground Picking|Ground Picking \+ Loot|Solo Picking)$/
      options << "Always Use Wedge" if Stats.prof == "Rogue"
      options << "Pop Boxes" if Spell[416].known?
      options << "Plinites" if picking_mode !~ /^(Pool Picking|Ground Picking|Ground Picking \+ Loot)$/
      options << "Disarm Only" if picking_mode =~ /^(Ground Picking|Ground Picking \+ Loot)$/

      if Stats.prof == "Warrior"
        options << "Bash Only" if picking_mode =~ /^(Solo Picking|Ground Picking|Ground Picking \+ Loot)$/
        options << "Bash + Disarm" if picking_mode =~ /^(Ground Picking|Ground Picking \+ Loot)$/
      end

      options.each { |option| menu.append_text(option) }
      menu.set_active(0)
    end
  end

  # =============================================================================
  # Aggregates current dropdown settings and entry text fields
  # into an array list to guide core command line routines.
  # =============================================================================
  def self.get_tpick_commands
    commands         = []
    picking_mode     = @non_settings_menus["Picking Mode"].active_text
    picking_options  = @non_settings_menus["Picking Options"].active_text
    
    commands << picking_mode

    if picking_options && picking_options != "None"
      commands << picking_options
    end

    if picking_mode == "Drop Off Boxes"
      commands << @spin_buttons["Tip Amount"].value.to_i.to_s
      commands << "Percent" if @check_boxes["Tip Percent"].active?
    end
    
    commands
  end

  # =============================================================================
  # Checks the text input for the Reset Stats entry.
  # If "reset" is typed script will purge historical data
  # and terminate the window and script, which will then call
  # to save stats data in the before_dying method.
  # =============================================================================
  def self.reset_stats
    if @entries["Reset Stats"].text.to_s.strip.downcase == "reset"
      $tpick_stats_data = {}

      @windows["Information"]&.close
      kill_script(@script_name) if running?(@script_name)
    end
	
    @entries["Reset Stats"].text = ""
  end

  # =============================================================================
  # Text properties for Trap label text
  # =============================================================================
  def self.format_display_label_style(text)
    color      = "#FFFF00"   # High-chroma bright yellow
    bg_color   = "#1A1A1A80" # Dark charcoal with ~50% opacity
    size       = "x-large"   # Options: small, medium, large, x-large
    weight     = "bold"      # Options: normal, bold
  
    "<span weight='#{weight}' foreground='#{color}' background='#{bg_color}' size='#{size}'> #{text} </span>"
  end

  # =============================================================================
  # create_information_window and all of its helper methods.
  # Creates the Information window.
  # Configures adjustments, numeric spin buttons, status trackers, 
  # and embeds the nested statistics notebook screens under an exclusive layout grid.
  # =============================================================================
  def self.create_information_window
    if (@needed_values["Show Window"] == "Yes") || (@script_variables.any? { |i| i.downcase == "show" })

      @windows["Information"] = Gtk::Window.new(:toplevel)
	  @windows["Information"].set_name("tpick_window")
	  
	  if @show_images
        create_traps_lockpick_windows
        keep_windows_connected
      end

	  create_information_headerbar

      @windows["Information"].set_keep_above(true)
      @windows["Information"].resize(@needed_values["Width"].to_i, @needed_values["Height"].to_i)
      @windows["Information"].move(@needed_values["Horizontal"].to_i, @needed_values["Vertical"].to_i)

      note_books = ["Information", "Stats", "Lockpicking"]
      note_books.each { |name| create_notebook(name) }

      create_text_view("Messages")

      pages = ["Main", "Messages", "Stats", "Settings"]
      pages.each do |name| 
        @grids["#{name} Main"] = Gtk::Grid.new
        @labels[name]         = Gtk::Label.new(name)
        
        if name == "Messages"
          @all_notebooks["Information"].append_page(@scrolled_windows[name], @labels[name])
        else
          @all_notebooks["Information"].append_page(@grids["#{name} Main"], @labels[name])
        end
      end
	  
      @info_row = -1
      create_information_spinbuttons
      create_information_checkboxes

      name = "Default Mode"
      @entries[name]      = Gtk::Entry.new
      @entries[name].text = @needed_values[name].to_s
      @labels[name]       = Gtk::Label.new("     #{name}     ")
      @grids["Settings Main"].attach(@labels[name], 0, @info_row += 1, 1, 1)
      @grids["Settings Main"].attach(@entries[name], 1, @info_row, 1, 1)

      create_information_buttons
      
      @buttons["Save"].signal_connect("clicked")        { save_settings("All") }
      @buttons["Defaults"].signal_connect("clicked")    { load_defaults }
      @buttons["Reset Stats"].signal_connect("clicked") { reset_stats }

      row = -1
      grids = ["Instructions Labels", "Menus", "Spin Buttons", "Buttons", "Box Labels"]
      grids.each do |name|
        @grids["Main #{name}"] = Gtk::Grid.new
        @grids["Main Main"].attach(@grids["Main #{name}"], 0, row += 1, 1, 1)
      end

      label = Gtk::Label.new("Choose the picking mode and option below.")
      @grids["Main Instructions Labels"].attach(label, 0, row += 1, 1, 1)

      create_start_stop_buttons

      name  = "Tip Amount"
      value = @load_data[name].to_s.strip.empty? ? 1 : @load_data[name].to_i
      @adjustments[name]  = Gtk::Adjustment.new(value, 1, 10000, 1, 10, 0)
      @spin_buttons[name] = Gtk::SpinButton.new(@adjustments[name], 1, 0)
      @labels[name]       = Gtk::Label.new("  #{name}  ")
      @grids["Main Spin Buttons"].attach(@labels[name], 0, 0, 1, 1)
      @grids["Main Spin Buttons"].attach(@spin_buttons[name], 1, 0, 1, 1)
      
      name = "Tip Percent"
      @check_boxes[name]        = Gtk::CheckButton.new(name)
      @check_boxes[name].active = (@load_data[name] == "Yes")
      @grids["Main Spin Buttons"].attach(@check_boxes[name], 2, 0, 1, 1)

      row = -1
      @box_info_labels.each do |name|
        @labels[name]        = Gtk::Label.new(name.gsub("Window Message", ""))
        @labels[name].halign = Gtk::Align::START
        
        css_provider = Gtk::CssProvider.new
        css_provider.load(data: <<-CSS)
          label {
            font-family: Courier New;
            font-size: 10pt;
          }
        CSS
        @labels[name].style_context.add_provider(css_provider, Gtk::StyleProvider::PRIORITY_USER)
        @labels[name].set_line_wrap(true)
        @labels[name].wrap_mode = :word
        @grids["Main Box Labels"].attach(@labels[name], 0, row += 1, 1, 1)
      end

      column = -1
      options_menus = ["Picking Mode", "Picking Options"]
      options_menus.each do |name|
        @non_settings_menus[name] = Gtk::ComboBoxText.new
        menu                      = @non_settings_menus[name]
        
        if name == "Picking Mode"
          options = ["Pool Picking", "Ground Picking", "Ground Picking + Loot", "Solo Picking", "Other Picking", "Refill Locksmith's Container", "Repair Lockpicks", "Drop Off Boxes", "Pick Up Boxes"]
          options.delete("Repair Lockpicks") if Stats.prof != "Rogue"
          
          menu.signal_connect("changed") { change_menu_options }
          options.each { |option| menu.append_text(option) }
        end
        @grids["Main Menus"].attach(menu, column += 1, row, 1, 1)
      end
      
      match_menu_item(@non_settings_menus["Picking Mode"], @load_data["Picking Mode"])
      match_menu_item(@non_settings_menus["Picking Options"], @load_data["Picking Options"])

      @labels["Lockpicking"] = Gtk::Label.new("Lockpicking")
      @all_notebooks["Stats"].append_page(@all_notebooks["Lockpicking"], @labels["Lockpicking"])

      @grids["Stats Main"].attach(@all_notebooks["Stats"], 0, 0, 1, 1)

      Gtk.queue { set_stat_info }

      handle_info_window_destroyed
	  
      add_all_tooltips
      
      @windows["Information"].add(@all_notebooks["Information"])
      @windows["Information"].show_all
	  
	  if @show_images
	    @windows["Traps"].show_all
	    @windows["Lockpick"].show_all
      end
	  
    else
      message(";#{@script_name}: To show the Information Window start script as: ;#{@script_name} show")
    end
  end
  # =============================================================================
  
  def self.handle_info_window_destroyed
    @windows["Information"].signal_connect("destroy") do
      save_settings("Menu Only")
      @windows["Traps"]&.close
      @windows["Traps"] = nil
      @windows["Lockpick"]&.close
      @windows["Lockpick"] = nil
      @windows["Information"].close
      @windows["Information"] = nil
      
      if @load_data["Close Window/Script"] == "Yes"
        kill_script(@script_name) if running?(@script_name)
      end
    end
  end
  # =============================================================================
  
  def self.create_start_stop_buttons
    column = -1
    buttons = ["Start", "Stop"]
    buttons.each do |name|
      @buttons[name] = Gtk::Button.new(label: name)
      @grids["Main Buttons"].attach(@buttons[name], column += 1, 0, 1, 1)
      
      if name == "Start"
        @buttons[name].signal_connect("clicked") { $tpick_commands_set = true }
      elsif name == "Stop"
        @buttons[name].set_sensitive(false)
        @buttons[name].signal_connect("clicked") do
          @buttons[name].set_sensitive(false)
          $tpick_stop_immediately = true
          message(";#{@script_name}: 'Stop' button clicked. Script will finish the box you are currently working on and then stop.")
        end
      end
    end
  end
  # =============================================================================
  
  def self.create_information_spinbuttons
    all_spinbuttons = ["Width", "Height", "Horizontal", "Vertical", "Scarab Value"]
    all_spinbuttons.each do |name|
      number = @needed_values[name].to_i
      
      if name =~ /^(Horizontal|Vertical)$/
        @adjustments[name]  = Gtk::Adjustment.new(number, -1000, 5000, 1, 10, 0)
        @spin_buttons[name] = Gtk::SpinButton.new(@adjustments[name], 1, 0)
      elsif name =~ /^(Width|Height)$/
        @adjustments[name]  = Gtk::Adjustment.new(number, 400, 2000, 1, 10, 0)
        @spin_buttons[name] = Gtk::SpinButton.new(@adjustments[name], 1, 0)
      elsif name == "Scarab Value"
        @adjustments[name]  = Gtk::Adjustment.new(number, 1, 20000, 1, 10, 0)
        @spin_buttons[name] = Gtk::SpinButton.new(@adjustments[name], 1, 0)
      end
    
      if name =~ /^(Width|Height)$/
        @spin_buttons[name].signal_connect("value-changed") do 
          @windows["Information"].resize(@spin_buttons["Width"].value.to_i, @spin_buttons["Height"].value.to_i) 
        end
      elsif name =~ /^(Horizontal|Vertical)$/
        @spin_buttons[name].signal_connect("value-changed") do 
          @windows["Information"].move(@spin_buttons["Horizontal"].value.to_i, @spin_buttons["Vertical"].value.to_i) 
        end
      end
      
      @labels[name] = Gtk::Label.new("     #{name}     ")
      @grids["Settings Main"].attach(@labels[name], 0, @info_row += 1, 1, 1)
      @grids["Settings Main"].attach(@spin_buttons[name], 1, @info_row, 1, 1)
    end
  end
  # =============================================================================

  def self.create_information_checkboxes
    @info_row += 1
    column = -1
    checkboxes = ["Show Window", "Track Loot", "Close Window/Script", "Keep Window Open", "One & Done", "Show Tooltips"]
    checkboxes.each do |name|
      @check_boxes[name]        = Gtk::CheckButton.new(name)
      @check_boxes[name].active = (@needed_values[name] == "Yes")
      
      @grids["Settings Main"].attach(@check_boxes[name], column += 1, @info_row, 1, 1)
      if column > 0
        column = -1
        @info_row += 1
      end
    end
  end
  # =============================================================================
  
  def self.create_information_buttons
    buttons = ["Save", "Defaults", "Reset Stats"]
    buttons.each do |name|
      @buttons[name] = Gtk::Button.new(label: name)
      if name == "Defaults"
        @grids["Settings Main"].attach(@buttons[name], 1, @info_row, 1, 1)
      else
        @grids["Settings Main"].attach(@buttons[name], 0, @info_row += 1, 1, 1)
      end
      
      if name == "Reset Stats"
        @entries[name] = Gtk::Entry.new
        @grids["Settings Main"].attach(@entries[name], 1, @info_row, 1, 1)
      end
    end
  end
  # =============================================================================

  def self.create_information_headerbar
    tpick_titlebar = Gtk::HeaderBar.new
    tpick_titlebar.set_show_close_button(true)
 
    if @show_images
      begin
        image_path = File.join(@images_folder, "Tpick Icon.jpg") 

        custom_pixbuf = GdkPixbuf::Pixbuf.new(file: image_path, width: 44, height: 44)
        info_icon = Gtk::Image.new(pixbuf: custom_pixbuf)
        info_icon.set_margin_left(4)
      rescue => e
        info_icon = Gtk::Image.new(icon_name: "utilities-terminal", size: :button)
      end

      tpick_titlebar.pack_start(info_icon)
    end

    title_label = Gtk::Label.new(" TPICK v#{@script_version} - #{Char.name} ")
    tpick_titlebar.set_custom_title(title_label)

    @windows["Information"].set_titlebar(tpick_titlebar)
  end
  # =============================================================================

  def self.create_traps_lockpick_windows
    windows = ["Traps", "Lockpick"]
	windows.each do |name|
      @windows[name] = Gtk::Window.new(:toplevel)
      @windows[name].set_name("tpick_window")
      @windows[name].decorated = false
      @windows[name].transient_for = @windows["Information"]
      @windows[name].set_size_request(1, 1)
      @windows[name].set_resizable(false)
      @windows[name].set_keep_above(true)
          
      @window_assets[name] ||= {}
      assets = @window_assets[name]
          
      assets["CurrentVisible"] = nil
      assets["ImageWidget"] = Gtk::Image.new
      assets["Grid"] = Gtk::Grid.new
          
      assets["Overlay"] = Gtk::Overlay.new
      assets["Overlay"].add(assets["ImageWidget"])
          
      labels = ["BottomLabel","TopLabel"]
      labels.each do |label|
        assets[label] = Gtk::Label.new("")
        assets[label].set_line_wrap(true)
        assets[label].set_max_width_chars(20)
        assets[label].set_justify(Gtk::Justification::CENTER)
  
        if label == "TopLabel"
          assets[label].set_valign(:start)
        else
          assets[label].set_valign(:end)
        end
  
        assets[label].set_halign(:center)
  
        assets["Overlay"].add_overlay(assets[label])
      end
  
      case name
      when "Traps"
        @window_assets[name]["TopLabel"].set_margin_top(5)        # Adjust this number to move text label up or down
        @window_assets[name]["BottomLabel"].set_margin_bottom(10) # Adjust this number to move text label up or down
      when "Lockpick"
        @window_assets[name]["TopLabel"].set_margin_top(5)
        @window_assets[name]["BottomLabel"].set_margin_bottom(0)
      end
  	
      assets["Grid"].attach(assets["Overlay"], 0, 0, 1, 1)
      @windows[name].add(assets["Grid"])
  	
      TpickMain.update_window_label_text("Idle", name, "bottom")
    end
  end
  # =============================================================================

  def self.keep_windows_connected
    @windows["Information"].signal_connect("configure-event") do
      if @windows["Information"]
        x, y = @windows["Information"].position
        width, _height = @windows["Information"].size
    
        @windows["Traps"].move(x + width + 4, y) if @windows["Traps"]
    
        if @windows["Lockpick"]
          @windows["Lockpick"].move(x - 224, y) 
        end
      end
      false
    end
  end
  # =============================================================================

  # =============================================================================
  # Loops through all widget hashes and maps tooltips out 
  # of the master tooltip dictionary if "Show Tooltips" is enabled.
  # =============================================================================
  def self.add_all_tooltips
    return unless @needed_values["Show Tooltips"] == "Yes"

    [@entries, @buttons, @menus, @non_settings_menus, @check_boxes, @labels, @spin_buttons].each do |widget_hash|
      widget_hash.each do |name, widget|
        if @repair_names.include?(name)
          widget.set_tooltip_text(@tooltips["Repair Tooltip"])
        elsif LOCKPICK_TIERS.include?(name)
          widget.set_tooltip_text(@tooltips["Lockpick Tooltip"])
        else
          widget.set_tooltip_text(@tooltips[name])
        end
      end
    end
  end
  
  # =============================================================================
  # create_settings_window and all of its helper methods.
  # Creates the Settings window.
  # Dynamically adds tabs filtered against character class profession profiles,
  # audits known spell trees, and paints required label texts red.
  # =============================================================================
  def self.create_settings_window
    width  = 300
    height = 300
    
    @windows["Settings"] = Gtk::Window.new(:toplevel)
	@windows["Settings"].set_name("tpick_window")

	create_settings_headerbar
	
    @windows["Settings"].set_keep_above(true)
    @windows["Settings"].resize(width, height)

    @windows["Settings"].signal_connect("destroy") do
      @windows.each do |name, window|
        window&.close
        @windows[name] = nil
      end
      kill_script(@script_name) if running?(@script_name)
    end

    create_notebook("Settings")

    main_tab_grids = ["Main", "Lockpicks", "Repair", "Containers", "Other", "Rogues Only", "Spells", "Experience", "Speech", "Popping", "Pool"]
    
    main_tab_grids.each do |name|
      create_it = case name
                  when "Rogues Only", "Repair" then Stats.prof == "Rogue"
                  when "Popping" then ["Bard", "Rogue", "Sorcerer", "Warrior", "Wizard"].include?(Stats.prof)
                  when "Spells"  then !["Monk", "Paladin"].include?(Stats.prof)
                  else true
                  end
                  
      if create_it
        @grids["#{name} Main"] = Gtk::Grid.new
        @all_notebooks["Settings"].append_page(@grids["#{name} Main"], Gtk::Label.new(name))
      end
    end

    if Stats.prof != "Rogue"
      rogue_only = [
	    "Wedge Container",
		"Wedge Open",
		"Wedge Close",
		"Calipers Container",
		"Calipers Open",
		"Calipers Close"
      ]
      @container_names.reject! { |name| rogue_only.include?(name) }
    end

    @other_names.delete("Bashing Weapon")  if Stats.prof != "Warrior"
    @other_names.delete("Use Calipers")    if Stats.prof != "Rogue"
    @other_names.delete("Use Loresinging") if Stats.prof != "Bard"

    @spell_names.delete("Use Lmaster Focus") if Stats.prof != "Rogue"
    @spell_names.delete("Lock Pick Enhancement (403)") if !Spell[403].known? && Stats.prof != "Rogue"
    @spell_names.delete("Disarm Enhancement (404)")    if !Spell[404].known? && Stats.prof != "Rogue"
    
    @spell_names.reject! do |name|
      if name =~ /\((\d+)\)/
        spell_num = $1
        !Spell[spell_num].known? && spell_num != "403" && spell_num != "404"
      else
        false
      end
    end
    @spell_names.delete("Percent Mana To Keep") if @spell_names.count == 1

    if !Spell[416].known?
      @popping_names = []
    else
      @popping_names = ["Number Of 416 Casts", "Phase (704)", "Only Disarm Safe", "Pick Enruned"]
    end
    @popping_names.delete("Phase (704)") if !Spell[704].known?

    @pool_names = ["Max Level", "Minimum Tip Start", "Minimum Tip Interval", "Minimum Tip Floor", "Time To Wait", "Standard Wait", "Use 403 On Level", "Use 404 On Level", "Rest When Fried", "Picks On Level"]	
    @pool_names.delete("Use 403 On Level") if !Spell[403].known? && Stats.prof != "Rogue"
    @pool_names.delete("Use 404 On Level") if !Spell[404].known? && Stats.prof != "Rogue"

    create_main_tab
	create_all_other_tabs

    @grids["Spells Main"].attach(Gtk::Label.new("You don't know any relevant spells."), 0, 0, 1, 1) if @spell_names.empty?
    @grids["Popping Main"].attach(Gtk::Label.new("You must know the spell Piercing Gaze (416) in order to use the Popping feature of this script."), 0, 0, 1, 1) if @popping_names.empty?

    if @grids["Repair Main"]
      @buttons["Copy"] = Gtk::Button.new(label: "Copy")
      @grids["Repair Main"].attach(@buttons["Copy"], 2, 6, 1, 1)
      @buttons["Copy"].signal_connect("clicked") do 
        LOCKPICK_TIERS.each { |name| @entries["Repair #{name}"].text = @entries[name].text } 
      end
    end

    @labels.each do |name, label|
      if @required_settings.include?(name)
        label.style_context.add_class("required-setting")
      end
    end

    @check_boxes.each do |box_name, checkbox|
      checkbox.active = (@needed_values[box_name] == "Yes")
    end

    add_all_tooltips
    
    @windows["Settings"].add(@all_notebooks["Settings"])
    @windows["Settings"].show_all
  end
  # =============================================================================

  def self.create_settings_headerbar
    setup_titlebar = Gtk::HeaderBar.new
    setup_titlebar.set_show_close_button(true)

    setup_label = Gtk::Label.new(" TPICK SETTINGS v#{@script_version} - #{Char.name} ")
    setup_titlebar.set_custom_title(setup_label)

    @windows["Settings"].set_titlebar(setup_titlebar)
  end
  
  def self.create_all_other_tabs
    create_tab(LOCKPICK_TIERS, @grids["Lockpicks Main"])     if @grids["Lockpicks Main"]
    create_tab(@repair_names, @grids["Repair Main"])         if @grids["Repair Main"]
    create_tab(@container_names, @grids["Containers Main"])  if @grids["Containers Main"]
    create_tab(@other_names, @grids["Other Main"])           if @grids["Other Main"]
    create_tab(@rogue_names, @grids["Rogues Only Main"])     if @grids["Rogues Only Main"]
    create_tab(@spell_names, @grids["Spells Main"])          if @grids["Spells Main"]
    create_tab(@experience_names, @grids["Experience Main"]) if @grids["Experience Main"]
    create_tab(@speech_names, @grids["Speech Main"])         if @grids["Speech Main"]
    create_tab(@popping_names, @grids["Popping Main"])       if @grids["Popping Main"]
    create_tab(@pool_names, @grids["Pool Main"])             if @grids["Pool Main"]
  end
  # =============================================================================
  
  # =============================================================================
  # Creates the welcoming onboarding controls layout hub.
  # Dynamically fills character profiles across the drop-down menu, maps 
  # required execution buttons, and attaches standard visual signaling triggers.
  # =============================================================================
  def self.create_main_tab
    row    = -1
    column = -1
    
    @non_settings_menus["Profiles"] = Gtk::ComboBoxText.new
    @all_characters.each { |character| @non_settings_menus["Profiles"].append_text(character) }
    match_menu_item(@non_settings_menus["Profiles"], Char.name)

    new_label = Gtk::Label.new(
      "IMPORTANT: All settings in RED are required settings and MUST be filled out for the script to work properly. " \
      "These settings will always be in red, even if they are filled out properly.\n" \
      "EXCEPTION: If you are POPPING boxes and don't have 'Pick Enruned' checked then you don't need to fill out these red settings.\n\n" \
      "All other settings are optional.\n\n" \
      "Hover your mouse over each setting to see a tooltip for what that setting does.\n\n" \
      "It is recommended that you read the tooltip for each setting to be sure you fill out each setting properly.\n\n" \
      "IMPORTANT: Having a Shimmering Trinket active might interfere with some features of this script " \
      "(like the SCAN feature or if you're using a keyring for your lockpicks), so if you're having any issues " \
      "try disabling your Shimmering Trinket first to see if this solves the issue."
    )
    new_label.set_line_wrap(true)
    
    label_grid    = Gtk::Grid.new
    buttons_grid  = Gtk::Grid.new
    
    label_grid.attach(new_label, 0, 0, 1, 1)
    @grids["Main Main"].attach(label_grid, 0, 0, 1, 1)
    @grids["Main Main"].attach(buttons_grid, 0, 2, 1, 1)
    
    buttons_grid.attach(@non_settings_menus["Profiles"], column += 1, row, 1, 1)

    buttons = ["Save", "Load", "Defaults"]
    buttons << "Scan" if Stats.prof == "Rogue"
    
    buttons.each do |name|
      @buttons[name] = Gtk::Button.new(label: name)
      buttons_grid.attach(@buttons[name], column += 1, row, 1, 1)
    end

    @buttons["Save"].signal_connect("clicked")     { save_settings("All") }
    @buttons["Load"].signal_connect("clicked")     { load_profile }
    @buttons["Defaults"].signal_connect("clicked") { load_defaults }
    @buttons["Scan"]&.signal_connect("clicked")    { scan_lockpicks }
  end

  # =============================================================================
  # Iterates through setting arrays to build appropriate 
  # input text fields, dropdown menus, or numeric spinners.
  # =============================================================================
  def self.create_tab(names, grid)
    row    = -1
    column = 0

    spinner_bounds_map = {
      /^(Max Lock|Trap Roll)$/                           => [-500, 10000],
      /^(Max Lock Roll|Lock Roll|Vaalin Lock Roll)$/     => [0, 101],
      /^(Calibrate Count|Trap Check Count|Lock Buffer)$/ => [0, 1000],
      /^(Number Of 416 Casts|Max Level)$/                => [1, 200],
      /^(Unlock \(407\) Mana|Percent Mana To Keep)$/     => [-1, 100],
      /^(Use 403 On Level|Use 404 On Level)$/            => [0, 200],
      /^(Minimum Tip Start|Minimum Tip Interval)$/       => [0, 20000],
      "Minimum Tip Floor"                                => [0, 20000],
      "Time To Wait"                                     => [5, 300]
    }

    mind_states = ["Never", "Must Rest (100%)", "Numbed (90%)", "Becoming Numbed (75%)", "Muddled (62%)", "Clear (50%)", "Fresh And Clear (25%)", "Clear As A Bell (0%)"]
    menu_items_map = {
      "Trick"            => ["pick", "spin", "twist", "turn", "twirl", "toss", "bend", "flip", "random"],
      "Unlock (407)"     => ["Plate", "Vial", "All", "Never"],
      "Rest At Percent"  => mind_states,
      "Pick At Percent"  => ["Always"] + mind_states.reject { |s| s == "Never" }
    }

    names.each do |name|
      widget = nil
 
      if @all_spinbuttons.include?(name)
        number = @needed_values[name].to_i
        bounds = spinner_bounds_map.find { |pattern, _| pattern.is_a?(Regexp) ? name =~ pattern : name == pattern }&.last || [0, 100]
        
        @adjustments[name]  = Gtk::Adjustment.new(number, bounds[0], bounds[1], 1, 1, 0)
        @spin_buttons[name] = Gtk::SpinButton.new(@adjustments[name], 1, 0)
        widget              = @spin_buttons[name]
      elsif @all_menus.include?(name)
        @menus[name] = Gtk::ComboBoxText.new
        menu         = @menus[name]
        
        if menu_items_map.key?(name)
          menu_items_map[name].each { |item| menu.append_text(item) }
        elsif name =~ /^(Lockpick Container|Broken Lockpick Container|Wedge Container|Calipers Container|Scale Weapon Container|Locksmith's Container)$/
          $tpick_worn_containers.each_key { |item| menu.append_text(item) }
        end
        
        widget = menu
        match_menu_item(widget, @needed_values[name])
      elsif @all_checkboxes.include?(name)
        label_text         = name =~ / Open| Close/ ? name : ""
        @check_boxes[name] = Gtk::CheckButton.new(label_text)
        
        if name == "Use Lmaster Focus"
          @check_boxes[name].signal_connect("toggled") do
            is_active = @check_boxes[name].active?
            @labels["Lock Pick Enhancement (403)"].text = is_active ? "Lock Mastery (Picking)"   : "Lock Pick Enhancement (403)"
            @labels["Disarm Enhancement (404)"].text    = is_active ? "Lock Mastery (Disarming)" : "Disarm Enhancement (404)"
          end
        end
        widget = @check_boxes[name]
      else
        @entries[name]      = Gtk::Entry.new
        @entries[name].text = @needed_values[name].to_s
        widget              = @entries[name]
      end

      if LOCKPICK_DISPLAY_NAMES.key?(name)
        @labels[name] = Gtk::Label.new("     #{LOCKPICK_DISPLAY_NAMES[name]}     ")
      else
        cleaned_label = name.gsub("Repair ", "")
        @labels[name] = Gtk::Label.new("     #{cleaned_label}     ")
      end

      if (name =~ / Open| Close/) && @all_checkboxes.include?(name)
        if name =~ / Open/
          grid.attach(widget, column, row += 1, 1, 1)
        else
          grid.attach(widget, column += 1, row, 1, 1)
          column -= 1
        end
      else
        @labels[name].halign = Gtk::Align::START
        grid.attach(@labels[name], column, row += 1, 1, 1)
        grid.attach(widget, column += 1, row, 1, 1)
        column -= 1
        
        # Wrap to a new column row array after 10 rows
        if row >= 9
          row     = -1
          column += 2
        end
      end
    end
  end

  # =============================================================================
  # Executes 'lmas appraise' command on a held lockpick and maps the resulting 
  # precision and strength strings to their matching configuration database properties.
  # =============================================================================
  def self.appraise_lockpick(name)
    @lockpick_info = nil
    put "lmas appraise my #{checkright}"
    wait_until { @lockpick_info }
    
    if @lockpick_info != "NONE"
      precision = @lockpick_info[0].to_s.downcase.strip
      strength  = @lockpick_info[1].to_s.downcase.strip
      @lockpick_found = true

      precision_map = {
        "detrimental"         => "Detrimental",
        "ineffectual"         => "Ineffectual",
        "very inaccurate"     => "Copper",
        "inaccurate"          => "Steel",
        "somewhat inaccurate" => "Gold",
        "inefficient"         => "Silver",
        "unreliable"          => "Mithril",
        "below average"       => "Ora",
        "average"             => "Glaes",
        "above average"       => "Laje",
        "somewhat accurate"   => "Mein",
        "favorable"           => "Rolaren",
        "advantageous"        => "Rolaren",
        "accurate"            => "Accurate",
        "incredible"          => "Kelyn",
        "unsurpassed"         => "Vaalin"
      }

      if precision_map.key?(precision)
        setting_key = precision_map[precision]
        @load_data[setting_key] += "#{name},"
      elsif precision == "highly accurate"
        setting_key = (strength == "incredibly strong") ? "Invar" : "Veniom"
        @load_data[setting_key] += "#{name},"
      elsif precision == "excellent"
        setting_key = (strength == "astonishingly strong") ? "Golvern" : "Alum"
        @load_data[setting_key] += "#{name},"
      else
        message(
          ";#{@script_name}: I don't recognize the precision level of #{name}.\n\n" \
          "Please send the LMAS APPRAISE information of this lockpick to Dreaven."
        )
      end
    end

    until !checkright
      waitrt?
      put "put my #{checkright} in ##{@container_lockpick.id}"
      sleep 0.3
    end
  end

  # =============================================================================
  # Automates emptying hands, opening the lockpick container, and iterating through 
  # every inventory item inside to auto-populate the setup window fields.
  # =============================================================================
  def self.scan_lockpicks
    LOCKPICK_TIERS.each { |name| @load_data[name] = "" }
    
    waitrt?
    put "stow right" if checkright
    put "stow left"  if checkleft

    @lockpick_found     = nil
    @container_lockpick = GameObj.inv.find { |i| i.name == @load_data["Lockpick Container"] }
    
    if !@container_lockpick
      message(";#{@script_name}: Could not find #{@load_data["Lockpick Container"]}, which you have listed as your 'Lockpick Container.'")
    else
      put "look in ##{@container_lockpick.id}"
      sleep 0.5
      
      @container_lockpick.contents.each do |item|
        until checkright
          waitrt?
          put "get ##{item.id}"
          sleep 0.3
        end
        appraise_lockpick(item.name)
      end

      # If the container isn't a standard bag (like a gnomish bracer or keyring), scan via XML hooks
      if !@lockpick_found
        command_to_use = (@load_data["Lockpick Container"] =~ /vambrace/i) ? "look in" : "look on"
        @lockpick_container_contents = nil
        
        put "#{command_to_use} ##{@container_lockpick.id}"
        wait_until { @lockpick_container_contents }
        
        if @lockpick_container_contents && @lockpick_container_contents != "NONE"
          lockpick_container_contents_hash = {}

          @lockpick_container_contents.each do |line|
            if line =~ /exist=['"](?<id>.*?)['"] noun=['"].*?['"]>(?<item_name>.*?)<\/a>/
              lockpick_container_contents_hash[$~[:item_name]] = $~[:id]
            end
          end

          lockpick_container_contents_hash.each do |key, value|
            next if value == @container_lockpick.id
            
            until checkright
              waitrt?
              put "get ##{value}"
              sleep 0.3
            end
            appraise_lockpick(key)
          end
        end
      end

      LOCKPICK_TIERS.each do |name|
        @load_data[name].chop! if @load_data[name].end_with?(",")
        @entries[name].text = @load_data[name]
      end
      
      message(";#{@script_name}: Finishing scanning your lockpicks.")
    end
  end

  def self.script_name=(value)
    @script_name = value
  end
  
  def self.script_version=(value)
    @script_version = value
  end
  
  def self.variables=(value)
    @script_variables = value
  end

  before_dying do
    @windows["Settings"]&.close

    if @windows["Information"] && (@load_data["Keep Window Open"] == "No" || @load_data["One & Done"] == "Yes")
      @windows["Information"]&.close
    end
  end

  # =============================================================================
  # Monitors when the player clicks the "Start" and "Stop" buttons.
  # =============================================================================
  Thread.new do
    loop do
      # Waits until player clicks "Start" button
      wait_until { $tpick_commands_set }
      @buttons["Start"]&.set_sensitive(false)
      @buttons["Stop"]&.set_sensitive(true)
      @non_settings_menus["Picking Mode"]&.set_sensitive(false)
      @non_settings_menus["Picking Options"]&.set_sensitive(false)
      $tpick_session_data["Session Start Time"] = Time.now
      
      # Waits until player clicks "Stop" button
      wait_until { !$tpick_commands_set }
      @buttons["Start"]&.set_sensitive(true)
      @buttons["Stop"]&.set_sensitive(false)
      @non_settings_menus["Picking Mode"]&.set_sensitive(true)
      @non_settings_menus["Picking Options"]&.set_sensitive(true)
      @current_session_picking += (Time.now - $tpick_session_data["Session Start Time"])
    end
  end
  
  # =============================================================================
  # Stream scanning loop. Intercepts incoming game lines,
  # isolates target responses via regex, and populates data handles.
  # =============================================================================
  PRECISION_LINE    = /It seems to have an? (.*?) level of precision and (?:is|has) (.*?)\.\s+(?:As far as|Judging)/
  
  def self.watching
    status_tags

    while line = get
      if line.include?("you see")
	    sline = strip_xml(line)
        @lockpick_container_contents = sline.split(/ an? /)

      elsif line.include?("There is nothing on")
        @lockpick_container_contents = "NONE"

      elsif line.include?("level of precision")
	    sline = strip_xml(line)
        if sline =~ PRECISION_LINE
          @lockpick_info = [$1, $2]
        end

      elsif line.include?("That's not a lockpick!") || line.include?("Please rephrase that command.")
        @lockpick_info = "NONE"
      end
    end
  end
end

