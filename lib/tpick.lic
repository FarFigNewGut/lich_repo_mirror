  "Boxes Looted"                       => nil
}

loaded_raw_data = TpickMain.load_the_stats || {}
working_stats   = {}
data_save       = false

new_old_stats.each do |new_key, old_key|
  if new_key == "Loot Total"
    if @load_data["Track Loot"] == "No"
      working_stats[new_key] = {}
    else
      working_stats[new_key] = loaded_raw_data[new_key].is_a?(Hash) ? loaded_raw_data[new_key] : {}
    end
  elsif new_key == "Opened/Broke For Each Pick"
    working_stats[new_key] = loaded_raw_data[new_key].is_a?(Hash) ? loaded_raw_data[new_key] : {}
  else
    data_save = true if !loaded_raw_data.key?(new_key)
    working_stats[new_key] = loaded_raw_data[new_key] ? loaded_raw_data[new_key].to_i : 0
  end

  if old_key && CharSettings[old_key]
    data_save = true
    working_stats[new_key] = CharSettings[old_key]
    CharSettings[old_key] = nil
  end

  if ["Loot Total", "Opened/Broke For Each Pick"].include?(new_key)
    working_stats[new_key] = working_stats[new_key].transform_values(&:to_i)
  end
end

$tpick_stats_data = working_stats
TpickMain.save_the_stats if data_save # Only save if old settings were found

