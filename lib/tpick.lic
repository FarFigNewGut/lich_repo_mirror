# =============================================================================
# Character abilities, skill bonuses, and lore coefficients.
# =============================================================================
$tpick_vars["Dex Bonus"]               = Stats.enhanced_dex[1].to_i
$tpick_vars["WLore Rot Bonus"]         = ((Math.sqrt(1 + 8 * Skills.elwater) - 1) / 2).floor
$tpick_vars["WLore Corrosion Timeout"] = 25
$tpick_vars["Use WLore Pick"]          = true if (@load_data["Water Lore Pick"] == "Yes") && ($tpick_vars["WLore Rot Bonus"] > 0)
$tpick_vars["Use WLore Disarm"]        = true if (@load_data["Water Lore Disarm"] == "Yes") && ($tpick_vars["WLore Rot Bonus"] > 0)

$tpick_vars["Pick Skill"] = (Skills.to_bonus(Skills.pickinglocks) + $tpick_vars["Dex Bonus"])
$tpick_vars["Pick Lore"]  = [
  (Stats.level / 2) + (Skills.to_bonus(Skills.pickinglocks) / 10) + $tpick_vars["Dex Bonus"] + (Spells.minorelemental / 4), 
  Skills.to_bonus(Skills.pickinglocks)
].min

$tpick_vars["Disarm Skill"] = ($tpick_vars["Dex Bonus"] + Skills.to_bonus(Skills.disarmingtraps))

if Spell[404].known?
  $tpick_vars["Disarm Lore"] = [
    (Stats.level / 2) + (Skills.to_bonus(Skills.disarmingtraps) / 10) + $tpick_vars["Dex Bonus"] + (Spells.minorelemental / 4), 
    Skills.to_bonus(Skills.disarmingtraps)
  ].min
else
  $tpick_vars["Disarm Lore"] = 0
end

before_dying do
  $tpick_stats_data["Pool Time Spent Picking"] += (Time.now - $tpick_vars["Worker Start Time"]) if $tpick_vars["Worker Start Time"]
  
  DownstreamHook.remove("#{script.name}_check_locksmiths_container")
  DownstreamHook.remove("#{script.name}_check_for_mithril_or_enruned")
  
  if script.vars.any? { |i| i !~ /buy|repair|setup/i }
    containers_open_or_close = []
    containers_need_open_close = { 
      @load_data["Lockpick Container"]        => @load_data["Lockpick Close"],
      @load_data["Broken Lockpick Container"] => @load_data["Broken Close"],
      @load_data["Wedge Container"]           => @load_data["Wedge Close"],
      @load_data["Calipers Container"]        => @load_data["Calipers Close"],
      @load_data["Scale Weapon Container"]    => @load_data["Weapon Close"]
    }

    containers_need_open_close.each do |name, option|
      if name.to_s.strip.empty? == false && option == "Yes" && !containers_open_or_close.include?(name)
        containers_open_or_close.push(name)
      end
    end

    if !containers_open_or_close.empty?
      tpick_silent(nil, "I will close your containers as soon as you're out of RT then I will exit.") if checkrt > 0
      wait_until { checkrt.zero? }
      containers_open_or_close.each do |container_name|
        container_obj = GameObj.inv.find { |t| t.name == container_name }
        fput "close ##{container_obj.id}" if container_obj
      end
    end

    if $tpick_vars["Armor Removed"] && $tpick_vars["Armor To Remove"]
      tpick_silent(nil, "I will equip your armor as soon as you're out of RT then I will exit.") if checkrt > 0
      wait_until { checkrt.zero? }
      tpick_put_stuff_away
      fput "get #{$tpick_vars["Armor To Remove"]}"
      wait_until { checkright }
      fput "wear #{$tpick_vars["Armor To Remove"]}"
    end
  end

  TpickMain.save_the_stats

  border = "#" * 40
  if $tpick_vars["Error Message"]
    _respond "\n#{monsterbold_start}#{border}\n#{$tpick_vars["Error Message"]}\n#{border}#{monsterbold_end}\n"
  end
  if $tpick_vars["Crash Report"]
    _respond "\n#{monsterbold_start}#{border}\n#{$tpick_vars["Crash Report"]}\n#{border}#{monsterbold_end}\n"
  end
end

# =============================================================================
# Check if the box is mithril or enruned.
# =============================================================================
$tpick_check_mithril_or_enruned = proc do
  action = proc { |server_string|
    if server_string =~ /You glance down to see.*?(mithril|enruned|rune-incised)/i
      $tpick_vars["Hand Status"] = "mithril or enruned"
      DownstreamHook.remove("#{script.name}_check_for_mithril_or_enruned")
      nil
    elsif server_string =~ /You glance down.*?left hand/i
      $tpick_vars["Hand Status"] = "good"
      DownstreamHook.remove("#{script.name}_check_for_mithril_or_enruned")
      nil
    elsif server_string =~ /You glance down at your empty hands\./i
      $tpick_vars["Hand Status"] = "empty"
      DownstreamHook.remove("#{script.name}_check_for_mithril_or_enruned")
      nil
    else
      server_string
    end
    }
    DownstreamHook.add("#{script.name}_check_for_mithril_or_enruned", action)
    silence_me
    fput "#{$tpick_vars["Check For Command"]}"
    silence_me
end

# =============================================================================
# Handles message routing, updating the visual interface dashboard 
# and logging clean, bounded divider borders directly to the main game window.
# =============================================================================
def tpick_silent(flag, message)
  flag = true if @load_data["Run Silently"] == "No"
  return unless flag

  if message !~ /Putty remaining/
    $tpick_vars["Window Message"] = message
    TpickMain.update_tpick_var("Window Message", message)
  end

  if @load_data["Don't Show Messages"] == "No"
    border = "#" * 40
    _respond ""
    if @load_data["Use Monster Bold"] == "Yes"
      _respond "#{monsterbold_start}#{border}\n#{message}\n#{border}#{monsterbold_end}"
    else
      _respond "#{border}\n#{message}\n#{border}"
    end
    _respond ""
  end
end

# =============================================================================
# Relocks box if player chose this option.
# =============================================================================
def do_relock_boxes
  no_vaalin_picks
  waitrt?

  tpick_get_box

  fput "get ##{@all_pick_ids["Vaalin"].first}"
  fput "close ##{$tpick_vars["Current Box"].id}"
  fput "lm relock ##{$tpick_vars["Current Box"].id}"
    
  tpick_drop_box if $tpick_vars["Picking Mode"] == "ground"
  tpick_put_stuff_away
end

# =============================================================================
# Checks room conditions and player configurations to determine whether to 
# trash an opened box, drop it at a table, or stow it away.
# =============================================================================
def garbage_check
  waitrt?
  
  if @load_data["Trash Boxes"] == "Yes"
    if checkroom =~ /table|booth/i
      tpick_drop_box
      fput "clean table"
    else
      waitrt?
      throw_away = true

      if $tpick_vars["No Garbage In Room"]
        if $tpick_vars["No Garbage In Room"] == Room.current.id
          throw_away = false
        else
          $tpick_vars["No Garbage In Room"] = nil
        end
      end
      
      if throw_away
        tpick_get_box
        result = dothistimeout "trash ##{$tpick_vars["Current Box"].id}", 2, /You need to find|As you toss/
        
        if result =~ /You need to find/
          $tpick_vars["No Garbage In Room"] = Room.current.id
          tpick_drop_box
        elsif result =~ /As you toss/
          $tpick_vars["No Garbage In Room"] = nil
        elsif result.nil?
          tpick_drop_box
        end
      else
        tpick_drop_box
      end
    end
  else
    @tpick_stow_current_box = true
    tpick_get_box
    tpick_put_stuff_away
  end

  waitrt?
end

# =============================================================================
# Prepares and casts the Unlock spell (407) on plated or difficult locks.
# Incorporates Water Lore corrosion stacking mathematics to dynamically recalculate 
# lock difficulties on the fly and fallback to standard lockpicking when possible.
# =============================================================================
def cast_407
  if $tpick_vars["Current Box"].name =~ /mithril|enruned|rune-incised/i ||
     $tpick_vars["Box Is Enruned/Mithril"] ||
     @load_data["Unlock (407)"] == "Never" ||
     $tpick_vars["Stop Using 407"] ||
     $tpick_vars["Box Has Glyph Trap"]

    tpick_silent(true, "Can't open this plated box because it is mithril or enruned, or has a glyph trap, or because your settings are set to not use 407 to open boxes.") unless $tpick_vars["Stop Using 407"]

  else
    attempts = 0
    max_attempts = 75
	
    TpickMain.update_display_image("Chest 407", "Lockpick")
    TpickMain.update_window_label_text("#{$tpick_vars["Lock Difficulty"]} Lock", "Lockpick", "top")
    TpickMain.update_window_label_text("Unlock (407)", "Lockpick", "bottom")

    loop do
      attempts += 1
      if attempts > max_attempts
        tpick_silent(true, "Reached maximum 407 casting attempts. Aborting.")
        break
      end

      if @load_data["Unlock (407) Mana"] > -1
        $tpick_vars["Stop Using 407"] = nil
        if checkmana < maxmana * (@load_data["Unlock (407) Mana"] / 100.0)
          tpick_silent(nil, "According to your 407 settings your mana is too low to continue trying to open this box with 407.")
          $tpick_vars["Stop Using 407"] = true
          break
        end
      end

      tpick_cast_spells(515)

      if checkmana < 20
        tpick_silent(true, "Waiting for mana.")
        wait_until { checkmana >= 20 }
      end

      # Don't use 403 if using Water Lore Pick because it speeds up the process
	  # of corroding the lock by not having to cast 403 each time
      tpick_cast_spells(403) unless $tpick_vars["Use WLore Pick"] # Keep this check here and not in tpick_cast_spells so the player can still cast 403 in other instances

      tpick_prep_spell(407, "Unlock")
      fput "cast at ##{$tpick_vars["Current Box"].id}"
      
      box_opened_or_handled = nil

	  result = matchtimeout 1, "corroded the lock"

      while line = get
        sline = strip_xml(line)
        sline_down = sline.downcase

        if sline_down.include?("suddenly flies open") || sline_down.include?("is already open")
		  flag_box_opened
          box_opened_or_handled = true
		  pool_payment_watch
          break
        elsif sline_down.include?("vibrates slightly but nothing else happens")
          break

        elsif sline_down.include?("cast roundtime")
          break
        end
      end
	  
	  break if box_opened_or_handled
	  
      if result.to_s =~ /corroded the lock/i && @tpick_vars["Use WLore Pick"]
        $tpick_vars["Successful Lock Corrosions"] ||= 0
        $tpick_vars["Successful Lock Corrosions"] += 1
        $tpick_vars["Lock Corrosion Expires At"] = Time.now + 60

        if $tpick_vars["Lock Difficulty"]
          base   = $tpick_vars["Lock Difficulty"].to_i
          bonus  = $tpick_vars["WLore Rot Bonus"].to_i
          stacks = $tpick_vars["Successful Lock Corrosions"].to_i

          total_reduction = stacks * bonus
          max_reduction   = (base * 0.10).floor
          total_reduction = [total_reduction, max_reduction].min
          effective       = base - total_reduction

          $tpick_vars["Total Pick Skill"] = ($tpick_vars["Pick Skill"] + $tpick_vars["Pick Lore"]) * 2.50

          tpick_silent(
            nil,
            "Original Lock Difficulty: #{base}\n" \
            "Total Lock Corrosion: #{total_reduction}\n" \
            "Effective Lock Difficulty: #{effective}"
          )

          if effective <= $tpick_vars["Max Lock Attempt"]
            tpick_silent(nil, "Corrosion has reduced the lock enough to attempt picking.")
            $tpick_vars["Recommended Pick"] = "Vaalin"
            lock_pick_information
            pick_2
            box_opened_or_handled = true
            break 
          end
        end
	  end
    end
  end
end

# =============================================================================
# Calibrates calipers for Rogues.
# =============================================================================
def calibrate_calipers
  if !$rogue_do_not_calibrate_calipers
    loop do
      tpick_silent(nil, "Calibrating calipers.")
      unless tpick_ensure_held("my calipers", "calipers")
        tpick_silent(
          true,
          "To fix this issue enter ;tpick setup\n" \
          "Make sure your calipers container is filled out properly and that you have calipers.\n" \
          "If you don't want to use calipers then go to the 'Other' tab and uncheck the box for the setting 'Use Calipers.'"
        )
        exit
      end

      result = dothistimeout("lmas calibrate my calipers", 4, /You\'re good\, but you\'re not that good\.|You should leave them alone.|Roundtime/i)
      if result =~ /You\'re good\, but you\'re not that good\.|You should leave them alone./i
        tpick_put_stuff_away
        break
      elsif result =~ /Roundtime/i
        waitrt?
        if $tpick_vars["Can Use Calipers"]
          next
        else
          break
        end
      elsif result.nil?
        next
      end
    end
  end
end


# =============================================================================
# Needs to be at the beginning of every loop.
# Checks if the script needs to exit or break out of current loop.
# =============================================================================
def check_loop_status
  exit if $tpick_exit_tpick_immediately
  
  if $tpick_stop_immediately
    return true
  end
  
  clear_box_variables
  return false
end

# =============================================================================
# Main loop for ground picking mode.
# Iterates through all available loot items on the floor,
# verifies disarm/pick configurations, handles specialized
# automation profiles, and loops to check for missed boxes.
# =============================================================================
def start_ground
  loop{
    total_boxes_count
    GameObj.loot.each do |box|
      break if check_loop_status
      
      next unless box.type =~ /box/ && !$tpick_vars["Box IDs Already Picked"].include?(box.id)

      $tpick_vars["Box IDs Already Picked"].push(box.id)
      TpickMain.update_box_for_window
      tpick_stop_403_404
      need_rest_check
      waitrt?

      $tpick_vars["Start Time"] = Time.now
      $tpick_vars["Current Box"] = box
      $tpick_vars["Manual Trap Checks Remaining"] = @load_data["Trap Check Count"].dup
  
      if $tpick_vars["Pop Boxes"]
        pop_boxes_begin
      elsif $tpick_vars["Bash Open Boxes"]
        if $tpick_vars["Disarm Only"]
          if $tpick_vars["Gnomish Bracers"] && @load_data["Bracer Tier 2"] == "Yes"
            gnomish_bracers_trap_check
          else
            manually_disarm_trap
          end
        else
          bash_the_box_open
        end
      else
        if $tpick_vars["Gnomish Bracers"] && @load_data["Bracer Tier 2"] == "Yes"
          gnomish_bracers_trap_check
        else
          manually_disarm_trap
        end
      end
  
      final_box_actions
    end
  
    break if check_loop_status
    if $tpick_vars["Check Ground Again"]
      $tpick_vars["Check Ground Again"] = nil
      tpick_silent(true, "Checking for boxes I might have missed.")
      $tpick_vars["Box Math"] = nil
    else
      tpick_silent(true, "All done!")
      tpick_silent(true, "Couldn't open #{$tpick_vars["Can't Open Box Count"]} boxes, which are still on the ground.") if $tpick_vars["Can't Open Box Count"].to_i > 0
	  break
    end
  }
  
  $tpick_vars["Check Ground Again"]     = true
  $tpick_vars["Box IDs Already Picked"] = []
end

# =============================================================================
# Ensures the needed item is in hand.
# =============================================================================
def tpick_ensure_held(target, fallback_name = "item")
  3.times do
    waitrt?

    if target.is_a?(Integer) || (target.is_a?(String) && target =~ /^\d+$/)
      return true if GameObj.right_hand.id == target || GameObj.left_hand.id == target
      get_command = "get ##{target}"
    else
      return true if GameObj.right_hand.name =~ /#{fallback_name}/i || GameObj.left_hand.name =~ /#{fallback_name}/i
      get_command = "get #{target}"
    end

    fput get_command
    10.times do
      if target.is_a?(Integer)
        break if GameObj.right_hand.id == target || GameObj.left_hand.id == target
      else
        break if GameObj.right_hand.name =~ /#{fallback_name}/i || GameObj.left_hand.name =~ /#{fallback_name}/i
      end
      sleep 0.1
    end
  end

  if target.is_a?(Integer)
    still_missing = (GameObj.right_hand.id != target && GameObj.left_hand.id != target)
  else
    still_missing = (GameObj.right_hand.name !~ /#{fallback_name}/i && GameObj.left_hand.name !~ /#{fallback_name}/i)
  end
  
  if still_missing
    tpick_silent(true, "Couldn't find your #{fallback_name}.")
    return false
  end
  true
end

# =============================================================================
# Adds pool payment info after finishing a box.
# =============================================================================
def pool_payment_received(silvers)
  $tpick_stats_data["Pool Tips Silvers"]       += silvers
  $tpick_session_data["Silver"]                += silvers
  $tpick_stats_data["Pool Boxes Picked"]       += 1
  $tpick_session_data["Session Boxes Picked"]  += 1
end

# =============================================================================
# Tracks when the game automatically turns in your
# pool box without you having to ask the NPC to check it.
# =============================================================================
def pool_payment_watch
  if $tpick_vars["Picking Mode"] == "worker"
    line = matchtimeout(2, "quality work")
    if line.to_s =~ /"That's some quality work\.  Here's your payment of (.*?) silvers?\."/
      silvers = $1.delete(",").to_i
	  pool_payment_received(silvers)
      $tpick_vars["Do Not Ask To Check"]            = true
    end
  end
end

# =============================================================================
# Updates image and text when a wedge is being used.
# =============================================================================
def update_wedge_image
  TpickMain.update_display_image("Chest Wedge", "Lockpick")
  TpickMain.update_window_label_text("#{$tpick_vars["Lock Difficulty"]} Lock", "Lockpick", "top")
  TpickMain.update_window_label_text("Wedge", "Lockpick", "bottom")
end

# =============================================================================
# Attempts to force a lock open using Lock Mastery wedges (Rogue only),
# falling back to the 407/Unlock spell or giving up if tools are missing or unavailable.
# =============================================================================
def wedge_lock
  tpick_put_stuff_away
  update_wedge_image
  loop do
    waitrt?
    tpick_get_box

    has_wedge = false
    if Stats.prof == 'Rogue'
      has_wedge = tpick_ensure_held("my wedge", "wedge")
    end

    if !has_wedge || $tpick_cannot_use_wedges
      if $tpick_vars["Use A Wedge"]
        tpick_silent(true, "Currently working on a ;rogues task for using a wedge but you appear to be out of wedges.\n;tpick will now exit and ;rogues will create more wedges then start ;tpick again.")
        exit
      else
        if @load_data["Unlock (407)"] == "Never" || !Spell[407].known?
          tpick_silent(true, "Couldn't open this box.")
        else
          message_text = (Stats.prof == 'Rogue') ? "Couldn't find any wedges, going to try popping this box." : "Going to try popping this box."
          tpick_silent(nil, message_text)
          cast_407
        end
        break
      end
    else
      result = dothistimeout("lmaster wedge ##{$tpick_vars["Current Box"].id}", 3, /What do you expect to wedge it with|(suddenly splits away from the casing|Why bother)|Please specify an appropriate skill\.|Roundtime/i)
      
      if result =~ /What do you expect to wedge it with/i
        tpick_put_stuff_away
        next
      elsif result =~ /(suddenly splits away from the casing|Why bother)/i
        pool_payment_watch
        flag_box_opened
        tpick_put_stuff_away
        break
      elsif result =~ /Please specify an appropriate skill\./
        $tpick_cannot_use_wedges = true
        next
      elsif result =~ /Roundtime/i || result.nil?
        next
      end
    end
  end
end

# =============================================================================
# Final commands to issue for every box.
# =============================================================================
def final_box_actions
  total_boxes_picked_math unless $tpick_vars["Picking Mode"] == "worker"
  waitrt?
  
  box = $tpick_vars["Current Box"]

  # =============================================================================
  # Issue final commands depending on picking mode.
  # =============================================================================
  case $tpick_vars["Picking Mode"]
  when "solo"
    if $tpick_vars["Box Opened"]
      tpick_cast_spells(506)
      tpick_cast_spells(1035)	
      fput "open ##{box.id}" unless $tpick_vars["Pop Boxes"]

      (dothistimeout "look in ##{box.id}", 10, /In .*? you see|In the .*\:|There is nothing in/) if box.contents.nil?
      fput "loot ##{box.id}" if @load_data["Use Loot"] == "Yes" && box.contents.none? { |item| item.type =~ /cursed/ }
  
      waitrt?
      fput "swap"
  
      box.contents.each do |item|
        $tpick_vars["Current Item"] = item
        tpick_gather_the_loot
      end
	  finishing_box_commands
	else
	  where_to_stow_box
	end
	
    tpick_put_stuff_away
    sleep 0.1
  when "other"
    tpick_say("Can't Open Box") unless $tpick_vars["Box Opened"]
    fput "give ##{box.id} to #{$tpick_vars["Customer"]}"
    waitfor "has accepted your offer" if GameObj.right_hand&.id == box.id
  when "ground"
    if $tpick_vars["Ground Loot"]
      encumbrance_check if @load_data["Auto Deposit Silvers"].to_s.strip.empty? == false
      
      if $tpick_vars["Bash Open Boxes"] && !$tpick_vars["Bash Check Box Not Locked"]
        fput "loot room" if @load_data["Use Loot"] == "Yes" && GameObj.loot.none? { |item| item.type =~ /cursed/ }
        sleep 0.1
        GameObj.loot.each do |item|
          $tpick_vars["Current Item"] = item
          tpick_gather_the_loot
        end
      elsif $tpick_vars["Box Opened"]
        waitrt?
        tpick_cast_spells(506)
        tpick_cast_spells(1035)
        fput "open ##{box.id}" unless $tpick_vars["Pop Boxes"]

        (dothistimeout "look in ##{box.id}", 10, /In .*? you see|In the .*\:|There is nothing in/i) if box.contents.nil?
        fput "loot ##{box.id}" if @load_data["Use Loot"] == "Yes" && box.contents.none? { |item| item.type =~ /cursed/ }
        
        box.contents.each do |item|
          $tpick_vars["Current Item"] = item
          tpick_gather_the_loot
        end
		
		finishing_box_commands
      end
    else
      unless $tpick_vars["Pop Boxes"]
        fput "open ##{box.id}" if $tpick_vars["Box Opened"] && !$tpick_vars["Disarm Only"] && @load_data["Open Boxes"] == "Yes"
      end
    end
	
	tpick_drop_box
    tpick_put_stuff_away
    $tpick_vars["Can't Open Box Count"] += 1 unless $tpick_vars["Box Opened"]
  when "worker"
    $tpick_vars["Give Up On Box"] = true unless $tpick_vars["Box Opened"]
  end

  # =============================================================================
  # Revert images and labels back to Idle.
  # =============================================================================
  TpickMain.update_display_image("Trap Idle", "Traps")
  TpickMain.update_window_label_text("Idle", "Traps", "bottom")
  
  TpickMain.update_display_image("Lockpick Idle", "Lockpick")
  TpickMain.update_window_label_text("", "Lockpick", "top")
  TpickMain.update_window_label_text("Idle", "Lockpick", "bottom")

  # =============================================================================
  # Updates pool picking time and updates all stats shown in Information window.
  # =============================================================================
  if $tpick_vars["Worker Start Time"]
    $tpick_stats_data["Pool Time Spent Picking"] += (Time.now - $tpick_vars["Worker Start Time"])
    $tpick_vars["Worker Start Time"] = Time.now
  end

  Gtk.queue { TpickMain.set_stat_info }
end

# =============================================================================
# Helper to do some final commands for an opened box.
# =============================================================================
def finishing_box_commands
  $tpick_stats_data["Boxes Looted"] += 1
  do_relock_boxes if $tpick_vars["Relock Boxes"]
  garbage_check
end

# =============================================================================
# Automatically upgrades the active lockpick tier
# if a lower quality lockpick fails or breaks.
# =============================================================================
def next_pick
  tpick_put_stuff_away

  loop do
    $tpick_vars["Before Needed Pick"] = $tpick_vars["Needed Pick"]
    $tpick_vars["Before Pick"]        = $tpick_vars["Recommended Pick"]
    
    current_pick = $tpick_vars["Recommended Pick"]
    current_idx  = LOCKPICK_TIERS.index(current_pick)

    if current_pick == "Vaalin"
      if $tpick_vars["Roll Amount"] == 100
        $tpick_vars["Needed Pick"] = "wedge"
      else
        $tpick_vars["403 Needed"]     = true unless $tpick_vars["Never Cast 403"]
        $tpick_vars["Needed Pick"]    = @load_data["Vaalin"]
        $tpick_vars["Needed Pick ID"] = @all_pick_ids["Vaalin"].first
      end
    elsif current_idx
      next_tier                     = LOCKPICK_TIERS[current_idx + 1]
      $tpick_vars["Needed Pick"]    = @load_data[next_tier]
      $tpick_vars["Needed Pick ID"] = @all_pick_ids[next_tier].first
      $tpick_vars["Recommended Pick"] = next_tier
    end

    no_vaalin_picks

    if !$tpick_vars["Needed Pick ID"]
      if $tpick_vars["Recommended Pick"] == "Vaalin"
        tpick_silent(true, "ALL OF YOUR VAALIN LOCKPICKS ARE BROKEN. YOU REALLY SHOULD HAVE AT LEAST 1 WORKING VAALIN LOCKPICK WHEN RUNNING THIS SCRIPT.")
        exit
      else
        tpick_silent(true, "All of your #{$tpick_vars["Recommended Pick"]} lockpicks seem to be broken or you don't have any lockpicks of that type, trying a higher tier lockpick.")
        next 
      end
    elsif $tpick_vars["Before Needed Pick"] == $tpick_vars["Needed Pick"] && $tpick_vars["Recommended Pick"] != "Vaalin"
      next 
    else
      nextpick2
      break
    end
  end
end

# =============================================================================
# Handles what to do when the player has no vaalin lockpicks.
# =============================================================================
def no_vaalin_picks
  if !$tpick_vars["Pop Boxes"] || ($tpick_vars["Pop Boxes"] && @load_data["Pick Enruned"] == "Yes")
    if (@all_pick_ids["Vaalin"].first.nil? || @all_pick_ids["Vaalin"].empty?) && $tpick_vars["Picking Mode"]
      $tpick_vars["Error Message"] = "I could not find any of your Vaalin Lockpicks. You need at least 1 Vaalin Lockpick (any lockpick you enter into the 'Vaalin Lockpick' setting) for this script to run correctly.\n\n" \
                                     "Check ;tpick setup to be sure 'Vaalin Lockpick' and 'Lockpick Container' are filled out correctly and be sure you have your Vaalin Lockpick in your Lockpick container.\n\n" \
                                     "It is also possible that all of your Vaalin lockpicks are broken, you should repair or replace them in that case."
      exit
    end
  end
end

# =============================================================================
# Handles plated traps.
# =============================================================================
def plate_trap_disarm
  # Checks if the player is working on a
  # Rogue guild task via using the script ;rogues
  if @rogue_current_task == "Wedge open boxes" && @rogue_automate_current_task_with_tpick && $tpick_vars["Picking Mode"] == "worker"
    tpick_silent(true, "Working on a ;rogues task to use wedges so I'm going to use a wedge on this box.")
    $tpick_vars["Use A Wedge"] = true
    wedge_lock
  else
    if @load_data["Unlock (407)"] == "Vial" && $tpick_vars["Current Box"].name !~ /mithril|enruned|rune-incised/i && !$tpick_vars["Box Is Enruned/Mithril"]
      tpick_silent(nil, "According to your settings you want to use 407 on non-enruned/mithril plated boxes.")
      cast_407
    else
      tpick_silent(nil, "Disarming trap.")
      
      attempts = 0
      max_attempts = 10

      loop do
        attempts += 1
        if attempts > max_attempts
          tpick_silent(true, "Reached maximum plated trap disarm attempts. Aborting.")
          break
        end

        waitrt?
        tpick_cast_spells(1035)
        tpick_cast_spells(506)
        
        if $tpick_vars["Always Use Wedge"]
          wedge_lock
          break
        else
          tpick_cast_spells(404)
          tpick_cast_spells(506)
          
          result = dothistimeout("disarm ##{$tpick_vars["Current Box"].id}", 3, /You try to pour .* onto the .*\, but it just won\'t pour\!|the metal plate covering the lock begins to melt away|but it appears to have been melted through|Gonna chew through it|The darn thing is built too tightly|You still have a good enough picture of the trap in your mind/i)
          
          if result =~ /the metal plate covering the lock begins to melt away|but it appears to have been melted through/i
		    text = "Plate Trap Disarmed"
		    $tpick_vars["Current Trap Type"] = text
            TpickMain.update_window_label_text(text, "Traps", "bottom")
            TpickMain.update_display_image(text, "Traps")
            measure_lock
            break

          elsif result =~ /Gonna chew through it/i
            tpick_silent(nil, "No vials found bundled in your locksmith's container, going to look for loose vials in your locksmith's container.")
            get_vials_and_stuff
            break

          elsif result =~ /The darn thing is built too tightly|You still have a good enough picture of the trap in your mind/
            next

          elsif result =~ /You try to pour .* onto the .*\, but it just won\'t pour\!/
            tpick_silent(true, "THIS IS A BUG WITH THE GAME: IT IS TRYING TO POUR YOUR LOCKSMITH'S CONTAINER ON THE BOX. Looking for loose vials in your locksmith's container.")
            get_vials_and_stuff
            break

          elsif result.nil?
            $tpick_vars["Number Of Vial Disarm Tries"] ||= 0
            $tpick_vars["Number Of Vial Disarm Tries"] += 1
            
            if $tpick_vars["Number Of Vial Disarm Tries"] >= 3
              tpick_silent(true, "TRIED 3 TIMES TO DISARM THIS TRAP WITH VIALS BUNDLED IN YOUR LOCKSMITH'S CONTAINER. GIVING UP AND MOVING ON. Looking for loose vials in your locksmith's container.")
              get_vials_and_stuff
              break
            else
              next
            end
          end
        end
      end
    end
  end
end

# =============================================================================
# measure_lock and all of its helper methods.
# Handles how the player has chosen to open a box (wedge, 407, etc)
# and gets the lock difficulty (if the character is able to) then
# determines which lockpick to use.
# =============================================================================
def measure_lock
  tpick_put_stuff_away
  $tpick_vars["Always Use Vaalin"] = nil if $rogue_need_to_measure_boxes
  need_rest_check if $tpick_vars["Picking Mode"] == "solo"
  waitrt?
  tpick_cast_spells(506)
  tpick_cast_spells(1035)
  $tpick_vars["Recommended Pick"] = nil
  
  check_use_403_based_on_level
  
  check_to_use_wedge
  
  if $tpick_vars["Use A Wedge"]
    wedge_lock
  elsif @rogue_automate_current_task_with_tpick && $tpick_vars["Picking Mode"] == "worker" && @rogue_current_task == "Repair broken lockpicks"
    rogue_task_break_lockpick
  elsif @rogue_automate_current_task_with_tpick && $tpick_vars["Picking Mode"] == "worker" && !$tpick_vars["True Lock Difficulty"] && @load_data[";rogues Lockpick"].to_s.strip.empty? == false && !(@load_data["Use Calipers"] == "Yes" && $tpick_vars["Can Use Calipers"]) && @rogue_current_task !~ /Measure then pick tough boxes|Calibrate calipers in the field|Gather trap components|Melt open plated boxes/
    automate_current_rogue_task
  elsif @load_data["Unlock (407)"] == "All"
    tpick_silent(nil, "Always use 407 setting enabled, using 407.")
    if $tpick_vars["Scale Trap Found"]
	  tpick_silent(true, "Can't open a scales trap with 407.")
    else
      tpick_get_box
      cast_407
    end
  elsif $tpick_vars["Picks For Critter Level"] && $tpick_vars["Picking Mode"] == "worker" && !$tpick_vars["True Lock Difficulty"]
    handle_lockpick_based_on_critter_level
  elsif @load_data["Use Vaalin When Fried"] == "Yes" && percentmind >= 100
    tpick_silent(nil, "Always use Vaalin when fried enabled, using a Vaalin lockpick.")
    $tpick_vars["Box Math"] = nil
    $tpick_vars["Recommended Pick"] = "Vaalin"
    lock_pick_information
    $tpick_vars["403 Needed"] = true unless $tpick_vars["Never Cast 403"]
    pick_2
  elsif $tpick_vars["Start With Copper"] && !$tpick_vars["True Lock Difficulty"]
    tpick_silent(nil, "Start with copper option enabled, starting with lockpick in your copper lockpick setting.")
    $tpick_vars["Recommended Pick"] = "Copper"
    lock_pick_information
    pick_2	
  else
    waitrt?
    if !$tpick_vars["True Lock Difficulty"]
      $tpick_vars["Number Of Times To Measure"] = 0
      measure_detection
      fput "speak common" if Stats.prof == 'Bard'
      if Stats.prof == 'Rogue'
        tpick_put_stuff_away
      elsif Stats.prof == 'Bard' && $tpick_vars["Picking Mode"] == "ground"
        tpick_drop_box
      end
    end
    number = 0
    $tpick_vars["Needed Pick"] = nil
    $tpick_vars["Needed Pick ID"] = nil
    if $tpick_vars["Lock Difficulty"] == "not locked"
      flag_box_opened
      $tpick_vars["Box Math"] = nil
    elsif $tpick_vars["Lock Difficulty"] == "can't find trap"
      $tpick_vars["Box Math"] = nil
	  tpick_silent(true, "Doesn't look like you have the skill to detect the trap on this box.")
    elsif $tpick_vars["Lock Difficulty"] == "can't measure"
      tpick_silent(true, "You can't determine the lock difficulty.")
      if $tpick_vars["Scale Trap Found"]
        tpick_silent(true, "This box has a scales trap therefore it can't be popped or wedged. Skipping box.")
        $tpick_vars["Box Math"] = nil
		tpick_silent(true, "This box has a scales trap therefore it can't be popped or wedged. Skipping box.")
      else
        tpick_silent(true, "Going to try wedging this box open since the lock difficulty can't be determined.")
        wedge_lock
      end
    elsif $tpick_vars["Lock Difficulty"] == "need vaalin"
      $tpick_vars["Recommended Pick"] = "Vaalin"
      lock_pick_information
      temp_math_number = $tpick_vars["Pick Skill"].to_i
      quick_maths = (temp_math_number * $tpick_vars["Recommended Pick Modifier"].to_f).truncate
      tpick_silent(nil, "Recommended lock pick: #{$tpick_vars["Recommended Pick"]} with a modifier of #{$tpick_vars["Recommended Pick Modifier"]}\nRecommend 403: No\nYour calculated lockpicking skill: #{$tpick_vars["Pick Skill"]}\nYour total picking skill for this attempt is: #{quick_maths}\nLock difficulty: #{$tpick_vars["Lock Difficulty"]}")
      pick_2
    elsif $tpick_vars["Lock Difficulty"] == "Soul Golem" && $tpick_vars["Give Up On Box"]
      tpick_silent(true, "Message indicates this box is trapped. Normally this means this is a Soul Golem box but the worker didn't say this was from a Soul Golem. To be on the safe side I am turning this box in and moving on.")
    else
      $tpick_vars["Total Pick Skill"] = ($tpick_vars["Pick Skill"].to_i + $tpick_vars["Pick Lore"].to_i) * 2.50
      if $tpick_vars["Max Lock Compared To Skill"] && $tpick_vars["Lock Difficulty"].to_i > ($tpick_vars["Total Pick Skill"] - $tpick_vars["Max Lock Attempt"].to_i)
        if $tpick_vars["Scale Trap Found"]
		  tpick_silent(true, "Lock difficulty: #{$tpick_vars["Lock Difficulty"]}, your max picking skill with a Vaalin lockpick: #{$tpick_vars["Total Pick Skill"]}, you won't pick anything higher than #{$tpick_vars["Max Lock Attempt"]} points below your max skill according to the Max Lock setting in the ;setup menu. This box also has a scales trap so can't be popped or wedged open. Skipping box.")
        else
          tpick_silent(true, "Lock difficulty: #{$tpick_vars["Lock Difficulty"]}, your max picking skill with a Vaalin lockpick: #{$tpick_vars["Total Pick Skill"]}, you won't pick anything higher than #{$tpick_vars["Max Lock Attempt"]} points below your max skill according to the Max Lock setting in the ;setup menu so a lockpick won't be used.")
          wedge_lock
        end
      elsif $tpick_vars["Lock Difficulty"].to_i > $tpick_vars["Max Lock Attempt"].to_i && !$tpick_vars["Max Lock Compared To Skill"]
        if $tpick_vars["Scale Trap Found"]
		  tpick_silent(true, "This lock is higher than the Max Lock setting you entered in the ;setup menu so a lockpick won't be used. This box also has a scales trap so can't be popped or wedged open. Skipping box.")
        else
          tpick_silent(true, "This lock is higher than the Max Lock setting you entered in the ;setup menu so a lockpick won't be used.")
          wedge_lock
        end
      else
        if $tpick_vars["Lock Difficulty"].to_i > ($tpick_vars["Total Pick Skill"] + @load_data["Vaalin Lock Roll"].to_i)
          if $tpick_vars["Scale Trap Found"]
		    tpick_silent(true, "Can't pick this box based on my calculations (and it has a scales trap.) If you think this is in error increase the Vaalin Lock Roll setting in the setup menu. Skipping box.")
          else
            tpick_silent(true, "Can't pick this box based on my calculations. If you think this is in error increase the Vaalin Lock Roll setting in the setup menu.")
            wedge_lock
          end
        else
		  if $tpick_vars["Always Use Vaalin"]
		    tpick_silent(nil, "Always use Vaalin setting enabled, using a Vaalin lockpick.")
            $tpick_vars["Recommended Pick"] = "Vaalin"
            lock_pick_information
            $tpick_vars["403 Needed"] = true unless $tpick_vars["Never Cast 403"]
		  else
            calculate_needed_lockpick
		  end
		  
          text = "Recommended lock pick: #{$tpick_vars["Recommended Pick"]} with a modifier of #{$tpick_vars["Recommended Pick Modifier"]}\n"
          
          if $tpick_vars["403 Needed"]
            if $tpick_vars["Use 403 For Lock Difficulty"] && $tpick_vars["Lock Difficulty"].to_i > $tpick_vars["Use 403 For Lock Difficulty"].to_i
              text += "Lock difficulty is higher than your 403 setting in setup menu, using 403.\n"
            else
              text += "Recommend 403: Yes\n"
            end
            text += "Your calculated lockpicking skill: #{$tpick_vars["Pick Skill"]}\n" \
                    "Your calculated lockpicking lore: #{$tpick_vars["Pick Lore"]}\n"
            temp_math_number = $tpick_vars["Pick Skill"].to_i + $tpick_vars["Pick Lore"].to_i
          else
            text += "Recommend 403: No\n" \
                    "Your calculated lockpicking skill: #{$tpick_vars["Pick Skill"]}\n"
            temp_math_number = $tpick_vars["Pick Skill"].to_i
          end
          
          quick_maths = (temp_math_number * $tpick_vars["Recommended Pick Modifier"].to_f).truncate
          text += "Your total picking skill for this attempt is: #{quick_maths}\n" \
                  "Lock difficulty: #{$tpick_vars["Lock Difficulty"]}"
          tpick_silent(nil, text)
          
          if !$tpick_vars["Needed Pick ID"]
            if $tpick_vars["Recommended Pick"].to_s.capitalize == "Vaalin"
              tpick_silent(true, "ALL OF YOUR VAALIN LOCKPICKS ARE BROKEN. YOU REALLY SHOULD HAVE AT LEAST 1 WORKING VAALIN LOCKPICK WHEN RUNNING THIS SCRIPT.")
              exit
            else
              tpick_silent(true, "All of your #{$tpick_vars["Recommended Pick"]} lockpicks seem to be broken, trying a higher tier lockpick.")
            end
            next_pick
          else
            pick_2
          end
        end
      end
    end
  end
end
# =============================================================================

def check_use_403_based_on_level
  if @load_data["Use 403 On Level"] != 200
    if !$tpick_vars["Critter Level"]
      tpick_silent(nil, "Critter level unknown, using 403 based on your settings.")
      $tpick_vars["403 Needed"] = true
    elsif @load_data["Use 403 On Level"] <= $tpick_vars["Critter Level"]
      tpick_silent(nil, "Critter level is #{$tpick_vars["Critter Level"]}, using 403 based on your settings.")
      $tpick_vars["403 Needed"] = true
    end
  end
end
# =============================================================================

def check_to_use_wedge
  $tpick_vars["Use A Wedge"] = nil
  if @rogue_current_task == "Wedge open boxes" && @rogue_automate_current_task_with_tpick && $tpick_vars["Picking Mode"] == "worker"
    required_plated_boxes = 0
    fput "gld"
    while line = get
      if line =~ /The Training Administrator told you to wedge open some boxes\./
        while line = get
          if line =~ /At least (\d+) more should have a plated lock or fused tumblers\, or be out of your league with a pick\./
            required_plated_boxes = $1.to_i
          elsif line =~ /You have (.*) repetitions? remaining (?:for|to complete) this task\./
            total_reps_remaining = ($1 == "no") ? 0 : $1.to_i
            break
          end
        end
        break
      end
    end
    
    if $tpick_vars["Current Trap Type"] != "Scales"
      if required_plated_boxes == total_reps_remaining
        tpick_silent(true, "Either no more plated boxes or only plated boxes are required for your task.\nTherefore I am not using a wedge on this box.")
        $tpick_vars["Use A Wedge"] = nil
      elsif required_plated_boxes != total_reps_remaining || required_plated_boxes.zero?
        tpick_silent(true, "Non-plated boxes are required to get a rep for your current task.\nTherefore I am using a wedge on this box.")
        $tpick_vars["Use A Wedge"] = true
      end
    end
  end
end
# =============================================================================

def rogue_task_break_lockpick
  tpick_silent(true, "Trying to break a lockpick.")
  $tpick_vars["Always Use Vaalin"] = nil
  if $tpick_vars["Lockpicks To Break For Rogue"].empty?
    @tpick_finished_with_current_rogue_task = true
    exit
  else
    until checkright
      break if $tpick_vars["Lockpicks To Break For Rogue"].empty?
      waitrt?
      fput "get ##{$tpick_vars["Lockpicks To Break For Rogue"].first}"
      sleep 0.2
    end
  end
  pick_3
end
# =============================================================================

def automate_current_rogue_task
  if $rogue_change_needed_lockpick
    all_lockpicks = LOCKPICK_TIERS.map(&:downcase)
    number = all_lockpicks.index(@load_data[";rogues Lockpick"].downcase) || 0
    $rogue_change_needed_lockpick = nil
    @load_data[";rogues Lockpick"] = all_lockpicks[number + 1] || "vaalin"
  end
  tpick_silent(true, ";tpick is automating your current ;rogues task.\n;tpick will use the lockpick in the 'Lockpick' setting under the ';rogues integration' tab.\n;rogues will automatically adjust this setting as necessary.")
  $tpick_vars["Always Use Vaalin"] = nil
  $tpick_vars["Recommended Pick"] = @load_data[";rogues Lockpick"].capitalize
  lock_pick_information
  pick_2
end
# =============================================================================

def handle_lockpick_based_on_critter_level
  $tpick_vars["Needed Pick"] = nil
  if !$tpick_vars["Critter Level"]
    $tpick_vars["Recommended Pick"] = "Vaalin"
  else
    $tpick_vars["Picks For Critter Level"].each do |i|
      $tpick_vars["Temp Picks Critter Level"] = i.split(" ")
      if $tpick_vars["Temp Picks Critter Level"][0].to_i >= $tpick_vars["Critter Level"]
        $tpick_vars["Recommended Pick"] = $tpick_vars["Temp Picks Critter Level"][1].to_s.capitalize
        break
      end
    end
  end
  $tpick_vars["Recommended Pick"] ||= "Vaalin"
  lock_pick_information
  
  if $tpick_vars["Critter Level"]
    tpick_silent(nil, "Critter level is #{$tpick_vars["Critter Level"]}, using a #{$tpick_vars["Recommended Pick"]} lockpick based on your settings.")
  else
    tpick_silent(nil, "Critter level is unknown, using a #{$tpick_vars["Recommended Pick"]} lockpick.")
  end
  pick_2
end
# =============================================================================

# =============================================================================
# Ensures the correct lockpick is fetched and held in hand.
# Routes through specialized Gnomish Bracer mechanics if active,
# otherwise loops to draw the correct lockpick from your inventory.
# =============================================================================
def pick_2
  waitrt?
  
  if $tpick_vars["Gnomish Bracers"] && @load_data["Bracer Override"] == "No"
    find_gnomish_lockpick
  else
    # Get needed lockpick and verify it's in hand
    if tpick_ensure_held($tpick_vars["Needed Pick ID"], $tpick_vars["Needed Pick"])
      pick_3
    else
      waitrt?
      $tpick_vars["Roll Amount"] = 100
      next_pick
    end
  end
end

# =============================================================================
# Flags the box as opened.
# Scales traps are picked first and THEN disarmed.
# Therefore a Scales trap isn't safe or considered "opened" until
# after it has been disarmed.
# =============================================================================
def flag_box_opened(force = false)
  not_safe_traps = ["Scales", "Scales trap found, need to use dagger to disarm."]
  
  if force || !not_safe_traps.include?($tpick_vars["Current Trap Type"])
    $tpick_vars["Box Opened"] = true
  end
end

# =============================================================================
# pick_3 and all of its helper methods.
# Loop for handling picking a lock.
# Handles plinite extractions and picking box locks.
# Manages 403 and routes to the needed part of code based on outcome.
# =============================================================================
def pick_3
  is_plinite = $tpick_vars["Open Plinites"] || $tpick_vars["Current Box"].name =~ /plinite/i
  
  if is_plinite
    tpick_silent(nil, "Attempting to extract plinite.")
  else
    tpick_silent(nil, "Attempting to pick lock.")
  end
  
  start_of_loop_pick3
  
  loop do
    if is_plinite
      fput "extract ##{$tpick_vars["Current Box"].id}"
    elsif $tpick_vars["Gnomish Bracers"] && @load_data["Bracer Override"] == "No"
      tpick_get_box
      fput "push my #{$tpick_vars["Gnomish Bracers"]}"
    else
      if $rogue_trick_to_use
        $tpick_vars["Do Trick"] = "lmas ptrick #{$rogue_trick_to_use}"
      elsif @load_data["Trick"] == "random"
        random_trick = ["spin", "twist", "turn", "twirl", "toss", "bend", "flip"].sample
        $tpick_vars["Do Trick"] = "lmas ptrick #{random_trick}"
      end
      
      wait_until { checkrt == 0 }

      handle_wlore_pick
	  
      fput "#{$tpick_vars["Do Trick"]} ##{$tpick_vars["Current Box"].id}"
    end
    
    if is_plinite
	  handle_pick_plinite
    else
      flip_trick_is_being_used = nil
      while line = get
        sline = strip_xml(line)
        sline_down = sline.downcase
        
        if sline_down.include?("quietly turn the tumblers")
          flip_trick_is_being_used = true
          
        elsif sline_down.include?("(d100")
          if sline =~ /^You make .*? attempt \(d100(?:\(open\))?\=(\d+)\)\./i
            $tpick_vars["Roll Amount"] = $1.to_i
            $tpick_vars["Next Task"] = "TryAgain" if $tpick_vars["Roll Amount"] == 1
          end
          
        # =====================================================================
        #  SUCCESS: Box has been opened successfully or was already unlocked.
        # =====================================================================
        elsif sline_down.include?("click!") || sline_down.include?("snap open") || sline_down.include?("not appear to be locked")
          if sline =~ /^You struggle with the .*?\.  As you do\, you get a sense that the .*? has .*? \(\-(\d+) thief\-lingo difficulty ranking\)\.  Then\.\.\.CLICK\!  It opens\!|^The .*? gives off an audible \*click\* as the tumblers snap open\.|^It does not appear to be locked\./i
		    handle_lockpick_success(sline, sline_down)
            break
          end
          
        # =====================================================================
        # No read from the box.
        # =====================================================================
        elsif sline_down.include?("learn little about it")
		  handle_no_read(sline, sline_down)
          break
          
        # =====================================================================
        # Lock is partially responsive (Pick is adequate).
        # =====================================================================
        elsif sline_down.include?("within your abilities") || sline_down.include?("difficulty lock") || sline_down.include?("difficulty ranking")
          if sline =~ /^You are not able to pick the .*?\, but you get a sense that it has .*? lock\.  About a \-(\d+) difficulty lock \(in thief\-lingo\)\.|^You are not able to pick the lock\, but you get a feeling that it is within your abilities\./i ||
             (sline =~ /^You get a sense that the .*? \(\-(\d+) thief\-lingo difficulty ranking\)\./i && flip_trick_is_being_used.nil?)
                
            handle_pick_is_adequate(sline, sline_down)
            break unless sline =~ /^You get a sense that the .*? \(\-(\d+) thief\-lingo difficulty ranking\)\./i
          end
          
        # =====================================================================
        # Lockpick has been bent or slightly damaged.
        # =====================================================================
        elsif sline_down.include?("bending the tip") || sline_down.include?("weakened by the stress") || sline_down.include?("steady your")
          if sline =~ /^Your .*? gets stuck in the lock\!  You carefully try to work it free but end up bending the tip\!|^Your .*? gets stuck in the lock\!  You carefully try to work it free\, but it may have been weakened by the stress\.|Tiny .*? shoot out of your .*? to steady your .*? before you do any damage!/i
		    handle_pick_damaged(sline, sline_down)
            break
          end
          
        # =====================================================================
        # Lockpick has snapped or broken completely.
        # =====================================================================
        elsif sline_down.include?("* snap ") || sline_down.include?("using a broken") || sline_down.include?("snapping off the tip")
          if sline =~ /^\* SNAP \*  Crud\!  You broke your .*? in the attempt\!|^Your .*? gets stuck in the lock\!  You carefully try to work it free but end up snapping off the tip\!|Tiny .*? shoot out of your .*? to steady your .*? before you do any damage!/i
		    handle_lockpick_broke(sline, sline_down)
            break
          end
          
        # =====================================================================
        # Empty hands or missing tool reference pointers.
        # =====================================================================
        elsif sline_down.include?("must be holding a lockpick") || sline_down.include?("didn't mention what you want to pick")
          tpick_silent(true, "Couldn't find #{$tpick_vars["Needed Pick"]}.")
          waitrt?
          $tpick_vars["Next Task"] = "nextpick"
          $tpick_vars["FinishedTask"] = true
          break
          
        elsif sline_down.include?("roundtime")
          $tpick_vars["FinishedTask"] = true
          break
        elsif sline_down.include?("...wait")
          break
        elsif sline_down.include?("pick a lock on what")
          exit
        end
      end
    end
    
    if $tpick_vars["Next Task"] == "TryAgain"
      start_of_loop_pick3
      next
    end
    
    break if $tpick_vars["FinishedTask"]
  end
  
  # =====================================================================
  # Directs script execution flow based on results.
  # =====================================================================
  if @rogue_automate_current_task_with_tpick && $tpick_vars["Picking Mode"] == "worker" && @rogue_current_task == "Repair broken lockpicks"
    case $tpick_vars["Next Task"]
    when "scale_disarm_call"
      disarm_scale
    when "worker_finished", "open plinite"
      nil
    when "next plinite"
      tpick_put_stuff_away
      $tpick_vars["Give Up On Box"] = true # This check needs to stay here because "next plinite" indicates a failure when pool picking.
    else
      measure_lock
    end
  else
    case $tpick_vars["Next Task"]
	when "solo_finished", "other_finished", "ground_finished"
	  nil
    when "worker_finished"
      if @rogue_automate_current_task_with_tpick && @rogue_current_task == "Relock tough boxes"
        relock_boxes_for_rogues
      end
    when "nextpick"
      next_pick
    when "measure again"
      tpick_silent(nil, "Got a read on this box, going to change to best suited lockpick.")
      waitrt?
      measure_lock
    when "broken lockpick stow"
      if $tpick_vars["Gnomish Bracers"] && @load_data["Bracer Override"] == "No"
        next_pick
      else
        @tpick_lockpick_is_broken = true
        @all_pick_ids[$tpick_vars["Recommended Pick"]].shift
        $tpick_vars["Roll Amount"] = 100 if @all_pick_ids["Vaalin"].length < 1
        no_vaalin_picks
        next_pick
      end
    when "open plinite"
      if $tpick_vars["Picking Mode"] == "worker"
        $tpick_vars["Give Up On Box"] = true
      else
        open_current_plinite
      end
    when "next plinite"
      tpick_put_stuff_away
      $tpick_vars["Give Up On Box"] = true if $tpick_vars["Picking Mode"] == "worker"
    when "scale_disarm_call"
      disarm_scale
    end
  end
end
# =============================================================================

def start_of_loop_pick3
  $tpick_vars["Next Task"] = nil
  $tpick_vars["Roll Amount"] = nil
  $tpick_vars["FinishedTask"] = nil
  tpick_cast_spells(403)
  tpick_cast_spells(506)
  tpick_cast_spells(1035)
  
  if @load_data["403"] =~ /auto/i && !$tpick_vars["403 Needed"] && !$tpick_vars["Need 403"] && !$tpick_vars["Use 403"]
    tpick_stop_spell(403)
  end
  
  waitrt?
end
# =============================================================================

def handle_wlore_pick
  if $tpick_vars["Use WLore Pick"]
    corrosion_active = $tpick_vars["Lock Corrosion Expires At"] && Time.now <= $tpick_vars["Lock Corrosion Expires At"]
    time_remaining = corrosion_active ? ($tpick_vars["Lock Corrosion Expires At"] - Time.now) : 0
    if time_remaining < $tpick_vars["WLore Corrosion Timeout"] && $tpick_vars["Lock Corrosion Expires At"]
      multifput "prep 407", "cast at ##{$tpick_vars["Current Box"].id}"
      waitcastrt?
      Spell[403].cast
    end
  end
end
# =============================================================================

def handle_pick_plinite
  while line = get
    if line =~ /^You make .* attempt \(d100(?:\(open\))?\=(\d+)\)\./
      $tpick_vars["Roll Amount"] = $1.to_i
      if $tpick_vars["Roll Amount"] == 1
        waitrt?
        $tpick_vars["Next Task"] = "pick3"
        $tpick_vars["FinishedTask"] = true
        break
      end
    elsif line =~ /As you do you so\, you push just a little too hard and rupture the core\!/
      waitrt?
      $tpick_vars["Next Task"] = "next plinite"
      $tpick_vars["FinishedTask"] = true
      break
    elsif line =~ /you withdraw your .* with the feeling that retrieving the core is within your abilities/
      waitrt?
      $tpick_vars["Next Task"] = "pick3"
      $tpick_vars["FinishedTask"] = true
      break
    elsif line =~ /with the feeling that your abilities are probably not sufficient to retrieve the core/ || line =~ /You fumble about for a bit before you realize you are using a broken|you realize that the .* is broken/
      is_broken_string = line =~ /You fumble about for a bit before you realize you are using a broken|you realize that the .* is broken/
      
      if is_broken_string && (GameObj.right_hand.id != $tpick_vars["Current Box"].id) && ($tpick_vars["Picking Mode"] == "ground" || $tpick_vars["Picking Mode"] == "worker")
        @tpick_lockpick_is_broken = true
        @all_pick_ids[$tpick_vars["Recommended Pick"]].shift
        $tpick_vars["Roll Amount"] = 100 if @all_pick_ids["Vaalin"].length < 1
        no_vaalin_picks
      end
      
      tpick_put_stuff_away

      if $tpick_vars["Needed Pick"] == @load_data["Vaalin"]
        if $tpick_vars["Picking Mode"] == "worker"
          tpick_silent(true, "Can't extract this plinite based on my calculations. If you think this is in error increase the Vaalin Lock Roll setting in the setup menu.")
        else
          tpick_silent(true, "Can't extract this plinite, OPENing it instead. If you think this is in error increase the Vaalin Lock Roll setting in the setup menu.")
          waitrt?
          fput "open ##{$tpick_vars["Current Box"].id}"
          flag_box_opened
        end
        $tpick_vars["Next Task"] = "next plinite"
      else
        $tpick_vars["Next Task"] = "nextpick"
      end
      $tpick_vars["FinishedTask"] = true
      break
    elsif line =~ /where it can be easily PLUCKed/
      $tpick_vars["Next Task"] = "open plinite"
      flag_box_opened
      $tpick_vars["FinishedTask"] = true
      break
    elsif line =~ /^Roundtime\:/
      $tpick_vars["FinishedTask"] = true
      break
    elsif line =~ /\.\.\.wait/
      break
    end
  end
end
# =============================================================================

def handle_lockpick_success(sline, sline_down)
  $tpick_vars["Calibrate-Count"] += 1
  waitrt?
  tpick_put_stuff_away
  flag_box_opened
  
  if sline_down.include?("not appear to be locked")
    $tpick_vars["Box Math"] = nil
  else
    actual_lock_difficulty = ($1.to_i if sline =~ /thief\-lingo difficulty ranking/i)
    
    if @rogue_automate_current_task_with_tpick && $tpick_vars["Picking Mode"] == "worker" && @rogue_current_task == "Repair broken lockpicks"
      $tpick_vars["Box Math"] = nil
    else
      $tpick_stats_data["Locks Opened Since Last Pick Broke"] += 1
      $tpick_stats_data["Opened/Broke For Each Pick"][$tpick_vars["Recommended Pick"]] += 1
      
      history_summary = $tpick_stats_data["Opened/Broke For Each Pick"].map { |k, v| "#{k}: #{v}" }.join(", ")
      tpick_silent(
        true, 
        "Number of locks successfully opened since last broken lockpick: #{history_summary}. " \
        "Number of total locks picked since any lockpick broke: #{$tpick_stats_data["Locks Opened Since Last Pick Broke"]}"
      )
      
      if Stats.prof == "Rogue"
        if $rogue_calibrate_every_box
          calibrate_calipers
        elsif $tpick_vars["Calibrate Auto Amount"] && $tpick_vars["Measured Lock"].is_a?(Integer) && actual_lock_difficulty.is_a?(Integer)
          calibrate_auto_math = ($tpick_vars["Measured Lock"] - actual_lock_difficulty).abs
          if calibrate_auto_math >= $tpick_vars["Calibrate Auto Amount"] && !$tpick_vars["Pop Boxes"]
            tpick_silent(nil, "The difference between calipers reading and actual lock difficulty was #{calibrate_auto_math}. According to your settings you want your calipers calibrated.")
            calibrate_calipers
          end
        elsif $tpick_vars["Calibrate-Count"] >= @load_data["Calibrate Count"].to_i && !$tpick_vars["Calibrate Auto Amount"]
          if $tpick_vars["Can Use Calipers"] && !$tpick_vars["Always Use Vaalin"] && !$tpick_vars["Start With Copper"]
            calibrate_calipers unless $tpick_vars["Pop Boxes"]
          end
          $tpick_vars["Calibrate-Count"] = 0
        end
      end
    end
  end
  
  case $tpick_vars["Picking Mode"]
    when "solo"   then $tpick_vars["Next Task"] = "solo_finished"
    when "other"  then $tpick_vars["Next Task"] = "other_finished"
    when "worker" then $tpick_vars["Next Task"] = "worker_finished"
    when "ground"
      tpick_drop_box if $tpick_vars["Gnomish Bracers"] && @load_data["Bracer Override"] == "No"
      $tpick_vars["Next Task"] = "ground_finished"
  end
  
  $tpick_vars["Next Task"] = "scale_disarm_call" if $tpick_vars["Scale Trap Found"]
  $tpick_vars["FinishedTask"] = true
end
# =============================================================================

def handle_no_read(sline, sline_down)
  if $tpick_vars["Roll Amount"] == 1
    tpick_silent(nil, "This attempt was a fumble, going to try again.")
    $tpick_vars["Next Task"] = "pick3"
  else
    roll_amount_check
  end
  $tpick_vars["FinishedTask"] = true
end
# =============================================================================

def handle_pick_is_adequate(sline, sline_down)
  if (sline =~ /About a \-(\d+) difficulty lock/i || sline =~ /difficulty ranking\)\./i) && !$tpick_vars["True Lock Difficulty"]
    TpickMain.update_tpick_var("Lock Difficulty", $1.to_i)
    $tpick_vars["True Lock Difficulty"] = true
    
    if $tpick_vars["Needed Pick"] == @load_data["Vaalin"]
      if $tpick_vars["Roll Amount"] > @load_data["Vaalin Lock Roll"].to_i
        if !$tpick_vars["Need 403"] && !$tpick_vars["Never Cast 403"]
          tpick_silent(nil, "You rolled: #{$tpick_vars["Roll Amount"]}, your Vaalin Lock Roll setting: #{@load_data["Vaalin Lock Roll"]}. Going to use 403 now.")
          $tpick_vars["Roll Amount"] = 99
        elsif $tpick_vars["Never Cast 403"]
          tpick_silent(nil, "You rolled: #{$tpick_vars["Roll Amount"]}, your Vaalin Lock Roll setting: #{@load_data["Vaalin Lock Roll"]}. Your settings indicate you don't want to use 403/Lmas Focus. According to your Vaalin Lock Roll setting you should stop trying to use lockpicks.")
          $tpick_vars["Roll Amount"] = 100
        else
          tpick_silent(nil, "You rolled: #{$tpick_vars["Roll Amount"]}, your Vaalin Lock Roll setting: #{@load_data["Vaalin Lock Roll"]}. You are already using 403. According to your Vaalin Lock Roll setting you should stop trying to use lockpicks.")
          $tpick_vars["Roll Amount"] = 100
        end
        $tpick_vars["Next Task"] = "nextpick"
      else
        tpick_silent(nil, "You rolled: #{$tpick_vars["Roll Amount"]}, your Vaalin Lock Roll setting: #{@load_data["Vaalin Lock Roll"]}. Trying same pick again")
        $tpick_vars["Next Task"] = "pick3"
      end
    else
      $tpick_vars["Next Task"] = "measure again"
    end
  else
    if $tpick_vars["Roll Amount"] == 1
      tpick_silent(nil, "This attempt was a fumble, going to try again.")
      $tpick_vars["Next Task"] = "pick3"
    else
      if @load_data["Keep Trying"] == "Yes"
        tpick_silent(nil, "Messaging indicates you can open this box with current lockpick, according to your settings you want to try same lockpick again.")
        $tpick_vars["Next Task"] = "pick3"
      else
        tpick_silent(nil, "Messaging indicates you can open this box with current lockpick, but according to your settings you don't want to try same lockpick again.")
        roll_amount_check
      end
    end
  end
  $tpick_vars["FinishedTask"] = true
end
# =============================================================================

def handle_pick_damaged(sline, sline_down)
  waitrt?
  wait_until { checkrt == 0 }
  
  if sline_down.include?("bending the tip") && @load_data["Auto Repair Bent Lockpicks"] == "Yes" && Stats.prof == "Rogue"
    waitrt?
    wait_until { checkrt == 0 }
    tpick_silent(nil, "Lockpick tip was bent, going to try repairing it.") if !$tpick_vars["Gnomish Bracers"]
    tpick_stow_box if $tpick_vars["Picking Mode"] !~ /ground|worker/i
    fput "lmas repair ##{$tpick_vars["Needed Pick ID"]}"
    waitrt?
    sleep 1
    wait_until { checkrt == 0 }
    tpick_get_box unless $tpick_vars["Picking Mode"] == "ground" # Ground picking doesn't want box in hand at this point
  end
  
  if $tpick_vars["Roll Amount"] == 1
    tpick_silent(nil, "This attempt was a fumble, going to try again.")
    $tpick_vars["Next Task"] = "pick3"
  elsif $tpick_vars["Roll Amount"].to_i < @load_data["Max Lock Roll"].to_i
    tpick_silent(nil, "You rolled #{$tpick_vars["Roll Amount"]}, your settings are to try again because you rolled less than #{@load_data["Max Lock Roll"]}.")
    $tpick_vars["Next Task"] = "pick3"
  elsif $tpick_vars["Needed Pick"] != @load_data["Vaalin"]
    tpick_silent(nil, "This pick doesn't seem to be cutting it, going to try a different one.")
  elsif $tpick_vars["Needed Pick"] == @load_data["Vaalin"]
    if !$tpick_vars["Need 403"] && !$tpick_vars["Never Cast 403"]
      tpick_silent(nil, "A Vaalin pick doesn't seem to be cutting it alone, going to try 403/Lmas Focus.")
      $tpick_vars["Roll Amount"] = 99
    elsif $tpick_vars["Never Cast 403"]
      tpick_silent(nil, "A Vaalin pick doesn't seem to be cutting it alone and your settings indicate you never want to use 403/Lmas Focus, going to try wedges or 407.")
      $tpick_vars["Roll Amount"] = 100
    else
      tpick_silent(nil, "A Vaalin pick with 403/Lmas Focus doesn't seem to be cutting it, going to try wedges or 407.")
      $tpick_vars["Roll Amount"] = 100
    end
  end
  
  $tpick_vars["Next Task"] = "nextpick"
  $tpick_vars["FinishedTask"] = true
end
# =============================================================================

def handle_lockpick_broke(sline, sline_down)
  if @rogue_automate_current_task_with_tpick && $tpick_vars["Picking Mode"] == "worker" && @rogue_current_task == "Repair broken lockpicks" && sline !~ /before you do any damage!/i
    $tpick_vars["Lockpicks To Break For Rogue"].delete(GameObj.right_hand.id)
    until !checkright
      waitrt?
      fput "stow ##{GameObj.right_hand.id}"
      sleep 0.2
    end
    if $tpick_vars["Lockpicks To Break For Rogue"].empty?
      tpick_silent(true, "That's the last lockpick to break! Let's repair them all now.")
      @tpick_finished_with_current_rogue_task = true
      exit
    else
      tpick_silent(true, "Broke this lockpick! #{$tpick_vars["Lockpicks To Break For Rogue"].count} more to go!")
    end
  else
    if sline =~ /^\* SNAP \*  Crud\!  You broke your .*? in the attempt\!|^Your .*? gets stuck in the lock\!  You carefully try to work it free but end up snapping off the tip\!/i
      tpick_silent(true, "Your #{$tpick_vars["Recommended Pick"]} lockpick successfully picked #{$tpick_stats_data["Opened/Broke For Each Pick"][$tpick_vars["Recommended Pick"]]} locks before it broke. You successfully picked #{$tpick_stats_data["Locks Opened Since Last Pick Broke"]} locks since you last broke any lockpick.")
      $tpick_stats_data["Locks Opened Since Last Pick Broke"] = 0
      $tpick_stats_data["Opened/Broke For Each Pick"][$tpick_vars["Recommended Pick"]] = 0
    end
    tpick_silent(true, "#{$tpick_vars["Needed Pick"]} is broken.")
    waitrt?
    $tpick_vars["Next Task"] = "broken lockpick stow"
  end
  $tpick_vars["FinishedTask"] = true
end
# =============================================================================

# =============================================================================
# Handles the specialized slicing utility routine for disarming scales traps.
# Loops to ensure your designated scale weapon is held, applies auxiliary buff
# spells, cuts the cord, and paths execution forward based on your picking mode.
# =============================================================================
def disarm_scale
  tpick_silent(nil, "Attempting to disarm scales trap.")
  
  attempts = 0
  max_attempts = 20

  loop do
    attempts += 1
    if attempts > max_attempts
      tpick_silent(true, "Reached maximum scale disarm attempts. Aborting.")
      break
    end

    unless tpick_ensure_held($tpick_vars["Scale Weapon ID"], @load_data["Scale Trap Weapon"])
      tpick_silent(
        true, 
        "To fix this issue enter ;tpick setup\n" \
        "Be sure to fill out the setting for the name of your scale trap weapon.\n" \
        "Be sure to fill out the setting for which container your scale trap weapon is in.\n" \
        "Also be sure you have your scale trap weapon.\n\n" \
      )
      exit
    end

    cast_spells_scale
    
    result = dothistimeout("disarm ##{$tpick_vars["Current Box"].id}", 3, /slice through the cord/i)
    
    if result =~ /slice through the cord/i
	  flag_box_opened(true) # Scales traps are considered "open" AFTER being disarmed.
      waitrt?
      tpick_put_stuff_away
      break
      
    elsif result.nil?
      waitrt?
      tpick_put_stuff_away
      tpick_cast_spells(404)
      tpick_cast_spells(506)
      next
    end
  end
end
# =============================================================================

def cast_spells_scale
  tpick_cast_spells(404)
  tpick_cast_spells(506)
  tpick_cast_spells(613)
  tpick_cast_spells(1006)
  tpick_cast_spells(1035)
end
# =============================================================================

# =============================================================================
# manually_disarm_trap and all of its helper methods.
# Loop for manually disarming traps.
# Handles detecting plinites, Wlore Disarm, 404 and other spells.
# Updates text for the Trap window.
# Routes to other parts of the script depending on the
# outcome of the disarm attempt.
# =============================================================================
def manually_disarm_trap
  attempts = 0
  max_attempts = 20

  loop do
    attempts += 1
    if attempts > max_attempts
      tpick_silent(true, "Reached maximum safety attempts within the disarm loop. Aborting.")
      break
    end

    waitrt?
    tpick_get_current_worker_box if $tpick_vars["Picking Mode"] == "worker" && !$tpick_vars["Current Box"]
    
    if $tpick_vars["Current Box"].name =~ /plinite/i
      detect_plinite
      break
    end
	
    handle_wlore_corrosion_timeout

    if $tpick_vars["Time To Disarm Trap"]
      tpick_silent(nil, "Attempting to disarm trap.")
    else
      TpickMain.update_window_label_text("Checking For Traps...", "Traps", "bottom")
      TpickMain.update_display_image("Checking For Traps", "Traps")
      tpick_silent(nil, "Checking for traps.")
      $tpick_vars["403 Needed"] = false
      $tpick_vars["Need 404"]   = false
    end

    if ["Sphere", "Sphere trap found, need to use lockpick to disarm."].include?($tpick_vars["Current Trap Type"])
      no_vaalin_picks
	  exit unless tpick_ensure_held(@all_pick_ids["Vaalin"].first, @load_data["Vaalin"])
    end
	
    waitrt?
	
	cast_spells_disarm

	if $tpick_vars["Picking Mode"] !~ /ground|worker/
      wait_until { GameObj.right_hand.id }
      $tpick_vars["Current Box"] = GameObj.right_hand
      TpickMain.update_box_for_window
    end

    waitrt?
    sleep 0.3
    waitrt?

    disarm_command = nil

    if $tpick_vars["Current Trap Type"] == "Scarab"
      tpick_say("Scarab Found")
      $tpick_vars["All Scarab IDs"] = GameObj.loot.select { |i| i.noun == "scarab" }.map(&:id)
    end

    if $tpick_vars["Time To Disarm Trap"] && $tpick_vars["Trap Difficulty"]
      if $tpick_vars["Always 404 For Detect"] && $tpick_vars["Disarm Skill"].to_i > $tpick_vars["Trap Difficulty"].to_i && !$tpick_vars["Use 404/Trap Higher Than Setting"]
        tpick_silent(nil, "According to your settings you want to stop 404 when it's not needed to disarm a trap.")
        tpick_stop_spell(404)
      end
      if @load_data["404"] =~ /auto/i && !$tpick_vars["Use 404"] && !$tpick_vars["Need 404"] && !$tpick_vars["Use 404/Trap Higher Than Setting"]
        tpick_stop_spell(404)
      end
	  disarm_command = "disarm"
    else
      if $tpick_vars["Always 404 For Detect"]
        $tpick_vars["404 Detect Check"] = true
        tpick_cast_spells(404) # This 404 call needs to stay because the $tpick_vars["404 Detect Check"] was set to true above
      end
	  disarm_command = "detect"
    end
	
	trap_cant_be_disarmed = current_trap_status(disarm_command) if disarm_command

    TpickMain.update_box_for_window
	
    all_trap_names = ["Scarab", "Needle", "Jaws", "Sphere", "Crystal", "Scales", "Sulphur", "Cloud", "Acid Vial", "Springs", "Fire Vial", "Spores", "Plate", "Glyph", "Rods", "Boomer"]
    $tpick_stats_data[$tpick_vars["Current Trap Type"]] += 1 if all_trap_names.include?($tpick_vars["Current Trap Type"])
    $tpick_vars["Time To Disarm Trap"] = true

    # Dynamic Validation Loop: Safely filters out clear or pre-unlocked boxes,
    # while ensuring any state containing "disarmed" or "set off" is flagged as safe.
    trap_status = $tpick_vars["Current Trap Type"].to_s
    is_safe_or_disarmed = ["No trap found.", "Box is already open."].include?(trap_status) ||
                          trap_status.to_s.match?(/disarmed|set off/i)

    if is_safe_or_disarmed
      tpick_silent(nil, $tpick_vars["Current Trap Type"])
      $tpick_vars["Box Math"] = nil if $tpick_vars["Current Trap Type"] =~ /already/i
      $tpick_vars["Manual Trap Checks Remaining"] -= 1

      if $tpick_vars["Picking Mode"] == "ground"
        if ["Cloud trap has been disarmed.", "Acid vial trap has been disarmed."].include?($tpick_vars["Current Trap Type"])
          tpick_drop_box
        end
      end

      if $tpick_vars["Current Trap Type"] == "No trap found." && ($tpick_vars["Bracers Found Trap"] || $tpick_vars["Manual Trap Checks Remaining"] > 0)
        tpick_silent(nil, $tpick_vars["Bracers Found Trap"] ? "No trap found but bracers said there was a trap. Checking again." : "Number of trap checks remaining: #{$tpick_vars["Manual Trap Checks Remaining"]}")
        $tpick_vars["Time To Disarm Trap"] = nil
        next
      else
        if $tpick_vars["Current Trap Type"] == "No trap found."
          $tpick_stats_data["No Trap"] += 1
        end
        waitrt?

        handle_held_vials

        handle_scarab_disarmed

        tpick_put_stuff_away
        if $tpick_vars["Disarm Only"]
          bash_the_box_open if $tpick_vars["Bash Open Boxes"]
        else
          if $tpick_vars["Always Use Wedge"]
            wedge_lock
          else
		    measure_lock
          end
        end
        break
      end
    elsif ["Couldn't disarm trap, trying again.", "Current Trap Type"].include?($tpick_vars["Current Trap Type"])
      tpick_silent(nil, $tpick_vars["Current Trap Type"]) if $tpick_vars["Current Trap Type"] == "Couldn't disarm trap, trying again."
	  tpick_silent(true, "Something went wrong on my end, repeating the DISARM command.") if !$tpick_vars["Current Trap Type"]
      $tpick_vars["Need 404"] = true
      next
    elsif ["Acid vial trap has been set off.", "Acid vial trap has already been set off."].include?($tpick_vars["Current Trap Type"])
      tpick_silent(true, "#{$tpick_vars["Current Trap Type"]}\nLock has been fused.")
      if $tpick_vars["Disarm Only"] && $tpick_vars["Bash Open Boxes"]
        bash_the_box_open
      elsif !$tpick_vars["Disarm Only"]
	    fused_lock_disarm
      end
      break
      
    elsif $tpick_vars["Current Trap Type"] == "Box is already open."
	  flag_box_opened
      tpick_silent(nil, $tpick_vars["Current Trap Type"])
      break
      
    elsif $tpick_vars["Current Trap Type"] == "Plate"
      handle_plate_trap
      break

    elsif ["Jaws trap has already been disarmed with 408. Can't pick it.", 
           "Jaws trap has already been set off."].include?($tpick_vars["Current Trap Type"])
      handle_jaws_cant_be_disarmed
      break

    else
      if ["Scales trap found, need to use dagger to disarm.", "Sphere trap found, need to use lockpick to disarm."].include?($tpick_vars["Current Trap Type"])
        tpick_silent(nil, $tpick_vars["Current Trap Type"])
      else
        tpick_silent(nil, "Found a #{$tpick_vars["Current Trap Type"]} trap.")
      end
      
      if trap_cant_be_disarmed
	    use_water_lore = should_use_wlore

        if use_water_lore
          rot_bonus = $tpick_vars["WLore Rot Bonus"].to_i
          if rot_bonus > 0
            neededcasts = ($tpick_vars["Trap Difficulty"].to_i - $tpick_vars["404 For Trap-Difficulty"].to_i + rot_bonus - 1) / rot_bonus
            tpick_silent(nil, "Trap difficulty too high, but trap is safe and you have water lore. \nWill attempt #{neededcasts} times to degrade the trap.")
            disarm_the_trap(neededcasts, "No")
            $tpick_vars["Trap Difficulty"] -= rot_bonus * neededcasts
          end
          next
        else
          tpick_silent(true, "Trap difficulty is too high according to your settings. Can't open box.")
          break
        end
      else
        tpick_silent(nil, "Attempting to disarm trap.") if $tpick_vars["Current Trap Type"] != "Scales" && !$tpick_vars["Time To Disarm Trap"]
        
        case $tpick_vars["Current Trap Type"]
        when "Scales"
          tpick_silent(nil, "Scales trap found, picking lock first then disarming.")
          $tpick_vars["Scale Trap Found"] = true
          measure_lock
          break
        when "Scales trap found, need to use dagger to disarm."
          disarm_scale
          break
        when "Needle", "Jaws", "Crystal", "Sulphur", "Cloud", "Acid Vial", "Springs", "Fire Vial", "Spores", "Glyph", "Rods", "Boomer", "Sphere", "Sphere trap found, need to use lockpick to disarm.", "Scarab"
          next
        end
      end
    end
  end
end
# =============================================================================

def handle_held_vials
  if @load_data["Auto Bundle Vials"] == "Yes" && (GameObj.right_hand.name =~ /vial/i || GameObj.left_hand.name =~ /vial/i)
    if @rogue_automate_current_task_with_tpick &&
	   $tpick_vars["Picking Mode"] == "worker" &&
	   @rogue_current_task == "Gather trap components" &&
	   @rogue_trap_components_needed_names.any? { |name| name =~ /clear vial|thick vial|green vial/i }
      tpick_silent(true, "This vial is needed for your task so we are not bundling it in your locksmith's kit.")
    else
      tpick_bundle_vials
    end
  end
end
# =============================================================================

def current_trap_status(command)
  trap_cant_be_disarmed = false
  
  fput "#{command} ##{$tpick_vars["Current Box"].id}"

  while line = get
    sline = strip_xml(line)
    sline_down = sline.downcase
    
    if sline =~ /\(.*\-(\d+)\)\./
      $tpick_vars["Trap Difficulty"] = $1.to_i
      disarm_skill_plus_lore          = $tpick_vars["Disarm Skill"].to_i + $tpick_vars["Disarm Lore"].to_i
      $tpick_vars["Total Trap Skill"] = disarm_skill_plus_lore + @load_data["Trap Roll"].to_i
      
      if !$tpick_vars["Time To Disarm Trap"]
        tpick_silent(nil, "Trap difficulty is: #{$tpick_vars['Trap Difficulty']}\n" \
                          "Your disarm skill is: #{$tpick_vars['Disarm Skill']}\n" \
                          "Your total disarm skill with lore is: #{disarm_skill_plus_lore}\n" \
                          "Highest trap you are willing to try is: #{$tpick_vars['Total Trap Skill']}"
        )
      end

      if $tpick_vars["Trap Difficulty"] > $tpick_vars["Total Trap Skill"]
        trap_cant_be_disarmed = true
      elsif $tpick_vars["404 For Trap-Difficulty"]
        if $tpick_vars["Trap Difficulty"] > $tpick_vars["404 For Trap-Difficulty"].to_i
          tpick_silent(nil, "Trap difficulty is higher than your setting in the setup menu for when to use Disarm Enhancement (404), going to use Disarm Enhancement (404).") if !$tpick_vars["Time To Disarm Trap"]
          $tpick_vars["Use 404/Trap Higher Than Setting"] = true
          $tpick_vars["Need 404"] = true
        end
      elsif ($tpick_vars["Trap Difficulty"] + 40) > $tpick_vars["Disarm Skill"].to_i && (Spell[404].known? || @load_data["Use Lmaster Focus"] == "Yes")
        tpick_silent(nil, "This trap looks tough, going to use Disarm Enhancement (404) or Lock Mastery Focus.") if !$tpick_vars["Time To Disarm Trap"]
        $tpick_vars["Need 404"] = true
      elsif $tpick_vars["Trap Difficulty"] > $tpick_vars["Disarm Skill"].to_i && !Spell[404].known? && @load_data["Use Lmaster Focus"] != "Yes"
        trap_cant_be_disarmed = true
      end
    # =====================================================================
    # Box is enruned/mithril check.
    # =====================================================================
    elsif sline_down.include?("carefully begin to examine") && sline_down.include?("for traps")
      if sline =~ /You carefully begin to examine (.*?) for traps\.\.\./i
        $tpick_vars["Box Is Enruned/Mithril"] = ($1 =~ /mithril|enruned|rune-incised/i) ? true : nil
      end

    # =====================================================================
    # Failed to disarm box.
	# By default the disarm attempt is considered a failure.
	# This is updated if a successful disarm line is seen.
    # =====================================================================
    elsif sline_down.include?("having discovered a trap on the")
      $tpick_vars["Current Trap Type"] = "Couldn't disarm trap, trying again."

    # =====================================================================
    # Scarab trap messaging.
    # =====================================================================
    elsif sline_down.include?("wedged into the lock mechanism") && sline_down.include?("scarab")
      if sline =~ /Peering closely into the lock\, you spy an? [a-zA-Z]+ (.*?) scarab wedged into the lock mechanism\./i
        $tpick_vars["Scarab Name"]       = $1
        $tpick_vars["Current Trap Type"] = "Scarab"
      end

    elsif sline_down.include?("carefully nudge the scarab free")
      $tpick_vars["Current Trap Type"] = "Scarab trap has been disarmed."
      break

    elsif sline_down.include?("lock appears to be free of all obstructions")
      $tpick_vars["Current Trap Type"] = "Scarab trap has already been disarmed."
      break

    elsif sline_down.include?("surrounded by crimson glow") && sline_down.include?("scarab")
      $tpick_vars["Current Trap Type"] = "Scarab trap has already been disarmed with 408."
      break

    # =====================================================================
    # Needle trap messaging.
    # =====================================================================
    elsif sline_down.include?("gleaming sliver of metal recessed")
      $tpick_vars["Current Trap Type"] = "Needle"

    elsif sline_down.include?("manage to block the tiny hole") || (sline_down.include?("carefully remove") && sline_down.include?("cover the tip with a bit of putty"))
      $tpick_vars["Current Trap Type"] = "Needle trap has been disarmed."
      $tpick_vars["Putty Remaining"]  -= 1 unless $tpick_vars["Putty Remaining"] == 999
      break

    elsif sline_down.include?("completely plugged") || sline_down.include?("cause for alarm") || sline_down.include?("paste on it")
      $tpick_vars["Current Trap Type"] = "Needle trap has already been disarmed."
      break

    elsif sline_down.include?("glint of red winks at you")
      $tpick_vars["Current Trap Type"] = "Needle trap has already been disarmed with 408."
      break

    # =====================================================================
    # Jaws trap messaging.
    # =====================================================================
    elsif sline_down.include?("discolored oval ring") && sline_down.include?("spring-loaded jaws")
      $tpick_vars["Current Trap Type"] = "Jaws"

    elsif sline_down.include?("upper and lower jaw pieces") || sline_down.include?("remove a pair of small steel jaws")
      $tpick_vars["Current Trap Type"] = "Jaws trap has been disarmed."
      break

    elsif sline_down.include?("pins that hold the jaws together have been pushed out") || sline_down.include?("vital part of whatever trap was here has been removed")
      $tpick_vars["Current Trap Type"] = "Jaws trap has already been disarmed."
      break

    elsif sline_down.include?("clamped tightly before the lockplate") || sline_down.include?("jaws are surrounded with a reddish glow")
      $tpick_vars["Current Trap Type"] = "Jaws trap has already been disarmed with 408. Can't pick it."
      break

    elsif sline_down.include?("bloody jaws clamped tightly")
      $tpick_vars["Current Trap Type"] = "Jaws trap has already been set off."
      break

    # =====================================================================
    # Sphere trap messaging.
    # =====================================================================
    elsif sline_down.include?("sphere held in a metal bracket")
      $tpick_vars["Current Trap Type"] = "Sphere"

    elsif sline_down.include?("poke the gem free of its metal housing") || sline_down.include?("knock the gem free of its metal housing")
      $tpick_vars["Current Trap Type"] = "Sphere trap has been disarmed."
      break

    elsif sline_down.include?("reveals what appears to be a metal bracket") && sline_down.include?("empty now")
      $tpick_vars["Current Trap Type"] = "Sphere trap has already been disarmed."
      break

    elsif sline_down.include?("sphere is surrounded by") && sline_down.include?("crimson glow")
      $tpick_vars["Current Trap Type"] = "Sphere trap has already been disarmed with 408."
      break

    elsif sline_down.include?("fingers are just too big to get back there")
      $tpick_vars["Current Trap Type"] = "Sphere trap found, need to use lockpick to disarm."
      no_vaalin_picks
      exit unless tpick_ensure_held(@all_pick_ids["Vaalin"].first, @load_data["Vaalin"])

    elsif sline_down.include?("sound like shattered crystal") && sline_down.include?("light flashes")
      $tpick_vars["Current Trap Type"] = "Sphere trap has been set off."
      tpick_silent(true, "Sphere trap has been set off! Exiting.")
      exit

    elsif sline_down.include?("lock mechanism indicates that the entire") && sline_down.include?("mangled")
      $tpick_vars["Current Trap Type"] = "Sphere trap has already been set off."
      break

    # =====================================================================
    # Crystal trap messaging.
    # =====================================================================
    elsif sline_down.include?("spy") && sline_down.include?("crystal") && sline_down.include?("imbedded in the locking mechanism")
      $tpick_vars["Current Trap Type"] = "Crystal"

    elsif sline_down.include?("grind down parts of the lock mechanism") && sline_down.include?("won't come in contact with the crystal")
      $tpick_vars["Current Trap Type"] = "Crystal trap has been disarmed."
      break

    elsif sline_down.include?("mechanism have been ground away to avoid unwanted contact")
      $tpick_vars["Current Trap Type"] = "Crystal trap has already been disarmed."
      break

    elsif sline_down.include?("crystal imbedded") && sline_down.include?("reddish glow")
      $tpick_vars["Current Trap Type"] = "Crystal trap has already been disarmed with 408."
      break

    # =====================================================================
    # Scales trap messaging.
    # =====================================================================
    elsif sline_down.include?("hundreds of tiny metal scales") || sline_down.include?("no way to pry off any of the scales")
      $tpick_vars["Current Trap Type"] = "Scales"

    elsif sline_down.include?("slice through the cord")
      $tpick_vars["Current Trap Type"] = "Scales trap has been disarmed."
      flag_box_opened # Scales traps are considered "open" AFTER being disarmed.
      break

    elsif sline_down.include?("thin cord dangling") && sline_down.include?("sliced through")
      $tpick_vars["Current Trap Type"] = "Scales trap has already been disarmed."
      break

    elsif sline_down.include?("crimson glow seeps between the lid")
      $tpick_vars["Current Trap Type"] = "Scales trap has already been disarmed with 408."
      break

    elsif sline_down.include?("had a dagger, you could probably cut the cord")
      $tpick_vars["Current Trap Type"] = "Scales trap found, need to use dagger to disarm."
      break
      
    # =====================================================================
    # Sulphur trap messaging.
    # =====================================================================
    elsif sline_down.include?("casing is coated with a rough, grainy substance") && sline_down.include?("sulphur")
      $tpick_vars["Current Trap Type"] = "Sulphur"

    elsif sline_down.include?("scrape away the rough, grainy substance") && sline_down.include?("clear gel oozes")
      $tpick_vars["Current Trap Type"] = "Sulphur trap has been disarmed."
      break

    elsif sline_down.include?("deflated bladder wedged between the tumblers")
      $tpick_vars["Current Trap Type"] = "Sulphur trap has already been disarmed."
      break

    elsif sline_down.include?("lock mechanism indicates that the entire") && sline_down.include?("mangled")
      $tpick_vars["Current Trap Type"] = "Sulphur trap has already been set off."
      break

    # =====================================================================
    # Cloud trap messaging.
    # =====================================================================
    elsif sline_down.include?("small vial of liquid and a tiny hammer device") && sline_down.include?("tampered with")
      $tpick_vars["Current Trap Type"] = "Cloud"

    elsif sline_down.include?("bend the weak metal out of striking range") || sline_down.include?("green-tinted vial filled with thick acrid smoke")
      $tpick_vars["Current Trap Type"] = "Cloud trap has been disarmed."
      break

    elsif sline_down.include?("hammer device which has been bent back") || sline_down.include?("splinters of glass")
      $tpick_vars["Current Trap Type"] = "Cloud trap has already been disarmed."
      break

    elsif sline_down.include?("hammer device which has a red glow")
      $tpick_vars["Current Trap Type"] = "Cloud trap has already been disarmed with 408."
      break

    # =====================================================================
    # Acid Vial trap messaging.
    # =====================================================================
    elsif sline_down.include?("tiny vial placed just past the tumblers")
      $tpick_vars["Current Trap Type"] = "Acid Vial"

    elsif sline_down.include?("push a small ball of cotton into the lock") || sline_down.include?("remove the padded clear glass vial")
      $tpick_vars["Current Trap Type"] = "Acid vial trap has been disarmed."
      $tpick_vars["Cotton Remaining"] -= 1 unless $tpick_vars["Cotton Remaining"] == 999
      break

    elsif sline_down.include?("small ball of cotton has been pushed up against the vial") || sline_down.include?("small metal housing set just inside") || sline_down.include?("small metal housing, which appears to be empty")
      $tpick_vars["Current Trap Type"] = "Acid vial trap has already been disarmed."
      break

    elsif sline_down.include?("tiny vial set just inside") && sline_down.include?("crimson glow")
      $tpick_vars["Current Trap Type"] = "Acid vial trap has already been disarmed with 408."
      break

    elsif sline_down.include?("fused into a lump of useless metal")
      $tpick_vars["Current Trap Type"] = "Acid vial trap has been set off."
      break

    elsif sline_down.include?("fused into a lump of useless metal.")
      $tpick_vars["Current Trap Type"] = "Acid vial trap has already been set off."
      break

    # =====================================================================
    # Springs trap messaging.
    # =====================================================================
    elsif sline_down.include?("ends of springs incorporated with the hinges")
      $tpick_vars["Current Trap Type"] = "Springs"

    elsif sline_down.include?("pop them inside") && (sline_down.include?("tinkle of breaking glass") || sline_down.include?("bounce around for a moment"))
      $tpick_vars["Current Trap Type"] = "Springs trap has been disarmed."
      break

    elsif sline_down.include?("reddish glow about the hinges")
      $tpick_vars["Current Trap Type"] = "Springs trap has already been disarmed with 408."
      break

    # =====================================================================
    # Fire Vial trap messaging.
    # =====================================================================
    elsif sline_down.include?("small vial of fire-red liquid")
      $tpick_vars["Current Trap Type"] = "Fire Vial"

    elsif sline_down.include?("bend the weak metal out of striking range of the vial") || sline_down.include?("remove a thick glass vial filled with murky red liquid")
      $tpick_vars["Current Trap Type"] = "Fire vial trap has been disarmed."
      break

    elsif sline_down.include?("hammer device which has been bent from striking range") || sline_down.include?("splinters of glass")
      $tpick_vars["Current Trap Type"] = "Fire vial trap has already been disarmed."
      break

      # =====================================================================
      # Spores trap messaging.
      # =====================================================================
    elsif sline_down.include?("small tube towards the bottom of the tumbler") && sline_down.include?("membrane")
      $tpick_vars["Current Trap Type"] = "Spores"

    elsif sline_down.include?("carefully apply it to the end of the small tube")
      $tpick_vars["Current Trap Type"] = "Spores trap has been disarmed."
      $tpick_vars["Putty Remaining"]  -= 1 unless $tpick_vars["Putty Remaining"] == 999
      break

    elsif sline_down.include?("tube has been plugged with something")
      $tpick_vars["Current Trap Type"] = "Spores trap has already been disarmed."
      break

    elsif sline_down.include?("tube extending from the lock mechanism") && sline_down.include?("crimson glow")
      $tpick_vars["Current Trap Type"] = "Spores trap has already been disarmed with 408."
      break

    elsif sline_down.include?("greyish-green powder covers the area")
      $tpick_vars["Current Trap Type"] = "Spores trap has already been set off."
      break

    # =====================================================================
    # Plate trap messaging.
    # =====================================================================
    elsif sline_down.include?("plate over the lock, sealing it") || sline_down.include?("gonna chew through it")
      $tpick_vars["Current Trap Type"] = "Plate"

    elsif sline_down.include?("carefully pour the contents") && sline_down.include?("melt away")
      $tpick_vars["Current Trap Type"] = "Plate trap has been disarmed."
      $tpick_vars["Vials Remaining"]  -= 1
      break

    elsif sline_down.include?("metal plate covering the lock plate, but it appears to have been melted through")
      $tpick_vars["Current Trap Type"] = "Plate trap has already been disarmed."
      break

    # =====================================================================
    # Glyph trap messaging.
    # =====================================================================
    elsif sline_down.include?("spiderweb-like scratches on the lock plate") && sline_down.include?("glyph spell")
      $tpick_vars["Current Trap Type"]  = "Glyph"
      $tpick_vars["Box Has Glyph Trap"] = true

    elsif sline_down.include?("scrape some extra lines into the markings")
      $tpick_vars["Current Trap Type"]  = "Glyph trap has been disarmed."
      $tpick_vars["Box Has Glyph Trap"] = true
      break

    elsif sline_down.include?("glyph spell, but some of the markings have been altered")
      $tpick_vars["Current Trap Type"]  = "Glyph trap has already been disarmed."
      $tpick_vars["Box Has Glyph Trap"] = true
      break

    # =====================================================================
    # Rods trap messaging.
    # =====================================================================
    elsif sline_down.include?("pair of small metal rods a hair's width from touching")
      $tpick_vars["Current Trap Type"] = "Rods"

    elsif sline_down.include?("bend the sensitive metal rods out of alignment")
      $tpick_vars["Current Trap Type"] = "Rods trap has been disarmed."
      break

    elsif sline_down.include?("rods that have been bent in opposite directions")
      $tpick_vars["Current Trap Type"] = "Rods trap has already been disarmed."
      break

    elsif sline_down.include?("rods surrounded by a crimson glow") || sline_down.include?("reddish glow about them")
      $tpick_vars["Current Trap Type"] = "Rods trap has already been disarmed with 408."
      break

    # =====================================================================
    # Boomer trap messaging.
    # =====================================================================
    elsif sline_down.include?("chamber is coated with a strange white substance") && sline_down.include?("detonation system")
      $tpick_vars["Current Trap Type"] = "Boomer"

    elsif sline_down.include?("cake a thin layer on the lock casing") && sline_down.include?("prevent sparks")
      $tpick_vars["Current Trap Type"] = "Boomer trap has been disarmed."
      $tpick_vars["Putty Remaining"]  -= 1 unless $tpick_vars["Putty Remaining"] == 999
      break

    elsif sline_down.include?("thin layer of mud or putty has been dabbed on the connecting point")
      $tpick_vars["Current Trap Type"] = "Boomer trap has already been disarmed."
      break

    elsif sline_down.include?("deep red glow surrounds the striking arm")
      $tpick_vars["Current Trap Type"] = "Boomer trap has already been disarmed with 408."
      break

    # =====================================================================
    # Safe state and exception status terminations.
    # =====================================================================
    elsif sline_down.include?("discover no traps.")
      $tpick_vars["Current Trap Type"] = "No trap found."
      break

    elsif sline_down.include?("um, but it's open") || sline_down.include?("there is no lock on that") || sline_down.include?("blink in surprise as though just becoming aware") || sline_down.include?("what were you referring to") || sline_down.include?("you want to pick a lock on what")
      $tpick_vars["Current Trap Type"] = "Box is already open."
      flag_box_opened                  = true
      $tpick_vars["Box Math"]          = nil
      break

    elsif sline_down.include?("if you had some sort of putty")
      tpick_silent(true, "No putty to disarm this trap. Exiting.\nBe sure to fill up your locksmith's container.\nThe script can do it for you by doing: ;tpick buy")
      exit

    elsif sline_down.include?("roundtime") || sline_down.include?("...wait")
      break
    end
  end
  
  trap_cant_be_disarmed
end
# =============================================================================

def cast_spells_disarm
  if @load_data["Use 404 On Level"] != 200
    if !$tpick_vars["Critter Level"]
      tpick_silent(nil, "Critter level unknown, using 404 based on your settings.")
      $tpick_vars["Need 404"] = true
    elsif @load_data["Use 404 On Level"] <= $tpick_vars["Critter Level"]
      tpick_silent(nil, "Critter level is #{$tpick_vars["Critter Level"]}, using 404 based on your settings.")
      $tpick_vars["Need 404"] = true
    end
  end

  tpick_cast_spells(402)
  tpick_cast_spells(404)
  tpick_cast_spells(506)
  tpick_cast_spells(613)
  tpick_cast_spells(1006)
  tpick_cast_spells(1035)
end
# =============================================================================

def handle_wlore_corrosion_timeout
  return unless $tpick_vars["Use WLore Disarm"] && $tpick_vars["Trap Corrosion Expires At"]

  corrosion_active = Time.now <= $tpick_vars["Trap Corrosion Expires At"]
  time_remaining   = corrosion_active ? ($tpick_vars["Trap Corrosion Expires At"] - Time.now) : 0
  
  if time_remaining < $tpick_vars["WLore Corrosion Timeout"]
    disarm_the_trap(1, "No")
  end
end
# =============================================================================

def handle_scarab_disarmed
  if $tpick_vars["Current Trap Type"] == "Scarab trap has been disarmed."
    tpick_silent(nil, "Disarming scarab.")
    waitrt?
    sleep 1
    waitrt?
  
    scarab_object = nil
    GameObj.loot.each do |item|
      if item.name =~ /#{$tpick_vars["Scarab Name"]}/i && item.noun == "scarab" && !$tpick_vars["All Scarab IDs"].include?(item.id)
        if @load_data["Disarm (408)"] == "Yes"
          loop do
            tpick_cast_spells(515)
            if checkmana < 13
              tpick_silent(true, "Waiting for mana.")
              wait_until { checkmana(13) }
            end
  
            until checkprep == "Disarm"
              waitrt?
              waitcastrt?
              fput "release" unless checkprep == "Disarm"
              fput "prep 408"
              sleep 0.5
            end
            
            result = dothistimeout("cast ##{item.id}", 3, /The runes on the scarab go still\.|Cast Roundtime/i)
            if result =~ /The runes on the scarab go still\./i
              scarab_object = item
              break
            end
          end
        else
          waitrt?
          result = dothistimeout("disarm ##{item.id}", 5, /^As you reach for the|^Knowing how delicate magical runes can be/i)
          scarab_object = item if result =~ /^Knowing how delicate magical runes can be/i
        end
      end
      break if scarab_object
    end
    
    tpick_say("Scarab Safe")
    until checkright == "scarab" || checkleft == "scarab"
      waitrt?
      fput "get ##{scarab_object.id}"
      sleep 0.5
    end
    
    $tpick_stats_data["Pool Scarabs Received"] += 1 if $tpick_vars["Picking Mode"] == "worker"
    $tpick_session_data["Scarabs"] += 1
    $tpick_stats_data["Loot Total"]["Scarabs"] += 1 if @load_data["Track Loot"] == "Yes"
    tpick_put_stuff_away
  end
end
# =============================================================================

def should_use_wlore
  use_water_lore = false
  
  if $tpick_vars["Use WLore Disarm"] && $tpick_vars["WLore Rot Bonus"].to_i > 0
    difficulty_threshold = $tpick_vars["Trap Difficulty"].to_i - ($tpick_vars["Trap Difficulty"].to_i * 0.10).floor
    if difficulty_threshold < $tpick_vars["Total Trap Skill"].to_i
      use_water_lore = true
    end
  end
  
  if use_water_lore
    case $tpick_vars["Current Trap Type"]
    when "Needle", "Jaws", "Crystal", "Springs"
      nil
    when "Scarab", "Sphere", "Scales", "Acid Vial", "Fire Vial", "Spores", "Boomer", "Cloud", "Rods"
      if @load_data["Only Disarm Safe"] == "Yes"
        tpick_silent(true, "Not using 408 with Water Lore due to tpick setting 'Only Disarm Safe' is set to yes.")
        use_water_lore = false
      end
    else
      tpick_silent(true, "Not using 408 with Water Lore because it is never safe to use 408 on this trap.")
      use_water_lore = false
    end
  end
  
  use_water_lore
end
# =============================================================================

def handle_plate_trap
  tpick_silent(nil, "Found a #{$tpick_vars["Current Trap Type"]} trap.")
  if $tpick_vars["Disarm Only"] && $tpick_vars["Bash Open Boxes"]
    bash_the_box_open
  elsif !$tpick_vars["Disarm Only"]
    if $tpick_vars["Always 404 For Detect"] && $tpick_vars["Disarm Skill"].to_i > $tpick_vars["Trap Difficulty"].to_i && !$tpick_vars["Use 404/Trap Higher Than Setting"]
      tpick_silent(nil, "According to your settings you want to stop 404 when it's not needed to disarm a trap.")
      tpick_stop_spell(404)
    end
    plate_trap_disarm
  end
end
# =============================================================================

def handle_jaws_cant_be_disarmed
  tpick_silent(nil, $tpick_vars["Current Trap Type"])
  if $tpick_vars["Disarm Only"] && $tpick_vars["Bash Open Boxes"]
    bash_the_box_open
  elsif !$tpick_vars["Disarm Only"]
    fused_lock_disarm
  end
end
# =============================================================================

# =============================================================================
# Scans the player's disk or coffin for boxes, executing the required
# popping or disarming pipelines on each element found.
# =============================================================================
def check_disk
  $tpick_vars["Stow In Disk"] = true

  unless disk = GameObj.loot.find { |obj| obj.name =~ /#{Char.name} disk|coffin/i }
    if !$tpick_vars["Checked For Disk"]
      tpick_silent(true, "Waiting 4 seconds for disk")
      40.times do 
        break if GameObj.loot.any? { |obj| obj.name =~ /#{Char.name} disk|coffin/i }
        sleep 0.1 
      end
      disk = GameObj.loot.find { |obj| obj.name =~ /#{Char.name} disk|coffin/i }
    end
  end

  if !disk
    tpick_silent(nil, "No disk found.") if !$tpick_vars["Checked For Disk"]
    exit
  end

  if disk && disk.contents.nil?
    dothistimeout("look in ##{disk.id}", 3, /In the|There is nothing in/i)
  end

  disk.contents.each do |item|
    break if check_loop_status
    next unless item.type =~ /box/i

    waitrt?
    if $tpick_vars["Pop Boxes"]
	  TpickMain.update_tpick_var("Current Box", item)
      pop_boxes_begin
    else
      fput "get ##{item.id}"
      execute_box_initialization(item)
    end
	
	final_box_actions
  end
end

# =============================================================================
# Loop for solo picking. Retrieves boxes from inventory sequentially
# and routes them through the appropriate evaluation methods.
# =============================================================================
def start_solo
  total_boxes_count
  
  $tpick_vars["All Box IDs"].each do |box_id|
    break if check_loop_status

    tpick_stop_403_404
    fput "get ##{box_id}"
    
    box_obj = GameObj.inv.find { |i| i.id == box_id } || GameObj.right_hand
    execute_box_initialization(box_obj)
    need_rest_check
	final_box_actions
  end

  check_disk
end

# =============================================================================
# Loop for Other picking mode (someone gives you a box.)
# Monitors incoming trade offers from other players and
# accepts the box, picks the box, then hands box back.
# =============================================================================
def start_others
  loop{
    break if check_loop_status

    $tpick_currently_working_on_box = nil
	waitrt?
    # Keep below line in case customer has already offered a box
    # before script reached the while loop below.
    fput "accept"
  
    while line = get
	  break if $tpick_stop_immediately || $tpick_exit_tpick_immediately
      sline = strip_xml(line)
  
      if sline =~ /^You accept ([a-zA-Z]+)\'s offer and are now holding.*\.$/i || 
         sline =~ /^([a-zA-Z]+) offers you .*? #{$tpick_vars["All Box Types"]}.*?\.  Click ACCEPT to accept the offer/i
        
        $tpick_vars["Customer"] = $1
        $tpick_currently_working_on_box = true
        sleep 1
  
        if sline =~ /offers you/i && !checkright
          fput "accept"
        end
  
        tpick_stop_403_404
        execute_box_initialization(GameObj.right_hand)
		final_box_actions
        break
      end
    end
  }
end

# =============================================================================
# Loop for Rogues to finish their relock boxes Rogue Guild task.
# =============================================================================
def relock_boxes_for_rogues
  until checkright
    waitrt?
    fput "get ##{$tpick_vars["Needed Pick ID"]}"
    sleep 0.3
  end

  loop do
    waitrt?
    result = dothistimeout("lmas relock ##{$tpick_vars["Current Box"].id}", 5, /Then\.\.\.CLICK\!  It locks\!/i)
    break if result =~ /Then\.\.\.CLICK\!  It locks\!/i
  end

  loop do
    waitrt?
    result = dothistimeout("pick ##{$tpick_vars["Current Box"].id}", 5, /Then\.\.\.CLICK\!  It opens\!/i)
    break if result =~ /Then\.\.\.CLICK\!  It opens\!/i
  end

  tpick_put_stuff_away
end

# =============================================================================
# Get initial stats for new box.
# =============================================================================
def execute_box_initialization(box_item)
  $tpick_vars["Start Time"]                   = Time.now
  $tpick_vars["Current Box"]                  = box_item
  $tpick_vars["Manual Trap Checks Remaining"] = @load_data["Trap Check Count"].dup
  
  if $tpick_vars["Gnomish Bracers"] && @load_data["Bracer Tier 2"] == "Yes"
    gnomish_bracers_trap_check
  else
    manually_disarm_trap
  end
end

# =============================================================================
# Manages the extraction and physical bundling of acid vials back into 
# your locksmith container kit, handling inventory state swaps securely.
# =============================================================================
def tpick_bundle_vials
  start_script "sorter" if $tpick_vars["Start Sorter"]
  
  if GameObj.right_hand.name =~ /vial/i
    $tpick_vars["Current Vial"] = GameObj.right_hand.id
  elsif GameObj.left_hand.name =~ /vial/i
    $tpick_vars["Current Vial"] = GameObj.left_hand.id
  end

  if ["solo", "other"].include?($tpick_vars["Picking Mode"]) || ($tpick_vars["Picking Mode"] == "other" && @load_data["Bracer Tier 2"] == "Yes")
    tpick_stow_box
  end

  tpick_put_stuff_away
  wait_until { !checkright && !checkleft }
  
  fput "remove ##{$tpick_vars["Locksmith's Container"].id}"
  20.times do
    break if checkright
    sleep 0.1
  end

  if !checkright
    fput "get ##{$tpick_vars["Locksmith's Container"].id}"
    15.times do
      break if checkright
      sleep 0.1
    end
  end

  if !checkright
    tpick_silent(true, "I could not find your locksmith's container to bundle a vial inside of it.")
  else
    fput "get ##{$tpick_vars["Current Vial"]}"
    wait_until { checkleft }
    fput "bundle"
    fput "wear ##{$tpick_vars["Locksmith's Container"].id}"
    
	TpickMain.update_tpick_var("Vials Remaining", [($tpick_vars["Vials Remaining"].to_i + 1), 100].min)
    wait_until { !checkright }
  end

   tpick_get_box unless $tpick_vars["Picking Mode"] == "ground" # Ground picking doesn't want box in hand at this point
end

# =============================================================================
# Simple routine to cleanly pluck shards out of plinites.
# =============================================================================
def open_current_plinite
  tpick_put_stuff_away
  waitrt?
  fput "pluck ##{$tpick_vars["Current Box"].id}"
  @tpick_stow_current_box = true
  tpick_put_stuff_away
end

# =============================================================================
# Loop to go through all plinites in player inventory.
# Retrieves each plinite and routes script to next required step.
# =============================================================================
def start_plinites
  $tpick_vars["All Box IDs"].each do |plinite|
    break if check_loop_status
    tpick_put_stuff_away
    $tpick_vars["Plinite Already Open"] = nil
    $tpick_vars["Can't Determine Plinite Difficulty"] = nil
    
    until GameObj.right_hand.id == plinite || GameObj.left_hand.id == plinite
      waitrt?
      fput "get ##{plinite}"
      sleep 0.2
    end
    
    if GameObj.right_hand.name =~ /plinite/i
      $tpick_vars["Current Box"] = GameObj.right_hand
    elsif GameObj.left_hand.name =~ /plinite/i
      $tpick_vars["Current Box"] = GameObj.left_hand
    end
    
    TpickMain.update_box_for_window
    detect_plinite
	final_box_actions
  end
end

# =============================================================================
# Handles trap checking with bracers.
# =============================================================================
def gnomish_bracers_check_result
  loop do
    waitrt?
    $tpick_vars["Bracers Found Trap"] = nil
    result = dothistimeout("rub my #{$tpick_vars["Gnomish Bracers"]}", 3, /begins to glow with a deep red light|begins to glow with a bright green light|Perhaps you need to be holding a container/i)
    
    case result
    when /begins to glow with a deep red light/i
      waitrt?
      $tpick_vars["Bracers Found Trap"] = true
      manually_disarm_trap
      break
    when /begins to glow with a bright green light/i
      waitrt?
      if $tpick_vars["Disarm Only"]
        if $tpick_vars["Bash Open Boxes"]
          bash_the_box_open
        else
          tpick_drop_box
        end
      else
        measure_lock
      end
      break
    when /Perhaps you need to be holding a container/i
      waitrt?
      manually_disarm_trap
      break
    when nil
      sleep 0.2
    end
  end
end

# =============================================================================
# Checks hand inventory states and pulls required target boxes to run 
# specialized trap evaluations using Gnomish Bracers.
# =============================================================================
def gnomish_bracers_trap_check
  if $tpick_vars["Picking Mode"] !~ /ground|worker/
    wait_until { GameObj.right_hand.id != nil }
	TpickMain.update_tpick_var("Current Box", GameObj.right_hand)
  end
  tpick_get_box
  tpick_get_current_worker_box if $tpick_vars["Picking Mode"] == "worker" && !$tpick_vars["Current Box"]
  gnomish_bracers_check_result
end

# =============================================================================
# Rotates and activates integrated bracer mechanics, programmatically spinning 
# the dials up to 20 times to deploy the specific pick tier needed.
# =============================================================================
def find_gnomish_lockpick
  found_pick  = nil
  spin_number = 0
  waitrt?
  
  fput "turn my #{$tpick_vars["Gnomish Bracers"]}"
  while line = get
    if line =~ /^You spin your/i
      found_pick = true if line =~ /#{$tpick_vars["Needed Pick"]}/i
      break
    end
  end

  if found_pick.nil?
    loop do
      spin_number += 1
      waitrt?
      fput "spin my #{$tpick_vars["Gnomish Bracers"]}"
      
      while line = get
        if line =~ /^You spin your/i
          found_pick = true if line =~ /#{$tpick_vars["Needed Pick"]}/i
          break
        end
      end
      break if found_pick || spin_number > 20
    end
  end

  if spin_number > 20
    tpick_silent(true, "Couldn't find the lockpick needed to pick this lock in your #{$tpick_vars["Gnomish Bracers"]}.")
    next_pick
  else
    pick_3
  end
end

# =============================================================================
# Navigates automated path strings to the Rogue Guild toolbench, 
# reads technical metadata metrics tables, and caches component material wire costs.
# =============================================================================
def get_wire_order_numbers
  move "out" if checkpaths("out")
  target_room = Map.list.find_all { |room| room.tags.include?("rogue guild toolbenchs") || room.tags.include?("rogue guild workshop") }
  
  start_script "go2", [Room.current.find_nearest(target_room)]
  wait_while { running?("go2") }
  
  move "go toolbench"
  fput "read sign"
  @tpick_repair_info = {}
  
  while line = get
    if line =~ /(\d+)\.\) a thin ([a-zA-Z]+) wire\s+(\d+)/i
      @tpick_repair_info[$2] = { "Order Number" => $1, "Order Cost" => $3 }
    elsif line =~ /a thin bar of vaalin/i
      break
    end
  end
  move "out" if checkpaths("out")
end

# =============================================================================
# Fallback block executing when acid or jaw traps freeze a lock mechanism.
# Routes Rogues to use wedges or 407 if the spell is known.
# =============================================================================
def fused_lock_disarm
  if @rogue_current_task == "Wedge open boxes" && @rogue_automate_current_task_with_tpick && $tpick_vars["Picking Mode"] == "worker"
    tpick_silent(true, "Working on a ;rogues task to use wedges so I'm going to use a wedge on this box.")
    $tpick_vars["Use A Wedge"] = true
    wedge_lock
  elsif Stats.prof == "Rogue"
    tpick_silent(nil, "Going to try wedging this box open.")
    wedge_lock
  elsif Stats.prof != "Rogue" && !Spell[407].known?
    tpick_silent(true, "Can't open this box.")
  elsif Stats.prof != "Rogue" && Spell[407].known?
    tpick_get_box
    tpick_silent(nil, "Going to try popping this box.")
    cast_407
  end
end

# =============================================================================
# Loop for Disarming boxes using the Disarm (408) spell.
# Incorporates Water Lore degradation to lower
# trap difficulty on difficult boxes.
# =============================================================================
def disarm_the_trap(mymax = 100, mypop = "Yes")
  box_is_disarmed = nil
  $tpick_vars["Successful Trap Corrosions"] ||= 0
  
  loop do
    tpick_cast_spells(402)
    tpick_cast_spells(404)
    tpick_cast_spells(515)
    tpick_prep_spell(408, "Disarm")
    fput "cast at ##{$tpick_vars["Current Box"].id}"
    
    while line = get
      sline = strip_xml(line)
      
      if sline =~ /Now to isolate the offending mechanism and disable it\.\.\.The.*?vibrates slightly but nothing else happens\.|You begin to probe the.*?for unusual mechanisms\.\.\.The.*?vibrates slightly but nothing else happens\./i
        tpick_silent(nil, "Couldn't disarm trap. Trying again.")
        
        if mymax < 100 
          $tpick_vars["Trap Corrosion Expires At"] = Time.now + 60
          $tpick_vars["Successful Trap Corrosions"] += 1
					
          base            = $tpick_vars["Trap Difficulty"].to_i
          bonus           = $tpick_vars["WLore Rot Bonus"].to_i
          stacks          = $tpick_vars["Successful Trap Corrosions"].to_i
          total_reduction = stacks * bonus
          max_reduction   = (base * 0.10).floor
          total_corrosion = [total_reduction, max_reduction].min
          effective       = $tpick_vars["Trap Difficulty"].to_i - total_corrosion

          tpick_silent(nil, "Original Trap Difficulty: #{base}\nTotal Trap Corrosion: #{total_corrosion}\nEffective Trap Difficulty: #{effective}")
        end
        break
      elsif sline =~ /Now to isolate the offending mechanism and disable it\.\.\.Your heart skips a beat as you hear a small sizzle from the.*?keyhole\..*?You begin to jump back\, but not in time as the entire.*?explodes in a deafening\, fiery detonation\!/i
        tpick_silent(true, "The trap was set off! Script is now exiting.")
        exit
      elsif sline =~ /Now to isolate the offending mechanism and disable it\.\.\.The.*?pulses once with a deep crimson light\!/i
        box_is_disarmed = true
        tpick_silent(nil, "Box is disarmed.")
        break
      elsif sline =~ /Spell Hindrance|fumble/i
        mymax += 1
        break
      end
    end
    mymax -= 1
    break if box_is_disarmed || mymax < 1
  end
  pop_open_box if mypop == "Yes"
end

# =============================================================================
# The beginning of the box popping feature.
# Rejects boxes that are mithril or enruned
# and also rejects plinites.
# =============================================================================
def pop_boxes_begin
  tpick_put_stuff_away
  
  if $tpick_vars["Picking Mode"] == "worker"
    tpick_get_current_worker_box
  else
    until checkright
      fput "get ##{$tpick_vars["Current Box"].id}"
      sleep 0.2
    end
    wait_until { GameObj.right_hand.name != "Empty" }
	TpickMain.update_tpick_var("Current Box", GameObj.right_hand)
  end
  
  $tpick_vars["Start Time"]           = Time.now
  $tpick_vars["Remaining 416 Casts"] = @load_data["Number Of 416 Casts"].to_i
  need_rest_check
  $tpick_vars["Hand Status"]          = nil
  
  if $tpick_vars["Picking Mode"] == "worker"
    $tpick_vars["Hand Status"] = ($tpick_vars["Current Box"].name =~ /mithril|enruned|rune-incised/i) ? "mithril or enruned" : "good"
  else
    $tpick_vars["Check For Command"] = "glance"
    $tpick_check_mithril_or_enruned.call
  end
  
  wait_until { $tpick_vars["Hand Status"] }
  
  if $tpick_vars["Current Box"].name =~ /plinite/i && $tpick_vars["Picking Mode"] == "worker"
    tpick_silent(true, "Can't open plinites when popping.")    
  elsif $tpick_vars["Hand Status"] == "mithril or enruned" && @load_data["Pick Enruned"] == "No"
    tpick_silent(true, "Can't open this box because it is mithril or enruned.")
  elsif $tpick_vars["Hand Status"] == "empty"
    tpick_silent(true, "No box was found in your hands.")
    exit
  else
    if @load_data["Phase (704)"] == "Yes"
      cast_704_at_box
    else
      tpick_silent(nil, "Checking for traps.")
      tpick_drop_box if $tpick_vars["Picking Mode"] == "ground"
      check_for_trap_with_416
    end
  end
end

# =============================================================================
# Uses Unlock (407) to pop open a box.
# Falls back to using lockpicks if the box
# is enruned or mithril.
# Keeps 403 and 515 active.
# =============================================================================
def pop_open_box
  if $tpick_vars["Hand Status"] == "mithril or enruned" && @load_data["Pick Enruned"] == "Yes"
    measure_lock
  else
    box_is_open = nil
    tpick_silent(nil, "Popping box.")
    
    loop do
      tpick_cast_spells(403)
      tpick_cast_spells(515)
      
      tpick_prep_spell(407, "Unlock")
      fput "cast at ##{$tpick_vars["Current Box"].id}"
      waitrt?
      
      while line = get
        sline = strip_xml(line)
        sline_down = sline.downcase

        if sline_down.include?("roundtime") || sline_down.include?("vibrates slightly but nothing else happens")
          break
        elsif sline_down.include?("gleaming jaws snap shut")
          break

        elsif sline_down.include?("suddenly flies open") || sline_down.include?("already open")
		  flag_box_opened
          box_is_open = true
		  pool_payment_watch
          break
        end
      end
      
      break if box_is_open
    end
  end
end

# =============================================================================
# Loop for using Piercing Gaze (416) to find traps.
# Checks for danger metrics of any trap found
# and routes the script to the next necessary step.
# Also handles getting back to starting room if
# 416 set off a Glyph trap.
# =============================================================================
def check_for_trap_with_416
  loop do
    tpick_cast_spells(402)
    tpick_cast_spells(404)
    tpick_cast_spells(515)
    
    $tpick_vars["Current Trap Type"] = nil
    tpick_prep_spell(416, "Piercing Gaze")
    fput "cast at ##{$tpick_vars["Current Box"].id}"
    
    while line = get
      sline = strip_xml(line)
      
      if sline =~ /Peering closely into the lock\, you spy an? [a-zA-Z]+ (.*?) scarab wedged into the lock mechanism\./i
        $tpick_vars["Scarab Name"]       = $1
        $tpick_vars["Current Trap Type"] = "Scarab"
      elsif sline =~ /You notice what appears to be a sharp sliver of metal nestled in a hole next to the lock plate\./i
        $tpick_vars["Current Trap Type"] = "Needle"
      elsif sline =~ /You notice a discolored oval ring around the outside of the.*?which makes you suspicious\.\s+Your suspicions are confirmed when you look inside the keyhole and notice the spring\-loaded jaws pressed flush against the.*?walls\./i
        $tpick_vars["Current Trap Type"] = "Jaws"
      elsif sline =~ /You see a tiny sphere imbedded in the lock mechanism\./i
        $tpick_vars["Current Trap Type"] = "Sphere"
      elsif sline =~ /You can see a small crystal imbedded in the locking mechanism\./i
        $tpick_vars["Current Trap Type"] = "Crystal"
      elsif sline =~ /You see a cord stretched between the lid and case\./i
        $tpick_vars["Current Trap Type"] = "Scales"
      elsif sline =~ /Peering through the .*?\, you notice that the lock casing is coated with a rough\, grainy substance\, and a small bladder is wedged between the tumblers of the lock\./i
        $tpick_vars["Current Trap Type"] = "Sulphur"
      elsif sline =~ /Looking closely into the keyhole of the lock\, you spy a small vial of liquid and a tiny hammer device which seems poised to shatter it if the lock is tampered with\./i
        $tpick_vars["Current Trap Type"] = "Cloud"
      elsif sline =~ /You notice what appears to be a tiny vial placed just past the tumblers of the lock mechanism\.\s+It appears that any tampering with the lock mechanism will cause the tumblers to crush the vial\./i
        $tpick_vars["Current Trap Type"] = "Acid Vial"
      elsif sline =~ /Peering through the .*?\, you notice that the hinges have some springs incorporated into the design in an unusual fashion\./i
        $tpick_vars["Current Trap Type"] = "Springs"
      elsif sline =~ /Looking closely into the keyhole of the lock\, you spy a small vial of fire\-red liquid and a tiny hammer device which seems poised to shatter it if the lock is tampered with\./i
        $tpick_vars["Current Trap Type"] = "Fire Vial"
      elsif sline =~ /You see a thin tube extending from the lock mechanism down into the .*?\.\s+The tube appears to be filled with a greenish powder\./i
        $tpick_vars["Current Trap Type"] = "Spores"
      elsif sline =~ /There appears to be a plate over the lock\, sealing it and preventing any access to the tumblers\./i
        $tpick_vars["Current Trap Type"] = "Plate"
      elsif sline =~ /Suddenly a dark splotch erupts from the lock mechanism and envelops you\!  Time seems to slow down and almost stop\.\.\./i
        $tpick_vars["Current Trap Type"] = "Glyph"
      elsif sline =~ /Near the lock mechanism\, you notice a pair of small metal rods a hair\'s width from rubbing together\./i
        $tpick_vars["Current Trap Type"] = "Rods"
      elsif sline =~ /The inside chamber is lined with some unidentifiable substance\./i
        $tpick_vars["Current Trap Type"] = "Boomer"
      elsif sline =~ /You gaze at the.*?but your vision is obscured\./i
        $tpick_vars["Current Trap Type"] = "check again"
      elsif sline =~ /Roundtime/i
        $tpick_stats_data[$tpick_vars["Current Trap Type"]] += 1 if $tpick_vars["Current Trap Type"] && $tpick_vars["Current Trap Type"] != "check again"
        break
      end
    end
    
    if $tpick_vars["Current Trap Type"] && $tpick_vars["Current Trap Type"] != "check again"
      tpick_silent(nil, "Found a #{$tpick_vars["Current Trap Type"]} trap.")
    end
    
    case $tpick_vars["Current Trap Type"]
    when "check again"
      tpick_silent(nil, "Failed detecting a trap, trying again.")
    when "Needle", "Jaws", "Plate"
      tpick_silent(nil, "Trap is safe to skip disarming.")
      pop_open_box
      break
    when "Crystal", "Springs"
      tpick_silent(nil, "Trap is safe to use 408 on. Must be disarmed before popping.")
      disarm_the_trap
      break
    when "Scarab", "Sphere", "Scales", "Acid Vial", "Fire Vial", "Spores", "Boomer", "Cloud", "Rods"
      tpick_silent(nil, "408 might set off trap. Must be disarmed before popping.")
      if @load_data["Only Disarm Safe"] == "Yes"
        tpick_silent(true, "Skipping box due to tpick setting 'Only Disarm Safe' is set to yes.")
        where_to_stow_box
      else
        disarm_the_trap
      end
      break
    when "Sulphur"
      tpick_silent(true, "Skipping box because 408 will set this trap off.")
      break
    when "Glyph"
      tpick_silent(true, "The box had a glyph trap on it. Taking you back to the room you started in.")
      while checkroom =~ /Temporal Rift/i
        move "e"
        sleep 0.1
      end
      sleep 0.5
      start_script "go2", [$tpick_vars["Starting Room"]]
      wait_while { running?("go2") }
      tpick_silent(true, "This box has a glyph trap and cannot be opened.")
      break
    when nil
      tpick_silent(nil, "No trap found.")
      $tpick_vars["Remaining 416 Casts"] -= 1
      if $tpick_vars["Remaining 416 Casts"] < 1
        $tpick_stats_data["No Trap"] += 1
        pop_open_box
        break
      else
        tpick_silent(nil, "416 casts remaining: #{$tpick_vars["Remaining 416 Casts"]}.")
      end
    end
  end
end

# =============================================================================
# Goes to nearest locksmith shop to fill up locksmith toolkit.
# =============================================================================
def fill_up_locksmith_container(check_lock_smiths_container)
  move "out" if checkpaths("out")
  start_script "go2", ["bank", "--disable-confirm"]
  wait_while { running?("go2") }
  
  fput "unhide" if hidden?
  fput "depo all"
  fput "withdraw 1000"
  
  start_script "go2", [Room[Room.current.find_nearest_by_tag("locksmith shop")], "--disable-confirm"]
  wait_while { running?("go2") }
  waitrt?
  fput "order"
  
  while line = get
    sline = strip_xml(line)
    if sline =~ /\d+.*?\s{2}(\d+).*?(locksmith\'s|tool kit|toolkit|leather case)/i || 
       sline =~ /(\d+).*?(locksmith\'s|tool kit|toolkit|leather case)/i
      $tpick_vars["Toolkit Order Number"] = $1
    end
    break if sline =~ /You can APPRAISE/i
  end
  
  tpick_put_stuff_away
  wait_until { !checkright && !checkleft }
  
  until checkright
    waitrt?
    fput "remove ##{$tpick_vars["Locksmith's Container"].id}"
    sleep 0.2
  end
  
  buy_locksmith_pouch
  if $tpick_vars["Putty Remaining"].to_i < 50 || $tpick_vars["Cotton Remaining"].to_i < 50
    buy_locksmith_pouch
  end
  
  fput "wear ##{$tpick_vars["Locksmith's Container"].id}"
  check_lock_smiths_container.call
end

# =============================================================================
# Start loop when using the Pop feature.
# =============================================================================
def start_pop
  total_boxes_count
  $tpick_vars["All Box IDs"].each do |box|
    break if check_loop_status

    $tpick_vars["Current Box"] = box
    pop_boxes_begin
	final_box_actions
  end
  check_disk
end

# =============================================================================
# Watches raw XML stream to determine how many putty, cotton, 
# and vials of acid are in the player's locksmith's toolkit.
# =============================================================================
check_lock_smiths_container = proc do
  action = proc { |server_string|
    clean_string = strip_xml(server_string)
    
    if clean_string =~ /lump of squishy white putty with about (\d+) pinch|(\d+) little ball|(\d+) vials? of liquid|you see a pinch of squishy white putty|unlimited amounts/i
      if clean_string =~ /unlimited amounts/i
        $tpick_vars["Putty Remaining"]  = 999
        $tpick_vars["Cotton Remaining"] = 999
      else
        $tpick_vars["Putty Remaining"] = case clean_string
                                         when /you see a lump of squishy white putty with about (\d+) pinch/i then $1.to_i
                                         when /you see a pinch of squishy white putty/i then 1
                                         else 0
                                         end
                                         
        $tpick_vars["Cotton Remaining"] = (clean_string =~ /(\d+) little ball/i) ? $1.to_i : 0
      end

      $tpick_vars["Vials Remaining"] = (clean_string =~ /(\d+) vials? of liquid/i) ? $1.to_i : 0
      DownstreamHook.remove("#{script.name}_check_locksmiths_container")
      nil
    elsif clean_string =~ /There is nothing|In the/i
      $tpick_vars["Putty Remaining"]  ||= 0
      $tpick_vars["Cotton Remaining"] ||= 0
      $tpick_vars["Vials Remaining"]  ||= 0
      DownstreamHook.remove("#{script.name}_check_locksmiths_container")
      server_string
    else
      server_string
    end
  }

  DownstreamHook.add("#{script.name}_check_locksmiths_container", action)
  silence_me

  if running?("sorter")
    kill_script "sorter"
    wait_until { !running?("sorter") }
    $tpick_vars["Start Sorter"] = true
  end

  fput "look in ##{$tpick_vars["Locksmith's Container"].id}"
  silence_me
  TpickMain.update_box_for_window
end

# =============================================================================
# While Solo picking:
# Stows the current box back in player's inventory or disk.
# =============================================================================
def where_to_stow_box
  if $tpick_vars["Picking Mode"] == "solo"
    if $tpick_vars["Stow In Disk"]
      fput "put ##{$tpick_vars["Current Box"].id} in #{Char.name} disk"
    else
      tpick_stow_box
    end
  end
end

# =============================================================================
## Checks player's experience settings to determine
# if the script should pause while mind clears out.
# Doesn't work for pool picking because that uses
# a different set of instructions for when to rest.
# =============================================================================
def need_rest_check
  if @load_data["Rest At Percent"] != "Never" && @load_data["Pick At Percent"] != "Always" && $tpick_vars["Picking Mode"] != "worker"
    rest_percent = @load_data["Rest At Percent"].to_s.scan(/\d+/).join.to_i
    
    if rest_percent <= percentmind
      pick_percent = @load_data["Pick At Percent"].to_s.scan(/\d+/).join.to_i
      tpick_silent(true, "Resting until mind reaches #{pick_percent}%.")
      wait_until { pick_percent >= percentmind }
    end
  end
end

# =============================================================================
# Scans all opened containers to find boxes
# or plinites depending on current picking mode.
# =============================================================================
def check_for_boxes
  # Optimize item scanning routines into compact, high-performance selector maps
  all_items = GameObj.containers.values.flatten
  
  if $tpick_vars["Open Plinites"]
    $tpick_vars["All Box IDs"] = all_items.select { |i| i.name =~ /plinite/i }.map(&:id)
  else
    $tpick_vars["All Box IDs"] = all_items.select { |i| i.type == "box" }.map(&:id)
  end
end

# =============================================================================
# Loop for Pool picking mode.
# Goes to nearest Pool NPC, manages cooldown checks,
# and captures job details (customer tip amounts, critter origins, level caps)
# =============================================================================
def start_pool
  loop do
    break if check_loop_status
    tpick_put_stuff_away
	TpickMain.update_tpick_var("Current Box", nil)
    waitrt?
    
    if !$tpick_vars["Pool NPC"]
      start_script "go2", ["locksmith", "pool", "--disable-confirm"]
      wait_while { running?("go2") }
      get_pool_info
    end
    
    encumbrance_check if @load_data["Auto Deposit Silvers"].to_s.strip.empty? == false
    $tpick_vars["Offered Tip Amount"] = nil
    exit if @rogue_the_current_task_is_finished
    
    if $tpick_vars["Current Minimum Tip"].to_i > 0
      fput "ask ##{$tpick_vars["Pool NPC"].id} for job minimum #{$tpick_vars["Current Minimum Tip"]}"
    else
      fput "ask ##{$tpick_vars["Pool NPC"].id} for job"
    end
    
    while line = get
      sline = strip_xml(line)
      sline_down = sline.downcase
 
      if sline_down.include?("finish the job you're working on first")
        $tpick_vars["Next Task"] = nil
        break
      elsif sline_down.include?("you've done enough boxes for now")
        if sline_down.include?("about 10 minutes from now")
          $tpick_vars["Next Task"] = "Wait 300 Seconds"
        elsif sline_down.include?("a few minutes from now")
          $tpick_vars["Next Task"] = "Wait 120 Seconds"
        elsif sline_down.include?("about a minute from now")
          $tpick_vars["Next Task"] = "Wait 60 Seconds"
        end
        break
      elsif sline_down.include?("wait a bit longer before asking again")
        $tpick_vars["Next Task"] = "Wait 10 Seconds"
        break
      elsif sline_down.include?("why don't you rest your mind a bit")
        $tpick_vars["Next Task"] = "Rest Wait"
        break
      elsif sline_down.include?("don't have any jobs for you at the moment") || sline_down.include?("haven't quite reflected on your past failure") || sline_down.include?("you've done enough")
        $tpick_vars["Next Task"] = "Tip Wait"
        break
      elsif sline_down.include?("come back when you learn a thing or two")
        tpick_silent(true, "You need to train in more ranks in lockpicking before you can pick boxes at the locksmith pool.")
        exit
 
      elsif sline_down.include?("the client is offering a tip of")
        if sline_down.include?("mentioned it being from")
          if sline =~ /says\, \"Ah\, here we are\.  The client is offering a tip of (.*?) silvers? and mentioned it being from [a-zA-Z]+ (.*?) \(level (\d+)\)\./i
            $tpick_vars["Offered Tip Amount"] = $1.delete(",").to_i	
            $tpick_vars["Critter Name"]       = $2
            $tpick_vars["Critter Level"]      = $3.to_i
            $tpick_vars["Next Task"]          = nil
            break
          end
        elsif sline_down.include?("aren't sure where it came from")
          if sline =~ /says\, \"Ah\, here we are\.  The client is offering a tip of (.*?) silvers? and they aren't sure where it came from/i
            $tpick_vars["Offered Tip Amount"] = $1.delete(",").to_i	
            $tpick_vars["Critter Name"]       = "Unknown"
            $tpick_vars["Critter Level"]      = Stats.level.to_i
            $tpick_vars["Next Task"]          = nil
            break
          end
        end
      end
    end
    
    # =====================================================================
	# Cooldown Handling:
	#  Tip settings management, wait times, and when to rest due to mind state
    # =====================================================================
    if $tpick_vars["Next Task"] =~ /Wait/i
      exit if $tpick_vars["Exit When Waiting"]
      wait_time = nil
      
      case $tpick_vars["Next Task"]
      when "Tip Wait"
        if @load_data["Minimum Tip Interval"] && @load_data["Minimum Tip Floor"]
          if $tpick_vars["Current Minimum Tip"].to_i > @load_data["Minimum Tip Floor"].to_i
            text = "No boxes at your current minimum rate. Lowering minimum tip wanted."
            $tpick_vars["Current Minimum Tip"] -= @load_data["Minimum Tip Interval"].to_i
            $tpick_vars["Current Minimum Tip"]  = [$tpick_vars["Current Minimum Tip"], @load_data["Minimum Tip Floor"].dup].max
            wait_time = (@load_data["Standard Wait"] == "No") ? @load_data["Time To Wait"].to_i : 10
          else
            $tpick_vars["Current Minimum Tip"] = @load_data["Minimum Tip Start"].dup
            text      = "No boxes at your lowest minimum rate."
            wait_time = (@load_data["Standard Wait"] == "No") ? @load_data["Time To Wait"].to_i : 30
          end
        else
          text      = "No boxes available at the moment."
          wait_time = (@load_data["Standard Wait"] == "No") ? @load_data["Time To Wait"].to_i : 30
        end
        
      when "Rest Wait"
        if $tpick_vars["Pool Fried Commands"] && @load_data["Pick At Percent"] != "Always"
          pool_fried_start_time = Time.now
          pick_percent          = @load_data["Pick At Percent"].to_s.scan(/\d+/).join.to_i
          
          tpick_silent(true, "Worker isn't assigning you boxes because your mind is too full. Running your resting routine then coming back to pick more boxes when your mind reaches #{pick_percent}%.")
          starting_pool_room_number = Room.current.id
          
          start_script "go2", [$tpick_vars["Pool Fried Commands"][0]]
          wait_while { running?("go2") }
          
          fput "#{$tpick_vars["Pool Fried Commands"][1]}" if $tpick_vars["Pool Fried Commands"][1]
          tpick_silent(true, "Resting until mind reaches #{pick_percent}%.")
          wait_until { pick_percent >= percentmind }
          
          tpick_silent(true, "Mind cleared out! Heading back to pick more boxes!")
          start_script "go2", [starting_pool_room_number]
          wait_while { running?("go2") }
          $tpick_stats_data["Pool Time Spent Waiting"] += (Time.now - pool_fried_start_time)
        else
          text      = "Worker isn't assigning boxes because your mind is too full."
          wait_time = (@load_data["Standard Wait"] == "No") ? @load_data["Time To Wait"].to_i : 120
        end
        
      else
        text      = "No boxes available at the moment."
        get_time  = $tpick_vars["Next Task"].to_s.split
        wait_time = (@load_data["Standard Wait"] == "No") ? @load_data["Time To Wait"].to_i : get_time[1].to_i
      end
 
      if wait_time
        tpick_silent(true, "#{text} Waiting #{wait_time} seconds and trying again.")
        real_time_waited = 0
        
        wait_time.times do
          break if check_loop_status
          sleep 1
          real_time_waited += 1
        end
        
        $tpick_stats_data["Pool Time Spent Waiting"] += (real_time_waited > 0) ? real_time_waited : wait_time
      end
      final_box_actions
    # =====================================================================
    # Processes assigned locksmith pool boxes
    # =====================================================================
    else
      if $tpick_vars["Critter Level"].to_i > @load_data["Max Level"].to_i
        tpick_silent(true, "Critter level too high, turning in box. Critter level: #{$tpick_vars["Critter Level"]}.")
      else
        if @rogue_current_task == "Gather trap components" && @rogue_task_for_footpad_or_administrator == "Footpad"
          tpick_silent(true, "Need #{@rogue_reps_remaining.to_i - @rogue_trap_components_needed_array.count} more trap components.")
        end
        
        tpick_stop_403_404
        $tpick_vars["Manual Trap Checks Remaining"] = @load_data["Trap Check Count"].dup
        
        if $tpick_vars["Gnomish Bracers"] && @load_data["Bracer Tier 2"] == "Yes" && $tpick_vars["Current Box"].name !~ /plinite/i
          gnomish_bracers_trap_check
        elsif $tpick_vars["Pop Boxes"]
          pop_boxes_begin
        else
          manually_disarm_trap
        end
      end
	  
	  finish_pool
	  final_box_actions
    end
  end
end

# =============================================================================
# Populates lockpick variables with corresponding details.
# =============================================================================
def lock_pick_information
  pick_type = $tpick_vars["Recommended Pick"]

  return unless LOCKPICK_MODIFIERS.key?(pick_type)

  $tpick_vars["Needed Pick"]               = @load_data[pick_type]
  $tpick_vars["Needed Pick ID"]            = @all_pick_ids[pick_type].first
  $tpick_vars["Recommended Pick Modifier"] = LOCKPICK_MODIFIERS[pick_type]

  no_vaalin_picks if pick_type == "Vaalin"
  
  case pick_type
  when "wedge"
    update_wedge_image
  else
    TpickMain.update_display_image("Chest #{pick_type} Lockpick", "Lockpick")
    TpickMain.update_window_label_text(pick_type, "Lockpick", "bottom")
  end

  TpickMain.update_window_label_text("#{$tpick_vars["Lock Difficulty"]} Lock", "Lockpick", "top")
end

# =============================================================================
# After a lockpick attempt:
# Evaluates whether the script should use wedges, 407,
# or try the next highest lockpick tier.
# =============================================================================
def nextpick2
  if $tpick_vars["Needed Pick"] == "wedge"
    if $tpick_vars["Open Plinites"] || $tpick_vars["Current Box"].name =~ /plinite/i
      if $tpick_vars["Picking Mode"] == "worker"
	    tpick_silent(true, "Can't extract this plinite based on my calculations. If you think this is in error increase the Vaalin Lock Roll setting in the setup menu.")
      else
        tpick_silent(true, "Can't extract this plinite, OPENing it instead. If you think this is in error increase the Vaalin Lock Roll setting in the setup menu.")
        waitrt?
        fput "open ##{$tpick_vars["Current Box"].id}"
      end
    elsif $tpick_vars["Scale Trap Found"]
	  tpick_silent(true, "Can't pick this box and it has a scales trap.")
    else
      if Stats.prof =~ /Rogue/i
        tpick_silent(nil, "Can't pick this lock, going to try to wedge it open.")
        wedge_lock
      elsif Spell[407].known? && !$tpick_vars["Box Has Glyph Trap"]
        tpick_silent(nil, "Can't pick this lock, going to try to pop it open.")
        cast_407
      else
        tpick_silent(true, "I can't use 407 on this box because it has a glyph trap.") if Spell[407].known? && $tpick_vars["Box Has Glyph Trap"]
        tpick_silent(true, "Couldn't open this box.")
      end
    end
  elsif $tpick_vars["Before Needed Pick"] == @load_data["Vaalin"]
    tpick_silent(nil, "Trying to pick with Vaalin lockpick again.")
    pick_2
  else
    tpick_silent(nil, "Couldn't pick lock with #{$tpick_vars["Before Pick"]} pick, trying #{$tpick_vars["Recommended Pick"]} pick.")
    pick_2
  end
end

# =============================================================================
# For solo and ground picking:
# Calculates an estimate of how many seconds left to pick remaining boxes
# based on lifetime number of boxes picked and total time it took
# to pick all of those boxes.
#
# For solo, other, and ground picking: 
# Tracks lifetime stats: number of boxes picked, total time spent picking
# Tracks number of boxes picked during the current session.
# =============================================================================
def total_boxes_picked_math(startup_announcement = false)
  return if $tpick_vars["Picking Mode"] == "worker" # The following code shouldn't be run in Worker mode.
  $tpick_vars["Box Math"] = nil if $tpick_vars["Disarm Only"] && !$tpick_vars["Bash Open Boxes"]
  
  # Only update if this is not the startup announcement.
  unless startup_announcement
    if !$tpick_vars["Box Math"]
      tpick_silent(nil, "This box was not added to your total boxes picked...")
    else
      total_picking_time = Time.now - $tpick_vars["Start Time"]
      $tpick_stats_data["Non-Pool Time Spent Picking"] += total_picking_time
      $tpick_stats_data["Non-Pool Boxes Picked"]       += 1
      $tpick_session_data["Session Boxes Picked"]      += 1
    end
    
    if ["solo", "ground"].include?($tpick_vars["Picking Mode"])
      $tpick_vars["Total Boxes Number"] = [($tpick_vars["Total Boxes Number"].to_i - 1), 0].max
    end
  end

  $tpick_stats_data["Non-Pool Time Spent Picking"] = $tpick_stats_data["Non-Pool Time Spent Picking"].round(2) unless $tpick_stats_data["Non-Pool Time Spent Picking"].zero?
  
  # Print the lifetime average estimates if at least 1 box has ever been picked.
  if $tpick_stats_data["Non-Pool Boxes Picked"].to_i > 0
    average_picking_time = ($tpick_stats_data["Non-Pool Time Spent Picking"] / $tpick_stats_data["Non-Pool Boxes Picked"]).round(2)
    formatted_boxes = $tpick_stats_data["Non-Pool Boxes Picked"].to_s.gsub(/(\d)(?=(\d{3})+(?!\d))/, '\1,')
    formatted_time  = $tpick_stats_data["Non-Pool Time Spent Picking"].to_s.gsub(/(\d)(?=(\d{3})+(?!\d))/, '\1,')

    _respond "\n" \
             "####################\n" \
             "Total boxes picked: #{formatted_boxes}\n" \
             "Total time picking: #{formatted_time} seconds\n" \
             "Average time per box: #{average_picking_time} seconds\n" \
             "####################\n" \
             "\n"
  end

  # Print the remaining boxes and time estimate using historical session averages
  if ["solo", "ground"].include?($tpick_vars["Picking Mode"]) && $tpick_vars["Total Boxes Number"].to_i > 0
    if $tpick_stats_data["Non-Pool Boxes Picked"].to_i > 0
      calculate_time_left = ($tpick_vars["Total Boxes Number"].to_i * average_picking_time).round(2)
      
      _respond "\n" \
               "####################\n" \
               "Boxes remaining: #{$tpick_vars["Total Boxes Number"]}\n" \
               "Estimated time remaining: #{calculate_time_left} seconds\n" \
               "####################\n" \
               "\n"
    end
  end
  $tpick_vars["Box Math"] = true
end

# =============================================================================
# Attempts to get loose acid vials from your locksmith pouch when bundled tools fail.
# Bypasses straight to disarming loops if found,
# otherwise initiates wedge or 407 casting paths.
# =============================================================================
def get_vials_and_stuff
  wait_until { checkrt == 0 }
  vial_command = "vial from ##{$tpick_vars["Locksmith's Container"].id}"
  unless tpick_ensure_held(vial_command, "vial")
    tpick_silent(true, "No vials found bundled in your locksmith's container and no loose vials found in your locksmith's container.")
    
    if Stats.prof == "Rogue"
      tpick_silent(nil, "Going to try wedging this box open.")
      wedge_lock
    elsif Stats.prof != "Rogue" && (!Spell[407].known? || @load_data["Unlock (407)"] !~ /Plate|All/i)
      tpick_silent(true, "Can't open this plated box.")
	  
	  exit if $tpick_vars["Picking Mode"] == "solo"
    elsif Stats.prof != "Rogue" && Spell[407].known? && @load_data["Unlock (407)"] =~ /Plate|All/i
      tpick_get_box
      tpick_silent(nil, "Going to try popping this box.")
      cast_407
    end
  else
    tpick_silent(nil, "Found a loose vial! Let's do this!")
    plate_trap_disarm
  end
end

# =============================================================================
# Ground picking: Counts how many boxes are on the ground.
# Solo picking: Counts how many boxes are in the player's inventory
# =============================================================================
def total_boxes_count
  $tpick_vars["Total Boxes Number"] = 0
  
  case $tpick_vars["Picking Mode"]
  when "ground"
    $tpick_vars["Total Boxes Number"] = GameObj.loot.select { |item| item.type == "box" && !$tpick_vars["Box IDs Already Picked"].include?(item.id) }.count
  when "solo"
    $tpick_vars["Total Boxes Number"] = $tpick_vars["All Box IDs"].length
  end
  
  total_boxes_picked_math(true)
end

# =============================================================================
# Resets variables to their default state
# whenever the player finishes work on a box.
# =============================================================================
def clear_box_variables
  $tpick_vars["Number Of Vial Disarm Tries"]      = 0
  $tpick_vars["Scale Trap Found"]                 = nil
  $tpick_vars["Current Trap Type"]                = nil
  $tpick_vars["Time To Disarm Trap"]              = nil
  $tpick_vars["True Lock Difficulty"]             = nil
  $tpick_vars["Box Has Glyph Trap"]               = nil
  $tpick_vars["Use 404/Trap Higher Than Setting"] = nil
  $tpick_vars["Current Box"]                      = nil
  $tpick_vars["Lock Difficulty"]                  = nil
  $tpick_vars["Trap Difficulty"]                  = nil
  $tpick_vars["Offered Tip Amount"]               = nil
  $tpick_vars["Critter Name"]                     = nil
  $tpick_vars["Critter Level"]                    = nil
  $tpick_vars["Window Message"]                   = nil
  $tpick_vars["Need 403"]                         = (@load_data["403"] =~ /yes/i) ? true : nil
  $tpick_vars["Need 404"]                         = (@load_data["404"] =~ /yes/i) ? true : nil
  $tpick_vars["404 Detect Check"]                 = nil
  $tpick_vars["Successful Lock Corrosions"]       = nil
  $tpick_vars["Lock Corrosion Expires At"]        = nil
  $tpick_vars["Successful Trap Corrosions"]       = nil
  $tpick_vars["Trap Corrosion Expires At"]        = nil
  $tpick_vars["Box Opened"]                       = nil
  $tpick_vars["Give Up On Box"]                   = nil
  $tpick_vars["Do Not Ask To Check"]              = nil
  $tpick_vars["Bash Check Box Not Locked"]        = nil
  TpickMain.update_box_for_window
end

# =============================================================================
# Waits for player disk then counts all boxes inside of disk.
# =============================================================================
def count_boxes_in_disk
  unless disk = GameObj.loot.find { |obj| obj.noun =~ /disk|coffin/i && obj.name =~ /#{Char.name}/i }
    tpick_silent(true, "Waiting 4 seconds for disk")
    40.times do
      break if GameObj.loot.any? { |obj| obj.noun =~ /disk|coffin/i && obj.name =~ /#{Char.name}/i }
      sleep 0.1
    end
    disk = GameObj.loot.find { |obj| obj.noun =~ /disk|coffin/i && obj.name =~ /#{Char.name}/i }
  end
  
  if disk && disk.contents.nil?
    dothistimeout("look in ##{disk.id}", 3, /In the|There is nothing in/i)
  end

  disk.contents.each do |item|
    if item.type =~ /box/i
      $tpick_vars["Total Number Of Boxes"] += 1
      $tpick_vars["All Box IDs"].push(item.id)
    end
  end
end

# =============================================================================
# Handles everything after finishing a box at the locksmith pool.
# This includes: asking for payment, giving up on a box,
# recording tip data and number of boxes picked.
# =============================================================================
def finish_pool
  waitrt?
  
  unless $tpick_vars["Do Not Ask To Check"]
    loop do
      result = dothistimeout("ask ##{$tpick_vars["Pool NPC"].id} to check", 3, /If you want to give up, ASK me to CHECK it again within 30 seconds\."|"That's some quality work\.  Here's your payment of (.*?) silvers?\."|You aren't working on a job\.|Too tough for ya, eh\?/i)
      
      if result =~ /"That's some quality work\.  Here's your payment of (.*?) silvers?\."/i
        silvers = $1.delete(",").to_i
        pool_payment_received(silvers)
        break
      elsif result =~ /You aren't working on a job/i || (result =~ /If you want to give up/i && $tpick_vars["Give Up On Box"])
        fput "ask ##{$tpick_vars["Pool NPC"].id} to check"
        break
      elsif result =~ /Too tough for ya, eh\?/i
        break
      elsif result.nil?
        tpick_silent(nil, "Didn't recognize game line I was looking for, trying again.")
        sleep 0.5
      end
    end
  end
end

# =============================================================================
# Checks die roll compared to Roll Amount setting.
# Determines if the script should go to a higher lockpick
# or try using the current lockpick again.
# =============================================================================
def roll_amount_check
  waitrt?
  is_vaalin = ($tpick_vars["Needed Pick"] == @load_data["Vaalin"])
  target_roll = is_vaalin ? @load_data["Vaalin Lock Roll"].to_i : @load_data["Lock Roll"].to_i

  if $tpick_vars["Roll Amount"].to_i > target_roll
    if is_vaalin
      if !$tpick_vars["403 Needed"] && !$tpick_vars["Never Cast 403"]
        tpick_silent(nil, "You rolled: #{$tpick_vars["Roll Amount"]}, your Vaalin Lock Roll setting: #{target_roll}. Going to use 403 now.")
        $tpick_vars["Roll Amount"] = 99
      else
        tpick_silent(true, "You rolled: #{$tpick_vars["Roll Amount"]}, your Vaalin Lock Roll setting: #{target_roll}. You are already using 403 or your settings are set to never use 403. According to your Vaalin Lock Roll setting you should stop trying to use lockpicks.")
        $tpick_vars["Roll Amount"] = 100
      end
    else
      tpick_silent(nil, "You rolled: #{$tpick_vars["Roll Amount"]}, your Lock Roll setting: #{target_roll}. Trying next pick.")
    end
    $tpick_vars["Next Task"] = "nextpick"
  else
    setting_name = is_vaalin ? "Vaalin Lock Roll" : "Lock Roll"
    tpick_silent(nil, "You rolled: #{$tpick_vars["Roll Amount"]}, your #{setting_name} setting: #{target_roll}. Trying same pick again")
    $tpick_vars["Next Task"] = "pick3"
  end
end

# =============================================================================
# End result of using detect on a plinite.
# Determines extract difficulty and whether the
# player is able to successfully extract the core.
# =============================================================================
def detect_plinite_result
  waitrt?
  $tpick_vars["Plinite Already Open"] = nil
  
  tpick_cast_spells(404)
  tpick_cast_spells(506)
  
  loop do
    result = dothistimeout("detect ##{$tpick_vars["Current Box"].id}", 3, /It looks like it would be.*?\(\-(\d+)\)\.|You struggle to determine the difficulty of the extraction \(somewhere between .*? and \-(\d+)\)\.|You promptly discover that the core has already been removed\.|You are unable to determine the difficulty of the extraction\.|You promptly discover that the core has already been extracted and merely needs to be PLUCKed from the tip of the shard\./i)
    
    if result =~ /It looks like it would be.*?\(\-(\d+)\)\./i || result =~ /You struggle to determine the difficulty of the extraction \(somewhere between .*? and \-(\d+)\)\./i
      $tpick_vars["Lock Difficulty"] = $1.to_i
      break
    elsif result =~ /You promptly discover that the core has already been removed\./i
      tpick_silent(nil, "This plinite has already been extracted.")
      tpick_put_stuff_away
      $tpick_vars["Plinite Already Open"] = true
      break
    elsif result =~ /You are unable to determine the difficulty of the extraction\./i
      $tpick_vars["Can't Determine Plinite Difficulty"] = true
      $tpick_vars["Lock Difficulty"] = 1_000_000
      break
    elsif result =~ /You promptly discover that the core has already been extracted and merely needs to be PLUCKed from the tip of the shard\./i
      open_current_plinite unless $tpick_vars["Picking Mode"] == "worker"
      $tpick_vars["Plinite Already Open"] = true
      break
    elsif result.nil?
      sleep 0.5
    end
  end
  
  TpickMain.update_box_for_window
end

# =============================================================================
# Uses Phase (704) to determine if the box has a Glyph trap on it.
# =============================================================================
def cast_704_at_box
  waitrt?
  waitcastrt?
  
  loop do
    tpick_prep_spell(704, "Phase")
    result = dothistimeout("cast at ##{$tpick_vars["Current Box"].id}", 3, /resists the effects of your magic|appears lighter|then stabilizes|but quickly returns to normal|Roundtime/i)
	TpickMain.update_tpick_var("Current Box", GameObj.right_hand)
    
    if result =~ /resists the effects of your magic/i
	  tpick_silent(true, "Box has a glyph trap and cannot be opened.")
      break
    elsif result =~ /appears lighter|then stabilizes|but quickly returns to normal|Roundtime/i
      tpick_silent(nil, "Box has no glyph trap. Checking for other traps.")
      if $tpick_vars["Picking Mode"] != "worker"
        tpick_drop_box
        tpick_get_box
      end
      check_for_trap_with_416
      break
    elsif result.nil?
      sleep 0.5
    end
  end
end

# =============================================================================
# Buys new toolkits to bundle cotton balls
# and putty into player's toolkit.
# =============================================================================
def buy_locksmith_pouch
  fput "order #{$tpick_vars["Toolkit Order Number"]}"
  fput "buy"
  wait_until { checkleft }
  fput "open ##{GameObj.left_hand.id}"
  fput "bundle"
  $tpick_vars["Current Box"] = GameObj.left_hand
  tpick_drop_box
end

# =============================================================================
# Get the lock difficulty if the player is able to.
# Rogues will use calipers.
# Bards will use Loresinging.
# =============================================================================
def measure_detection
  loop do
    $tpick_vars["Lock Difficulty"] = nil
    $tpick_vars["Measured Lock"]   = nil
    
    case Stats.prof
    when "Rogue"
      tpick_silent(nil, "Measuring lock.")
      unless tpick_ensure_held("my calipers", "calipers")
        tpick_silent(
          true,
          "To fix this issue enter ;tpick setup\n" \
          "Make sure your calipers container is filled out properly and that you have calipers.\n" \
          "If you don't want to use calipers then go to the 'Other' tab and uncheck the box for the 'Use Calipers' setting.\n\n"
        )
        exit
      end
      fput "lmaster measure ##{$tpick_vars["Current Box"].id}"
      TpickMain.update_window_label_text("Measuring lock...", "Lockpick", "bottom")
      TpickMain.update_display_image("Chest Calipers", "Lockpick")
      
    when "Bard"
      tpick_silent(nil, "Loresinging to box to find out lock difficulty.")
      tpick_get_box
      waitrt?
      fput "speak bard"
      
      if $tpick_vars["Picking Mode"] == "worker"
        loresong_stuff = "loresing ::#{Char.name} #{$tpick_vars["Current Box"].noun} on #{$tpick_vars["Pool Table"]}:: #{$tpick_vars["Current Box"].noun} that looks like a clock;What's the purpose of your lock?"
      else
        loresong_stuff = "loresing #{checkright} that I hold;let your purpose now be told"
      end
      
      TpickMain.update_window_label_text("Singing to lock...", "Lockpick", "bottom")
      TpickMain.update_display_image("Chest Loresinging", "Lockpick")
      
      loop do
        result = dothistimeout(loresong_stuff.to_s, 2, /^You sing/i)
        break if result =~ /^You sing/i
      end
    end

    while line = get
      sline = strip_xml(line)
      
      if sline =~ /\-(\d+) in thief\-lingo difficulty ranking/i
        $tpick_vars["Lock Difficulty"] = $1.to_i
        break
      end

      sline_downcase = sline.downcase
      $tpick_vars["Lock Difficulties"].each do |key, value|
        if sline_downcase.include?(key.downcase)
          $tpick_vars["Lock Difficulty"] = value
          break
        end
      end
      break if $tpick_vars["Lock Difficulty"]

      # =============================================================================
      # SOUL GOLEM BOXES
      # Soul Golem boxes always appear as trapped, so this properly
      # handles this messaging depending on whether or not the box came
      # from a Soul Golem.
      # =============================================================================
      if sline =~ /You place the probe in the lock and grimace as something feels horribly wrong/i
        if $tpick_vars["Critter Name"] =~ /soul golem/i || $tpick_vars["Picking Mode"] != "worker"
          $tpick_vars["Lock Difficulty"] = "need vaalin"
        else
          $tpick_vars["Give Up On Box"]  = true
          $tpick_vars["Lock Difficulty"] = "Soul Golem"
      end
      break
    end
	# =============================================================================
      
      if sline =~ /has already been unlocked|isn\'t even closed/i
        $tpick_vars["Lock Difficulty"] = "not locked"
        flag_box_opened
        break
      elsif sline =~ /As you start to place the probe in the lock/i
        $tpick_vars["Lock Difficulty"] = "can't find trap"
        break
      elsif sline =~ /but your song simply wasn\'t powerful enough/i
        $tpick_vars["Lock Difficulty"] = "can't measure"
        break
      elsif sline =~ /^Try measuring something with a lock\./i
        exit
      end
    end

    waitrt?
    $tpick_vars["Measured Lock"] = $tpick_vars["Lock Difficulty"] if $tpick_vars["Lock Difficulty"].is_a?(Integer)
    
    if $tpick_vars["Lock Difficulty"].is_a?(Integer) && @load_data["Lock Buffer"].to_i > 0
      $tpick_vars["Lock Difficulty"] += @load_data["Lock Buffer"].to_i
      tpick_silent(nil, "You have lock buffer set to #{@load_data["Lock Buffer"]}, going to assume this lock is +#{@load_data["Lock Buffer"]} higher at -#{$tpick_vars["Lock Difficulty"]}")
    end
    
    $tpick_vars["Number Of Times To Measure"] += 1
    
    if $tpick_vars["Lock Difficulty"] == "can't measure" && $tpick_vars["Number Of Times To Measure"] < 3
      next
    elsif $tpick_vars["Lock Difficulty"] == "IMPOSSIBLE"
      $tpick_vars["Lock Difficulty"] = "can't measure"
      break
    else
      break
    end
  end
  
  TpickMain.update_box_for_window
end


# =============================================================================
# Go to nearest bank and deposit silver
# if the player's encumbrance is high.
# =============================================================================
def encumbrance_check
  if percentencumbrance > 99
    tpick_silent(nil, "Your settings indicate you want to deposit silvers when encumbered, and you are encumbered, so we are depositing silvers.")
    $tpick_vars["Starting Room Number"] = Room.current.id
    
    if @load_data["Auto Deposit Silvers"] !~ /yes/i
      script_commands = @load_data["Auto Deposit Silvers"].to_s.split(" ")
      start_script(script_commands[0].to_s, script_commands[1..4].map(&:to_s))
      wait_while { running?(script_commands[0].to_s) }
    end
    
    start_script "go2", ["bank", "--disable-confirm"]
    wait_while { running?("go2") }
    fput "depo all"
    
    start_script "go2", [$tpick_vars["Starting Room Number"]]
    wait_while { running?("go2") }
  end
end

# =============================================================================
# Enforces a slight pause to prevent missed
# commands from entering commands too fast.
# =============================================================================
def coins_from_boxes_pause
  if $tpick_vars["Silvers From Box"].to_i < 625
    sleep 0.01
  else
    waitrt?
    sleep 1
    waitrt?
  end
  waitrt?
end

# =============================================================================
# Handles what to do with the current item that needs to be looted.
# Ensures cursed items won't be picked up,
# handles using Fossil Charm for silver,
# bundles Acid Vials in locksmith toolkit,
# and tracks loot picked up.
# =============================================================================
def tpick_gather_the_loot
  waitrt?
  current_item = $tpick_vars["Current Item"]

  return if current_item.type =~ /cursed/i || current_item.type == "box"

  # =====================================================================
  # Coin Gathering
  # =====================================================================
  if current_item.name =~ /coins/i
    if @load_data["Fossil Charm"].to_s.length > 1
      fput "point my #{@load_data["Fossil Charm"]} at ##{$tpick_vars["Current Box"].id}"
      while line = get
        sline = strip_xml(line)
        if sline =~ /You summon .*? They locate a pile of (.*?) coin/i
          $tpick_vars["Silvers From Box"] = $1.delete(",").to_i
          break
        end
      end
    else
      $tpick_vars["Got All Coins"] = nil
      loop do
        break if $tpick_vars["Got All Coins"]
        fput "get ##{current_item.id}"
        
        while line = get
          sline = strip_xml(line)
          if sline =~ /You gather the remaining (.*?) coins?/i
            $tpick_vars["Silvers From Box"] = $1.delete(",").to_i
            coins_from_boxes_pause
            $tpick_vars["Got All Coins"] = true
            break
          elsif sline =~ /^You can only collect (.*?) of the coins due to your load\./i
            $tpick_vars["Silvers From Box"] = $1.delete(",").to_i
            tpick_silent(true, "You can't carry anymore silvers!")
            coins_from_boxes_pause
            $tpick_vars["Got All Coins"] = true
            break
          elsif sline =~ /^You cannot hold any more silvers\./i
            tpick_silent(true, "You can't carry anymore silvers!")
            $tpick_vars["Got All Coins"] = true
            break
          elsif sline =~ /^You gather (.*?) of the coins?/i
            $tpick_vars["Silvers From Box"] = $1.delete(",").to_i
            coins_from_boxes_pause
            break
          end
        end
      end
    end
    
    $tpick_session_data["Silver"] += $tpick_vars["Silvers From Box"].to_i
    $tpick_stats_data["Loot Total"]["Silver"] += $tpick_vars["Silvers From Box"].to_i if @load_data["Track Loot"] == "Yes"

  # =====================================================================
  # Other loot
  # =====================================================================
  else
    $tpick_cannot_pick_up_items ||= []
    add_stats = true
    
    unless $tpick_cannot_pick_up_items.include?(current_item.id)
      if $tpick_vars["Picking Up"]
        fput "get ##{current_item.id}"
        wait_until { checkleft }
        tpick_put_stuff_away
      else
        result = dothistimeout("get ##{current_item.id}", 2, /^You pick up|^You can\'t|You remove/i)
        if result =~ /^You can\'t/i
          add_stats = nil
          $tpick_cannot_pick_up_items.push(current_item.id) unless $tpick_cannot_pick_up_items.include?(current_item.id)
        end
      end
      
      if add_stats
        $tpick_session_data["Loot Session"][current_item.name] ||= 0
        $tpick_session_data["Loot Session"][current_item.name] += 1
        
        if current_item.type !~ /^(clothing|junk|food|herb|toy|ammo)$/i && @load_data["Track Loot"] == "Yes"
          $tpick_stats_data["Loot Total"][current_item.name] ||= 0
          $tpick_stats_data["Loot Total"][current_item.name] += 1
        end
      end
    end

    # =====================================================================
    # Acid Vials
    # =====================================================================
    10.times do
      break if GameObj.right_hand.id == current_item.id || GameObj.left_hand.id == current_item.id
      sleep 0.1
    end

    if current_item.name =~ /vial/i && (GameObj.right_hand.name =~ /vial/i || GameObj.left_hand.name =~ /vial/i)
      if @load_data["Auto Bundle Vials"] == "Yes"
        tpick_bundle_vials
      end
    end

    tpick_put_stuff_away
  end
  waitrt?
end

# =============================================================================
# Determines what to do with the current plinite depending on the results of using detect.
# =============================================================================
def detect_plinite
  $tpick_vars["Need 404"] = true unless $tpick_vars["Never Cast 404"]
  waitrt?
  no_vaalin_picks
  
  exit unless tpick_ensure_held(@all_pick_ids["Vaalin"].first, @load_data["Vaalin"])
  
  detect_plinite_result
  tpick_put_stuff_away
  
  if !$tpick_vars["Plinite Already Open"]
    $tpick_vars["Total Pick Skill"] = ($tpick_vars["Pick Skill"].to_i + $tpick_vars["Pick Lore"].to_i) * 2.50
    
    if $tpick_vars["Lock Difficulty"].to_i > ($tpick_vars["Total Pick Skill"].to_i + @load_data["Vaalin Lock Roll"].to_i)
      $tpick_vars["Can't Determine Plinite Difficulty"] = nil
      
      if $tpick_vars["Picking Mode"] == "worker"
	    tpick_silent(true, "Can't extract this plinite based on my calculations.\nIf you think this is in error increase the Vaalin Lock Roll setting in the setup menu.")
      else
        tpick_silent(true, "Can't extract this plinite, OPENing it instead.\nIf you think this is in error increase the Vaalin Lock Roll setting in the setup menu.")
        waitrt?
        fput "open ##{$tpick_vars["Current Box"].id}"
		flag_box_opened
      end
    else
      calculate_needed_lockpick
      text = "Recommended lock pick: #{$tpick_vars["Recommended Pick"]} with a modifier of #{$tpick_vars["Recommended Pick Modifier"]}\n"
      
      if $tpick_vars["403 Needed"]
        if $tpick_vars["Use 403 For Lock Difficulty"] && $tpick_vars["Lock Difficulty"].to_i > $tpick_vars["Use 403 For Lock Difficulty"].to_i
          text += "Lock difficulty is higher than your 403 setting in setup menu, using 403.\n"
        else
          text += "Recommend 403: Yes\n"
        end
        text += "Your calculated lockpicking skill: #{$tpick_vars["Pick Skill"]}\n" \
                "Your calculated lockpicking lore: #{$tpick_vars["Pick Lore"]}\n"
        temp_math_number = $tpick_vars["Pick Skill"].to_i + $tpick_vars["Pick Lore"].to_i
      else
        text += "Recommend 403: No\n" \
                "Your calculated lockpicking skill: #{$tpick_vars["Pick Skill"]}\n"
        temp_math_number = $tpick_vars["Pick Skill"].to_i
      end
      
      quick_maths = (temp_math_number * $tpick_vars["Recommended Pick Modifier"].to_f).truncate
      tpick_silent(nil, text)
      
      if !$tpick_vars["Needed Pick ID"]
        if $tpick_vars["Recommended Pick"].to_s.capitalize == "Vaalin"
          tpick_silent(true, "ALL OF YOUR VAALIN LOCKPICKS ARE BROKEN. YOU REALLY SHOULD HAVE AT LEAST 1 WORKING VAALIN LOCKPICK WHEN RUNNING THIS SCRIPT.")
          exit
        else
          tpick_silent(true, "All of your #{$tpick_vars["Recommended Pick"]} lockpicks seem to be broken, trying a higher tier lockpick.")
        end
        next_pick
      else
        pick_2
      end
    end
  elsif $tpick_vars["Plinite Already Open"]
    $tpick_vars["Give Up On Box"] = true if $tpick_vars["Picking Mode"] == "worker"
  end
end

# =============================================================================
# Gets the ID of the player's scale weapon.
# Handles various ways of locating the weapon.
# Exits if the weapon can't be found.
# =============================================================================
def find_scale_weapon_id
  swc          = $tpick_vars["Scale Weapon Container"]
  scale_weapon = @load_data["Scale Trap Weapon"]
  
  Script.current.want_downstream_xml = true
  
  line = nil
  if !swc.contents
    fput "look in ##{swc.id}"
    line = matchtimeout 3, "In the"
  end

  found_item = swc.contents.to_a.find { |i| i.name =~ /#{Regexp.escape(scale_weapon.to_s)}/i }
  sw_id = found_item ? found_item.id : nil
  
  if !sw_id
    found_item = GameObj.containers.values.flatten.find { |i| i.name =~ /#{Regexp.escape(scale_weapon.to_s)}/i }
    sw_id = found_item ? found_item.id : nil
  end

  if !sw_id && line.to_s =~ /a exist="(\d+)" noun="#{Regexp.escape(scale_weapon.to_s)}"/i
    echo "Found your weapon. Your container may not be emitting normal Wrayth tags like <inv> and <container>."
    sw_id = $1
  end
  
  Script.current.want_downstream_xml = false

  if !sw_id
    echo "I still can't find your scale weapon. It may be in a unique container."
    echo "Going to force the issue by GETTING it."
    fput "get my #{scale_weapon}"
    matchtimeout 3, "#{scale_weapon}"
    
    if GameObj.right_hand.id.nil?
      echo "Unable to find your scale weapon. Please make sure it is on your character and not in a closed container."
      exit
    else
      echo "Found your scale weapon."
      sw_id = GameObj.right_hand.id
      fput "put ##{sw_id} in my #{swc}"
      matchtimeout 2, "You put"
    end
  end
  
  $tpick_vars["Scale Weapon ID"] = sw_id
end

# =============================================================================
# Finds and indexes all lockpicks.
# Also finds the player's locksmith toolkit.
# =============================================================================
def check_for_lockpicks_etc(check_lock_smiths_container)
  find_scale_weapon_id

  lpc = "Lockpick Container"
  if !$tpick_vars[lpc].contents
    fput "look in ##{$tpick_vars[lpc].id}"
    sleep 1
  end

  $tpick_vars[lpc].contents.to_a.each do |i|
    @all_pick_ids.each_key   { |name| @all_pick_ids[name].push(i.id) if @settings_pick_names[name].to_a.include?(i.name) }
    @all_repair_ids.each_key { |name| @all_repair_ids[name].push(i.id) if @all_repair_names[name].to_a.include?(i.name) }
  end

  if @all_pick_ids["Vaalin"].empty?
    command_to_use = (@load_data[lpc] =~ /vambrace/i) ? "look in ##{$tpick_vars[lpc].id}" : "look on ##{$tpick_vars[lpc].id}"
    status_tags
    fput command_to_use
    
    while line = get
      sline = strip_xml(line)
      if sline =~ /you see/i
        lockpick_container_contents = line.to_s.split(/ an? /)
        break
      elsif sline =~ /There is nothing on/i
        break
      end
    end
    status_tags

    if lockpick_container_contents
      lockpick_container_contents_hash = {}
      lockpick_container_contents.each do |i|
        lockpick_container_contents_hash[$2] = $1 if i =~ /exist\=\"(.*?)\" noun\=\".*?\"\>(.*?)\<\/a\>/i
      end
      
      lockpick_container_contents_hash.each do |key, value|
        @all_pick_ids.each_key   { |name| @all_pick_ids[name].push(value) if @settings_pick_names[name].to_a.include?(key) }
        @all_repair_ids.each_key { |name| @all_repair_ids[name].push(value) if @all_repair_names[name].to_a.include?(key) }
      end
    end
  end

  if $tpick_vars[lpc]
    check_lock_smiths_container.call
	wait_until{ $tpick_vars["Putty Remaining"] }

    if $tpick_vars["Putty Remaining"].to_i.zero? && $tpick_vars["Cotton Remaining"].to_i.zero?
      $tpick_vars["Error Message"] = "The container you have selected as your Locksmith's Container doesn't appear to be a Locksmith's Container. Run ;tpick setup and be sure to select your Locksmith's Container. Your Locksmith's Container is where your putty and cotton balls are stored."
      exit
    end
	
    tpick_silent(true, "Putty remaining: #{$tpick_vars["Putty Remaining"]}\nCotton balls remaining: #{$tpick_vars["Cotton Remaining"]}\nVials of acid remaining: #{$tpick_vars["Vials Remaining"]}")
    start_script "sorter" if $tpick_vars["Start Sorter"]
  end
end

# =============================================================================
# Goes to nearest bank to withdraw needed silver,
# buys the needed wire, and repairs the broken lockpick.
# =============================================================================
def tpick_repair_lockpicks(pick, material)
  result = dothistimeout("look ##{pick}", 1, /The.*appears to be broken\.|You see nothing unusual\.|I could not find what you were referring to\.|appears to be somewhat damaged/i)
  
  if result =~ /The.*appears to be broken\./i
    get_wire_order_numbers unless @tpick_repair_info

    if !@tpick_repair_info || !@tpick_repair_info.key?(material)
      tpick_silent(true, "Error: Missing Rogue Guild wire records for material: #{material}")
      return
    end

    fput "get ##{pick}"
    move "out" if checkpaths("out")
    
    start_script "go2", ["bank", "--disable-confirm"]
    wait_while { running?("go2") }
    fput "depo all"
    fput "withdraw #{@tpick_repair_info[material]["Order Cost"]} silvers"
    
    target_room = Map.list.find_all { |room| room.tags.include?("rogue guild toolbenchs") || room.tags.include?("rogue guild workshop") }
    start_script "go2", [Room.current.find_nearest(target_room)]
    wait_while { running?("go2") }
    
    move "go toolbench"
    waitrt?
    fput "order #{@tpick_repair_info[material]["Order Number"]}"
    fput "buy"
    waitrt?
    
    result = dothistimeout("lmas repair ##{pick}", 2, /cooling rapidly to form a tight bond|but the broken tip refuses to work free/i)
    if result =~ /cooling rapidly to form a tight bond/i
      waitrt?
      fput "put ##{pick} in ##{$tpick_vars["Lockpick Container"].id}"
    elsif result =~ /but the broken tip refuses to work free/i
      tpick_silent(true, "This lockpick cannot be repaired.")
      exit
    elsif result.nil?
      tpick_silent(true, "Didn't recognize any game lines.")
      exit
    end
  end
end

# =============================================================================
# Bashes the box open.
# =============================================================================
def bash_the_box_open
  current_box_id = $tpick_vars["Current Box"].id
  if GameObj.right_hand.id == current_box_id || GameObj.left_hand.id == current_box_id
    fput "drop ##{current_box_id}"
  end
  
  tpick_silent(nil, "Bashing open box.")
  waitrt?
  
  loop do
    result = dothistimeout("open ##{current_box_id}", 3, /That is already open\.|You open|It appears to be locked\./i)
    if result =~ /That is already open\.|You open/i
      $tpick_vars["Box Math"]                  = nil
      $tpick_vars["Bash Check Box Not Locked"] = true
      break
    elsif result =~ /It appears to be locked\./i
      fput "get my #{@load_data["Bashing Weapon"]}"
      until $tpick_vars["Current Box"].status == "gone"
        waitrt?
        fput "bash ##{current_box_id}"
        waitrt?
        sleep 0.2
      end
      break
    elsif result.nil?
      sleep 0.5
    end
  end
  
  flag_box_opened
end

# =============================================================================
# Calculates needed lockpick to pick
# current lock based on player settings.
# Also manages 403 and 404.
# =============================================================================
def calculate_needed_lockpick
  number = 0
  $tpick_vars["Total Pick Skill"] = $tpick_vars["Pick Skill"].to_i + $tpick_vars["Pick Lore"].to_i

  skill_max_roll = ($tpick_vars["Total Pick Skill"].to_i * 2.50) - $tpick_vars["Lock Difficulty"].to_i + @load_data["Lock Roll"].to_i
  
  if skill_max_roll < 100 || $tpick_vars["Can't Determine Plinite Difficulty"]
    $tpick_vars["Needed Pick"]    = @load_data["Vaalin"]
    $tpick_vars["Needed Pick ID"] = @all_pick_ids["Vaalin"].first
    no_vaalin_picks
    
    unless $tpick_vars["Never Cast 403"]
      $tpick_vars["403 Needed"] = true
      $tpick_vars["Need 403"]   = true
    end
    $tpick_vars["Need 404"] = true unless $tpick_vars["Never Cast 404"]
    number = 19
  else
    $tpick_vars["Pick Mod"].each do |mod|
      $tpick_vars["Total Pick Skill"] = $tpick_vars["Pick Skill"].to_i * mod.to_f
      if $tpick_vars["Total Pick Skill"] - $tpick_vars["Lock Difficulty"].to_i + @load_data["Lock Roll"].to_i < 100
        number += 1
        $tpick_vars["Need 403"] = true if number > 18 && !$tpick_vars["Never Cast 403"]
      else
        break
      end
      
      if $tpick_vars["Use 403 For Lock Difficulty"] && $tpick_vars["Lock Difficulty"].to_i > $tpick_vars["Use 403 For Lock Difficulty"].to_i
        $tpick_vars["Need 403"] = true
      end
    end
    
    if $tpick_vars["Need 403"]
      number = 0
      $tpick_vars["403 Needed"] = true unless $tpick_vars["Never Cast 403"]
      $tpick_vars["Need 404"]   = true unless $tpick_vars["Never Cast 404"]
      
      $tpick_vars["Pick Mod"].each do |mod|
        $tpick_vars["Total Pick Skill"] = ($tpick_vars["Pick Skill"].to_i + $tpick_vars["Pick Lore"].to_i) * mod.to_f
        if $tpick_vars["Total Pick Skill"] - $tpick_vars["Lock Difficulty"].to_i + @load_data["Lock Roll"].to_i < 100
          number += 1
        else
          break
        end
      end
    end
  end
  
  number = [number, 19].min
  $tpick_vars["Recommended Pick"] = LOCKPICK_TIERS[number]
  lock_pick_information
end

# =============================================================================
# Helper for tpick_put_stuff_away.
# Handles stowing lockpicks, wedges, calipers, and weapons.
# =============================================================================
def self.stow_tool_item(item)
  if @all_pick_ids.any? { |_, values| values.include?(item.id) }
    return @tpick_lockpick_is_broken ? $tpick_vars["Broken Lockpick Container"].id : $tpick_vars["Lockpick Container"].id
  elsif item.name =~ /wedge/i
    return $tpick_vars["Wedge Container"].id
  elsif item.name =~ /caliper/i
    return $tpick_vars["Calipers Container"].id
  elsif item.id == $tpick_vars["Scale Weapon ID"]
    return $tpick_vars["Scale Weapon Container"].id
  end
  nil
end

# =============================================================================
# Helper for tpick_put_stuff_away.
# Handles matching loose loot against player 'Other Containers' settings.
# =============================================================================
def self.stow_loot_item(item)
  return [nil, nil] if @all_other_container_options.empty?

  item_name_down = item.name.downcase
  item_type_down = item.type.downcase

  @all_other_container_options.each do |option|
    clean_option = option.to_s.strip.split(":")
    next if clean_option.length < 2
    
    pattern = clean_option[0].strip
    bag_name = clean_option[1].strip
    pattern_down = pattern.downcase
    
    if item_name_down.include?(pattern_down) || item_type_down.include?(pattern_down)
      matched_bag = GameObj.inv.find { |t| t.name == bag_name }
      return matched_bag ? [matched_bag.id, nil] : [nil, bag_name]
    end
  end
  [nil, nil]
end

# =============================================================================
# Checks both hands and puts necessary tools away where they belong.
# Delegates sorting to tool and loot helper methods.
# =============================================================================
def tpick_put_stuff_away
  @rogue_trap_components_needed_nouns ||= []
  both_hands = [GameObj.right_hand, GameObj.left_hand]
  
  both_hands.each do |item|
    next if item.nil? || item.name == "Empty"
    
    if @rogue_trap_components_needed_nouns.include?(item.noun)
      if @rogue_trap_components_needed_nouns.any? { |noun| noun.match?(/vial/) }
        if (item.name =~ /clear glass vial/i && @rogue_trap_components_needed_names.include?("clear vial")) || 
           (item.name =~ /thick glass vial|green\-tinted vial/i && @rogue_trap_components_needed_names.include?("thick vial"))
          @rogue_trap_components_needed_array.push(item.id)
        end
      else
        @rogue_trap_components_needed_array.push(item.id)
      end
    end

    next unless item.name != "Empty" && (item.id != $tpick_vars["Current Box"].id || @tpick_stow_current_box)

    container_id_to_stow_item_in = stow_tool_item(item)
    short_name_container = nil

    if container_id_to_stow_item_in.nil?
      container_id_to_stow_item_in, short_name_container = stow_loot_item(item)
    end
    
    item_stowed = proc { GameObj.right_hand.id != item.id && GameObj.left_hand.id != item.id }

    if container_id_to_stow_item_in || short_name_container
      unless item_stowed.call
        3.times do
          waitrt?
          if container_id_to_stow_item_in
            fput "put ##{item.id} in ##{container_id_to_stow_item_in}"
          else
            fput "put ##{item.id} in my #{short_name_container}"
          end
          
          10.times do
            break if item_stowed.call
            sleep 0.1
          end
          break if item_stowed.call
        end
      end
      
      if GameObj.right_hand.id == item.id || GameObj.left_hand.id == item.id
        tpick_silent(nil, "Couldn't put #{item.name} in its proper container, STOWing it instead.")
      end
    end

    unless item_stowed.call
      3.times do
        waitrt?
        fput "stow ##{item.id}"
        
        10.times do
          break if item_stowed.call
          sleep 0.1
        end
        break if item_stowed.call
      end
    end

    if GameObj.right_hand.id == item.id || GameObj.left_hand.id == item.id
      echo "Your STOW container is out of space."
      echo "Pausing the script while you put it somewhere else."
      pause_script
    end
  end
  
  @tpick_stow_current_box   = nil
  @tpick_lockpick_is_broken = nil
end

# =============================================================================
# Casting wrapper.
# Handles using Lmas Focus instead of 403/404,
# casts required spell, tracks mana limits,
# and Removes Armor if necessary.
# =============================================================================
def tpick_cast_spells(number)
  if number == 403
    return if $tpick_vars["Never Cast 403"] || (!$tpick_vars["Need 403"] && !$tpick_vars["Use 403"])
    $tpick_vars["Need 403"] = true
  elsif number == 404
    return if $tpick_vars["Never Cast 404"] || (!$tpick_vars["Need 404"] && !$tpick_vars["Use 404"] && !$tpick_vars["404 Detect Check"])
  else
    return unless $tpick_vars["Use #{number}"]
  end

  spell_name_to_check = case number
                        when 402  then "Presence"
                        when 403  then "Lock Pick Enhancement"
                        when 404  then "Disarm Enhancement"
                        when 506  then "Celerity"
                        when 515  then "Rapid Fire"
                        when 613  then "Self Control"
                        when 1006 then "Song of Luck"
                        when 1035 then "Song of Tonis"
                        end

  if @load_data["Use Lmaster Focus"] == "Yes" && (number == 403 || number == 404)
    if !Effects::Buffs.active?('Focused')
      loop do
        result = dothistimeout "lmaster focus", 2, /You focus intently on your picking and disarm skill\./i
        break if result =~ /You focus intently on your picking and disarm skill\./i
      end
    end

    
  elsif @load_data["Percent Mana To Keep"].to_i > percentmana.to_i
    tpick_silent(true, "According to your settings your current mana is too low to cast spells.")
  else
    spell_needs_to_be_recast = nil
    
    if Spell[spell_name_to_check].known?
      if [402, 506, 515, 1035].include?(number)
        active_state = Effects::Buffs.active?(spell_name_to_check)
        time_offset  = active_state ? (Time.now - Effects::Buffs.to_h[spell_name_to_check]).abs : 0
        spell_needs_to_be_recast = true if !active_state || (active_state && time_offset > 10)
      else
        active_state = Effects::Spells.active?(spell_name_to_check)
        time_offset  = active_state ? (Time.now - Effects::Spells.to_h[spell_name_to_check]).abs : 0
        spell_needs_to_be_recast = true if !active_state || (active_state && time_offset > 10)
      end
    end
    
    if spell_needs_to_be_recast
      unless number == 1035 && !Spell[spell_name_to_check].affordable?
        if number == 515
          if checkmana < 50
            tpick_silent(true, "Waiting for at least 50 mana before casting Rapid Fire (515).")
            wait_until { checkmana(50) }
          end
        elsif (Spell[spell_name_to_check].cost.to_i + 5) > checkmana
          tpick_silent(true, "Waiting for mana.")
          wait_until { (Spell[spell_name_to_check].cost.to_i + 5) < checkmana }
        end

        if $tpick_vars["Armor To Remove"] && !$tpick_vars["Armor Removed"] && checkroom !~ /table/i
          $tpick_vars["Armor Removed"] = true
          wait_until { checkrt == 0 }
          fput "remove #{$tpick_vars["Armor To Remove"]}"
          fput "stow #{$tpick_vars["Armor To Remove"]}"
        end
        
        until Spell[spell_name_to_check].active?
          Spell[spell_name_to_check].cast
        end
        sleep 0.2
      end
    end
  end
  waitrt?
end

# =============================================================================
# Prepares and casts required spell, making sure
# to always have enough mana to cast the spell +5 mana
# for when using Rapid Fire (515)
# =============================================================================
def tpick_prep_spell(number, name)
  if Spell[number].known?
    if (Spell[number].cost.to_i + 5) > checkmana
      tpick_silent(true, "Waiting for mana.")
      wait_until { (Spell[number].cost.to_i + 5) < checkmana }
    end
    
    until checkprep == name.to_s
      waitrt?
      waitcastrt?
      fput "release" if checkprep !~ /None|#{Regexp.escape(name.to_s)}/i
      fput "prep #{number}"
      sleep 0.2
    end
  end
end

# =============================================================================
# Drops the current box on the ground.
# =============================================================================
def tpick_drop_box
  box_id = $tpick_vars["Current Box"].id
  until GameObj.right_hand&.id != box_id && GameObj.left_hand&.id != box_id
    waitrt?
    fput "drop ##{box_id}"
    sleep 0.2
  end
end

# =============================================================================
# Gets the current box.
# Doesn't work for pool mode because
# you don't hold boxes when pool picking.
# =============================================================================
def tpick_get_box
  return if $tpick_vars["Picking Mode"] == "worker"
  box_id = $tpick_vars["Current Box"].id
  until GameObj.right_hand&.id == box_id || GameObj.left_hand&.id == box_id
    waitrt?
    fput "get ##{box_id}"
    sleep 0.2
  end
end

# =============================================================================
# Stops the specified spell/lmas focus.
# =============================================================================
def tpick_stop_spell(number)
  fput "stop #{number}" if Spell[number].active?
  fput "stop lmaster focus" if Effects::Buffs.active?('Focused')
end

# =============================================================================
# Stops 403 and 404 if player has "Cancel" set for these spells.
# =============================================================================
def tpick_stop_403_404		
  waitrt?

  fput "stop 403" if Spell[403].active? && $tpick_vars["Cancel 403"]
  fput "stop 404" if Spell[404].active? && $tpick_vars["Cancel 404"]
  fput "stop lmaster focus" if Effects::Buffs.active?('Focused') && ($tpick_vars["Cancel 403"] || $tpick_vars["Cancel 404"])
end

# =============================================================================
# Stows the current box.
# =============================================================================
def tpick_stow_box
  box_id = $tpick_vars["Current Box"].id
  until GameObj.right_hand.id != box_id && GameObj.left_hand.id != box_id
    waitrt?
    fput "stow ##{box_id}"
    sleep 0.2
  end
end

# =============================================================================
# Makes the player say the specified words
# if the corresponding setting isn't blank.
# =============================================================================
def tpick_say(words)
  fput "say #{@load_data[words]}" unless @load_data[words].to_s.strip.empty?
end

# =============================================================================
# Gets the current room's pool
# settings using the metadata tag.
# =============================================================================
def get_pool_info
  Room.current.tags.each do |tag|
    if tag =~ /meta:boxpool:npc:(.*)/i
      $tpick_vars["Pool NPC"] = GameObj.npcs.find { |npc| npc.name == $1 }
    elsif tag =~ /meta:boxpool:table:(.*)/i
      table_name = $1
      $tpick_vars["Pool Table"] = GameObj.loot.find { |loot| loot.name == table_name } || 
                                  GameObj.room_desc.find { |desc| desc.name == table_name }
    end
  end
end

# =============================================================================
# Checks the initial commands and verifies they
# are valid then routes to other parts of the
# script depending on command selections.
# =============================================================================
def start_up_procedure(check_lock_smiths_container)
  if !$tpick_vars["Drop Off Boxes"] && !$tpick_vars["Pick Up Boxes"]
    if !$tpick_vars["Pop Boxes"] || ($tpick_vars["Pop Boxes"] && @load_data["Pick Enruned"] == "Yes")
      check_for_containers(check_lock_smiths_container) if !$tpick_vars["Checked For Containers"]
    end
    no_vaalin_picks
  end

  $tpick_vars["Checked For Containers"] = true

  if ["worker", "other"].include?($tpick_vars["Picking Mode"]) || $tpick_vars["Drop Off Boxes"] || $tpick_vars["Pick Up Boxes"]
    get_pool_info
  end

  if $tpick_vars["Buy Mode"]
    refill_locksmiths_container(check_lock_smiths_container)
  elsif $tpick_vars["Repair Mode"]
    repair_lockpicks_start
  elsif $tpick_vars["Drop Off Boxes"]
    $tpick_vars["Current Room"] = Room.current.id
    
    if !$tpick_vars["Pool NPC"]
      tpick_silent(true, "The 'drop' command only works at locksmith pools.")
      exit
    end
    
    if !$tpick_vars["Tip Being Offered"]
      tpick_silent(true, "You need to specify how much you are tipping and if you want it to be a percent.\nFor example do ';tpick drop 100' to tip 100 silvers per box\nDo \";tpick drop 10 percent\" or ';tpick drop 10%' if you want to tip 10% per box")
      exit
    end
    
    if $tpick_vars["Tip Is A Percent"] && $tpick_vars["Tip Being Offered"].to_i > 100
      tpick_silent(true, "Wise guy, huh? You can't tip more than 100%!")
      exit
    end
    
    tpick_put_stuff_away
    check_for_boxes
    
    $tpick_vars["Total Number Of Boxes"] = $tpick_vars["All Box IDs"].length.to_i
    count_boxes_in_disk unless $hunt_looter == Char.name
    
    tpick_silent(true, "Total number of boxes: #{$tpick_vars["Total Number Of Boxes"]}")
    
    if $tpick_vars["Total Number Of Boxes"].zero?
      tpick_silent(true, "You don't have any boxes.")
    else
      tip_amount = $tpick_vars["Tip Being Offered"].to_i
      total_boxes = $tpick_vars["Total Number Of Boxes"]

      if $tpick_vars["Tip Is A Percent"]
        tpick_silent(true, "You are tipping #{tip_amount}% for each box.")
        withdrawal_sum = 3500 * total_boxes
        give_suffix = " percent"
      else
        tpick_silent(true, "You are tipping #{tip_amount} silvers for each box for a total tip needed of #{tip_amount * total_boxes}")
        withdrawal_sum = tip_amount * total_boxes
        give_suffix = ""
      end
      
      sleep 1
      start_script "go2", ["bank", "--disable-confirm"]
      wait_while { running?("go2") }
      fput "depo all"
      fput "withdraw #{withdrawal_sum} silvers"
      
      start_script "go2", [$tpick_vars["Current Room"]]
      wait_while { running?("go2") }

      unless $hunt_looter == Char.name
        40.times do
          break if GameObj.loot.any? { |obj| obj.name =~ /#{Char.name} disk|coffin/i }
          sleep 0.1
        end
      end

      $tpick_vars["All Box IDs"].each do |box|
        tpick_put_stuff_away
        fput "get ##{box}"
        fput "give #{$tpick_vars["Pool NPC"]} #{tip_amount}#{give_suffix}"
        fput "give #{$tpick_vars["Pool NPC"]} #{tip_amount}#{give_suffix}"
      end
    end
  elsif $tpick_vars["Pick Up Boxes"]
    if !$tpick_vars["Pool NPC"]
      tpick_silent(true, "This command only works at locksmith pools.")
      exit
    end
    tpick_put_stuff_away
    no_boxes = nil
    
    loop do
      break if no_boxes
      fput "ask #{$tpick_vars["Pool NPC"]} about return"
      
      while line = get
        sline = strip_xml(line)
        
        if sline =~ /We don\'t have any boxes ready for you/i
          no_boxes = true
          break
        elsif sline =~ /here\'s your .*? back/i
          wait_until { checkright }
          $tpick_vars["Picking Up"] = true
          sleep 0.2
          
          lootbox = GameObj.right_hand
		  TpickMain.update_tpick_var("Current Box", GameObj.right_hand)
          fput "open ##{lootbox.id}"
          
          if @load_data["Use Loot"] == "Yes" && lootbox.contents.to_a.none? { |item| item.type =~ /cursed/i }
            fput "loot ##{$tpick_vars["Current Box"].id}"
          end
          
          25.times do
            break if lootbox.contents
            fput "look in ##{lootbox.id}"
            sleep 0.2
          end
          
          lootbox.contents.to_a.each do |item|
            $tpick_vars["Current Item"] = item
            tpick_gather_the_loot
          end
          
          $tpick_stats_data["Boxes Looted"] += 1
          garbage_check
          tpick_put_stuff_away
          break
        elsif sline =~ /\"You need to lighten your load first\.\"/i
          $tpick_vars["Starting Room Number"] = Room.current.id
          start_script "go2", ["bank", "--disable-confirm"]
          wait_while { running?("go2") }
          fput "depo all"
          start_script "go2", [$tpick_vars["Starting Room Number"]]
          wait_while { running?("go2") }
          break
        end
      end
    end
    
  else
    trigger_startup_calibration = proc do
      if @load_data["Calibrate On Startup"] == "Yes" && !$tpick_vars["Always Use Vaalin"] && 
         !$tpick_vars["Pop Boxes"] && $tpick_vars["Can Use Calipers"] && !$tpick_vars["Start With Copper"]
        calibrate_calipers
      end
    end

    if ["ground", "other", "worker"].include?($tpick_vars["Picking Mode"]) || $tpick_vars["Bash Open Boxes"]
      if $tpick_vars["Open Plinites"]
        tpick_silent(true, "#{$tpick_vars["Picking Mode"].to_s.capitalize} feature cannot be used when opening plinites.")
        exit
      end
    end
    
    if ["other", "worker", "solo"].include?($tpick_vars["Picking Mode"])
      if $tpick_vars["Disarm Only"] && !$tpick_vars["Bash Open Boxes"]
        tpick_silent(true, "Disarm only feature only works for ground picking.")
        exit
      end
    end

    case $tpick_vars["Picking Mode"]
    when "ground"
      trigger_startup_calibration.call
      start_ground
      
    when "other"
      tpick_say("Ready")
      start_others
      
    when "worker"
      trigger_startup_calibration.call
      tpick_silent(true, $tpick_vars["Picks Information"]) if $tpick_vars["Picks For Critter Level"]
      $tpick_vars["Worker Start Time"] = Time.now
      start_pool
      
    when "solo"
      check_for_boxes
      if $tpick_vars["Pop Boxes"]
        start_pop
      elsif $tpick_vars["Open Plinites"]
        start_plinites
      else
        trigger_startup_calibration.call
        start_solo
      end
    end
  end
end

# =============================================================================
# Scans the pool table to find your assigned box or plinite.
# Scans for the player's name first, falling back to TAPPING
# each item on the table if the initial name scan fails.
# =============================================================================
def tpick_get_current_worker_box
  table_obj = $tpick_vars["Pool Table"]
  
  until $tpick_vars["Current Box"]
    dothistimeout "look on ##{table_obj.id}", 3, /^On the/i
    
    table_obj.contents.to_a.each do |item|
      if item.name =~ /#{Regexp.escape(Char.name)}/i
		TpickMain.update_tpick_var("Current Box", item)
        break
      end
    end

    if !$tpick_vars["Current Box"]
      table_obj.contents.to_a.each do |item|
        fput "tap ##{item.id}"
        while line = get
          sline = strip_xml(line)
          if sline =~ /^You probably shouldn\'t do that\./i
            break
          elsif sline =~ /^You tap/i
            TpickMain.update_tpick_var("Current Box", item)
            break
          end
        end
        break if $tpick_vars["Current Box"]
      end
    end
    sleep 1
  end
  
  tpick_silent(nil, "Found your box/plinite!\nName: #{$tpick_vars["Current Box"]}, ID: #{$tpick_vars["Current Box"].id}, tip: #{$tpick_vars["Offered Tip Amount"]}, Critter name: #{$tpick_vars["Critter Name"]}, Critter level: #{$tpick_vars["Critter Level"]}")
  TpickMain.update_box_for_window
end

# =============================================================================
# Validates if the player's locksmith toolkit is indeed a locksmith toolkit.
# Scans the player's toolkit to see if Putty and Cotton Balls are both already at 100.
# Verifies the player isn't too injured to use the BUNDLE command.
# Routes script to the buy toolkits method if everything looks good.
# =============================================================================
def refill_locksmiths_container(check_lock_smiths_container)
  check_lock_smiths_container.call
  
  if $tpick_vars["Putty Remaining"].to_i.zero? && $tpick_vars["Cotton Remaining"].to_i.zero?
    $tpick_vars["Error Message"] = "The container you have selected as your Locksmith's Container doesn't appear to be a Locksmith's Container. Run ;tpick setup and be sure to select your Locksmith's Container."
    exit
  end
  
  start_script "sorter" if $tpick_vars["Start Sorter"]
  
  if $tpick_vars["Putty Remaining"].to_i >= 100 && $tpick_vars["Cotton Remaining"].to_i >= 100
    tpick_silent(true, "You already have 100 each of putty and cotton balls.")
    exit
  else
    severe_injury = [Wounds.lhand, Wounds.rhand, Wounds.larm, Wounds.rarm, Scars.lhand, Scars.rhand, Scars.larm, Scars.rarm].any? { |tier| tier.to_i >= 3 }
    if severe_injury
      tpick_silent(true, "Your wounds are too great to do this task. You can't do this with a missing hand or arm.")
      exit
    else
      tpick_put_stuff_away
      fill_up_locksmith_container(check_lock_smiths_container)
    end
  end
end

# =============================================================================
# Goes through each item in the Broken Lockpick Container,
# tracks which items are lockpicks listed in the settings
# and determines the wire material needed to repair them.
# Then calls the repair lockpick method on each lockpick found.
# =============================================================================
def repair_lockpicks_start
  if Stats.prof == "Rogue"
    tpick_put_stuff_away
    broken_bag = $tpick_vars["Broken Lockpick Container"]
    
    broken_bag.contents.to_a.each do |i|
      @all_pick_ids.each_key   { |name| @all_pick_ids[name].push(i.id) if @settings_pick_names[name].to_a.include?(i.name) }
      @all_repair_ids.each_key { |name| @all_repair_ids[name].push(i.id) if @all_repair_names[name].to_a.include?(i.name) }
    end
    
    $tpick_vars["Repair Names"].to_a.each do |name|
      clean_material_string = name.to_s.gsub("Repair ", "").downcase
      @all_repair_ids[name].to_a.each { |pick| tpick_repair_lockpicks(pick, clean_material_string) }
    end
    
    move "out" if checkroom =~ /workbench/i
  else
    tpick_silent(true, "Only rogues can repair lockpicks.")
  end
end

# =============================================================================
# Scans player inventory to find needed containers
# and saves their item ID to the main variable hash.
# =============================================================================
def check_for_containers(check_lock_smiths_container)
  containers = ["Lockpick Container", "Broken Lockpick Container", "Wedge Container", "Calipers Container", "Scale Weapon Container", "Locksmith's Container"]

  containers.each do |name|
    if @load_data[name]
      id = $tpick_worn_containers.fetch(@load_data[name], "Not Found")
      $tpick_vars[name] = GameObj.inv.find { |i| i.id == id }
    end
  end

  if !$tpick_vars["Locksmith's Container"]
    waitrt?
    fput "inv containers"
    all_worn_containers = ""
    
    while line = get
      sline = strip_xml(line)
      if sline =~ /You are wearing/i
        all_worn_containers = line
        break
      end
    end

    all_worn_containers.to_s.split(/[\,\.]/).each do |container_string|
      fput "look in #{container_string.to_s.split.last}"
    end
    $tpick_vars["Locksmith's Container"] = GameObj.containers.values.flatten.find { |obj| obj.name == @load_data["Locksmith's Container"] }
  end

  is_rogue = (Stats.prof == "Rogue")
  needs_calipers = (@load_data["Use Calipers"] == "Yes")

  if !$tpick_vars["Lockpick Container"] || 
     !$tpick_vars["Broken Lockpick Container"] || 
     (!$tpick_vars["Wedge Container"] && is_rogue) || 
     (!$tpick_vars["Calipers Container"] && is_rogue && needs_calipers) || 
     !$tpick_vars["Scale Weapon Container"] || 
     !$tpick_vars["Locksmith's Container"]

    text = "To fix the below issues enter ;tpick setup\nBe sure to properly fill out the name of each of your containers.\nIt is also possible you aren't wearing the missing container.\n\n"
    text += "Could not find your lockpick container.\n"        if !$tpick_vars["Lockpick Container"]
    text += "Could not find your broken lockpick container.\n" if !$tpick_vars["Broken Lockpick Container"]
    text += "Could not find your wedge container.\n"           if !$tpick_vars["Wedge Container"] && is_rogue
    text += "Could not find your calipers container.\n"        if !$tpick_vars["Calipers Container"] && is_rogue && needs_calipers
    text += "Could not find your scale weapon container.\n"    if !$tpick_vars["Scale Weapon Container"]
    text += "Could not find your locksmith's container.\n"     if !$tpick_vars["Locksmith's Container"]

    $tpick_vars["Error Message"] = text.strip
    exit
  end

  fput "open ##{$tpick_vars["Locksmith's Container"].id}"
  check_for_lockpicks_etc(check_lock_smiths_container)
end

# =============================================================================
# Verifies if various settings and command combinations are valid
# (only Rogues can use calipers, etc).
# Creates the needed window, opens the necessary containers,
# and shows the help menu if no command line given.
# =============================================================================
def main_program(check_lock_smiths_container, script)
  $tpick_lock_mastery_ranks = nil

  if Stats.prof == "Rogue"
    $tpick_vars["Can Use Calipers"] = true
    if @load_data["Trick"] == "pick"
      $tpick_vars["Do Trick"] = "pick"
    elsif @load_data["Trick"] != "random"
      $tpick_vars["Do Trick"] = "lmas ptrick #{@load_data["Trick"]}"	
    end
    
    if !$tpick_lock_mastery_ranks && @load_data["Use Lmaster Focus"] == "Yes"
      waitrt?
      result = dothistimeout("gld", 3, /You have no guild affiliation\.|Click GLD MENU for additional commands\.|You have (\d+) ranks in the Lock Mastery skill\.|You are a Master of Lock Mastery\./i)
      
      $tpick_lock_mastery_ranks = case result
                                  when /You have (\d+) ranks in the Lock Mastery skill\./i then $1.to_i
                                  when /You are a Master of Lock Mastery\./i then 63
                                  else 0
                                  end
                                  
      dex_offset = $tpick_vars["Dex Bonus"].to_i / 2
      $tpick_vars["Pick Lore"]   = (2 * $tpick_lock_mastery_ranks) + dex_offset
      $tpick_vars["Disarm Lore"] = (2 * $tpick_lock_mastery_ranks) + dex_offset
    end
  else
    $tpick_vars["Can Use Calipers"] = nil
    $tpick_vars["Do Trick"]        = "pick"
  end

  # =====================================================================
  # Creates the necessary window.
  # =====================================================================
  if UserVars.tpick
    Gtk.queue do
      TpickMain.import_settings
      TpickMain.create_welcome_window
    end
    TpickMain.watching
  elsif !File.exist?("Tpick Settings.json")
    Gtk.queue do
      TpickMain.create_settings_window
      TpickMain.create_welcome_window
    end
    TpickMain.watching
  elsif script.vars.any? { |v| v =~ /setup/i }
    Gtk.queue { TpickMain.create_settings_window }
    TpickMain.watching
  end

  Gtk.queue do 
    TpickMain.create_information_window 
    TpickMain.update_display_image("Trap Idle", "Traps")
	TpickMain.update_display_image("Lockpick Idle", "Lockpick")
  end

  if @load_data["Gnomish Bracer"].to_s.strip.empty? == false
    $tpick_vars["Gnomish Bracers"] = @load_data["Gnomish Bracer"].dup
  end

  # =====================================================================
  # Automatically opens configured container items
  # =====================================================================
  containers_need_open_close = { 
    @load_data["Lockpick Container"]        => @load_data["Lockpick Open"],
    @load_data["Broken Lockpick Container"] => @load_data["Broken Open"],
    @load_data["Wedge Container"]           => @load_data["Wedge Open"],
    @load_data["Calipers Container"]        => @load_data["Calipers Open"],
    @load_data["Scale Weapon Container"]    => @load_data["Weapon Open"]
  }

  containers_open_or_close = containers_need_open_close.select do |name, option|
    name.to_s.strip.empty? == false && option == "Yes"
  end.keys.uniq

  containers_open_or_close.each do |bag_name|
    container_to_open = GameObj.inv.find { |t| t.name == bag_name }
    fput "open ##{container_to_open.id}" if container_to_open
  end

  if @load_data["Rest When Fried"].to_s.strip.empty? == false
    $tpick_vars["Pool Fried Commands"] = @load_data["Rest When Fried"].to_s.split(":").map { |cmd| cmd.to_s.strip }
  end

  @all_other_container_options = @load_data["Other Containers"].to_s.split(",")

  tpick_put_stuff_away

  if Skills.arcanesymbols < 20
    _respond "\n#{monsterbold_start}########################################\n" \
             "WARNING: You need 20 ranks of Arcane Symbols in order to disarm scarabs with one try. " \
             "As of now the script doesn't check for your skill or failure messages when disarming scarabs. " \
             "It is highly recommended you get 20 ranks of Arcane Symbols.\n" \
             "#########################################{monsterbold_end}\n"
  end
  $tpick_vars["Max Lock Attempt"] = @load_data["Max Lock"].dup
  $tpick_vars["Max Lock Compared To Skill"] = (@load_data["Max Lock"].to_i < 0) ? true : nil

  is_rogue = (Stats.prof == "Rogue")

  if Spell[403].known? || is_rogue
    $tpick_vars["Use 403 For Lock Difficulty"] = $1.to_i if @load_data["403"] =~ /(\d+)/
    $tpick_vars["Use 403"]    = true if @load_data["403"] =~ /yes/i
    $tpick_vars["Cancel 403"] = true if @load_data["403"] =~ /cancel/i
	$tpick_vars["Never Cast 403"] = true if @load_data["403"] =~ /never/i
  end

  if Spell[404].known? || is_rogue
    $tpick_vars["404 For Trap-Difficulty"] = $1.to_i if @load_data["404"] =~ /(\d+)/
    $tpick_vars["Use 404"]    = true if @load_data["404"] =~ /yes/i
    $tpick_vars["Cancel 404"] = true if @load_data["404"] =~ /cancel/i
	$tpick_vars["Never Cast 404"] = true if @load_data["404"] =~ /never/i
	$tpick_vars["Always 404 For Detect"] = true if @load_data["404"] =~ /detect/i
  end

  {
    "Use 402"  => "Presence (402)",
    "Use 506"  => "Celerity (506)",
    "Use 515"  => "Rapid Fire (515)",
    "Use 1035" => "Song of Tonis (1035)",
    "Use 613"  => "Self Control (613)",
    "Use 1006" => "Song of Luck (1006)"
  }.each { |var_key, setting| $tpick_vars[var_key] = true if @load_data[setting] == "Yes" }

  $tpick_vars["Current Minimum Tip"] = @load_data["Minimum Tip Start"].dup

  tpick_silent(true, "Max level wanted: #{@load_data["Max Level"]}") if @load_data["Max Level"].to_i != 200

  if @load_data["Picks On Level"].to_s.strip.empty? == false && $tpick_vars["Always Use Vaalin"]
    $tpick_vars["Picks For Critter Level"] = @load_data["Picks On Level"].to_s.split(",")
    $tpick_vars["Picks Information"]       = "Your picks to use based on critter level settings: "
    number = 0
    
    $tpick_vars["Picks For Critter Level"].each do |i|
      $tpick_vars["Temp Picks Critter Level"] = i.split(" ")
      level_cap = $tpick_vars["Temp Picks Critter Level"][0].to_i
      material  = $tpick_vars["Temp Picks Critter Level"][1]
      
      start_lvl = (number == 0) ? 0 : (number + 1)
      $tpick_vars["Picks Information"] += "Levels #{start_lvl}-#{level_cap}: #{material}. "
      number = level_cap
    end
    $tpick_vars["Picks Information"] += "All higher levels: Vaalin"
  end

  default_commands = @load_data["Default Mode"].to_s.strip.empty? ? [] : @load_data["Default Mode"].to_s.downcase.split
  script_vars_down = script.vars.to_a.map { |v| v.to_s.downcase }

  raw_script_args = script.vars[1..-1].to_a.compact

  combined_commands = raw_script_args + default_commands.to_a

  TpickMain.set_picking_flags(combined_commands)

  $tpick_vars["Buy Mode"]          = true if script_vars_down.any? { |v| v.include?("buy") } || default_commands.include?("buy")
  $tpick_vars["Repair Mode"]       = true if script_vars_down.any? { |v| v.include?("repair") } || default_commands.include?("repair")
  $tpick_vars["Exit When Waiting"]  = true if script_vars_down.any? { |v| v.include?("exit") }

  $tpick_vars["Start With Copper"] = nil if $tpick_vars["Always Use Vaalin"] && $tpick_vars["Start With Copper"]
  $tpick_vars["Always Use Vaalin"] = true if @load_data["Use Calipers"] == "No" && @load_data["Use Loresinging"] == "No" && !$tpick_vars["Start With Copper"]
  $tpick_vars["Always Use Vaalin"] = true if Stats.prof !~ /Rogue|Bard/i && !$tpick_vars["Start With Copper"]
  
  if Stats.prof != "Warrior" && $tpick_vars["Bash Open Boxes"]
    tpick_silent(true, "Only Warriors can use the 'bash' feature.")
    exit
  end

  if $tpick_vars["Open Plinites"]
    case
    when $tpick_vars["Disarm Only"]     then tpick_silent(true, "Disarm feature cannot be used when opening plinites."); exit
    when $tpick_vars["Relock Boxes"]    then tpick_silent(true, "Relock feature cannot be used when opening plinites."); exit
    when $tpick_vars["Bash Open Boxes"] then tpick_silent(true, "Bash feature cannot be used when opening plinites."); exit
    when $tpick_vars["Pop Boxes"]       then tpick_silent(true, "Popping feature cannot be used when opening plinites."); exit
    end
  end

  if $tpick_vars["Relock Boxes"] && $tpick_vars["Bash Open Boxes"]
    tpick_silent(true, "'relock' and 'bash' cannot both be used together.")
    exit
  end

  if $tpick_vars["Pop Boxes"] && !Spell[416].known?
    tpick_silent(true, "Popping feature requires the knowledge of Piercing Gaze (416).")
    exit
  end

  Spell[205].cast if @load_data["Light (205)"] == "Yes"
  $tpick_vars["Window Active"]      = true if @load_data["Show Window"] != "No" || script.vars.to_a.any? { |v| v.to_s.downcase == "show" }
  $tpick_vars["Command Lines Used"] = true if $tpick_vars["Drop Off Boxes"] || $tpick_vars["Pick Up Boxes"] || $tpick_vars["Picking Mode"] || $tpick_vars["Buy Mode"] || $tpick_vars["Repair Mode"]
  silence_me if @load_data["Don't Show Commands"] == "Yes"
  
  tpick_silent(true, "There might be an issue with ;tpick working properly when picking at the Locksmith's pool in Solhaven.\nIf ;tpick isn't working correctly here try doing this:\nset Description OFF\nThen move to another room and back to the Locksmith's pool room and try running ;tpick again.")

  if $tpick_vars["Command Lines Used"] && (!$tpick_vars["Window Active"] || @load_data["One & Done"] == "Yes")
    $tpick_commands_set = true
    start_up_procedure(check_lock_smiths_container)
  elsif $tpick_vars["Window Active"]
    loop do
      if $tpick_vars["Command Lines Used"]
        $tpick_commands_set = true
        start_up_procedure(check_lock_smiths_container)
      else
        tpick_silent(true, "Waiting for commands. Select the picking mode and any option you want then click the 'Start' button in the Information Window to pick some boxes.")
        wait_until { $tpick_commands_set }
        commands = TpickMain.get_tpick_commands.to_a

        $tpick_vars["Always Use Vaalin"] = nil
        TpickMain.set_picking_flags(commands)

        $tpick_vars["Buy Mode"]    = true if commands.include?("Refill Locksmith's Container")
        $tpick_vars["Repair Mode"] = true if commands.include?("Repair Lockpicks")
        
        if commands.any? { |c| c =~ /(\d+)/ }
          $tpick_vars["Tip Being Offered"] = $1.to_i
        end
        
        $tpick_vars["Always Use Vaalin"] = true if @load_data["Use Calipers"] == "No" && @load_data["Use Loresinging"] == "No" && !$tpick_vars["Start With Copper"]
        $tpick_vars["Always Use Vaalin"] = true if Stats.prof !~ /Rogue|Bard/i && !$tpick_vars["Start With Copper"]
        
        start_up_procedure(check_lock_smiths_container)
      end

      all_command_options = ["Open Plinites", "Bash Open Boxes", "Disarm Only", "Relock Boxes", "Drop Off Boxes", "Pick Up Boxes", "Tip Is A Percent", "Start With Copper", "Always Use Vaalin", "Always Use Wedge", "Ground Loot", "Pop Boxes", "Tip Being Offered", "Picking Mode", "Command Lines Used", "Buy Mode", "Repair Mode"]
      all_command_options.each { |opt| $tpick_vars[opt] = nil }
      
      $tpick_stop_immediately = nil
      $tpick_commands_set     = nil
    end
  elsif script.vars.count > 0
    start_up_procedure(check_lock_smiths_container)
  else
    text = "You must specify which mode you want when starting this script.\n" \
           ";tpick solo = Pick all boxes in your open containers.\n" \
           ";tpick other = Wait for someone to GIVE you a box, you will then pick the box and GIVE it back to the person.\n" \
           ";tpick ground = Pick all boxes on the ground.\n" \
           ";tpick worker = Pick boxes at a pool. Only works if you're in a pool room when starting script.\n" \
           ";tpick setup = Enter setup menu.\n" \
           ";tpick show - Shows the Information Window which has more features and stats."
    tpick_silent(true, text)
  end
end

# =============================================================================
# Main script execution entry point.
# =============================================================================
$tpick_cannot_use_wedges = nil

waitrt?
begin
  main_program(check_lock_smiths_container, script)
rescue => e
  crash_msg = "The script has crashed. Please provide the following information to Dreaven or Discord for assistance.\n" \
              "Tpick Version: #{Script.version(Script.current.name)}\n" \
              "Lich Version: #{$version}\n" \
              "Front End: #{$frontend}\n" \
              "Realm: #{XMLData.game}\n" \
              "#{e}\n"

  e.backtrace.to_a.each do |line| 
    crash_msg += "#{line}\n" 
  end

  $tpick_vars["Crash Report"] = crash_msg.strip
end