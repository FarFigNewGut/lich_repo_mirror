# =============================================================================
#  Window customization settings.
# =============================================================================
tpick_style_provider = Gtk::CssProvider.new
tpick_style_provider.load(data: <<-CSS)
  #tpick_window, 
  #tpick_window grid,
  #tpick_window notebook stack,
  #tpick_window notebook stack grid,
  #tpick_window notebook > stack {
    background-color: #12131a;
  }

  #tpick_window label,
  #tpick_window grid label,
  #tpick_window notebook label,
  #tpick_window checkbutton, 
  #tpick_window radiobutton,
  #tpick_window entry,
  #tpick_window entry text,
  #tpick_window button,
  #tpick_window textview,
  #tpick_window textview text,
  #tpick_window combobox,
  #tpick_window spinbutton,
  #tpick_window spinbutton entry,
  #tpick_window spinbutton entry text,
  #tpick_window spinbutton button {
    font-family: 'Courier New', monospace;
    font-weight: bold;
    font-size: 10.5pt;
    text-shadow: none;
  }

  #tpick_window label,
  #tpick_window grid label,
  #tpick_window notebook label,
  #tpick_window checkbutton, 
  #tpick_window radiobutton {
    color: #ffffff;
  }

  #tpick_window grid label.required-setting,
  #tpick_window label.required-setting {
    color: #ff4d4d;
  }

  #tpick_window entry,
  #tpick_window entry text,
  #tpick_window textview text {
    background-color: #1a1b26; 
    color: #ffffff;
    border: 1px solid #3d3e54;
    border-radius: 4px;
    padding: 4px;
  }

  #tpick_window spinbutton entry,
  #tpick_window spinbutton entry text,
  #tpick_window spinbutton button,
  #tpick_window spinbutton {
    background-color: #1a1b26;
    color: #ffffff;
  }

  #tpick_window button {
    background-color: #252632;
    background-image: none;
    border-radius: 4px;
    padding: 6px 12px;
    border: 1px solid #3d3e54;
  }
  #tpick_window button:hover {
    background-color: #2f3142;
    background-image: none;
  }
  
  #tpick_window button label,
  #tpick_window button:hover label {
    color: #ffffff;
  }

  #tpick_window combobox,
  #tpick_window combobox button,
  #tpick_window combobox > box {
    background-color: #252632;
    background-image: none;
    border-radius: 4px;
    border: 1px solid #3d3e54;
  }
  #tpick_window combobox button:hover {
    background-color: #2f3142;
    background-image: none;
  }
  
  #tpick_window combobox cellview,
  #tpick_window combobox cellview label,
  #tpick_window combobox > box > cellview label,
  #tpick_window combobox > text {
    color: #ffffff;
  }

  #tpick_window combobox window.popup,
  #tpick_window combobox window.popup menu,
  #tpick_window combobox menu {
    background-color: #1a1b26; 
    border: 1px solid #00ffcc;
  }

  #tpick_window combobox window.popup menuitem label,
  #tpick_window combobox menuitem label,
  #tpick_window combobox window.popup cellview {
    color: #ffffff;
  }

  #tpick_window combobox window.popup menuitem:hover,
  #tpick_window combobox window.popup menuitem:selected,
  #tpick_window combobox menuitem:hover,
  #tpick_window combobox menuitem:selected {
    background-color: #11998e;
  }
  #tpick_window combobox window.popup menuitem:hover label,
  #tpick_window combobox window.popup menuitem:selected label,
  #tpick_window combobox menuitem:hover label,
  #tpick_window combobox menuitem:selected label {
    color: #12131a;
  }

  #tpick_window notebook,
  #tpick_window notebook header {
    background-color: #1a1b26;
    border: none;
  }
  #tpick_window notebook stack,
  #tpick_window notebook > grid {
    padding-top: 10px;
  }
  #tpick_window notebook tab {
    background-color: #12131a; 
    border: 1px solid #3d3e54;
    border-bottom: none;
    border-radius: 4px 4px 0 0;
    padding: 6px 12px;
  }
  #tpick_window notebook tab label {
    color: #a5afc4; 
    font-size: 10pt;
  }
  #tpick_window notebook tab:checked {
    background-color: #12131a; 
    border-color: #00ffcc;     
  }
  #tpick_window notebook tab:checked label {
    color: #00ffcc; 
  }

  #tpick_window headerbar {
    background-color: #12131a;
    background-image: none;
    border-bottom: 1px solid #00ffcc;
    box-shadow: none;
    padding: 6px;
    min-height: 54px;
  }
  #tpick_window headerbar label {
    font-family: 'Courier New', monospace;
    font-weight: bold;
    color: #ffffff;
    font-size: 11pt;
  }
  #tpick_window headerbar button.titlebutton {
    background: #1a1b26;
    border: 1px solid #3d3e54;
    color: #ffffff;
    border-radius: 4px;
  }
  #tpick_window headerbar button.titlebutton:hover {
    background: #ff4d4d;
  }

  #tpick_window tooltip, 
  #tpick_window .tooltip,
  tooltip,
  .tooltip {
    background-color: #1a1b26;
    background-image: none;
    opacity: 1.0;
    border: 1px solid #00ffcc;
    border-radius: 4px;
  }
  #tpick_window tooltip label, 
  #tpick_window .tooltip label,
  tooltip label,
  .tooltip label {
    font-family: 'Courier New', monospace;
    font-weight: bold;
    font-size: 10pt;
    color: #ffffff;
  }
CSS
Gtk::StyleContext.add_provider_for_screen(Gdk::Screen.default, tpick_style_provider, Gtk::StyleProvider::PRIORITY_USER)

# =============================================================================
# Main program
# =============================================================================
class TpickMain
  @windows["Information"]&.close
  
  require "open-uri"
  require "fileutils"

  @save_file       = "Tpick Settings.json"
  @save_stats_file = "Tpick Stats.json"
  @images_folder   = File.expand_path("Tpick Images", Dir.pwd)

  %w[windows grids entries buttons menus non_settings_menus check_boxes labels 
     spin_buttons adjustments all_textviews all_buffers scrolled_windows 
     all_notebooks needed_values window_assets].each { |key| instance_variable_set("@#{key}", {}) }

  @all_messages             = []
  @load_data                = nil
  $tpick_stats_data         = nil
  @script_variables         = nil
  @current_session_picking  = 0
  @reset_profession         = nil
  @show_images              = nil

  $tpick_session_data = {
    "Silver"                => 0,
    "Scarabs"               => 0,
    "Loot Session"          => {}, # Hash for all other loot
    "Session Start Time"    => Time.now,
    "Session Boxes Picked"  => 0
  }

  $tpick_commands_set      = nil

  @worn_containers = Lich::Util.quiet_command_xml("inv containers", /You are wearing|You are holding/)
  EXIST ||= %r{<a exist=['"](?<id>.*?)['"] noun=['"](?<noun>.*?)['"]>(?<name>.*?)</a>}

  $tpick_worn_containers = {}
  @worn_containers.each do |container|
    container.scan(EXIST).each { |id, _noun, name| $tpick_worn_containers[name] = id }
  end

  @required_settings = [
    "Vaalin",
