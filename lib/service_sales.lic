end

# -- Wizard enchant helpers ---------------------------------------------------

def wizard_enchant_cost(bonus)
	return 0   if bonus == 1
	return (((bonus - 1) * 312.5).truncate) if bonus <= 25
	7500 * (bonus - 24)
end

def wizard_best_enchant(total_raw)
	return nil if total_raw == 0
	50.downto(2) do |bonus|
		return bonus if total_raw >= wizard_enchant_cost(bonus)
	end
	nil
end

# -- Rogue covert arts helpers ------------------------------------------------

ROGUE_ART_GATES = [200, 300, 400, 500, 600].freeze
ROGUE_ART_NAMES = {
	"Sidestep"       => "Side Step",
	"Keen Eye"       => "Keen Eye",
	"Escape Artist"  => "Escape Artist",
	"Swift Recovery" => "Swift Recovery",
	"Poisoncraft"    => "Poisoncraft"
}.freeze

def rogue_art_best_tier(skill_bonus)
	tier = nil
	ROGUE_ART_GATES.each_with_index do |gate, i|
		tier = i + 1 if skill_bonus.to_i >= gate
	end
	tier
end

def rogue_art_label(bonus_data)
	return nil unless bonus_data.is_a?(Hash)
	parts = ROGUE_ART_NAMES.map do |key, display|
		t = rogue_art_best_tier(bonus_data[key])
		t ? "#{display} T#{t}" : nil
	end.compact
	parts.empty? ? nil : "Up to: #{parts.join(", ")}"
end

# -- Profession helpers -------------------------------------------------------

def resource_name_for(prof)
	case prof
	when "Wizard"   then "Essence"
	when "Sorcerer" then "Necrotic Energy"
	when "Bard"     then "Luck Inspiration"
	when "Cleric"   then "Devotion"
	when "Paladin"  then "Devotion"
	when "Ranger"   then "Nature's Grace"
	when "Empath"   then "Vitality"
	when "Monk"     then "Motes of Tranquility"
	when "Warrior"  then "Grit"
	when "Rogue"    then "Guile"
	else "Resource"
	end
end

def price_unit_for(prof)
	case prof
	when "Wizard"  then "per essence"
	when "Warrior" then "per service"
	else                "per week"
	end
end

def skill_bonus_value(bonus_data, preferred_key = "Self")
	case bonus_data
	when Numeric
		bonus_data.to_i
	when Hash
		(bonus_data[preferred_key] || bonus_data[preferred_key.to_sym] ||
		 bonus_data.values.grep(Numeric).max || 0).to_i
	when Array
		bonus_data.grep(Numeric).max.to_i
	else
		bonus_data.to_s.to_i
	end
end

def bonus_display(prof, bonus_data)
	case prof
	when "Monk"
		self_b  = skill_bonus_value(bonus_data, "Self")
		other_b = skill_bonus_value(bonus_data, "Other")
		"Self:#{self_b} Other:#{other_b}"
	when "Ranger", "Bard", "Paladin", "Cleric", "Empath", "Sorcerer", "Wizard", "Rogue"
		"w/#{skill_bonus_value(bonus_data)} bonus"
	when "Warrior"
		wpn = bonus_data.is_a?(Hash) ? bonus_data["Weapon"] : (bonus_data.is_a?(Array) ? bonus_data[1] : "?")
		arm = bonus_data.is_a?(Hash) ? bonus_data["Armor"]  : (bonus_data.is_a?(Array) ? bonus_data[0] : "?")
		"Wpn:#{wpn} Arm:#{arm}"
	else
		"w/#{skill_bonus_value(bonus_data)} bonus"
	end
end

def avail_display(prof, total_raw)
	avail = round_resource(total_raw, prof)
	avail == 0 ? nil : format_resource(avail)
end

# -- Bonus calculation --------------------------------------------------------
# Runs `skills full` and `info` for the current character and calculates the
# service bonus using the same formulas as resource.lic.
# Returns a hash ready to be saved as a bonus entry, or nil on unsupported profession.

def calculate_bonus
	prof = Stats.prof

	unless prof =~ /^(?:Wizard|Sorcerer|Bard|Monk|Cleric|Warrior|Ranger|Rogue|Paladin|Empath)$/
		respond "--- Service Sales Bonus: #{prof} is not a supported profession."
		respond "--- Supported: Wizard, Sorcerer, Bard, Monk, Cleric, Warrior, Ranger, Rogue, Paladin, Empath"
		return nil
	end

	respond "--- Service Sales Bonus: Calculating bonus for #{Char.name} (#{prof})..."

	# --- initialize all skill/stat variables ---
	level = 0
	arcanesymbols = magicitemuse = physicalfitness = firstaid = 0
	dodging = perception = combatmaneuvers = ambush = pickpocketing = 0
	gldranks = 0
	elementalmanacontrol = spiritmanacontrol = mentalmanacontrol = 0
	mentalloretelepathybonus = mentalloretransformationbonus = 0
	spiritloreblessings = survival = harnesspower = 0
	bardranks = sorcererranks = wizardranks = clericranks = rangerranks = 0
	empathranks = paladinranks = minormentalranks = minorspiritranks = 0
	strength = constitution = dexterity = agility = discipline = 0
	aura = logic = intuition = wisdom = influence = 0
	armoruse = shielduse = 0
	grit_skills = {}
	edgedweapons = bluntweapons = twohandedweapons = rangedweapons = 0
	thrownweapons = polearmweapons = brawling = 0

	# --- parse `skills full` ---
	res = Lich::Util.quiet_command_xml("skills full", /your current skill bonuses and ranks/, /Further information can be found in the/, 8)
	res.each do |line|
		line = line.gsub('<pushBold/>', '').gsub('<popBold/>', '')
		if    line =~ /Arcane Symbols.*?(\d+)$/           then arcanesymbols        = $1.to_i
		elsif line =~ /Magic Item Use.*?(\d+)$/            then magicitemuse          = $1.to_i
		elsif line =~ /Physical Fitness.*?(\d+)$/          then physicalfitness       = $1.to_i
		elsif line =~ /First Aid.*?(\d+)$/                 then firstaid              = $1.to_i
		elsif line =~ /Ambush.*?(\d+)$/                    then ambush                = $1.to_i
		elsif line =~ /Pickpocketing.*?(\d+)$/             then pickpocketing         = $1.to_i
		elsif line =~ /Mental Lore - Telepathy.*?(\d+)\s+(\d+)$/
			mentalloretelepathybonus = $1.to_i
		elsif line =~ /Mental Lore - Transformation.*?(\d+)\s+(\d+)$/
			mentalloretransformationbonus = $1.to_i
		elsif line =~ /Elemental Mana Control.*?(\d+)$/    then elementalmanacontrol  = $1.to_i
		elsif line =~ /Spirit Mana Control.*?(\d+)$/       then spiritmanacontrol     = $1.to_i
		elsif line =~ /Mental Mana Control.*?(\d+)$/       then mentalmanacontrol     = $1.to_i
		elsif line =~ /Wizard.*?(\d+)$/                    then wizardranks           = $1.to_i
		elsif line =~ /Sorcerer.*?(\d+)$/                  then sorcererranks         = $1.to_i
		elsif line =~ /Paladin.*?(\d+)$/                   then paladinranks          = $1.to_i
		elsif line =~ /Cleric.*?(\d+)$/                    then clericranks           = $1.to_i
		elsif line =~ /Minor Mental.*?(\d+)$/              then minormentalranks      = $1.to_i
		elsif line =~ /Minor Spiritual.*?(\d+)$/           then minorspiritranks      = $1.to_i
		elsif line =~ /Bard.*?(\d+)$/                      then bardranks             = $1.to_i
		elsif line =~ /Ranger.*?(\d+)$/                    then rangerranks           = $1.to_i
		elsif line =~ /Empath.*?(\d+)$/                    then empathranks           = $1.to_i
		elsif line =~ /Armor Use.*?(\d+)$/                 then armoruse              = $1.to_i
		elsif line =~ /Shield Use.*?(\d+)$/                then shielduse             = $1.to_i
		elsif line =~ /Edged Weapons.*?(\d+)$/
			edgedweapons = $1.to_i; grit_skills["Edged Weapons"] = edgedweapons
		elsif line =~ /Blunt Weapons.*?(\d+)$/
			bluntweapons = $1.to_i; grit_skills["Blunt Weapons"] = bluntweapons
		elsif line =~ /Two-Handed Weapons.*?(\d+)$/
			twohandedweapons = $1.to_i; grit_skills["Two-Handed Weapons"] = twohandedweapons
		elsif line =~ /Ranged Weapons.*?(\d+)$/
			rangedweapons = $1.to_i; grit_skills["Ranged Weapons"] = rangedweapons
		elsif line =~ /Thrown Weapons.*?(\d+)$/
			thrownweapons = $1.to_i; grit_skills["Thrown Weapons"] = thrownweapons
		elsif line =~ /Polearm Weapons.*?(\d+)$/
			polearmweapons = $1.to_i; grit_skills["Polearm Weapons"] = polearmweapons
		elsif line =~ /Brawling.*?(\d+)$/
			brawling = $1.to_i; grit_skills["Brawling Weapons"] = brawling
		elsif line =~ /Survival.*?(\d+)$/                  then survival              = $1.to_i
		elsif line =~ /Spiritual Lore - Blessings.*?(\d+)\s+(\d+)$/
			spiritloreblessings = $2.to_i
		elsif line =~ /Harness Power.*?(\d+)\s+(\d+)$/
			harnesspower = $2.to_i
		elsif line =~ /Dodging.*?(\d+)$/                   then dodging               = $1.to_i
		elsif line =~ /Perception.*?(\d+)$/                then perception            = $1.to_i
		elsif line =~ /Combat Maneuvers.*?(\d+)$/          then combatmaneuvers       = $1.to_i
		end
	end

	# --- parse `info` ---
	res = Lich::Util.quiet_command_xml("info", /^Name: /)
	res.each do |line|
		line = line.gsub('<pushBold/>', '').gsub('<popBold/>', '')
		if    line =~ /Level:\s+(\d+)$/                   then level        = $1.to_i
		elsif line =~ /Strength.*?\((\-*\d+)\)$/          then strength     = $1.to_i
		elsif line =~ /Constitution.*?\((\-*\d+)\)$/      then constitution = $1.to_i
		elsif line =~ /Dexterity.*?\((\-*\d+)\)$/         then dexterity    = $1.to_i
		elsif line =~ /Agility.*?\((\-*\d+)\)$/           then agility      = $1.to_i
		elsif line =~ /Discipline.*?\((\-*\d+)\)$/        then discipline   = $1.to_i
		elsif line =~ /Aura.*?\((\-*\d+)\)$/              then aura         = $1.to_i
		elsif line =~ /Logic.*?\((\-*\d+)\)$/             then logic        = $1.to_i
		elsif line =~ /Intuition.*?\((\-*\d+)\)$/         then intuition    = $1.to_i
		elsif line =~ /Wisdom.*?\((\-*\d+)\)$/            then wisdom       = $1.to_i
		elsif line =~ /Influence.*?\((\-*\d+)\)$/         then influence    = $1.to_i
		end
	end

	# --- fetch guild ranks for Rogue ---
	if prof == "Rogue"
		res = Lich::Util.quiet_command_xml("gld", /<output class="mono"\/>/, /<output class=""\/>/)
		res.each do |line|
			if line =~ /You currently have (\d+) ranks? out of a possible \d+ for your training\./
				gldranks = $1.to_i
			end
		end
	end

	# --- fetch resource totals ---
	weekly_resource = nil
	total_resource  = nil
	suffused        = nil
	res = Lich::Util.quiet_command_xml("resource", /^Health: /)
	res.each do |line|
		line = line.gsub('<pushBold/>', '').gsub('<popBold/>', '')
		if line =~ /([\d,]+)\/50,000 \(Weekly\)\s+([\d,]+)\/200,000 \(Total\)$/
			weekly_resource = $1
			total_resource  = $2
		elsif line =~ /Suffused.+: ([\d,]+)$/
			suffused = $1
		end
	end

	timestamp = Time.now.strftime("%Y-%m-%d %H:%M")
	key       = "#{XMLData.game}:#{Char.name}"

	# --- calculate bonus by profession ---
	case prof
	when "Wizard"
		spell_bonus = wizardranks > (level + 1) ? (level + 1) * 2 + (wizardranks - (level + 1)) : wizardranks * 2
		bonus = level + logic + intuition +
		        (magicitemuse / 10).truncate +
		        (arcanesymbols / 10).truncate +
		        (elementalmanacontrol / 2).truncate +
		        spell_bonus + 25 + 50  # familiar +25, public workshop +50 always
		respond "--- Service Sales Bonus: Wizard bonus = #{bonus}"
		{
			"game"    => XMLData.game,
			"name"    => Char.name,
			"prof"    => prof,
			"bonus"   => bonus,
			"weekly"  => weekly_resource,
			"total"   => total_resource,
			"suffused"=> suffused,
			"updated" => timestamp
		}

	when "Sorcerer"
		emc_part = (elementalmanacontrol >= spiritmanacontrol) ? (elementalmanacontrol / 2).truncate : (elementalmanacontrol / 4).truncate
		smc_part = (spiritmanacontrol > elementalmanacontrol)  ? (spiritmanacontrol / 2).truncate    : (spiritmanacontrol / 4).truncate
		spell_bonus = sorcererranks > (level + 1) ? (level + 1) * 2 + (sorcererranks - (level + 1)) : sorcererranks * 2
		bonus = level + wisdom + intuition +
		        (magicitemuse / 10).truncate +
		        (arcanesymbols / 10).truncate +
		        emc_part + smc_part + spell_bonus + 20
		respond "--- Service Sales Bonus: Sorcerer bonus = #{bonus}"
		{
			"game"    => XMLData.game,
			"name"    => Char.name,
			"prof"    => prof,
			"bonus"   => bonus,
			"weekly"  => weekly_resource,
			"total"   => total_resource,
			"suffused"=> suffused,
			"updated" => timestamp
		}

	when "Bard"
		spell_bonus = (bardranks > level) ? (level * 2) + (bardranks - level) : bardranks * 2
		bonus = level + intuition + influence +
		        magicitemuse + elementalmanacontrol + mentalmanacontrol + 20 + spell_bonus
		respond "--- Service Sales Bonus: Bard bonus = #{bonus}"
		{
			"game"    => XMLData.game,
			"name"    => Char.name,
			"prof"    => prof,
			"bonus"   => bonus,
			"weekly"  => weekly_resource,
			"total"   => total_resource,
			"suffused"=> suffused,
			"updated" => timestamp
		}

	when "Cleric"
		spell_bonus = clericranks > (level + 1) ? (level + 1) * 2 + (clericranks - (level + 1)) : clericranks * 2
		bonus = level + wisdom + influence +
		        (magicitemuse / 10).truncate +
		        (arcanesymbols / 10).truncate +
		        (spiritmanacontrol / 2).truncate +
		        spell_bonus + 20
		t6_capable = spiritloreblessings >= 100
		respond "--- Service Sales Bonus: Cleric bonus = #{bonus}#{t6_capable ? ", S6 Capable" : ""}"
		{
			"game"       => XMLData.game,
			"name"       => Char.name,
			"prof"       => prof,
			"bonus"      => bonus,
			"t6_capable" => t6_capable,
			"weekly"     => weekly_resource,
			"total"      => total_resource,
			"suffused"   => suffused,
			"updated"    => timestamp
		}

	when "Paladin"
		spell_bonus = paladinranks > (level + 1) ? (level + 1) * 2 + (paladinranks - (level + 1)) : paladinranks * 2
		bonus = level + wisdom + influence +
		        (magicitemuse * 1.5).truncate +
		        (arcanesymbols * 1.5).truncate +
		        spiritmanacontrol + spell_bonus + 20
		respond "--- Service Sales Bonus: Paladin bonus = #{bonus}"
		{
			"game"    => XMLData.game,
			"name"    => Char.name,
			"prof"    => prof,
			"bonus"   => bonus,
			"weekly"  => weekly_resource,
			"total"   => total_resource,
			"suffused"=> suffused,
			"updated" => timestamp
		}

	when "Ranger"
		spell_bonus = (rangerranks * 1.5).truncate
		# Always add +20 outdoor bonus
		bonus = level + (wisdom * 2) + (intuition * 2) +
		        (survival * 0.75).truncate +
		        magicitemuse + harnesspower +
		        spiritmanacontrol + spiritloreblessings +
		        spell_bonus + 20
		respond "--- Service Sales Bonus: Ranger bonus = #{bonus} (includes +20 outdoor bonus)"
		{
			"game"    => XMLData.game,
			"name"    => Char.name,
			"prof"    => prof,
			"bonus"   => bonus,
			"weekly"  => weekly_resource,
			"total"   => total_resource,
			"suffused"=> suffused,
			"updated" => timestamp
		}

	when "Empath"
		smc_part = (spiritmanacontrol >= mentalmanacontrol) ? (spiritmanacontrol / 2).truncate : (spiritmanacontrol / 4).truncate
		mmc_part = (mentalmanacontrol > spiritmanacontrol)  ? (mentalmanacontrol / 2).truncate  : (mentalmanacontrol / 4).truncate
		spell_bonus = (empathranks > level) ? (level * 2) + (empathranks - level) : empathranks * 2
		bonus = level + constitution + influence +
		        spell_bonus + smc_part + mmc_part +
		        (arcanesymbols / 10).truncate +
		        (magicitemuse / 10).truncate +
		        (physicalfitness / 20).truncate +
		        (firstaid / 20).truncate
		respond "--- Service Sales Bonus: Empath bonus = #{bonus}"
		{
			"game"    => XMLData.game,
			"name"    => Char.name,
			"prof"    => prof,
			"bonus"   => bonus,
			"weekly"  => weekly_resource,
			"total"   => total_resource,
			"suffused"=> suffused,
			"updated" => timestamp
		}

	when "Monk"
		self_bonus  = level + (dexterity * 2) + (discipline * 2) +
		              (physicalfitness * 0.75).truncate +
		              (firstaid / 2).truncate +
		              ((minormentalranks + minorspiritranks) * 2) +
		              arcanesymbols + mentalmanacontrol + spiritmanacontrol +
		              mentalloretransformationbonus
		other_bonus = level + (dexterity * 2) + (discipline * 2) +
		              (physicalfitness * 0.75).truncate +
		              (firstaid / 2).truncate +
		              ((minormentalranks + minorspiritranks) * 2) +
		              arcanesymbols + mentalmanacontrol + spiritmanacontrol +
		              mentalloretelepathybonus
		respond "--- Service Sales Bonus: Monk Self=#{self_bonus} Other=#{other_bonus}"
		{
			"game"    => XMLData.game,
			"name"    => Char.name,
			"prof"    => prof,
			"bonus"   => { "Self" => self_bonus, "Other" => other_bonus },
			"weekly"  => weekly_resource,
			"total"   => total_resource,
			"suffused"=> suffused,
			"updated" => timestamp
		}

	when "Warrior"
		common = level + strength + discipline + (physicalfitness / 10) + 20
		weapon_ranks = grit_skills.sort_by { |_k, v| v }.pop(3).reverse
		if weapon_ranks.length < 3
			respond "--- Service Sales Bonus: Warrior needs at least 3 weapon skills trained."
			return nil
		end
		wpn_bonus = common +
		            (weapon_ranks[0][1] > (level + 1) ? (level + 1) * 2 + (weapon_ranks[0][1] - (level + 1)) : weapon_ranks[0][1] * 2) +
		            ((weapon_ranks[1][1] + weapon_ranks[2][1]) / 2)
		arm_bonus = common +
		            (armoruse > (level + 1) ? (level + 1) * 2 + (armoruse - (level + 1)) : armoruse * 2) +
		            (shielduse / 3)
		respond "--- Service Sales Bonus: Warrior Weapon=#{wpn_bonus} Armor=#{arm_bonus}"
		{
			"game"    => XMLData.game,
			"name"    => Char.name,
			"prof"    => prof,
			"bonus"   => { "Weapon" => wpn_bonus, "Armor" => arm_bonus },
			"weekly"  => weekly_resource,
			"total"   => total_resource,
			"suffused"=> suffused,
			"updated" => timestamp
		}

	when "Rogue"
		base = level + (influence * 2) + gldranks + ambush + (pickpocketing * 0.5).truncate
		sidestep       = (base + (discipline * 2)   + dodging).truncate
		keen_eye       = (base + (intuition * 2)    + perception).truncate
		escape_artist  = (base + (agility * 2)      + combatmaneuvers).truncate
		swift_recovery = (base + (constitution * 2) + physicalfitness).truncate
		poisoncraft    = (base + (dexterity * 2)    + survival).truncate
		respond "--- Service Sales Bonus: Rogue Sidestep=#{sidestep} KeenEye=#{keen_eye} EscapeArtist=#{escape_artist} SwiftRecovery=#{swift_recovery} Poisoncraft=#{poisoncraft}"
		{
			"game"    => XMLData.game,
			"name"    => Char.name,
			"prof"    => prof,
			"bonus"   => {
				"Sidestep"       => sidestep,
				"Keen Eye"       => keen_eye,
				"Escape Artist"  => escape_artist,
				"Swift Recovery" => swift_recovery,
				"Poisoncraft"    => poisoncraft
			},
			"weekly"  => weekly_resource,
			"total"   => total_resource,
			"suffused"=> suffused,
			"updated" => timestamp
		}
	end
end

def run_bonus
	entry = calculate_bonus
	return unless entry
	key = "#{XMLData.game}:#{Char.name}"
	save_ss_bonus_entry(key, entry)
	respond "--- Service Sales Bonus: Saved for #{Char.name}."
	respond "--- Run ;service_sales setup to review and configure your ad."
end

# -- Build ad -----------------------------------------------------------------

def build_ad(sales_data)
	all_bonuses = load_ss_bonuses
	return nil if all_bonuses.empty?

	parts = []

	all_bonuses.each do |key, entry|
		next unless entry.is_a?(Hash)
		char_name  = entry["name"].to_s
		prof       = entry["prof"].to_s
		bonus_data = entry["bonus"]
		total_raw  = entry["total"].to_s.gsub(",", "").to_i
		suffused   = entry["suffused"].to_i
		t6_capable = entry["t6_capable"] == true
		next if total_raw == 0

		char_config = sales_data[key] || {}
		next unless char_config["include"] == true

		price = char_config["price"].to_f
		next if price == 0

		show_suffused = char_config["suffused"] == true && suffused > 0
		suf_str = show_suffused ? ", #{suffused} suffused avail" : ""

		# Use custom_bonus override for Wizard/Sorcerer/Cleric if set
		effective_bonus = if char_config["custom_bonus"].to_s.strip != "" && char_config["custom_bonus"].to_f > 0
			char_config["custom_bonus"].to_i
		else
			skill_bonus_value(bonus_data)
		end

		res  = resource_name_for(prof)
		unit = price_unit_for(prof)

		if prof == "Ranger"
			tier_result = ranger_best_tier(skill_bonus_value(bonus_data), total_raw)
			next unless tier_result
			r, t = tier_result
			avail_rounded = (round_resource(total_raw, prof) / 25_000) * 25_000
			avail_str = format_resource(avail_rounded)
			price_str = format_silver(price)
			parts << "#{prof} #{res}: #{avail_str} avail (Up to R#{r}T#{t}#{suf_str}) @ #{price_str}/wk"
			next
		end

		if prof == "Bard"
			t = bard_best_tier(skill_bonus_value(bonus_data), total_raw)
			next unless t
			avail_rounded = (total_raw / 25_000) * 25_000
			avail_str = format_resource(avail_rounded)
			price_str = format_silver(price)
			parts << "#{prof} #{res}: #{avail_str} avail (Up to L#{t}#{suf_str}) @ #{price_str}/wk"
			next
		end

		if prof == "Paladin"
			t = paladin_best_tier(skill_bonus_value(bonus_data), total_raw)
			next unless t
			avail_rounded = (total_raw / 25_000) * 25_000
			avail_str = format_resource(avail_rounded)
			price_str = format_silver(price)
			parts << "#{prof} #{res}: #{avail_str} avail (Up to P#{t}#{suf_str}) @ #{price_str}/wk"
			next
		end

		if prof == "Monk"
			t = monk_best_tier(skill_bonus_value(bonus_data, "Self"), total_raw)
			next unless t
			avail_rounded = (total_raw / 25_000) * 25_000
			avail_str = format_resource(avail_rounded)
			price_str = format_silver(price)
			parts << "#{prof} #{res}: #{avail_str} avail (Up to M#{t}#{suf_str}) @ #{price_str}/wk"
			next
		end

		if prof == "Cleric"
			t = cleric_best_tier(total_raw, t6_capable)
			next unless t
			avail_rounded = (total_raw / 25_000) * 25_000
			avail_str = format_resource(avail_rounded)
			price_str = format_silver(price)
			parts << "#{prof} #{res}: #{avail_str} avail (Up to S#{t} w/ #{effective_bonus} bonus#{suf_str}) @ #{price_str}/wk"
			next
		end

		if prof == "Empath"
			t = empath_best_tier(skill_bonus_value(bonus_data), total_raw)
			next unless t
			avail_rounded = (total_raw / 25_000) * 25_000
			avail_str = format_resource(avail_rounded)
			price_str = format_silver(price)
			parts << "#{prof} #{res}: #{avail_str} avail (Up to B#{t}#{suf_str}) @ #{price_str}/wk"
			next
		end

		if prof == "Sorcerer"
			t = sorcerer_best_tier(total_raw)
			next unless t
			avail_rounded = (total_raw / 25_000) * 25_000
			avail_str = format_resource(avail_rounded)
			price_str = format_silver(price)
			parts << "#{prof} #{res}: #{avail_str} avail (Up to E#{t} w/ #{effective_bonus} bonus#{suf_str}) @ #{price_str}/wk"
			next
		end

		if prof == "Wizard"
			best = wizard_best_enchant(total_raw)
			next unless best
			avail_str = format_resource((total_raw / 1_000) * 1_000)
			price_str = format_silver(price)
			parts << "#{prof} #{res}: #{avail_str} avail (Up to +#{best} w/ #{effective_bonus} bonus#{suf_str}) @ #{price_str}/ess"
			next
		end

		if prof == "Rogue"
			label = rogue_art_label(bonus_data)
			next unless label
			avail_rounded = (total_raw / 25_000) * 25_000
			avail_str = format_resource(avail_rounded)
			price_str = format_silver(price)
			parts << "#{prof} #{res}: #{avail_str} avail (#{label}#{suf_str}) @ #{price_str}/wk"
			next
		end

		avail_str = avail_display(prof, total_raw)
		next unless avail_str

		bonus     = bonus_display(prof, bonus_data)
		price_str = format_silver(price)
		suf_tag   = show_suffused ? " (#{suffused} suffused avail)" : ""

		parts << "#{prof} #{res}: #{avail_str} avail @ #{price_str}/#{unit == "per week" ? "wk" : unit == "per essence" ? "ess" : "svc"} #{bonus}#{suf_tag}"
	end

	return nil if parts.empty?
	"Selling services: " + parts.join(" | ")
end

# -- Send ad ------------------------------------------------------------------

def send_message_direct(msg, use_esp: true, use_lnet: true)
	respond ""
	respond " === Service Sales: Sending ==="
	respond " #{msg}"
	respond ""
	if use_esp
		put "think on merchant #{msg}"
		pause 1
	end
	if use_lnet
		LNet.send_message({ 'type' => 'channel', 'channel' => 'merchant' }, msg)
	end
	respond " === Service Sales: Ad sent! ==="
	respond ""
end

def send_ad(sales_data)
	ad = build_ad(sales_data)
	unless ad
		respond ""
		respond "--- Service Sales: Nothing to advertise."
		respond "--- No characters are included with a price set. To fix this:"
		respond "---   1. Run ;service_sales bonus on each character to calculate their bonus."
		respond "---   2. Run ;service_sales setup to open the ad builder."
		respond "---   3. Check the Include box next to each character you want to advertise."
		respond "---   4. Enter a price for each included character."
		respond "---   5. Click Save, then close the window and run ;service_sales again."
		respond ""
		return
	end

	use_esp  = sales_data.fetch("use_esp",  true)
	use_lnet = sales_data.fetch("use_lnet", true)
	send_message_direct(ad, use_esp: use_esp, use_lnet: use_lnet)
end

# -- GUI ----------------------------------------------------------------------

$ss_window = nil

# Returns true if this profession uses a custom bonus override field.
def prof_uses_custom_bonus?(prof)
	["Wizard", "Sorcerer", "Cleric"].include?(prof)
end

def build_setup_window
	all_bonuses = load_ss_bonuses
	sales_data  = load_sales_data

	if all_bonuses.empty?
		respond "--- Service Sales: No bonus data found."
		respond "--- Have your characters run ;service_sales bonus first."
		return
	end

	$ss_window = Gtk::Window.new
	$ss_window.title = "Service Sales - Setup"
	$ss_window.set_default_size(1000, 580)
	$ss_window.set_border_width(12)
	$ss_window.keep_above = true
	$ss_window.signal_connect("destroy") { $ss_window = nil }

	outer = Gtk::Box.new(:vertical, 10)
	$ss_window.add(outer)

	# Header
	header = Gtk::Label.new
	header.set_markup("<b>Service Sales Setup</b>")
	header.set_halign(:start)
	outer.pack_start(header, false, false, 0)

	sub = Gtk::Label.new("Configure price and inclusion for each character. Run ;service_sales bonus on each character to refresh data.")
	sub.set_halign(:start)
	sub.set_line_wrap(true)
	outer.pack_start(sub, false, false, 0)

	outer.pack_start(Gtk::Separator.new(:horizontal), false, false, 2)

	# Scrollable grid
	scroll = Gtk::ScrolledWindow.new
	scroll.set_policy(:never, :automatic)
	scroll.set_vexpand(true)
	outer.pack_start(scroll, true, true, 0)

	grid = Gtk::Grid.new
	grid.set_row_spacing(8)
	grid.set_column_spacing(10)
	grid.set_border_width(4)
	scroll.add(grid)

	# Column headers: Incl | Character | Profession | Available | Bonus | Custom Bonus | Price | Per | Suf | Updated
	headers = ["Incl", "Character", "Profession", "Available", "Bonus", "Custom Bonus", "Price (silvers)", "Per", "Suf", "Updated"]
	headers.each_with_index do |h, col|
		lbl = Gtk::Label.new
		lbl.set_markup("<b>#{h}</b>")
		lbl.set_halign(:start)
		grid.attach(lbl, col, 0, 1, 1)
	end

	char_widgets = {}  # key => { check:, price:, suffused:, custom_bonus: }

	all_bonuses.each_with_index do |(key, entry), i|
		next unless entry.is_a?(Hash)
		row = i + 1

		char_name  = entry["name"].to_s
		prof       = entry["prof"].to_s
		bonus_data = entry["bonus"]
		total_raw  = entry["total"].to_s.gsub(",", "").to_i
		updated    = entry["updated"].to_s
		char_config = sales_data[key] || {}

		# Include checkbox
		chk = Gtk::CheckButton.new
		chk.active = char_config["include"] == true
		grid.attach(chk, 0, row, 1, 1)

		# Character name
		name_lbl = Gtk::Label.new(char_name)
		name_lbl.set_halign(:start)
		name_lbl.set_size_request(100, -1)
		grid.attach(name_lbl, 1, row, 1, 1)

		# Profession
		prof_lbl = Gtk::Label.new(prof)
		prof_lbl.set_halign(:start)
		prof_lbl.set_size_request(80, -1)
		grid.attach(prof_lbl, 2, row, 1, 1)

		# Available
		avail_str = avail_display(prof, total_raw) || "0"
		res_name  = resource_name_for(prof)
		avail_lbl = Gtk::Label.new("#{avail_str} #{res_name}")
		avail_lbl.set_halign(:start)
		avail_lbl.set_size_request(140, -1)
		grid.attach(avail_lbl, 3, row, 1, 1)

		# Bonus (calculated)
		bonus_str = bonus_display(prof, bonus_data)
		bonus_lbl = Gtk::Label.new(bonus_str)
		bonus_lbl.set_halign(:start)
		bonus_lbl.set_size_request(160, -1)
		bonus_lbl.set_ellipsize(:end)
		bonus_lbl.set_tooltip_text(bonus_str)
		grid.attach(bonus_lbl, 4, row, 1, 1)

		# Custom Bonus entry (Wizard/Sorcerer/Cleric only; pre-populated with calculated value)
		custom_entry = Gtk::Entry.new
		custom_entry.set_size_request(90, -1)
		if prof_uses_custom_bonus?(prof)
			calc_val = skill_bonus_value(bonus_data).to_s
			saved_custom = char_config["custom_bonus"].to_s.strip
			custom_entry.text = saved_custom != "" ? saved_custom : calc_val
			custom_entry.set_placeholder_text("e.g. #{calc_val}")
			custom_entry.set_tooltip_text("Override the calculated bonus for this profession (affects ad text only)")
		else
			custom_entry.text = ""
			custom_entry.set_sensitive(false)
			custom_entry.set_tooltip_text("Custom bonus applies to Wizard, Sorcerer, and Cleric only")
		end
		grid.attach(custom_entry, 5, row, 1, 1)

		# Price entry
		price_entry = Gtk::Entry.new
		price_entry.set_size_request(120, -1)
		price_entry.set_placeholder_text("e.g. 2000000")
		current_price = char_config["price"]
		price_entry.text = current_price.to_s unless current_price.nil? || current_price.to_f == 0
		grid.attach(price_entry, 6, row, 1, 1)

		# Unit
		unit_lbl = Gtk::Label.new(price_unit_for(prof))
		unit_lbl.set_halign(:start)
		grid.attach(unit_lbl, 7, row, 1, 1)

		# Suffused checkbox
		suf_chk = Gtk::CheckButton.new
		suf_chk.active = char_config["suffused"] == true
		suf_chk.set_tooltip_text("Include suffused energy in ad")
		grid.attach(suf_chk, 8, row, 1, 1)

		# Updated timestamp
		ts_lbl = Gtk::Label.new(updated.empty? ? "(never)" : updated)
		ts_lbl.set_halign(:start)
		ts_lbl.set_size_request(130, -1)
		ts_lbl.set_tooltip_text("Last updated via ;service_sales bonus")
		grid.attach(ts_lbl, 9, row, 1, 1)

		char_widgets[key] = { check: chk, price: price_entry, suffused: suf_chk, custom_bonus: custom_entry }
	end

	outer.pack_start(Gtk::Separator.new(:horizontal), false, false, 2)

	# Auto preview
	preview_lbl = Gtk::Label.new
	preview_lbl.set_markup("<b>Auto Preview:</b>")
	preview_lbl.set_halign(:start)
	outer.pack_start(preview_lbl, false, false, 0)

	preview_text = Gtk::TextView.new
	preview_text.set_editable(false)
	preview_text.set_wrap_mode(:word)
	preview_text.set_size_request(-1, 55)
	preview_scroll = Gtk::ScrolledWindow.new
	preview_scroll.set_policy(:never, :automatic)
	preview_scroll.add(preview_text)
	outer.pack_start(preview_scroll, false, false, 0)

	outer.pack_start(Gtk::Separator.new(:horizontal), false, false, 2)

	# Editable message area
	edit_lbl = Gtk::Label.new
	edit_lbl.set_markup("<b>Edit Message Before Sending:</b>")
	edit_lbl.set_halign(:start)
	outer.pack_start(edit_lbl, false, false, 0)

	edit_hint = Gtk::Label.new("The message below is what will actually be sent. Edit freely --- changes here do not affect saved settings.")
	edit_hint.set_halign(:start)
	edit_hint.set_line_wrap(true)
	outer.pack_start(edit_hint, false, false, 0)

	edit_text = Gtk::TextView.new
	edit_text.set_editable(true)
	edit_text.set_wrap_mode(:word)
	edit_text.set_size_request(-1, 70)
	edit_scroll = Gtk::ScrolledWindow.new
	edit_scroll.set_policy(:never, :automatic)
	edit_scroll.add(edit_text)
	outer.pack_start(edit_scroll, false, false, 0)

	# Reset button
	reset_row = Gtk::Box.new(:horizontal, 8)
	reset_row.set_halign(:end)
	outer.pack_start(reset_row, false, false, 0)
	btn_reset = Gtk::Button.new(label: "Reset to Auto Preview")
	btn_reset.signal_connect("clicked") { edit_text.buffer.text = preview_text.buffer.text }
	reset_row.pack_start(btn_reset, false, false, 0)

	refresh_preview = lambda do
		temp_data = {}
		char_widgets.each do |key, w|
			temp_data[key] = {
				"include"      => w[:check].active?,
				"price"        => w[:price].text.gsub(",", "").to_f,
				"suffused"     => w[:suffused].active?,
				"custom_bonus" => w[:custom_bonus].text.strip
			}
		end
		ad = begin
			build_ad(temp_data)
		rescue StandardError => e
			respond "--- Service Sales: preview error: #{e.class}: #{e.message}"
			nil
		end
		preview_text.buffer.text = ad || "(No characters included or prices set - configure in the grid above)"
		edit_text.buffer.text    = ad || ""
	end

	char_widgets.each_value do |w|
		w[:check].signal_connect("toggled")        { refresh_preview.call }
		w[:price].signal_connect("changed")        { refresh_preview.call }
		w[:suffused].signal_connect("toggled")     { refresh_preview.call }
		w[:custom_bonus].signal_connect("changed") { refresh_preview.call }
	end

	outer.pack_start(Gtk::Separator.new(:horizontal), false, false, 2)

	# Send channel checkboxes
	channel_box = Gtk::Box.new(:horizontal, 16)
	channel_box.set_halign(:start)
	channel_lbl = Gtk::Label.new
	channel_lbl.set_markup("<b>Send via:</b>")
	channel_box.pack_start(channel_lbl, false, false, 0)

	chk_esp  = Gtk::CheckButton.new("Use ESP (think on merchant)")
	chk_esp.active  = sales_data.fetch("use_esp",  true)
	channel_box.pack_start(chk_esp,  false, false, 0)

	chk_lnet = Gtk::CheckButton.new("Use LNet (merchant channel)")
	chk_lnet.active = sales_data.fetch("use_lnet", true)
	channel_box.pack_start(chk_lnet, false, false, 0)

	outer.pack_start(channel_box, false, false, 4)

	# Buttons
	btn_box = Gtk::Box.new(:horizontal, 8)
	btn_box.set_halign(:end)
	outer.pack_start(btn_box, false, false, 0)

	def collect_data(char_widgets, chk_esp, chk_lnet)
		data = {
			"use_esp"  => chk_esp.active?,
			"use_lnet" => chk_lnet.active?
		}
		char_widgets.each do |key, w|
			val = w[:price].text.gsub(",", "").to_f
			data[key] = {
				"include"      => w[:check].active?,
				"price"        => val > 0 ? val : nil,
				"suffused"     => w[:suffused].active?,
				"custom_bonus" => w[:custom_bonus].text.strip
			}
		end
		data
	end

	btn_save = Gtk::Button.new(label: "Save")
	btn_save.signal_connect("clicked") do
		data = collect_data(char_widgets, chk_esp, chk_lnet)
		save_sales_data(data)
		respond "--- Service Sales: Settings saved."
	end
	btn_box.pack_start(btn_save, false, false, 0)

	btn_send = Gtk::Button.new(label: "Save & Send Ad")
	btn_send.signal_connect("clicked") do
		data = collect_data(char_widgets, chk_esp, chk_lnet)
		save_sales_data(data)
		msg = edit_text.buffer.text.strip
		if msg.empty?
			respond "--- Service Sales: Nothing to send. Check the Include box and set a price for at least one character."
		else
			use_esp  = chk_esp.active?
			use_lnet = chk_lnet.active?
			Thread.new { send_message_direct(msg, use_esp: use_esp, use_lnet: use_lnet) }
		end
	end
	btn_box.pack_start(btn_send, false, false, 0)

	btn_close = Gtk::Button.new(label: "Close")
	btn_close.signal_connect("clicked") do
		Gtk.queue do
			$ss_window.hide
			$ss_window.destroy
		end
	end
	btn_box.pack_start(btn_close, false, false, 0)

	refresh_preview.call
	$ss_window.show_all
end

def run_setup
	if $ss_window
		begin
			$ss_window.present
			return
		rescue
			$ss_window = nil
		end
	end
	GLib::Idle.add do
		begin
			build_setup_window
		rescue => e
			respond "--- Service Sales GUI error: #{e.class}: #{e.message}"
			respond e.backtrace.first(5).join("\n")
		end
		false
	end
	nil
end

# -- Help ---------------------------------------------------------------------

def show_help
	respond ""
	respond "  Service Sales"
	respond "  ============================================================"
	respond "  ;service_sales             Send the service ad via ESP/LNet"
	respond "  ;service_sales bonus       Calculate and save this character's"
	respond "                             bonus and resource totals"
	respond "  ;service_sales setup       Open the GUI to configure prices,"
	respond "                             inclusion, suffused, and custom bonus"
	respond "  ;service_sales help        Show this message"
	respond "  ;service_sales ?           Show this message"
	respond "  ============================================================"
	respond "  Workflow:"
	respond "    1. Run ;service_sales bonus on EACH character"
	respond "    2. Run ;service_sales setup to set prices and inclusion"
	respond "    3. Run ;service_sales to send the ad"
	respond ""
end

# -- Entry point --------------------------------------------------------------

case script.vars[1].to_s.downcase
when "setup", "config", "gui"
	run_setup
when "bonus"
	run_bonus
when "help", "?"
	show_help
else
	sales_data = load_sales_data
	if sales_data.empty?
		respond ""
		respond "--- Service Sales: Not configured yet."
		respond "--- 1. Run ;service_sales bonus on each character to calculate their bonus."
		respond "--- 2. Run ;service_sales setup to configure prices and inclusion."
		respond "--- Run ;service_sales help for full usage."
		respond ""
	else
		send_ad(sales_data)
	end
end
