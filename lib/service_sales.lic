	end

	nil
end

# -- Cleric tier helpers ------------------------------------------------------
# S6 requires 200k energy AND t6_capable flag (spiritloreblessings >= 100 at calc time).

CLERIC_TIER_COSTS = [50_000, 75_000, 100_000, 125_000, 150_000, 200_000].freeze

def cleric_best_tier(total_raw, t6_capable = false)
	avail = (total_raw / 25_000) * 25_000
	return nil if avail < 50_000

	if t6_capable && avail >= CLERIC_TIER_COSTS[5]
		return 6
	end

	5.downto(1) do |t|
		return t if avail >= CLERIC_TIER_COSTS[t - 1]
	end

	nil
end

