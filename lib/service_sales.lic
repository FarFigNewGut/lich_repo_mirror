=begin
	   Service Sales Version: 3.6.2 (Nov 19, 2026)
	   Author: peggyanne

	   Builds and sends a service advertisement for characters
	   based on bonus data calculated by this script. Per-character pricing and
	   include/exclude configured via GUI.

	   Usage:
	     ;service_sales         - Send ad for all included characters
	     ;service_sales bonus   - Calculate and save this character's bonus
	     ;service_sales setup   - Open the GUI to configure prices
	     ;service_sales help    - Show available commands
	     ;service_sales ?       - Show available commands

	 Change Log:

	             Sep 26, 2026 - Fixed Saga/GTK crash when editing Monk price: resource YAML stores Monk bonus as
	                            {Self:, Other:} Hash; build_ad called .to_i on it (NoMethodError) on every keystroke.
	             Nov  1, 2026 - Replaced generic T# tier labels with profession-specific monikers: Bard L1-6 (Luck),
	                            Cleric S1-6 (Sanctification), Empath B1-5 (Bloodstone Jewelry), Monk M1-5 (Motes),
	                            Paladin P1-6 (Battle Standard), Sorcerer E1-5 (Ensorcell). Ranger R#T# unchanged.
	                            Replaced Skills.spiritual_lore_blessings live check with a per-character "S6 Capable"
	                            checkbox in the GUI; Cleric rows show the checkbox; saved to service_sales.yaml.
	            Nov 19, 2026 - Added ;service_sales bonus subcommand: calculates and saves this character's service bonus
	                           using its own flock-protected YAML at DATA_DIR/service_sales/bonuses.yaml, eliminating
	                           dependency on resource.lic. Ranger always includes +20 outdoor bonus. Wizard always uses
	                           public workshop (+50) and familiar (+25). Cleric S6 capability determined live from
	                           spiritloreblessings >= 100 at calculation time. Added custom bonus override field in GUI
	                           for Wizard, Sorcerer, and Cleric (pre-populated with calculated value, user-adjustable).
	                           Replaced S6 checkbox with timestamp column in setup GUI. build_ad and send_ad now read
	                           from service_sales/bonuses.yaml; resource.lic no longer required. Added ;service_sales
	                           help / ? subcommand. Fixed stray backslash line continuation in Rogue guild-rank fetch.
=end

i_stand_alone
require "yaml"
require "gtk3"
require "fileutils"

# -- YAML helpers -------------------------------------------------------------

SALES_YAML    = File.join(DATA_DIR, XMLData.game, Char.name, "service_sales.yaml")
SS_BONUSES_YAML = File.join(DATA_DIR, "service_sales", "bonuses.yaml")

def load_sales_data
	FileUtils.mkdir_p(File.dirname(SALES_YAML))
	return {} unless File.exist?(SALES_YAML)
	begin
		raw = File.read(SALES_YAML)
		return {} if raw.strip.empty?
		YAML.safe_load(raw, permitted_classes: [Symbol], aliases: true) || {}
	rescue
		{}
	end
end

def save_sales_data(data)
	FileUtils.mkdir_p(File.dirname(SALES_YAML))
	File.open(SALES_YAML, File::RDWR | File::CREAT, 0o644) do |f|
		f.flock(File::LOCK_EX)
		f.rewind
		YAML.dump(data, f)
		f.flush
		f.truncate(f.pos)
	end
end

# Load all entries from the shared service_sales bonuses YAML.
# Uses a shared read lock so multiple readers don't block each other.
def load_ss_bonuses
	return {} unless File.exist?(SS_BONUSES_YAML)
	begin
		File.open(SS_BONUSES_YAML, "r") do |f|
			f.flock(File::LOCK_SH)
			raw = f.read
			return {} if raw.strip.empty?
			YAML.safe_load(raw, permitted_classes: [Symbol], aliases: true) || {}
		end
	rescue
		{}
	end
end

# Merge a single character entry into the shared bonuses YAML.
# Uses an exclusive write lock; reads existing data first to avoid clobbering
# entries saved by other characters running concurrently.
def save_ss_bonus_entry(key, entry)
	FileUtils.mkdir_p(File.dirname(SS_BONUSES_YAML))
	File.open(SS_BONUSES_YAML, File::RDWR | File::CREAT, 0o644) do |f|
		f.flock(File::LOCK_EX)
		f.rewind
		raw = f.read
		all = if raw.strip.empty?
			{}
		else
			begin
				YAML.safe_load(raw, permitted_classes: [Symbol], aliases: true) || {}
			rescue
				{}
			end
		end
		all[key] = entry
		f.rewind
		YAML.dump(all, f)
		f.flush
		f.truncate(f.pos)
	end
end

# -- Number formatting --------------------------------------------------------

def format_silver(n)
	n = n.to_f
	return "0" if n == 0
	if n >= 1_000_000
		v = n / 1_000_000.0
		v == v.truncate ? "#{v.truncate.to_i}m" : "#{'%.1f' % v}m"
	elsif n >= 1_000
		v = n / 1_000.0
		v == v.truncate ? "#{v.truncate.to_i}k" : "#{'%.1f' % v}k"
	else
		n.to_i.to_s
	end
end

def format_resource(n)
	n = n.to_i
	return "0" if n == 0
	n >= 1_000 ? "#{(n / 1_000).to_i}k" : n.to_s
end

def round_resource(total, prof)
	total = total.to_s.gsub(",", "").to_i
	case prof
	when "Wizard"   then (total / 1_000) * 1_000
	when "Warrior"  then (total / 10_000) * 10_000
	else
		rounded = (total / 25_000) * 25_000
		rounded < 50_000 ? 0 : rounded
	end
end

# -- Ranger tier helpers ------------------------------------------------------

def ranger_skill_required(r, t)
	200 + (r - 1) * 100 + (t - 1) * 150
end

def ranger_tier_cost(t)
	t * 25_000 + 25_000
end

def ranger_best_tier(skill_bonus, total_raw)
	avail = (total_raw / 25_000) * 25_000
	return nil if avail < 50_000

	skill_r, skill_t = 1, 1
	(1..5).each do |r|
		(1..5).each do |t|
			if skill_bonus >= ranger_skill_required(r, t)
				skill_r, skill_t = r, t
			end
		end
	end

	skill_t.downto(1) do |t|
		return [skill_r, t] if avail >= ranger_tier_cost(t)
	end

	nil
end

# -- Bard tier helpers --------------------------------------------------------

BARD_SKILL_GATES = [250, 325, 400, 475, 550, 625].freeze
BARD_TIER_COSTS  = [50_000, 75_000, 100_000, 125_000, 150_000, 200_000].freeze

def bard_best_tier(skill_bonus, total_raw)
	avail = (total_raw / 25_000) * 25_000
	return nil if avail < 50_000

	skill_t = nil
	BARD_SKILL_GATES.each_with_index do |gate, i|
		skill_t = i + 1 if skill_bonus >= gate
	end
	return nil unless skill_t

	skill_t.downto(1) do |t|
		return t if avail >= BARD_TIER_COSTS[t - 1]
	end

	nil
end

