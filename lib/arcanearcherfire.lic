# QUIET
## afire.lic
## This script aims and fires for an arcane archer
## AFire will fire at the head for an elemental arrow or at the eyes for a regular arrow
## Written by Ralkean

silence_me
if !(checkrt == 0) then echo "RT"; exit end
if !(checkcastrt == 0)then echo "Cast RT"; put "stance guard"; exit end
if (GameObj.targets.empty? and (GameObj.target.nil? || GameObj.target.status =~ /dead|gone/))
	echo "No valid targets"
	put "stance def"
	exit
end
if !(checkstance "offensive") then put "stance off" end
if ((!Effects::Cooldowns.active?("Elemental Arrows") and checkmana > 0) or Effects::Buffs.active?("Arcane Archer (Empowered)"))
		put "aim head"
	else
		put "aim right eye"
end
put "fire"

