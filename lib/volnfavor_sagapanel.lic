=begin
  volnfavor_sagapanel.lic

  Saga-only panel showing this character's Order of Voln favor, via
  Infomon's Lich::Resources.voln_favor tracking (populated from the
  "Voln Favor: N" line the game emits as part of the RESOURCE command's
  output -- see lib/gemstone/infomon/parser.rb).

  If the character isn't currently a Voln member, the panel says so
  instead of polling the game for a value that will never show up.

  Commands:
    (none -- fixed-layout readout, refreshes automatically)

  Tags: saga, frontend, mod, window, voln, favor, society
  Version: 1.0.0
=end

no_kill_all

unless $frontend == 'saga'
  respond ""
  respond " volnfavor_sagapanel relies on a Saga-specific dialog window and"
  respond " will not work correctly on other frontends."
  respond ""
  exit
end

module VolnFavorSagaPanel
  extend self
  include Lich::Common if defined?(Lich::Common)
end

VF_REFRESH_SECONDS = 30

def VolnFavorSagaPanel.voln_member?
  defined?(Lich::Gemstone::Societies::OrderOfVoln) && Lich::Gemstone::Societies::OrderOfVoln.member?
rescue StandardError
  false
end

def VolnFavorSagaPanel.refresh_from_game
  Lich::Resources.check(true)
rescue StandardError
  nil
end

def VolnFavorSagaPanel.signature
  [VolnFavorSagaPanel.voln_member?, Lich::Resources.voln_favor]
end

def VolnFavorSagaPanel.build_dialog
  out = String.new("<dialogData id='VolnFavorSagaPanel' clear='t'>")

  text = if VolnFavorSagaPanel.voln_member?
           favor = Lich::Resources.voln_favor
           "Favor: #{favor.nil? ? 'detecting...' : favor.with_commas}"
         else
           "Not a member of the Order of Voln"
         end

  out << "<label id='vf_line' value='#{text}' justify='left' left='0' top='0' />"
  out << "</dialogData>"
  out
end

_respond("<closeDialog id='VolnFavorSagaPanel'/><openDialog id='VolnFavorSagaPanel' title='Voln Favor' target='VolnFavorSagaPanel'>" + VolnFavorSagaPanel.build_dialog + "</openDialog>")

before_dying do
  _respond("<closeDialog id='VolnFavorSagaPanel'/>")
end

echo "Volnfavor_sagapanel is active."

VolnFavorSagaPanel.refresh_from_game if VolnFavorSagaPanel.voln_member?

@vf_last_signature = VolnFavorSagaPanel.signature
@vf_last_refresh_at = Time.now
@vf_last_redraw_at = Time.at(0)

loop do
  if VolnFavorSagaPanel.voln_member? && (Time.now - @vf_last_refresh_at) > VF_REFRESH_SECONDS
    VolnFavorSagaPanel.refresh_from_game
    @vf_last_refresh_at = Time.now
  end

  signature = VolnFavorSagaPanel.signature
  if signature != @vf_last_signature || (Time.now - @vf_last_redraw_at) > 1.0
    @vf_last_signature = signature
    @vf_last_redraw_at = Time.now
    _respond(VolnFavorSagaPanel.build_dialog)
  end
  sleep 0.25
end
