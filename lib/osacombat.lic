# ---------------------------------------------------------------------------
# Living Routine -- data helpers
# The routine is stored as living_routine: Array of entry hashes.
# Each hash has the following keys:
#   kind:           'attack' or 'spell'
#   type:           attack name string OR spell number string
#   stance:         stance string or '' (means use tab default)
#   min_mana:       integer (0 = no minimum)
#   max_mana:       integer (999 = no maximum)
#   min_stam:       integer
#   max_stam:       integer
#   min_targets:    integer
#   max_targets:    integer
#   tgt_stunned:    bool  (target must be stunned)
#   tgt_not_stunned:bool
#   tgt_bound:      bool
#   tgt_not_bound:  bool
#   tgt_webbed:     bool
#   tgt_not_webbed: bool
#   tgt_prone:      bool
#   tgt_not_prone:  bool
#   use_kneel:      bool  (attacks only)
#   use_stealth:    bool  (attacks only)
#   cast_type:      string -- '', 'channel', 'evoke', 'evoke channel' (spells only)
#   warding:        bool  (spells only)
#   open_cast:      bool  (spells only)
# ---------------------------------------------------------------------------

def living_routine_default_entry(kind)
  {
    'kind'            => kind,
    'type'            => '',
    'stance'          => '',
    'min_mana'        => 0,
    'max_mana'        => 999,
    'min_stam'        => 0,
    'max_stam'        => 999,
    'min_targets'     => 1,
    'max_targets'     => 99,
    'tgt_stunned'     => false,
    'tgt_not_stunned' => false,
    'tgt_bound'       => false,
    'tgt_not_bound'   => false,
    'tgt_webbed'      => false,
    'tgt_not_webbed'  => false,
    'tgt_prone'       => false,
    'tgt_not_prone'   => false,
    'tgt_rooted'      => false,
    'tgt_not_rooted'  => false,
    'tgt_frozen'      => false,
    'tgt_not_frozen'  => false,
    'tgt_calmed'      => false,
    'tgt_not_calmed'  => false,
    'use_kneel'       => false,
    'use_stealth'     => false,
    'flare_gloves_adj'  => '',
    'flare_gloves_noun' => '',
    'wings_pin_adj'     => '',
    'wings_pin_noun'    => '',
    'cast_type'       => '',
    'warding'         => false,
    'open_cast'       => false,
    'use_stomp'       => false,
    'use_tap'         => false,
    'use_pound'       => false,
    'only_use_on'     => '',
    'do_not_use_on'   => '',
    'until_dead'      => false,
    'mstrike_skip_celerity' => false,
    'mstrike_uac'           => false,
    'mstrike_archery'       => false,
    'mstrike_melee'         => false,
    'use_forcert'           => false,
    'use_quickstrike'       => false,
    'quickstrike_value'     => '-2',
  }
end

def living_routine_load
  raw = @combat_data["living_routine"]
  return [] unless raw.is_a?(Array)
  raw
end

def living_routine_save(routine)
  self.save_script_data("living_routine", routine)
  @combat_data["living_routine"] = routine
end

def undead_routine_load
  raw = @combat_data["undead_routine"]
  return [] unless raw.is_a?(Array)
  raw
end

def undead_routine_save(routine)
  self.save_script_data("undead_routine", routine)
  @combat_data["undead_routine"] = routine
end

unless defined?(ROOM_EFFECT_SPELLS)
ROOM_EFFECT_SPELLS = {
	"335" => /miniature storm of faintly glowing snowflakes/,
	"610" => /vine|bramble|widgeonweed|vathor club|swallowwort|smilax|creeper|creepers|briar|ivy|tumbleweed/,
	"709" => / arm|arms|pincer|pincers|tentacle|tentacles/,
	"710" => /tempest/,
	"720" => /void/,
	"118" => /web/,
}

# Spells that persist on specific targets - tracked via $osa_affected_targets[spell]
AFFECTED_TARGET_SPELLS = %w[917 1117 1614 217 512 611 603]
end # unless defined?(ROOM_EFFECT_SPELLS)

def can_cast_spell(spell, cast_type, stam_min, mana_min, enemy_min, enemy_max, warding, open_cast, base_var: nil)
	spell = spell.to_s.strip
	return if spell.empty? || spell == "0"
	return if Effects::Debuffs.active?("Mystic Impedance") || Effects::Debuffs.active?("Silenced")
	return if stunned? || webbed? || bound? || checkdead || GameObj.targets.empty?
	return unless get_target
	return if excluded_target?
	return unless base_var.nil? || target_in_routine?(base_var)
	return if Char.stamina.to_i < stam_min.to_i
	return if Char.mana.to_i    < mana_min.to_i
	return if GameObj.targets.count < enemy_min.to_i
	return if GameObj.targets.count > enemy_max.to_i
	unless Spell[spell].known?
		echo "------==== You Do Not Know Spell #{spell}. Check Your Spell Settings. ==== ------"
		return
	end

	# Room effect guard - don't recast if the effect is already present
	if (pattern = ROOM_EFFECT_SPELLS[spell])
		return if GameObj.loot.any? { |loot| loot.name =~ pattern }
	end

	# 909 (Tremors) - only cast if non-prone targets exist, then follow up
	if spell == "909"
		not_prone = GameObj.targets.reject { |npc| npc.status =~ /dead|gone|lying/ }
		return if not_prone.empty?
		if Spell[909].available?
			fput "incant 909 channel"
		end
		wait_rt
		pause 0.1
		fput "stomp" if @combat_data["stomp"]
		fput "pound" if @combat_data["pound"]
		fput "tap"   if @combat_data["tap"]
		return
	end

	# Affected target spells - skip if all current targets already affected and still alive
	if AFFECTED_TARGET_SPELLS.include?(spell) && spell != "917"
		refresh_affected_targets(spell)
		unaffected = GameObj.targets.map(&:id) - ($osa_affected_targets[spell] || [])
		if unaffected.empty?
			return
		else
			$osa_affected_targets[spell] ||= []
			$osa_affected_targets[spell].concat(GameObj.targets.map(&:id)).uniq!
		end
	end


	# 316 (Censure) - skip if already active, cast as warding spell
	if spell == "316"
		return if Effects::Buffs.active?("Censure")
		get_target
		stance_offensive
		fput "incant 316 #{cast_type} target"
		wait_castrt
		stance_defensive
		return
	end

	# 917 (Earthen Fury) - channel flag + per-target tracking
	if spell == "917"
		return if $earthen_fury_active
		refresh_affected_targets("917")
		unaffected = GameObj.targets.map(&:id) - ($osa_affected_targets["917"] || [])
		return if unaffected.empty?
		$osa_affected_targets["917"] ||= []
		$osa_affected_targets["917"].concat(GameObj.targets.map(&:id)).uniq!
		get_target
		stance_offensive
		fput "incant 917 #{cast_type} target"
		wait_castrt
		stance_defensive
		return
	end
	# Wait for mana if needed
	unless Spell[spell].affordable?
		mana_leech
		symbol_of_mana
		sigil_of_power
		# Rate-limited mana share - only request from group once per cooldown period
		if $osa_last_mana_share.nil? || (Time.now - $osa_last_mana_share) > (@combat_data["mana_share_cooldown"] || 90).to_i
			mana_share
			lnet_crew($mana_message)
			$osa_last_mana_share = Time.now
		end
		# Brief wait for mana to arrive - if still not affordable just skip
		pause 2
		return unless Spell[spell].affordable?
	end

	get_target
	if warding
		stance_defensive
	else
		stance_offensive
	end
	if open_cast
		fput ["incant", spell, cast_type.empty? ? nil : cast_type, "open"].compact.join(" ")
	else
		get_target
		fput ["incant", spell, cast_type.empty? ? nil : cast_type, "target"].compact.join(" ")
	end
	anti_magic_check
	wait_castrt
	stance_defensive
	health_monitor
end

def combat	
	prep_reset
	get_target
	return if GameObj.target.nil?
	load_attack_vars
	check_for_poaching if @combat_data["check_for_group"]
	# Opener spells - fire before attacks and regular spells each cycle
	if !$poaching && !@opener_spell1.to_s.empty?
		load_attack_vars
		can_cast_spell(@opener_spell1, @opener_cast_type1, @opener_spell1_stam_min, @opener_spell1_mana_min, @opener_spell1_enemy_min, @opener_spell1_enemy_max, @opener_spell1_warding, @opener_spell1_open, base_var: (@creature_type == "undead" ? "undead_opener" : "living_opener") + "1")
		health_monitor
	end
	if !$poaching && !@opener_spell2.to_s.empty?
		load_attack_vars
		can_cast_spell(@opener_spell2, @opener_cast_type2, @opener_spell2_stam_min, @opener_spell2_mana_min, @opener_spell2_enemy_min, @opener_spell2_enemy_max, @opener_spell2_warding, @opener_spell2_open, base_var: (@creature_type == "undead" ? "undead_opener" : "living_opener") + "2")
		health_monitor
	end
	if !$poaching && !@opener_spell3.to_s.empty?
		load_attack_vars
		can_cast_spell(@opener_spell3, @opener_cast_type3, @opener_spell3_stam_min, @opener_spell3_mana_min, @opener_spell3_enemy_min, @opener_spell3_enemy_max, @opener_spell3_warding, @opener_spell3_open, base_var: (@creature_type == "undead" ? "undead_opener" : "living_opener") + "3")
		health_monitor
	end
	if !$poaching && $osa_reactive
		reactive
	end
	health_monitor
	wait_rt
	check_for_poaching if @combat_data["check_for_group"]
	# Living routine -- iterate the dynamic array in order
	if @creature_type == "living"
		@living_routine.each do |entry|
			check_for_poaching if @combat_data["check_for_group"]
			break if $poaching
			load_attack_vars
			if entry["kind"] == "attack"
				dispatch_attack_entry(entry)
			else
				dispatch_spell_entry(entry)
			end
			health_monitor
			wait_rt
		end
	end
	if @creature_type == "undead"
		@undead_routine.each do |entry|
			check_for_poaching if @combat_data["check_for_group"]
			break if $poaching
			load_attack_vars
			if entry["kind"] == "attack"
				dispatch_attack_entry(entry)
			else
				dispatch_spell_entry(entry)
			end
			health_monitor
			wait_rt
		end
	end
	if !$poaching
		if @combat_data["use_kneel"]
			kneel_check
		end
	end
	check_for_poaching if @combat_data["check_for_group"]
	if !$poaching
		mstrike_routine
	end
	health_monitor
	wait_rt
	check_for_poaching if @combat_data["check_for_group"]
	if !$poaching && $osa_reactive
		reactive
	end
	check_for_poaching if @combat_data["check_for_group"]
	if !$poaching
		if @combat_data["use_stealth"]
			hide_time
		end
	end
	check_for_poaching if @combat_data["check_for_group"]
	if !$poaching
		if @combat_data["noattack"]
			if @combat_data["osaarcher"]
				chicken_fire
			end
			if @combat_data["use_uac"]
				uac_round
			end
			if !@combat_data["use_uac"] && !@combat_data["osaarcher"]
				chicken_attack
			end
		end
	end
	health_monitor
	wait_rt
	prep_reset
	check_for_poaching if @combat_data["check_for_group"]
	if !$poaching && $osa_reactive
		reactive
	end
	check_for_poaching if @combat_data["check_for_group"]
	if !$poaching && !@attack_spell1.to_s.empty?
		load_attack_vars
		can_cast_spell(@attack_spell1, @cast_type1, @attack_spell1_stam_min, @attack_spell1_mana_min, @attack_spell1_enemy_min, @attack_spell1_enemy_max, @attack_spell1_warding, @attack_spell1_open, base_var: (@creature_type == "undead" ? "undead_spell" : "spell") + "1")
