def wings_pin_target(type)
	if type == :light
		adj  = @combat_data["light_wings_pin_adj"].to_s.strip
		noun = @combat_data["light_wings_pin_noun"].to_s.strip
	else
		adj  = @combat_data["dark_wings_pin_adj"].to_s.strip
		noun = @combat_data["dark_wings_pin_noun"].to_s.strip
	end
	return nil if noun.empty?
	adj.empty? ? noun : "#{adj} #{noun}"
end

def use_light_wings_luminous_flight
	return if Effects::Cooldowns.active?("Luminous Flight")
	target = wings_pin_target(:light)
	return unless target
	wait_castrt
	fput "tap my #{target}"
	wait_castrt
end

def use_light_wings_prismatic_aegis
	return if Effects::Cooldowns.active?("Prismatic Aegis")
	target = wings_pin_target(:light)
