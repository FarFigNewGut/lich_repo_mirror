self.load_osa_yaml
self.cleanup_obsolete_vars
TITLE = "OSACombat: v. (#{@combat_data["version"]})" unless defined?(TITLE)

check_dependencies("OSACombat", [
	{ name: "eherbs",          author: "elanthia-online" },
	{ name: "lnet",            author: "elanthia-online" },
	{ name: "osasail_watch",   author: "peggyanne"       },
	{ name: "osacannon_watch", author: "peggyanne"       },
	{ name: "osa_migrate",     author: "peggyanne"       },
])

# -- Migration check ----------------------------------------------------------
# If osacombat.yaml is empty/new AND osa_vars.yaml exists, the user has old
# settings that need migrating. Prompt them to run osa_migrate.
_osa_data_dir   = File.join(DATA_DIR, XMLData.game, Char.name)
_osa_vars_path  = File.join(_osa_data_dir, "osa_vars.yaml")
_combat_is_new  = @combat_data.empty? || @combat_data.keys == ["version"]

if _combat_is_new && File.exist?(_osa_vars_path)
  respond ""
  respond " =========================================================="
  respond "  OSACombat: Old settings detected (osa_vars.yaml found)."
  respond "  Running osa_migrate will move your spell and attack"
  respond "  settings into the new yaml format automatically."
  respond " =========================================================="
  respond "  Would you like to download and run osa_migrate now?"
  respond "    1. Yes - download and run osa_migrate, then continue"
  respond "    2. No  - continue without migrating (you will need to"
  respond "             re-enter your combat settings manually)"
  respond "  NOTE: This warning will not appear again once your"
  respond "        settings have been saved."
  respond " =========================================================="
  respond "  Please select an option - ;send <#>"
  respond ""
  clear
  _mig_line = nil
  _mig_line = get until _mig_line.to_s.strip =~ /^[12]$/
  if _mig_line.strip == "1"
    if Script.exists?("osa_migrate")
      respond "  Running osa_migrate..."
    else
      respond "  Downloading osa_migrate..."
      start_script("repository", ["download", "osa_migrate"])
      wait_until { !running?("repository") }
      respond "  Download complete."
    end
    start_script("osa_migrate")
    wait_until { !running?("osa_migrate") }
    self.load_osa_yaml
    respond "  Migration complete! Your settings have been loaded."
    respond ""
  else
    respond ""
    respond "  Very well. Your combat settings will need to be configured"
    respond "  manually via ;osacombat setup. This prompt will not appear"
    respond "  again once your settings have been saved."
    respond ""
  end
end
# -- End migration check ------------------------------------------------------

