def return_to_injured_room
	if Room.current.id == @captains_quarters && (Room.current.location == "Ships")
		start_script("go2", [@injured_room])
		wait_while { running?("go2") }
		unpause_script "osacrew"
	end
end

def get_captains_location
	LNet.send_message(attr = { 'type' => 'private', 'to' => osacrew_data["commander"] }, "Captain, I've Been Injured and Will Return Shortly")
	result = matchtimeout 30, /^\[Private\]-GSIV:#{osacrew_data["commander"]}\: \"Ok Crewman\, We Are At (.*) And Will Await Your Arrival"/
		if result.to_s =~ /^\[Private\]-GSIV:#{osacrew_data["commander"]}\: \"Ok Crewman\, We Are At (.*) And Will Await Your Arrival"/
			@captains_location = $1
		else
			echo "Something Went Wrong, Retrying!"
			get_captains_location
	end
end

def wheres_the_captain
	if !checkpcs.include?(osacrew_data["commander"]) && (!osacrew_data["commander"].include?(checkname)) && (Room.current.location == "Ships")
		get_captains_location
		fput "group open"
		start_script("go2", [@captains_location])
		wait_while { running?("go2") }
	end
end

def go_to_healer
	if (!checkpcs.include? osacrew_data["medicalofficer"]) and (Room.current.location == "Ships")
		wait_rt
		pause_script "osacrew"
		ship_type
		@injured_room = Room.current.id
		if (Room.current.id != @captains_quarters) && (Room.current.location == "Ships")
			start_script("go2", ["captains_quarters"])
			wait_while { running?("go2") }
		end
	end
	if checkpcs.include? osacrew_data["medicalofficer"]
		if $osa_healing_status == "poisoned"
			lnet_crew("I Am Poisoned!")
			wait_until {!Effects::Debuffs.active? ("Wall of Thorns Poison 5") and (!Effects::Debuffs.active? "Wall of Thorns Poison 4") and (!Effects::Debuffs.active? "Wall of Thorns Poison 3") and (!Effects::Debuffs.active? "Wall of Thorns Poison 2") and (!Effects::Debuffs.active? "Wall of Thorns Poison 1") and !checkpoison}
			wait_until {!Effects::Debuffs.active? ("Wall of Thorns Poison 1") and (!Effects::Debuffs.active? "Wall of Thorns Poison 2") and (!Effects::Debuffs.active? "Wall of Thorns Poison 3") and (!Effects::Debuffs.active? "Wall of Thorns Poison 4") and (!Effects::Debuffs.active? "Wall of Thorns Poison 5") and !checkpoison}
			$osa_healing_status = "clear"
			return_to_injured_room
			wheres_the_captain
		end
		if $osa_healing_status == "diseased"
			lnet_crew("I Am Diseased!")
			wait_until {!diseased?}
			$osa_healing_status = "clear"
			return_to_injured_room
			wheres_the_captain
		end
		if $osa_healing_status == "injured"
			lnet_crew("I Am Injured!")
			wait_until {!XMLData.injuries.any?{|key,value,| value["wound"] > @combat_data["wound_level"].to_i}}
			$osa_healing_status = "clear"
			return_to_injured_room
			wheres_the_captain
		end
		if $osa_healing_status == "popped"
			if Feat.known?("Kroderine Soul")
				LNet.send_message(attr = { 'type' => 'private', 'to' => osacrew_data["medicalofficer"] }, "surge KS")
			else
				LNet.send_message(attr = { 'type' => 'private', 'to' => osacrew_data["medicalofficer"] }, "surge")
			end
			wait_until {!Effects::Debuffs.active? "Overexerted"}
			$osa_healing_status = "clear"
			return_to_injured_room
			wheres_the_captain
		end
	else
		if $osa_healing_status == "poisoned"
			respond ""
			respond " -------                                         WARNING                                                  --------"
			respond " -------                  You Appear To Be Poisoned And There Is No Herbal Cure For Poison                --------"
			respond " ------- OSACombat Will Wait Until The Poison Is No Longer Affecting You And Then Return To Your Last Location ---"
			respond " -------                      To Stop Waiting And\\Or Continue With The Poison Type YES                       --------"
			respond ""
			waitfor /A good positive attitude never hurts/
			$osa_healing_status = "ignore"
			return_to_injured_room
			wheres_the_captain
		end
		if $osa_healing_status == "diseased"
			respond ""
			respond " -------                                         WARNING                                                  --------"
			respond " -------                  You Appear To Be Poisoned And There Is No Herbal Cure For Disease               --------"
			respond " ------- OSACombat Will Wait Until The Disease Is No Longer Affecting You And Then Return To Your Last Location ---"
			respond " -------                      To Stop Waiting And\\Or Continue With The Disease Type YES                       --------"
			respond ""
			waitfor /A good positive attitude never hurts/
			$osa_healing_status = "ignore"
			return_to_injured_room
			wheres_the_captain
		end
		if $osa_healing_status == "injured"
			healing_stance
			if @combat_data["safe_room"].to_i != 0
				start_script("go2", [@combat_data["safe_room"]])
				wait_while { running?("go2") }
			end
			do_client ";eherbs --buy=off --mending=on --skipscars=on --yaba=on --potions=on"
			wait_while { running?("eherbs") }
			if XMLData.injuries.any?{|key,value| value["wound"] > @combat_data["wound_level"].to_i}
				respond " -------      You Still Have Serious Wounds, It Is Recommended You Seek Medical Attention Immediately -------"
				respond " -------              OSACombat Will Stay Here Where It Is Safe Until You Can Get Help                -------"
				respond " -------                   To Stop Waiting And\\Or Continue With The Wounds Type YES                      -------"
				waitfor /A good positive attitude never hurts/
				$osa_healing_status = "ignore"
			end
			return_to_injured_room
			wheres_the_captain
		end
		if $osa_healing_status == "popped"
			healing_stance
			if @combat_data["safe_room"].to_i != 0
				start_script("go2", [@combat_data["safe_room"]])
				wait_while { running?("go2") }
			end
			respond " -------      You Have Overexertion, It Is Recommended You Seek Medical Attention Immediately         -------"
			respond " -------              OSACombat Will Stay Here Where It Is Safe Until You Can Get Help                -------"
			respond " -------                   To Stop Waiting And\\Or Continue With The Overexertion Type YES                      -------"
			waitfor /A good positive attitude never hurts/
			$osa_healing_status = "ignore"
			return_to_injured_room
			wheres_the_captain
		end
	end
end

def check_for_poison
	if (Effects::Debuffs.active? "Wall of Thorns Poison 1")||(Effects::Debuffs.active? "Wall of Thorns Poison 2")||(Effects::Debuffs.active? "Wall of Thorns Poison 3")||(Effects::Debuffs.active? "Wall of Thorns Poison 4")||(Effects::Debuffs.active? "Wall of Thorns Poison 5")||(checkpoison)
		if Spell[114].known? && Spell[114].affordable? && (!Effects::Debuffs.active? "Mystic Impedance") && (!Effects::Debuffs.active? "Silenced")
			Spell[114].cast
			pause 0.3
			return
		end
		if $osa_healing_status == "ignore"
			return
		else
			$osa_healing_status = "poisoned"
			$osa_status_burst = true
			go_to_healer
		end
	end
end

def check_for_disease
	if (diseased?) || ($osa_healing_status == "diseased")
		# Clearance guard -- if the downstream hook set the flag but diseased? has since
		# cleared, reset and return. However skip this if stunned since the XML status
		# may not have updated yet and we would prematurely clear a real disease.
		if $osa_healing_status == "diseased" && !diseased? && !stunned?
			$osa_healing_status = "clear"
			return
		end
		if Spell[113].known? && Spell[114].affordable? && (!Effects::Debuffs.active? "Mystic Impedance") && (!Effects::Debuffs.active? "Silenced")
			Spell[113].cast
			pause 0.3
			return
		end
		if $osa_healing_status == "ignore"
			return
		else
			$osa_healing_status = "diseased"
			lnet_crew("#{checkname} Is Diseased!")
			go_to_healer
		end
	end
end

def check_for_injuries
	activate_gemstone_blood_wellspring if @combat_data["gemstone_blood_wellspring"]
	if (Char.percent_health < @combat_data["percent_health"].to_i) && @combat_data["symbol_of_restore"]
		fput "sym rest" until Char.percent_health > 90
		wait_rt
		pause 0.5
	end
	if XMLData.injuries.any?{|key,value| value["wound"] > @combat_data["wound_level"].to_i}
		if osacrew_data["medicalofficer"].include? "#{checkname}"
			wait_while { running?("ecure") }
			wait_rt
			pause 0.5
			start_script "ecure"
			wait_while { running?("ecure") }
		else
			if $osa_healing_status == "ignore"
				return
			# Block injury only during the same burst as a disease/poison detection
			# so the status flag is not overwritten before check_for_disease acts on it.
			# Once the burst clears, injuries are reported normally even if also diseased/poisoned.
			elsif $osa_status_burst && ["diseased", "poisoned"].include?($osa_healing_status)
				return
			else
				$osa_healing_status = "injured"
				go_to_healer
			end
		end
	end
	# Clear the burst flag after injuries have been evaluated this cycle
	$osa_status_burst = false
end

def check_for_popped
	if Effects::Debuffs.active? "Overexerted"
		if Spell[1107].known? && Spell[1107].affordable? && (!Effects::Debuffs.active? "Mystic Impedance") && (!Effects::Debuffs.active? "Silenced")
			Spell[1107].cast
			pause 0.3
			return
		end
		if $osa_healing_status == "ignore"
			return
		else
			$osa_healing_status = "popped"
			go_to_healer
		end
	end
end

def check_for_stunned
	if(!checkstunned && !checkdead && GameObj.pcs.find { |p| p.status =~ /stunned/ })
		stunned_players = GameObj.pcs
		if Spell[108].known? && @combat_data["use_unstun"] && (!Effects::Debuffs.active? "Mystic Impedance") && (!Effects::Debuffs.active? "Silenced")
			stunned_players.each do |p|
				wait_rt
				if p.status =~ /stun/i
					wait_until{ Char.mana >= 8 }
					wait_castrt
					fput "prep 108"
					fput "cast " + p.noun
					pause 3
				end
			end
		end
	end
end

def check_dead
	if checkdead
		respond "
			You Have Died My Friend, Please Wait Until You Are Resurrected!
				"
		lnet_crew("Call The Bugleman, Crewman #{checkname} Has Died!")
		if Spell[9823].known?
			Spell[9823].cast
		end
		if running? "osacrew"
			stop_script "osacrew"
		end
		exit
	end
end

def check_daybringer
	check_weapon = Lich::Util.quiet_command("anal my #{GameObj.right_hand}", /You analyze the |(NIGHT|DAY)BRINGER/, end_pattern = /Target: As brilliant as the sun, radiant beams surge forth from [ATTACKER's] [ITEM] and burn you, leaving a stench of scorched matter in the air!!/, include_end = true ,timeout = 3, silent = true)
	if check_weapon.to_s =~ /NIGHTBRINGER/ 
		$daybringer = false
	elsif check_weapon.to_s =~ /DAYBRINGER/
		$daybringer = true
	end
end

def beseechme
	beseech = dothistimeout "beseech", 3, /You beseech (.*) for some divine assistance.|...wait/
	if beseech.to_s =~ /You beseech (.*) for some divine assistance./
		return
	elsif beseech.to_s =~ /...wait/
		beseechme
	end
end

def check_status
	$status = false
	$need_dispel = false
	$status = true if ((Effects::Debuffs.active? "Stunned") or (Effects::Debuffs.active? "Calm") or (Effects::Debuffs.active? "Frenzy") or (Effects::Debuffs.active? "Curse") or (Effects::Debuffs.active? "Webbed") or (Effects::Debuffs.active? "Bind") or (Effects::Debuffs.active? "Interference") or (Effects::Debuffs.active? "Moonbeam") or (Effects::Debuffs.active? "Stone Fist"))
	$need_dispel = true if ((Effects::Debuffs.active? "Earthen Fury")or (Effects::Debuffs.active? "Condemn"))
	if ((@combat_data["symbol_of_transcendance"]) && (!Spell[9049].active? && !Spell[9812].active?) && (checkrt > 6) && (!standing? or stunned? or webbed?) && (GameObj.targets.any? { |npc| npc.type !~ /passive/ and npc.status !~ /dead/ }))
		if Spell[9812].known? && Spell[9812].affordable?
			fput "symbol of transcendence"
			fput "symbol of transcendence confirm"
		end
	end
	if ((@combat_data["di_armor"]) && (checkrt > 6) && (!standing? or stunned? or webbed?) && (GameObj.targets.any? { |npc| npc.type !~ /passive/ and npc.status !~ /dead/ }))
		if Spell[1650].known?
			fput "incarn armor"
		end
	end
	if $status
		if Spell[1635].known? && Spell[1635].affordable?
			wait_castrt
			beseechme
			pause 0.3
			check_status
		end
	end
	if ($need_dispel && (!Effects::Debuffs.active? "Mystic Impedance"))
		wait_castrt
		if Spell[119].known? && Spell[119].affordable?
			multifput "prep 119", "channel #{checkname}"
		end
		if Spell[417].known? && Spell[417].affordable?
			multifput "prep 417", "channel #{checkname}"
		end
		pause 0.3
		check_status
	end
	stand_check
end

def health_monitor
	check_dead
	check_status
	check_for_poison
	check_for_disease
	check_for_injuries
	check_for_popped
	check_for_stunned
end



def check_for_poaching
	return unless @combat_data["check_for_group"]
	# Wait for Lich claim XML to finish updating before reading state
	sleep(0.1) while Lich::Gemstone::Claim::Lock.locked?
	# Stranger PC check - stop immediately if non-group PCs are in the room
	group_nouns = (Group.members.to_a.map { |m| m.noun.to_s.downcase } + [Char.name.downcase])
	stranger_pcs = GameObj.pcs.to_a.reject { |pc| group_nouns.include?(pc.noun.to_s.downcase) }
	unless stranger_pcs.empty?
		$poach_strikes = 0
		$poaching = true
		return
	end
	# Disk check - exclude own disk and group member disks
	own_disk_noun = "#{Char.name.downcase}'s disk"
	stranger_disks = Lich::Gemstone::Disk.all.to_a - Lich::Gemstone::Group.disks.to_a
	stranger_disks = stranger_disks.reject { |d| group_nouns.include?(d.noun.to_s.downcase) || d.name.to_s.downcase == own_disk_noun }
	unless stranger_disks.empty?
		$poach_strikes = 0
		$poaching = true
		return
	end
	# Claim check - solo hunters always get a pass; strike counter for grouped hunting
	if Group.members.to_a.empty?
		$poach_strikes = 0
		$poaching = false
	elsif Lich::Gemstone::Claim.mine?
		$poach_strikes = 0
		$poaching = false
	else
		$poach_strikes += 1
		$poaching = true if $poach_strikes >= 3
	end
end

def energy_shield
	checkshield = Lich::Util.quiet_command("anal my pavis", /You analyze the/, end_pattern = /leaving a stench of scorched matter in the air!/, include_end = true ,timeout = 3, silent = true)
	if checkshield.to_s =~ /\(Store Energy\)(\W+)Currently\:(\s+)(.*)(\s+)PUSH/
		if $3.delete('^a-zA-Z') == "ON"
			$drained_flares = true
		else
			$drained_flares = false
		end
	end
	if checkshield.to_s =~ /at the cost of energy\)(\W+)Currently\:(\s+)(.*)(\s+)PUNCH/
		if $3.delete('^a-zA-Z') == "ON"
			$surged_flares = true
		else 
			$surged_flares = false
		end
	end
	if checkshield.to_s =~ /Energy Stored\: ([0-9,]+)\/500/
		$energy_stored = $1
	end
	set_shield
end

def set_shield
	if ($energy_stored.to_i <= 20) && (($surged_flares && !$drained_flares) or (!$surged_flares && !$drained_flares))
		wait_rt
		pause 0.1
		if $surged_flares 
			fput "push my pavis"
			wait_rt
			pause 0.1
		end
		fput "pull my pavis"
		wait_rt
		pause 0.1
	end
	if ($energy_stored.to_i >= 500) && ((!$surged_flares && $drained_flares) or (!$surged_flares && !$drained_flares))
		wait_rt
		pause 0.1
		if $drained_flares
			fput "pull my pavis"
			wait_rt
			pause 0.1
		end
		fput "push my pavis"
		wait_rt
		pause 0.1
	end
end

def is_it_daytime
	$est_time = TZInfo::Timezone.get('America/New_York').now
	if $est_time.hour >= 6 && $est_time.hour < 18
	  $daytime = true
	else
	  $daytime = false
	end
end

def daybringer_light
	is_it_daytime
	check_light = Lich::Util.quiet_command("anal my #{GameObj.right_hand}", /You analyze the |(NIGHT|DAY)BRINGER/, end_pattern = /Target: As brilliant as the sun, radiant beams surge forth from [ATTACKER's] [ITEM] and burn you, leaving a stench of scorched matter in the air!/, include_end = true ,timeout = 3, silent = true)
	if check_light.to_s =~ /\(Charge with 111, 609, 205 \(Light, Cast\), 135\)(\W+)Status\:(\s+)(.*)(\s+)Cauterize/
		if $3.delete('^a-zA-Z') == "Ready"
			$ready_to_charge = true
		else
			$ready_to_charge = false
		end
	end
	if check_light.to_s =~ /Stored: ([0-9,]+)\/250/
		$stored_light = $1
	end
	if ($stored_light.to_i <= 210) && $ready_to_charge
		pause 0.5
		if !$daytime
			Spell[111].cast GameObj.right_hand
		elsif $daytime && Room.current.outside?
			fput "raise my spear"
			pause 3
		end
	end
end

def daybringer_darkness
	is_it_daytime
	check_darkness = Lich::Util.quiet_command("anal my #{GameObj.right_hand}", /You analyze the |(NIGHT|DAY)BRINGER/, end_pattern = /Target: As brilliant as the sun, radiant beams surge forth from [ATTACKER's] [ITEM] and burn you, leaving a stench of scorched matter in the air!/, include_end = true ,timeout = 3, silent = true)
	if check_darkness.to_s =~ /\(Charge with 712, 205 \(Darkness, Evoke\), 705, 907, 1709, 711\)(\W+)Status\:(\s+)(.*)(\s+)Cauterize/
		if $3.delete('^a-zA-Z') == "Ready"
			$ready_to_charge = true
		else
			$ready_to_charge = false
		end
	end
	if check_darkness.to_s =~ /Stored: ([0-9,]+)\/250/
		$stored_darkness = $1
	end
	if ($stored_darkness.to_i <= 210) && $ready_to_charge
		pause 0.5
		if !$daytime
			fput "raise my spear"
			pause 3
		elsif $daytime && Room.current.outside?
			fput "turn my spear"
			pause 2.0
			Spell[111].cast GameObj.right_hand
			fput "turn my spear"
		end
	end
end

def checkfordead
	@deadnpcs = GameObj.npcs.find_all { |i| i.status =~ /dead|gone/ }
   # @deadnpcs.delete_if { |npc| (npc.name =~ /animated/ && npc.name !~ /animated slush/) }
   # @deadnpcs.delete_if { |npc| npc.noun =~ /child|traveller|scribe|merchant|dignitary|official|magistrate/i && npc.name !~ /ethereal|celestial|unworldly/i }
   # @deadnpcs.delete_if { |npc| npc.noun =~ /^(?:arm|appendage|claw|limb|pincer|tentacle)s?$|^(?:palpus|palpi)$/i }
end	

# ===== helpers =====
# One helper to BUILD them all!
def self.ui(parent, type, **o)
	@OSA_COM_ENTRY ||= {}
	@combat_data ||= {}
	@_ui_sizegroups ||= Hash.new { |h, k| h[k] = {} }  # { group_sym => { col_int => Gtk::SizeGroup } }
	get_key = ->(v) { v.nil? ? nil : v.to_s }
	get_val = ->(key) { d = @combat_data || {}; key && d.key?(key) ? d[key] : nil }
	set_widget_width = lambda do |widget, width|
		return widget unless widget && width
		widget.set_size_request(width, -1)
		widget
	end
	case type
	when :row
		row = Gtk::Box.new(:horizontal, o.fetch(:spacing, 12))
		row.set_halign(o[:halign]) if o[:halign]
		row.set_hexpand(o.fetch(:hexpand, true))
		parent.pack_start(row, false, false, o.fetch(:pad, 0)) if parent
		return row
	when :vrow
		col = Gtk::Box.new(:vertical, o.fetch(:spacing, 8))
		col.set_border_width(o[:border] || 0)
		parent.pack_start(col, false, false, o.fetch(:pad, 0)) if parent
		return col
	when :header
		outer = Gtk::Box.new(:vertical, o.fetch(:spacing, 4))
		label = Gtk::Label.new
		label.set_xalign(0.0)
		label.use_markup = true
		text = o.fetch(:text).to_s
		safe =
			if GLib.respond_to?(:markup_escape_text)
				GLib.markup_escape_text(text)
			else
				text.gsub("&", "&amp;").gsub("<", "&lt;").gsub(">", "&gt;")
			end
		label.label = "<b>#{safe}</b>"
		sep = Gtk::Separator.new(:horizontal)
		outer.pack_start(label, false, false, 0)
		outer.pack_start(sep, false, false, 0)
		parent.pack_start(outer, false, false, o.fetch(:pad, 6)) if parent
		return outer
	when :blank
		spacer = Gtk::Box.new(:vertical, 0)
		spacer.set_size_request(-1, o.fetch(:height, 8))
		parent.pack_start(spacer, false, false, 0) if parent
		return spacer
	when :sep
		s = Gtk::Box.new(:horizontal, 0)
		s.set_size_request(o.fetch(:width, 10), -1)
		parent.pack_start(s, false, false, 0) if parent
		return s
	when :label
		lab = Gtk::Label.new(o.fetch(:text, ""))
		lab.set_xalign(o.fetch(:xalign, 0.0))
		lab.set_tooltip_text(o[:tip]) if o[:tip] && !o[:tip].to_s.empty?
		set_widget_width.call(lab, o[:width])
		parent.pack_start(lab, false, false, o.fetch(:pad, 0)) if parent
		return lab
	when :entry
		key = get_key.call(o[:var])
		box = Gtk::Box.new(:horizontal, o.fetch(:spacing, 6))
		lab = Gtk::Label.new(o.fetch(:label))
		lab.set_xalign(0.0)
		lab.set_tooltip_text(o[:tip]) if o[:tip] && !o[:tip].to_s.empty?
		set_widget_width.call(lab, o[:label_width]) if o[:label_width]
		ent = Gtk::Entry.new
		if o[:width_chars]
			ent.width_chars = o[:width_chars]
			ent.max_width_chars = o[:max_width_chars] || o[:width_chars]
		else
			set_widget_width.call(ent, o[:entry_width] || o[:width])
		end
		ent.hexpand = false
		ent.halign = :start
		raw = get_val.call(key)
		ent.text = (raw.nil? || raw.to_s.empty?) ? o.fetch(:default, "").to_s : raw.to_s
		ent.placeholder_text = o[:placeholder].to_s if o[:placeholder]
		@OSA_COM_ENTRY[key] = ent if key
		box.pack_start(lab, false, false, 0)
		box.pack_start(ent, false, false, 0)
		set_widget_width.call(box, o[:box_width] || o[:width]) if (o[:box_width] || o[:width])
		parent.pack_start(box, false, false, o.fetch(:pad, 0)) if parent
		return box
	when :check
		key = get_key.call(o[:var])
		cb = Gtk::CheckButton.new(o.fetch(:label))
		cb.tooltip_text = o[:tip] if o[:tip] && !o[:tip].to_s.empty?
		raw = get_val.call(key)
		cb.active = raw.nil? ? !!o.fetch(:default, false) : !!raw
		@OSA_COM_ENTRY[key] = cb if key
		cb.set_halign(:start)
		cb.set_hexpand(false)
		widget = cb
		if o[:cell_width]
			wrapper = Gtk::Box.new(:horizontal, 0)
			wrapper.set_size_request(o[:cell_width], -1)
			wrapper.set_halign(:start)
			wrapper.pack_start(cb, false, false, 0)
			widget = wrapper
		end
		if o[:group] && o[:col]
			g = o[:group].to_sym
			c = o[:col].to_i
			@_ui_sizegroups[g][c] ||= Gtk::SizeGroup.new(:horizontal)
			@_ui_sizegroups[g][c].add_widget(widget)
		end
		parent.pack_start(widget, false, false, o.fetch(:pad, 0)) if parent
		return widget
	when :check_box
		key = get_key.call(o[:var])
		cb = Gtk::CheckButton.new
		cb.tooltip_text = o[:tip] if o[:tip] && !o[:tip].to_s.empty?
		raw = get_val.call(key)
		cb.active = raw.nil? ? !!o.fetch(:default, false) : !!raw
		@OSA_COM_ENTRY[key] = cb if key
		cb.set_halign(:start)
		cb.set_hexpand(false)
		parent.pack_start(cb, false, false, o.fetch(:pad, 0)) if parent
		return cb
	when :spell
		r = ui(parent, :row, spacing: o.fetch(:spacing, 10))
		ui(r, :entry,
			label: o[:spell_label],
			tip: o[:spell_tip],
			var: o[:spell_var],
			width_chars: 4,
			entry_width: o.fetch(:spell_width, 50))
		ui(r, :entry,
			label: "Min Stam:",
			var: o[:stam_min_var],
			width_chars: 4,
			default: "0",
			entry_width: o.fetch(:stam_width, 50))
		ui(r, :entry,
			label: "Min Mana:",
			var: o[:mana_min_var],
			width_chars: 4,
			default: "0",
			entry_width: o.fetch(:mana_width, 50))
		ui(r, :entry,
			label: "Min Enemy:",
			var: o[:enemy_min_var],
			width_chars: 4,
			default: "1",
			entry_width: o.fetch(:enemy_min_width, 50))
		ui(r, :entry,
			label: "Max Enemy:",
			var: o[:enemy_max_var],
			width_chars: 4,
			default: "10",
			entry_width: o.fetch(:enemy_max_width, 50))
		ui(r, :check, label: "Warding", var: o[:ward_var])
		ui(r, :check, label: "Channel", var: o[:chan_var])
		ui(r, :check, label: "Evoke", var: o[:evoke_var])
		ui(r, :check, label: "Open", var: o[:open_var])
		return r
	when :attack
		r = ui(parent, :row, spacing: o.fetch(:spacing, 10))
		ui(r, :dropdown,
			label: o.fetch(:attack_label, "Attack:"),
			tip: o.fetch(:attack_tip, ""),
			var: o.fetch(:attack_var),
			options: o.fetch(:options),
			default_index: o.fetch(:default_index, "None"),
			combo_width: o.fetch(:attack_width, 520))
		ui(r, :entry,
			label: o.fetch(:stam_label, "Min Stam:"),
			tip: o.fetch(:stam_tip, ""),
			var: o.fetch(:stam_min_var),
			default: o.fetch(:stam_default, "0"),
			width_chars: o.fetch(:stam_chars, 4),
			entry_width: o.fetch(:stam_width, 50))
		ui(r, :entry,
			label: o.fetch(:mana_label, "Min Mana:"),
			tip: o.fetch(:mana_tip, ""),
			var: o.fetch(:mana_min_var),
			default: o.fetch(:mana_default, "0"),
			width_chars: o.fetch(:mana_chars, 4),
			entry_width: o.fetch(:mana_width, 50))
		ui(r, :entry,
			label: o.fetch(:enemy_min_label, "Min Enemy:"),
			tip: o.fetch(:enemy_min_tip, ""),
			var: o.fetch(:enemy_min_var),
			default: o.fetch(:enemy_min_default, "1"),
			width_chars: o.fetch(:enemy_min_chars, 4),
			entry_width: o.fetch(:enemy_min_width, 50))
		ui(r, :entry,
			label: o.fetch(:enemy_max_label, "Max Enemy:"),
			tip: o.fetch(:enemy_max_tip, ""),
			var: o.fetch(:enemy_max_var),
			default: o.fetch(:enemy_max_default, "10"),
			width_chars: o.fetch(:enemy_max_chars, 4),
			entry_width: o.fetch(:enemy_max_width, 50))
			return r
	when :ability
		r = ui(parent, :row, spacing: o.fetch(:spacing, 10))
		label_w = o.fetch(:label_width, 175) # adjust once to taste
		ui(r, :label, text: o.fetch(:label), tip: o[:tip].to_s, width: label_w, xalign: 0.0)
		ui(r, :check_box,
			var: o.fetch(:var),
			tip: o[:tip].to_s,
			default: o.fetch(:default, false))
		ui(r, :sep, width: o.fetch(:sep_width, 12))
			fields = o.fetch(:fields, [])
			fields.each do |f|
				ui(r, :entry,
				label: f.fetch(:label),
				tip:   f[:tip].to_s,
				var:   f.fetch(:var),
				default: f.fetch(:default, ""),
				width_chars: f[:chars] || o[:chars] || 4,
				max_width_chars: f[:max_chars] || f[:chars] || o[:chars] || 4,
				entry_width: f[:entry_width] || o[:entry_width] || 90,
				label_width: f[:label_width] || o[:label_width])
			end
		return r
	when :dropdown
		label = Gtk::Label.new(o[:label])
		label.set_xalign(0)
		parent.pack_start(label, false, false, 5)
		combo = Gtk::ComboBoxText.new
		o[:options].split(',').each { |opt| 
			combo.append(opt, opt) 
			}
			val = get_val.call(get_key.call(o[:var]))
			if val && val.is_a?(String) && !val.empty?
				combo.set_active_id(val)
			else
				combo.set_active(0)
			end
			combo.set_size_request(o[:combo_width], -1) if o[:combo_width]
			@OSA_COM_ENTRY[o[:var]] = combo
			parent.pack_start(combo, false, false, 0)
		end
end

# save_settings! defined below

# ===== population =====

def self.toast(msg)
	respond "--- OSACombat: #{msg}"
end

def self.profiles_dir
	File.join(DATA_DIR, XMLData.game, Char.name, "osacombat profiles")
end

def self.profile_path(name)
	File.join(profiles_dir, "#{name}.yaml")
end

def self.list_profiles
	FileUtils.mkdir_p(profiles_dir)
	Dir.glob(File.join(profiles_dir, "*.yaml")).map { |f| File.basename(f, ".yaml") }.sort
rescue StandardError
	[]
end

def self.save_profile(name)
	FileUtils.mkdir_p(profiles_dir)
	File.write(profile_path(name), YAML.dump(@combat_data))
	respond "--- OSACombat: Profile saved: #{name}"
rescue StandardError => e
	respond "--- OSACombat: Save failed: #{e.message}\n#{e.backtrace.first(3).join('\n')}"
end

def self.load_profile(name)
	path = profile_path(name)
	return unless File.exist?(path)
	raw  = File.read(path)
	data = YAML.safe_load(raw, permitted_classes: [Time, Symbol], aliases: true) || {}
	@combat_data = data.transform_keys(&:to_s)
	File.write(@osa_yaml_file, YAML.dump(@combat_data)) if @osa_yaml_file
	respond "--- OSACombat: Profile loaded: #{name}"
rescue StandardError => e
	respond "--- OSACombat: Load failed: #{e.message}"
end

def self.delete_profile(name)
	File.delete(profile_path(name)) if File.exist?(profile_path(name))
	respond "--- OSACombat: Profile deleted: #{name}"
rescue StandardError => e
	respond "--- OSACombat: Delete failed: #{e.message}"
end

def self.refresh_widgets
	return unless @OSA_COM_ENTRY && @OSA_COM_WINDOW
	@OSA_COM_ENTRY.each do |var, widget|
		value = @combat_data[var.to_s]
		next if value.nil?
		begin
			if widget.is_a?(Gtk::CheckButton)
				widget.active = value ? true : false
			elsif widget.is_a?(Gtk::Entry)
				widget.text = value.to_s
			elsif widget.is_a?(Gtk::ComboBoxText)
				# Find matching text in dropdown and select it
				found = false
				widget.model.each do |model, path, iter|
					if iter[0].to_s == value.to_s
						widget.set_active_iter(iter)
						found = true
						break
					end
				end
				widget.active = 0 unless found
			end
		rescue StandardError => e
			respond "--- OSACombat refresh_widgets error on #{var}: #{e.message}"
			next
		end
	end
end



def self.populate_general(rows)
	ui(rows, :header, text: "Combat Settings")
	row = ui(rows, :row)
	ui(row, :entry, label: "Mana Leech Threshold:", tip: 'Will use "Mana Leech" when your mana percentage drops below this number. Default setting is 50.', var: 'percentleech', default: "50", width_chars: 4, label_width: 180)
	row = ui(rows, :row)
	ui(row, :entry, label: "Wound Threshold:", tip: 'When you recieve any wounds above the level indicated, you will seek healing from your "Medical Officer" (if present) or default to your herbkit via "Eherbs" script. 0 will seek healing from ALL wounds. 3 will not seek healing from any wounds. Default setting is 0', var: 'wound_level', width_chars: 4, default: "0", label_width: 180)
	row = ui(rows, :row)
	ui(row, :entry, label: "Mana Request Cooldown:", tip: "How many seconds must pass before the script will request mana from the crew channel again. Prevents spamming the crew channel when mana is low. Default is 90 seconds.", var: 'mana_share_cooldown', width_chars: 4, default: "90", label_width: 180)
	row = ui(rows, :row)
	ui(row, :entry, label: "Safe Room:", tip: "Will run to this room before the seeking healing process. Defaults to your current room.", var: 'safe_room', width_chars: 8, default: nil, label_width: 180)
	row = ui(rows, :row)
	ui(row, :entry, label: "UAC Hand Wraps:", tip: "The noun of your UAC hand wraps. Used in Blessing routines.", var: 'uachands', width_chars: 8, default: "", label_width: 180)
	row = ui(rows, :row)
	ui(row, :entry, label: "UAC Foot Wraps:", tip: "The noun of your UAC foot wraps. Used in Blessing routines.", var: 'uacfeet', width_chars: 8, default: "", label_width: 180)
	row = ui(rows, :row)
	ui(row, :entry, label: "Paladin Infuse Spell:", tip: "Enter the spell number for what spell infused in your weapon.", var: 'infusespell', width_chars: 8, default: "", label_width: 180)
	ui(row, :label, text: "Beseech Ignite:", tip: "After girding, beseeches your right hand weapon to ignite. Only activates if Beseech (Ignite) buff is not already active.")
	ui(row, :check_box, var: 'beseech_ignite', tip: "After girding, beseeches your right hand weapon to ignite. Only activates if Beseech (Ignite) buff is not already active.", default: false)
	ui(row, :label, text: "Beseech Conserve:", tip: "After girding, beseeches your right hand weapon to conserve. Only activates if Beseech (Conserve) buff is not already active.")
	ui(row, :check_box, var: 'beseech_conserve', tip: "After girding, beseeches your right hand weapon to conserve. Only activates if Beseech (Conserve) buff is not already active.", default: false)
	if Char.name == "Peggyanne"
		row = ui(rows, :row)
		ui(row, :entry, label: "Percent Chance For Personalized Attack Messaging:", tip: "", var: 'cheeseball', default: "", width_chars: 4, label_width: 180)
	end
	row = ui(rows, :row)
	ui(row, :dropdown, label: "Stealth Disabler:", tip: "If a hidden pirate is detected in your room you will use the following method to attempt to remove them from hiding. Also works for Kiramon Stalkers in The Hive. Requires OSACrew for monitoring.", var: 'stealth_disabler', options: "Search (Default), Dispel Invisibility, Searing Light, Light, Censure, Divine Wrath, Elemental Wave, Major Elemental Wave, Cone of Elements, Sunburst, Nature's Fury, Grasp of the Grave, Implosion, Tremors, Call Wind, Aura of the Arkati, Judgement, Eviscerate, Carn's Cry (Open), Symbol of Sleep", label_width: 220, combo_width: 220, default_index: 0)
	ui(rows, :blank, height: 8)
	add_checks = lambda do |defs, cols: 4, group: :general_checks, spacing: 18|
		defs.each_slice(cols).with_index do |slice, _row_i|
			r = ui(rows, :row, spacing: spacing)
			slice.each_with_index do |d, col|
				ui(r, :check,
				label: d[:label],
				tip: d[:tip].to_s,
				var: d[:var],
				default: d.fetch(:default, false),
				group: group,
				col: col)
			end
		end
	end
	add_checks.call([
    { label: "Scripted Combat", tip: "Click to enable OSACrew to start OSACombat Automatically when an enemy ship is detected.", var: 'osacombat'},
    { label: "Enable Mana Leech", tip: 'Click to enable automatic use of "Mana Leech" spell. Requires minimum mana stetting above.', var: 'use_mana_leech' },
    { label: "Enable Stance Dancing", tip: "Click to enable switching your stance in between attacks. This is defined in the Living and Undead tab.", var: 'stance_dance' }], cols: 3)
	add_checks.call([
    { label: "Use Gird and Store", tip: 'When checked, osacombat will store your weapon(s) and shield on startup then draw them via "Gird" before combat begins. On script stop it will store them again. Uncheck for barehanded UAC or if you manage your own weapons.', var: 'use_gird_and_store', default: true },
    { label: "Enable Brief Combat", tip: 'Click to enable use of "Flag Combatbrief" and "Flag Combatnonumbers"', var: 'usebriefcombat' },
    { label: "Enable Reactive Attacks", tip: 'Click to enable automatic use of reactive attacks. The script will automatically detect and execute reactive opportunities as they arise.', var: 'use_reactive' }], cols: 3)
	add_checks.call([
    { label: "Enable Anti-Poaching", tip: 'Click to enable automatic group status monitoring to avoid attacking when non-group PCs are present. This requires OSACrew to handle monitoring.', var: 'check_for_group'},
    { label: "Enable Looting", tip: 'Click to enable automatic use of looting. Requires "Eloot" script.', var: 'osalooter' },
    { label: "Wait For Room Clear Before Looting", tip: 'When checked, eloot will only run after all living hostile enemies have left the room. Uncheck to allow looting while enemies are still present.', var: 'eloot_wait_for_clear', default: true }], cols: 3)
	add_checks.call([
    { label: "Enable Skinning Only", tip: 'Click to disable looting. This will only send the command, "Eloot Skin".', var: 'skin_only'},
    { label: "Disable Looting When Gemstone Is Found.", tip: 'Click to enable automatic disabling of Looting when you have found your weekly gemstone or when you have found all three for the month. Requires "Killtracker" script.', var: 'usekilltracker' }], cols: 3)
	ui(rows, :blank, height: 10)
	ui(rows, :header, text: "Profiles:")
	ui(rows, :blank, height: 6)
	# Row 1: existing profiles - Load and Delete
	profile_row1 = ui(rows, :row)
	@profile_combo = Gtk::ComboBoxText.new
	list_profiles.each { |p| @profile_combo.append_text(p) }
	@profile_combo.active = 0 unless list_profiles.empty?
	profile_row1.pack_start(@profile_combo, true, true, 4)
	profile_load_btn = Gtk::Button.new(label: "Load")
	profile_load_btn.signal_connect("clicked") do
		name = @profile_combo.active_text
		next unless name && !name.empty?
		load_profile(name)
		refresh_widgets
	end
	profile_row1.pack_start(profile_load_btn, false, false, 2)
	profile_save_btn = Gtk::Button.new(label: "Save")
	profile_save_btn.signal_connect("clicked") do
		name = @profile_combo.active_text
		next unless name && !name.empty?
		save_settings!
		save_profile(name)
	end
	profile_row1.pack_start(profile_save_btn, false, false, 2)
	profile_del_btn = Gtk::Button.new(label: "Delete")
	profile_del_btn.signal_connect("clicked") do
		name = @profile_combo.active_text
		next unless name && !name.empty?
		delete_profile(name)
		@profile_combo.remove_all
		list_profiles.each { |p| @profile_combo.append_text(p) }
		@profile_combo.active = 0 unless list_profiles.empty?
	end
	profile_row1.pack_start(profile_del_btn, false, false, 2)
	ui(rows, :blank, height: 4)
	# Row 2: Save As - type name and save
	profile_row2 = ui(rows, :row)
	@profile_name_entry = Gtk::Entry.new
	@profile_name_entry.placeholder_text = "New profile name..."
	profile_row2.pack_start(@profile_name_entry, true, true, 4)
	save_as_btn = Gtk::Button.new(label: "Save As")
	save_as_btn.signal_connect("clicked") do
		name = @profile_name_entry.text.strip
		next if name.empty?
		begin
			save_settings!
			save_profile(name)
			@profile_name_entry.text = ""
			@profile_combo.remove_all
			list_profiles.each { |p| @profile_combo.append_text(p) }
			@profile_combo.active = list_profiles.index(name) || 0
		rescue StandardError => e
			respond "--- OSACombat: Save As failed: #{e.message}"
		end
	end
	profile_row2.pack_start(save_as_btn, false, false, 2)
end


def self.populate_support(rows)
	add_checks = lambda do |defs, cols: 4, group: :general_checks, spacing: 18|
		defs.each_slice(cols).with_index do |slice, _row_i|
			r = ui(rows, :row, spacing: spacing)
			slice.each_with_index do |d, col|
				ui(r, :check,
				label: d[:label],
				tip: d[:tip].to_s,
				var: d[:var],
				default: d.fetch(:default, false),
				group: group,
				col: col)
			end
		end
	end
	ui(rows, :blank, height: 10)
	ui(rows, :header, text: "Society:")
	ui(rows, :blank, height: 6)
	head = ui(rows, :row, spacing: 40)
	ui(head, :label, text: "Council of Light", xalign: 0.0, width: 220)
	ui(head, :label, text: "Guardians of Sunfist", xalign: 0.0, width: 155)
	ui(head, :label, text: "Order of Voln", xalign: 0.0, width: 220)
	ui(rows, :blank, height: 6)
	add_checks.call([
    { label: "Sign of Warding", tip: "+5 to DS. (Cost: 1 mana)", var: 'sign_of_warding' },
    { label: "Sigil of Minor Bane", tip: "Adds +5 AS. Also grants heavy damage weighting to melee, ranged and bolt attacks against hated foes. (Cost: 3 mana, 3 stamina)", var: 'sigil_of_minor_bane' },
    { label: "Symbol of Courage", tip: "Increases member's Attack Strength +1 per rank (Max bonus +26). Duration of 10 seconds per rank (stackable). Fear based attack protection.", var: 'symbol_of_courage'}], cols: 3)
	add_checks.call([
    { label: "Sign of Defending", tip: "+10 to DS. (Cost: 2 mana)", var: 'sign_of_defending' },
    { label: "Sigil of Offense", tip: "Provides a bonus to AS equal to current rank. (Cost: 5 mana, 5 stamina)", var: 'sigil_of_offense' },
    { label: "Symbol of Protection", tip: "Increases member's Defensive Strength +1 per rank (Max bonus +26). Duration of 20 seconds per rank. Protection also adds a TD boost of 1/2 total ranks. (Max bonus +13) (stackable).", var: 'symbol_of_protection'}], cols: 3)
	add_checks.call([
    { label: "Sign of Deflection", tip: "Adds +20 to Bolt DS. (Cost: 3 mana, 0 spirit)", var: 'sign_of_deflection' },
    { label: "Sigil of Major Bane", tip: "Adds +10 AS. Also grants heavy crit weighting to melee, ranged and bolt attacks against hated foes. (Cost: 10 mana, 10 stamina)", var: 'sigil_of_major_bane' },
    { label: "Symbol of Disruption", tip: "Casts an aura around user and group members. Any noncorporeal undead struck will sustain penalties to AS/DS,CS/TD,UDF, CMAN. Duration: 10 seconds per rank - (stackable).", var: 'symbol_of_disruption'}], cols: 3)
	add_checks.call([
    { label: "Sign of Shields", tip: "Adds +20 to DS. (Cost: 1 spirit)", var: 'sign_of_shields' },
    { label: "Sigil of Minor Protection", tip: "Provides +5 DS. Also grants heavy damage padding against attacks from hated foes. (Cost: 5 mana, 10 stamina)", var: 'sigil_of_minor_protection' },
    { label: "Symbol of Mana", tip: "Restores 50 mana. Initially, no deed cost. 5 minute cooldown period.", var: 'symbol_of_mana'}], cols: 3)
	add_checks.call([
    { label: "Sign of Striking", tip: "+5 to AS. (Cost: 1 mana)", var: 'sign_of_striking' },
    { label: "Sigil of Defense", tip: "Provides a bonus to DS equal to current rank. (Cost: 5 mana, 5 stamina)", var: 'sigil_of_defense' },
    { label: "Symbol of Retribution", tip: "Direct attack against undead when member is deceased. When used while living (self-cast version) will reactively flare if struck by an undead creature. Uses the standard success resolution system.", var: 'symbol_of_retribution'}], cols: 3)
	add_checks.call([
    { label: "Sign of Smiting", tip: "+10 to AS. (Cost: 2 mana)", var: 'sign_of_smiting' },
    { label: "Sigil of Major Protection", tip: "Adds +10 DS. Also grants heavy critical padding against attacks from hated foes. (Cost: 10 mana, 15 stamina)", var: 'sigil_of_major_protection' },
    { label: "Symbol of Supremacy", tip: "Bonus of +1 per two Voln ranks to AS/CS,CMAN, UAF against undead creatures. Duration: 10 seconds per rank - (stackable).", var: 'symbol_of_supremacy'}], cols: 3)
	add_checks.call([
    { label: "Sign of Swords", tip: "Adds +20 to AS. (Cost: 1 spirit)", var: 'sign_of_swords' },
    { label: "Sigil of Concentration", tip: "+5 mana per pulse. (Cost: 30 stamina)", var: 'sigil_of_concentration' },
    { label: "Symbol of Restoration", tip: "Returns up to half of a members health point loss. Minimum +10/Maximum +50 HP recovery per use.", var: 'symbol_of_restore'}], cols: 3)
	add_checks.call([
    { label: "Sign of Dissipation", tip: "Adds +15 to TD. Costs 1 spirit when sign dissipates. Gated by Minimum Spirit (Dissipating Signs) in Support Options.", var: 'sign_of_dissipation' },
    { label: "Sigil of Power", tip: "Converts 50 stamina into 25 mana.", var: 'sigil_of_power' },
    { label: "Symbol of Transcendence", tip: "For 30 seconds member will take damage as if in an incorporeal state. 3 minute cooldown period / 10 minutes if used in emergency.", var: 'symbol_of_transcendance'}], cols: 3)
	add_checks.call([
    { label: "Sign of Wracking", tip: "Fully regenerates all mana. Costs 5 spirit. Only fires when mana drops below CoL Mana Threshold (%) in Support Options AND spirit is safely above half max spirit. Characters with max spirit 10 or below cannot safely use this sign.", var: 'sign_of_wracking'}], cols: 1)
	ui(rows, :header, text: "Buffs:")
	ui(rows, :blank, height: 6)
	add_checks.call([
    { label: "Seanette's Shout", tip: 'Seanette\'s Shout is a supporting war cry that invigorates the warrior and their party and encourages them to strengthen their efforts for 25 stamina. The warrior and all party members are Empowered for a bonus of 20 to all AS attacks.', var: 'warcry_shout' },
    { label: "Horland's Holler", tip: 'Horland\'s Holler is a room taunt that lasts for a duration based on Influence bonus. Any attacks made in the room have a chance to be redirected back to the warrior. Success of a redirect is based on Multi Opponent Combat training and the Influence bonus of the warrior. In addition, Holler provides the Warrior and Warrior\'s party with a short term Boost Health (20). The success of the taunt is based on the Standard success resolution system, and attackers gain a bonus for every attempt made.', var: 'warcry_holler' },
    { label: "Surge of Strength (Use Cooldown)", tip: 'Surge of Strength is a commonly used Combat Maneuver due to the strength increase that it provides, increasing a character\'s attack strength and increasing carrying capacity, effectively reducing encumbrance and, therefore, possibly roundtime when attacking. Each bonus point will increase unencumbered carrying capacity 1% of the character\'s body weight with a maximum bonus of 16% at Rank 5. E.g., a character that weighs 200 lbs. with Rank 5 will have an increased carrying capacity of 32 lbs. (200 * .16). Because its effects are treated as an enhancive, it is subject to normal enhancive limits; thus additional ranks of Surge of Strength may net no further bonuses depending on a character\'s existing Strength enhancives (including spells such as Holy Weapon (1625)).', var: 'cman_surge_of_strength_cooldown'}], cols: 3)
	add_checks.call([
    { label: "Surge of Strength (Ignore Cooldown)", tip: 'Surge of Strength is a commonly used Combat Maneuver due to the strength increase that it provides, increasing a character\'s attack strength and increasing carrying capacity, effectively reducing encumbrance and, therefore, possibly roundtime when attacking. Each bonus point will increase unencumbered carrying capacity 1% of the character\'s body weight with a maximum bonus of 16% at Rank 5. E.g., a character that weighs 200 lbs. with Rank 5 will have an increased carrying capacity of 32 lbs. (200 * .16). Because its effects are treated as an enhancive, it is subject to normal enhancive limits; thus additional ranks of Surge of Strength may net no further bonuses depending on a character\'s existing Strength enhancives (including spells such as Holy Weapon (1625)).', var: 'cman_surge_of_strength_no_cooldown' },
    { label: "Wall of Force (140)", tip: 'Wall of Force creates a temporary wall of force that strongly resists attacks. The wall will follow the subject and position itself to fend off attacks while letting outgoing attacks pass without penalty. This spell bestows a +100 to the target\'s Defensive Strength (DS). Wall of Force has a 270 second cooldown per target, beginning when the spell is cast. It is exempt from spell-removing mechanics.', var: 'wallofforce' },
    { label: "Group Bravery (211)", tip: 'Bravery provides a base bonus of +15 to both physical attack strength, and bolt attack strength. The caster also gains 3 phantom levels against sheer fear attacks. Note: This requires 25 ranks of Spiritual Lore, Blessings.', var: 'groupbravery'}], cols: 3)
	add_checks.call([
    { label: "Group Heroism (215)", tip: 'Heroism provides a base bonus of +25 to both physical attack strength, and bolt attack strength and +1 regeneration to both mana (MP) and health point (HP) every minute. The caster also gains 3 phantom levels against sheer fear attacks and an increase to the user\'s defense against a standard maneuver roll if the maneuver is able to be evaded. Note: This requires 35 ranks of Spiritual Lore, Blessings.', var: 'spell_heroism' },
    { label: "Group Spell Shield (219)", tip: 'Spell Shield (219) provides +30 bolt DS and +30 spiritual TD. The group version is triggered via EVOKE and has a 120 second duration with a 360 second cooldown per target. Requires 50 ranks of Spiritual Lore, Blessings. The EVOKEd version is exempt from spell-removing effects.', var: 'spell_group_spell_shield' },
    { label: "Sanctify Right Hand (330)", tip: 'This will apply Holy Fire flares and non-corporeal undead anchoring to the item in your right hand. This enhancement, does not apply any of the other 330 benefits, and lasts for 4 hours. At 90 and 180 ranks of Spiritual Lore, Religion clerics gain an extra charge of a Holy Fire flare that is guaranteed to trigger on their next attack.', var: 'sanctrighthand' }], cols: 3)
	add_checks.call([
    { label: "Sanctify Left Hand (330)", tip: 'This will apply Holy Fire flares and non-corporeal undead anchoring to the item in your left hand. This enhancement, does not apply any of the other 330 benefits, and lasts for 4 hours. At 90 and 180 ranks of Spiritual Lore, Religion clerics gain an extra charge of a Holy Fire flare that is guaranteed to trigger on their next attack.', var: 'sanctlefthand' },
    { label: "Mana Focus (418)", tip: 'Mana Focus provides mana regeneration to the caster and their group. Pulse rate and regeneration amount scale with training. Cast untargeted.', var: 'cast_spell_mana_focus' },
    { label: "Celerity (506)", tip: 'Celerity reduces the stamina cost, possibly to zero, for all Quickstrike actions that reduce combat roundtimes (see QUICKSTRIKE for a full listing). It has a non-stackable 60 second duration. If not natively self-cast, there is a four minute period starting at the time of first application during which Celerity may not be re-applied to the same target. There is no such delay when the spell is natively self-cast. All offensive combat actions automatically apply the lowest RT possible whether or not the Quickstrike ability is explicitly invoked. Users of Celerity need not use Quickstrike to gain the maximum zero-stamina RT reduction, or may use Quickstrike to gain additional RT reduction at a lesser stamina cost than would otherwise be the case.', var: 'cast_spell_self_celerity' }], cols: 3)
	add_checks.call([
    { label: "Group Celerity (506)", tip: 'Celerity reduces the stamina cost, possibly to zero, for all Quickstrike actions that reduce combat roundtimes (see QUICKSTRIKE for a full listing). It has a non-stackable 60 second duration. If not natively self-cast, there is a four minute period starting at the time of first application during which Celerity may not be re-applied to the same target. There is no such delay when the spell is natively self-cast. All offensive combat actions automatically apply the lowest RT possible whether or not the Quickstrike ability is explicitly invoked. Users of Celerity need not use Quickstrike to gain the maximum zero-stamina RT reduction, or may use Quickstrike to gain additional RT reduction at a lesser stamina cost than would otherwise be the case. Note: This requires 50 ranks of Elemental Lore, Air.', var: 'cast_spell_group_celerity' },
    { label: "Rapid Fire (515)", tip: 'While Rapid Fire is active, it will reduce the cast roundtime of all subsequent spells to 1 second. Once the effect ends, there is a short recovery period (i.e. cooldown) of 90 seconds before the spell can be used again without an extra penalty. If the spell is recast during the recovery period, all subsequent spells cast cost an additional 5 mana. Training in Elemental Mana Control will reduce the recovery period.', var: 'spell_rapid_fire' },
    { label: "Barkskin (605)", tip: 'Barkskin allows the Ranger to surround themselves with a thick layer of bark, which will absorb the next instance of a physical attack, SMRv2 maneuver, bolt spell, or warding spell that would have otherwise successfully struck them. On attacks that would have only moderately been successful, the bark has a 50 + (Spiritual Lore, Blessings ranks / 2) % chance of enduring. Moderate success is defined as a successful endroll threshold of no more than 20 + (Survival skill / 10). Barkskin has a five minute character-specific cooldown after successfully absorbing an effect during which that character may not gain Barkskin again.', var: 'barkskin_spell' }], cols: 3)
	add_checks.call([
    { label: "Group Barkskin (605)", tip: 'Barkskin allows the Ranger to surround themselves with a thick layer of bark, which will absorb the next instance of a physical attack, SMRv2 maneuver, bolt spell, or warding spell that would have otherwise successfully struck them. On attacks that would have only moderately been successful, the bark has a 50 + (Spiritual Lore, Blessings ranks / 2) % chance of enduring. Moderate success is defined as a successful endroll threshold of no more than 20 + (Survival skill / 10). Barkskin has a five minute character-specific cooldown after successfully absorbing an effect during which that character may not gain Barkskin again. Note: This requires 50 ranks of Spiritual Lore, Blessings.', var: 'barkskin_spell_group' },
    { label: "Song of Tonis (1035)", tip: 'While singing this song, a Bard magically imparts all members of his or her party with additional speed, making all of their actions a bit quicker, and giving them an increased chance to dodge incoming attacks. Specifically, Song of Tonis increases the defensive equivalent of the group\'s Dodging skill by +20 ranks as well as adding a -1 second haste effect.', var: 'song_song_of_tonis' },
    { label: "Mind Over Body (1213)", tip: 'Mind over Body is a group focus spell which decreases stamina activation costs for the caster and group members. The base reduction is 20% and can be further increased with training in Mental Lore, Telepathy. The reduced cost from this spell applies to anything involving stamina usage: GoS sigils, combat maneuvers, warrior and rogue guild skills, etc. The spell will terminate when the caster dies or is sufficiently stunned. Group members who leave the group and the immediate room of the caster will lose the spell effect within approximately 60 seconds. A caster can maintain only one focus spell at a time.', var: 'mob' }], cols: 3)
	add_checks.call([
    { label: "Focus Barrier (1216)", tip: 'Focus Barrier is a group focus spell that provides the caster and member\'s of his group a +30 Defensive Strength (DS) bonus. The spell will terminate when the caster dies or is sufficiently stunned. Group members who leave the group and the immediate room of the caster will lose the spell effect within approximately 60 seconds. A caster can maintain only one focus spell at a time', var: 'focus' },
    { label: "Beacon of Courage (1608)", tip: 'The Beacon of Courage effect will redirect attacks made on the paladin\'s party members to the paladin. Any creature attacking a party member while this effect is active will be subject to hidden warding rolls and failing will redirect attacks for as long as the Beacon of Courage effect lasts. The effect also allows the Paladin to ignore Force on Force mechanics for at least one additional target, the number of targets increasing based on Spiritual Lore, Blessings.', var: 'spell_beacon_of_courage' },
    { label: "Faith Shield (1619)", tip: 'Provides a base benefit of +50 to Spiritual Target Defense (TD) for 30 seconds. The duration is extended +1 second for every two Paladin Base spell ranks known above rank 19. The maximum duration is 70 seconds at 99 Paladin Base spell ranks. Faith Shield has a 210 second cooldown.', var: 'spell_shield_faith' }], cols: 3)
	add_checks.call([
    { label: "Divine Incarnation: Armor (1650) Emergency Use", tip: 'This causes a holy armor to surround the paladin. This grants a 50% resistance to all forms of attack for 30 seconds.Training in Spiritual Lore, Blessings increases the resistance effect of Armor. Divine Incarnation does not need to be active in order to invoke an "emergency" usage of Armor.', var: 'di_armor' },
    { label: "Divine Incarnation: Zeal (1650)", tip: 'Zeal will cause a divine aura to surround the paladin and trigger deity specific flares upon the next 5 successful attacks made during the next 60 seconds. If time allows, additional flares may be triggered at a cost of 1 divine energy each. Training in Spiritual Lore, Summoning increases the duration of Zeal.', var: 'cast_spell_di_zeal' },
    { label: "Steely Resolve", tip: 'For 60 seconds, you gain +15 Block DS per rank and a +15% chance per rank to block incoming attacks. There a 5 minute recovery period after using this ability, where it cannot be re-invoked.', var: 'shield_steely'}], cols: 3)
	add_checks.call([
    { label: "Light Wings: Luminous Flight (T1)", tip: "Temporary flight, ignoring height restrictions for attacks. Lasts 30 seconds with a 90 second cooldown. While active, grants +5% evade chance per Tier. Activated via TAP.", var: 'wings_light_luminous_flight' },
    { label: "Light Wings: Prismatic Aegis (T2)", tip: "Grants Evasiveness for the next incoming attack for 10 seconds. 3 minute cooldown. Activated via PULL.", var: 'wings_light_prismatic_aegis' },
    { label: "Light Wings: Wings of Warding (T3)", tip: "Wings expand outward providing temporary protection for the player's group. +25 DS, +15 TD, and +10 critical padding for 30 seconds. 30 minute cooldown. Cannot stack with other wings. Activated via PUSH.", var: 'wings_light_wings_of_warding' }], cols: 3)
	add_checks.call([
    { label: "Dark Wings: Shadow Mantle (T1)", tip: "Wings fold inward, cloaking the wearer in shadows. Grants +5 per Tier in Stalking and Hiding ranks with a 90 second cooldown. While active, grants a +5 evade chance per tier. Activated via TAP.", var: 'wings_dark_shadow_mantle' },
    { label: "Dark Wings: Crawling Shadow (T2)", tip: "Grants Evasiveness for the next incoming attack for 10 seconds. SMR counter attack to cause Disease effect. 3 minute cooldown. Activated via PULL.", var: 'wings_dark_crawling_shadow' },
    { label: "Dark Wings: Carrion Guard (T3)", tip: "Draws health from wounds to nearby players or creatures. Temporarily grants +10 Damage Resistance/Padding, 5 HP regen, and +100 max HP for 60 seconds. 15 minute cooldown. Activated via PUSH.", var: 'wings_dark_carrion_guard' }], cols: 3)
	ui(rows, :blank, height: 10)
	ui(rows, :header, text: "Support Options:")
	ui(rows, :blank, height: 6)
	r_restore = ui(rows, :row)
	ui(r_restore, :entry, label: "Symbol of Restore Threshold:", tip: 'Will use "Symbol of Restore" when your health percentage drops below this number. Default setting is 65.', var: 'percent_health', width_chars: 4, default: "65", label_width: 200)
	ui(rows, :blank, height: 4)
	r_spirit = ui(rows, :row)
	ui(r_spirit, :entry, label: "Min Spirit (Dissipating Signs):", tip: "Minimum spirit required before using Sign of Dissipation, Sign of Swords, or Sign of Shields. These signs cost 1 spirit when they wear off. Leave 0 to auto-calculate: ceil(max_spirit/2) + 3. For a character with 10 max spirit the auto value is 8, meaning the sign will not be cast unless you have at least 8 spirit.", var: 'min_spirit_dissipating', width_chars: 4, default: "0", label_width: 200, placeholder: "0 = auto")
	ui(r_spirit, :entry, label: "CoL Mana Threshold (%):", tip: "Sign of Wracking will only fire when your mana drops below this percentage. Default 30%. The sign also requires spirit > ceil(max_spirit/2) + 5 to avoid obvious spirit drain. Characters with 10 or fewer max spirit can never safely use Sign of Wracking.", var: 'col_mana_threshold', width_chars: 4, default: "30", label_width: 200, placeholder: "30")
	ui(rows, :blank, height: 4)
	r_wings = ui(rows, :row)
	ui(r_wings, :entry, label: "Light Wings Pin:", tip: 'Enter the adjective and noun of your Light Energy "Pinions and Pulse" pin e.g. "silver pin". Used for Light Wings buff actions (tap/pull/push).', var: 'light_wings_pin_adj', width_chars: 10, default: "", label_width: 140, placeholder: "adjective")
	ui(r_wings, :entry, label: "", tip: 'Noun of your Light Wings pin.', var: 'light_wings_pin_noun', width_chars: 10, default: "", label_width: 10, placeholder: "noun")
	ui(r_wings, :entry, label: "Dark Wings Pin:", tip: 'Enter the adjective and noun of your Dark Energy "Pinions and Pulse" pin e.g. "obsidian pin". Used for Dark Wings buff actions (tap/pull/push).', var: 'dark_wings_pin_adj', width_chars: 10, default: "", label_width: 140, placeholder: "adjective")
	ui(r_wings, :entry, label: "", tip: 'Noun of your Dark Wings pin.', var: 'dark_wings_pin_noun', width_chars: 10, default: "", label_width: 10, placeholder: "noun")
	ui(rows, :blank, height: 4)
	add_checks.call([
    { label: "Cast Buffs Without Waiting For Enemy", tip: 'When checked, all support buffs (spells, songs, war cries, abilities) will cast immediately on script start rather than waiting for a live enemy to be present first. Buffs will still refresh normally after the first cast regardless of this setting.', var: 'buff_no_wait_for_mob', default: false },
    { label: "Enable Unstun", tip: 'Click to enable automatic use of the "Unstun" spell on PCs who are present and stunned.', var: 'use_unstun' },
    { label: "Bless Caster", tip: 'Click to enable casting "Bless" spell or "Symbol of Bless" on others when the commander calls for blessing the crew.', var: 'givebless' },
    { label: "Need Bless", tip: 'Click to indicate need for a blessing when the commander calls for one.', var: 'needbless'}], cols: 4)
end

def self.make_int_entry(box, label_text, val, width=6, tip: nil)
	lbl = Gtk::Label.new(label_text)
	lbl.xalign = 0.0
	lbl.tooltip_text = tip if tip
	ent = Gtk::Entry.new
	ent.text = val.to_s
	ent.set_width_chars(width)
	ent.tooltip_text = tip if tip
	box.pack_start(lbl, expand: false, fill: false, padding: 0)
	box.pack_start(ent, expand: false, fill: false, padding: 0)
	ent
end

def self.make_check(box, label_text, checked, tip: nil)
	cb = Gtk::CheckButton.new(label_text)
	cb.active = !!checked
	cb.tooltip_text = tip if tip
	box.pack_start(cb, expand: false, fill: false, padding: 0) if box.is_a?(Gtk::Box)
	cb
end

def self.refresh_living_routine_display(main_rows)
	container = @living_routine_container
	return unless container
	container.children.each { |c| container.remove(c) }
	routine = living_routine_load
	if routine.empty?
		lbl = Gtk::Label.new("No entries yet. Use the buttons below to build your routine.")
		lbl.xalign = 0.0
		container.pack_start(lbl, expand: false, fill: false, padding: 2)
	else
		routine.each_with_index do |entry, idx|
			frame = build_routine_entry_row(entry, idx, main_rows, :living)
			container.pack_start(frame, expand: false, fill: true, padding: 2)
		end
	end
	container.show_all
end

def self.refresh_undead_routine_display(main_rows)
	container = @undead_routine_container
	return unless container
	container.children.each { |c| container.remove(c) }
	routine = undead_routine_load
	if routine.empty?
		lbl = Gtk::Label.new("No entries yet. Use the buttons below to build your routine.")
		lbl.xalign = 0.0
		container.pack_start(lbl, expand: false, fill: false, padding: 2)
	else
		routine.each_with_index do |entry, idx|
			frame = build_routine_entry_row(entry, idx, main_rows, :undead)
			container.pack_start(frame, expand: false, fill: true, padding: 2)
		end
	end
	container.show_all
end

def self.build_routine_entry_row(entry, idx, main_rows, creature_type = :living)
	frame = Gtk::Frame.new
	frame.set_shadow_type(:etched_in)
	vbox = Gtk::Box.new(:vertical, 2)
	vbox.set_border_width(4)
	frame.add(vbox)

	kind_label = entry['kind'] == 'attack' ? "Attack" : "Spell"
	type_label = entry['type'].to_s.empty? ? "(none)" : entry['type']
	l1 = Gtk::Label.new("#{kind_label}: #{type_label}")
	l1.xalign = 0.0
	vbox.pack_start(l1, expand: false, fill: false, padding: 0)

	stance = entry['stance'].to_s.empty? ? "Default" : entry['stance']
	l2 = Gtk::Label.new("Stance: #{stance}")
	l2.xalign = 0.0
	vbox.pack_start(l2, expand: false, fill: false, padding: 0)

	char_parts = []
	char_parts << "Min Mana: #{entry['min_mana']}"    if entry['min_mana'].to_i > 0
	char_parts << "Max Mana: #{entry['max_mana']}"    if entry['max_mana'].to_i < 999
	char_parts << "Min Stamina: #{entry['min_stam']}" if entry['min_stam'].to_i > 0
	char_parts << "Max Stamina: #{entry['max_stam']}" if entry['max_stam'].to_i < 999
	unless char_parts.empty?
		l3 = Gtk::Label.new("Character Conditions: #{char_parts.join(",  ")}")
		l3.xalign = 0.0
		vbox.pack_start(l3, expand: false, fill: false, padding: 0)
	end

	tgt_parts = []
	tgt_parts << "Min Targets: #{entry['min_targets']}"   if entry['min_targets'].to_i > 1
	tgt_parts << "Max Targets: #{entry['max_targets']}"   if entry['max_targets'].to_i < 99
	tgt_parts << "Target Stunned"      if entry['tgt_stunned']
	tgt_parts << "Target Not Stunned"  if entry['tgt_not_stunned']
	tgt_parts << "Target Bound"        if entry['tgt_bound']
	tgt_parts << "Target Not Bound"    if entry['tgt_not_bound']
	tgt_parts << "Target Webbed"       if entry['tgt_webbed']
	tgt_parts << "Target Not Webbed"   if entry['tgt_not_webbed']
	tgt_parts << "Target Prone"        if entry['tgt_prone']
	tgt_parts << "Target Not Prone"    if entry['tgt_not_prone']
	tgt_parts << "Target Rooted"       if entry['tgt_rooted']
	tgt_parts << "Target Not Rooted"   if entry['tgt_not_rooted']
	tgt_parts << "Target Calmed"       if entry['tgt_calmed']
	tgt_parts << "Target Not Calmed"   if entry['tgt_not_calmed']
	tgt_parts << "Target Frozen"       if entry['tgt_frozen']
	tgt_parts << "Target Not Frozen"   if entry['tgt_not_frozen']
	unless tgt_parts.empty?
		l4 = Gtk::Label.new("Target Conditions: #{tgt_parts.join(",  ")}")
		l4.xalign = 0.0
		vbox.pack_start(l4, expand: false, fill: false, padding: 0)
	end

	if entry['kind'] == 'attack'
		opt_parts = []
		opt_parts << "Kneel"              if entry['use_kneel']
		opt_parts << "Stealth"            if entry['use_stealth']
		opt_parts << "Until Dead"         if entry['until_dead']
		opt_parts << "ForceRT"            if entry['use_forcert']
		opt_parts << "QStrike #{entry['quickstrike_value']}" if entry['use_quickstrike'] && !entry['quickstrike_value'].to_s.strip.empty?
		opt_parts << "Skip With Celerity" if entry['mstrike_skip_celerity']
		opt_parts << "UAC"                if entry['mstrike_uac']
		opt_parts << "Archery"            if entry['mstrike_archery']
		opt_parts << "Melee"              if entry['mstrike_melee']
		opt_parts << "Flare Gloves: #{entry['flare_gloves_adj']} #{entry['flare_gloves_noun']}".strip if !entry['flare_gloves_noun'].to_s.empty?
		opt_parts << "Wings Pin: #{entry['wings_pin_adj']} #{entry['wings_pin_noun']}".strip if !entry['wings_pin_noun'].to_s.empty?
		unless opt_parts.empty?
			l5 = Gtk::Label.new("Options: #{opt_parts.join(",  ")}")
			l5.xalign = 0.0
			vbox.pack_start(l5, expand: false, fill: false, padding: 0)
		end
	end

	if entry['kind'] == 'spell'
		spl_parts = []
		spl_parts << "Cast Type: #{entry['cast_type']}" unless entry['cast_type'].to_s.empty?
		spl_parts << "Warding"    if entry['warding']
		spl_parts << "Open Cast"  if entry['open_cast']
		spl_parts << "Until Dead" if entry['until_dead']
		spl_parts << "Use Stomp"  if entry['use_stomp']
		spl_parts << "Use Tap"    if entry['use_tap']
		spl_parts << "Use Pound"  if entry['use_pound']
		unless spl_parts.empty?
			ls = Gtk::Label.new("Spell Options: #{spl_parts.join(",  ")}")
			ls.xalign = 0.0
			vbox.pack_start(ls, expand: false, fill: false, padding: 0)
		end
	end

	unless entry['only_use_on'].to_s.strip.empty?
		lc = Gtk::Label.new("Only Use On: #{entry['only_use_on']}")
		lc.xalign = 0.0
		vbox.pack_start(lc, expand: false, fill: false, padding: 0)
	end
	unless entry['do_not_use_on'].to_s.strip.empty?
		lc2 = Gtk::Label.new("Do Not Use On: #{entry['do_not_use_on']}")
		lc2.xalign = 0.0
		vbox.pack_start(lc2, expand: false, fill: false, padding: 0)
	end

	btn_row = Gtk::Box.new(:horizontal, 6)
	vbox.pack_start(btn_row, expand: false, fill: false, padding: 2)

	edit_btn  = Gtk::Button.new(label: "Edit")
	del_btn   = Gtk::Button.new(label: "Delete")
	up_btn    = Gtk::Button.new(label: "Move Up")
	down_btn  = Gtk::Button.new(label: "Move Down")

	$_osa_gc ||= []

	h_edit = proc { open_living_entry_dialog(main_rows, idx, entry['kind'], creature_type) }
	$_osa_gc << h_edit
	edit_btn.signal_connect("clicked", &h_edit)

	h_del = proc do
		routine = creature_type == :undead ? undead_routine_load : living_routine_load
		routine.delete_at(idx)
		creature_type == :undead ? undead_routine_save(routine) : living_routine_save(routine)
		GLib::Idle.add { creature_type == :undead ? refresh_undead_routine_display(main_rows) : refresh_living_routine_display(main_rows); false }
	end
	$_osa_gc << h_del
	del_btn.signal_connect("clicked", &h_del)

	h_up = proc do
		routine = creature_type == :undead ? undead_routine_load : living_routine_load
		if idx > 0
			routine[idx], routine[idx-1] = routine[idx-1], routine[idx]
			creature_type == :undead ? undead_routine_save(routine) : living_routine_save(routine)
			GLib::Idle.add { creature_type == :undead ? refresh_undead_routine_display(main_rows) : refresh_living_routine_display(main_rows); false }
		end
	end
	$_osa_gc << h_up
	up_btn.signal_connect("clicked", &h_up)

	h_down = proc do
		routine = creature_type == :undead ? undead_routine_load : living_routine_load
		if idx < routine.length - 1
			routine[idx], routine[idx+1] = routine[idx+1], routine[idx]
			creature_type == :undead ? undead_routine_save(routine) : living_routine_save(routine)
			GLib::Idle.add { creature_type == :undead ? refresh_undead_routine_display(main_rows) : refresh_living_routine_display(main_rows); false }
		end
	end
	$_osa_gc << h_down
	down_btn.signal_connect("clicked", &h_down)

	[edit_btn, del_btn, up_btn, down_btn].each { |b| btn_row.pack_start(b, expand: false, fill: false, padding: 0) }

	frame
end

def self.open_living_entry_dialog(main_rows, edit_idx, kind, creature_type = :living)
	routine = creature_type == :undead ? undead_routine_load : living_routine_load
	entry = edit_idx.nil? ? living_routine_default_entry(kind) : routine[edit_idx].dup

	win = Gtk::Window.new(:toplevel)
	type_label = creature_type == :undead ? "Undead " : ""
	win.set_title(edit_idx.nil? ? "Add #{type_label}#{kind.capitalize}" : "Edit #{type_label}#{kind.capitalize}")
	win.set_default_size(680, -1)
	win.set_resizable(false)
	win.set_window_position(:center)
	$_osa_entry_dialog_gc = []

	vbox = Gtk::Box.new(:vertical, 8)
	vbox.set_border_width(12)
	win.add(vbox)

	# --- Type field ---
	type_row = Gtk::Box.new(:horizontal, 8)
	vbox.pack_start(type_row, expand: false, fill: false, padding: 0)

	if kind == 'attack'
		type_label_w = Gtk::Label.new("Attack:")
		type_label_w.xalign = 0.0
		type_label_w.set_size_request(120, -1)
		type_row.pack_start(type_label_w, expand: false, fill: false, padding: 0)
		type_combo = Gtk::ComboBoxText.new
		LIVING_ATTACK_OPTIONS.each { |o| type_combo.append_text(o) }
		cur_idx = LIVING_ATTACK_OPTIONS.index(entry['type']) || 0
		type_combo.active = cur_idx
		type_row.pack_start(type_combo, expand: true, fill: true, padding: 0)
	else
		type_label_w = Gtk::Label.new("Spell Number:")
		type_label_w.xalign = 0.0
		type_label_w.set_size_request(120, -1)
		type_row.pack_start(type_label_w, expand: false, fill: false, padding: 0)
		type_entry = Gtk::Entry.new
		type_entry.text = entry['type'].to_s
		type_entry.set_width_chars(10)
		type_row.pack_start(type_entry, expand: false, fill: false, padding: 0)
	end

	# --- Stance ---
	stance_row = Gtk::Box.new(:horizontal, 8)
	vbox.pack_start(stance_row, expand: false, fill: false, padding: 0)
	stance_lbl = Gtk::Label.new("Stance:")
	stance_lbl.xalign = 0.0
	stance_lbl.set_size_request(120, -1)
	stance_lbl.tooltip_text = "Select the stance to use for this entry. Default uses the tab-level stance setting. Offensive boosts AS at the cost of DS."
	stance_row.pack_start(stance_lbl, expand: false, fill: false, padding: 0)
	stance_combo = Gtk::ComboBoxText.new
	stance_combo.tooltip_text = "Default: use tab-level stance. Offensive/Advance for attacks that need AS. Guarded/Defensive for defensive casts."
	LIVING_STANCE_OPTIONS.each { |s| stance_combo.append_text(s) }
	cur_stance = entry['stance'].to_s.empty? ? "Default" : entry['stance']
	stance_combo.active = LIVING_STANCE_OPTIONS.index(cur_stance) || 0
	stance_row.pack_start(stance_combo, expand: false, fill: false, padding: 0)

	# --- Character Conditions ---
	sep1 = Gtk::Separator.new(:horizontal)
	vbox.pack_start(sep1, expand: false, fill: true, padding: 2)
	char_lbl = Gtk::Label.new("Character Conditions:")
	char_lbl.xalign = 0.0
	char_lbl.tooltip_text = "These conditions are checked against your character's current stats before the entry fires. Leave at defaults to ignore."
	vbox.pack_start(char_lbl, expand: false, fill: false, padding: 0)

	char_row = Gtk::Box.new(:horizontal, 12)
	vbox.pack_start(char_row, expand: false, fill: false, padding: 0)

	min_mana_ent  = make_int_entry(char_row, "Min Mana:",    entry['min_mana'],  tip: "Only use this entry when your current mana is at or above this value. 0 = no minimum.")
	max_mana_ent  = make_int_entry(char_row, "Max Mana:",    entry['max_mana'],  tip: "Only use this entry when your current mana is at or below this value. 999 = no maximum.")
	min_stam_ent  = make_int_entry(char_row, "Min Stamina:", entry['min_stam'],  tip: "Only use this entry when your current stamina is at or above this value. 0 = no minimum.")
	max_stam_ent  = make_int_entry(char_row, "Max Stamina:", entry['max_stam'],  tip: "Only use this entry when your current stamina is at or below this value. 999 = no maximum.")

	if kind == 'spell'
		char_action_row = Gtk::Box.new(:horizontal, 12)
		vbox.pack_start(char_action_row, expand: false, fill: false, padding: 0)
		char_action_lbl = Gtk::Label.new("Tremors (909):")
		char_action_lbl.xalign = 0.0
		char_action_lbl.tooltip_text = "Only applies when this spell is 909. Select which physical action to perform before casting: Stomp, Tap, or Pound. Leave unchecked if not using 909."
		char_action_row.pack_start(char_action_lbl, expand: false, fill: false, padding: 0)
		stomp_rb = Gtk::RadioButton.new(label: "Stomp")
		tap_rb   = Gtk::RadioButton.new(member: stomp_rb, label: "Tap")
		pound_rb = Gtk::RadioButton.new(member: stomp_rb, label: "Pound")
		if entry['use_stomp']
			stomp_rb.active = true
		elsif entry['use_pound']
			pound_rb.active = true
		elsif entry['use_tap']
			tap_rb.active = true
		else
			# None selected -- add a hidden radio to hold the group with nothing visible active
			none_rb = Gtk::RadioButton.new(member: stomp_rb)
			none_rb.active = true
			none_rb.visible = false
		end
		[stomp_rb, tap_rb, pound_rb].each { |rb| char_action_row.pack_start(rb, expand: false, fill: false, padding: 0) }
		tremors_widgets = [char_action_lbl, stomp_rb, tap_rb, pound_rb]
		update_tremors_sensitivity = proc {
			is_909 = type_entry.text.to_s.strip == "909"
			tremors_widgets.each { |w| w.sensitive = is_909 }
		}
		update_tremors_sensitivity.call
		h_type_changed = proc { update_tremors_sensitivity.call }
		$_osa_entry_dialog_gc << h_type_changed
		type_entry.signal_connect("changed", &h_type_changed)
	end

	# --- Target Conditions ---
	sep2 = Gtk::Separator.new(:horizontal)
	vbox.pack_start(sep2, expand: false, fill: true, padding: 2)
	tgt_lbl = Gtk::Label.new("Target Conditions:")
	tgt_lbl.xalign = 0.0
	tgt_lbl.tooltip_text = "These conditions are checked against the current target before the entry fires. Unchecked means don't care. Checking both a condition and its Not version means the entry never fires."
	vbox.pack_start(tgt_lbl, expand: false, fill: false, padding: 0)

	tgt_count_row = Gtk::Box.new(:horizontal, 12)
	vbox.pack_start(tgt_count_row, expand: false, fill: false, padding: 0)
	min_tgt_ent = make_int_entry(tgt_count_row, "Min Target Count:", entry['min_targets'], tip: "Only fire when at least this many targets are in the room. Default 1.")
	max_tgt_ent = make_int_entry(tgt_count_row, "Max Target Count:", entry['max_targets'], tip: "Only fire when no more than this many targets are in the room. Default 99 (no limit). Useful for single-target spells you don't want to waste on crowds.")

	tgt_grid = Gtk::Grid.new
	tgt_grid.column_spacing = 4
	tgt_grid.row_spacing    = 4
	vbox.pack_start(tgt_grid, expand: false, fill: false, padding: 0)

	stunned_cb     = make_check(tgt_grid, "Target Stunned",     entry['tgt_stunned'],     tip: "Only fire if the target is currently stunned.")
	not_stunned_cb = make_check(tgt_grid, "Target Not Stunned", entry['tgt_not_stunned'], tip: "Only fire if the target is NOT stunned. Useful for opening attacks before applying a stun.")
	bound_cb       = make_check(tgt_grid, "Target Bound",       entry['tgt_bound'],       tip: "Only fire if the target is currently bound.")
	not_bound_cb   = make_check(tgt_grid, "Target Not Bound",   entry['tgt_not_bound'],   tip: "Only fire if the target is NOT bound.")
	[stunned_cb, not_stunned_cb, bound_cb, not_bound_cb].each_with_index { |cb, col| cb.set_size_request(160, -1); tgt_grid.attach(cb, col, 0, 1, 1) }

	webbed_cb      = make_check(tgt_grid, "Target Webbed",     entry['tgt_webbed'],     tip: "Only fire if the target is currently webbed.")
	not_webbed_cb  = make_check(tgt_grid, "Target Not Webbed", entry['tgt_not_webbed'], tip: "Only fire if the target is NOT webbed.")
	prone_cb       = make_check(tgt_grid, "Target Prone",      entry['tgt_prone'],      tip: "Only fire if the target is lying prone. Useful for follow-up attacks on downed enemies.")
	not_prone_cb   = make_check(tgt_grid, "Target Not Prone",  entry['tgt_not_prone'],  tip: "Only fire if the target is NOT prone.")
	[webbed_cb, not_webbed_cb, prone_cb, not_prone_cb].each_with_index { |cb, col| cb.set_size_request(160, -1); tgt_grid.attach(cb, col, 1, 1, 1) }

	rooted_cb      = make_check(tgt_grid, "Target Rooted",     entry['tgt_rooted'],     tip: "Only fire if the target is currently rooted.")
	not_rooted_cb  = make_check(tgt_grid, "Target Not Rooted", entry['tgt_not_rooted'], tip: "Only fire if the target is NOT rooted.")
	calmed_cb      = make_check(tgt_grid, "Target Calmed",     entry['tgt_calmed'],     tip: "Only fire if the target is calmed.")
	not_calmed_cb  = make_check(tgt_grid, "Target Not Calmed", entry['tgt_not_calmed'], tip: "Only fire if the target is NOT calmed.")
	[rooted_cb, not_rooted_cb, calmed_cb, not_calmed_cb].each_with_index { |cb, col| cb.set_size_request(160, -1); tgt_grid.attach(cb, col, 2, 1, 1) }

	frozen_cb      = make_check(tgt_grid, "Target Frozen",     entry['tgt_frozen'],     tip: "Only fire if the target is currently frozen.")
	not_frozen_cb  = make_check(tgt_grid, "Target Not Frozen", entry['tgt_not_frozen'], tip: "Only fire if the target is NOT frozen.")
	[frozen_cb, not_frozen_cb].each_with_index { |cb, col| cb.set_size_request(160, -1); tgt_grid.attach(cb, col, 3, 1, 1) }

	# --- Other Options ---
	sep3 = Gtk::Separator.new(:horizontal)
	vbox.pack_start(sep3, expand: false, fill: true, padding: 2)

	if kind == 'attack'
		other_lbl = Gtk::Label.new("Other Options:")
		other_lbl.xalign = 0.0
		vbox.pack_start(other_lbl, expand: false, fill: false, padding: 0)
		other_row = Gtk::Box.new(:horizontal, 12)
		vbox.pack_start(other_row, expand: false, fill: false, padding: 0)
		kneel_cb          = make_check(other_row, "Use Kneel",          entry['use_kneel'],          tip: "Kneel before executing this attack. Required for some archery attacks and provides a bonus to ranged AS.")
		stealth_cb        = make_check(other_row, "Use Stealth",        entry['use_stealth'],        tip: "Hide before executing this attack. Required for Waylay and ambush-style attacks. Only fires if you are not already hidden.")
		until_dead_cb     = make_check(other_row, "Until Dead",         entry['until_dead'],         tip: "Keep repeating this attack until the target is dead or leaves. All conditions are still checked each cycle.")
		forcert_cb        = make_check(other_row, "Use ForceRT",        entry['use_forcert'],        tip: "Execute this attack during combat roundtime using ForceRT. Requires 10+ MOC ranks and sufficient stamina. The script calculates the stamina cost automatically using the wiki formula and skips the attack if you cannot afford it.")

		qs_row = Gtk::Box.new(:horizontal, 8)
		vbox.pack_start(qs_row, expand: false, fill: false, padding: 0)
		qs_cb  = make_check(qs_row, "Use Quickstrike", entry['use_quickstrike'], tip: "Sends QSTRIKE before this attack to reduce roundtime. Enter a negative value for RT reduction (e.g. -2) or a positive value for absolute RT (e.g. 1). The game will automatically use less stamina if you cannot afford the full reduction.")
		qs_lbl = Gtk::Label.new("QStrike Value:")
		qs_lbl.xalign = 0.0
		qs_lbl.tooltip_text = "Negative = RT reduction (e.g. -2 reduces RT by 2 seconds). Positive = absolute RT (e.g. 1 sets RT to 1 second minimum)."
		qs_row.pack_start(qs_lbl, expand: false, fill: false, padding: 0)
		qs_ent = Gtk::Entry.new
		qs_ent.text = entry['quickstrike_value'].to_s
		qs_ent.set_width_chars(4)
		qs_ent.placeholder_text = "-2"
		qs_ent.tooltip_text = "e.g. -2 for -2 second reduction, or 1 for 1 second absolute RT."
		qs_row.pack_start(qs_ent, expand: false, fill: false, padding: 0)

		# Grey out QStrike value field when checkbox is unchecked
		qs_ent.sensitive = qs_cb.active?
		qs_lbl.sensitive = qs_cb.active?
		h_qs_toggle = proc { qs_ent.sensitive = qs_cb.active?; qs_lbl.sensitive = qs_cb.active? }
		$_osa_entry_dialog_gc << h_qs_toggle
		qs_cb.signal_connect("toggled", &h_qs_toggle)

		# --- Multi-Strike Options ---
		ms_sep = Gtk::Separator.new(:horizontal)
		vbox.pack_start(ms_sep, expand: false, fill: true, padding: 2)
		ms_lbl = Gtk::Label.new("Multi-Strike Options:")
		ms_lbl.xalign = 0.0
		ms_lbl.tooltip_text = "These options only apply when the Multi-Strike attack type is selected above."
		vbox.pack_start(ms_lbl, expand: false, fill: false, padding: 0)
		ms_row = Gtk::Box.new(:horizontal, 12)
		vbox.pack_start(ms_row, expand: false, fill: false, padding: 0)
		ms_uac_cb      = make_check(ms_row, "UAC",                entry['mstrike_uac'],          tip: "Configure mstrike for UAC combat (default: jab).")
		ms_archery_cb  = make_check(ms_row, "Archery",            entry['mstrike_archery'],      tip: "Configure mstrike for archery combat (default: fire).")
		ms_melee_cb    = make_check(ms_row, "Melee",              entry['mstrike_melee'],        tip: "Configure mstrike for standard melee weapon combat (default: attack).")
		celerity_only_cb = make_check(ms_row, "Skip With Celerity", entry['mstrike_skip_celerity'], tip: "Skip Multi-Strike when Celerity (506) is active. Celerity already reduces roundtime on all attacks so mstrike may be redundant.")

		# Grey out Multi-Strike Options unless Multi-Strike is selected
		ms_widgets = [ms_sep, ms_lbl, ms_uac_cb, ms_archery_cb, ms_melee_cb, celerity_only_cb]
		update_ms_sensitivity = proc {
			is_ms = LIVING_ATTACK_OPTIONS[type_combo.active].to_s == "Multi-Strike"
			ms_widgets.each { |w| w.sensitive = is_ms }
		}
		update_ms_sensitivity.call
		h_ms_changed = proc { update_ms_sensitivity.call }
		$_osa_entry_dialog_gc << h_ms_changed
		type_combo.signal_connect("changed", &h_ms_changed)

		fg_row = Gtk::Box.new(:horizontal, 8)
		vbox.pack_start(fg_row, expand: false, fill: false, padding: 0)
		fg_lbl = Gtk::Label.new("Flare Gloves (adj noun):")
		fg_lbl.xalign = 0.0
		fg_lbl.set_tooltip_text('Enter the adjective and noun of your "Right to Flare Arms" gloves e.g. "red gloves". The command sent will be: pound <adj> <noun>')
		fg_row.pack_start(fg_lbl, expand: false, fill: false, padding: 0)
		fg_adj_ent  = Gtk::Entry.new; fg_adj_ent.text  = entry['flare_gloves_adj'].to_s;  fg_adj_ent.set_width_chars(10); fg_adj_ent.placeholder_text = "adjective"
		fg_noun_ent = Gtk::Entry.new; fg_noun_ent.text = entry['flare_gloves_noun'].to_s; fg_noun_ent.set_width_chars(10); fg_noun_ent.placeholder_text = "noun"
		fg_row.pack_start(fg_adj_ent,  expand: false, fill: false, padding: 0)
		fg_row.pack_start(fg_noun_ent, expand: false, fill: false, padding: 0)

		wp_row = Gtk::Box.new(:horizontal, 8)
		vbox.pack_start(wp_row, expand: false, fill: false, padding: 0)
		wp_lbl = Gtk::Label.new("Energy Wing Pin (adj noun):")
		wp_lbl.xalign = 0.0
		wp_lbl.set_tooltip_text('Enter the adjective and noun of your "Pinions and Pulse" pin e.g. "silver pin". The command sent will be: tap/pull/push <adj> <noun>')
		wp_row.pack_start(wp_lbl, expand: false, fill: false, padding: 0)
		wp_adj_ent  = Gtk::Entry.new; wp_adj_ent.text  = entry['wings_pin_adj'].to_s;  wp_adj_ent.set_width_chars(10); wp_adj_ent.placeholder_text = "adjective"
		wp_noun_ent = Gtk::Entry.new; wp_noun_ent.text = entry['wings_pin_noun'].to_s; wp_noun_ent.set_width_chars(10); wp_noun_ent.placeholder_text = "noun"
		wp_row.pack_start(wp_adj_ent,  expand: false, fill: false, padding: 0)
		wp_row.pack_start(wp_noun_ent, expand: false, fill: false, padding: 0)

		flare_attacks = ["Pound (Flare Gloves)"]
		wings_attacks  = ["Light Energy Wings: Radiant Pulse", "Light Energy Wings: Blast of Brilliance",
		                  "Light Energy Wings: Blinding Reprisal", "Dark Energy Wings: Shadow Barb",
		                  "Dark Energy Wings: Barbed Sweep", "Dark Energy Wings: Rain of Thorns"]
		update_attack_fields = proc {
			selected = LIVING_ATTACK_OPTIONS[type_combo.active].to_s
			[fg_lbl, fg_adj_ent, fg_noun_ent].each { |w| w.sensitive = flare_attacks.include?(selected) }
			[wp_lbl, wp_adj_ent, wp_noun_ent].each { |w| w.sensitive = wings_attacks.include?(selected) }
		}
		update_attack_fields.call
		h_atk_changed = proc { update_attack_fields.call }
		$_osa_entry_dialog_gc << h_atk_changed
		type_combo.signal_connect("changed", &h_atk_changed)
	else
		spell_opt_lbl = Gtk::Label.new("Spell Options:")
		spell_opt_lbl.xalign = 0.0
		vbox.pack_start(spell_opt_lbl, expand: false, fill: false, padding: 0)
		spell_opt_row = Gtk::Box.new(:horizontal, 12)
		vbox.pack_start(spell_opt_row, expand: false, fill: false, padding: 0)
		cast_type_lbl = Gtk::Label.new("Cast Type:")
		cast_type_lbl.xalign = 0.0
		spell_opt_row.pack_start(cast_type_lbl, expand: false, fill: false, padding: 0)
		cast_combo = Gtk::ComboBoxText.new
		["(default)", "channel", "evoke", "evoke channel"].each { |t| cast_combo.append_text(t) }
		cur_ct = entry['cast_type'].to_s.empty? ? "(default)" : entry['cast_type']
		cast_combo.active = ["(default)", "channel", "evoke", "evoke channel"].index(cur_ct) || 0
		spell_opt_row.pack_start(cast_combo, expand: false, fill: false, padding: 0)
		open_cb       = make_check(spell_opt_row, "Open Cast",  entry['open_cast'],  tip: "Cast the spell open (targets all creatures in room) instead of at a single target. Use for AoE spells like 435 or 710.")
		warding_cb    = make_check(spell_opt_row, "Warding",    entry['warding'],    tip: "Mark this as a warding spell. Warding spells are cast from defensive stance since they are not stance-dependent. Bolt spells should leave this unchecked and are cast from offensive stance.")
		until_dead_cb = make_check(spell_opt_row, "Until Dead", entry['until_dead'], tip: "Keep casting this spell until the target is dead or leaves. All conditions are still checked each cycle. Useful for warding spells you want to keep casting until the mob falls.")
	end

	# --- Creature Exceptions ---
	sep4 = Gtk::Separator.new(:horizontal)
	vbox.pack_start(sep4, expand: false, fill: true, padding: 2)
	creature_lbl = Gtk::Label.new("Creature Exceptions:")
	creature_lbl.xalign = 0.0
	creature_lbl.tooltip_text = "Restrict this entry to specific creature types. Leave both fields empty to use on any creature."
	vbox.pack_start(creature_lbl, expand: false, fill: false, padding: 0)
	only_row = Gtk::Box.new(:horizontal, 8)
	vbox.pack_start(only_row, expand: false, fill: false, padding: 0)
	only_lbl = Gtk::Label.new("Only Use On:")
	only_lbl.xalign = 0.0
	only_lbl.set_size_request(140, -1)
	only_lbl.tooltip_text = "Comma-separated list of creature nouns or names. This entry will ONLY fire if the current target matches one of these. Empty = use on anything."
	only_row.pack_start(only_lbl, expand: false, fill: false, padding: 0)
	only_ent = Gtk::Entry.new
	only_ent.text = entry['only_use_on'].to_s
	only_ent.placeholder_text = "troll, ghoul, vampire  (empty = use on anything)"
	only_ent.tooltip_text = "Comma-separated creature nouns. e.g. \"troll, ghoul\" - entry only fires on those creatures."
	only_ent.set_width_chars(40)
	only_row.pack_start(only_ent, expand: true, fill: true, padding: 0)
	skip_row = Gtk::Box.new(:horizontal, 8)
	vbox.pack_start(skip_row, expand: false, fill: false, padding: 0)
	skip_lbl = Gtk::Label.new("Do Not Use On:")
	skip_lbl.xalign = 0.0
	skip_lbl.set_size_request(140, -1)
	skip_lbl.tooltip_text = "Comma-separated list of creature nouns or names. This entry will be SKIPPED if the current target matches any of these. Empty = no exclusions."
	skip_row.pack_start(skip_lbl, expand: false, fill: false, padding: 0)
	skip_ent = Gtk::Entry.new
	skip_ent.text = entry['do_not_use_on'].to_s
	skip_ent.placeholder_text = "golem, construct  (empty = no exclusions)"
	skip_ent.tooltip_text = "Comma-separated creature nouns. e.g. \"golem, construct\" - entry skips those creatures."
	skip_ent.set_width_chars(40)
	skip_row.pack_start(skip_ent, expand: true, fill: true, padding: 0)

	# --- Action buttons ---
	sep5 = Gtk::Separator.new(:horizontal)
	vbox.pack_start(sep5, expand: false, fill: true, padding: 2)
	act_row = Gtk::Box.new(:horizontal, 8)
	vbox.pack_start(act_row, expand: false, fill: false, padding: 0)

	save_btn   = Gtk::Button.new(label: edit_idx.nil? ? "Add To Routine" : "Save Changes")
	cancel_btn = Gtk::Button.new(label: "Cancel")

	h_save = proc do
		new_entry = living_routine_default_entry(kind)
		new_entry['kind'] = kind

		if kind == 'attack'
			new_entry['type']                  = LIVING_ATTACK_OPTIONS[type_combo.active] || ''
			new_entry['use_kneel']             = kneel_cb.active?
			new_entry['use_stealth']           = stealth_cb.active?
			new_entry['until_dead']            = until_dead_cb.active?
			new_entry['mstrike_skip_celerity'] = celerity_only_cb.active?
			new_entry['use_forcert']           = forcert_cb.active?
			new_entry['use_quickstrike']       = qs_cb.active?
			new_entry['quickstrike_value']     = qs_ent.text.to_s.strip
			new_entry['mstrike_uac']           = ms_uac_cb.active?
			new_entry['mstrike_archery']       = ms_archery_cb.active?
			new_entry['mstrike_melee']         = ms_melee_cb.active?
			new_entry['flare_gloves_adj']  = fg_adj_ent.text.to_s.strip
			new_entry['flare_gloves_noun'] = fg_noun_ent.text.to_s.strip
			new_entry['wings_pin_adj']     = wp_adj_ent.text.to_s.strip
			new_entry['wings_pin_noun']    = wp_noun_ent.text.to_s.strip
		else
			new_entry['type']      = type_entry.text.to_s.strip
			new_entry['cast_type'] = cast_combo.active_text == "(default)" ? '' : cast_combo.active_text.to_s
			new_entry['open_cast'] = open_cb.active?
			new_entry['warding']   = warding_cb.active?
			new_entry['until_dead'] = until_dead_cb.active?
			new_entry['use_stomp'] = stomp_rb&.active? || false
			new_entry['use_tap']   = tap_rb&.active?   || false
			new_entry['use_pound'] = pound_rb&.active?  || false
		end

		new_entry['stance']          = stance_combo.active_text == "Default" ? '' : stance_combo.active_text.to_s
		new_entry['min_mana']        = min_mana_ent.text.to_i
		new_entry['max_mana']        = max_mana_ent.text.to_i
		new_entry['min_stam']        = min_stam_ent.text.to_i
		new_entry['max_stam']        = max_stam_ent.text.to_i
		new_entry['min_targets']     = min_tgt_ent.text.to_i
		new_entry['max_targets']     = max_tgt_ent.text.to_i
		new_entry['tgt_stunned']     = stunned_cb.active?
		new_entry['tgt_not_stunned'] = not_stunned_cb.active?
		new_entry['tgt_bound']       = bound_cb.active?
		new_entry['tgt_not_bound']   = not_bound_cb.active?
		new_entry['tgt_webbed']      = webbed_cb.active?
		new_entry['tgt_not_webbed']  = not_webbed_cb.active?
		new_entry['tgt_prone']       = prone_cb.active?
		new_entry['tgt_not_prone']   = not_prone_cb.active?
		new_entry['tgt_rooted']      = rooted_cb.active?
		new_entry['tgt_not_rooted']  = not_rooted_cb.active?
		new_entry['tgt_calmed']      = calmed_cb.active?
		new_entry['tgt_not_calmed']  = not_calmed_cb.active?
		new_entry['tgt_frozen']      = frozen_cb.active?
		new_entry['tgt_not_frozen']  = not_frozen_cb.active?
		new_entry['only_use_on']     = only_ent.text.to_s.strip
		new_entry['do_not_use_on']   = skip_ent.text.to_s.strip

		routine = creature_type == :undead ? undead_routine_load : living_routine_load
		if edit_idx.nil?
			routine << new_entry
		else
			routine[edit_idx] = new_entry
		end
		creature_type == :undead ? undead_routine_save(routine) : living_routine_save(routine)
		win.destroy
		GLib::Idle.add { creature_type == :undead ? refresh_undead_routine_display(main_rows) : refresh_living_routine_display(main_rows); false }
	end
	$_osa_entry_dialog_gc << h_save
	save_btn.signal_connect("clicked", &h_save)

	h_cancel = proc { win.destroy }
	$_osa_entry_dialog_gc << h_cancel
	cancel_btn.signal_connect("clicked", &h_cancel)

	h_destroy = proc { $_osa_entry_dialog_gc.clear }
	$_osa_entry_dialog_gc << h_destroy
	win.signal_connect("destroy", &h_destroy)

	act_row.pack_start(save_btn,   expand: false, fill: false, padding: 0)
	act_row.pack_start(cancel_btn, expand: false, fill: false, padding: 0)

	win.set_transient_for(@OSA_COM_WINDOW) if @OSA_COM_WINDOW
	win.set_keep_above(true)
	win.show_all
	win.present
end

def self.populate_living(rows)
	ui(rows, :header, text: "Combat Settings:")
	ui(rows, :blank, height: 4)
	ui(ui(rows, :row), :entry, label: "Creature Exclusion List:", tip: "Comma-separated creature nouns or names to never attack. e.g. \"kobold, spirit, wisp\"", var: 'living_exclusion', width_chars: 50, default: "", label_width: 180, placeholder: "kobold, spirit, wisp")
	ui(ui(rows, :row), :entry, label: "Target Priority:", tip: "Comma-separated creature nouns or names. When multiple targets are present, the script will prefer these in the order listed. e.g. \"bandit, rogue\"", var: 'living_priority', width_chars: 50, default: "", label_width: 180, placeholder: "bandit, rogue")
	ui(rows, :blank, height: 6)
	ui(ui(rows, :row), :dropdown, label: "Default Attacking Stance", tip: "The default stance used during combat. Individual routine entries can override this.", var: 'attack_stance', options: "Offensive,Advance,Forward,Neutral,Guarded,Defensive", combo_width: 256)
	ui(ui(rows, :row), :dropdown, label: "Default Defending Stance", tip: "The default stance used when not actively attacking. Individual routine entries can override this.", var: 'defending_stance', options: "Defensive,Guarded,Neutral,Forward,Advance,Offensive", combo_width: 251)
	ui(rows, :blank, height: 8)
	ui(rows, :header, text: "Combat Routine:")
	ui(rows, :blank, height: 4)

	@living_routine_container = Gtk::Box.new(:vertical, 4)
	rows.pack_start(@living_routine_container, expand: false, fill: true, padding: 0)

	refresh_living_routine_display(rows)

	ui(rows, :blank, height: 8)

	btn_row = Gtk::Box.new(:horizontal, 8)
	btn_row.set_border_width(4)

	add_atk_btn = Gtk::Button.new(label: "  + Add Attack  ")
	h_add_atk = proc { open_living_entry_dialog(rows, nil, 'attack') }
	$_osa_gc ||= []
	$_osa_gc << h_add_atk
	add_atk_btn.signal_connect("clicked", &h_add_atk)
	btn_row.pack_start(add_atk_btn, expand: false, fill: false, padding: 0)

	add_spl_btn = Gtk::Button.new(label: "  + Add Spell  ")
	h_add_spl = proc { open_living_entry_dialog(rows, nil, 'spell') }
	$_osa_gc << h_add_spl
	add_spl_btn.signal_connect("clicked", &h_add_spl)
	btn_row.pack_start(add_spl_btn, expand: false, fill: false, padding: 0)

	rows.pack_start(btn_row, expand: false, fill: false, padding: 0)

	ui(rows, :blank, height: 6)
	copy_row = Gtk::Box.new(:horizontal, 8)
	copy_row.set_border_width(4)
	copy_btn = Gtk::Button.new(label: "Copy Routine to Undead Tab")
	h_copy = proc do
		routine = living_routine_load
		undead_routine_save(routine.map(&:dup))
		GLib::Idle.add { refresh_undead_routine_display(@OSA_COM_ROWS4); false }
		respond "--- OSACombat: Living routine copied to Undead tab."
	end
	$_osa_gc << h_copy
	copy_btn.signal_connect("clicked", &h_copy)
	copy_row.pack_start(copy_btn, expand: false, fill: false, padding: 0)
	rows.pack_start(copy_row, expand: false, fill: false, padding: 0)
end

