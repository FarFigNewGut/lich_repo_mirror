################# Mstrike Routine	
def do_mstrike(entry: nil)
	return if stunned? || webbed? || bound? || checkdead
	return if Effects::Cooldowns.active?("Multi-Strike")
	return if Skills.multiopponentcombat < 5
	# Celerity gate -- skip when Celerity is active if user checked that option
	if entry && entry['mstrike_skip_celerity']
		return if Effects::Buffs.active?("Celerity")
	end
	# Configure mstrike default based on per-entry type selection
	if entry
		if entry['mstrike_uac']
			fput "mstrike set default jab"
		elsif entry['mstrike_archery']
			fput "mstrike set default fire"
		elsif entry['mstrike_melee']
			fput "mstrike set default attack"
		end
	end
	if GameObj.targets.count >= 2 && $osacombat_my_mstrike_focus == 0 && $osacombat_my_mstrike_open >= 1
		stance_offensive
		fput "mstrike"
		wait_rt
		stance_defensive
	elsif $osacombat_my_mstrike_focus >= 1 && $osacombat_my_mstrike_open >= 1
		get_target
		stance_offensive
		cmd = GameObj.targets.count >= 2 ? "mstrike" : "mstrike target"
		fput cmd
		wait_rt
		stance_defensive
	end
end

def mstrike_routine
	if Skills.multiopponentcombat >= 5 && @combat_data["use_mstrike"]
		if Effects::Cooldowns.active? "Multi-Strike" or ((stunned?) or (webbed?) or (bound?))
			return
		else
			if GameObj.targets.count >= 2 && $osacombat_my_mstrike_focus == 0 && $osacombat_my_mstrike_open >= 1 && @combat_data["use_mstrike"]
				if Char.percent_stamina >= 50
					stance_offensive
					fput "mstrike"
					wait_rt
					stance_defensive
				end
			elsif GameObj.targets.count == 1 && $osacombat_my_mstrike_focus >= 1 && $osacombat_my_mstrike_open >= 1 && @combat_data["use_mstrike"]
				if Char.percent_stamina >= 50
					get_target
					stance_offensive
					fput "mstrike target"
					wait_rt
					stance_defensive
				end
			elsif GameObj.targets.count >= 2 && $osacombat_my_mstrike_focus >= 1 && $osacombat_my_mstrike_open >= 1 && @combat_data["use_mstrike"]
				if Char.percent_stamina >= 50
					stance_offensive
					fput "mstrike"
					wait_rt
					stance_defensive
				end
			end
		end
	else
		return
	end
	wait_rt
end

################# Combat Styles	

def parse_slots(str)
	str.to_s.split(",").map { |s| s.strip.to_i }.select { |n| n > 0 }
end

def target_in_routine?(base_var)
	return true if GameObj.target.nil?
	# Determine if base_var is an attack, spell, or opener slot and extract slot number
	if base_var =~ /(?:living|undead)_atk_(\d+)$/
		slot_num = $1.to_i
		skip_key = lambda { |n| "creature_#{n}_skip_attacks" }
		only_key = lambda { |n| "creature_#{n}_only_attacks" }
	elsif base_var =~ /(?:undead_)?spell(\d+)$/
		slot_num = $1.to_i
		skip_key = lambda { |n| "creature_#{n}_skip_spells" }
		only_key = lambda { |n| "creature_#{n}_only_spells" }
	elsif base_var =~ /(?:living|undead)_opener(\d+)$/
		slot_num = $1.to_i
		skip_key = lambda { |n| "creature_#{n}_skip_openers" }
		only_key = lambda { |n| "creature_#{n}_only_openers" }
	else
		return true
	end
	# If no creature slots defined, fire normally
	defined_slots = (1..10).select { |n| !@combat_data["creature_#{n}"].to_s.strip.empty? }
	return true if defined_slots.empty?
	target_noun = GameObj.target.noun.to_s.downcase
	target_name = GameObj.target.name.to_s.downcase
	matched_slot = nil
	defined_slots.each do |n|
		creature = @combat_data["creature_#{n}"].to_s.downcase.strip
		creature_words = creature.split
		if target_noun.split.any? { |w| creature_words.include?(w) } ||
		   target_name.split.any? { |w| creature_words.include?(w) }
			matched_slot = n
			break
		end
	end
	# Check Exclusive lists across ALL defined slots -
	# if this slot_num is marked exclusive for ANY creature slot,
	# it must not fire on non-matching creatures
	if matched_slot.nil?
		defined_slots.each do |n|
			only_slots = parse_slots(@combat_data[only_key.call(n)])
			return false if only_slots.include?(slot_num)
		end
		return true
	end
	# Target matched a creature slot - apply Skip check
	skip_slots = parse_slots(@combat_data[skip_key.call(matched_slot)])
	return false if skip_slots.include?(slot_num)
	# Fire normally - Exclusive only restricts on non-matching creatures, not on matching ones
	true
end


def stealth_disabler_routine
	return if @combat_data["stealth_disabler"].nil? || @combat_data["stealth_disabler"] == "Search (Default)"
	case @combat_data["stealth_disabler"]
	when "Search (Default)"
		stance_defensive
		fput "search"
		wait_rt
	when "Eviscerate"
		stance_offensive
		fput "cman eviscerate#{forcert_suffix}"
		stance_defensive
	when "Carn\'s Cry (Open)"
		stance_offensive
		Warcry.use("Cry", "All")
		stance_defensive
	when "Symbol of Sleep"
		stance_defensive
		fput "symbol of sleep"
		wait_rt
	else
		# Spell-based disablers
		$stealth_disabler_spell = @combat_data["stealth_disabler"]
		cast_disabler
	end
end

def cast_disabler
	if $stealth_disabler_spell.nil? || $stealth_disabler_spell.to_s.strip.empty?
		fput "search"
		wait_rt
		return
	end
	unless Spell[$stealth_disabler_spell].known?
		respond "--- OSACombat: Stealth disabler spell \'#{$stealth_disabler_spell}\' not known. Defaulting to Search."
		fput "search"
		wait_rt
		return
	end
	wait_rt
	wait_castrt
	fput "prep #{$stealth_disabler_spell}"
	fput "cast"
	wait_rt
	wait_castrt
	if $stealth_disabler_spell == "Light"
		fput "search"
		wait_rt
	end
end
def attack_stamina_cost(attack_name)
	# Map our display name to lookup long_name
	long = attack_name.to_s.downcase
	             .gsub(/[^a-z0-9]/, '_')
	             .gsub(/_+/, '_')
	             .gsub(/^_|_$/, '')
	all = CMan.cman_lookups.to_a + Weapon.weapon_lookups.to_a + Shield.shield_lookups.to_a
	entry = all.find { |t| t[:long_name] == long }
	entry ? entry.dig(:cost, :stamina).to_i : 0
end

def forcert_cost(base_stamina, use_number)
	# Wiki formula: TRUNC(base + base * (25 + 10 * use_number) / 100)
	(base_stamina + (base_stamina * (25 + (10 * use_number)) / 100.0)).truncate
end

def forcert_reset_if_new_rt
	# Reset use counter when a new RT cycle begins
	current_rt = $rt
	if current_rt.nil? || current_rt <= Time.now
		# Not in RT -- reset counter so next RT cycle starts fresh
		$osa_forcert_uses = 0
		$osa_forcert_last_rt = nil
	elsif $osa_forcert_last_rt != current_rt
		# New RT cycle started
		$osa_forcert_uses = 0
		$osa_forcert_last_rt = current_rt
	end
end

def can_use_forcert?(attack_name)
	forcert_reset_if_new_rt
	# Must be in roundtime to use ForceRT
	return false unless $rt && $rt > Time.now
	# Must have ForceRT uses remaining
	next_use = $osa_forcert_uses + 1
	return false unless PSMS.can_forcert?(next_use)
	# Must have enough stamina for the ForceRT cost
	base = attack_stamina_cost(attack_name)
	return false if base == 0  # unknown attack, can't calculate
	cost = forcert_cost(base, next_use)
	return false if Char.stamina < cost
	true
end

def consume_forcert_use
	$osa_forcert_uses += 1
end

def forcert_suffix
	$osa_forcert_active ? " forcert" : ""
end

def do_uac_single(attack_cmd)
	return unless GameObj.targets.count >= 1
	return if stunned? || webbed? || bound? || checkdead
	# On first call use the specified attack; on subsequent until_dead iterations
	# use whatever the chain determined as the next attack
	valid_uac = %w[jab punch kick grapple]
	current = $osacombat_uac_current_attack.to_s
	actual_cmd = valid_uac.include?(current) ? current : attack_cmd
	$osacombat_uac_current_attack = actual_cmd
	stance_offensive
	result = dothistimeout actual_cmd, 3, /excellent positioning|followup jab|followup punch|followup grapple|followup kick|Roundtime/
	if result.to_s =~ /excellent positioning/
		$osacombat_uac_current_attack = "kick"
	elsif result.to_s =~ /followup jab/
		$osacombat_uac_current_attack = "jab"
	elsif result.to_s =~ /followup punch/
		$osacombat_uac_current_attack = "punch"
	elsif result.to_s =~ /followup grapple/
		$osacombat_uac_current_attack = "grapple"
	elsif result.to_s =~ /followup kick/
		$osacombat_uac_current_attack = "kick"
	else
		# No followup suggestion -- reset to the entry's base attack next round
		$osacombat_uac_current_attack = attack_cmd
	end
	wait_rt
	stance_defensive
end

def dispatch_attack(atk, stam_min, mana_min, enemy_min, enemy_max, base_var: nil, entry: nil, forcert: false)
	return if stunned? || webbed? || bound? || checkdead || GameObj.targets.empty?
	return if Char.stamina.to_i < stam_min
	return if Char.mana.to_i < mana_min
	return if GameObj.targets.count < enemy_min
	return if GameObj.targets.count > enemy_max
	return unless get_target
	return if excluded_target?
	return unless base_var.nil? || target_in_routine?(base_var)
	$osa_forcert_active = forcert
	case atk
	when "Barrage (Ranged)"                    then barrage
	when "Bearhug"                             then bearhug
	when "Berserk"                             then berserk
	when "Bertrandt's Bellow (Single Target)"  then bertrandts_bellow_single
	when "Bertrandt's Bellow (Open)"           then bertrandts_bellow_open
	when "Bull Rush"                           then bull_rush
	when "Carn's Cry (Single Target)"          then carns_cry_single
	when "Carn's Cry (Open)"                   then carns_cry_open
	when "Chastise"                            then chastise
	when "Charge (Polearm)"                    then charge
	when "Clash (Brawling)"                    then clash
	when "Cripple (Edged)"                     then cripples
	when "Crowd Press"                         then crowd_press
	when "Cutthroat"                           then cutthroat
	when "Cyclone (Polearm)"                   then cyclone
	when "Dark Energy Wings: Shadow Barb"      then dark_wings_turn
	when "Dark Energy Wings: Barbed Sweep"     then dark_wings_knock
	when "Dark Energy Wings: Rain of Thorns"   then dark_wings_fold
	when "Dirtkick"                            then dirt_kick
	when "Disarm Weapon"                       then disarm_manuever
	when "Dislodge"                            then dislodge
	when "Dizzying Swing (Blunt)"              then dizzying_swing
	when "Eviscerate"                          then eviscerate
	when "Excoriate"                           then excoriate
	when "Exsanguinate"                        then exsanguinate
	when "Eyepoke"                             then eyepoke
	when "Feint"                               then feint_manuever
	when "Flurry (Edged)"                      then flurry
	when "Footstomp"                           then footstomp
	when "Fury (Brawling)"                     then fury
	when "Garrelle's Growl (Single Target)"    then gerrelles_growl_single
	when "Garrelle's Growl (Open)"             then gerrelles_growl_open
	when "Groin Kick"                          then groin_kick
	when "Guardant Thrusts (Polearm)"          then gthrusts
	when "Hamstring"                           then hamstring
	when "Haymaker"                            then haymaker
	when "Headbutt"                            then headbutt
	when "Kneebash"                            then kneebash
	when "Leap Attack"                         then leap_attack
	when "Light Energy Wings: Radiant Pulse"   then light_wings_turn
	when "Light Energy Wings: Blast of Brilliance" then light_wings_knock
	when "Light Energy Wings: Blinding Reprisal"   then light_wings_fold
	when "Mighty Blow"                         then mighty_blow
	when "Mounted Combat: Charge"              then mounted_combat_charge
	when "Mounted Combat: Trample"             then mounted_combat_trample
	when "Mug"                                 then mug
	when "Nosetweak"                           then nosetweak
	when "Pin Down (Ranged)"                   then pin_down
	when "Pound (Flare Gloves)"               then flare_gloves_pound
	when "Pulverize (Blunt)"                   then pulverize
	when "Pummel (Blunt)"                      then pummel
	when "Shield Bash"                         then shield_bash
	when "Shield Charge"                       then shield_charge
	when "Shield Push"                         then shield_push
	when "Shield Strike"                       then shield_strike
	when "Shield Throw"                        then shield_throw
	when "Shield Trample"                      then shield_trample
	when "Spin Attack"                         then spin_attack
	when "Spell Cleave"                        then spell_cleave
	when "Staggering Blow"                     then staggering_blow
	when "Subdue"                              then subdue
	when "Sunder Shield"                       then sunder_shield
	when "Sweep"                               then sweep
	when "Swiftkick"                           then swiftkick
	when "Tackle"                              then tackle_manuever
	when "Templeshot"                          then templeshot
	when "Thrash (Two-Handed)"                 then thrash
	when "Throatchop"                          then throatchop
	when "Trip"                                then trip
	when "True Strike"                         then true_strike
	when "Twin Hammerfists (Brawling)"         then twin_hammerfists
	when "Vault Kick"                          then vault_kick
	when "Volley (Ranged)"                     then volley
	when "Voln Sleep"                          then voln_sleep
	when "Whirling Blade (Edged)"              then whirling_blade
	when "Whirlwind (Two-Handed)"              then whirlwind
	when "Attack"                              then (stance_offensive; fput "attack";  wait_rt; stance_defensive)
	when "Fire"                                then (stance_offensive; fput "fire";    wait_rt; stance_defensive)
	when "Waylay"                              then (stance_offensive; fput "waylay";  wait_rt; stance_defensive)
	when "Multi-Strike"                        then do_mstrike(entry: entry)
	when "Jab"                                 then do_uac_single("jab")
	when "Punch"                               then do_uac_single("punch")
	when "Kick"                                then do_uac_single("kick")
	when "Grapple"                             then do_uac_single("grapple")
	end
end

# ---------------------------------------------------------------------------
# Entry-based dispatch for the new living routine system
# ---------------------------------------------------------------------------

def living_entry_conditions_met?(entry)
	# Character conditions
	return false if Char.mana.to_i    < entry['min_mana'].to_i
	return false if Char.mana.to_i    > entry['max_mana'].to_i
	return false if Char.stamina.to_i < entry['min_stam'].to_i
	return false if Char.stamina.to_i > entry['max_stam'].to_i
	# Target count conditions
	tc = GameObj.targets.count
	return false if tc < entry['min_targets'].to_i
	return false if tc > entry['max_targets'].to_i
	# Target state conditions -- evaluated against the current primary target
	tgt = GameObj.target
	return false unless tgt
	status = tgt.status.to_s
	return false if entry['tgt_stunned']     && !(status =~ /stunned/)
	return false if entry['tgt_not_stunned'] &&  (status =~ /stunned/)
	return false if entry['tgt_bound']       && !(status =~ /bound/)
	return false if entry['tgt_not_bound']   &&  (status =~ /bound/)
	return false if entry['tgt_webbed']      && !(status =~ /webbed/)
	return false if entry['tgt_not_webbed']  &&  (status =~ /webbed/)
	return false if entry['tgt_prone']       && !(status =~ /lying|prone/)
	return false if entry['tgt_not_prone']   &&  (status =~ /lying|prone/)
	return false if entry['tgt_rooted']      && !(status =~ /rooted/)
	return false if entry['tgt_not_rooted']  &&  (status =~ /rooted/)
	return false if entry['tgt_frozen']      && !(status =~ /frozen/)
	return false if entry['tgt_not_frozen']  &&  (status =~ /frozen/)
	return false if entry['tgt_calmed']      && !(status =~ /calmed/)
	return false if entry['tgt_not_calmed']  &&  (status =~ /calmed/)
	# Creature restrictions
	tgt_noun = tgt.noun.to_s.downcase
	tgt_name = tgt.name.to_s.downcase
	only_on = entry['only_use_on'].to_s.split(',').map(&:strip).map(&:downcase).reject(&:empty?)
	skip_on = entry['do_not_use_on'].to_s.split(',').map(&:strip).map(&:downcase).reject(&:empty?)
	unless only_on.empty?
		return false unless only_on.any? { |n| tgt_noun.include?(n) || tgt_name.include?(n) }
	end
	unless skip_on.empty?
		return false if skip_on.any? { |n| tgt_noun.include?(n) || tgt_name.include?(n) }
	end
	true
end

def apply_entry_stance(entry)
	stance = entry['stance'].to_s.strip
	if stance.empty? || stance == 'Default'
		@attack_stance    = @combat_data["attack_stance"]
		@defending_stance = @combat_data["defending_stance"]
	else
		@attack_stance    = stance
		@defending_stance = @combat_data["defending_stance"]
	end
end

def dispatch_attack_entry(entry)
	uac_attacks = %w[Jab Punch Kick Grapple]
	last_target_id = nil
	loop do
		return if stunned? || webbed? || bound? || checkdead || GameObj.targets.empty?
		return unless get_target
		return if excluded_target?
		return unless living_entry_conditions_met?(entry)
		# Reset UAC chain if target changed
		if uac_attacks.include?(entry['type']) && GameObj.target&.id != last_target_id
			$osacombat_uac_current_attack = entry['type'].downcase
			last_target_id = GameObj.target&.id
		end
		apply_entry_stance(entry)
		@combat_data["flare_gloves_adj"]  = entry['flare_gloves_adj'].to_s
		@combat_data["flare_gloves_noun"] = entry['flare_gloves_noun'].to_s
		@combat_data["energy_wings_noun"] = begin
			adj  = entry['wings_pin_adj'].to_s.strip
			noun = entry['wings_pin_noun'].to_s.strip
			adj.empty? ? noun : "#{adj} #{noun}"
		end
		fput "kneel" if entry['use_kneel'] && !kneeling?
		fput "hide"  if entry['use_stealth'] && !hiding?
		if entry['use_quickstrike'] && !entry['quickstrike_value'].to_s.strip.empty?
			fput "qstrike #{entry['quickstrike_value'].to_s.strip}"
		end
		use_forcert = entry['use_forcert'] && can_use_forcert?(entry['type'])
		dispatch_attack(entry['type'], 0, 0, 0, 99, entry: entry, forcert: use_forcert)
		consume_forcert_use if use_forcert
		health_monitor
		wait_rt
		break unless entry['until_dead']
		tgt = GameObj.target
		break if tgt.nil? || tgt.status.to_s =~ /dead|gone/
	end
end

def dispatch_spell_entry(entry)
	loop do
		spell_num = entry['type'].to_s.strip
		return if spell_num.empty? || spell_num == '0'
		cast_type  = entry['cast_type'].to_s
		warding    = entry['warding']
		open_cast  = entry['open_cast']
		return unless living_entry_conditions_met?(entry)
		apply_entry_stance(entry)
		can_cast_spell(spell_num, cast_type, 0, 0, 0, 99, warding, open_cast)
		health_monitor
		wait_rt
		break unless entry['until_dead']
		tgt = GameObj.target
		break if tgt.nil? || tgt.status.to_s =~ /dead|gone/
	end
end

def refresh_affected_targets(spell)
	return unless $osa_affected_targets[spell]
	current_npc_ids = GameObj.targets.map(&:id)
	$osa_affected_targets[spell].select! { |id| current_npc_ids.include?(id) }
end

