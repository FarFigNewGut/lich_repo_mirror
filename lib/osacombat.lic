def time_diff_seconds(start,finish)
	(finish - start)
end

def combat_spellup
	health_monitor
	if (Effects::Debuffs.active? "Mystic Impedance") or (Effects::Debuffs.active? "Silenced") or ((stunned?) or (webbed?) or (bound?))
		return
	end
    if running? "ecure"
		wait_until { !running?('ecure') }
	end
	if !checkprep.include? "None"
		fput "release"
	end
	if Char.mana < 50
		if $osa_last_mana_share.nil? || (Time.now - $osa_last_mana_share) > (@combat_data["mana_share_cooldown"] || 90).to_i
			mana_share
			lnet_crew($mana_message)
			$osa_last_mana_share = Time.now
		end
		pause 1
	end
	wait_rt
    result = dothistimeout "incant #{@combat_spell} #{@combat_cast_type}", 30, /Wait|...wait|Spell Hindrance|(Cast|Sing) Roundtime (.*) Seconds./
        if result.to_s =~ /Wait|...wait/
            combat_spellup
        elsif result.to_s =~ /Spell Hindrance/
            wait_castrt
            combat_spellup
        elsif result.to_s =~ /(Cast|Sing) Roundtime/
            return
        else
            combat_spellup
        end
end

def cast_spell_society
	return if $osa_anti_magic_room
	health_monitor
	society_cast("Sign of Warding")   if @combat_data["sign_of_warding"]
	society_cast("Sign of Defending") if @combat_data["sign_of_defending"]
	society_cast("Sign of Striking")  if @combat_data["sign_of_striking"]
	society_cast("Sign of Smiting")   if @combat_data["sign_of_smiting"]
	# Dissipating signs -- gate on spirit threshold to prevent obvious drain
	spirit_threshold = @combat_data["min_spirit_dissipating"].to_i
	spirit_threshold = ((Char.max_spirit / 2.0).ceil + 3) if spirit_threshold == 0
	if Char.spirit >= spirit_threshold
		society_cast("Sign of Swords")  if @combat_data["sign_of_swords"]
		society_cast("Sign of Shields") if @combat_data["sign_of_shields"]
		sign_of_dissipation
	end
	sign_of_deflection
	sign_of_wracking
	society_cast("Sigil of Minor Bane")       if @combat_data["sigil_of_minor_bane"]
	society_cast("Sigil of Offense")          if @combat_data["sigil_of_offense"]
	society_cast("Sigil of Major Bane")       if @combat_data["sigil_of_major_bane"]
	society_cast("Sigil of Minor Protection") if @combat_data["sigil_of_minor_protection"]
	society_cast("Sigil of Defense")          if @combat_data["sigil_of_defense"]
	society_cast("Sigil of Major Protection") if @combat_data["sigil_of_major_protection"]
	society_cast("Sigil of Concentration")    if @combat_data["sigil_of_concentration"]
	society_cast("Symbol of Courage")         if @combat_data["symbol_of_courage"]
	society_cast("Symbol of Protection")      if @combat_data["symbol_of_protection"]
	if @creature_type == "undead"
		society_cast("Symbol of Retribution") if @combat_data["symbol_of_retribution"]
		society_cast("Symbol of Supremacy")   if @combat_data["symbol_of_supremacy"]
	end
	Spell[1607].cast if (Spell[1607].available? && Spell[1607].affordable?) && (!Effects::Buffs.active? "Rejuvenation") && Char.percent_stamina <= 50
	$society_firstcast = true
end

def cast_spell_mana_focus
	# Always mark as cast so the caller stops re-triggering regardless of outcome
	$mana_focus_first_cast = nil
	return if Spell[1018].active?
	return unless Spell[418].known?
	@combat_spell = "418"
	@combat_cast_type = ""
	combat_spellup
end

