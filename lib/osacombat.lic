			fput "mstrike set open  #{$osacombat_my_mstrike_open}"			
		end
	end
end

################ Spell Checks to Cast
def anti_magic_check
	# Checks the last 10 lines of game output for anti-magic room dissipation messages.
	# Returns true if in an anti-magic room and waits until the room changes.
	anti_magic_msgs = [
		"The power from your sign dissipates into the air.",
		"The power from your sigil dissipates into the air.",
		"The power from your symbol dissipates into the air.",
		"Your magic fizzles ineffectually."
	]
	if anti_magic_msgs.any? { |msg| reget(10, msg) }
		$osa_anti_magic_room = true
		current_room = Room.current.id
		respond "--- OSACombat: Anti-magic room detected -- pausing society abilities until room changes."
		until Room.current.id != current_room
			sleep 2
		end
		$osa_anti_magic_room = false
		return true
	end
	false
end

def society_cast(spell_name)
	return if $osa_anti_magic_room
	return unless Spell[spell_name].known? && Spell[spell_name].affordable? && !Spell[spell_name].active?
	return if stunned? || webbed? || bound? || checkdead
	Spell[spell_name].cast
	anti_magic_check
end

def symbol_of_mana
	if Spell["Symbol of Mana"].known? && @combat_data["symbol_of_mana"] && ((!stunned?) && (!webbed?) && (!bound?) && (!checkdead))
		if Effects::Cooldowns.active? "Symbol of Mana"
			nil
		else
			Spell["Symbol of Mana"].cast
		end
	end
end

def mana_leech
	if (Spell[516].known? && (Spell[9516].timeleft < 15) && Spell[516].affordable? && (percentmana < @combat_data["percentleech"].to_i) && @combat_data["use_mana_leech"]) && ((!stunned?) && (!webbed?) && (!bound?) && (!checkdead))
		if GameObj.targets.count > 0	
			get_target
			Spell[516].cast "target"
		end
	end
end

def sigil_of_power
	Spell["Sigil of Power"].cast if Spell["Sigil of Power"].known? && Spell["Sigil of Power"].affordable? && @combat_data["sigil_of_mana"] && ((!stunned?) && (!webbed?) && (!bound?) && (!checkdead))
end

def sign_of_deflection
	return if $osa_anti_magic_room
	return unless @combat_data["sign_of_deflection"]
	return unless Spell["Sign of Deflection"].known? && Spell["Sign of Deflection"].affordable?
	return if Spell["Sign of Deflection"].active?
	return if stunned? || webbed? || bound? || checkdead
	Spell["Sign of Deflection"].cast
	anti_magic_check
end

def sign_of_dissipation
	return if $osa_anti_magic_room
	return unless @combat_data["sign_of_dissipation"]
	return unless Spell["Sign of Dissipation"].known? && Spell["Sign of Dissipation"].affordable?
	return if Spell["Sign of Dissipation"].active?
	return if stunned? || webbed? || bound? || checkdead
	threshold = @combat_data["min_spirit_dissipating"].to_i
	threshold = ((Char.max_spirit / 2.0).ceil + 3) if threshold == 0
	return if Char.spirit < threshold
	Spell["Sign of Dissipation"].cast
	anti_magic_check
end

def sign_of_wracking
	return if $osa_anti_magic_room
	return unless @combat_data["sign_of_wracking"]
	return unless Spell["Sign of Wracking"].known?
	return if stunned? || webbed? || bound? || checkdead
	mana_threshold = @combat_data["col_mana_threshold"].to_i
	mana_threshold = 30 if mana_threshold == 0
	return if Char.percent_mana > mana_threshold
	safe_threshold = (Char.max_spirit / 2.0).ceil + 5
	return if Char.spirit < safe_threshold
	Spell["Sign of Wracking"].cast
	anti_magic_check
end

def infuse_weapon
	infuse_spell = @combat_data["infusespell"].to_s.strip
	if !infuse_spell.empty?
		if Spell[infuse_spell].affordable?
			fput "prep #{infuse_spell}"
			fput "infuse ##{GameObj.right_hand.id}"
			pause 5
		else
			echo "------==== Out Of Mana ==== ------"
		end
	else
		echo "------==== No Infusion Spell Designated ==== ------"
	end
end

def infuse_gear
	return unless Spell[1604].known?
	return if $osa_expired_gear.empty?
	$osa_expired_gear.dup.each do |noun|
		if Spell[1604].affordable?
			multifput "prep 1604", "evoke my #{noun}"
			wait_rt
			$osa_expired_gear.delete(noun)
		else
			echo "------==== Out Of Mana For 1604 ==== ------"
			break
		end
	end
end

def mana_share
	$mana_type = Array.new
	$mana_type.clear
	$my_mana_type = Array.new
	$my_mana_type.clear
	if (Skills.smc >= 24)
		$mana_type.push ("Spiritual")
		$my_mana_type.push ("Spiritual")
	end
	if (Skills.mmc >= 24)
		$mana_type.push ("Mental")
		$my_mana_type.push ("Mental")
	end
	if (Skills.emc >= 24)
		$mana_type.push ("Elemental")
		$my_mana_type.push ("Elemental")
	end
	if $mana_type.count > 1
		$new_mana_type = $mana_type.last()
		$mana_type.delete "#{$mana_type.last()}"
		$mana_type.push ("or #{$new_mana_type}")
	end
	if $mana_type.count.to_i == 3
		$mana_message = "I Need #{$mana_type[0]}, #{$mana_type[1]} #{$mana_type[2]} Mana!"
	end
	if $mana_type.count.to_i == 2
		$mana_message = "I Need #{$mana_type[0]} #{$mana_type[1]} Mana!"
	end
	if $mana_type.count.to_i == 1
		$mana_message = "I Need #{$mana_type[0]} Mana!"
	end
end


############# Attack Openers
def return_from_berserk
	ship_type
	start_script("go2", [@berserk_return]) if !Room.current.id != @berserk_return
	wait_while { running?("go2") }
	if checkname == osacrew_data["commander"]
		GameObj.pcs.each{|pc|;fput "hold ##{pc.id}"}
	else
		fput "join #{osacrew_data["commander"]}"
	end
end

def berserk
	if CMan.available?("Berserk")
		@berserk_return = Room.current.id
		stance_offensive
		fput "berserk"
		waitfor /The redness fades from the world and you begin to breathe harder/
		looter
		stance_defensive
		return_from_berserk
	end
end

