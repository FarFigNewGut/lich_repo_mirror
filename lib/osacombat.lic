		undead_atk_8 undead_atk_8_stam_min undead_atk_8_mana_min undead_atk_8_enemy_min undead_atk_8_enemy_max
		undead_atk_9 undead_atk_9_stam_min undead_atk_9_mana_min undead_atk_9_enemy_min undead_atk_9_enemy_max
		undead_atk_10 undead_atk_10_stam_min undead_atk_10_mana_min undead_atk_10_enemy_min undead_atk_10_enemy_max
		undead_opener1 undead_opener1_channel undead_opener1_evoke undead_opener1_man_min undead_opener1_stam_min
		undead_opener1_enemy_min undead_opener1_enemy_max undead_opener1_warding undead_opener1_open_cast
		undead_opener2 undead_opener2_channel undead_opener2_evoke undead_opener2_man_min undead_opener2_stam_min
		undead_opener2_enemy_min undead_opener2_enemy_max undead_opener2_warding undead_opener2_open_cast
		undead_opener3 undead_opener3_channel undead_opener3_evoke undead_opener3_man_min undead_opener3_stam_min
		undead_opener3_enemy_min undead_opener3_enemy_max undead_opener3_warding undead_opener3_open_cast
		undead_spell1 undead_spell1_channel undead_spell1_evoke undead_spell1_man_min undead_spell1_stam_min undead_spell1_enemy_min undead_spell1_enemy_max undead_spell1_warding undead_spell1_open_cast
		undead_spell2 undead_spell2_channel undead_spell2_evoke undead_spell2_man_min undead_spell2_stam_min undead_spell2_enemy_min undead_spell2_enemy_max undead_spell2_warding undead_spell2_open_cast
		undead_spell3 undead_spell3_channel undead_spell3_evoke undead_spell3_man_min undead_spell3_stam_min undead_spell3_enemy_min undead_spell3_enemy_max undead_spell3_warding undead_spell3_open_cast
		undead_spell4 undead_spell4_channel undead_spell4_evoke undead_spell4_man_min undead_spell4_stam_min undead_spell4_enemy_min undead_spell4_enemy_max undead_spell4_warding undead_spell4_open_cast
		undead_spell5 undead_spell5_channel undead_spell5_evoke undead_spell5_man_min undead_spell5_stam_min undead_spell5_enemy_min undead_spell5_enemy_max undead_spell5_warding undead_spell5_open_cast
		undead_spell6 undead_spell6_channel undead_spell6_evoke undead_spell6_man_min undead_spell6_stam_min undead_spell6_enemy_min undead_spell6_enemy_max undead_spell6_warding undead_spell6_open_cast
		undead_spell7 undead_spell7_channel undead_spell7_evoke undead_spell7_man_min undead_spell7_stam_min undead_spell7_enemy_min undead_spell7_enemy_max undead_spell7_warding undead_spell7_open_cast
		undead_spell8 undead_spell8_channel undead_spell8_evoke undead_spell8_man_min undead_spell8_stam_min undead_spell8_enemy_min undead_spell8_enemy_max undead_spell8_warding undead_spell8_open_cast
		undead_spell9 undead_spell9_channel undead_spell9_evoke undead_spell9_man_min undead_spell9_stam_min undead_spell9_enemy_min undead_spell9_enemy_max undead_spell9_warding undead_spell9_open_cast
		undead_spell10 undead_spell10_channel undead_spell10_evoke undead_spell10_man_min undead_spell10_stam_min undead_spell10_enemy_min undead_spell10_enemy_max undead_spell10_warding undead_spell10_open_cast
	]
	removed = obsolete.select { |k| @combat_data.key?(k) }
	unless removed.empty?
		removed.each { |k| @combat_data.delete(k) }
		@combat_data["osa_project_migrated"] = true
		File.open(@osa_yaml_file, File::RDWR | File::CREAT, 0o644) do |file|
			file.flock(File::LOCK_EX)
			file.rewind
			file.write(YAML.dump(@combat_data))
			file.flush
			file.truncate(file.pos)
		end
		respond "--- OSACombat: Cleaned #{removed.count} obsolete settings from YAML (one-time migration)."
	else
		@combat_data["osa_project_migrated"] = true
		self.save_script_data("osa_project_migrated", true, push: false)
	end
end


def osacrew_yaml_path
	File.join(DATA_DIR, XMLData.game, Char.name, "osacrew.yaml")
end

def osacrew_data
	path = osacrew_yaml_path
	return {} unless File.exist?(path)
	raw = File.read(path)
	return {} if raw.strip.empty?
	(YAML.safe_load(raw, permitted_classes: [Time, Symbol], aliases: true) || {}).transform_keys(&:to_s)
rescue StandardError
	{}
end

self.save_script_data("version", "4.2.50 (August 22, 2026)", push: false)
#toggle_upstream if !upstream_is_enabled?
require "yaml"
