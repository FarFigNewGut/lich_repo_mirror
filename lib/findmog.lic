=begin
  findmog.lic
  Scans a container for transmog items and either drops them on the ground
  or moves them to a second container.

  Usage:
    ;findmog <source>              drop transmog items on the ground
    ;findmog <source> <dest>       move transmog items into dest container

  Examples:
    ;findmog chest
    ;findmog chest pack
=end

TRANSMOG_TYPES = /jewelry|clothing|armor|weapon|uncommon/i
TRANSMOG_LINE  = /transfer its appearance onto another compatible worn item/i

def issue_cmd(cmd, start_rx, timeout: 4)
  Lich::Util.issue_command(
    cmd, start_rx, /<prompt/,
    include_end: false, timeout: timeout, silent: true, usexml: true, quiet: true
  )
end

def refresh_container(noun)
  issue_cmd("look in #{noun}", /In the|Inside the|nothing|closed|isn't a container|don't see/i, timeout: 3)
  GameObj.inv.find { |o| o.noun.to_s.downcase == noun } ||
    GameObj.loot.find { |o| o.noun.to_s.downcase == noun } rescue nil
end

# --- Args ---
source_noun = script.vars[1].to_s.strip.downcase
dest_noun   = script.vars[2].to_s.strip.downcase

if source_noun.empty?
  respond "--- findmog: Usage: ;findmog <source container> [dest container]"
  respond "  ;findmog chest        -- drop transmog items on the ground"
  respond "  ;findmog chest pack   -- move transmog items into pack"
  exit
end

# --- Find containers ---
source = refresh_container(source_noun)
if source.nil?
  respond "--- findmog: Could not find source container '#{source_noun}'."
  exit
end

dest = nil
if !dest_noun.empty?
  dest = GameObj.inv.find { |o| o.noun.to_s.downcase == dest_noun } ||
         (GameObj.right_hand&.noun&.downcase == dest_noun ? GameObj.right_hand : nil) ||
         (GameObj.left_hand&.noun&.downcase  == dest_noun ? GameObj.left_hand  : nil)
  if dest.nil?
    respond "--- findmog: Could not find destination container '#{dest_noun}'."
    exit
  end
end

dest_label = dest ? dest.name : "the ground"
respond "--- findmog: Scanning #{source.name} for transmog items -> #{dest_label}..."

# --- Get contents ---
contents = Array(GameObj.containers[source.id])
if contents.empty?
  respond "--- findmog: Nothing found in #{source.name}."
  exit
end

candidates = contents.select { |i| i.type.to_s =~ TRANSMOG_TYPES }
respond "--- findmog: #{contents.size} item(s) found, #{candidates.size} wearable candidate(s) to check."

found  = 0
passed = 0

candidates.each_with_index do |item, idx|
  respond "--- findmog: [#{idx + 1}/#{candidates.size}] Checking #{item.name}..."
  item_id = item.id

  # Get item from source
  result = dothistimeout "get ##{item_id} from ##{source.id}", 5,
    /You get|You remove|already holding|don't see|What were|need a free hand/
  if result.to_s =~ /already holding|don't see|What were|need a free hand/
    respond "--- findmog: Could not retrieve #{item.name}, skipping."
    next
  end
  waitrt?

  # Analyze for transmog
  analyze_lines = issue_cmd("analyze ##{item_id}",
    /You analyze|cannot be analyzed|not a sound idea|isn't a sound idea|don't think/i)

  is_transmog = analyze_lines.any? { |l| l =~ TRANSMOG_LINE }

  if is_transmog
    found += 1
    respond "--- findmog: TRANSMOG found: #{item.name}"
    if dest
      fput "put ##{item_id} in ##{dest.id}"
    else
      fput "drop ##{item_id}"
    end
    waitrt?
  else
    passed += 1
    # Return to source
    fput "put ##{item_id} in ##{source.id}"
    waitrt?
  end

  pause 0.3
end

respond "--- findmog: Done. #{found} transmog item(s) moved to #{dest_label}, #{passed} returned to #{source.name}."
