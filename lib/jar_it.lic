# Gemstone IV Lich Script: jar_it.lic
# Description: Multi-container alchemy jarring script with single-pass 'look in' memory caching,
#              GTK container setup, overflow fallback, duplicate consolidation, status reporting,
#              quick jar fetching, automatic unbundling, and comprehensive jar-able reagent detection.
#
#  Author -- Arinnaer
#
# Usage: ;jar_it
#        ;jar_it setup
#        ;jar_it setup <reagent_bag> <jar_bag1,jar_bag2,...>
#        ;jar_it status
#        ;jar_it clean
#        ;jar_it empty
#        ;jar_it <reagent>
#        ;jar_it help

# ---------------------------------------------------------
# Master Jar-able Item Detection & Exclusions
# ---------------------------------------------------------
JARABLE_REGEX = Regexp.union(
  # Ground, Powdered & Mashed Reagents
  /\b(?:ground|powdered|mashed)\s+.+/i,

  # Elusive & Essences
  /\b(?:ayanad|s'ayanad|t'ayanad|n'ayanad) crystal\b/i,
  /\bcluster of (?:ayanad|s'ayanad|t'ayanad) crystals\b/i,
  /\b(?:elemental|crystal|inky necrotic) core\b/i,
  /\b(?:essence|spirit) shard\b/i,
  /\b(?:glimmering|glowing|radiant|faint) (?:blue|violet|crimson|mote|soul)/i,
  /\bpristine (?:nymph|sprite|siren)'s hair\b/i,
  /\b(?:small|large) troll tooth\b/i,
  /\btiny golden seed\b/i,
  /\bcracked soulstone\b/i,
  /\bperfect myklian belly scale\b/i,
  /\b(?:jagged crimson|jagged translucent|pale blue runed|shard of cloudy|shimmering prismatic|runed azure|runed crimson|dark glimmering|dark shadow-shrouded|shining silver|blue mist-shrouded) (?:crystal|shard|fragment)\b/i,
  /\b(?:pinch of (?:iron|gold|mithril) dust|coarse glittering earth|handful of quartz sand|pale translucent dust|dark glittering powder|glowing white powder|coarse ivory dust|fine alabaster dust)\b/i,
  /\b(?:small enruned bone|small ivory disc|slender white bone|smooth stone)\b/i,

  # Foraged Herbs, Flowers, Mosses, Roots & Mushrooms
  /\b(?:acantha|ambrominas|torban|ayana|ayana'al) leaf\b/i,
  /\b(?:tkaro|pepperthorn|talneo|rose-marrow|haphip|wingstem|bur-clover|ironfern|valerian|ginger|angelica) root\b/i,
  /\b(?:wolifrew|bolmara|orchil|red|glowing green) lichen\b/i,
  /\b(?:basal|ephlox|cave|blackened|arctic|blue|shadowlace) moss\b/i,
  /\b(?:woth|cothinar|yellow|red|blue) (?:flower|blossom|passionflower)\b/i,
  /\b(?:luckbloom|wavepetal|sunburst|nightbloom|white clover|wild pansy) blossom\b/i,
  /\b(?:pothinir|brostheras|wheat|long)grass\b/i,
  /\b(?:cactacae|strigae) (?:spine|cactus)\b/i,
  /\b(?:calamia|yabathilium) fruit\b/i,
  /\b(?:cuctucae|nightshade|marallis|bright red cran|flaeshorn)berry\b/i,
  /\b(?:aloeas|bloodthorn|sweetfern|crimson dragon)stalk\b/i,
  /\bsovyn clove\b/i,
  /\bmurdroot\b/i,
  /\b(?:bone|red trafel|blue trafel|white hook|striped heart|soft white|genkew|golden hook|sponge|flathead|trollfear) mushroom\b/i,
  /\bgiant glowing toadstool\b/i,
  /\b(?:bloodwood|twisted|witchwood|yew|willow|ebony|oak|slender) twig\b/i,
  /\b(?:small daisy|stargazer lily|fragrant white lily|tiger lily|oxblood lily|pink rain lily|coppery rain lily|wood violet|red poppy|golden buttercup|pink hydrangea|heath aster|golden aster|wild orchid|small dandelion|fairy primrose)\b/i,
  /\bsprig of (?:larkspur|foxglove|lavender|holly|wild lilac|columbine|mournbloom)\b/i,
  /\b(?:stalk of (?:bluebells|goldenrod)|cluster of (?:woad leaves|gorse)|layer of onion skin|handful of (?:pinenuts|oats|walnuts)|wild beechnut|pine cone|small wild rose|alder bark|luminescent green fungus|black-tipped wyrm thorn|petrified shadowstalk|moonlight cactus-bloom)\b/i,

  # Jarable Creature Drops (Bones, Eyes, Claws, Fangs, Feathers, Scales, etc.)
  /\b(?:skeleton|skeletal giant|golem) bone\b/i,
  /\b(?:wraith|vesperti) talon\b/i,
  /\b(?:ghoul|spider) (?:nail|finger|scraping|leg)\b/i,
  /\b(?:mist wraith|cyclops|glistening black) eye\b/i,
  /\bwight (?:skull|mane)\b/i,
  /\b(?:boar|yellowed boar|ursian) tusk\b/i,
  /\b(?:viper|tree viper|troll|faeroth|copper|silver) fang\b/i,
  /\b(?:fire cat|cat) claw\b/i,
  /\b(?:cockatrice plume|snowy cockatrice tailfeather|ruff of raptor feathers|soft blue griffin feather)\b/i,
  /\b(?:myklian|orange myklian|red myklian|yellow myklian|green myklian) scale\b/i,
  /\b(?:kappa fin|stone-grey lizard tail|cougar tail|fire rat tail|silvery tail|tegu tailspike|ogre tooth|ogre nose|troll toe|troll heart|troll beard|troll tongue|pale troll tongue|bear paw|black leopard paw|mottled faeroth crest|basilisk crest|shelfae crest|warcat whisker|silvery hoof|goat hoof|silver-tipped horseshoe|orc knuckle|kiramon tongue|tufted hawk-owl ear|hawk-owl ear|mammoth arachnid mandible)\b/i
)

NON_JARABLE_REGEX = Regexp.union(
  # Skins, Hides, Pelts, Scalps & Furs (cannot go into jars)
  /\b(?:skin|hide|pelt|scalp|fur|shroud)\b/i,

  # Liquids, Vials, Flasks, Containers & Oils (cannot be jarred)
  /\b(?:vial|flask|bottle|jar|beaker|potion|elixir|tonic|oil|water|dye|blood|venom|humor|essence of (?:air|earth|fire|water|regeneration|vitality)|murdroot essence|crystal core essence|crystalline globe|slime)\b/i
)

BUNDLED_HERB_REGEX = /^some (?:acantha leaf|cactacae spine|ambrominas leaf|torban leaf|wolifrew lichen|sovyn clove|ephlox moss|pothinir grass|haphip root|calamia fruit|aloeas stem|basal moss|woth flower)$/i

# Explicit mapping from pickup command noun -> canonical jar contents (pluralized)
REAGENT_JAR_NAMES = {
  "blue shard"    => "glimmering blue essence shards",
  "blue dust"     => "glimmering blue essence dust",
  "nymph's hair"  => "pristine nymph's hairs",
  "nymph hair"    => "pristine nymph's hairs",
  "sprite's hair" => "pristine sprite's hairs",
  "siren's hair"  => "pristine siren's hairs",
  "necrotic core" => "inky necrotic cores"
}

# Explicit mapping from pickup command noun -> all accepted aliases when matching existing jars
REAGENT_ALIASES = {
  "blue shard"    => ["glimmering blue essence shards", "glimmering blue essence shard", "blue essence shards", "blue shards"],
  "blue dust"     => ["glimmering blue essence dust", "blue essence dust", "blue dust"],
  "nymph's hair"  => ["pristine nymph's hairs", "pristine nymph's hair", "nymph's hairs", "nymph's hair", "nymph hairs", "nymph hair"],
  "nymph hair"    => ["pristine nymph's hairs", "pristine nymph's hair", "nymph's hairs", "nymph's hair", "nymph hairs", "nymph hair"],
  "necrotic core" => ["inky necrotic cores", "inky necrotic core", "necrotic cores", "necrotic core"]
}

# ---------------------------------------------------------
# Helpers
# ---------------------------------------------------------
def jarable?(item)
  return false if item.nil?
  return false if item.name =~ NON_JARABLE_REGEX
  return true if item.type =~ /\b(?:gem|reagent|herb)\b/i
  return true if item.name =~ JARABLE_REGEX
  false
end

def normalize_reagent_name(raw_name)
  raw_name.strip.downcase.sub(/^(?:bundle of|some|an?|the)\s+/i, "")
end

def pluralize_reagent(name)
  clean = normalize_reagent_name(name)
  return REAGENT_JAR_NAMES[clean] if REAGENT_JAR_NAMES.key?(clean)

  if clean =~ /^(?:ground|powdered|mashed)\s+/
    clean
  elsif clean =~ /^essence of (.+)$/
    "essences of #{$1}"
  elsif clean =~ /\btooth$/
    clean.sub(/\btooth$/, "teeth")
  elsif clean =~ /\bleaf$/
    clean.sub(/\bleaf$/, "leaves")
  elsif clean =~ /berry$/
    clean.sub(/berry$/, "berries")
  elsif clean =~ /lily$/
    clean.sub(/lily$/, "lilies")
  elsif clean =~ /poppy$/
    clean.sub(/poppy$/, "poppies")
  elsif clean =~ /moss$/
    clean.sub(/moss$/, "mosses")
  elsif clean =~ /\b(dust|essence|salt|charcoal|extract|fungus|grass|bark)$/
    clean
  elsif clean.end_with?("s")
    clean
  else
    "#{clean}s"
  end
end

def reagent_match_variants(name)
  clean = normalize_reagent_name(name)
  variants = [clean, pluralize_reagent(clean)]
  variants.concat(REAGENT_ALIASES[clean]) if REAGENT_ALIASES.key?(clean)
  variants.uniq
end

def matches_reagent?(jar_contents, target_reagent)
  return false if jar_contents.nil? || jar_contents.empty?
  jc = jar_contents.strip.downcase
  variants = reagent_match_variants(target_reagent)

  variants.any? do |v|
    jc == v || jc.end_with?(" #{v}") || jc =~ /\b#{Regexp.escape(v)}\b/
  end
end

def clean_container_label(raw_name)
  raw_name
    .sub(/^(?:a|an|some)\s+/i, "")
    .sub(/\s+(?:dyed|embroidered|inlaid|painted|tooled|trimmed|lined|decorated|set|fitted|clasped|etched|carved)\s+with\b.*$/i, "")
    .strip
end

def find_worn_container(query)
  return nil if query.nil? || query.strip.empty?
  q = query.strip.downcase

  # 1. Exact full_name or name match
  exact = GameObj.inv.find do |item|
    item.name.downcase == q || item.full_name.downcase == q
  end
  return exact if exact

  # 2. Prefix or substring match against full_name / name
  partial = GameObj.inv.find do |item|
    item.full_name.downcase.include?(q) || item.name.downcase.include?(q)
  end
  return partial if partial

  # 3. Noun match
  GameObj.inv.find { |item| item.noun.downcase == q }
end

def fetch_worn_containers
  containers = []
  capturing = false
  captured_lines = []

  hook_name = "jar_it_inv_containers_#{Time.now.to_i}_#{rand(1000)}"
  DownstreamHook.add(hook_name, proc { |server_string|
    if server_string =~ /You are holding .* containers|You are wearing /i
      capturing = true
    end

    if capturing
      captured_lines << server_string
      if server_string =~ /<prompt/i
        capturing = false
        DownstreamHook.remove(hook_name)
      end
    end
    server_string
  })

  put "inv containers"
  wait_until(3) { !DownstreamHook.list.include?(hook_name) }
  DownstreamHook.remove(hook_name) if DownstreamHook.list.include?(hook_name)

  raw_text = captured_lines.join(" ")
  if raw_text =~ /You are wearing\s+(.+?)\./im
    wearing_block = $1
    plain_items = wearing_block.gsub(/<[^>]+>/, "")
    plain_items.split(/,\s*(?:and\s+)?|\s+and\s+/).each do |entry|
      cleaned = clean_container_label(entry)
      next if cleaned.empty?
      next if cleaned =~ /\b(locket|ring|amulet|necklace|bracelet|earring|pin|brooch|crown|tiara|circlet|boots|shoes|sandals|slippers|robes|tunic|shirt|pants|trousers|gloves|gauntlets|helm|shield|buckler)\b/i
      containers << cleaned unless containers.include?(cleaned)
    end
  end

  if containers.empty?
    GameObj.inv.each do |item|
      next if item.noun =~ /^(?:ring|amulet|necklace|bracelet|earring|pin|brooch|locket|boots|shoes|robes|shirt|pants|gloves|helm|shield|sword|dagger|staff|wand|bow|arrow)$/i
      if GameObj.containers.key?(item.id) || item.noun =~ /^(?:pack|backpack|sack|bag|pouch|cloak|greatcloak|longcoat|coat|satchel|tote|rucksack|knapsack|haversack|kit|case|box|chest|bandolier|belt|quiver|scabbard|sheath|harness)$/i
        label = clean_container_label(item.name)
        containers << label unless containers.include?(label)
      end
    end
  end

  containers
end

def inspect_jar(jar)
  look_res = dothistimeout "look in ##{jar.id}", 3, /Inside .* you see|is empty|There is nothing/i

  contents = nil
  count = 0
  is_full = false

  if look_res =~ /Inside .*? you see (\d+) portions? of ([^\.]+)\./i
    count = $1.to_i
    contents = $2.strip.downcase
    is_full = (look_res =~ /It is full\./i) ? true : false
  elsif look_res =~ /Inside .*? you see (?:some |an |a )?([^\.]+)\./i
    count = 1
    contents = $1.strip.downcase
    is_full = (look_res =~ /\bfull\b/i) ? true : false
  end

  {
    id: jar.id,
    contents: contents,
    count: count,
    full: is_full
  }
end

def return_jar_to_containers(jar_entry, jar_containers)
  ordered_bags = []
  preferred = jar_containers.find { |c| c.id == jar_entry[:bag_id] }
  ordered_bags << preferred if preferred
  jar_containers.each { |c| ordered_bags << c unless ordered_bags.include?(c) }

  ordered_bags.each do |bag|
    put_res = dothistimeout "put ##{jar_entry[:id]} in ##{bag.id}", 3, /You put|won't fit|too full|cannot fit|no room|not enough room|could not find/i
    if put_res =~ /You put/i
      jar_entry[:bag_id] = bag.id
      jar_entry[:bag_name] = bag.name
      return true
    end
  end

  false
end

def store_single_item_in_jar(item_id, reagent_name, jar_inventory, jar_containers)
  canonical_plural = pluralize_reagent(reagent_name)

  loop do
    # Priority 1: Non-full jar anywhere in configured containers already holding this item
    target_jar = jar_inventory.find { |j| !j[:full] && matches_reagent?(j[:contents], reagent_name) }

    # Priority 2: Empty jar anywhere in configured containers
    target_jar ||= jar_inventory.find { |j| !j[:full] && (j[:contents].nil? || j[:count] == 0) }

    return :no_jars if target_jar.nil?

    get_jar = dothistimeout "get ##{target_jar[:id]} from ##{target_jar[:bag_id]}", 3, /You remove|Get what\?|Could not find/i
    unless get_jar =~ /You remove/i
      target_jar[:full] = true
      next
    end

    jar_res = dothistimeout "put ##{item_id} in ##{target_jar[:id]}", 3, /into your|into the|You add|is full|won't fit|cannot|That doesn't seem/i

    if jar_res =~ /into your|into the|You add/i
      target_jar[:contents] = canonical_plural if target_jar[:contents].nil?
      target_jar[:count] += 1
      target_jar[:full] = true if jar_res =~ /\bfull\b/i

      unless return_jar_to_containers(target_jar, jar_containers)
        echo "*** Error: Could not fit jar ##{target_jar[:id]} into ANY configured jar container! ***"
        exit
      end

      return :stored
    elsif jar_res =~ /cannot|That doesn't seem/i
      return_jar_to_containers(target_jar, jar_containers)
      return :unjarable
    else
      # Jar is full; mark it full in memory and return to a jar container
      target_jar[:full] = true
      unless return_jar_to_containers(target_jar, jar_containers)
        echo "*** Error: Could not fit jar ##{target_jar[:id]} into ANY configured jar container! ***"
        exit
      end
    end
  end
end

def print_inventory_summary(jar_inventory, jar_containers)
  echo "============================================================"
  echo "=== JAR INVENTORY SUMMARY (#{jar_containers.map(&:name).join(', ')}) ==="
  echo "============================================================"

  occupied = jar_inventory.reject { |j| j[:contents].nil? || j[:count] <= 0 }
  empty_count = jar_inventory.count { |j| j[:contents].nil? || j[:count] <= 0 }

  if occupied.empty?
    echo "  No occupied jars found."
  else
    grouped = occupied.group_by { |j| j[:contents] }
    grouped.keys.sort.each do |reagent_name|
      jars = grouped[reagent_name]
      total_portions = jars.sum { |j| j[:count] }
      full_jars = jars.count { |j| j[:full] }
      partial_jars = jars.length - full_jars
      echo sprintf("  %-32s | Jars: %2d (%d full, %d partial) | Portions: %3d", reagent_name, jars.length, full_jars, partial_jars, total_portions)
    end
  end

  echo "------------------------------------------------------------"
  echo "  Total Jars: #{jar_inventory.length}  |  Occupied: #{occupied.length}  |  Empty: #{empty_count}"
  echo "============================================================"
end

def print_help
  echo "============================================================"
  echo "=== JAR_IT HELP & USAGE GUIDE ==="
  echo "============================================================"
  echo "  ;jar_it"
  echo "      Default jarring mode. Clears hands with STOW, scans all"
  echo "      configured jar bags once via 'look in', caches jar IDs"
  echo "      and capacity in memory, unbundles multi-bite herbs, and"
  echo "      stores all jar-able gems, herbs, creature parts, powders,"
  echo "      and alchemy reagents from your reagent bag."
  echo ""
  echo "  ;jar_it setup"
  echo "      Opens a GTK configuration window to choose your Reagent"
  echo "      Bag and one or more Jar Bags from your worn containers."
  echo ""
  echo "  ;jar_it setup <reagent_bag> <jar_bag1,jar_bag2,...>"
  echo "      Saves your Reagent Bag and Jar Bag(s) directly from the"
  echo "      command line (e.g. ;jar_it setup tote rucksack,sack)."
  echo ""
  echo "  ;jar_it status"
  echo "      Inspects all jars across your configured jar bags via"
  echo "      'look in' without moving items and prints a full summary"
  echo "      of reagents, portion counts, full/partial jars, and empties."
  echo ""
  echo "  ;jar_it clean"
  echo "      Consolidates duplicate non-full jars of the same reagent"
  echo "      across your jar bags by shaking portions out of smaller"
  echo "      jars into the fullest partial jar."
  echo ""
  echo "  ;jar_it <reagent>"
  echo "      Finds a jar containing the specified reagent across your"
  echo "      jar bags and places it in your hand (e.g. ;jar_it blue dust"
  echo "      or ;jar_it ayanad crystal)."
  echo ""
  echo "  ;jar_it empty"
  echo "      Finds an empty jar across your configured jar bags and"
  echo "      places it into your hand."
  echo ""
  echo "  ;jar_it help"
  echo "      Displays this command reference."
  echo "============================================================"
end

# ---------------------------------------------------------
# Parse Arguments
# ---------------------------------------------------------
raw_args = Script.current.vars[0] ? Script.current.vars[0].strip : ""
arg_lower = raw_args.downcase

# ---------------------------------------------------------
# HELP MODE: ;jar_it help
# ---------------------------------------------------------
if arg_lower == "help" || arg_lower == "?" || arg_lower == "-h" || arg_lower == "--help"
  print_help
  exit
end

# ---------------------------------------------------------
# SETUP MODE: ;jar_it setup [reagent_bag] [jar_bags...]
# ---------------------------------------------------------
if arg_lower == "setup" || arg_lower.start_with?("setup ")
  cli_rest = raw_args.sub(/^setup\s*/i, "").strip

  if !cli_rest.empty?
    parts = cli_rest.split(/\s+/, 2)
    if parts.length < 2
      echo "*** CLI Usage: ;jar_it setup <reagent_bag> <jar_bag1,jar_bag2,...> ***"
      exit
    end
    new_reagent_bag = parts[0].strip
    new_jar_bags = parts[1].split(",").map(&:strip).reject(&:empty?)

    CharSettings['reagent_bag'] = new_reagent_bag
    CharSettings['jar_bags'] = new_jar_bags
    Settings.save
    echo "=== Saved settings: Reagent Bag = '#{new_reagent_bag}', Jar Bags = #{new_jar_bags.inspect} ==="
    exit
  end

  worn_containers = fetch_worn_containers
  saved_reagent = CharSettings['reagent_bag'] || "pack"
  saved_jars = CharSettings['jar_bags'] || (CharSettings['jar_bag'] ? [CharSettings['jar_bag']] : ["cloak"])

  done = false
  saved_result = nil

  Gtk.queue {
    window = Gtk::Window.new("jar_it Setup")
    window.set_border_width(12)
    window.set_default_size(420, 380)
    window.set_keep_above(true)

    vbox = Gtk::Box.new(:vertical, 10)
    window.add(vbox)

    # Reagent Bag Selection
    r_label = Gtk::Label.new("Reagent Bag (source of loose reagents):")
    r_label.set_xalign(0.0)
    vbox.pack_start(r_label, expand: false, fill: false, padding: 0)

    r_combo = Gtk::ComboBoxText.new(entry: true)
    worn_containers.each { |c| r_combo.append_text(c) }
    r_combo.child.text = saved_reagent
    vbox.pack_start(r_combo, expand: false, fill: false, padding: 0)

    # Jar Bags Selection (Multi-Container Checkboxes)
    j_label = Gtk::Label.new("Jar Bags (select one or more containers holding jars):")
    j_label.set_xalign(0.0)
    vbox.pack_start(j_label, expand: false, fill: false, padding: 4)

    scrolled = Gtk::ScrolledWindow.new
    scrolled.set_policy(:automatic, :automatic)
    scrolled.set_min_content_height(150)
    vbox.pack_start(scrolled, expand: true, fill: true, padding: 0)

    check_box_list = Gtk::Box.new(:vertical, 4)
    scrolled.add(check_box_list)

    checkboxes = {}
    worn_containers.each do |c|
      cb = Gtk::CheckButton.new(c)
      if saved_jars.any? { |sj| sj.downcase == c.downcase || c.downcase.include?(sj.downcase) }
        cb.active = true
      end
      checkboxes[c] = cb
      check_box_list.pack_start(cb, expand: false, fill: false, padding: 0)
    end

    # Extra manual jar bags entry
    extra_label = Gtk::Label.new("Additional Jar Bags (optional, comma-separated):")
    extra_label.set_xalign(0.0)
    vbox.pack_start(extra_label, expand: false, fill: false, padding: 0)

    extra_entry = Gtk::Entry.new
    unmatched_saved = saved_jars.reject do |sj|
      worn_containers.any? { |c| sj.downcase == c.downcase || c.downcase.include?(sj.downcase) }
    end
    extra_entry.text = unmatched_saved.join(", ")
    vbox.pack_start(extra_entry, expand: false, fill: false, padding: 0)

    # Buttons
    btn_box = Gtk::Box.new(:horizontal, 8)
    save_btn = Gtk::Button.new(label: "Save")
    cancel_btn = Gtk::Button.new(label: "Cancel")
    btn_box.pack_end(save_btn, expand: false, fill: false, padding: 0)
    btn_box.pack_end(cancel_btn, expand: false, fill: false, padding: 0)
    vbox.pack_start(btn_box, expand: false, fill: false, padding: 4)

    save_btn.signal_connect("clicked") do
      chosen_reagent = (r_combo.active_text || r_combo.child.text).to_s.strip
      chosen_jars = checkboxes.select { |_, cb| cb.active? }.keys
      extra_entry.text.to_s.split(",").each do |ex|
        cleaned = ex.strip
        chosen_jars << cleaned unless cleaned.empty? || chosen_jars.include?(cleaned)
      end

      saved_result = { reagent_bag: chosen_reagent, jar_bags: chosen_jars }
      window.destroy
      done = true
    end

    cancel_btn.signal_connect("clicked") do
      window.destroy
      done = true
    end

    window.signal_connect("destroy") { done = true }

    window.show_all
    window.present
  }

  wait_until { done }

  if saved_result
    if saved_result[:reagent_bag].empty? || saved_result[:jar_bags].empty?
      echo "*** Setup cancelled or incomplete: please select a Reagent Bag and at least one Jar Bag. ***"
    else
      CharSettings['reagent_bag'] = saved_result[:reagent_bag]
      CharSettings['jar_bags'] = saved_result[:jar_bags]
      Settings.save
      echo "=== Saved settings: Reagent Bag = '#{saved_result[:reagent_bag]}', Jar Bags = #{saved_result[:jar_bags].inspect} ==="
    end
  else
    echo "=== Setup cancelled. ==="
  end

  exit
end

# ---------------------------------------------------------
# Load Configured Containers
# ---------------------------------------------------------
reagent_bag_name = CharSettings['reagent_bag'] || "pack"
jar_bag_names = CharSettings['jar_bags'] || (CharSettings['jar_bag'] ? [CharSettings['jar_bag']] : ["cloak"])

jar_containers = []
jar_bag_names.each do |bname|
  found = find_worn_container(bname)
  if found
    jar_containers << found unless jar_containers.include?(found)
  else
    echo "*** Warning: Could not find configured jar container '#{bname}' worn on you. ***"
  end
end

if jar_containers.empty?
  echo "*** No valid jar containers found! Run ';jar_it setup' to configure. ***"
  exit
end

# ---------------------------------------------------------
# STATUS MODE: ;jar_it status (no hand stowing or item moves)
# ---------------------------------------------------------
if arg_lower == "status"
  jar_inventory = []

  jar_containers.each do |bag|
    dothistimeout "look in ##{bag.id}", 3, /In the|There is nothing|That is closed/i
    wait_until(2) { !bag.contents.nil? }
    next if bag.contents.nil?

    jars_in_bag = bag.contents.select { |item| item.noun =~ /jar|beaker|bottle/i || item.name =~ /\bjar\b/i }
    jars_in_bag.each do |jar|
      info = inspect_jar(jar)
      info[:bag_id] = bag.id
      info[:bag_name] = bag.name
      jar_inventory << info
    end
  end

  print_inventory_summary(jar_inventory, jar_containers)
  exit
end

# ---------------------------------------------------------
# PHASE 0: Clear hands first using STOW
# ---------------------------------------------------------
if !GameObj.right_hand.id.nil? || !GameObj.left_hand.id.nil?
  dothistimeout "stow all", 3, /You put|You are not holding anything|You have nothing/i
  waitrt?

  if !GameObj.right_hand.id.nil? || !GameObj.left_hand.id.nil?
    echo "*** Could not clear hands with STOW! Please empty your hands and restart. ***"
    exit
  end
end

# Refresh XML contents for all configured jar containers
jar_containers.each do |bag|
  dothistimeout "look in ##{bag.id}", 3, /In the|There is nothing|That is closed/i
  wait_until(2) { !bag.contents.nil? }
end

# ---------------------------------------------------------
# FETCH MODE: ;jar_it <reagent> OR ;jar_it empty
# ---------------------------------------------------------
if !arg_lower.empty? && arg_lower != "clean"
  if arg_lower == "empty" || arg_lower == "empty jar"
    echo "=== Searching #{jar_containers.map(&:name).join(', ')} for an empty jar ==="
    found_jar = nil
    found_bag = nil

    jar_containers.each do |bag|
      next if bag.contents.nil?
      jars_in_bag = bag.contents.select { |item| item.noun =~ /jar|beaker|bottle/i || item.name =~ /\bjar\b/i }

      jars_in_bag.each do |jar|
        next if jar.name =~ /containing\b/i

        info = inspect_jar(jar)
        if info[:contents].nil? || info[:count] == 0
          found_jar = jar
          found_bag = bag
          break
        end
      end
      break if found_jar
    end

    if found_jar
      dothistimeout "get ##{found_jar.id} from ##{found_bag.id}", 3, /You remove|Get what\?/i
      echo "=== Grabbed empty jar (##{found_jar.id}) from #{found_bag.name} ==="
    else
      echo "*** Could not find any empty jars across your configured jar containers! ***"
    end
    exit
  end

  echo "=== Searching #{jar_containers.map(&:name).join(', ')} for a jar of #{raw_args} ==="
  found_jar = nil
  found_bag = nil

  jar_containers.each do |bag|
    next if bag.contents.nil?
    jars_in_bag = bag.contents.select { |item| item.noun =~ /jar|beaker|bottle/i || item.name =~ /\bjar\b/i }

    jars_in_bag.each do |jar|
      if jar.name =~ /containing (?:some |an |a )?(.+)$/i
        xml_contents = $1.strip.downcase
        if matches_reagent?(xml_contents, arg_lower)
          found_jar = jar
          found_bag = bag
          break
        end
      end

      info = inspect_jar(jar)
      if matches_reagent?(info[:contents], arg_lower)
        found_jar = jar
        found_bag = bag
        break
      end
    end
    break if found_jar
  end

  if found_jar
    dothistimeout "get ##{found_jar.id} from ##{found_bag.id}", 3, /You remove|Get what\?/i
    echo "=== Grabbed jar of #{raw_args} (##{found_jar.id}) from #{found_bag.name} ==="
  else
    echo "*** Could not find any jar containing #{raw_args} across your configured jar containers! ***"
  end

  exit
end

# ---------------------------------------------------------
# PHASE 1: Scan and cache all jars across all configured bags
# ---------------------------------------------------------
echo "=== Scanning jars across #{jar_containers.length} container(s): #{jar_containers.map(&:name).join(', ')} ==="
jar_inventory = []

jar_containers.each do |bag|
  next if bag.contents.nil?
  jars_in_bag = bag.contents.select { |item| item.noun =~ /jar|beaker|bottle/i || item.name =~ /\bjar\b/i }

  jars_in_bag.each do |jar|
    info = inspect_jar(jar)
    info[:bag_id] = bag.id
    info[:bag_name] = bag.name
    jar_inventory << info
  end
end

echo "=== Cached #{jar_inventory.length} jars in memory across #{jar_containers.length} container(s) ==="

# ---------------------------------------------------------
# CLEAN MODE: ;jar_it clean
# ---------------------------------------------------------
if arg_lower == "clean"
  echo "=== Consolidating duplicate non-full jars across configured containers ==="

  partials_by_reagent = jar_inventory
    .select { |j| !j[:full] && !j[:contents].nil? && j[:count] > 0 }
    .group_by { |j| j[:contents] }

  combined_any = false

  partials_by_reagent.each do |reagent_name, group|
    next if group.length < 2

    combined_any = true
    echo "=== Combining #{group.length} partial jars of #{reagent_name} ==="

    sorted = group.sort_by { |j| -j[:count] }
    target = sorted.shift

    sorted.each do |source|
      if target[:full]
        target = source
        next
      end

      loop do
        break if source[:count] <= 0 || target[:full]

        # 1. Pull donor jar from its bag into hand (other hand remains free for shake)
        get_src = dothistimeout "get ##{source[:id]} from ##{source[:bag_id]}", 3, /You remove|Get what\?|Could not find/i
        break unless get_src =~ /You remove/i

        # 2. Shake one portion out into our free hand
        shake_res = dothistimeout "shake ##{source[:id]}", 3, /give your jar a hard shake|You shake|That was the last|is empty|nothing in/i

        if shake_res =~ /That was the last|is empty|nothing in/i
          source[:count] = 0
          source[:contents] = nil
          unless return_jar_to_containers(source, jar_containers)
            echo "*** Error: Could not fit empty donor jar ##{source[:id]} into any configured container! ***"
            exit
          end
          break
        elsif shake_res =~ /give your jar a hard shake|You shake/i
          wait_until(2) do
            [GameObj.right_hand, GameObj.left_hand].any? { |h| !h.id.nil? && h.id != source[:id] }
          end
          shaken_item = [GameObj.right_hand, GameObj.left_hand].find { |h| !h.id.nil? && h.id != source[:id] }

          source[:count] -= 1
          if source[:count] <= 0
            source[:count] = 0
            source[:contents] = nil
          end

          # 3. Return donor jar so a hand opens up for holding the target jar
          unless return_jar_to_containers(source, jar_containers)
            echo "*** Error: Could not fit donor jar ##{source[:id]} into any configured container! ***"
            exit
          end

          if shaken_item
            # 4. Pull target jar into open hand and put shaken item inside
            get_tgt = dothistimeout "get ##{target[:id]} from ##{target[:bag_id]}", 3, /You remove|Get what\?|Could not find/i
            if get_tgt =~ /You remove/i
              put_res = dothistimeout "put ##{shaken_item.id} in ##{target[:id]}", 3, /into your|into the|You add|is full|won't fit|cannot/i

              if put_res =~ /into your|into the|You add/i
                target[:count] += 1
                target[:full] = true if put_res =~ /\bfull\b/i
                unless return_jar_to_containers(target, jar_containers)
                  echo "*** Error: Could not fit target jar ##{target[:id]} into any configured container! ***"
                  exit
                end
              else
                # Target was actually full; put shaken item back into donor jar
                target[:full] = true
                unless return_jar_to_containers(target, jar_containers)
                  echo "*** Error: Could not fit target jar ##{target[:id]} into any configured container! ***"
                  exit
                end

                dothistimeout "get ##{source[:id]} from ##{source[:bag_id]}", 3, /You remove/i
                dothistimeout "put ##{shaken_item.id} in ##{source[:id]}", 3, /into your|into the|You add/i
                source[:count] += 1
                source[:contents] = reagent_name
                unless return_jar_to_containers(source, jar_containers)
                  echo "*** Error: Could not fit donor jar ##{source[:id]} into any configured container! ***"
                  exit
                end
                break
              end
            end
          end
        else
          unless return_jar_to_containers(source, jar_containers)
            echo "*** Error: Could not fit donor jar ##{source[:id]} into any configured container! ***"
            exit
          end
          break
        end
      end

      if target[:full] && source[:count] > 0
        target = source
      end
    end
  end

  if combined_any
    echo "=== Finished consolidating partial jars! ==="
  else
    echo "=== No duplicate partial jars found. Your jar bags are already clean! ==="
  end

  print_inventory_summary(jar_inventory, jar_containers)
  exit
end

# ---------------------------------------------------------
# PHASE 2: Default Jarring Mode (;jar_it)
# ---------------------------------------------------------
reagent_container = find_worn_container(reagent_bag_name)
if reagent_container.nil?
  echo "*** Could not find container '#{reagent_bag_name}' worn on you! Run ';jar_it setup' to configure. ***"
  exit
end

dothistimeout "look in ##{reagent_container.id}", 3, /In the|There is nothing|That is closed/i
wait_until(2) { !reagent_container.contents.nil? }

if reagent_container.contents.nil? || reagent_container.contents.empty?
  echo "=== #{reagent_container.name} is empty! ==="
  print_inventory_summary(jar_inventory, jar_containers)
  exit
end

echo "=== Starting Jarring Routine from #{reagent_container.name} ==="

jarable_items = reagent_container.contents.select { |item| jarable?(item) }
skipped_reagents = {}

jarable_items.each do |item|
  reagent_name = normalize_reagent_name(item.name)
  next if skipped_reagents[reagent_name]

  res = dothistimeout "get ##{item.id} from ##{reagent_container.id}", 3, /You remove|Get what\?|Could not find/i
  next unless res =~ /You remove/i

  # Determine if item is a multi-portion bundle (either "bundle of ..." or multi-bite herb)
  is_bundle = (item.name =~ /^bundle of /i) ? true : false
  if !is_bundle && item.name =~ BUNDLED_HERB_REGEX
    measure_res = dothistimeout "measure ##{item.id}", 3, /has (\d+) (?:bite|bites) left|can't tell exactly/i
    is_bundle = true if measure_res =~ /has (\d+) (?:bite|bites) left/i && $1.to_i > 1
  end

  if is_bundle
    echo "=== Unbundling #{item.name} to store in jars ==="
    bundle_active = true

    while bundle_active
      # Ensure the bundle is currently in hand before calling bundle remove
      in_hands = [GameObj.right_hand, GameObj.left_hand].any? { |h| h.id == item.id }
      unless in_hands
        pull_bundle = dothistimeout "get ##{item.id} from ##{reagent_container.id}", 3, /You remove|Get what\?|Could not find/i
        break unless pull_bundle =~ /You remove/i
      end

      rem_res = dothistimeout "bundle remove", 3, /You (?:carefully )?remove|Those were the last two|You only have one|You do not have|cannot be unbundled/i

      if rem_res =~ /You only have one|You do not have|cannot be unbundled/i
        # Only 1 portion left in hand; jar it directly
        status = store_single_item_in_jar(item.id, reagent_name, jar_inventory, jar_containers)
        if status != :stored
          dothistimeout "put ##{item.id} in ##{reagent_container.id}", 3, /You put/i
          skipped_reagents[reagent_name] = true
        end
        bundle_active = false
      elsif rem_res =~ /Those were the last two/i
        # Both hands now hold 1 individual portion each
        sleep 0.1
        hand_items = [GameObj.right_hand, GameObj.left_hand].reject { |h| h.id.nil? }
        hand_items.each do |piece|
          status = store_single_item_in_jar(piece.id, reagent_name, jar_inventory, jar_containers)
          if status != :stored
            dothistimeout "put ##{piece.id} in ##{reagent_container.id}", 3, /You put/i
            skipped_reagents[reagent_name] = true
          end
        end
        bundle_active = false
      elsif rem_res =~ /You (?:carefully )?remove/i
        sleep 0.1
        # Identify the newly separated single item vs the remaining bundle
        single_piece = [GameObj.right_hand, GameObj.left_hand].find { |h| !h.id.nil? && h.id != item.id }

        # Immediately return the remaining bundle to reagent_container to free a hand for the jar!
        dothistimeout "put ##{item.id} in ##{reagent_container.id}", 3, /You put/i

        if single_piece
          status = store_single_item_in_jar(single_piece.id, reagent_name, jar_inventory, jar_containers)
          if status != :stored
            echo "*** No more jars available for #{reagent_name}. Returning piece to #{reagent_container.name}. ***"
            dothistimeout "put ##{single_piece.id} in ##{reagent_container.id}", 3, /You put/i
            skipped_reagents[reagent_name] = true
            bundle_active = false
          end
        else
          bundle_active = false
        end
      else
        dothistimeout "put ##{item.id} in ##{reagent_container.id}", 3, /You put/i
        bundle_active = false
      end

      waitrt?
    end
  else
    status = store_single_item_in_jar(item.id, reagent_name, jar_inventory, jar_containers)
    if status != :stored
      echo "*** Could not jar #{item.name} (no jars left or unjarable). Returning to #{reagent_container.name}. ***"
      dothistimeout "put ##{item.id} in ##{reagent_container.id}", 3, /You put/i
      skipped_reagents[reagent_name] = true
    end
    waitrt?
  end
end

echo "=== Finished jarring reagents! ==="
print_inventory_summary(jar_inventory, jar_containers)
