=begin  
  ============================================================
  EBON GATE 2026 CAROUSEL RIDING SCRIPT
  VERSION 1.2
  ============================================================
  Original script Kaldonis
  New version by Tenaro
  Usage:
  ;carousel2026 (one run spending 10000 is the default behavior)
  ;carousel2026 15000 (limits spending to this number)
    this will withdraw in 10k increments, so if you put 12500, 
    it will grab 10000 coins then go back for the remaining 2500
  ;carousel2026 --unlimited (will spend until you have no coins in the bank)
  ============================================================
=end

require 'timeout'

silence_me

# ------------------------------------------------------------
# CONFIGURATION
# ------------------------------------------------------------

START_ROOM = '36869'
CAROUSEL_ROOM = '23165'
BANK_ROOM = 'bank'

DEFAULT_BANKROLL = 10_000
GAME_COST = 500

RESPONSE_TIMEOUT = 20
MAX_MOUNT_ATTEMPTS = 7

CAROUSEL_ROOMS = %w[23169 23166 23165]

# ------------------------------------------------------------
# STARTING BANKROLL
# ------------------------------------------------------------

args = Script.current.vars

# Display help when called with ;carousel2026 help.
# Lich may set __FILE__ to the script name rather than a readable path,
# so keep this help text inline instead of trying to read the source file.
if args[1].to_s.downcase == 'help'
  help_lines = [
    '''============================================================
    EBON GATE 2026 CAROUSEL RIDING SCRIPT
    VERSION 1.2
    ============================================================
    Original script Kaldonis
    New version by Tenaro
    Usage:
    ;carousel2026 (one run spending 10000 is the default behavior)
    ;carousel2026 15000 (limits spending to this number)
      this will withdraw in 10k increments, so if you put 12500,
      it will grab 10000 coins then go back for the remaining 2500
    ;carousel2026 --unlimited (will spend until you have no coins in the bank)
    ==========================================================='''
  ]
  help_lines.each { |line| echo line }
  exit
end

bankroll_arg = args[1]

begin
  bankroll = if bankroll_arg.nil? || bankroll_arg.empty?
               DEFAULT_BANKROLL
             else
               Integer(bankroll_arg, 10)
             end
rescue ArgumentError
  #echo 'Invalid bankroll amount.'
  exit
end

if bankroll <= 0
  #echo 'Bankroll must be greater than zero.'
  exit
end

if bankroll < GAME_COST
  #echo "Bankroll must be at least #{GAME_COST} silver."
  exit
end

# Only complete 500-silver games are permitted.
bankroll = (bankroll / GAME_COST) * GAME_COST

silver_spent = 0
hook_name = 'carousel2026_v72'

# ------------------------------------------------------------
# RESPONSE PATTERNS
# ------------------------------------------------------------

PAYMENT_SUCCESS = /You hand over the coins/

PAYMENT_FAILURE = /Finding that you do not have the coins|You do not have enough silver to play this game|If you ain't paying/i

RIDE_RESULT = /Great job|miss the rings by several feet|lose your balance and go tumbling off|Since you fell off your carousel animal|pick up some Ebon Gate prize tickets|need at least one hand free|have too many items|unable to handle the additional load/i

# ------------------------------------------------------------
# PLAYER SPAM FILTER + GAME TEXT CAPTURE
# ------------------------------------------------------------

roomspam = /removes <a exist="\d+" noun="tickets">some Ebon Gate prize tickets|combines the value of|reaches away from (his|her) carousel animal|connects with the rings and comes away with|misses the rings by several feet and goes tumbling off|stands up|struggles to stand|climbs on top of|together before jumping off the moving platform of|put <a exist="\d+" noun="tickets">/i

carousel_capture_active = false
carousel_capture_text = +''

DownstreamHook.add(
  hook_name,
  proc do |line|
    if carousel_capture_active
      carousel_capture_text << line.to_s << "\n"
    end

    line =~ roomspam ? nil : line
  end,
  persist: false
)

# ------------------------------------------------------------
# HELPERS
# ------------------------------------------------------------

wait_for_line = lambda do |pattern, seconds = RESPONSE_TIMEOUT|
  begin
    Timeout.timeout(seconds) do
      wait_until do
        line = get
        line && line.match?(pattern)
      end
    end
  rescue Timeout::Error
    nil
  end
end

# ------------------------------------------------------------
# SILVER BALANCE VERIFICATION
# ------------------------------------------------------------

verify_silver = lambda do
  actual_silver = Lich::Util.silver_count(5)

  echo "Current carried silver: #{actual_silver}"
  #echo "Required game cost: #{GAME_COST}"

  if actual_silver < GAME_COST
    #echo 'Insufficient carried silver.'
    false
  else
    #echo 'Silver balance verified.'
    true
  end
end

# ------------------------------------------------------------
# HAND INSPECTION AND AUTOMATIC TICKET DEPOSIT
# ------------------------------------------------------------

deposit_held_ticket = lambda do
  MAX_TICKET_DEPOSITS = 10

  deposits = 0
  completed = false

  #echo 'Checking both hands for carousel tickets.'

  while deposits < MAX_TICKET_DEPOSITS
    waitrt?

    carousel_capture_text = +''
    carousel_capture_active = true

    fput 'glance'
    waitrt?

    carousel_capture_active = false

    hands = carousel_capture_text.dup

    # Check specifically for ticket objects in either hand.
    # Empty hands and worn inventory do not count.

    if hands =~ /<(?:right|left) exist="\d+" noun="ticket">|<(?:right|left) exist="\d+" noun="ticket"/i
      carousel_capture_text = +''
      carousel_capture_active = true

      response = fput 'get ticket'
      waitrt?

      carousel_capture_active = false

      deposit_response = carousel_capture_text.dup

      if deposit_response =~ /You pick up .*General ticket/i
        deposits += 1
        echo "Successful ticket deposits: #{deposits}"
      else
        break
      end
    else
      completed = true
      break
    end
  end

  completed || deposits > 0
end

# ------------------------------------------------------------
# TRAVEL
# ------------------------------------------------------------

travel = lambda do |destination|
  start_script 'go2', [destination]
  wait_while { running?('go2') }
  true
end

# ------------------------------------------------------------
# CAROUSEL ENTRY
# ------------------------------------------------------------

enter_carousel = lambda do
  room = Room.current

  if room && CAROUSEL_ROOMS.include?(room.id.to_s)
    next true
  end

  unless room && room.id.to_s == START_ROOM
    next false
  end
  fput 'go carousel'
  waitrt?

  room = Room.current

  if room && CAROUSEL_ROOMS.include?(room.id.to_s)
    true
  else
    false
  end
end

# ------------------------------------------------------------
# BANKING ROUTINE
# ------------------------------------------------------------

get_money = lambda do
  start_script 'go2', ['bank', '--disable-confirm']
  wait_while { running?('go2') }

  waitrt?

  fput 'depo all'
  waitrt?

  # Never withdraw more than 10,000 silver or the remaining
  # amount allowed by the total spending limit.
  withdrawal_amount = [DEFAULT_BANKROLL, bankroll - silver_spent].min

  fput "withdraw #{withdrawal_amount} sil"
  waitrt?

  actual_silver = Lich::Util.silver_count(5)

  unless actual_silver == withdrawal_amount
    raise 'Bankroll verification failed.'
  end

  travel.call(START_ROOM)

  deposit_held_ticket.call

  unless enter_carousel.call
    raise 'Unable to re-enter carousel after banking.'
  end

  true
end

# ------------------------------------------------------------
# INITIAL BANKROLL VERIFICATION
# ------------------------------------------------------------

verify_starting_bankroll = lambda do
  actual_silver = Lich::Util.silver_count(5)

  # For limits of 10,000 or less, use silver already carried if
  # sufficient. For larger limits, start with a 10,000 withdrawal.
  if bankroll <= DEFAULT_BANKROLL && actual_silver >= bankroll
    next true
  end

  get_money.call

  actual_silver = Lich::Util.silver_count(5)
  expected_starting_silver = [DEFAULT_BANKROLL, bankroll].min

  unless actual_silver == expected_starting_silver
    raise 'Starting bankroll verification failed.'
  end

  true
end

# ------------------------------------------------------------
# DYNAMIC CAROUSEL ANIMAL SEARCH
# ------------------------------------------------------------

mount_animal = lambda do
  waitrt?

  carousel_capture_text = +''
  carousel_capture_active = true

  response = fput(
    'look at creatures',
    /You gaze around at the wooden carousel creatures/
  )

  if response.nil?
    response = fput(
      'look at beasts',
      /Drifting globules|wooden beasts/i
    )
  end

  unless response
    carousel_capture_active = false
    next false
  end

  unless carousel_capture_text =~ /yellow and red iron wire bin/i
    wait_for_line.call(
      /yellow and red iron wire bin.*middle of the creatures/i,
      5
    )
  end

  carousel_capture_active = false

  description = carousel_capture_text.dup

  description.gsub!(/<[^>]*>/, ' ')
  description.gsub!(/\s+/, ' ')
  description.strip!

  description.sub!(
    /\A.*?wooden carousel creatures in the area\.\s*/i,
    ''
  )

  description.sub!(
    /A yellow and red iron wire bin.*\z/i,
    ''
  )

  animals = description.scan(
    /\b(?:a|an)\s+(.+?)(?=\s+and\s+(?:a|an)\s+|\s*,|\s+while\s+|\s+are\s+|\s*[.;]|\z)/i
  ).flatten

  animals = animals.map do |animal|
    animal.strip.sub(/[,.]+\z/, '')
  end.reject do |animal|
    animal.empty?
  end.uniq

  unless animals.any?
    next false
  end

  mounted = false

  animals.each do |animal|
    animal_noun = animal.split.last

    waitrt?

    carousel_capture_text = +''
    carousel_capture_active = true

    fput(
      "climb #{animal_noun}",
      /You climb on top of|You are already sitting on|already on a|I could not find what you were referring to|Pick another animal|cannot find|cannot climb/i
    )

    carousel_capture_active = false

    climb_response = carousel_capture_text.to_s

    if climb_response =~ /You climb on top of/i
      mounted = true
      break
    end

    if climb_response =~ /You are already sitting on/i
      mounted = true
      break
    end

    if climb_response =~ /already on a/i
      next
    end

    if climb_response =~ /You are already on/i
      mounted = true
      break
    end
  end

  mounted
end

# ------------------------------------------------------------
# REQUEST ONE GAME
# ------------------------------------------------------------

play_one_game = lambda do
  waitrt?

  if silver_spent + GAME_COST > bankroll
    next :limit
  end

  unless verify_silver.call
    next :money
  end

  carousel_capture_text = +''
  carousel_capture_active = true

  fput 'get ticket'

  initial_deadline = Time.now + RESPONSE_TIMEOUT

  until carousel_capture_text =~ /You motion to the game tickets|You need at least one hand free|You have too many items|You hand over the coins|Finding that you do not have the coins|You do not have enough silver to play this game|you need to be on an animal first/i || Time.now >= initial_deadline
    sleep 0.2
  end

  if carousel_capture_text =~ /you need to be on an animal first/i
    carousel_capture_active = false
    next :mount
  end

  if carousel_capture_text =~ /You need at least one hand free|You have too many items/i
    carousel_capture_active = false
    next :inventory
  end

  unless carousel_capture_text =~ /You motion to the game tickets|You hand over the coins|Finding that you do not have the coins|You do not have enough silver to play this game/i
    carousel_capture_active = false
    next :timeout
  end

  payment = nil
  payment_deadline = Time.now + RESPONSE_TIMEOUT

  until payment || Time.now >= payment_deadline
    if carousel_capture_text =~ /You hand over the coins|Finding that you do not have the coins|You do not have enough silver to play this game|If you ain't paying|You need at least one hand free|You have too many items|unable to handle the additional load/i
      payment = carousel_capture_text.dup
    else
      sleep 0.2
    end
  end

  unless payment
    carousel_capture_active = false
    next :timeout
  end

  if payment =~ /You need at least one hand free|You have too many items|unable to handle the additional load/i
    carousel_capture_active = false
    next :inventory
  end

  if payment =~ PAYMENT_FAILURE
    carousel_capture_active = false
    next :money
  end

  unless payment =~ PAYMENT_SUCCESS
    carousel_capture_active = false
    next :timeout
  end

  silver_spent += GAME_COST

  payment_match = carousel_capture_text.match(PAYMENT_SUCCESS)

  if payment_match
    carousel_capture_text =
      carousel_capture_text[payment_match.end(0)..-1].to_s
  else
    carousel_capture_text = +''
  end

  result = nil
  result_deadline = Time.now + 90

  result_patterns = /
    Great\ job|
    miss\ the\ rings\ by\ several\ feet|
    lose\ your\ balance\ and\ go\ tumbling\ off|
    pick\ up\ some\ Ebon\ Gate\ prize\ tickets|
    need\ at\ least\ one\ hand\ free|
    have\ too\ many\ items|
    unable\ to\ handle\ the\ additional\ load
  /ix

  until result || Time.now >= result_deadline
    captured = carousel_capture_text.to_s

    if captured =~ result_patterns
      result = captured
    else
      sleep 0.2
    end
  end

  carousel_capture_active = false

  unless result
    next :timeout
  end

  if result =~ /need at least one hand free|have too many items|unable to handle the additional load/i
    next :inventory
  end

  if result =~ /lose your balance and go tumbling off|miss the rings by several feet/i
    carousel_capture_text = +''
    carousel_capture_active = true

    stand_response = fput "stand"

    stand_confirmed = stand_response.to_s =~ /You stand back up|You are already standing/i

    stand_deadline = Time.now + 15

    until stand_confirmed || Time.now >= stand_deadline
      stand_confirmed = carousel_capture_text =~ /You stand back up|You are already standing/i
      sleep 0.2 unless stand_confirmed
    end

    carousel_capture_active = false

    unless stand_confirmed
      next :timeout
    end

    next :mount
  end

  if result =~ /Great job|pick up some Ebon Gate prize tickets/i
    next :continue
  end

  if result =~ /Since you fell off your carousel animal/i
    next :mount
  end

  :continue
end
# ------------------------------------------------------------
# FINAL TICKET COLLECTION
# ------------------------------------------------------------

collect_final_tickets = lambda do
  waitrt?

  travel.call(START_ROOM)

  unless Room.current && Room.current.id.to_s == START_ROOM
    raise 'Unable to reach starting room for final ticket collection.'
  end

  # Deposit held tickets only. Do not withdraw more silver here.
  deposit_held_ticket.call
end

# ------------------------------------------------------------
# AUTOMATIC INVENTORY RECOVERY
# ------------------------------------------------------------

consecutive_recovery_failures = 0
MAX_CONSECUTIVE_RECOVERY_FAILURES = 3

recover_inventory = lambda do
  travel.call(START_ROOM)

  unless Room.current && Room.current.id.to_s == START_ROOM
    consecutive_recovery_failures += 1
    next false
  end

  unless deposit_held_ticket.call
    echo 'DEBUG: Ticket deposit or hand-clear verification failed.'
    consecutive_recovery_failures += 1
    next false
  end

  unless enter_carousel.call
    consecutive_recovery_failures += 1
    next false
  end

  unless mount_animal.call
    consecutive_recovery_failures += 1
    next false
  end

  consecutive_recovery_failures = 0
  true
end

# ------------------------------------------------------------
# MAIN SCRIPT
# ------------------------------------------------------------

begin
  echo "Starting bankroll: #{bankroll} silver."

  # Obtain the first batch before traveling to the carousel.
  verify_starting_bankroll.call

  unless Room.current && Room.current.id.to_s == START_ROOM
    travel.call(START_ROOM)
  end

  unless Room.current && Room.current.id.to_s == START_ROOM
    raise 'Did not reach carousel starting room 36869.'
  end

  deposit_held_ticket.call

  unless enter_carousel.call
    raise 'Unable to enter carousel.'
  end

  unless mount_animal.call
    raise 'Unable to mount a carousel animal.'
  end

  # ----------------------------------------------------------
  # MAIN GAME LOOP
  # ----------------------------------------------------------

  loop do
    waitrt?

    result = play_one_game.call

    case result
    when :money
      get_money.call

      unless mount_animal.call
        raise 'Unable to remount after banking.'
      end

    when :mount
      waitrt?
      fput 'stand'
      waitrt?

      unless mount_animal.call
        raise 'Unable to remount.'
      end

    when :inventory
      if recover_inventory.call
        # Recovery succeeded; continue playing.
      else
        if consecutive_recovery_failures >= MAX_CONSECUTIVE_RECOVERY_FAILURES
          collect_final_tickets.call
          break
        else
          next
        end
      end

    when :limit
      collect_final_tickets.call
      break

    when :timeout
      collect_final_tickets.call
      break

    when :continue
      if silver_spent >= bankroll
        collect_final_tickets.call
        break
      end

    else
      collect_final_tickets.call
      break
    end
  end

rescue Interrupt
  begin
    collect_final_tickets.call
  rescue StandardError => error
    #echo "Final ticket collection failed: #{error.message}"
  end

rescue StandardError => error
  #echo "Carousel error: #{error.class}: #{error.message}"
  echo error.backtrace.first(8).join("\n")

ensure
  carousel_capture_active = false
  DownstreamHook.remove(hook_name)
end
