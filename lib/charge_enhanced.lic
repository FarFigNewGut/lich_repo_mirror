# charge_enhanced.lic
# written by grok prompted by Malvash
# Direct Message Malvash on GS4 Discord for any issues
# version: 1.11
# changes:
#   1.11 use item numbers instead of names
#   1.10 go2 options before target; order 5 with item in hand
#   1.9 version stamp, dedupe before list, no Unknown
#   1.8 one warning, under 4 charges, no duplicate or Unknown
#   1.7 no pause before treasuremaster, warn on the list
#   1.6 quiet go2, quote worn item
#   1.5 low-charge warning list first, stats on top
#   1.4 strip Lich item links so names match once
#   1.3 respond list, silence_me, Proc hide hook, 1 / 1 CONFIRM
#   1.2 hide attempt, ;send choice, 30s timeout
#   1.1 recall after quote, under 10 charges, room warning
#   1.0 treasuremaster recharge from enhancive list
#
#   Usage:
#   ;charge_enhanced
#   ;charge_enhanced -type strength
#   ;charge_enhanced 1
#   ;charge_enhanced 1 CONFIRM
#
#   Prerequisites:
#   Script go2 is required for moving to the treasuremaster
#
#   Intro:
#   The script charge_enhanced.lic lists your enhancive gear that is under 10 charges and, on request, prices or buys a 10-charge refill from the nearest Treasure Master with bounty points.
#
#;charge_enhanced
#Reads inventory enhancive and your unspent bounty points, then prints the low-charge items grouped by stat or skill, with bonus and charges. 
#Items under 4 charges are warned first. Items with 10 or more charges are left off the list. 
#
#;charge_enhanced -type strength 
#Limits the list to one stat or skill. Short names work: str, con, dex, agi, dis, aur, log, int, wis, inf, plus mana, health, stamina, and spirit.
#
#;charge_enhanced 5 
#Walks you to the nearest Treasure Master, recalls the item, and asks the price to refill it. 
#It reports whether the item persists or crumbles when the last enhancive charge is used, the bounty cost, and what you would have left. It does not spend points. 
#
#;charge_enhanced 5 CONFIRM 
#Places that order and wears the item again. A quote stays open for 30 seconds, so a second quote cancels the leftover order first.

no_kill_all
VERSION = '1.10'
$ce_buf = []
$ce_hide = false
TYPE_ALIASES = {
  'str' => 'strength', 'strength' => 'strength',
  'con' => 'constitution', 'constitution' => 'constitution',
  'dex' => 'dexterity', 'dexterity' => 'dexterity',
  'agi' => 'agility', 'agility' => 'agility',
  'dis' => 'discipline', 'discipline' => 'discipline',
  'aur' => 'aura', 'aura' => 'aura',
  'log' => 'logic', 'logic' => 'logic',
  'int' => 'intuition', 'intuition' => 'intuition',
  'wis' => 'wisdom', 'wisdom' => 'wisdom',
  'inf' => 'influence', 'influence' => 'influence',
  'mana' => 'mana', 'health' => 'health', 'stamina' => 'stamina', 'spirit' => 'spirit'
}.freeze
def say(msg)
  respond strip_tags(msg)
end
def strip_tags(text)
  text.to_s.gsub(/<[^>]*>/, '').gsub(/[ \t]+/, ' ').strip
end
def commas(n)
  n.to_s.reverse.gsub(/(\d{3})(?=\d)/, '\\1,').reverse
end
def start_hide
  return if $ce_hide
  $ce_buf = []
  hook = proc { |line|
    $ce_buf << line.to_s
    nil
  }
  added = DownstreamHook.add('charge_enhanced_hide', hook)
  $ce_hide = added != false
rescue
  $ce_hide = false
end
def stop_hide
  DownstreamHook.remove('charge_enhanced_hide')
rescue
  nil
ensure
  $ce_hide = false
end
Script.at_exit { stop_hide }
def pull_line
  line = if $ce_buf && !$ce_buf.empty?
    $ce_buf.shift
  else
    get?
  end
  line ? strip_tags(line) : nil
end
def args_list
  vars = Script.current.vars
  return [] if vars.nil?
  if vars[1]
    vars[1..].compact.map(&:to_s)
  else
    vars[0].to_s.split
  end
rescue
  []
end
def requested_type(args)
  idx = args.index { |a| a.downcase == '-type' }
  return nil unless idx && args[idx + 1]
  args[idx + 1].downcase
end
def type_wanted?(block_name, want)
  return true if want.nil? || want.empty?
  name = block_name.downcase
  key = TYPE_ALIASES[want] || want
  name.include?(key)
end
def parse_number(text)
  text.to_s.gsub(',', '').to_i
end
def wait_lines(seconds = 2)
  lines = []
  start = Time.now
  loop do
    line = pull_line
    if line
      lines << line
      start = Time.now
    else
      sleep 0.1
    end
    break if (Time.now - start) > seconds && !lines.empty?
    break if (Time.now - start) > (seconds + 2)
  end
  lines
end
def capture_command(cmd, done_regex, timeout = 8)
  fput cmd
  lines = []
  started = Time.now
  loop do
    line = pull_line
    if line
      lines << line
      return lines if line =~ done_regex
    else
      sleep 0.05
    end
    break if (Time.now - started) > timeout && lines.any?
    break if (Time.now - started) > (timeout + 4)
  end
  lines
end
def clear_stream
  20.times { break unless pull_line }
end
def read_bounty
  clear_stream
  lines = capture_command('bounty', /lifetime bounty points|unspent bounty points|Adventurer's Guild information/i, 6)
  lines.concat(wait_lines(1.2))
  points = nil
  lifetime = nil
  lines.each do |line|
    points = parse_number($1) if line =~ /You currently have ([\d,]+) unspent bounty points/i
    lifetime = parse_number($1) if line =~ /accumulated a total of ([\d,]+) lifetime/i
  end
  { points: points, lifetime: lifetime }
end
def read_enh_list
  clear_stream
  lines = capture_command('inventory enhancive list', /\(Items:\s*\d+\)|not holding any enhancive|wearing the following enhancive/i, 8)
  lines.concat(wait_lines(1.2))
  items = []
  lines.each do |line|
    line = strip_tags(line)
    next unless line =~ /^(.*?)\s+\((\d+)\/(\d+)\s+charges\)$/
    name = $1.strip
    next if items.any? { |it| it[:name].downcase == name.downcase }
    items << { name: name, current: $2.to_i, max: $3.to_i, props: [], status: nil }
  end
  items
end
def read_enh_details(items)
  clear_stream
  lines = capture_command('inventory enhancive totals details', /For fewer details, see INVENTORY ENHANCIVE TOTALS/i, 10)
  lines.concat(wait_lines(1.0))
  current_prop = nil
  lines.each do |line|
    line = strip_tags(line)
    if line =~ /^([A-Za-z][A-Za-z \-']+?)(?:\s+\([A-Z]+\))?:\s+\d+\/\d+$/
      current_prop = $1.strip
      next
    end
    next unless line =~ /^\+(\d+):\s+(.+)$/ && current_prop
    bonus = $1.to_i
    name = strip_tags($2)
    item = items.find { |it| it[:name].downcase == name.downcase }
    next unless item
    item[:props] << { name: current_prop, bonus: bonus } unless item[:props].any? { |p| p[:name] == current_prop && p[:bonus] == bonus }
  end
  items
end
def name_words(name)
  name.to_s.sub(/^(a|an|some|the)\s+/i, '').gsub(/[^\w\s\-]/, '').split.reject { |w| w =~ /\A(and|with|of|the)\z/i }
end
def noun_of(name)
  words = name_words(name)
  return name.to_s if words.empty?
  adj = words[0..-2].find { |w| w !~ /-/ }
  adj ? "#{adj} #{words[-1]}" : words[-1]
end
def bind_ids(items)
  return unless defined?(GameObj)
  pool = []
  pool.concat(GameObj.inv.to_a) if GameObj.respond_to?(:inv)
  items.each do |item|
    words = name_words(item[:name]).map(&:downcase)
    obj = pool.find { |o| n = o.name.to_s.downcase; words.last(2).all? { |w| n.include?(w) } }
    item[:obj_id] = obj.id if obj && obj.respond_to?(:id) && obj.id
  end
end
def act_on(verb, item)
  item[:obj_id] ? "#{verb} ##{item[:obj_id]}" : "#{verb} #{noun_of(item[:name])}"
end
def hand_matches?(item)
  return false unless defined?(GameObj) && GameObj.right_hand
  held = GameObj.right_hand.name.to_s.downcase
  name_words(item[:name]).last(2).all? { |w| held.include?(w.downcase) }
end
def classify_recall(item)
  clear_stream
  fput act_on('recall', item)
  lines = []
  started = Time.now
  loop do
    line = pull_line
    if line
      lines << line
      break if line =~ /permanently unlocked loresong|unable to recall|don't seem to be able to recall|cannot recall|nothing about that/i
      break if line =~ /crumble into dust after its last enhancive|persist after its last enhancive/i && lines.length > 3
    else
      sleep 0.05
    end
    break if (Time.now - started) > 8
  end
  blob = lines.join("\n")
  return 'Crumbly' if blob =~ /crumble into dust after its last enhancive charge/i
  return 'Persists' if blob =~ /persist after its last enhancive charge/i
  'NoLoresong'
end
def needs_charge?(item)
  return false if item[:current].nil?
  item[:current] < 10
end
def room_for_ten?(item)
  return false if item[:current].nil? || item[:max].nil?
  (item[:max] - item[:current]) >= 10
end
def empty_right_hand
  return true unless defined?(GameObj) && GameObj.right_hand
  fput 'stow right'
  wait_lines(1.0)
  GameObj.right_hand.nil?
end
def took_off?(lines, item)
  blob = lines.join(' ').downcase
  name_words(item[:name]).last(2).all? { |w| blob.include?(w.downcase) } && blob =~ /take off|you remove|you get|you pick up|off your/i
end
def remove_to_hand(item)
  cmd = act_on('remove', item)
  fput cmd
  lines = ["sent #{cmd}"]
  started = Time.now
  loop do
    line = pull_line
    if line
      lines << line
      break if line =~ /take off|you remove|off your|remove what|not wearing|aren't wearing|hands are full/i
    else
      sleep 0.05
    end
    break if (Time.now - started) > 5
  end
  item[:remove_lines] = lines
  item[:in_hand] = took_off?(lines, item)
  item[:in_hand]
end
def settle
  quiet_since = Time.now
  started = Time.now
  while (Time.now - quiet_since) < 1.2 && (Time.now - started) < 8
    if pull_line
      quiet_since = Time.now
    else
      sleep 0.05
    end
  end
end
def quote_recharge(item)
  noun = noun_of(item[:name])
  empty_right_hand
  unless remove_to_hand(item)
    return { cost: nil, lines: ["Refusing to order. Remove did not take off #{noun}."] + item[:remove_lines].to_a }
  end
  fput 'order cancel'
  wait_lines(0.6)
  settle
  lines = []
  fput 'order 5'
  started = Time.now
  loop do
    line = pull_line
    if line
      lines << line
      break if line =~ /ORDER 5 CONFIRM within 30 seconds/i
      break if line =~ /fully charged|cannot recharge|can't recharge|not an enhancive|don't have enough/i
    else
      sleep 0.05
    end
    break if (Time.now - started) > 8
  end
  blob = lines.join("\n")
  cost = blob =~ /([\d,]+)\s+(?:of your )?bounty points/i ? parse_number($1) : nil
  { cost: cost, lines: lines }
end
def confirm_recharge(item)
  unless item[:in_hand]
    return { ok: false, lines: ["Refusing to confirm. #{item[:name]} was not taken off."] }
  end
  fput 'order 5 confirm'
  lines = []
  started = Time.now
  loop do
    line = pull_line
    if line
      lines << line
      break if line =~ /Finished,|handing it back to you|recharged/i
      break if line =~ /too late|expired|not enough|don't have enough/i
    else
      sleep 0.05
    end
    break if (Time.now - started) > 8
  end
  blob = lines.join("\n")
  { ok: blob =~ /Finished,|handing it back to you|recharged/i && blob !~ /too late|not enough|don't have enough/i, lines: lines }
end
def wear_back(item)
  fput act_on('wear', item)
  wait_lines(1.0)
end
def go_treasuremaster
  # Options must come before the target or go2 treats them as part of the destination
  # and keeps echoing. Do not DownstreamHook-squelch during go2; a nil hook hides
  # lines from go2 as well and the walk never finishes.
  Script.run(
    'go2',
    '--echo_input=off --hide_room_descriptions=on --hide_room_titles=on treasuremaster',
    { quiet: true }
  )
  pause 1
end
silence_me
args = args_list
want = requested_type(args)
confirm = args.any? { |a| a.casecmp('CONFIRM').zero? }
pick = args.find { |a| a =~ /\A\d+\z/ }
pick = pick.to_i if pick
start_hide
bounty = read_bounty
items = read_enh_list
read_enh_details(items)
stop_hide
if bounty[:points].nil?
  say 'Could not read bounty points.'
  exit
end
matching = items.select do |item|
  next false if item[:props].empty? && want
  item[:props].empty? || item[:props].any? { |p| type_wanted?(p[:name], want) }
end
matching = items if want.nil?
offer = matching.select { |it| needs_charge?(it) }
offer = offer.sort_by { |it| [it[:current].to_i, it[:name]] }
if offer.empty?
  say 'No enhancives under 10 charges.'
  say "#{commas(bounty[:points])} bounty points."
  exit
end
STAT_ORDER = [
  'Strength', 'Constitution', 'Dexterity', 'Agility', 'Discipline',
  'Aura', 'Logic', 'Intuition', 'Wisdom', 'Influence'
].freeze
def prop_sort_key(name)
  idx = STAT_ORDER.index { |s| name.to_s.downcase.include?(s.downcase) }
  idx.nil? ? STAT_ORDER.length : idx
end
def lead_prop(item)
  props = item[:props]
  return 'Unknown' if props.nil? || props.empty?
  props.min_by { |p| prop_sort_key(p[:name]) }[:name]
end
unless pick
  seen = {}
  offer = offer.select { |item| key = item[:name].downcase; seen[key] ? false : (seen[key] = true) }
  offer.each_with_index { |item, i| item[:num] = i + 1 }
  say "charge_enhanced #{VERSION}"
  low = offer.select { |item| item[:current] < 4 }
  if low.any?
    say 'WARNING!'
    low.each do |item|
      say "#{item[:num]} #{item[:name]} has only #{item[:current]}/#{item[:max]} charges remaining!"
    end
    say ''
  end
  groups = Hash.new { |h, k| h[k] = [] }
  offer.each do |item|
    next if item[:props].empty?
    shown = want ? item[:props].select { |p| type_wanted?(p[:name], want) } : item[:props]
    shown = item[:props] if shown.empty?
    shown.each do |p|
      next if p[:name] =~ /unknown/i
      groups[p[:name]] << [item, p]
    end
  end
  groups.keys.sort_by { |name| [prop_sort_key(name), name] }.each do |prop|
    say prop
    groups[prop].each do |item, p|
      bonus = p[:bonus] ? "+#{p[:bonus]}  " : ''
      say "#{item[:num]}  #{item[:name]}  #{bonus}#{item[:current]}/#{item[:max]}"
    end
    say ''
  end
  say "#{commas(bounty[:points])} bounty points."
  say 'Ignoring items with more than ten charges remaining.'
  say 'Do you want to charge? type ;charge_enhanced 1 to check the price to charge item 1.'
  say 'WARNING! This will move you to the nearest treasure master!'
  say 'type ;charge_enhanced 1 CONFIRM to charge immediately'
  exit
end
item = offer[pick - 1]
unless item
  say "No item #{pick}."
  exit
end
bind_ids([item])
go_treasuremaster
start_hide
settle
item[:status] = classify_recall(item)
quote = quote_recharge(item)
if quote[:cost].nil?
  say "No quote for #{item[:name]}."
  quote[:lines].to_a.last(4).each { |line| say "  #{line}" unless line.to_s.empty? }
  start_hide
  wear_back(item)
  stop_hide
  exit
end
stop_hide
warn = room_for_ten?(item) ? '' : ' WARNING! cannot take 10.'
case item[:status]
when 'Crumbly'
  say "WARNING! THIS COSTS ALOT! #{item[:name]} is Crumbly. #{commas(quote[:cost])} bounty points.#{warn}"
when 'NoLoresong'
  if quote[:cost] > 10_000
    say "WARNING! NoLoresong on #{item[:name]}. It is probably crumbly, this is why it is so expensive. #{commas(quote[:cost])} bounty points.#{warn}"
  else
    say "#{item[:name]} NoLoresong. #{commas(quote[:cost])} bounty points.#{warn}"
  end
else
  say "#{item[:name]} Persists. #{commas(quote[:cost])} bounty points.#{warn}"
end
say "You have #{commas(bounty[:points])} bounty points. This will leave you with #{commas(bounty[:points] - quote[:cost])} points remaining!"
if !confirm
  start_hide
  wear_back(item)
  stop_hide
  say "Not charged. type ;charge_enhanced #{pick} CONFIRM to charge immediately"
  exit
end
if quote[:cost] > bounty[:points]
  start_hide
  wear_back(item)
  stop_hide
  say 'WARNING! Cannot afford it. Not charged.'
  exit
end
start_hide
result = confirm_recharge(item)
wear_back(item)
fresh = read_bounty
stop_hide
if result[:ok]
  say "Charged #{item[:name]} for #{commas(quote[:cost])}. #{commas(fresh[:points] || (bounty[:points] - quote[:cost]))} bounty points left."
else
  say 'WARNING! Confirm did not look successful.'
  result[:lines].to_a.last(4).each { |line| say "  #{line}" unless line.to_s.empty? }
end