def sail2_port_name(room_id)
  key = PORTS.key(room_id.to_s)
  key && (PORT_NAMES[key] || key.capitalize)
end

def sail2_ship_name(crew_cfg)
  cmd_cfg = sail2_load_yaml_file(File.join(DATA_DIR, XMLData.game, Char.name, "osacommander.yaml")) rescue {}
  name = (cmd_cfg.is_a?(Hash) ? cmd_cfg["commander_ship_name"] : nil).to_s.strip
  name = crew_cfg["commander_ship_name"].to_s.strip if name.empty?
  name.empty? ? "The Ship" : name
end

script.want_downstream_xml = true

$current_room_id = nil
$ocean_watch_started = false
$current_heading  = nil
$sail2_trip_start = nil
$sail2_trip_moves = 0
$sail2_est_seconds = 0

def wait_for_go2
  Timeout.timeout(30) do
    loop do
      break unless Script.running?("go2")
      sleep 0.2
    end
  end
rescue Timeout::Error
  echo "--- WARNING: go2 did not finish within 30 seconds."
end

def sail2_flag_settings
	flagset = Lich::Util.quiet_command("flag", /You may also access these settings through/, end_pattern = /war in towns with active justice./, include_end = true ,timeout = 3, silent = true)
		if flagset.to_s =~ /ShowRoomID\s+OFF/
			Lich::Util.quiet_command("flag showroomid on", /You will now display the room ID./, end_pattern = /You will now display the room ID./, include_end = true ,timeout = 3, silent = true)
			# Shared by the OSA scripts: set when one of them turned ShowRoomID on
			$osa_showroomid_by_osa = true
		end
end

# Turns ShowRoomID back off if an OSA script turned it on, unless nautical-charts still needs it.
def sail2_release_showroomid
	return unless $osa_showroomid_by_osa
	return if running?("nautical-charts")
	Lich::Util.quiet_command("flag showroomid off", /You will no longer display the room ID./, end_pattern = /You will no longer display the room ID./, include_end = true ,timeout = 3, silent = true)
	$osa_showroomid_by_osa = false
end

def sail2_lower_sail
	result = dothistimeout "lower sail", 3, /you slowly lower the (.*) sail until it is at half mast|you slowly lower the (.*) sail until it is fully open|far as it can go!|\.\.\.wait/
        waitrt?
	if result.to_s =~ /\.\.\.wait/
		waitrt?
		sail2_lower_sail
	elsif result.to_s =~ /you slowly lower the (.*) sail until it is at half mast/
		waitrt?
		sail2_lower_sail
	elsif result.to_s =~ /you slowly lower the (.*) sail until it is fully open/
		waitrt?
	elsif result.to_s =~ /far as it can go!/
		end
end

def main_mast; sail2_go("main_mast"); end
def mid_mast; sail2_go("mid_mast"); end
def forward_mast; sail2_go("forward_mast"); end
def sail2_crows_nest; sail2_go("crows_nest"); end

def sail2_raise_anchor
  result = dothistimeout "push capstan", 3, /begin to push|one final push|anchor is already up|\.\.\.wait/
  waitrt?
  if result.to_s =~ /\.\.\.wait/
    waitrt?
    sail2_raise_anchor
  elsif result.to_s =~ /begin to push/
    waitrt?
    sail2_raise_anchor
  elsif result.to_s =~ /one final push/
    @anchor_aweigh = true
    waitrt?
  elsif result.to_s =~ /anchor is already up/
    return
  end
end

def ensure_at_helm
	helm = (SAIL2_SHIPS[sail2_ship_kind] || {}).dig(:rooms, "helm")
	return if helm ? Room.current&.id.to_i == helm : Room.current&.tags.to_a.include?("helm")

	echo "--- Moving to helm"
	sail2_go("helm")
	waitrt?
end

def sail2_ship_flag
	data      = load_sail2_data
	use_flag  = data.fetch("use_flag", true)
	flag_mode = data.fetch("flag_mode", "white").to_s.downcase
	return unless use_flag

	# Check current flag via silent command
	check_flag = Lich::Util.quiet_command("ship flag", //,
		end_pattern = /\[To change your flag please provide a valid option. Valid options: WHITE, BLACK, or NEUTRAL\]/,
		include_end = false, timeout = 3, silent = true)

	# Determine current flag state
	current = if check_flag.to_s =~ /is currently flying a (\w+) flag/
		$1.downcase
	elsif check_flag.to_s =~ /is currently flying no flag/
		"neutral"
	else
		nil
	end

	# Already correct - nothing to do
	return if current == flag_mode || (flag_mode == "neutral" && current == "neutral")

	# Go to crows nest to change flag
	sail2_crows_nest
	change_result = Lich::Util.quiet_command("ship flag #{flag_mode}",
		/Your ship is now flying|Time until flag can be changed/,
		end_pattern = /Your ship is now flying|Time until flag can be changed/,
		include_end = true, timeout = 5, silent = true)

	change_text = Array(change_result).join("\n")
	if change_text =~ /Time until flag can be changed:\s*([^\r\n"\]]+)/
		cooldown = $1.strip
		respond ""
		respond " =========================================================="
		respond "  WARNING: Your ship flag could not be changed to #{flag_mode}."
		respond "  #{cooldown} remaining before you can change it again."
		if flag_mode == "white"
			respond "  Sailing without a white flag is dangerous - enemy ships"
			respond "  may engage you on sight."
		end
		respond " =========================================================="
		respond "  How would you like to proceed?"
		respond "    1. Continue sailing with your current flag"
		respond "    2. Exit sail2 and wait for the cooldown to expire"
		respond " =========================================================="
		respond "  Please select an option - ;send <#>"
		respond ""
		# sail2 runs with i_stand_alone, and Lich only hands a plain ;send to scripts that want
		# downstream (;send to sail2 goes to the unique buffer). Turn downstream on just for this
		# prompt so ;send 1 / ;send 2 arrive, and read both buffers.
		this_script = Script.current
		prev_downstream = this_script.want_downstream
		answer = nil
		begin
			nil while unique_get?
			clear
			this_script.want_downstream = true
			until answer.to_s.gsub(/<[^>]*>/, "").strip =~ /^[12]$/
				answer = unique_get? || get?
				sleep 0.1 unless answer
			end
		ensure
			this_script.want_downstream = prev_downstream
			clear
		end
		answer = answer.to_s.gsub(/<[^>]*>/, "")
		if answer.strip == "2"
			respond "  Exiting sail2. Please try again in #{cooldown}."
			exit
		else
			respond "  Understood. Proceeding with current flag. Sail carefully!"
			respond ""
		end
	end
end

def start_nav
	ensure_at_helm
	check_city = Lich::Util.quiet_command("look ocean", //, end_pattern = /(Open waters:|Obvious paths:)/, include_end = true ,timeout = 3, silent = true)
	if check_city.to_s =~ /Potential docking options include|Open waters:/
		sail2_ship_flag
		return
	elsif check_city.to_s =~ /Obvious paths:/
		$mast_count = sail2_ship_masts
		if $mast_count.to_i >= 1
			main_mast
			fput "pull gang"
			sail2_lower_sail
		end
		if $mast_count.to_i >= 2
			forward_mast
			sail2_lower_sail
		end
		if $mast_count.to_i == 3
			mid_mast
			sail2_lower_sail
		end
		ensure_at_helm
		sail2_raise_anchor
		waitrt?
		fput "depart"
		fput "depart"
	else
		echo "Please get your ship underway, then restart Sail2.lic."
		exit
	end
end

