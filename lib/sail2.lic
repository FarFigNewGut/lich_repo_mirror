	"carrack" => { "enemy_cargo_hold" => 30269, "enemy_main_deck" => 30266, "enemy_forward_deck" => 30271, "enemy_bow" => 30272, "enemy_crows_nest" => 30270, "enemy_helm" => 30267, "enemy_quarters" => 30268 },
	"galleon" => { "enemy_cargo_hold" => 30801, "enemy_main_deck" => 30798, "enemy_forward_deck" => 30803, "enemy_bow" => 30804, "enemy_crows_nest" => 30802, "enemy_helm" => 30799, "enemy_quarters" => 30800 },
	"frigate" => { "enemy_cargo_hold" => 30808, "enemy_main_deck" => 30805, "enemy_forward_deck" => 30810, "enemy_crows_nest" => 30809, "enemy_helm" => 30806, "enemy_quarters" => 30807 },
	"man o' war" => { "enemy_cargo_hold" => 30781, "enemy_main_deck" => 30778, "enemy_mid_deck" => 30783, "enemy_forward_deck" => 30786, "enemy_bow" => 30784, "enemy_crows_nest" => 30782, "enemy_forward_crows_nest" => 30785, "enemy_helm" => 30779, "enemy_quarters" => 30780 }
}

# Which ship type you are on, from the room number (nil when not on a ship).
def sail2_ship_kind
	id = Room.current&.id.to_i
	SAIL2_SHIPS.each { |kind, ship| return kind if ship[:range].include?(id) }
	nil
end

def sail2_ship_masts
	(SAIL2_SHIPS[sail2_ship_kind] || {})[:masts].to_i
end

# Tags the rooms of the ship you are on, plus the enemy ship rooms and the gangplank links from
# your main deck to them (as before). Only this ship's rooms are tagged now, not every ship type's.
def sail2_map_ship
	SAIL2_ENEMY_SHIP_ROOMS.each_value do |rooms|
		rooms.each { |tag, id| Room[id].tags.push(tag) unless Room[id].tags.include?(tag) }
	end
	ship = SAIL2_SHIPS[sail2_ship_kind]
	return unless ship
	ship[:rooms].each { |tag, id| Room[id].tags.push(tag) unless Room[id].tags.include?(tag) }
	main = Room[ship[:rooms]["main_deck"]]
	SAIL2_ENEMY_SHIP_ROOMS.each_value do |rooms|
		enemy_main = rooms["enemy_main_deck"].to_s
		next unless main.wayto[enemy_main].nil?
		main.wayto[enemy_main] = StringProc.new("fput \"push gang\";fput \"go gang\"")
		main.timeto[enemy_main] = 0.2
	end
end

# Walks to a role on the ship you are on, by room number so go2 can't pick another ship's room.
def sail2_go(tag)
	room_id = (SAIL2_SHIPS[sail2_ship_kind] || {}).dig(:rooms, tag)
	if room_id
		return if Room.current&.id.to_i == room_id
		start_script("go2", [room_id.to_s])
	else
		return if Room.current&.tags.to_a.include?(tag)
		start_script("go2", [tag])
	end
	wait_for_go2
end

def sail2_ship_type
	sail2_map_ship
	$mast_count = sail2_ship_masts
	if Room.current.location != "Ships"
		echo "You are not currently on a ship! Please restart from your ship."
		exit
	else
		start_nav
	end
end

if script.vars[1] == 'update'
	sync_all
	exit
end

if script.vars[1] =~ /^config$/i
	$sail2_config_window = nil

	GLib::Idle.add do
		begin
			data      = load_sail2_data
			use_flag  = data.fetch("use_flag", true)
			flag_mode = data.fetch("flag_mode", "white").to_s.downcase

			$sail2_config_window = Gtk::Window.new
			$sail2_config_window.title = "Sail2 - Flag Configuration"
			$sail2_config_window.set_default_size(320, 200)
			$sail2_config_window.set_border_width(16)
			$sail2_config_window.keep_above = true
			$sail2_config_window.signal_connect("destroy") { $sail2_config_window = nil }

			outer = Gtk::Box.new(:vertical, 12)
			$sail2_config_window.add(outer)

			# Header
			header = Gtk::Label.new
			header.set_markup("<b>Sail2 - Flag Settings</b>")
			header.set_halign(:start)
			outer.pack_start(header, false, false, 0)

			outer.pack_start(Gtk::Separator.new(:horizontal), false, false, 2)

			# Use flag checkbox
			use_flag_cb = Gtk::CheckButton.new("Change ship flag when sailing")
			use_flag_cb.active = use_flag
			outer.pack_start(use_flag_cb, false, false, 0)

			# Flag color row
			color_row = Gtk::Box.new(:horizontal, 8)
			color_lbl = Gtk::Label.new("Flag color:")
			color_lbl.set_size_request(90, -1)
			color_lbl.set_halign(:start)
			color_row.pack_start(color_lbl, false, false, 0)

			color_combo = Gtk::ComboBoxText.new
			["white", "black", "neutral"].each { |c| color_combo.append_text(c.capitalize) }
			color_combo.active = ["white", "black", "neutral"].index(flag_mode) || 0
			color_row.pack_start(color_combo, true, true, 0)
			outer.pack_start(color_row, false, false, 0)

			# Grey out color combo when use_flag unchecked
			color_row.sensitive = use_flag
			use_flag_cb.signal_connect("toggled") { color_row.sensitive = use_flag_cb.active? }

			outer.pack_start(Gtk::Separator.new(:horizontal), false, false, 2)

			# Buttons
			btn_box = Gtk::Box.new(:horizontal, 8)
			btn_box.set_halign(:end)
			outer.pack_start(btn_box, false, false, 0)

			save_btn = Gtk::Button.new(label: "Save")
			save_btn.signal_connect("clicked") do
				d = load_sail2_data
				d["use_flag"]  = use_flag_cb.active?
				d["flag_mode"] = ["white", "black", "neutral"][color_combo.active] || "white"
				save_sail2_data(d)
				respond "--- Sail2: Flag settings saved. use_flag=#{d["use_flag"]} flag_mode=#{d["flag_mode"]}"
			end
			btn_box.pack_start(save_btn, false, false, 0)

			close_btn = Gtk::Button.new(label: "Close")
			close_btn.signal_connect("clicked") do
				Gtk.queue do
					$sail2_config_window.hide
					$sail2_config_window.destroy
				end
			end
			btn_box.pack_start(close_btn, false, false, 0)

			$sail2_config_window.show_all
		rescue => e
			respond "--- Sail2 config GUI error: #{e.class}: #{e.message}"
			respond e.backtrace.first(3).join("\n")
		end
		false
	end
	# Keep the script alive until the window is closed
	wait_until { $sail2_config_window.nil? }
	exit
end

sail2_ship_type
sail2_flag_settings

def fatal(msg)
  echo "--- ERROR: #{msg}"
  exit
end

def valid_room_id?(s)
  s.to_s.match?(/^\d{7}$/)
end

def normalize_input(raw)
  s = raw.to_s.strip.downcase
  return "" if s.empty?
  return PORTS[s] if PORTS.key?(s)
  return s if valid_room_id?(s)
  ""
end

def port_destination?(room_id)
  PORTS.value?(room_id.to_s)
end

def load_ocean_map_flat
  path = File.join(MAP_DIR, 'OSAMaps', 'Database', 'oceandb.json')
  fatal("Missing #{MAP_FILE} in DATA_DIR (#{path})") unless File.exist?(path)

  raw = JSON.parse(File.read(path))
  flat = {}

  if raw.is_a?(Hash) && raw.keys.any? { |k| k.to_s.match?(/^\d{7}$/) }
    raw.each do |rid, exits|
      rid = rid.to_s.strip
      next unless valid_room_id?(rid)
      flat[rid] = exits.is_a?(Hash) ? exits : {}
    end
    return flat
  end

  raw.each do |_, rooms|
    next unless rooms.is_a?(Hash)
    rooms.each do |rid, exits|
      rid = rid.to_s.strip
      next unless valid_room_id?(rid)
      flat[rid] = exits.is_a?(Hash) ? exits : {}
    end
  end

  flat
end

def bfs(map, start_id, goal_id)
  visited = Set.new([start_id])
  queue = [[start_id, []]]

  until queue.empty?
    cur, path = queue.shift
    return path if cur == goal_id

    exits = map[cur]
    next unless exits.is_a?(Hash)

    exits.each do |dir, nxt|
      nid = nxt.to_s.strip
      next unless valid_room_id?(nid)
      next if visited.include?(nid)

      visited << nid
      queue << [nid, path + [[dir.to_s.downcase, nid]]]
    end
  end

  nil
end

def compress_route(path)
  return [] if path.nil? || path.empty?

  legs = []
  current_dir = path.first[0].to_s.downcase
  expected_rooms = [path.first[1].to_s]

  path[1..-1].each do |dir, nid|
    dir = dir.to_s.downcase
    nid = nid.to_s

    if dir == current_dir
      expected_rooms << nid
    else
      legs << [current_dir, expected_rooms.dup]
      current_dir = dir
      expected_rooms = [nid]
    end
  end

  legs << [current_dir, expected_rooms.dup]
  legs
end

def update_current_room_from_watch(line)
  return false if line.nil?

  text = line.to_s

  if text =~ /roomName.*?\((\d{7})\)/
    $current_room_id = $1.to_s
    return true
  end

  # Only the room title line ("[Sea Name] (1234567)"), so a number in LNet or speech is ignored
  if text =~ /^(?:<[^>]*>)*\[[^\]]*\]\s*\((\d{7})\)/
    $current_room_id = $1.to_s
    return true
  end

  false
end

def sail2_ensure_ocean_watch
  return if $ocean_watch_started

  begin
    raw_location = Room.current.location
    raw_location = raw_location.first if raw_location.is_a?(Array)
    location = raw_location.to_s.downcase

    if location == 'ships'
      watch_result = Lich::Util.quiet_command("watch ocean", /You begin to watch the ocean waters surrounding the ship|You are already watching the ocean|I could not find what you were referring to/, end_pattern = /You begin to watch the ocean waters surrounding the ship|You are already watching the ocean|I could not find what you were referring to/, include_end = true, timeout = 3, silent = true)

      if watch_result.to_s =~ /You begin to watch the ocean waters surrounding the ship/
        # Fresh watch -- try to get room ID from bracket line
        look_result = Lich::Util.quiet_command("look ocean", /\[.*?\]\s*\(\d{6,8}\)|I could not find what you were referring to/, end_pattern = /\[.*?\]\s*\(\d{6,8}\)|I could not find what you were referring to/, include_end = true, timeout = 2, silent = true)
        if look_result.to_s =~ /\((\d{6,8})\)/
          $current_room_id = $1
        end

      elsif watch_result.to_s =~ /You are already watching the ocean/
        # Already watching -- look ocean to get current room
        look_result = Lich::Util.quiet_command("look ocean", /\[.*?\]\s*\(\d{6,8}\)|I could not find what you were referring to/, end_pattern = /\[.*?\]\s*\(\d{6,8}\)|I could not find what you were referring to/, include_end = true, timeout = 2, silent = true)
        if look_result.to_s =~ /\((\d{6,8})\)/
          $current_room_id = $1
        end

      elsif watch_result.to_s =~ /I could not find what you were referring to/
        # Cannot see ocean -- inside ship, wait for room detection via stream
        nil
      end

      $ocean_watch_started = true
    end
  rescue => e
    respond "[sail2: ensure_ocean_watch error: #{e.message}]"
  end
end

def wait_for_current_room(timeout = 8)
  start_time = Time.now

  loop do
    rid = $current_room_id.to_s
    return rid unless rid.empty?

    break if (Time.now - start_time) > timeout

    line = get?
    if line
      update_current_room_from_watch(line)
    else
      sleep 0.1
    end
  end

  ""
end

def wait_for_room_change(previous_room, timeout = 8)
  start_time = Time.now
  previous_room = previous_room.to_s

  loop do
    current = $current_room_id.to_s
    return current if !current.empty? && current != previous_room

    break if (Time.now - start_time) > timeout

    line = get?
    if line
      update_current_room_from_watch(line)
    else
      sleep 0.1
    end
  end

  $current_room_id.to_s
end

def current_sea_room
  $current_room_id.to_s
end

def set_heading(dir)
  dir = dir.to_s.strip.downcase

  if $current_heading.to_s.strip.downcase == dir
    echo "--- Wheel already set to #{dir.upcase}"
    return
  end

  ensure_at_helm
  fput "turn wheel #{dir}"
  waitrt?
  $current_heading = dir
end

def wait_for_sailing_result(timeout = 300)
  start_time = Time.now

  loop do
    return :timeout if (Time.now - start_time) > timeout

    line = get?
    unless line
      sleep 0.1
      next
    end

    update_current_room_from_watch(line)

    case line
    when /The (.*) (cuts through the ocean, heading|drifts slowly)/
      return :moved
    when /A large swell crashes into the side of the/
      return :rogue_wave
    when /The sound of ropes coming free of the rigging/
      return :rigging
    when /The (.*) suddenly drifts from its course as the/
      return :off_course
    when /The (.*) drifts steadily toward the/
      return :arrival
    when /The .* wheel slowly turns off course\./
      return :invalid_heading
    when /Aimless, the .* rocks idly in the ocean waters\./
      return :aimless
    end
  end
end

def sail_leg(dir, expected_rooms)
  echo "--- Heading #{dir.upcase} for #{expected_rooms.length} move(s)"
  set_heading(dir)

  moved = 0

  move_start_time = Time.now
  while moved < expected_rooms.length
    previous_room = current_sea_room
    result = wait_for_sailing_result

    if result == :moved
      actual_room = wait_for_room_change(previous_room, 8)
      expected_room = expected_rooms[moved]

      if actual_room.empty?
        echo "--- WARNING: Could not confirm current room after movement."
        return [:reroute, actual_room]
      end

      if actual_room == previous_room
        echo "--- WARNING: Room did not update after movement. Still showing #{actual_room}."
        return [:reroute, actual_room]
      end

      if actual_room != expected_room
        echo "--- Course deviation: expected #{expected_room}, got #{actual_room}"
        return [:reroute, actual_room]
      end

      move_secs = (Time.now - move_start_time).round(2)
      record_move_time(move_secs)
      move_start_time = Time.now
      moved += 1
      echo "--- Move #{moved}/#{expected_rooms.length}: now at #{actual_room} (#{move_secs}s)"
      next
    elsif result == :rogue_wave
      waitrt?
      fput "yell Rogue Wave! Secure the Anchor!"
      ensure_at_helm
      waitrt?
      waitcastrt?
      sail2_raise_anchor
      $current_heading = nil
      echo "--- Rogue wave handled. Resuming travel..."
      return [:reroute, current_sea_room]
    elsif result == :rigging
      echo "The Sails Have Been Furled"
      if $mast_count.to_i >= 1
        main_mast
        sail2_lower_sail
      end
      if $mast_count.to_i >= 2
        forward_mast
        sail2_lower_sail
      end
      if $mast_count.to_i == 3
        mid_mast
        sail2_lower_sail
      end
      ensure_at_helm
      $current_heading = nil
      echo "--- Rigging secured. Resuming travel..."
      return [:reroute, current_sea_room]
    end

    if [:invalid_heading, :aimless, :off_course].include?(result)
      $current_heading = nil
    end

    actual_room = wait_for_current_room(5)
    echo "--- Sailing interrupted (#{result}). Current room: #{actual_room.empty? ? 'UNKNOWN' : actual_room}"
    return [:reroute, actual_room]
  end

  [:ok, current_sea_room]
end

# Registered as a Lich cleanup block. This used to be "def before_dying", which replaced Lich's own
# before_dying for every script once sail2 had loaded (so their cleanup blocks never registered).
before_dying {
	sail2_release_showroomid
}

def sail_into_port
  echo "--- Final approach: turning wheel PORT"
  $current_heading = nil
  ensure_at_helm
  fput "turn wheel port"
  waitrt?

  loop do
    result = wait_for_sailing_result

    case result
    when :arrival
      echo "--- Port approach confirmed."
      return :arrived
    when :moved
      next
    when :invalid_heading, :aimless, :off_course
      $current_heading = nil
      return :reroute
    else
      return :reroute
    end
  end
end

def sail2_broadcast_depart(crew_cfg, goal_id, eta_time)
  origin_name = sail2_port_name(current_sea_room)
  dest_name   = sail2_port_name(goal_id) || goal_id.to_s
  ship_name   = sail2_ship_name(crew_cfg)
  crew_chan    = crew_cfg["crew"].to_s
  msg = if origin_name
    "#{ship_name} Expects To Make Way From #{origin_name} And Will Be Moored In #{dest_name} At Approximately: #{eta_time}"
  else
    "#{ship_name} Expects To Make Way And Will Be Moored In #{dest_name} At Approximately: #{eta_time}"
  end
  LNet.send_message(attr = { 'type' => 'channel', 'channel' => crew_chan }, msg)
  waitrt?
  pause 0.2
  fput "yell #{msg}"
end

def sail2_broadcast_moored(crew_cfg)
  crew_chan = crew_cfg["crew"].to_s
  look = Lich::Util.quiet_command("look ocean", /\[(.*)\]/, end_pattern = /(Open waters: (.*)|Obvious paths: (.*))/, include_end = false, timeout = 3, silent = true)
  if look.to_s =~ /\(([0-9,]+)\)/
    room      = Room["u#{$1}"]
    room_id   = room&.id
    city      = room&.location.to_s
    title     = room&.title&.first.to_s
    msg = "The Ship Is Now Moored In #{city}. #{title}"
    lnetmsg = "The Ship Is Now Moored In #{city}. Room Number: #{room_id} #{title}"
  else
    msg = "The Ship Is Now Moored."
    lnetmsg = msg
  end
  LNet.send_message(attr = { 'type' => 'channel', 'channel' => crew_chan }, lnetmsg)
  waitrt?
  pause 0.2
  fput "yell #{msg}"
end

def autopilot_to(map, start_id, goal_id)
  current_id   = start_id.to_s
  goal_is_port = port_destination?(goal_id)
  crew_cfg     = sail2_load_yaml_file(File.join(DATA_DIR, XMLData.game, Char.name, "osacrew.yaml"))
  is_commander = checkname == crew_cfg["commander"]

  # Calculate initial ETA and broadcast departure once before the loop
  path = bfs(map, current_id, goal_id)
  fatal("No path found from #{current_id} to #{goal_id}.") if path.nil?

  avg       = average_move_seconds
  est_secs  = (path.length * avg).round
  eta_time  = eastern_time(Time.now + est_secs).strftime("%I:%M %p EST")
  echo "--- [#{ship_display_name}] Estimated travel time: #{format_duration(est_secs)} (#{est_secs}s total) (ETA: #{eta_time} EST)"
  echo "--- Based on #{load_sail2_data[ship_timing_key]&.size || 0} recorded moves (avg #{avg.round(2)}s/move)"
  $sail2_trip_start  = Time.now
  $sail2_trip_moves  = path.length
  $sail2_est_seconds = est_secs

  # Departure/moored announcements are only for port destinations
  sail2_broadcast_depart(crew_cfg, goal_id, eta_time) if is_commander && goal_is_port

  loop do
    path = bfs(map, current_id, goal_id)
    fatal("No path found from #{current_id} to #{goal_id}.") if path.nil?

    legs = compress_route(path)

    echo "--- ROUTE (#{path.length} moves / #{legs.length} heading changes#{goal_is_port ? ' + port entry' : ''}) ---"
    legs.each_with_index do |(dir, rooms), i|
      echo "#{i + 1}. #{dir.upcase.ljust(3)} x #{rooms.length} -> #{rooms.last}"
    end
    echo "#{legs.length + 1}. PORT entry from #{goal_id}" if goal_is_port

    reroute_needed = false

    legs.each do |dir, expected_rooms|
      status, new_room = sail_leg(dir, expected_rooms)

      if status == :reroute
        new_room = wait_for_current_room(5) if new_room.to_s.empty?
        fatal("Unable to determine current room for reroute.") if new_room.to_s.empty?

        if new_room.to_s == goal_id.to_s && !goal_is_port
          echo "--- ARRIVED AT #{goal_id}"
		  main_mast
          return
        end

        echo "--- Re-routing from #{new_room} to #{goal_id}"
        current_id = new_room.to_s
        reroute_needed = true
        break
      end
    end

    next if reroute_needed

    actual = wait_for_current_room(5)

    if actual != goal_id.to_s
      current_id = actual unless actual.empty?
      echo "--- Route exhausted but destination not confirmed. Re-routing from #{current_id}"
      next
    end

    if goal_is_port
      port_result = sail_into_port

      if port_result == :arrived
        actual_secs = (Time.now - $sail2_trip_start).round
        echo "--- ARRIVED AT PORT #{goal_id}"
        echo "--- Estimated: #{format_duration($sail2_est_seconds)} (#{$sail2_est_seconds}s) | Actual: #{format_duration(actual_secs)} (#{actual_secs}s) | Moves: #{$sail2_trip_moves}"
        sail2_broadcast_moored(crew_cfg) if is_commander
        return
      end

      current_id = wait_for_current_room(5)
      fatal("Unable to determine current room after failed port entry.") if current_id.to_s.empty?

      echo "--- Re-routing from #{current_id} to #{goal_id}"
      next
    end

    actual_secs = (Time.now - $sail2_trip_start).round
    echo "--- ARRIVED AT #{goal_id}"
    echo "--- Estimated: #{format_duration($sail2_est_seconds)} (#{$sail2_est_seconds}s) | Actual: #{format_duration(actual_secs)} (#{actual_secs}s) | Moves: #{$sail2_trip_moves}"
    return
  end
end
# ---------------- MAIN ----------------

arg1 = variable[1].to_s
arg2 = variable[2].to_s

map = load_ocean_map_flat


if arg2.empty?
  # Verify player is on a ship before proceeding
  raw_location = Room.current.location rescue nil
  raw_location = raw_location.first if raw_location.is_a?(Array)
  if raw_location.to_s.downcase != 'ships'
    respond "[sail2: You must be on your ship to use this script. Please board your ship and try again.]"
    exit
  end

  sail2_ensure_ocean_watch

  start_id = wait_for_current_room(8)
  goal_id  = normalize_input(arg1)

  fatal("Could not determine current ocean room from watch ocean.") if start_id.empty?
  fatal("End must be a known port or 7-digit room id.") if goal_id.empty?
  fatal("Start room #{start_id} not found in #{MAP_FILE}.") unless map.key?(start_id)
  fatal("End room #{goal_id} not found in #{MAP_FILE}.") unless map.key?(goal_id)

  $current_room_id = start_id

  echo "--- Voyage: #{start_id} -> #{goal_id}"
  autopilot_to(map, start_id, goal_id)

else
  start_id = normalize_input(arg1)
  goal_id  = normalize_input(arg2)

  fatal("Start must be a known port or 7-digit room id.") if start_id.empty?
  fatal("End must be a known port or 7-digit room id.") if goal_id.empty?
  fatal("Start room #{start_id} not found in #{MAP_FILE}.") unless map.key?(start_id)
  fatal("End room #{goal_id} not found in #{MAP_FILE}.") unless map.key?(goal_id)

  echo "--- Voyage: #{start_id} -> #{goal_id}"

  path = bfs(map, start_id, goal_id)

  if path
    echo "--- ROUTE FOUND (#{path.length} moves) ---"
    path.each_with_index do |(dir, nid), i|
      echo "#{i + 1}. Steer #{dir.to_s.upcase.ljust(3)} -> #{nid}"
    end
  else
    echo "--- ERROR: No path found."
  end
end