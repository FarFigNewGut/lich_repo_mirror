=begin
	   Sail2 Version: 1.1.0 (October 31, 2026)

	   This Is A Go2 Style Script For OSA Shipboard Travel. Using The Oceandb, Sail2 Will
	   Sail Your Ship From Any Location In The Ocean To Any Other Using UIDs And Port Names.
	   Must Be Ran From Your Ship While Your Ship Is At Sea. First Time Users Must Run ;sail2 update
	   First To Download Appropriate Mapdb files.

	   Use:
	       ;sail2 <Port or UID>                        Will Begin Sailing To Destination.
	       ;sail2 <Port or UID> <Port or UID>          Will Display Step-by-step Route For Designated Travel.
	       ;sail2 update                               Will Check For Up-To-Date Ocean Mapdb files.
	   
	   Available Ports:
	   
	                   Brisker's Cove                  briskercove
	                   Glaoveln                        glaoveln
	                   Icemule Trace                   icemule
	                   Kraken's Fall                   kraken
	                   Wehnimer's Landing              landing
	                   Sleeping Drake Harbor           ornath
	                   Nielira Harbor                  nielira
	                   River's Rest                    riversrest
	                   Solhaven                        solhaven
	                   Teras Isle                      teras
	                   Ta'Vaalor                       vaalor
	                   Talon Isle                      talon
					   
	   Enjoy!
	
	   ~Peggyanne
	   
	   PS: feel free to send me any bugs via discord Bait#4376 and I'll try my best to fix them.
	 
	   Change Log:
	 
             October 10, 2026 - sail2 no longer replaces Lich's before_dying for every script (it was defined as a
                                method, so other scripts' cleanup never ran). Methods shared with other OSA scripts
                                now have a sail2_ prefix.
             October 11, 2026 - The flag-cooldown prompt now hears ;send 1 / ;send 2 and shows just the time left.
                                Departure and moored announcements only go out for port destinations, use the ship
                                name from osacommander and full port names. Fixed the moored message erroring without
                                a room number.
             October 28, 2026 - Fixed Brigantines never getting underway (wrong room range) and the Galleon and Man O'
                                War ranges. Anchor and sails retry after roundtime. Room tracking only reads the room
                                title line. ShowRoomID stays on while nautical-charts is open.
             October 31, 2026 - Ship mapping is one table (SAIL2_SHIPS) shared in layout with osacrew: only your ship
                                is tagged, masts, helm and crow's nest are reached by room number, and the mast count
                                and sailing-time lookups read the table. Saved sailing times are kept.
=end 

i_stand_alone
require 'json'
require 'set'
require 'timeout'
require 'open-uri'
require 'fileutils'
require "yaml"
require "gtk3"

# -- No-argument check - must be first so we never get the ship underway -------
if variable[1].to_s.empty? || variable[1].to_s =~ /^(help|\?)$/i
  respond ""
  respond " =================================================="
  respond "  Sail2 - Help"
  respond " =================================================="
  respond "  Usage:"
  respond "    ;sail2 <port or uid>          Sail to destination"
  respond "    ;sail2 <port> <port>          Show route between two points"
  respond "    ;sail2 update                 Update ocean map files"
  respond "    ;sail2 config                 Configure flag settings"
  respond "    ;sail2 help                   Show this help message"
  respond " =================================================="
  respond "  Available Ports:"
  respond "    Brisker's Cove        briskercove"
  respond "    Glaoveln              glaoveln"
  respond "    Icemule Trace         icemule"
  respond "    Kraken's Fall         kraken"
  respond "    Wehnimer's Landing    landing"
  respond "    Sleeping Drake Hbr    ornath"
  respond "    Nielira Harbor        nielira"
  respond "    River's Rest          riversrest"
  respond "    Solhaven              solhaven"
  respond "    Teras Isle            teras"
  respond "    Ta'Vaalor             vaalor"
  respond "    Talon Isle            talon"
  respond " =================================================="
  respond "  Notes:"
  respond "    - Must be run from your ship while at sea"
  respond "    - First time users must run ;sail2 update first"
  respond "    - You may use a 7-digit room UID instead of a port name"
  respond " =================================================="
  respond ""
  exit
end
# -- End no-argument check ------------------------------------------------------

# JSON Data
JSON_GIT_USER  = 'jmbreitfeld'
JSON_GIT_REPO  = 'OSA-Ocean-Database'
JSON_GIT_PATH  = ''
LOCAL_JSON_DIR = File.join(MAP_DIR, 'OSAMaps', 'Database')

# -- Sail2 Timing System ----------------------------------------------------

def sail2_yaml_path
	File.join(DATA_DIR, XMLData.game, Char.name, "sail2.yaml")
end

def load_sail2_data
	path = sail2_yaml_path
	return {} unless File.exist?(path)
	raw = File.read(path)
	return {} if raw.strip.empty?
	YAML.safe_load(raw, permitted_classes: [Time, Symbol], aliases: true) || {}
rescue StandardError
	{}
end

def sail2_load_yaml_file(path)
	return {} unless File.exist?(path)
	raw = File.read(path)
	return {} if raw.strip.empty?
	YAML.safe_load(raw, permitted_classes: [Time, Symbol], aliases: true) || {}
rescue StandardError
	{}
end

def save_sail2_data(data)
	path = sail2_yaml_path
	FileUtils.mkdir_p(File.dirname(path))
	File.open(path, File::RDWR | File::CREAT, 0o644) do |file|
		file.flock(File::LOCK_EX)
		file.rewind
		YAML.dump(data, file)
		file.flush
		file.truncate(file.pos)
	end
rescue StandardError => e
	echo "--- sail2: failed to save timing data: #{e.message}"
end

# Timing key and display name for the ship you are on (keys match the saved sail2.yaml data)
SAIL2_SHIP_NAMES = {
	"sloop"      => ["sloop_times",      "Sloop"],
	"brigantine" => ["brigantine_times", "Brigantine"],
	"carrack"    => ["carrack_times",    "Carrack"],
	"galleon"    => ["galleon_times",    "Galleon"],
	"frigate"    => ["frigate_times",    "Frigate"],
	"man o' war" => ["manowar_times",    "Man O\'War"]
}

def ship_timing_key
	(SAIL2_SHIP_NAMES[sail2_ship_kind] || ["unknown_times"])[0]
end

def ship_display_name
	(SAIL2_SHIP_NAMES[sail2_ship_kind] || [nil, "Unknown"])[1]
end

def record_move_time(seconds)
	data = load_sail2_data
	key  = ship_timing_key
	data[key] ||= []
	data[key] << seconds.round(4)
	data[key] = data[key].last(50)
	save_sail2_data(data)
end

def average_move_seconds
	data  = load_sail2_data
	times = data[ship_timing_key]
	return 0.35 if times.nil? || times.empty?
	(times.sum / times.size.to_f).round(4)
end

def eastern_time(time)
	# Convert any Time object to US Eastern (auto DST)
	# DST: second Sunday in March through first Sunday in November
	year = time.utc.year
	dst_start = Time.utc(year, 3,  8 + (7 - Time.utc(year, 3,  8).wday) % 7, 2)
	dst_end   = Time.utc(year, 11, 1 + (7 - Time.utc(year, 11, 1).wday) % 7, 2)
	offset = (time.utc >= dst_start && time.utc < dst_end) ? -4 * 3600 : -5 * 3600
	Time.at(time.to_i + offset).utc
end

def format_duration(total_seconds)
	total_seconds = total_seconds.to_i
	h = total_seconds / 3600
	m = (total_seconds % 3600) / 60
	s = total_seconds % 60
	h > 0 ? "#{h}h #{m}m #{s}s" : (m > 0 ? "#{m}m #{s}s" : "#{s}s")
end
# -- End Sail2 Timing System ------------------------------------------------


def sail2_sync_echo(msg); respond "[MapSync: #{msg}]" rescue puts msg; end

def sail2_download_folder(user, repo, api_path, local_dir)
  FileUtils.mkdir_p(local_dir) unless Dir.exist?(local_dir)
  api_url = "https://api.github.com/repos/#{user}/#{repo}/contents/#{api_path}"
  
  begin
    # GitHub API requires a User-Agent header [cite: 26, 27]
    response = URI.open(api_url, "User-Agent" => "Lich-Map-Syncer").read
    data = JSON.parse(response)

    unless data.is_a?(Array)
      sail2_sync_echo("Error: #{api_path} in #{repo} is not a folder.")
      return 0
    end

    count = 0
    data.each do |file|
      next unless file['type'] == 'file' # Only download files, skip folders [cite: 30]
      
      file_name    = file['name']
      remote_size  = file['size'].to_i
      download_url = file['download_url']
      local_path   = File.join(local_dir, file_name)

      # Only download if file is missing or size has changed [cite: 31]
      if !File.exist?(local_path) || File.size(local_path) != remote_size
        sail2_sync_echo("Downloading: #{file_name} from #{repo}...")
        URI.open(download_url) do |remote|
          File.open(local_path, "wb") { |local| local.write(remote.read) }
        end
        count += 1
      end
    end
    count
  rescue => e
    sail2_sync_echo("Error syncing #{repo}/#{api_path}: #{e.message}")
    0
  end
end

def sync_all
  sail2_sync_echo("Connecting to GitHub APIs...")
  
  # 1. Sync the JSON data from the separate Git 
  json_updates = sail2_download_folder(JSON_GIT_USER, JSON_GIT_REPO, JSON_GIT_PATH, LOCAL_JSON_DIR)

  total = json_updates
  if total > 0
    sail2_sync_echo("Success! Updated #{total} files from one repository.")
  else
    sail2_sync_echo("All files are up to date.")
  end
end

