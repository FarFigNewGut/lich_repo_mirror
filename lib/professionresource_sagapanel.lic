=begin
  professionresource_sagapanel.lic

  Saga-only panel showing this character's profession resource via Infomon's
  Lich::Resources tracking. The title displays the first word of the resource
  name and is clickable.

  No profession -> resource mapping is hardcoded here. The resource name
  and values come straight from the game's own RESOURCE command output
  (parsed by lib/gemstone/infomon/parser.rb into Lich::Resources.type/
  weekly/total), so this automatically follows whichever resource this
  character's profession actually has.

  Display modes:
    compact  - abbreviated values, such as W:45.1k/50k
    percent  - percentages, such as W:90.2%/100%
    both     - abbreviated values with the current percentage
    full     - comma-formatted values, such as W:45,100/50,000

  The default mode is compact. Click the resource title or use:
    *prmode  - cycle compact, percent, both, and full display modes

  The panel refreshes resource values automatically every 30 seconds.

  Author: Phocosoen, ChatGPT
  Tags: saga, frontend, mod, window, resource, profession
  Version: 1.1.0
	Recently changed: Added display mode options.
=end

no_kill_all

unless $frontend == 'saga'
  respond ""
  respond " professionresource_sagapanel relies on a Saga-specific dialog"
  respond " window and will not work correctly on other frontends."
  respond ""
  exit
end

module ProfessionResourceSagaPanel
  extend self
  include Lich::Common if defined?(Lich::Common)

  class << self
    attr_accessor :display_mode
  end
end

PR_REFRESH_SECONDS = 30

# Display modes: :compact -> 45.1k/50k, :percent -> 90.2%/100%,
# :both -> 45.1k/50k (90.2%). Use :full for the original comma format.
PR_DISPLAY_MODE = :compact
PR_WEEKLY_CAP = 50_000
PR_TOTAL_CAP = 200_000
PR_DISPLAY_MODES = [:compact, :percent, :both, :full].freeze
ProfessionResourceSagaPanel.display_mode = PR_DISPLAY_MODE

def ProfessionResourceSagaPanel.refresh_from_game
  Lich::Resources.check(true)
rescue StandardError
  nil
end

def ProfessionResourceSagaPanel.signature
  [Lich::Resources.type, Lich::Resources.weekly, Lich::Resources.total]
end

def ProfessionResourceSagaPanel.compact_amount(value)
  amount = value.to_f
  return '0' if amount.zero?

  if amount.abs >= 1000
    abbreviated = (amount / 1000.0).round(1)
    abbreviated = abbreviated.to_i if abbreviated == abbreviated.to_i
    "#{abbreviated}k"
  else
    amount.to_i.to_s
  end
end

def ProfessionResourceSagaPanel.percent_amount(value, maximum)
  percentage = ((value.to_f / maximum.to_f) * 100).round(1)
  percentage = percentage.to_i if percentage == percentage.to_i
  "#{percentage}%"
end

# The current/max/percent strings for one row (W or T), for whatever
# display_mode is active. :percent's "max" is always the literal "100%",
# same both rows, so no column padding is needed for it.
def ProfessionResourceSagaPanel.row_fields(current, maximum)
  current = current || 0

  case ProfessionResourceSagaPanel.display_mode
  when :percent
    { current: percent_amount(current, maximum), max: '100%', percent: nil }
  when :both
    { current: compact_amount(current), max: compact_amount(maximum), percent: percent_amount(current, maximum) }
  when :full
    { current: current.to_i.with_commas, max: maximum.to_i.with_commas, percent: nil }
  else
    { current: compact_amount(current), max: compact_amount(maximum), percent: nil }
  end
end

def ProfessionResourceSagaPanel.cycle_display_mode
  current_index = PR_DISPLAY_MODES.index(display_mode) || 0
  self.display_mode = PR_DISPLAY_MODES[(current_index + 1) % PR_DISPLAY_MODES.length]
end

# Right-pads `str` out to `width` characters using repeated non-breaking-
# space XML entities (not plain Ruby String#rjust -- that pads by repeating
# individual CHARACTERS of its fill string, which would mangle a multi-char
# entity like "&#160;" into garbage instead of inserting whole copies of it).
def ProfessionResourceSagaPanel.nbsp_pad(str, width)
  deficit = width - str.length
  return str if deficit <= 0

  ("&#160;" * deficit) + str
end

# Builds each row (W/T) as ONE combined label, with the current/max/percent
# fields individually right-padded (via nbsp_pad) to the widest string
# either row needs in that field, so the "/" and subsequent text line up at
# the same character position across both rows regardless of digit count.
#
# This intentionally does NOT split each row into separately left-positioned
# label elements -- an earlier version tried computing pixel offsets between
# adjacent elements using a rough px-per-character heuristic (PR_CHAR_WIDTH),
# but that heuristic doesn't match Saga's real (proportional) font metrics
# closely enough, and the drift compounded across elements into visible
# overlap. A single string with padding characters avoids needing to predict
# any pixel width at all -- it only relies on same-width strings (padding
# included) rendering at roughly the same width as each other, which holds
# for repeated characters in one font regardless of what that font's actual
# metrics are.
def ProfessionResourceSagaPanel.build_resource_rows(weekly, total)
  weekly_fields = ProfessionResourceSagaPanel.row_fields(weekly, PR_WEEKLY_CAP)
  total_fields  = ProfessionResourceSagaPanel.row_fields(total, PR_TOTAL_CAP)

  current_width = [weekly_fields[:current].length, total_fields[:current].length].max
  max_width     = [weekly_fields[:max].length, total_fields[:max].length].max
  percent_width = [weekly_fields[:percent]&.length.to_i, total_fields[:percent]&.length.to_i].max

  out = String.new
  [['W', weekly_fields, 20], ['T', total_fields, 40]].each do |prefix, fields, top|
    current = ProfessionResourceSagaPanel.nbsp_pad(fields[:current], current_width)
    max     = ProfessionResourceSagaPanel.nbsp_pad(fields[:max], max_width)
    line = "#{prefix}:#{current}/#{max}"
    line += " (#{ProfessionResourceSagaPanel.nbsp_pad(fields[:percent], percent_width)})" if fields[:percent]

    out << "<label id='pr_#{prefix.downcase}' value='#{line}' justify='left' left='0' top='#{top}' />"
  end

  out
end

def ProfessionResourceSagaPanel.build_dialog
  type   = Lich::Resources.type
  weekly = Lich::Resources.weekly
  total  = Lich::Resources.total

  out = String.new("<dialogData id='ProfessionResourceSagaPanel' clear='t'>")

  if type.nil? || type.to_s.empty?
    out << "<label id='pr_none' value='Resource: detecting...' justify='left' left='0' top='0'/>"
  else
    display_type = type.to_s.split.first
    out << "<link id='pr_type' value='#{display_type}' cmd=';e ProfessionResourceSagaPanel.cycle_display_mode; _respond(ProfessionResourceSagaPanel.build_dialog)' echo='Cycling resource display format...' justify='left' left='0' top='0' />"
    out << ProfessionResourceSagaPanel.build_resource_rows(weekly, total)
  end

  out << "</dialogData>"
  out
end

pr_upstream_hook_id = "#{Script.current.name}_upstream"
UpstreamHook.remove(pr_upstream_hook_id) rescue nil
UpstreamHook.add(pr_upstream_hook_id, proc do |command|
  if command.strip =~ /\A\*prmode\b/i
    next_mode = ProfessionResourceSagaPanel.cycle_display_mode
    _respond(ProfessionResourceSagaPanel.build_dialog)
    respond "Resource display: #{next_mode}"
    nil
  else
    command
  end
end)

_respond("<closeDialog id='ProfessionResourceSagaPanel'/><openDialog type='dynamic' id='ProfessionResourceSagaPanel' title='Resource' target='ProfessionResourceSagaPanel' resident='true'>" + ProfessionResourceSagaPanel.build_dialog + "</openDialog>")

before_dying do
  UpstreamHook.remove(pr_upstream_hook_id) rescue nil
  _respond("<closeDialog id='ProfessionResourceSagaPanel'/>")
end

echo "Professionresource_sagapanel is active."

ProfessionResourceSagaPanel.refresh_from_game

@pr_last_signature = ProfessionResourceSagaPanel.signature
@pr_last_refresh_at = Time.now
@pr_last_redraw_at = Time.at(0)

loop do
  UpstreamHook.add(pr_upstream_hook_id, proc do |command|
    if command.strip =~ /\A\*prmode\b/i
      next_mode = ProfessionResourceSagaPanel.cycle_display_mode
      _respond(ProfessionResourceSagaPanel.build_dialog)
      respond "Resource display: #{next_mode}"
      nil
    else
      command
    end
  end) unless UpstreamHook.list.include?(pr_upstream_hook_id)

  if (Time.now - @pr_last_refresh_at) > PR_REFRESH_SECONDS
    ProfessionResourceSagaPanel.refresh_from_game
    @pr_last_refresh_at = Time.now
  end

  signature = ProfessionResourceSagaPanel.signature
  if signature != @pr_last_signature || (Time.now - @pr_last_redraw_at) > 1.0
    @pr_last_signature = signature
    @pr_last_redraw_at = Time.now
    _respond(ProfessionResourceSagaPanel.build_dialog)
  end
  sleep 0.25
end
