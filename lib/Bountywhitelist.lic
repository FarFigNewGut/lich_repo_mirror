#Checks the adventurer's guild bounty to see if it's on your personal whitelist.
#If it isn't, runs ebounty again to remove it.

=begin
  BountyWhitelist.lic
  Annoyed that ;ebounty doesn't have a whitelist and only a blacklist? 
  Want to do skin quests for some mobs that are rare and are incidentally accumulating their skins,
  but don't want to do kill quests for the same reason?
  This script solves both problems.
  
  How to use:
  The main commands are mob, skin, and both. Any of these can be reversed by adding "remove-" before them.
  
  Setup commands:
  ;bountywhitelist mob <mobname>           - Accept kill tasks of all kinds for this mob.
						                     That means culling, heirloom looting tasks, and bosses.
  ;bountywhitelist skin <mobname>          - Accept skinning tasks for this mob.
								             Completely independent of kill tasks.
									         For rarer mobs that you kill in a normal run and keep the skins of.
									         Think Triton Magi in Nelemar, for instance.
  ;bountywhitelist both <mobname>          - Accept both kill and skin tasks for both.
  ;bountywhitelist remove-mob <mobname>    - Delete a mob from the kill list.
  ;bountywhitelist remove-skin <mobname>   - Delete a mob from the skinning list.
  ;bountywhitelist remove-both <mobname>   - Delete a mob from both lists at once.
  ;bountywhitelist settings                - Display your current skin and kill lists.
  
  Running Commands:
  ;bountywhitelist run                     - Run the script with your current settings.
  ;bountywhitelist dryrun                  - Informs you what it's going to do with your current settings
                                             if you were to type "run" instead.
  Other commands:
  ;bountywhitelist clear-mobs              - Delete ALL mobs from your kill list.
  ;bountywhitelist clear-skins             - Delete ALL mobs from your skinning list.
  ;bountywhitelist full-reset              - Deletes your settings file.
											 Effectively a clear-both command.
										     Good if I've made changes that creates a bugged state for you,
											 or you've left your current hunting ground but not the town,
											 and don't want to go back for any bounties.
  
            author: Renian
              game: Gemstone
              tags: bounty, ebounty
          required: Lich >= 5.15.0
           version: 0.1.1
  Changelog:
  v0.1.1 - Added more info about how to use the script for ;repo info bountywhitelist.lic.
		   Fixed a bug that caused the script to improperly trade in bandit bounties.
		   Removed some of the ECHOes. Should add a logging system for those.
  v0.1.0 - Initial Release
=end

require 'yaml'

class BountyWhitelist	
	def initialize
		@yamlFilename = File.join(DATA_DIR, XMLData.game, Char.name, "bountywhitelist.yaml")
		@settings = yamlLoad
	end
	
	def yamlLoad
		data = if File.exist?(@yamlFilename)
			respond "Settings file found."
			YAML.unsafe_load(File.read(@yamlFilename))
		  else
			respond "Settings not found. Assuming this is the first run."
			d = {}
			d[:skins] = []
			d[:mobs] = []
		    d
		  end
		return data
	end
	
	def yamlSave
		respoond "### Writing settings to #{@yamlFilename}"
		File.write(@yamlFilename, YAML.dump(@settings))
	end
	
	def fullReset
		respond "### Deleting YAML file."
		File.delete(@yamlFilename)
	end
	
	def main
		args = Script.current.vars;
		
		if args.size == 0
			showHelp
			exit
		end
		
		case args[0]
		when /dryrun/
			dryRun
		when /run/
			run
		when /settings/
			echoSettings
		when /remove-skin ([\s\w-]+)/
			removeSkin($1)
		when /remove-mob ([\s\w-]+)/
			removeMob($1)
		when /remove-both ([\s\w-]+)/
			removeSkin($1)
			removeMob($1)
		when /skin ([\s\w-]+)/
			addSkin($1)
		when /mob ([\s\w-]+)/
			addMob($1)
		when /both ([\s\w-]+)/
			addSkin($1)
			addMob($1)
		when /clear-skins/
			clearSkins
		when /clear-mobs/
			clearMobs
		when /full-reset/
			fullReset
		else
			respond "### Invalid input: #{args[0]}"
			respond "### Run the script with no arguments to see all the possible commands."
		end
		
	end
	
	def showHelp
		respond "### Runtime commands:"
		respond "### ;BountyWhitelist run       - Checks your bounty to see if its on your personal whitelist,"
		respond "                                 dodging the problem with ebounty only having blacklists."
		respond "                                 If you have nothing set, this does nothing."
		respond "                                 If you have only skins set, this only checks skin tasks."
		respond "                                 If you have creatures added, then ONLY those creatures will not be traded in,"
        respond "								  so make sure you have everything."
		respond "### ;BountyWhitelist dryrun	- Tells you what it would do if it ran given your settings and current bounty."
		respond "### ;BountyWhitelist settings  - Echo current settings."
		respond "#############################################################################################"
		respond "### Setting commands:"
		respond "### Prepend all of these with ;BountyWhitelist. ex. ;BountyWhitelist --add-skins-only <name>"
		respond "### skin <name>                - Adds a creature's skin to your whitelist."
		respond "                                 Great for rarer creatures or creatures that stealth that you incidentally kill and skin."
		respond "### mob <name>                 - Adds a creature's non-skinning tasks to your whitelist."
		respond "                                 This does not effect HEIRLOOM SEARCH bounties, only kill ones."
		respond "### both <name>                - Adds both tasks for that creature to your whitelist."
		respond "### remove-skin <name>         - Removes a craeture from your skins whitelist."
		respond "### remove-mob <name>          - Removes a creature from your non-skinning whitelist."
		respond "### remove-mob <name>          - Removes a creature from your skins and non-skins whitelists."
		respond "### clear-skins <name>         - Removes all skins from your whitelist."
		respond "### clear-mobs <name>          - Removes all creatures from your whitelist. Do this if you want to use your blacklist instead."
		respond "### full-reset       	        - Deletes your settings file completely. Essentially clear-both."
		respond "### backup                     - Create a backup of your current settings. (Not yet implemented)"
		respond "                                 Stored in the character's data folder with the current UNIX timestamp appended."
	end

	
	def echoSettings
		respond "### #{checkname}, your whitelists are as follows:"
		respond "###"
		respond "### Skins:"
		for skin in @settings[:skins].sort
			respond "### - #{skin}"
		end
		respond "###"
		respond "### Mobs:"
		for mob in @settings[:mobs].sort
			respond "### - #{mob}"
		end
	end
	
	def addSkin(name)
		if (@settings[:skins].include?(name))
			respond "### You have already whitelisted #{name} skins."
			exit
		end
		@settings[:skins].push(name)
		echo @settings[:skins]
		respond "### You are now accepting #{name} skin tasks."
		yamlSave
	end
	
	def removeSkin(name)
		if (!@settings[:skins].include?(name))
			respond "### You didn't whitelist #{name} skins!"
			exit
		end
		@settings[:skins].delete_at(@settings[:skins].find_index(name))
		respond "### #{name} skins are no longer whitelisted."
		yamlSave
	end
	
	def addMob(name)
		if (@settings[:mobs].include?(name))
			respond "### You have already whitelisted #{name} non-skinning tasks!"
			exit
		end
		@settings[:mobs].push(name)
		respond "### #{name} non-skinning tasks are now whitelisted."
		echo @settings[:mobs]
		yamlSave
	end
	
	def removeMob(name)
		if (!@settings[:mobs].include?(name))
			respond "### You didn't whitelist #{name} non-skinning tasks!"
			exit
		end
		index = @settings[:mobs].find_index(name)
		echo index
		@settings[:mobs].delete_at(@settings[:mobs].find_index(name))
		respond "### #{name} non-skinning tasks are no longer whitelisted."
		echoSettings
		yamlSave
	end
	
	def clearSkins
		currentSkins = @settings[:skins]
		@settings[:skins] = []
		respond "### Cleared all skins."
		respond "### In case this was a mistake, here's the skins you were looking for:"
		for skin in currentSkins
			respond "### * #{skin}"
		end
		yamlSave
	end
	
	def clearMobs
		currentMobs = @settings[:mobs]
		@settings[:mobs] = []
		respond "### Cleared all mobs."
		respond "### In case this was a mistake, here's the mobs you wanted to kill:"
		for mob in currentMobs
			respond "### * #{mob}"
		end
		yamlSave
	end
	
	def shouldRemove
		!settingsAreEmpty && !isBanditBounty && (shouldRemoveSkinBounty || shouldRemoveMobBounty)
	end
	
	def settingsAreEmpty
		@settings[:skins].size == 0 && @settings[:mobs].size == 0
	end
	
	def isBanditBounty
		checkbounty =~ /suppress bandit activity/
	end
	
	def shouldRemoveSkinBounty
		b = checkbounty
		
		if b =~ /furrier/
			for skin in @settings[:skins]
				if b =~ /#{skin}/
					return false
				end
			end
			return true #Skin bounty not found
		end
		
		return false #Not a skin bounty
	end
	
	def shouldRemoveMobBounty
		b = checkbounty
		
		if b !~ /particularly dangerous|tasked to suppress|that an unfortunate citizen lost/
			return false
		end
		
		for mob in @settings[:mobs]
			if b =~ /#{mob}/
				return false
			end
		end
		
		return true
	end
	
    def run
		if shouldRemove
			#echo shouldRemoveSkinBounty
			#echo shouldRemoveMobBounty
			start_script "ebounty", ["remove"]
		else
			respond "### The current bounty is WHITELISTED."
		end
		exit
	end
	
	def dryRun
		# The shouldRemove calls are added as a sanity test. 
		# The size check is there to explain why it won't be removed. 
		# But if the shouldRemove says it still should, there's a code problem.
		if settingsAreEmpty
			respond "### Nothing will be removed because you have added nothing to any whitelist."
			exit
		end
		if shouldRemove
			if shouldRemoveSkinBounty
				respond "### The current bounty would be removed because it is not a skin you are searching for."
			elsif shouldRemoveMobBounty
				respond "### The current bounty would be removed because it is not a mob you are trying to kill or find searchable heirlooms for."
			else
				respond "### !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!"
				respond "### The current bounty should be removed...but I can't figure out why! Check the code. Something's wrong."
			end
		elsif isBanditBounty
			respond "### You have a bandit bounty, which is not something this script should influence, and therefore is effectively WHITELISTED."
		elsif checkbounty =~ /You are not currently assigned a task/
			respond "### You don't have a task."
		else
			respond "### The current bounty is WHITELISTED."
		end
	end
end

__bwl = BountyWhitelist.new()
__bwl.main()