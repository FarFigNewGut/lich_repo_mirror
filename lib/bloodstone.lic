#    bloodstone.lic
#    Allows per-character tracking of item settings, thresholds, and toggles.
#
#    SYNTAX:
#      ;bloodstone help
#      ;bloodstone set adjective <gold|silver|none>
#      ;bloodstone set noun <ring|earrings|detect>
#      ;bloodstone set health <percentage>
#      ;bloodstone set mana <percentage>
#      ;bloodstone set stamina <percentage>
#      ;bloodstone toggle <health|mana|stamina>

# Initialize defaults
CharSettings['adjective']    ||= ""
CharSettings['noun']         ||= nil # Starts nil to trigger auto-detection
CharSettings['health']       ||= 60
CharSettings['mana']         ||= 40
CharSettings['stamina']      ||= 35
CharSettings['health_on']    = true if CharSettings['health_on'].nil?
CharSettings['mana_on']      = true if CharSettings['mana_on'].nil?
CharSettings['stamina_on']   = true if CharSettings['stamina_on'].nil?

# Full auto-detection engine for both adjective and noun
def detect_bloodstone_jewelry
  candidates = (GameObj.inv || []).select { |obj|
    obj.name =~ /bloodstone/i && obj.noun !~ /^(?:bloodstone|chunk)$/i
  }
  
  return nil unless candidates.size == 1
  target_obj = candidates.first

  # Clean the full name to pull potential adjectives before "bloodstone"
  # Handles patterns like: "a polished bloodstone cuff" or "some ancient bloodstone earrings"
  detected_adj = ""
  if target_obj.name =~ /^(?:a|an|some|the)?\s*(.*?)\s+bloodstone/i
    raw_adj = $1.strip
    # Only save if it's not empty and isn't just an article
    detected_adj = raw_adj unless raw_adj.empty?
  end

  { noun: target_obj.noun, adjective: detected_adj }
end

# Verify or detect the target settings, with worn inventory checks
def verify_and_get_target
  if CharSettings['noun']
    # Safety Check: Ensure the user is actually wearing their custom-set noun
    unless (GameObj.inv || []).any? { |obj| obj.noun == CharSettings['noun'] }
      respond "--- WARNING: Saved item noun '#{CharSettings['noun']}' does not match anything you are currently wearing!"
      respond "--- Please wear your item or use ';bloodstone set noun detect' to reset."
      exit
    end
    return
  end
  
  detected = detect_bloodstone_jewelry
  if detected
    CharSettings['noun'] = detected[:noun]
    CharSettings['adjective'] = detected[:adjective]
    
    adj_display = CharSettings['adjective'].empty? ? "" : "#{CharSettings['adjective']} "
    respond "--- Bloodstone: Auto-detected worn jewelry: #{adj_display}#{CharSettings['noun']}"
  else
    respond "--- Bloodstone: Could not auto-detect any unique bloodstone jewelry on your person."
    respond "--- Please ensure the item is worn, or set it manually using ';bloodstone set noun <noun>'"
    exit
  end
end

# Help & Status readout
def display_help
  current_adj = CharSettings['adjective'].empty? ? "(none)" : "'#{CharSettings['adjective']}'"
  current_noun = CharSettings['noun'] || "(will auto-detect)"
  
  status_health  = CharSettings['health_on']  ? "ON  (#{CharSettings['health']}%)" : "OFF"
  status_mana    = CharSettings['mana_on']    ? "ON  (#{CharSettings['mana']}%)"   : "OFF"
  status_stamina = CharSettings['stamina_on'] ? "ON  (#{CharSettings['stamina']}%)" : "OFF"

  respond "--- Bloodstone: Current Settings ---"
  respond "  Adjective:  #{current_adj}"
  respond "  Noun:       '#{current_noun}'"
  respond "  Health:      #{status_health}"
  respond "  Mana:        #{status_mana}"
  respond "  Stamina:     #{status_stamina}"
  respond "--------------------------------------"
  respond "To update settings for this character, use:"
  respond "  ;bloodstone set adjective <value>  - Sets item modifier (e.g., gold)"
  respond "  ;bloodstone set adjective none     - Removes the item adjective modifier"
  respond "  ;bloodstone set noun <value>       - Sets the base item noun (e.g., ring)"
  respond "  ;bloodstone set noun detect        - Forgets saved noun/adjective and re-detects"
  respond "  ;bloodstone set health <#>         - Set health trigger percent"
  respond "  ;bloodstone set mana <#>           - Set mana trigger percent"
  respond "  ;bloodstone set stamina <#>        - Set stamina trigger percent"
  respond "  ;bloodstone toggle <resource>      - Turn health, mana, or stamina checks ON/OFF"
  respond "--------------------------------------"
end

# Command parser - Only evaluate regex if the array is not empty
if Script.current.vars && !Script.current.vars.empty?
  if Script.current.vars =~ /^help$/i
    display_help
    exit
  elsif Script.current.vars =~ /^toggle\s+(health|mana|stamina)$/i
    target = $1.downcase
    setting_key = "#{target}_on"
    CharSettings[setting_key] = !CharSettings[setting_key]
    status_str = CharSettings[setting_key] ? "ENABLED" : "DISABLED"
    respond "--- Bloodstone: #{target.capitalize} check has been #{status_str}."
    exit
  elsif Script.current.vars =~ /^set\s+(\w+)\s+(.+)$/i
    action = $1.downcase
    value  = $2.strip

    if action == 'adjective'
      if value =~ /^none$/i
        CharSettings['adjective'] = ""
        respond "--- Bloodstone: Adjective removed."
      else
        CharSettings['adjective'] = value.downcase
        respond "--- Bloodstone: Adjective set to '#{CharSettings['adjective']}'"
      end
      exit
    elsif action == 'noun'
      if value =~ /^detect$/i
        CharSettings['noun'] = nil
        CharSettings['adjective'] = ""
        respond "--- Bloodstone: Saved configurations cleared. Will re-detect on launch."
      else
        CharSettings['noun'] = value.downcase
        respond "--- Bloodstone: Noun set to '#{CharSettings['noun']}'"
      end
      exit
    elsif ['health', 'mana', 'stamina'].include?(action) && value =~ /^-?\d+$/
      CharSettings[action] = value.to_i
      respond "--- Bloodstone: #{action.capitalize} threshold set to #{CharSettings[action]}%"
      exit
    else
      respond "--- Invalid syntax."
      display_help
      exit
    end
  else
    respond "--- Unknown command."
    display_help
    exit
  end
end

# Validate and secure your target item properties before beginning the monitor loop
verify_and_get_target

# Main loop
loop {
  # Combat safety filters (Fast-checks every 1s when incapacitated)
  if stunned? || dead? || webbed? || sleeping? || silenced?
    sleep 1
    next
  end

  # Re-read parameters continuously in case item settings change mid-run
  item_target = "#{CharSettings['adjective']} #{CharSettings['noun']}".strip

  # Trigger blocks utilizing explicit toggle flags
  if CharSettings['health_on'] && percenthealth <= CharSettings['health'] && !Effects::Cooldowns.active?("Vivacity (Health)")
    waitcastrt?
    waitrt?
    fput "beseech my #{item_target} health"
  end

  if CharSettings['mana_on'] && percentmana <= CharSettings['mana'] && !Effects::Cooldowns.active?("Vivacity (Mana)")
    waitcastrt?
    waitrt?
    fput "beseech my #{item_target} mana"
  end

  if CharSettings['stamina_on'] && percentstamina <= CharSettings['stamina'] && !Effects::Cooldowns.active?("Vivacity (Stamina)")
    waitcastrt?
    waitrt?
    fput "beseech my #{item_target} stamina"
  end

  sleep 5
}
