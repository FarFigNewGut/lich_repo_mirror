=begin
  effectsbar_sagapanel.lic

  Saga-only panel showing your active buffs and debuffs as emoji icons with
  countdown timers, so you don't have to open the native Debuffs dialog to
  see what's on you. Tracks Effects::Debuffs (bleeds, poisons, mental-status
  effects, etc), a small set of tracked Effects::Buffs (currently Celerity),
  and posture/Hidden (sitting/kneeling/prone/dead/hidden, read from GS4's
  compass indicator flags). Hidden always shows first when active, posture
  right after it, then buffs, then debuffs in the order they were applied.
  Posture/Hidden have no duration (they persist until you change stance or
  break stealth) so they render icon-only; everything else shows its
  remaining time and clears on its own once it expires.

  Each icon is also a clickable link that echoes its name to the main
  window, since Saga dialogs don't support hover tooltips.

  Usage:
    ;effectsbar_sagapanel.lic              - Start the panel

  Commands:
    *ebar dir                    - Toggle horizontal/vertical layout
    *ebar col2                   - 2-column grid: non-debuffs (Hidden/
                                    posture/buffs) fill column 1 top to
                                    bottom, debuffs fill column 2
    *ebar row2                   - 2-row grid: non-debuffs fill row 1 left
                                    to right, debuffs fill row 2
    *ebar test                   - Toggle a test mode showing every known
                                    icon at once (alphabetically), all
                                    counting down from 30 seconds together
                                    and clearing once expired -- lets you
                                    check every icon renders and durations
                                    tick without waiting to actually get hit
                                    with each effect

  Tags: saga, frontend, mod, window, effects, debuffs, status
  Author: RuseofFools, Claude
  Version: 1.0.0
  Recently changed:
=end

no_kill_all

require 'yaml'

unless $frontend == 'saga'
  respond ""
  respond " effectsbar relies on a Saga-specific dialog window and will not"
  respond " work correctly on other frontends."
  respond ""
  exit
end

module EffectsBar
  extend self
  include Lich::Common if defined?(Lich::Common)

  ROW_HEIGHT = 20
  ICON_COL_WIDTH = 40   # horizontal mode: pixels per icon column
  ICON_ROW_HEIGHT = 40  # horizontal mode: icon row + duration row
  VERTICAL_LABEL_LEFT = 24 # vertical mode: name/duration text left offset from icon
  # Nudges the duration text right of the icon's own left edge in horizontal
  # mode -- emoji glyphs render wider than the duration text's few
  # characters, so lining both up on the same left edge left the duration
  # looking shifted left of its icon instead of centered under it.
  DURATION_LEFT_NUDGE = 8

  # horizontal: single row, columns grow. vertical: single column, rows grow
  # (icon + inline name/duration text). row2/col2: a grid capped at exactly
  # 2 rows/2 columns respectively (the other dimension grows to fit),
  # rendered in the same icon-above-duration cell style as horizontal.
  LAYOUTS = %w[horizontal vertical row2 col2].freeze

  # XML numeric character references, not raw UTF-8 literals -- raw
  # non-ASCII bytes don't reliably survive a dialog control's value=''
  # attribute (same reasoning as creaturewindow's status-icon tables).
  # Debuff icons, keyed by the exact name Effects::Debuffs.to_h uses.
  DEBUFF_ICON_MAP = {
    "Bleeding"    => "&#x1FA78;",
    "Blinded"     => "&#x1F648;",
    "Poisoned"    => "&#x1F922;",
    "Diseased"    => "&#x1F92E;",
    "Stunned"     => "&#x26A1;",
    "Webbed"      => "&#x1F578;&#xFE0F;",
    "Bind"        => "&#x26D3;&#xFE0F;",
    "Calm"        => "&#x1F60C;",
    "Confused"    => "&#x2753;",
    "Confusion"   => "&#x1F300;",
    "Curse"       => "&#x1F608;",
    "Doom Sign"   => "&#x2620;&#xFE0F;",
    "Frenzy"      => "&#x1F621;",
    "Major Bleed" => "&#x1FA78;&#x1FA78;",
    "Mindwipe"    => "&#x1F92F;",
    "Overexerted" => "&#x1F975;",
    "Rooted"      => "&#x1FAB5;",
    "Silenced"    => "&#x1F64A;",
    "Sleep"       => "&#x1F634;",
    "Sounds"      => "&#x1F649;",
    "Sympathy"    => "&#x1F60D;",
    "Vertigo"     => "&#x1F635;&#x200D;&#x1F4AB;",
    "Hiding"      => "&#x1F977;",
    "Slow"        => "&#x231B;",
    "Frozen"      => "&#x1F976;",
    "Terrified"   => "&#x1F631;"
  }.freeze

  # "Wall of Thorns Poison 1" .. "Wall of Thorns Poison 5" -- shown as
  # "#<tier><nauseated face>", a single icon with its tier number prefixed,
  # not the icon repeated per tier.
  WALL_OF_THORNS_POISON = /\AWall of Thorns Poison (\d+)\z/.freeze
  WALL_OF_THORNS_POISON_ICON = "&#x1F922;".freeze

  # Posture -- reuses playerwindow.lic's exact emoji codepoints for these
  # same states. No duration: these persist until you change stance, not a
  # timed effect.
  POSTURE_ICON_MAP = {
    "Dead"     => "&#x1FAA6;",
    "Kneeling" => "&#x1F9CE;",
    "Prone"    => "&#x1F6CC;",
    "Sitting"  => "&#x1FA91;"
  }.freeze
  # Checked in this order -- dead/kneeling/prone take priority over sitting
  # if somehow more than one indicator is simultaneously true.
  POSTURE_INDICATOR_ORDER = [
    ["Dead", "IconDEAD"],
    ["Kneeling", "IconKNEELING"],
    ["Prone", "IconPRONE"],
    ["Sitting", "IconSITTING"]
  ].freeze

  # Bleeding/Poisoned/Diseased each have their own XMLData.indicator flag
  # (IconBLEEDING/IconPOISONED/IconDISEASED), read the same way posture is --
  # separate from the Effects::Debuffs dialog, so one can be active without
  # the other. They're debuffs, not posture/Hidden, so despite being read
  # via indicator flags they still group into row/column 2 for row2/col2.
  INDICATOR_DEBUFF_ORDER = [
    ["Bleeding", "IconBLEEDING"],
    ["Poisoned", "IconPOISONED"],
    ["Diseased", "IconDISEASED"]
  ].freeze

  # Hidden isn't a debuff (no entry in Effects::Debuffs) -- it's read the
  # same way posture is, from XMLData.indicator['IconHIDDEN']. Reuses the
  # same ninja icon as the "Hiding" *debuff* (a separate, timed effect that
  # can come from a different source) since they're the same concept
  # visually; distinguishing them isn't worth a second icon. Always sorted
  # first when active -- see EffectsBar.entries.
  HIDDEN_ICON = "&#x1F977;".freeze

  # Buffs -- same Effects::Debuffs mechanism (lib/gemstone/effects.rb) but
  # reading Effects::Buffs instead, so these ARE timed like debuffs (unlike
  # posture/Hidden). Kept in a separate category from debuffs for row2/col2
  # grouping (see assign_grid_positions) -- non-debuffs (Hidden/posture/
  # buffs) in row/column 1, debuffs in row/column 2.
  BUFF_ICON_MAP = {
    "Celerity" => "&#x23F1;&#xFE0F;"
  }.freeze

  EB_DEFAULT_WINDOW_SETTINGS = {
    "effectsbar" => {
      "layout" => "row2"
    }
  } unless defined?(EB_DEFAULT_WINDOW_SETTINGS)

  class << self
    attr_accessor :layout, :test_mode
  end
end

def EffectsBar.window_settings_path(name: Char.name)
  base_dir = "#{$data_dir}#{XMLData.game}/#{name}"
  Dir.mkdir("#{$data_dir}#{XMLData.game}") unless File.exist?("#{$data_dir}#{XMLData.game}")
  Dir.mkdir(base_dir) unless File.exist?(base_dir)
  File.join(base_dir, "lichwindows.yaml")
end

def EffectsBar.load_window_settings
  filename = EffectsBar.window_settings_path
  settings_hash = File.exist?(filename) ? YAML.load_file(filename) : {}
  settings_hash = {} unless settings_hash.is_a?(Hash)
  settings_hash["effectsbar"] ||= EffectsBar::EB_DEFAULT_WINDOW_SETTINGS["effectsbar"].dup
  settings_hash
end

def EffectsBar.save_window_settings(settings)
  File.write(EffectsBar.window_settings_path, settings.to_yaml)
end

def EffectsBar.set_layout!(new_layout)
  settings = EffectsBar.load_window_settings
  EffectsBar.layout = new_layout
  settings["effectsbar"]["layout"] = new_layout
  EffectsBar.save_window_settings(settings)
end

@eb_settings = EffectsBar.load_window_settings
EffectsBar.layout = EffectsBar::LAYOUTS.include?(@eb_settings["effectsbar"]["layout"]) ? @eb_settings["effectsbar"]["layout"] : "row2"
EffectsBar.test_mode = false

def EffectsBar.sanitize_xml(value)
  value.to_s.gsub("&", "&amp;").gsub("<", "&lt;").gsub(">", "&gt;").gsub("'", "&apos;").gsub('"', "&quot;")
end

def EffectsBar.format_duration(seconds)
  return "" if seconds.nil? || seconds <= 0

  if seconds >= 3600
    "#{(seconds / 3600).to_i}h"
  elsif seconds >= 60
    "#{(seconds / 60).to_i}m"
  else
    "#{seconds.to_i}s"
  end
end

# [left, top] pixel origin for every entry, in the icon-above-duration cell
# style shared by horizontal/row2/col2 -- one array, same order as `entries`.
#
# horizontal: single row, columns grow (category is irrelevant, just fills
# left to right in entries' own order -- which already puts non-debuffs
# before debuffs, since EffectsBar.entries builds hidden+postures+buffs
# before debuffs).
#
# row2: row 1 = non-debuffs (Hidden/posture/buffs), row 2 = debuffs, each
# row filled left to right independently -- NOT a plain sequential wrap,
# since that would split a category across rows arbitrarily based on total
# count rather than what it actually is.
#
# col2: same grouping, transposed -- column 1 = non-debuffs, column 2 =
# debuffs, each filled top to bottom independently.
def EffectsBar.assign_grid_positions(entries)
  case EffectsBar.layout
  when "row2", "col2"
    positions = Array.new(entries.size)
    fixed_index = 0 # position within its own row/column (row2/col2 respectively)

    [false, true].each do |is_debuff|
      fixed_index = 0
      entries.each_with_index do |(_icon, _name, _duration, _prefix, category), idx|
        next unless (category == :debuff) == is_debuff

        group = is_debuff ? 1 : 0
        row, col = EffectsBar.layout == "row2" ? [group, fixed_index] : [fixed_index, group]
        positions[idx] = [col * EffectsBar::ICON_COL_WIDTH, row * EffectsBar::ICON_ROW_HEIGHT]
        fixed_index += 1
      end
    end

    positions
  else # "horizontal"
    entries.each_index.map { |idx| [idx * EffectsBar::ICON_COL_WIDTH, 0] }
  end
end

# "#<tier>" -- plain text, not part of the clickable icon link (a link's
# whole value renders as clickable link-blue text, so baking the tier number
# into the icon string itself made it render as a blue "#3" instead of plain
# text next to the emoji).
def EffectsBar.wall_of_thorns_prefix(tier)
  "##{[tier, 1].max}"
end

# One entry: [icon (XML entity string), display name, duration string ('' for
# postures/Hidden), prefix (plain-text string rendered just before the icon
# on the same line, nil for everything except Wall of Thorns Poison),
# category (:debuff or :buff -- used to group row2/col2, see
# assign_grid_positions; :buff covers Hidden/posture/Effects::Buffs, since
# none of them are timed Effects::Debuffs entries)]
def EffectsBar.active_debuffs
  entries = []
  now = Time.now.to_f

  Effects::Debuffs.to_h.each do |name, expires_at|
    next unless name.is_a?(String)

    remaining = expires_at.to_f - now
    next if remaining <= 0 && expires_at.to_f != 0 # 0 means "no expiration", still active

    icon = EffectsBar::DEBUFF_ICON_MAP[name]
    prefix = nil
    if icon.nil? && (m = EffectsBar::WALL_OF_THORNS_POISON.match(name))
      icon = EffectsBar::WALL_OF_THORNS_POISON_ICON
      prefix = EffectsBar.wall_of_thorns_prefix(m[1].to_i)
    end
    next unless icon

    duration = expires_at.to_f == 0 ? "" : EffectsBar.format_duration(remaining)
    entries << [icon, name, duration, prefix, :debuff]
  end

  entries
rescue StandardError
  []
end

# Effects::Buffs, not Effects::Debuffs -- e.g. Celerity. Timed like debuffs,
# but grouped with the non-debuffs (Hidden/posture) for row2/col2.
def EffectsBar.active_buffs
  entries = []
  now = Time.now.to_f

  Effects::Buffs.to_h.each do |name, expires_at|
    next unless name.is_a?(String)

    icon = EffectsBar::BUFF_ICON_MAP[name]
    next unless icon

    remaining = expires_at.to_f - now
    next if remaining <= 0 && expires_at.to_f != 0

    duration = expires_at.to_f == 0 ? "" : EffectsBar.format_duration(remaining)
    entries << [icon, name, duration, nil, :buff]
  end

  entries
rescue StandardError
  []
end

def EffectsBar.active_postures
  entries = []
  indicators = XMLData.indicator || {}

  EffectsBar::POSTURE_INDICATOR_ORDER.each do |name, icon_id|
    next unless indicators[icon_id] == 'y'

    entries << [EffectsBar::POSTURE_ICON_MAP[name], name, '', nil, :buff]
  end

  entries
rescue StandardError
  []
end

# No duration, same as posture -- persists until the indicator clears.
def EffectsBar.active_hidden
  indicators = XMLData.indicator || {}
  return [] unless indicators['IconHIDDEN'] == 'y'

  [[EffectsBar::HIDDEN_ICON, 'Hidden', '', nil, :buff]]
rescue StandardError
  []
end

# Skips any name already present via active_debuffs (a timed Effects::Debuffs
# entry for the same condition) so it doesn't render twice.
def EffectsBar.active_indicator_debuffs(existing_names = [])
  entries = []
  indicators = XMLData.indicator || {}

  EffectsBar::INDICATOR_DEBUFF_ORDER.each do |name, icon_id|
    next unless indicators[icon_id] == 'y'
    next if existing_names.include?(name)

    entries << [EffectsBar::DEBUFF_ICON_MAP[name], name, '', nil, :debuff]
  end

  entries
rescue StandardError
  []
end

TEST_DURATION_SECONDS = 30

def EffectsBar.start_test_mode!
  @test_started_at = Time.now
  EffectsBar.test_mode = true
end

# Every known icon at once, all counting down from the same 30-second start
# (set by start_test_mode!) so they tick down and clear together, the same
# way a real expiring debuff would drop off the bar -- not the real
# active-effects feed. Used by *ebar test to visually confirm every emoji
# actually renders (Saga's font coverage is inconsistent; see the codex
# book-icon swap in treasurewindow.lic for a real example of one that didn't).
def EffectsBar.test_entries
  return [] unless @test_started_at

  remaining = EffectsBar::TEST_DURATION_SECONDS - (Time.now - @test_started_at)
  return [] if remaining <= 0

  duration = EffectsBar.format_duration(remaining)
  entries = []

  EffectsBar::DEBUFF_ICON_MAP.each do |name, icon|
    entries << [icon, name, duration, nil, :debuff]
  end

  (1..5).each do |tier|
    entries << [EffectsBar::WALL_OF_THORNS_POISON_ICON, "Wall of Thorns Poison #{tier}", duration, EffectsBar.wall_of_thorns_prefix(tier), :debuff]
  end

  EffectsBar::POSTURE_ICON_MAP.each do |name, icon|
    entries << [icon, name, duration, nil, :buff]
  end

  entries << [EffectsBar::HIDDEN_ICON, 'Hidden', duration, nil, :buff]

  EffectsBar::BUFF_ICON_MAP.each do |name, icon|
    entries << [icon, name, duration, nil, :buff]
  end

  # Alphabetical for the test view only -- live tracking (active_hidden/
  # active_postures/active_buffs/active_debuffs) stays in the order the
  # effects were actually applied/take priority, not sorted. Sorting doesn't
  # break row2/col2 grouping either way -- assign_grid_positions groups by
  # category, not by array order.
  entries.sort_by { |_icon, name, _duration, _prefix, _category| name }
end

# Hidden always sorts first when active; posture (dead/kneeling/prone/
# sitting) comes right after it, or first if Hidden isn't active; buffs
# (e.g. Celerity) after that -- none of those three are timed
# Effects::Debuffs entries, so they're prepended ahead of those. Indicator-
# flag debuffs (Bleeding/Poisoned/Diseased) come next, skipping any name
# active_debuffs already has a timed entry for, then the rest of the timed
# debuffs in the order they were applied.
def EffectsBar.entries
  return EffectsBar.test_entries if EffectsBar.test_mode

  debuffs = EffectsBar.active_debuffs
  existing_names = debuffs.map { |_icon, name, *_rest| name }

  EffectsBar.active_hidden + EffectsBar.active_postures + EffectsBar.active_buffs +
    EffectsBar.active_indicator_debuffs(existing_names) + debuffs
end

def EffectsBar.snapshot
  EffectsBar.entries.map { |icon, name, duration, _prefix, category| "#{icon}|#{name}|#{duration}|#{category}" }
rescue StandardError
  []
end

def EffectsBar.build_dialog
  entries = EffectsBar.entries
  out = String.new("<dialogData id='EffectsBar' clear='t'>")

  if entries.empty?
    out << "<label id='eb_none' value='No active effects' justify='left' left='0' top='0' />"
    out << "</dialogData>"
    return out
  end

  # cmd is a no-op (matches treasurewindow.lic's divider-link convention);
  # echo alone displays the effect's name on click -- clicking is the
  # closest available substitute for a hover tooltip, since <label>/<link>
  # have no hover attribute in Saga's dialog renderer at all.
  #
  # A <link>'s whole value renders as clickable link-blue text, so an entry
  # with a prefix (Wall of Thorns Poison's "#<tier>") gets its own plain
  # <label> placed immediately before the icon link, both at the same top so
  # they read as one "#3<icon>" unit on the same line -- rather than baking
  # the prefix into the link's value, which rendered the whole "#3" as a
  # link instead of plain text next to the emoji.
  prefix_width = ->(prefix) { prefix ? (prefix.length * 7) : 0 }

  if EffectsBar.layout != "vertical"
    positions = EffectsBar.assign_grid_positions(entries)
    entries.each_with_index do |(icon, name, duration, prefix), idx|
      left, top = positions[idx]
      icon_left = left + prefix_width.call(prefix)
      if prefix
        out << "<label id='eb_prefix_#{idx}' value='#{EffectsBar.sanitize_xml(prefix)}' justify='left' left='#{left}' top='#{top}' height='#{EffectsBar::ROW_HEIGHT}' />"
      end
      out << "<link id='eb_icon_#{idx}' value='#{icon}' cmd=';e nil' echo='#{EffectsBar.sanitize_xml(name)}' justify='left' left='#{icon_left}' top='#{top}' width='#{EffectsBar::ICON_COL_WIDTH - prefix_width.call(prefix)}' height='#{EffectsBar::ROW_HEIGHT}' />"
      out << "<label id='eb_dur_#{idx}' value='#{EffectsBar.sanitize_xml(duration)}' justify='left' left='#{left + EffectsBar::DURATION_LEFT_NUDGE}' top='#{top + EffectsBar::ROW_HEIGHT}' width='#{EffectsBar::ICON_COL_WIDTH}' height='#{EffectsBar::ROW_HEIGHT}' font='small' />"
    end
  else
    entries.each_with_index do |(icon, name, duration, prefix), idx|
      top = idx * EffectsBar::ROW_HEIGHT
      icon_left = prefix_width.call(prefix)
      label_left = EffectsBar::VERTICAL_LABEL_LEFT + prefix_width.call(prefix)
      if prefix
        out << "<label id='eb_prefix_#{idx}' value='#{EffectsBar.sanitize_xml(prefix)}' justify='left' left='0' top='#{top}' height='#{EffectsBar::ROW_HEIGHT}' />"
      end
      out << "<link id='eb_icon_#{idx}' value='#{icon}' cmd=';e nil' echo='#{EffectsBar.sanitize_xml(name)}' justify='left' left='#{icon_left}' top='#{top}' width='#{EffectsBar::VERTICAL_LABEL_LEFT}' height='#{EffectsBar::ROW_HEIGHT}' />"
      label_value = duration.empty? ? name : "#{name} (#{duration})"
      out << "<label id='eb_name_#{idx}' value='#{EffectsBar.sanitize_xml(label_value)}' justify='left' left='#{label_left}' top='#{top}' font='small' />"
    end
  end

  out << "</dialogData>"
  out
end

eb_upstream_hook_id = "#{Script.current.name}_upstream"
UpstreamHook.remove(eb_upstream_hook_id) rescue nil
UpstreamHook.add(eb_upstream_hook_id, proc do |command|
  if command.strip =~ /\*ebar\s+dir\b/i
    EffectsBar.set_layout!(EffectsBar.layout == "horizontal" ? "vertical" : "horizontal")
    _respond(EffectsBar.build_dialog)
    respond "Effectsbar layout: #{EffectsBar.layout}"
    nil
  elsif command.strip =~ /\*ebar\s+col2\b/i
    EffectsBar.set_layout!("col2")
    _respond(EffectsBar.build_dialog)
    respond "Effectsbar layout: col2 (2 columns)"
    nil
  elsif command.strip =~ /\*ebar\s+row2\b/i
    EffectsBar.set_layout!("row2")
    _respond(EffectsBar.build_dialog)
    respond "Effectsbar layout: row2 (2 rows)"
    nil
  elsif command.strip =~ /\*ebar\s+test\b/i
    if EffectsBar.test_mode
      EffectsBar.test_mode = false
      respond "Effectsbar test mode: OFF (live data)"
    else
      EffectsBar.start_test_mode!
      respond "Effectsbar test mode: ON (every known icon, #{EffectsBar::TEST_DURATION_SECONDS}s countdown, alphabetical)"
    end
    _respond(EffectsBar.build_dialog)
    nil
  else
    command
  end
end)

_respond("<closeDialog id='EffectsBar'/><openDialog type='dynamic' id='EffectsBar' title='Effects' target='EffectsBar' scroll='manual' location='main' resident='true'><dialogData id='EffectsBar'></dialogData></openDialog>")
_respond(EffectsBar.build_dialog)

before_dying do
  UpstreamHook.remove(eb_upstream_hook_id) rescue nil
  _respond("<closeDialog id='EffectsBar'/>")
end

echo "Effectsbar is active."

@eb_last_snapshot = EffectsBar.snapshot
@eb_last_refresh_at = Time.now

loop do
  snapshot = EffectsBar.snapshot
  if snapshot != @eb_last_snapshot || (Time.now - @eb_last_refresh_at) > 5.0
    @eb_last_snapshot = snapshot
    @eb_last_refresh_at = Time.now
    _respond(EffectsBar.build_dialog)
  end
  sleep 0.5
end
