      ]
    },
    {
      key: :creaturewindow,
      filename: "creaturewindow.lic",
      script_name: "creaturewindow",
      display: "Creature Window",
      summary: "Real-time creature/bounty display, kill metrics, Gem Onslaught + Empyrean tracking.",
      settings_key: "creaturewindow",
      controls: [
