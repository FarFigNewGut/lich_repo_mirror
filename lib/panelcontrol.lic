        { type: :entry_command, label: "Un-hide entry", command_template: "*tm unignore %s", placeholder: "entry name" },
        { type: :toggle, label: "Track ALL resolvable spells", command: "*tm track all" },
        { type: :toggle, label: "Untrack ALL spells", command: "*tm untrack all" },
        { type: :toggle, label: "Un-hide ALL entries", command: "*tm unignore all" },
        { type: :choice, label: "Show lists in main window", options: [
          ["Tracked spells", "*tm tracked"], ["Recast macros", "*tm macros"],
          ["Gemstones", "*tm gemstones"], ["Hidden entries", "*tm ignored"]
        ] },
        { type: :toggle, label: "Save settings now", command: "*tm save" },
        { type: :toggle, label: "Show totals + Casting Strength in Story", command: "*tm totalscheck" }
      ]
    },
    {
      key: :messaging,
      filename: "messaging.lic",
      script_name: "messaging",
      display: "Messaging",
      summary: "Transforms death/login/logout/channel/announcement messaging into compact Saga markers and icons.",
      settings_key: nil,
      controls: [
        { type: :toggle, label: "Run a death-message test", command: ";messaging test" },
        { type: :toggle, label: "Run all channel-icon tests", command: ";messaging esptest" },
