    {
      key: :exp,
      filename: "exp_sagapanel.lic",
      script_name: "exp_sagapanel",
      display: "Experience",
      summary: "Experience/Lumnis panel with weekly/monthly/yearly history and profession resources.",
      settings_key: "exp",
      controls: [
