      script_name: "playerwindow",
      display: "Player Window",
      summary: "Real-time player display with spam/animal filtering and profession icons.",
      settings_key: "playerwindow",
      controls: [
        { type: :toggle, label: "Single/double column layout", command: "*pwcol" },
        { type: :toggle, label: "Filter buttons visibility", command: "*pwbuttons", field: "show_filter_buttons" },
        { type: :toggle, label: "Player movement filtering", command: "*pwmove", field: "show_movement" },
        { type: :toggle, label: "Flare-message filtering", command: "*pwflare", field: "filter_flares" },
        { type: :toggle, label: "AS/CS/SMR/SSR line filtering", command: "*pwcombat", field: "filter_combat_math" },
