        { type: :cycle, label: "Cycle count headers (text/emoji/off)", command: "*cwheaders", field: "header_mode" },
        { type: :cycle, label: "Cycle Saga status style", command: "*cwstatus", field: "saga_status_mode" },
        { type: :cycle, label: "Cycle target-next mode", command: "*cwtargetnext", field: "target_next_mode" },
        { type: :cycle, label: "Cycle target HP display", command: "*cwhp", field: "target_hp_mode" },
        { type: :cycle, label: "Cycle target marker icon", command: "*cwtargetid", field: "target_marker_index" },
        { type: :cycle, label: "Cycle grid flow (row/col)", command: "*cwflow", field: "grid_flow" },
