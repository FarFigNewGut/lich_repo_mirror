        { type: :toggle, label: "Bounty task display", command: "*cwbty", field: "display_bounty" },
        { type: :toggle, label: "Claim status", command: "*cwclaim", field: "display_claim" },
        { type: :toggle, label: "Custom layout 1 (*cwcustom1)", command: "*cwcustom1", field: "custom_layout1" },
        { type: :toggle, label: "Dead creatures inline", command: "*cwdead", field: "dead_inline" },
