      settings_key: "treasurewindow",
      controls: [
        { type: :toggle, label: "LOOT ROOM/ELOOT clickable links", command: "*click" },
        { type: :toggle, label: "Single/double column layout", command: "*twcol" },
        { type: :toggle, label: "Killtracker gem output", command: "*twgem", field: "show_killtracker" },
        { type: :choice, label: "Column layout", field: "columns", values: [1, 2, 3, 4], options: [
          ["1 column", "*twcol1"], ["2 columns", "*twcol2"], ["3 columns", "*twcol3"], ["4 columns", "*twcol4"]
        ] }
      ]
    }
  ].freeze

  # A broad, general-purpose picker grid -- not narrowly Empyrean-themed,
  # since *cwicon accepts any emoji for either slot. Arranged in the fixed
  # 8-per-row grid EMOJI_COLUMNS below. Double-quoted \u{} escapes, not raw
  # literal characters -- keeps this source file itself ASCII-only (same
  # convention as every icon table in creaturewindow.lic/effectsbar_
  # sagapanel.lic); each escape still becomes a real UTF-8 character at
  # runtime, which is what actually needs to reach the GTK button label.
  # %w[] would NOT work here -- it does not process \u{} escapes at all.
  EMOJI_PALETTE = [
    "\u{1F47D}", "\u{1F6F8}", "\u{1F47E}", "\u{1F680}", "\u{1F30C}", "\u{2B50}", "\u{1F4AB}", "\u{1F52E}",
    "\u{1F480}", "\u{2620}\u{FE0F}", "\u{1F3AF}", "\u{26A1}", "\u{1F525}", "\u{2744}\u{FE0F}", "\u{1F31F}", "\u{1F47B}",
    "\u{1F409}", "\u{1F98B}", "\u{1F98A}", "\u{1F43A}", "\u{1F985}", "\u{1F989}", "\u{1F984}", "\u{1F40D}",
    "\u{2764}\u{FE0F}", "\u{1F49C}", "\u{1F499}", "\u{1F49A}", "\u{1F9E1}", "\u{1F5A4}", "\u{26AA}", "\u{26AB}",
    "\u{1F451}", "\u{1F48E}", "\u{2694}\u{FE0F}", "\u{1F6E1}\u{FE0F}", "\u{1F3F9}", "\u{1F52A}", "\u{1FA84}", "\u{1F3B2}"
  ].freeze
  EMOJI_COLUMNS = 8

  # ---------------------------------------------------------------------
  # Command dispatch -- do_client (lib/global_defs.rb) runs a string
  # through the exact same UpstreamHook pipeline as if the player had
  # typed it at the game prompt. This is the established, working pattern
  # for a GTK script injecting a command on a button click -- confirmed
  # against grids.lic, an existing Lich script that does the same thing
  # from its own Gtk::Entry "activate" handler. It is NOT the same as
  # put/fput, which send straight to the game server and would bypass
  # every *cwXXX/*ebar/*tm/*exp UpstreamHook entirely.
  # ---------------------------------------------------------------------
  def send_command!(text)
    do_client(text)
  rescue StandardError => e
    respond "PanelControl: error sending '#{text}': #{e.message}"
  end

  def script_installed?(entry)
    File.exist?(File.join($script_dir, entry[:filename]))
  end

  def script_running?(entry)
    running?(entry[:script_name])
  rescue StandardError
    false
  end

  # entry's own top-level block from the shared lichwindows.yaml (e.g.
  # all["creaturewindow"]), or {} if it has no settings_key (messaging.lic)
  # or nothing's been saved yet. Reads fresh every call, same "never cache
  # across calls" rule every managed script's own load_window_settings
  # already follows -- this panel is reading the SAME file those scripts
  # write to, potentially seconds after they last saved it.
  def script_settings(entry)
    return {} unless entry[:settings_key]

    all = load_all_settings
    block = all[entry[:settings_key]]
    block.is_a?(Hash) ? block : {}
  end

  # Reads one setting out of entry's block. `path` is either a single key
  # ("display_bounty") or an array for a nested path
  # (["custom_icons", "empyrean"]). Returns `default` if entry has no
  # settings_key, the key was never saved, or any intermediate step isn't
  # actually a Hash (e.g. a corrupt/foreign value on disk).
  def read_setting(entry, path, default = nil)
    value = Array(path).reduce(script_settings(entry)) do |hash, key|
      hash.is_a?(Hash) ? hash[key.to_s] : nil
    end
    value.nil? ? default : value
  end

  # Reads just the header comment block rather than the whole file (some
  # of these headers run past 6KB with a long Commands:/changelog list, so
  # this reads the same 20,000 bytes repository.lic's own CommentParser
  # reads for the same purpose) and pulls the version line. Not every
  # managed script uses the same "Version:" capitalization/placement
  # (verbwindow.lic's is a bare lowercase "version: N.N" line deep in its
  # changelog, not a "Version:" header field), so this matches either.
  def installed_version(entry)
    return nil unless script_installed?(entry)

    header = File.open(File.join($script_dir, entry[:filename]), 'rb') { |f| f.read(20_000) }
    m = header.to_s.match(/^\s*version:\s*([\w.]+)/i)
    m ? m[1] : "unknown"
  rescue StandardError
    nil
  end

  # Shells out to the already-installed repository.lic rather than
  # reimplementing its SSL/gzip download protocol here -- mirrors
  # repository.lic's own GTK "Download selected script" button, which
  # calls Script.run('repository', ...) directly from a GTK click handler
  # the same way. Blocks the GTK thread for the duration of the download
  # (same tradeoff repository.lic's own GUI already accepts).
  def download_script!(entry)
    unless File.exist?(File.join($script_dir, "repository.lic"))
      respond "PanelControl: repository.lic is not installed -- cannot download #{entry[:filename]}."
      return
    end

    Script.run('repository', "download #{entry[:filename]}", force: true)
  rescue StandardError => e
    respond "PanelControl: error downloading #{entry[:filename]}: #{e.message}"
  end

  def start_script!(entry)
    return unless script_installed?(entry)
    return if script_running?(entry)

    start_script(entry[:script_name])
  rescue StandardError => e
    respond "PanelControl: error starting #{entry[:script_name]}: #{e.message}"
  end

  def stop_script!(entry)
    target = (Script.running + Script.hidden).find { |s| s.name == entry[:script_name] }
    target&.kill
  rescue StandardError => e
    respond "PanelControl: error stopping #{entry[:script_name]}: #{e.message}"
  end

  # -------------------------------------------------------------------
  # This window's OWN dark/light + font-size preference -- stored under a
  # "panelcontrol" key in the same shared lichwindows.yaml every managed
  # script already reads/writes (never touching any of THEIR keys), using
  # the same strict-permitted-classes/rescue-and-rebuild pattern
  # established across this codebase (see creaturewindow.lic's
  # load_window_settings for the original).
  # -------------------------------------------------------------------
  PALETTES = {
    "Dark"  => { bg: "#2E2E2E", fg: "#DADADA", btn: "#3E3E3E", border: "#555555" },
    "Light" => { bg: "#E6E6E6", fg: "#202020", btn: "#D6D6D6", border: "#AAAAAA" }
  }.freeze
  PERMITTED_CLASSES = [Hash, Array, String, Integer, Float, TrueClass, FalseClass, NilClass].freeze

  def settings_path
    base_dir = "#{$data_dir}#{XMLData.game}/#{Char.name}"
    Dir.mkdir("#{$data_dir}#{XMLData.game}") unless File.exist?("#{$data_dir}#{XMLData.game}")
    Dir.mkdir(base_dir) unless File.exist?(base_dir)
    File.join(base_dir, "lichwindows.yaml")
  end

  def load_all_settings
    filename = settings_path
    return {} unless File.exist?(filename)

    parsed = YAML.safe_load(File.read(filename), permitted_classes: PERMITTED_CLASSES, aliases: false)
    parsed.is_a?(Hash) ? parsed : {}
  rescue StandardError
    {}
  end

  def load_settings
    pc = load_all_settings["panelcontrol"]
    pc = {} unless pc.is_a?(Hash)
    {
      "palette" => PALETTES.key?(pc["palette"]) ? pc["palette"] : "Dark",
      "font_size" => pc["font_size"].is_a?(Integer) ? pc["font_size"].clamp(8, 30) : 14
    }
  end

  def save_settings(palette:, font_size:)
    all = load_all_settings
    all["panelcontrol"] = { "palette" => palette, "font_size" => font_size }
    File.write(settings_path, all.to_yaml)
  rescue StandardError => e
    respond "PanelControl: error saving settings: #{e.message}"
  end
end

# ===========================================================================
# GTK window
# ===========================================================================
class PanelControlGtk
  @css_provider = nil
  @palette      = nil
  @font_size    = nil

  # Regenerates and applies this window's own CSS (dark/light palette +
  # font size) -- same technique as creaturewindow.lic's CreatureWindowGtk
  # .reload_css, scoped to window#panelcontrol so it can never affect any
  # OTHER script's GTK window sharing this same process-wide style
  # provider.
  def self.reload_css
    colors = PanelControl::PALETTES[@palette] || PanelControl::PALETTES["Dark"]

    # Broad, deliberately non-exhaustive-looking selector list -- every
    # widget type actually used anywhere in this window (see
    # build_scripts_tab/build_control_tab/build_control!/
    # show_emoji_picker) gets an explicit rule, since GTK's CSS engine
    # does NOT reliably cascade background-color the way real browser CSS
    # does (confirmed live: leaving buttons/scrolledwindow/combobox/
    # spinbutton unstyled kept them on the system's default light theme
    # even with the top-level window rule in place).
    css = <<~CSS
      window#panelcontrol {
        background-color: #{colors[:bg]};
        color:            #{colors[:fg]};
        font-size:        #{@font_size}px;
      }
      window#panelcontrol headerbar,
      window#panelcontrol headerbar:backdrop,
      window#panelcontrol .titlebar,
      window#panelcontrol .titlebar:backdrop {
        background-image: none;
        background-color: #{colors[:bg]};
        color:            #{colors[:fg]};
        box-shadow:        none;
        border:            none;
      }
      window#panelcontrol headerbar .title {
        color: #{colors[:fg]};
      }
      window#panelcontrol headerbar .header-toggle {
        margin:            0 2px;
        padding:           2px 6px;
        background-image:  none;
        background-color:  transparent;
        color:             #{colors[:fg]};
        border:            none;
        box-shadow:        none;
      }
      window#panelcontrol notebook,
      window#panelcontrol notebook header,
      window#panelcontrol notebook tab,
      window#panelcontrol notebook stack {
        background-color: #{colors[:bg]};
        color:            #{colors[:fg]};
      }
      window#panelcontrol label {
        color: #{colors[:fg]};
      }
      window#panelcontrol frame {
        background-color: #{colors[:bg]};
        color:            #{colors[:fg]};
      }
      window#panelcontrol frame > label {
        color: #{colors[:fg]};
      }
      window#panelcontrol scrolledwindow,
      window#panelcontrol viewport,
      window#panelcontrol box {
        background-color: #{colors[:bg]};
        color:            #{colors[:fg]};
      }
      window#panelcontrol entry,
      window#panelcontrol combobox,
      window#panelcontrol combobox window,
      window#panelcontrol combobox menu,
      window#panelcontrol spinbutton,
      window#panelcontrol popover {
        background-color: #{colors[:btn]};
        color:            #{colors[:fg]};
        border-color:     #{colors[:border]};
      }
      window#panelcontrol button {
        background-image: none;
        background-color: #{colors[:btn]};
        color:            #{colors[:fg]};
        border-color:     #{colors[:border]};
      }
      window#panelcontrol button:hover {
        background-color: shade(#{colors[:btn]}, 1.15);
      }
      window#panelcontrol button:active {
        background-color: shade(#{colors[:btn]}, 0.85);
      }
      window#panelcontrol button:disabled {
        background-color: #{colors[:btn]};
        color:            shade(#{colors[:fg]}, 0.7);
      }
    CSS

    @css_provider.load(data: css)
  end

  def self.create_main_window
    settings   = PanelControl.load_settings
    @palette   = settings["palette"]
    @font_size = settings["font_size"]

    @window = Gtk::Window.new(:toplevel)
    @window.set_name("panelcontrol")
    # Sized to comfortably show a full control tab (e.g. Timers, the
    # tallest one) without scrolling, per the user's own screenshot of
    # their preferred window size.
    @window.set_default_size(950, 1200)

    header = Gtk::HeaderBar.new
    header.show_close_button = true
    header.title = "Lich Saga Panel Controls"

    dec_btn   = Gtk::Button.new(label: "A-")
    inc_btn   = Gtk::Button.new(label: "A+")
    dark_btn  = Gtk::Button.new(label: "Dark")
    light_btn = Gtk::Button.new(label: "Light")
    [dec_btn, inc_btn, dark_btn, light_btn].each do |b|
      b.style_context.add_class("header-toggle")
      header.pack_start(b)
    end
    dec_btn.signal_connect("clicked") do
      @font_size = [@font_size - 1, 8].max
      PanelControl.save_settings(palette: @palette, font_size: @font_size)
      reload_css
    end
    inc_btn.signal_connect("clicked") do
      @font_size = [@font_size + 1, 30].min
      PanelControl.save_settings(palette: @palette, font_size: @font_size)
      reload_css
    end
    dark_btn.signal_connect("clicked") do
      @palette = "Dark"
      PanelControl.save_settings(palette: @palette, font_size: @font_size)
      reload_css
    end
    light_btn.signal_connect("clicked") do
      @palette = "Light"
      PanelControl.save_settings(palette: @palette, font_size: @font_size)
      reload_css
    end
    @window.set_titlebar(header)

    @css_provider = Gtk::CssProvider.new
    reload_css
    Gtk::StyleContext.add_provider_for_screen(
      Gdk::Screen.default,
      @css_provider,
      Gtk::StyleProvider::PRIORITY_APPLICATION
    )

    @notebook = Gtk::Notebook.new
    @window.add(@notebook)

    @scripts_tab_box = build_scripts_tab
    @notebook.append_page(@scripts_tab_box, Gtk::Label.new("Scripts"))

    # Parallel to MANAGED_SCRIPTS (index i here <-> MANAGED_SCRIPTS[i]) --
    # lets switch-page below find the right entry/notice pair without a
    # separate lookup structure.
    @tab_notices = []
    PanelControl::MANAGED_SCRIPTS.each do |entry|
      tab, notice, populate_controls = build_control_tab(entry)
      @tab_notices << [entry, notice, populate_controls]
      @notebook.append_page(tab, Gtk::Label.new(entry[:display]))
    end

    # Each per-script tab's "not currently running" notice, and every
    # control's displayed current value, are only ever computed once, when
    # the tab widget is first built -- both go stale the moment you
    # start/stop that script or change one of its settings from somewhere
    # else without ever rebuilding this tab. Recomputing on every tab
    # switch means both are fresh by the time you're actually looking at
    # them, without needing to remember to press each tab's own Refresh
    # button first.
    @notebook.signal_connect("switch-page") do |_nb, _page, page_num|
      idx = page_num - 1
      if idx >= 0 && idx < @tab_notices.size
        entry, notice, populate_controls = @tab_notices[idx]
        notice.visible = !PanelControl.script_running?(entry)
        populate_controls.call
      end
    end

    @window.signal_connect("destroy") do
      # No Gtk.main_quit here -- the GTK main loop is one shared, process-
      # wide loop (see GtkMainLoopGuards in lib/common/gtk.rb, which
      # already no-ops a regular script's main_quit call for exactly this
      # reason), so closing this window must only drop our own reference,
      # never stop the loop other scripts' GTK windows depend on too.
      @window = nil
    end

    @window.show_all
  end

  # -------------------------------------------------------------------
  # Scripts tab -- install/run status + Download/Start/Stop, per entry.
  # Rebuilt from scratch on Refresh rather than trying to update widgets
  # in place; only 6 rows, so this stays cheap.
  # -------------------------------------------------------------------
  def self.build_scripts_tab
    outer = Gtk::Box.new(:vertical, 6)
    outer.border_width = 10

    refresh_button = Gtk::Button.new(label: "Refresh Status")
    outer.pack_start(refresh_button, expand: false, fill: false, padding: 0)

    @scripts_list_box = Gtk::Box.new(:vertical, 4)
    scroll = Gtk::ScrolledWindow.new
    scroll.set_policy(Gtk::PolicyType::NEVER, Gtk::PolicyType::AUTOMATIC)
    scroll.add(@scripts_list_box)
    outer.pack_start(scroll, expand: true, fill: true, padding: 0)

    refresh_button.signal_connect("clicked") { populate_scripts_list! }
    populate_scripts_list!

    outer
  end

  def self.populate_scripts_list!
    @scripts_list_box.children.each { |c| @scripts_list_box.remove(c) }

    PanelControl::MANAGED_SCRIPTS.each do |entry|
      frame = Gtk::Frame.new(entry[:display])
      row = Gtk::Box.new(:horizontal, 8)
      row.border_width = 6
      frame.add(row)

      installed = PanelControl.script_installed?(entry)
      running = installed && PanelControl.script_running?(entry)
      version = PanelControl.installed_version(entry)

      status_text =
        if !installed
          "Missing"
        elsif running
          "Installed (v#{version}) -- Running"
        else
          "Installed (v#{version}) -- Not running"
        end

      info = Gtk::Label.new("#{entry[:filename]}\n#{status_text}")
      info.set_xalign(0)
      info.set_line_wrap(true)
      row.pack_start(info, expand: true, fill: true, padding: 0)

      if !installed
        download_btn = Gtk::Button.new(label: "Download")
        download_btn.signal_connect("clicked") do
          PanelControl.download_script!(entry)
          populate_scripts_list!
        end
        row.pack_start(download_btn, expand: false, fill: false, padding: 0)
      elsif running
        stop_btn = Gtk::Button.new(label: "Stop")
        stop_btn.signal_connect("clicked") do
          PanelControl.stop_script!(entry)
          populate_scripts_list!
        end
        row.pack_start(stop_btn, expand: false, fill: false, padding: 0)
      else
        start_btn = Gtk::Button.new(label: "Start")
        start_btn.signal_connect("clicked") do
          PanelControl.start_script!(entry)
          populate_scripts_list!
        end
        row.pack_start(start_btn, expand: false, fill: false, padding: 0)
      end

      @scripts_list_box.pack_start(frame, expand: false, fill: false, padding: 0)
    end

    @scripts_list_box.show_all
  end

  # -------------------------------------------------------------------
  # Per-script control tab -- built from entry[:controls]. Every control
  # sends its command immediately (no separate "Apply" step for
  # toggles/cycles/choices); :number and :entry_command have their own
  # Apply/Send button since they need a value first.
  # -------------------------------------------------------------------
  def self.build_control_tab(entry)
    outer = Gtk::Box.new(:vertical, 6)
    outer.border_width = 10

    summary = Gtk::Label.new(entry[:summary])
    summary.set_xalign(0)
    summary.set_line_wrap(true)
    outer.pack_start(summary, expand: false, fill: false, padding: 0)

    not_running_notice = Gtk::Label.new("(#{entry[:script_name]} is not currently running -- these will do nothing until it is; use the Scripts tab to start it.)")
    not_running_notice.set_xalign(0)
    not_running_notice.visible = !PanelControl.script_running?(entry)
    outer.pack_start(not_running_notice, expand: false, fill: false, padding: 0)

    refresh_btn = Gtk::Button.new(label: "Refresh Settings")
    outer.pack_start(refresh_btn, expand: false, fill: false, padding: 0)

    scroll = Gtk::ScrolledWindow.new
    scroll.set_policy(Gtk::PolicyType::NEVER, Gtk::PolicyType::AUTOMATIC)
    grid = Gtk::Box.new(:vertical, 4)
    grid.border_width = 4
    scroll.add(grid)
    outer.pack_start(scroll, expand: true, fill: true, padding: 0)

    # Rebuilds every control widget from scratch, re-reading
    # lichwindows.yaml each time -- called once now to populate the tab,
    # again from the Refresh button, and again from create_main_window's
    # notebook "switch-page" handler every time this tab is viewed, so
    # what's displayed never gets far out of sync with what's actually
    # saved.
    populate_controls = lambda do
      grid.children.each { |c| grid.remove(c) }
      entry[:controls].each { |control| build_control!(grid, entry, control) }
      grid.show_all
    end
    populate_controls.call
    refresh_btn.signal_connect("clicked") { populate_controls.call }

    custom_box = Gtk::Box.new(:horizontal, 4)
    custom_entry = Gtk::Entry.new
    custom_entry.placeholder_text = "Custom command, e.g. *tm gemstone Ring 10 STR"
    custom_send = Gtk::Button.new(label: "Send")
    send_custom = lambda do
      text = custom_entry.text.to_s.strip
      next if text.empty?

      PanelControl.send_command!(text)
      custom_entry.text = ""
    end
    custom_send.signal_connect("clicked") { send_custom.call }
    custom_entry.signal_connect("activate") { send_custom.call }
    custom_box.pack_start(custom_entry, expand: true, fill: true, padding: 0)
    custom_box.pack_start(custom_send, expand: false, fill: false, padding: 0)
    outer.pack_start(Gtk::Label.new("Custom command (anything not listed above):").tap { |l| l.set_xalign(0) }, expand: false, fill: false, padding: 0)
    outer.pack_start(custom_box, expand: false, fill: false, padding: 0)

    [outer, not_running_notice, populate_controls]
  end

  # Comboboxes and spin buttons both change their value when the mouse
  # wheel scrolls over them while focused/hovered -- GTK's own default
  # behavior, not something either widget can be told not to do via a
  # property. Easy to trigger by accident while scrolling this tab's
  # ScrolledWindow past one of them. Intercepting "scroll-event" and
  # returning true (GDK_EVENT_STOP) stops that default handler from ever
  # running, without otherwise affecting the widget (dropdown-click,
  # keyboard, and the panel's own +/- buttons are untouched).
  def self.disable_scroll!(widget)
    widget.signal_connect("scroll-event") { true }
  end

  def self.build_control!(container, entry, control)
    row = Gtk::Box.new(:horizontal, 6)

    case control[:type]
    when :toggle
      if control[:field]
        # A real checkbox reflecting what's actually saved, not just a
        # fire-and-forget button -- current = the value read straight out
        # of lichwindows.yaml. `active =` is set BEFORE signal_connect
        # below so restoring that saved state never re-sends the command.
        current = !!PanelControl.read_setting(entry, control[:field], false)
        # Positional, not label: -- Gtk::CheckButton.new(label: ...) raises
        # ArgumentError on this gtk3 gem build ("wrong arguments"), unlike
        # Gtk::Button.new(label: ...) which works fine; confirmed live.
        check = Gtk::CheckButton.new(control[:label])
        check.active = current
        check.signal_connect("toggled") { PanelControl.send_command!(control[:command]) }
        row.pack_start(check, expand: true, fill: true, padding: 0)
      else
        # No known settings field for this one (a one-shot action, or an
        # unpersisted debug flag) -- stays a plain stateless button.
        btn = Gtk::Button.new(label: control[:label])
        btn.signal_connect("clicked") { PanelControl.send_command!(control[:command]) }
        row.pack_start(btn, expand: true, fill: true, padding: 0)
      end

    when :cycle
      # Cycle controls only ever advance to the next state on click, so
      # there's no natural widget to preset -- instead the button's own
      # label shows the CURRENT saved value, refreshed every time this tab
      # rebuilds (populate_controls, see build_control_tab).
      label_text = control[:label]
      if control[:field]
        current = PanelControl.read_setting(entry, control[:field])
        label_text = "#{control[:label]} (currently: #{current})" unless current.nil?
      end
      btn = Gtk::Button.new(label: label_text)
      btn.signal_connect("clicked") { PanelControl.send_command!(control[:command]) }
      row.pack_start(btn, expand: true, fill: true, padding: 0)

    when :choice
      label = Gtk::Label.new(control[:label])
      label.set_xalign(0)
      label.set_size_request(220, -1)
      combo = Gtk::ComboBoxText.new
      disable_scroll!(combo)
      control[:options].each { |display, _command| combo.append_text(display) }

      active_index = 0
      if control[:field] && control[:values]
        current = PanelControl.read_setting(entry, control[:field])
        found = control[:values].index(current)
        active_index = found if found
      end
      combo.active = active_index
      # signal_connect is deliberately AFTER active= above, so that
      # restoring the saved selection never fires this handler -- only
      # real user changes do.
      combo.signal_connect("changed") do
        _display, command = control[:options][combo.active]
        PanelControl.send_command!(command) if command
      end
      row.pack_start(label, expand: false, fill: false, padding: 0)
      row.pack_start(combo, expand: true, fill: true, padding: 0)

    when :number
      label = Gtk::Label.new(control[:label])
      label.set_xalign(0)
      label.set_size_request(220, -1)
      initial = control[:field] ? PanelControl.read_setting(entry, control[:field], control[:default]) : control[:default]
      initial = control[:default] unless initial.is_a?(Numeric)
      initial = initial.clamp(control[:min], control[:max])
      adjustment = Gtk::Adjustment.new(initial, control[:min], control[:max], 1, 1, 0)
      spin = Gtk::SpinButton.new(adjustment, 1, 0)
      disable_scroll!(spin)
      apply = Gtk::Button.new(label: "Apply")
      apply.signal_connect("clicked") { PanelControl.send_command!(format(control[:command_template], spin.value.to_i)) }
      row.pack_start(label, expand: false, fill: false, padding: 0)
      row.pack_start(spin, expand: false, fill: false, padding: 0)
      row.pack_start(apply, expand: false, fill: false, padding: 0)

    when :stepper
      # For settings with no "set to this exact value" command -- only a
      # relative increment/decrement (*ebar ci/cd/ri/rd/si/sd). No Apply/
      # target value like :number, just +/- buttons either side of a
      # readout of the current saved value. do_client (send_command!) runs
      # the command's UpstreamHook synchronously, including its settings
      # save, so by the time it returns the new value is already on disk
      # -- each click re-reads it and updates this row's own label
      # in-place immediately, rather than waiting for the whole tab to
      # rebuild (Refresh Settings / tab switch still also catch it).
      label = Gtk::Label.new(control[:label])
      label.set_xalign(0)
      label.set_size_request(220, -1)
      format_value = lambda do |value|
        value.is_a?(Float) ? format("%.1f", value) : value.to_s
      end
      current = control[:field] ? PanelControl.read_setting(entry, control[:field], control[:default]) : control[:default]
      value_label = Gtk::Label.new(format_value.call(current))
      value_label.set_size_request(50, -1)
      refresh_value = lambda do
        updated = control[:field] ? PanelControl.read_setting(entry, control[:field], control[:default]) : control[:default]
        value_label.text = format_value.call(updated)
      end
      dec_btn = Gtk::Button.new(label: "-")
      inc_btn = Gtk::Button.new(label: "+")
      dec_btn.signal_connect("clicked") { PanelControl.send_command!(control[:dec_command]); refresh_value.call }
      inc_btn.signal_connect("clicked") { PanelControl.send_command!(control[:inc_command]); refresh_value.call }
      row.pack_start(label, expand: false, fill: false, padding: 0)
      row.pack_start(dec_btn, expand: false, fill: false, padding: 0)
      row.pack_start(value_label, expand: false, fill: false, padding: 0)
      row.pack_start(inc_btn, expand: false, fill: false, padding: 0)

    when :entry_command
      label = Gtk::Label.new(control[:label])
      label.set_xalign(0)
      label.set_size_request(220, -1)
      field = Gtk::Entry.new
      field.placeholder_text = control[:placeholder] || ""
      send_btn = Gtk::Button.new(label: "Send")
      submit = lambda do
        value = field.text.to_s.strip
        next if value.empty?

        PanelControl.send_command!(format(control[:command_template], value))
      end
      send_btn.signal_connect("clicked") { submit.call }
      field.signal_connect("activate") { submit.call }
      row.pack_start(label, expand: false, fill: false, padding: 0)
      row.pack_start(field, expand: true, fill: true, padding: 0)
      row.pack_start(send_btn, expand: false, fill: false, padding: 0)

    when :emoji_picker
      current_icon = control[:field] ? PanelControl.read_setting(entry, control[:field]) : nil
      label_text = current_icon ? "#{control[:label]} (current: #{current_icon})" : "#{control[:label]} (default)"
      label = Gtk::Label.new(label_text)
      label.set_xalign(0)
      label.set_size_request(220, -1)
      label.set_line_wrap(true)
      choose_btn = Gtk::Button.new(label: "Choose icon...")
      choose_btn.signal_connect("clicked") { show_emoji_picker(choose_btn, entry, control[:slot]) }
      reset_btn = Gtk::Button.new(label: "Reset")
      reset_btn.signal_connect("clicked") { PanelControl.send_command!("*cwicon #{control[:slot]} reset") }
      row.pack_start(label, expand: true, fill: true, padding: 0)
      row.pack_start(choose_btn, expand: false, fill: false, padding: 0)
      row.pack_start(reset_btn, expand: false, fill: false, padding: 0)
    end

    container.pack_start(row, expand: false, fill: false, padding: 0)
  end

  # A Gtk::Popover anchored to the button that opened it, containing a
  # grid of emoji buttons (PanelControl::EMOJI_PALETTE) plus a manual entry
  # for anything not in the curated list. Clicking a palette button or
  # submitting the manual entry both send "*cwicon <slot> <emoji>" and
  # close the popover -- creaturewindow.lic (see *cwicon/set_custom_icon!)
  # converts whatever raw character(s) arrive into the XML-numeric-entity
  # form it actually renders with.
  def self.show_emoji_picker(anchor_widget, _entry, slot)
    popover = Gtk::Popover.new(anchor_widget)
    box = Gtk::Box.new(:vertical, 6)
    box.border_width = 8

    grid = Gtk::Grid.new
    grid.row_spacing = 2
    grid.column_spacing = 2
    PanelControl::EMOJI_PALETTE.each_with_index do |emoji, idx|
      row = idx / PanelControl::EMOJI_COLUMNS
      col = idx % PanelControl::EMOJI_COLUMNS
      btn = Gtk::Button.new(label: emoji)
      btn.signal_connect("clicked") do
        PanelControl.send_command!("*cwicon #{slot} #{emoji}")
        popover.popdown
      end
      grid.attach(btn, col, row, 1, 1)
    end
    box.pack_start(grid, expand: false, fill: false, padding: 0)

    manual_row = Gtk::Box.new(:horizontal, 4)
    manual_entry = Gtk::Entry.new
    manual_entry.placeholder_text = "or paste any emoji"
    manual_entry.set_size_request(140, -1)
    manual_send = Gtk::Button.new(label: "Use")
    submit_manual = lambda do
      text = manual_entry.text.to_s.strip
      next if text.empty?

      PanelControl.send_command!("*cwicon #{slot} #{text}")
      popover.popdown
    end
    manual_send.signal_connect("clicked") { submit_manual.call }
    manual_entry.signal_connect("activate") { submit_manual.call }
    manual_row.pack_start(manual_entry, expand: true, fill: true, padding: 0)
    manual_row.pack_start(manual_send, expand: false, fill: false, padding: 0)
    box.pack_start(manual_row, expand: false, fill: false, padding: 0)

    popover.add(box)
    popover.show_all
    popover.popup
  end
end

# Gtk.queue (lib/common/gtk.rb) marshals widget construction onto the
# thread that actually runs the GTK main loop, via a GLib::Timeout --
# calling GTK APIs from any other thread ("random segfaults", per that
# file's own comment) is exactly what crashed the client here: this used
# to call PanelControlGtk.create_main_window directly on this script's own
# thread, then start Gtk.main on that same thread afterward. Since GTK's
# main loop is one shared, process-wide loop across every script that uses
# it (Gtk.main itself is guarded to only actually start once), building a
# window outside Gtk.queue is a real crash risk the moment any other GTK
# script (creaturewindow.lic, etc.) is also running. Mirrors
# creaturewindow.lic's own bootstrap sequence exactly.
Gtk.queue { PanelControlGtk.create_main_window }
Thread.new { Gtk.main if Gtk.main_level == 0 }
