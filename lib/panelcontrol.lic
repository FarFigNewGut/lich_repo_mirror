        { type: :number, label: "Weapon enchant (pAS totals)", min: 0, max: 30, default: 0, field: "weapon_enchant", command_template: "*tm enchant %d" },
        { type: :number, label: "Casting Strength phantom bonus", min: 0, max: 10, default: 0, field: "trandest_rank", command_template: "*tm trandest %d" },
