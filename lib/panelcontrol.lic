        { type: :toggle, label: "Spam filtering", command: "*filterspam", field: "filter_spam" },
        { type: :toggle, label: "Animal filtering", command: "*filteranimals", field: "filter_animals" },
        { type: :toggle, label: "Filter-debug logging", command: "*pwdebug" },
        { type: :toggle, label: "Profession icons on/off", command: "*pwprofession", field: "show_profession_icons" },
