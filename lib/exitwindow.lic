=begin
  Works in Saga FE!
  Exit Window - Real-Time Room Exit Display

  This script creates a dedicated window to display room exit information in real time.

  Features:
  - Continuously updates with the current room exits.
  - Displays clickable exits for both standard and Lich exits.
  - Uses consistent window formatting.
  - Supports ;go2 navigation for Lich exits.
  - Displays trash containers.
  - Displays Lich ID and room UID.
  - Makes the Lich room ID and room UID clickable for clipboard copying.

  References:
    Wrayth FE Window: https://discordapp.com/channels/226045346399256576/1339018254517145681
    GTK Window:       https://discordapp.com/channels/226045346399256576/1386507836191670342

  Usage:
    ;exitwindow                  - Start exit window

  In-game Commands (while running):
    *ewgtk                       - Enable GTK window
    *ewcol                       - Toggle single/double column layout
    *ewcol3                      - Use a 3-column layout
    *ewcol4                      - Use a 4-column layout
    *ewcopy <lich|u> <number>    - Copy a room number to the clipboard
    *ewheader                    - Hide/show Exits and Lich Exits headers

  Author: Phocosoen, ChatGPT
  Tags: wrayth, saga, frontend, mod, window, paths, navigation, wizard, avalon
  Version: 1.3
  Recently changed:
  v1.3 (2026-08-26)
    - Made the Lich room ID and room UID clickable in both Wrayth and GTK
      windows so their numbers can be copied to the clipboard.
    - Added a native Windows clipboard path so clicks update the system
      clipboard even when optional clipboard gems are not installed.
  1.2.1 - Fixed the GTK window's font-size A-/A+ buttons, the dark/light
  switch, and the *ewgtk command all silently clobbering any OTHER
  script's writes to the shared lichwindows.yaml -- all three saved a
  cached settings hash instead of re-reading the file fresh first.
  *ewgtk was the worst of the three: it saved ExitWindow.settings, a
  class-level hash loaded once at script STARTUP, so it stayed stale for
  the entire session, not just since the window was opened. Confirmed
  as the real cause of a user-reported "my exp_sagapanel change didn't
  save" report. All three now go through update_setting (already
  fresh-reloads before saving), same as every other safe setter in this
  file.
  1.2.0 - Added configurable multi-column layout (1-4) matching creaturewindow/playerwindow, and Saga support.
=end

no_kill_all

require 'yaml'

module ExitWindow
  extend self
  include Lich::Common if defined?(Lich::Common)

  class << self
    attr_accessor :settings, :window_settings, :use_gtk_window, :columns, :single_column, :show_headers
  end
end

# Saga dynamic-dialog layout controls.  Adjust these values when changing the
# panel font or when longer Lich exit labels need more room.
#
# No fixed width/height on the openDialog itself (see the _respond call
# below) -- Saga sizes the dialog to its content naturally the same way
# effectsbar_sagapanel.lic/playerwindow.lic/creaturewindow.lic do. A fixed
# height forces a scrollbar the moment a room has more exits than fit in it;
# a fixed width does the same horizontally once Lich exit labels overflow it.
#
# Bounded width for the Lich exit column specifically. "natural" (nil) FE
# sizing lets a long ;go2 command push past this with no wrapping (nbsp'd
# spaces block wrapping outright), which is what forces a horizontal
# scrollbar at small panel widths. Keep this a concrete number so labels get
# truncated (see LICH_EXIT_CHAR_WIDTH) instead of overflowing.
ExitWindow::LICH_EXIT_COLUMN_WIDTH = 130 unless defined?(ExitWindow::LICH_EXIT_COLUMN_WIDTH)
# Rough px-per-character used to truncate Lich exit labels to fit within
# LICH_EXIT_COLUMN_WIDTH. The full command still runs on click; only the
# displayed label is shortened.
ExitWindow::LICH_EXIT_CHAR_WIDTH = 6 unless defined?(ExitWindow::LICH_EXIT_CHAR_WIDTH)
ExitWindow::EXIT_LINK_HEIGHT = 20 unless defined?(ExitWindow::EXIT_LINK_HEIGHT)
ExitWindow::ROOM_INFO_COLUMN_WIDTH = 110 unless defined?(ExitWindow::ROOM_INFO_COLUMN_WIDTH)

EW_DEFAULT_WINDOW_SETTINGS = {
  "exitwindow" => {
    "single_column"        => false,
    "columns"                => 2,
    "show_headers"           => true,
    "use_gtk_exitwindow" => true,
    "font_size"              => 17,
    "x"                      => 2280,
    "y"                      => 1600,
    "width"                  => 705,
    "height"                 => 370,
    "palette"                => "White on Black"
  }
} unless defined?(EW_DEFAULT_WINDOW_SETTINGS)

def ExitWindow.window_settings_path(name: Char.name)
  # Use $data_dir and XMLData.game for Lich data structure
  base_dir = "#{$data_dir}#{XMLData.game}/#{name}"
  Dir.mkdir("#{$data_dir}#{XMLData.game}") unless File.exist?("#{$data_dir}#{XMLData.game}")
  Dir.mkdir(base_dir) unless File.exist?(base_dir)
  File.join(base_dir, "lichwindows.yaml")
end

def ExitWindow.load_window_settings(name: Char.name)
  filename = window_settings_path(name: name)
  settings_hash = nil

  if File.exist?(filename) && name == Char.name
    settings_hash = YAML.load_file(filename)
  elsif !File.exist?(filename) && name != Char.name
    echo "Window settings: Attempt to load a profile (#{name}) that does not exist."
    settings_hash = nil
  elsif !File.exist?(filename) && name == Char.name
    echo "Window settings: No current settings found. Loading defaults..."
    File.write(filename, EW_DEFAULT_WINDOW_SETTINGS.to_yaml)
    settings_hash = EW_DEFAULT_WINDOW_SETTINGS
  else
    echo "Window settings: Unknown error loading profile (#{name})"
    settings_hash = nil
  end

  settings_hash
end

def ExitWindow.save_window_settings(settings, name: Char.name)
  filename = window_settings_path(name: name)
  File.write(filename, settings.to_yaml)
end

def ExitWindow.update_setting(key, value)
  settings = ExitWindow.load_window_settings
  settings["exitwindow"] ||= {}
  settings["exitwindow"][key] = value
  ExitWindow.settings = settings
  ExitWindow.window_settings = settings["exitwindow"]
  ExitWindow.save_window_settings(settings)
end

def ExitWindow.copy_to_windows_clipboard(text)
  return false unless Gem.win_platform?

  require 'fiddle'

  user32 = Fiddle.dlopen('user32.dll')
  kernel32 = Fiddle.dlopen('kernel32.dll')
  open_clipboard = Fiddle::Function.new(
    user32['OpenClipboard'],
    [Fiddle::TYPE_VOIDP],
    Fiddle::TYPE_INT
  )
  close_clipboard = Fiddle::Function.new(
    user32['CloseClipboard'],
    [],
    Fiddle::TYPE_INT
  )
  empty_clipboard = Fiddle::Function.new(
    user32['EmptyClipboard'],
    [],
    Fiddle::TYPE_INT
  )
  set_clipboard_data = Fiddle::Function.new(
    user32['SetClipboardData'],
    [Fiddle::TYPE_UINT, Fiddle::TYPE_VOIDP],
    Fiddle::TYPE_VOIDP
  )
  global_alloc = Fiddle::Function.new(
    kernel32['GlobalAlloc'],
    [Fiddle::TYPE_UINT, Fiddle::TYPE_SIZE_T],
    Fiddle::TYPE_VOIDP
  )
  global_free = Fiddle::Function.new(
    kernel32['GlobalFree'],
    [Fiddle::TYPE_VOIDP],
    Fiddle::TYPE_VOIDP
  )
  global_lock = Fiddle::Function.new(
    kernel32['GlobalLock'],
    [Fiddle::TYPE_VOIDP],
    Fiddle::TYPE_VOIDP
  )
  global_unlock = Fiddle::Function.new(
    kernel32['GlobalUnlock'],
    [Fiddle::TYPE_VOIDP],
    Fiddle::TYPE_INT
  )

  opened = 5.times.any? do
    break true if open_clipboard.call(0) != 0

    sleep 0.02
    false
  end
  return false unless opened

  handle = nil
  transferred = false
  begin
    return false if empty_clipboard.call.zero?

    utf16_text = text.to_s.encode('UTF-16LE') + "\x00\x00"
    handle = global_alloc.call(0x0042, utf16_text.bytesize)
    return false if handle.to_i.zero?

    locked = global_lock.call(handle)
    return false if locked.to_i.zero?

    begin
      Fiddle::Pointer.new(locked.to_i)[0, utf16_text.bytesize] = utf16_text
    ensure
      global_unlock.call(handle)
    end

    transferred = !set_clipboard_data.call(13, handle).to_i.zero?
    transferred
  ensure
    global_free.call(handle) if handle && !transferred
    close_clipboard.call
  end
rescue StandardError
  false
end

def ExitWindow.copy_to_clipboard(text)
  return true if ExitWindow.copy_to_windows_clipboard(text)

  begin
    require 'copy_to_clipboard'
    if defined?(CopyToClipboard)
      CopyToClipboard.copy(text.to_s)
      return true
    end
  rescue LoadError
    # Try the next available clipboard implementation.
  rescue StandardError
    # Try the next available clipboard implementation.
  end

  begin
    require 'win32/clipboard'
    Win32::Clipboard.set_data(text.to_s)
    return true
  rescue LoadError
    # Try the native Windows clipboard command below.
  rescue StandardError
    # Try the native Windows clipboard command below.
  end

  begin
    IO.popen('clip', 'w') { |io| io.write(text.to_s) }
    $?.success?
  rescue StandardError
    false
  end
end

def ExitWindow.room_info
  [
    { id: 'room_info', label: 'L#', type: 'lich', value: Room.current.id.to_s },
    { id: 'room_info_uid', label: 'U#', type: 'u', value: Room.current.uid.to_s.gsub(/[\[\]]/, '') },
  ]
end

def ExitWindow.copy_current_room_number(type)
  info = room_info.find { |entry| entry[:type] == type.to_s }
  return false unless info

  clipboard_value = info[:type] == 'u' ? "u#{info[:value]}" : info[:value]
  copied = copy_to_clipboard(clipboard_value)
  if copied
    echo "ExitWindow: #{info[:label]} #{info[:value]} copied as #{clipboard_value}."
  else
    echo "ExitWindow: unable to copy #{info[:label]} #{info[:value]} to clipboard."
  end
  copied
end

# Set the column count (1-4), persist it, and refresh both the dialog panel
# and the GTK window. Returns the applied count.
def ExitWindow.apply_column_setting(n)
  n = [[n.to_i, 1].max, 4].min
  ExitWindow.columns = n
  ExitWindow.single_column = (n == 1)
  ExitWindow.update_setting("columns", n)
  ExitWindow.update_setting("single_column", n == 1)

  ExitWindow.update_room_info if Frontend.supports_room_window?
  if ExitWindow.use_gtk_window && ExitWindowGtk.instance_variable_get(:@window)
    std   = ExitWindow.extract_exits_from_paths(Room.current.paths)
    lich  = ExitWindow.extract_lich_exits(Room.current.id)
    trash = ExitWindow.extract_trash_containers
    ExitWindowGtk.update_exits(std, lich, trash)
  end
  n
end

ExitWindow.settings       = ExitWindow.load_window_settings
ExitWindow.window_settings         = ExitWindow.settings["exitwindow"] ||= {}
ExitWindow.use_gtk_window = ExitWindow.window_settings["use_gtk_window"] || false
ExitWindow.columns = begin
  c = ExitWindow.window_settings["columns"].to_i
  c = (ExitWindow.window_settings["single_column"] ? 1 : 2) unless (1..4).include?(c)
  [[c, 1].max, 4].min
end
ExitWindow.single_column = (ExitWindow.columns == 1)
ExitWindow.show_headers = ExitWindow.window_settings.fetch("show_headers", true)

# If GTK is explicitly enabled, always launch it.
if ExitWindow.use_gtk_window
  respond ""
  respond " GTK exits window is enabled."
  respond ""
  respond " Initiating GTK window."
  respond ""
  Gtk.queue { ExitWindowGtk.create_main_window }
  Thread.new { Gtk.main if Gtk.main_level == 0 }

# Otherwise fall back to auto-GTK for non-StormFront frontends.
elsif !Frontend.supports_room_window?
  respond ""
  respond " Using a frontend other than Wrayth."
  respond ""
  respond " Initiating GTK window."
  respond ""
  Gtk.queue { ExitWindowGtk.create_main_window }
  Thread.new { Gtk.main if Gtk.main_level == 0 }
end

if Frontend.supports_room_window?
# Open the room info window using Wrayth's dynamic dialog.  The compass
# occupies the first 3 columns; leave enough room for full Lich exit labels.
_respond("<closeDialog id='Exits'/><openDialog type='dynamic' id='Exits' title='Exits' target='Exits' location='main' resident='true'><dialogData id='Exits'></dialogData></openDialog>")
end

@ew_last_room_id = nil

ExitWindow.send(:remove_const, :COMPASS_EXIT_ALIASES) if ExitWindow.const_defined?(:COMPASS_EXIT_ALIASES, false)
ExitWindow::COMPASS_EXIT_ALIASES = {
  'n' => 'n', 'north' => 'n',
  'ne' => 'ne', 'northeast' => 'ne',
  'e' => 'e', 'east' => 'e',
  'se' => 'se', 'southeast' => 'se',
  's' => 's', 'south' => 's',
  'sw' => 'sw', 'southwest' => 'sw',
  'w' => 'w', 'west' => 'w',
  'nw' => 'nw', 'northwest' => 'nw',
  'o' => 'o', 'out' => 'o',
  'u' => 'u', 'up' => 'u',
  'd' => 'd', 'down' => 'd'
}.freeze

ExitWindow.send(:remove_const, :COMPASS_GRID_ROWS) if ExitWindow.const_defined?(:COMPASS_GRID_ROWS, false)
ExitWindow::COMPASS_GRID_ROWS = [
  %w[nw n ne],
  %w[w o e],
  %w[sw s se],
  ['u', nil, 'd']
].freeze

def ExitWindow.exit_shorthand(exit)
  ExitWindow::COMPASS_EXIT_ALIASES[exit.to_s.downcase.strip]
end

def ExitWindow.exit_command(exit)
  "go #{exit.to_s.downcase.strip}"
end

def ExitWindow.compass_exit_map(exits)
  exits.each_with_object({}) do |exit, memo|
    short = exit_shorthand(exit)
    memo[short] ||= exit if short
  end
end

def ExitWindow.non_compass_exits(exits)
  exits.reject { |exit| exit_shorthand(exit) }
end

# Extract standard exits from the room's paths.
def ExitWindow.extract_exits_from_paths(paths)
  room_exits = []
  paths.each do |path|
    if path =~ /Obvious (?:paths|exits):\s*(.*)/i
      exits = $1.strip.split(/\s*,\s*|\s+and\s+/i).map { |exit| exit.strip.downcase }.reject(&:empty?)
      room_exits.concat(exits)
    end
  end
  room_exits.uniq
end

# Extract Lich exits that are not standard movement directions.
def ExitWindow.valid_exits(room_id)
  room = Room[room_id]
  return {} unless room

  room_exits = {}
  room.wayto.each do |key, value|
    next unless value.is_a?(String) || value.is_a?(Proc) # Ensure only valid exits

    room_exits[key] = { wayto: value, name: Room[key].title.first.gsub(/\[|\]/, '') }
  end

  room_exits
end

# Extract Lich exits using the valid_exits function.
def ExitWindow.extract_lich_exits(room_id)
  room_exits = valid_exits(room_id) # Use the valid_exits function
  return [] if room_exits.nil? || !room_exits.is_a?(Hash) || room_exits.empty?

  ignored_directions = /^(?:o|d|u|n|ne|e|se|s|sw|w|nw|out|down|up|north|northeast|east|southeast|south|southwest|west|northwest|StringProc)$/

  lich_exits = []
  room_exits.each do |key, value|
    next unless value.is_a?(Hash) && value[:wayto] # Ensure :wayto exists
    next if value[:wayto].to_s.match?(ignored_directions) # Ignore obvious directions

    wayto_cmd = if value[:wayto].is_a?(String)
                  value[:wayto]
                elsif value[:wayto] == "StringProc"
                  ";go2 #{key}" # Default for unknown procs
                else
                  next
                end

    lich_exits << { label: "#{wayto_cmd}", cmd: wayto_cmd, destination: value[:name] }
  end
  lich_exits
end

# Extract trash container using the meta tag method.
def ExitWindow.extract_trash_containers
  if (match = Room.current.tags.find { |t| t =~ /meta:trashcan:(.*)/ })
    # Use the match object to extract the trash container name and strip any extra whitespace.
    [match.match(/meta:trashcan:(.*)/)[1].strip]
  else
    []
  end
end

# Push exit and trash container data to the ExitWindow
def ExitWindow.push_room_info_to_window(standard_exits, lich_exits, trash_containers)
  output = "<dialogData id='Exits' clear='t'>"

  cols = [ExitWindow.columns, 1].max
  col_width = 60
  room_info_col_width = ExitWindow::ROOM_INFO_COLUMN_WIDTH
  link_height = ExitWindow::EXIT_LINK_HEIGHT
  header_height = ExitWindow.show_headers ? 18 : 0
  section_gap = 18
  compass_col_width = 34

  room_info = ExitWindow.room_info
  room_info.each_with_index do |info, index|
    col = index % cols
    row = index / cols
    value = "#{info[:label]}: #{info[:value]}"
    cmd = ";e ExitWindow.copy_current_room_number(:#{info[:type]})"
    output += "<link id='#{info[:id]}' value='#{value}' cmd='#{cmd}' echo='Copying #{value} to clipboard...' justify='left' left='#{col * room_info_col_width}' top='#{row * link_height}' width='#{room_info_col_width}' height='#{link_height}' font='normal' />"
  end

  room_info_height = link_height * (room_info.size.to_f / cols).ceil

  # Standard exits block: compass exits use a fixed 3-column rose.
  standard_exits_header_top = room_info_height # no gap: right after Lid#/Uid#
  if ExitWindow.show_headers
    output += "<label id='total' value='Exits: #{standard_exits.size}' left='0' top='#{standard_exits_header_top}' width='#{compass_col_width * 3}' height='#{header_height}' />"
  end

  compass_map = ExitWindow.compass_exit_map(standard_exits)
  lich_col_left = (compass_col_width * 3) + 10
  lich_col_width = ExitWindow::LICH_EXIT_COLUMN_WIDTH
  lich_width_attribute = lich_col_width.to_i > 0 ? " width='#{lich_col_width}'" : ''
  compass_base_top = standard_exits_header_top + header_height
  compass_rows = compass_map.empty? ? 0 : ExitWindow::COMPASS_GRID_ROWS.size
  ExitWindow::COMPASS_GRID_ROWS.each_with_index do |row_values, row|
    row_values.each_with_index do |short, col|
      next unless short && (exit = compass_map[short])

      output += "<link id='room_exit_#{short}' value='#{short}' cmd='#{ExitWindow.exit_command(exit)}' echo='#{ExitWindow.exit_command(exit)}' left='#{col * compass_col_width}' top='#{compass_base_top + (link_height * row)}' width='#{compass_col_width}' height='#{link_height}' />"
    end
  end

  lich_max_chars = lich_col_width.to_i > 0 ? [(lich_col_width.to_i / ExitWindow::LICH_EXIT_CHAR_WIDTH) - 1, 6].max : nil
  lich_exits.each_with_index do |lich_exit, index|
    lich_exit_top = compass_base_top + (link_height * index)
    raw_command = lich_exit[:cmd].to_s
    truncated_command = lich_max_chars && raw_command.length > lich_max_chars ? "#{raw_command[0...lich_max_chars]}..." : raw_command
    display_command = truncated_command.gsub(' ', '&#160;')
    output += "<link id='lich_exit_#{index}' value='#{display_command}' cmd='#{raw_command}' echo='#{raw_command}' justify='left' left='#{lich_col_left}' top='#{lich_exit_top}'#{lich_width_attribute} height='#{link_height}' font='normal' />"
  end

  non_compass_exits = ExitWindow.non_compass_exits(standard_exits)
  side_by_side_rows = [compass_rows, lich_exits.size].max
  non_compass_base_top = compass_base_top + (link_height * side_by_side_rows)
  non_compass_rows = (non_compass_exits.size.to_f / cols).ceil
  non_compass_exits.each_with_index do |exit, index|
    col = index % cols
    row = index / cols
    exit_top = non_compass_base_top + (link_height * row)
    output += "<link id='room_exit_extra_#{index}' value='#{exit}' cmd='#{ExitWindow.exit_command(exit)}' echo='#{ExitWindow.exit_command(exit)}' justify='left' left='#{col * col_width}' top='#{exit_top}' width='#{col_width}' height='#{link_height}' font='small' />"
  end

  # Calculate end of standard exits block
  standard_exits_rows = side_by_side_rows + non_compass_rows
  standard_exits_block_end = standard_exits_header_top + header_height + (link_height * standard_exits_rows)

  # Trash containers block, laid out in an N-column grid
  trash_containers_start = standard_exits_block_end + section_gap
  if trash_containers.any?
    output += "<label id='trash_containers' value='Trash Containers: #{trash_containers.size}' left='0' top='#{trash_containers_start}' width='#{col_width * cols}' height='#{header_height}' />"
    trash_base_top = trash_containers_start + header_height
    trash_containers.each_with_index do |trash, index|
      col = index % cols
      row = index / cols
      trash_top = trash_base_top + (link_height * row)
      output += "<label id='trash_#{index}' value='#{trash}' justify='left' left='#{col * col_width}' top='#{trash_top}' width='#{col_width}' height='#{link_height}' font='small' />"
    end
  end

  output += "</dialogData>"
  _respond(output)
end

# Update room exit information.
def ExitWindow.update_room_info
  standard_exits = ExitWindow.extract_exits_from_paths(Room.current.paths)
  lich_exits = ExitWindow.extract_lich_exits(Room.current.id)
  trash_containers = ExitWindow.extract_trash_containers

  ExitWindow.push_room_info_to_window(standard_exits, lich_exits, trash_containers)
end

# 1) Define palettes.
ExitWindow::PALETTES = {
  "Lich Dark Mode"     => { bg: "#2E2E2E", fg: "#DADADA" },
  "Lich Light Mode"    => { bg: "#E6E6E6", fg: "#202020" },
  "Middle Ground"      => { bg: "#333333", fg: "#FFFFFF" },
  "White on Black"     => { bg: "#000000", fg: "#FFFFFF" },
  "NQWhite on NQBlack" => { bg: "#111111", fg: "#f6f6f6" },
  "Black on White"     => { bg: "#FFFFFF", fg: "#000000" },
} unless defined?(ExitWindow::PALETTES)

class ExitWindowGtk
  @window       = nil
  @css_provider = nil
  @font_size    = nil

  # Regenerate and apply CSS using the chosen palette.
  def self.reload_css
    # Load persisted palette choice.
    settings = ExitWindow.load_window_settings
    tw       = settings["exitwindow"] ||= {}
    pal_name = tw["palette"] || "White on Black"
    colors   = ExitWindow::PALETTES[pal_name]

    css = <<~CSS
      /* window frame */
      window#exitwindow {
        background-color: #{colors[:bg]};
        color:            #{colors[:fg]};
        border:           0px solid #888888;
        border-radius:    4px;
      }

      window#exitwindow .palette-btn,
      window#exitwindow popover .palette-btn,
      window#exitwindow GtkPopover .palette-btn {
        background: #{colors[:bg]};
        color: #{colors[:fg]};
      }

      window#exitwindow .palette-btn:checked {
        background: #{colors[:bg]};
        color: #{colors[:fg]};
      }

      /* header bar */
      window#exitwindow headerbar {
        background-color: #{colors[:bg]};
        color:            #{colors[:fg]};
      }

      /* header bar buttons / toggles */
      window#exitwindow headerbar .header-toggle {
        margin:      0 2px;
        padding:     2px 4px;
        background-image: none;
        background-color: transparent;
        color:            #{colors[:fg]};
        border:           none;
        box-shadow:       none;
      }

      /* On state for toggles */
      window#exitwindow headerbar .header-toggle:checked {
        background-color: #0a84ff; /* system blue */
        color:            #FFFFFF;
      }

      /* content labels */
      window#exitwindow label {
        font-size: #{@font_size}px;
        color:     #{colors[:fg]};
      }

      window#exitwindow button.room-info-link {
        font-size:        #{@font_size}px;
        color:            #{colors[:fg]};
        background-image: none;
        background-color: transparent;
        border:           none;
        box-shadow:       none;
        padding:          0px;
        margin:           0px;
      }

      window#exitwindow button.room-info-link:hover {
        color: #0a84ff;
      }

      /* scrolled area & flowbox */
      window#exitwindow GtkScrolledWindow,
      window#exitwindow GtkFlowBox {
        background-color: #{colors[:bg]};
      }
    CSS

    @css_provider.load(data: css)
  end

  def self.create_main_window
    return if @window

    # Load persisted settings.
    settings = ExitWindow.load_window_settings
    ew = settings["exitwindow"] ||= {}
    dark_mode = ew["dark_mode"] || false
    @font_size = ew["font_size"] || 14

    # Build top-level window and HeaderBar.
    @window = Gtk::Window.new(:toplevel)
    @window.set_name("exitwindow")
    @window.set_border_width(10)
    @window.set_type_hint(Gdk::WindowTypeHint::UTILITY)
    @window.set_keep_above(true)

    header = Gtk::HeaderBar.new
    header.show_close_button = true
    header.title = "EW"

    # Font size buttons.
    dec_btn = Gtk::Button.new(label: "A-")
    inc_btn = Gtk::Button.new(label: "A+")
    [dec_btn, inc_btn].each { |b| b.style_context.add_class("header-toggle"); header.pack_start(b) }
    dec_btn.signal_connect("clicked") do
      @font_size = [@font_size - 1, 8].max
      ExitWindow.update_setting("font_size", @font_size)
      reload_css
    end
    inc_btn.signal_connect("clicked") do
      @font_size = [@font_size + 1, 30].min
      ExitWindow.update_setting("font_size", @font_size)
      reload_css
    end

    # Dark/Light switch.
    theme_switch = Gtk::Switch.new
    theme_switch.active = dark_mode
    @window.style_context.add_class("dark") if dark_mode
    theme_switch.signal_connect("notify::active") do |sw, _|
      if sw.active?
        @window.style_context.add_class("dark")
      else
        @window.style_context.remove_class("dark")
      end
      ExitWindow.update_setting("dark_mode", sw.active?)
      reload_css
    end
    header.pack_end(theme_switch)

    @window.set_titlebar(header)

    # CSS provider and initial styling.
    @css_provider = Gtk::CssProvider.new
    reload_css
    screen = Gdk::Screen.default
    Gtk::StyleContext.add_provider_for_screen(
      screen,
      @css_provider,
      Gtk::StyleProvider::PRIORITY_APPLICATION
    )

    # Restore geometry.
    @window.resize(ew["width"], ew["height"]) if ew["width"] && ew["height"]
    @window.move(ew["x"], ew["y"]) if ew["x"] && ew["y"]

    @scroll = Gtk::ScrolledWindow.new
    @scroll.set_policy(Gtk::PolicyType::AUTOMATIC, Gtk::PolicyType::AUTOMATIC)
    @scroll.set_hexpand(true)
    @scroll.set_vexpand(true)

    @flow = Gtk::FlowBox.new
    @flow.selection_mode        = :none
    @flow.max_children_per_line = 1
    @flow.column_spacing        = 0
    @flow.row_spacing           = 0
    @flow.set_vexpand(true)
    @flow.valign                = Gtk::Align::START
    @flow.homogeneous           = false
    @scroll.add(@flow)

    @window.add(@scroll)

    # Save geometry on move/resize.
    @ignore_next_configure = true
    @window.signal_connect("configure_event") do |_w, _ev|
      if @ignore_next_configure
        @ignore_next_configure = false
      else
        x, y = @window.position
        w, h = @window.size
        s = ExitWindow.load_window_settings
        s["exitwindow"] ||= {}
        s["exitwindow"].merge!("x" => x, "y" => y, "width" => w, "height" => h)
        ExitWindow.save_window_settings(s)
      end
      false
    end

    @window.signal_connect("destroy") do
      @window = nil
      # Do not quit the GTK main loop here. This window can share a GTK
      # process with the frontend/other scripts, and quitting it can drop session.
    end
    @window.show_all

    # Initial fill.
    if defined?(Room) && Room.current
      std   = ExitWindow.extract_exits_from_paths(Room.current.paths)
      lich  = ExitWindow.extract_lich_exits(Room.current.id)
      trash = ExitWindow.extract_trash_containers
      ExitWindowGtk.update_exits(std, lich, trash)
    end
  end

  def self.update_exits(standard, lich, trash)
    return unless @window
    Gtk.queue do
      @flow.max_children_per_line = [[ExitWindow.columns, 1].max, 4].max

      # clear out old widgets
      @flow.children.each { |c| @flow.remove(c) }

      cols = [[ExitWindow.columns, 1].max, 4].max

      # Pad out the remainder of the current row so the next section starts
      # on a fresh row instead of sharing one with the tail of the previous.
      pad_to_next_row = ->(count) {
        remainder = count % cols
        (cols - remainder).times { @flow.add(Gtk::Label.new("")) } if remainder != 0
      }

      # ---- ROOM INFO: Add once at the top! ----
      ExitWindow.room_info.each do |info|
        room_info = Gtk::Button.new(label: "#{info[:label]}: #{info[:value]}")
        room_info.set_halign(Gtk::Align::START)
        room_info.style_context.add_class("room-info")
        room_info.style_context.add_class("room-info-link")
        room_info.signal_connect("clicked") do
          ExitWindow.copy_current_room_number(info[:type])
        end
        @flow.add(room_info)
      end
      pad_to_next_row.call(2)

      # helper to render a titled section of plain labels/buttons
      render_section = ->(items) do
        items.each do |it|
          display_label = it.is_a?(Hash) ? it[:label] : it.to_s
          # Optionally: make them clickable here if you want, as previously suggested
          line = Gtk::Label.new("#{display_label}")
          line.set_xalign(0)
          @flow.add(line)
        end
        pad_to_next_row.call(items.size)
      end

      render_standard_exits = ->(items, lich_items) do
        compass_map = ExitWindow.compass_exit_map(items)
        added = 0
        rows = [compass_map.empty? ? 0 : ExitWindow::COMPASS_GRID_ROWS.size, lich_items.size].max
        rows.times do |row_index|
          row_values = ExitWindow::COMPASS_GRID_ROWS[row_index] || [nil, nil, nil]
          row_values.each do |short|
            display = short && compass_map[short] ? short : ''
            line = Gtk::Label.new(display)
            line.set_xalign(0)
            @flow.add(line)
            added += 1
          end

          display_label = lich_items[row_index].is_a?(Hash) ? lich_items[row_index][:label] : lich_items[row_index].to_s
          line = Gtk::Label.new(display_label.to_s)
          line.set_xalign(0)
          @flow.add(line)
          added += 1
        end

        extras = ExitWindow.non_compass_exits(items)
        extras.each do |exit|
          line = Gtk::Label.new(exit.to_s)
          line.set_xalign(0)
          @flow.add(line)
          added += 1
        end
        pad_to_next_row.call(added)
      end

      if ExitWindow.show_headers
        @flow.add(Gtk::Label.new("Exits: #{standard.size}"))
        pad_to_next_row.call(1)
      end
      render_standard_exits.call(standard, lich)
      @flow.add(Gtk::Label.new(""))
      pad_to_next_row.call(1)
      render_section.call(trash)

      @flow.show_all
    end
  end
end

upstream_hook_id   = "#{Script.current.name}_upstream"

UpstreamHook.remove(upstream_hook_id)   rescue nil

UpstreamHook.add(upstream_hook_id, proc do |command|
  case command.strip.downcase
  when /\A\*ewcopy\s+(lich|u)\s+(.+)\z/
    room_type = Regexp.last_match(1)
    room_number = Regexp.last_match(2).strip
    clipboard_value = room_type == 'u' ? "u#{room_number}" : room_number
    if ExitWindow.copy_to_clipboard(clipboard_value)
      respond "#{room_type.upcase} room #{room_number} copied as #{clipboard_value}."
    else
      respond "Unable to copy #{room_type.upcase} room #{room_number} to clipboard."
    end
    nil

  when /\*ewgtk/
    ExitWindow.use_gtk_window = !ExitWindow.use_gtk_window
    respond "GTK exits window is now #{ExitWindow.use_gtk_window ? 'ENABLED' : 'DISABLED'}."
    ExitWindow.update_setting("use_gtk_window", ExitWindow.use_gtk_window)
    if ExitWindow.use_gtk_window
      Gtk.queue { ExitWindowGtk.create_main_window }
      Thread.new { Gtk.main if Gtk.main_level == 0 }
    else
      if ExitWindowGtk.instance_variable_get(:@window)
        Gtk.queue { ExitWindowGtk.instance_variable_get(:@window).close }
      end
    end
    nil

  when /\*ewcol3\b/
    n = ExitWindow.apply_column_setting(3)
    respond "Column Layout: #{n} columns"
    nil

  when /\*ewcol4\b/
    n = ExitWindow.apply_column_setting(4)
    respond "Column Layout: #{n} columns"
    nil

  when /\*ewcol\b/
    # Classic single/double toggle (drops back to 1/2 even from 3/4).
    n = ExitWindow.apply_column_setting(ExitWindow.columns == 2 ? 1 : 2)
    respond "Column Layout: #{n == 1 ? 'Single' : 'Double'} (#{n} column#{n == 1 ? '' : 's'})"
    nil

  when /\*ewheader\b/
    ExitWindow.show_headers = !ExitWindow.show_headers
    ExitWindow.update_setting("show_headers", ExitWindow.show_headers)
    respond "Exit headers are now #{ExitWindow.show_headers ? 'ON' : 'OFF'}."
    ExitWindow.update_room_info if Frontend.supports_room_window?
    if ExitWindow.use_gtk_window && ExitWindowGtk.instance_variable_get(:@window)
      std   = ExitWindow.extract_exits_from_paths(Room.current.paths)
      lich  = ExitWindow.extract_lich_exits(Room.current.id)
      trash = ExitWindow.extract_trash_containers
      ExitWindowGtk.update_exits(std, lich, trash)
    end
    nil

  else
    command
  end
end)

before_dying do
  UpstreamHook.remove(upstream_hook_id)

  if defined?(ExitWindowGtk) && ExitWindowGtk.instance_variable_get(:@window)
    Gtk.queue { ExitWindowGtk.instance_variable_get(:@window).close }
  end
end

echo "Exitwindow is active." if Frontend.supports_room_window?

loop do
  if @ew_last_room_id != Room.current.id
    std   = ExitWindow.extract_exits_from_paths(Room.current.paths)
    lich  = ExitWindow.extract_lich_exits(Room.current.id)
    trash = ExitWindow.extract_trash_containers

    ExitWindow.update_room_info if Frontend.supports_room_window?
    ExitWindowGtk.update_exits(std, lich, trash) if ExitWindow.use_gtk_window

    @ew_last_room_id = Room.current.id
  end
  sleep 0.1
end

