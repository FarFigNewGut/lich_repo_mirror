=begin
  utilitybeltx.lic
  Author: Hexbane
  Version: 1.0
  Tags: combat, automation, wing pin, parasite, vissi, cleric

  Combined combat automation script managing:
    - Wing pin abilities (dark and light modes)
    - Cirrose Parasite vissi activation

  Wing pin credits: original EnergyWings script by Ruseoffools and Codex.
  Parasite credits: original ParasiteX script by Hexbane.

  Each system runs in its own thread and can be independently enabled/disabled.

  Wing Pin logic:
    - Defensive tap (Shadow Mantle / Luminous Flight): fires when off cooldown
    - Single target (Shadow Barb / Radiant Pulse): fires when target is vulnerable
    - Multi target (Barbed Sweep / Blast of Brilliance): vulnerable AND target count >= threshold
    - AOE (Rain of Thorns / Blinding Reprisal): target count >= threshold (precast invoke 1714)
    - Guard AOE (Carrion Guard / Wings of Warding): bleeding AND target count >= threshold

  Parasite logic:
    - Fires when target is vulnerable and vissi is off cooldown
    - Skips configured creature types

  Usage:
    ;utilitybeltx        -- start with saved settings
    ;utilitybeltx setup  -- open GTK setup GUI
    ;utilitybeltx reset  -- clear saved settings
=end

require 'yaml'
require 'thread'

module UtilityBeltX
  PRONE_STATUS     = /sleeping|webbed|stunned|kneeling|sitting|lying|prone|frozen|held in place|entangled|rooted/i
  POLL_INTERVAL    = 0.3
  VISSI_MUTEX      = Mutex.new
  @wing_active = false

  def self.wing_active?; @wing_active; end
  def self.wing_active=(v); @wing_active = v; end
  @wealth_threshold = 1

  def self.wealth_threshold=(val)
    @wealth_threshold = val.to_i
  end

  def self.wealth_threshold
    @wealth_threshold
  end

  def self.wealth_wants_fire?
    return false unless Effects::Cooldowns.to_h.keys.none? { |k| k.to_s =~ /Wealth/i }
    target_count = GameObj.npcs.count { |n| n && n.status.to_s !~ /dead|gone/ }
    target_count >= @wealth_threshold
  rescue StandardError
    false
  end

  def self.settings_path
    File.join(DATA_DIR, XMLData.game, Char.name, 'utilitybeltx.yaml')
  end

  def self.load_settings
    defaults = {
      'wings_enabled'          => true,
      'wings_use_tap'          => true,
      'wings_use_single'       => true,
      'wings_use_multi'        => true,
      'wings_use_aoe'          => true,
      'wings_use_guard'        => true,
      'wings_multi_threshold'  => 3,
      'wings_aoe_threshold'    => 4,
      'wings_guard_threshold'  => 4,
      'wings_pause_scripts'    => 'bigshot',
      'wings_precast_tap'      => '',
      'wings_precast_single'   => '',
      'wings_precast_multi'    => '',
      'wings_precast_aoe'      => '',
      'wings_precast_guard'    => '',
      'parasite_enabled'       => true,
      'parasite_command'       => 'rub my ave arc',
      'parasite_pause_scripts' => '',
      'parasite_skip'          => '',
      'fatedfruit_enabled'       => true,
      'fatedfruit_command'       => 'rub my ave arc',
      'fatedfruit_pause_scripts' => '',
      'fatedfruit_skip'          => '',
      # Wealth Vissi
      'wealth_enabled'           => false,
      'wealth_verb'              => 'rub',
      'wealth_arcarium'          => 'ave arc',
      'wealth_threshold'         => 3,
      'wealth_pause_scripts'     => '',
      # Bloodstone
      'bloodstone_enabled'           => false,
      'bloodstone_noun'              => 'earring',
      'bloodstone_vivacity_health'   => false,
      'bloodstone_vivacity_health_threshold' => 50,
      'bloodstone_vivacity_stamina'  => false,
      'bloodstone_vivacity_stamina_threshold' => 50,
      'bloodstone_vivacity_mana'     => false,
      'bloodstone_vivacity_mana_threshold' => 30,
      'bloodstone_sanguine_swap'     => false,
      'bloodstone_sanguine_swap_wounds' => 3,
      'bloodstone_prod'              => false,
      'bloodstone_pinch'             => false,
    }
    return defaults unless File.exist?(settings_path)
    loaded = YAML.load_file(settings_path) rescue {}
    defaults.merge(loaded)
  end

  def self.save_settings(data)
    dir = File.dirname(settings_path)
    Dir.mkdir(dir) unless Dir.exist?(dir)
    File.write(settings_path, data.to_yaml)
  end

  module SetupGUI
    def self.run
      unless defined?(Gtk) && Gtk::Version::MAJOR == 3
        echo "GTK3 is not available."
        exit
      end

      saved    = UtilityBeltX.load_settings
      @running = true
      @result  = nil

      Gtk.queue do
        @win = Gtk::Window.new(:toplevel)
        @win.set_title("UtilityBeltX Setup")
        @win.set_default_size(500, 560)
        @win.set_border_width(10)
        @win.keep_above = true

        outer = Gtk::Box.new(:vertical, 6)
        @win.add(outer)

        nb = Gtk::Notebook.new
        outer.pack_start(nb, expand: true, fill: true, padding: 0)

        # --- Wing Pin Tab ---
        w_scroll = Gtk::ScrolledWindow.new
        w_scroll.set_policy(:automatic, :automatic)
        w_vbox = Gtk::Box.new(:vertical, 8)
        w_vbox.set_border_width(10)
        w_scroll.add_with_viewport(w_vbox)

        @w_enabled = Gtk::CheckButton.new("Enable Wing Pin system")
        @w_enabled.active = saved['wings_enabled'] != false
        w_vbox.pack_start(@w_enabled, expand: false, fill: false, padding: 0)
        w_vbox.pack_start(Gtk::Separator.new(:horizontal), expand: false, fill: false, padding: 2)

        @w_checks  = {}
        @w_precasts = {}
        [
          ['wings_use_tap',    'Defensive tap (Shadow Mantle / Luminous Flight)',                        'wings_precast_tap',    'Tap pre-cast:',    'commands separated by ; e.g. incant 118'],
          ['wings_use_single', 'Single target -- vulnerable (Shadow Barb / Radiant Pulse)',               'wings_precast_single', 'Single pre-cast:', 'commands separated by ; e.g. incant 118'],
          ['wings_use_multi',  'Multi target -- vulnerable + count (Barbed Sweep / Blast of Brilliance)', 'wings_precast_multi',  'Multi pre-cast:',  'commands separated by ; e.g. incant 118'],
          ['wings_use_aoe',    'AOE -- target count (Rain of Thorns / Blinding Reprisal)',                'wings_precast_aoe',    'AOE pre-cast:',    'commands separated by ; e.g. invoke 1714 tat; cast'],
          ['wings_use_guard',  'Guard AOE -- bleeding + count (Carrion Guard / Wings of Warding)',        'wings_precast_guard',  'Guard pre-cast:',  'commands separated by ; e.g. incant 110'],
        ].each do |chk_key, chk_label, pre_key, pre_label, pre_placeholder|
          chk = Gtk::CheckButton.new(chk_label)
          chk.active = saved[chk_key] != false
