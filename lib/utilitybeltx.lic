        ].each do |key, label, placeholder, row|
          lbl = Gtk::Label.new(label)
          lbl.set_halign(:end)
          wv_grid.attach(lbl, 0, row, 1, 1)
          entry = Gtk::Entry.new
          entry.set_placeholder_text(placeholder)
