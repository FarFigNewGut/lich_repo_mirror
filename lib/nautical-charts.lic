# ---------- HELPER METHODS ----------

def charts_sync_echo(msg); respond "[MapSync: #{msg}]" rescue puts msg; end

def charts_download_folder(user, repo, api_path, local_dir)
  FileUtils.mkdir_p(local_dir) unless Dir.exist?(local_dir)
  api_url = "https://api.github.com/repos/#{user}/#{repo}/contents/#{api_path}"
  begin
    response = URI.open(api_url, "User-Agent" => "Lich-Map-Syncer").read
    data = JSON.parse(response)
    unless data.is_a?(Array)
      charts_sync_echo("Error: #{api_path} in #{repo} is not a folder.")
      return 0
    end
    count = 0
    data.each do |file|
      next unless file['type'] == 'file'
      file_name    = file['name']
      remote_size  = file['size'].to_i
      download_url = file['download_url']
      local_path   = File.join(local_dir, file_name)
      if !File.exist?(local_path) || File.size(local_path) != remote_size
        charts_sync_echo("Downloading: #{file_name} from #{repo}...")
        URI.open(download_url) do |remote|
          File.open(local_path, "wb") { |local| local.write(remote.read) }
        end
        count += 1
      end
    end
    count
  rescue => e
    charts_sync_echo("Error syncing #{repo}/#{api_path}: #{e.message}")
    0
  end
end

# Window icon for the map and settings windows (replaces the Ruby gem icon).
# Loaded once; nil if the file hasn't been downloaded yet, so GTK keeps its default.
def charts_window_icon
  return $charts_window_icon if defined?($charts_window_icon_loaded) && $charts_window_icon_loaded
  $charts_window_icon_loaded = true
  $charts_window_icon = File.exist?(APPICON_FILE) ? GdkPixbuf::Pixbuf.new(file: APPICON_FILE) : nil
rescue StandardError
  $charts_window_icon = nil
end

def charts_apply_window_icon(win)
  icon = charts_window_icon
  win.set_icon(icon) if icon && win && !win.destroyed?
rescue StandardError
  nil
end

def nautical_sync_all
  charts_sync_echo("Connecting to OSA Repository...")
  png_updates = charts_download_folder(MAP_GIT_USER, MAP_GIT_REPO, MAP_GIT_PATH, LOCAL_MAP_DIR)
  bg_updates  = charts_download_folder(BG_GIT_USER, BG_GIT_REPO, BG_GIT_PATH, LOCAL_BG_DIR)
  json_updates = charts_download_folder(JSON_GIT_USER, JSON_GIT_REPO, JSON_GIT_PATH, LOCAL_JSON_DIR)
  icons_updates = charts_download_folder(ICONS_GIT_USER, ICONS_GIT_REPO, ICONS_GIT_PATH, LOCAL_ICONS_DIR)
  ports_updates = charts_download_folder(PORTS_GIT_USER, PORTS_GIT_REPO, PORTS_GIT_PATH, LOCAL_PORTS_DIR)
  sounds_updates = charts_download_folder(SOUNDS_GIT_USER, SOUNDS_GIT_REPO, SOUNDS_GIT_PATH, LOCAL_SOUNDS_DIR)
  appicon_updates = charts_download_folder(APPICON_GIT_USER, APPICON_GIT_REPO, APPICON_GIT_PATH, LOCAL_APPICON_DIR)
  total = png_updates + json_updates + icons_updates + bg_updates + sounds_updates + ports_updates + appicon_updates
  if total > 0
    charts_sync_echo("Success! Updated #{total} files from all repositories.")
  else
    charts_sync_echo("All files are up to date.")
  end
end

def play_audio_loop(file_path)
  stop_audio
  return unless $enable_sounds && File.exist?(file_path)

  if Gem.win_platform?
    # --- Windows (PowerShell) ---
    ps_cmd = "Add-Type -AssemblyName PresentationCore; $player = New-Object System.Windows.Media.MediaPlayer; $player.Open('#{file_path.gsub('/', '\\')}'); $player.Volume = 1.0; $player.Play(); while($true) { if ($player.Position -ge $player.NaturalDuration.TimeSpan) { $player.Position = [TimeSpan]::Zero; $player.Play() }; Start-Sleep -s 1; }"
    command = "powershell -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -Command \"#{ps_cmd}\""
    $current_audio_pid = spawn(command)
  elsif RUBY_PLATFORM =~ /darwin/
    # --- macOS (afplay) ---
    # Use full path to afplay in case PATH is constrained in Lich's spawn env.
    # Guard against CPU spin: if afplay fails, sleep 5 before retrying.
    # Use explicit /bin/sh to avoid PATH lookup issues with rbenv.
    escaped = file_path.gsub('"', '\\"')
    command = "while true; do /usr/bin/afplay \"#{escaped}\" 2>/dev/null || sleep 5; done"
    $current_audio_pid = spawn('/bin/sh', '-c', command)
  else
    # --- Linux (mpg123) ---
    # --loop 0 means loop infinitely
    command = "mpg123 --loop 0 \"#{file_path}\" > /dev/null 2>&1"
    $current_audio_pid = spawn(command)
  end

  Process.detach($current_audio_pid) if $current_audio_pid
end

def mm_echo(msg); respond "[nautical-charts: #{msg}]" rescue puts msg; end
def debug_echo(msg); mm_echo("DEBUG: #{msg}") if $debug_mode; end

def find_room(data, rid_int)
	rid = rid_int.to_s
	data.each { |_top, bucket|
		return bucket[rid] if bucket.is_a?(Hash) && bucket.key?(rid)
	}
	nil
end

def clamp(v, lo, hi); [[v, lo].max, hi].min; end

def scaled_pixbuf(pixbuf, scale)
	w = [(pixbuf.width * scale).round, 1].max
	h = [(pixbuf.height * scale).round, 1].max
	pixbuf.scale_simple(w, h, GdkPixbuf::InterpType::BILINEAR)
end

# ----- Global state -----
$minimap_win = nil
$minimap_alive = true
$data = nil
$ship_pixbuf_orig = nil
$current_room_id = nil
$current_map_file = nil
$current_cx = nil
$current_cy = nil
$follow_ship = true
$follow_timer_id = nil
$bg_pixbuf_orig = nil      
$map_image = nil
$bg_image = nil            
$ship_image = nil
$layout = nil
$scroller = nil
$status = nil
$ocean_watch_started = false
$charts_notebook = nil
$world_tab_active = false
