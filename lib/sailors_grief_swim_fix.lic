=begin
  A supplemental script to hotpatch the mapdb with proper swimming between
  sections of Sailor's Grief.

  Will eventually be included into GSIV Prime mapdb after thorough testing.

       author: Tysong
         game: gs
      version: 1.0.1

  changelog:
    1.0.1 (2026-11-19):
      * fix load-time NameError: waytos are now built from quoted heredocs so
        their code runs when go2 calls them, not when this script loads
      * waitrt? before every swim step; $go2_restart on every route
      * cap the Contempt sense loop so it can't spin forever
      * add Seat -> Contempt and Grief -> Contempt
    1.0.0 (2026-01-30):
      * initial release
=end

grief    = 35608
seat     = 35670
contempt = 35597
talons   = [35620, 35622, 35623, 35624, 35625, 35626, 35627, 35628].freeze

timeto_code = <<~'TIMETO'
  Skills.swimming >= 101 ? 10 : nil
TIMETO

# Fixed path: a list of commands sent one at a time.
fixed_path_code = <<~'WAYTO'
  dirs.each { |dir|
    wait_until { Char.stamina > 15 }
    waitrt?
    fput(dir)
    sleep(5)
  }
  $go2_restart = true
WAYTO

# Contempt: no fixed path, so follow SENSE until the target is a short swim away.
sense_path_code = <<~'WAYTO'
  wait_until { Char.stamina > 15 }
  waitrt?
  fput("#{sailors_grief_destination == "contempt" ? "swim" : "jump"} water")
  reverse = { "north" => "s", "south" => "n", "east" => "w", "west" => "e",
              "northeast" => "sw", "northwest" => "se", "southeast" => "nw", "southwest" => "ne" }
  done = false
  attempts = 0
  until done
    attempts += 1
    if attempts > 40
      echo "sailors_grief_swim_fix: gave up sensing #{sailors_grief_destination} after 40 tries"
      break
    end
    waitrt?
    result = Lich::Util.issue_command("sense #{sailors_grief_destination}", /Try as you might|short swim away|somewhere to the .+? of/)
    Array(result).each { |line|
      if line =~ /somewhere to the (?<dir>.+?) of/
        dir = reverse[Regexp.last_match[:dir]]
        next unless dir
        wait_until { Char.stamina > 15 }
        waitrt?
        fput(dir)
      elsif line =~ /is just a short swim away/
        wait_until { Char.stamina > 15 }
        waitrt?
        fput("swim #{sailors_grief_destination}")
        done = true
        break
      end
    }
  end
  $go2_restart = true
WAYTO

# These run at load time and only build code strings. Values are spliced in
# with #inspect, so the generated code holds literals, not references to
# variables that won't exist when go2 runs it.
set_fixed_path = lambda do |from, to, dirs|
  Room[from].wayto[to.to_s] = StringProc.new("dirs = #{dirs.inspect}\n" + fixed_path_code)
  Room[from].timeto[to.to_s] = StringProc.new(timeto_code)
end

set_sense_path = lambda do |from, to, destination|
  Room[from].wayto[to.to_s] = StringProc.new("sailors_grief_destination = #{destination.inspect}\n" + sense_path_code)
  Room[from].timeto[to.to_s] = StringProc.new(timeto_code)
end

grief_to_talon = ["swim water", "ne", "ne", "e", "e", "e", "e", "e", "swim talon"]
talon_to_grief = ["swim water", "sw", "sw", "w", "w", "w", "w", "w", "swim sailor"]
seat_to_talon  = ["swim water"] + ["se"] * 10 + ["e"] * 9 + ["swim talon"]
talon_to_seat  = ["swim water"] + ["nw"] * 10 + ["w"] * 9 + ["swim seat"]
seat_to_grief  = ["swim water"] + ["se"] * 10 + ["s", "s", "e", "e", "swim sailor"]
grief_to_seat  = ["swim water"] + ["nw"] * 10 + ["n", "n", "w", "w", "swim seat"]

talons.each do |talon|
  set_fixed_path.call(grief, talon, grief_to_talon)
  set_fixed_path.call(talon, grief, talon_to_grief)
  set_fixed_path.call(seat, talon, seat_to_talon)
  set_fixed_path.call(talon, seat, talon_to_seat)

  set_sense_path.call(contempt, talon, "talon")
  set_sense_path.call(talon, contempt, "contempt")
end

set_fixed_path.call(seat, grief, seat_to_grief)
set_fixed_path.call(grief, seat, grief_to_seat)

set_sense_path.call(contempt, grief, "grief")
set_sense_path.call(contempt, seat, "seat")
set_sense_path.call(grief, contempt, "contempt")
set_sense_path.call(seat, contempt, "contempt")