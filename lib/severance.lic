=begin
;severance is a script to remove spells at risk for Spell Sever zones, with options to configure a list of spells to preserve.

   original author: Kaetel
        maintainer: Kaetel
              game: gs
              tags: spellsever,spells
           version: 1.0.14

	v1.0.14 (2026-11-07)
		- Added the Mystic Thread and Greater Mystic Thread elite ascension skills: each lets one more
		  low level spell stay active on top of the limit, so it is kept rather than stopped

	v1.0.13 (2026-09-30)
		- Added rules command to print the Spell Sever rules being enforced, with the current limit and preserve list

	v1.0.12 (2026-09-03)
		- Added handling for lore unlocked short duration buffs (506, 211, 215, 219) to be ignored for severance
		- Updated to use Lich::Messaging for all output, allowing for better handling of output to streams and windows

	v1.0.11  (2024-07-10)
    - Fixed setlimit handling of values greater than a single digit

  v1.0.10  (2024-07-10)
    - Fixed output of check relative to configurable limit

	v1.0.9  (2024-07-09)
    - Added setlimit and --limit runtime override

  v1.0.8  (2024-02-09)
    - Added 1125

  v1.0.7  (2023-08-23)
    - Added ignore for spell numbers > 50 (cooldowns)

  v1.0.6  (2022-11-10)
    - Added --daemon mode, allowing the script to run in the background and automatically
        sever new spells as necessary
    - Added --quiet mode to support daemon mode and reduce output
    - Added --delay=X to customize daemon check frequency
  v1.0.5  (2022-09-06)
    - Added 1018

  v1.0.4  (2022-08-09)
    - Added `set` command to be able to define the entire priority list in a single command
    - Added examples to help
    - Added 605

  v1.0.3  (2022-08-08)
    - Changed to priority list rather than fixed 2 spell list for protected spells
    - Added `up` command to shift priorty of spells in protected list

  v1.0.2 (2022-07-29)
    - Added 1699

  v1.0.2 (2022-05-20)
    - Added 1605

  v1.0.1 (2022-05-20)
    - Added arcane/miscelaneous circles to the default exclusions

  v1.0.0 (2022-05-20)
    - Initial release

=end

Vars.severspells ||= []
Vars.severlimit ||= 2
$scriptname = script.name

module Severance
	# Group spells that are not subject to Spell Sever
	GROUPSPELLS = [
		307, 310, 							# Cleric
		605, 620, 							# Ranger
		1006, 1007, 1018, 1035, # Bard songs
		1213, 1216, 						# Minor Mental
		1125, 									# Empath 
		1605, 1609, 1617, 1618, # Paladin
		1699                    # Beacon of Courage (taunt effect from 1608)
	]
	# Spells that unlock a group buff version of themselves for a short duration.  These are not at risk for Spell Sever, so we will ignore them.
	SHORTGROUPSPELLS = [
		211, 215, 219,	# Major Spiritual lore unlocks
		506, 						# Celerity group
	]

	# Elite ascension skills (Artificer): with any ranks, each lets Spell Sever ignore 1 more
	# spell of at most level 5, raised 0.5 levels a rank (5 + 0.5 x ranks, rounded down).
	THREAD_SKILLS = {
		'mysticthread' => 'Mystic Thread',
		'greaterthread' => 'Greater Mystic Thread',
	}
	THREAD_BASE_LEVEL = 5
	THREAD_LEVEL_PER_RANK = 0.5

	@quiet = false
	@limit = nil

	def self.limit
		@limit || Vars.severlimit
	end

	def self.add(n)
		if Spell[n].nil?
			Lich::Messaging.msg("bold", "Unknown spell number #{n}")
			return
		elsif Vars.severspells.include?(n.to_i)
			Lich::Messaging.msg("bold", "#{Spell[n.to_i]} (#{n}) is already configured as one of your sever spells")
			return
		end

		Lich::Messaging.msg("speech", "Added #{Spell[n.to_i].name} (#{n}) to your protected spells")
		Vars.severspells |= [n.to_i]
	end

	def self.rem(n)
		if !Vars.severspells.include?(n.to_i)
			Lich::Messaging.msg("bold", "#{Spell[n.to_i]} (#{n}) is not configured as one of your sever spells")
			return
		end

		Lich::Messaging.msg("speech", "Removed #{Spell[n.to_i].name} (#{n}) from your protected spells")
		Vars.severspells.delete(n.to_i)
	end

	def self.up(n)
		if !Vars.severspells.include?(n.to_i)
			Lich::Messaging.msg("bold", "#{Spell[n.to_i]} (#{n}) is not configured as one of your sever spells")
			return
		elsif Vars.severspells.index(n.to_i) == 0
			Lich::Messaging.msg("bold", "#{Spell[n.to_i]} (#{n}) is already your top priority spell")
			return
		end

		i = Vars.severspells.index(n.to_i)
		Vars.severspells.insert((i - 1), Vars.severspells.delete_at(i))

		Lich::Messaging.msg("speech", "Moved #{Spell[n.to_i].name} (#{n}) up in priority")
	end

	def self.set(spells)
		toAdd = []
		spells.each{|n|
			if n.include?(',')
				toAdd |= n.split(',').map{|i| i.strip.to_i}
			else
				toAdd |= [n.to_i]
			end
		}

		if Vars.severspells.length > 0
			Lich::Messaging.msg("speech", "Resetting protected spell list...")
			Vars.severspells = []
		end

		Lich::Messaging.msg("speech", "Adding new spells...")
		toAdd.each{|s|
			self.add(s)
		}

		Lich::Messaging.msg("speech", "")
		self.list
	end

	def self.setLimit(limit)
		Vars.severlimit = limit.to_i
		Lich::Messaging.msg("speech", "Updated sever limit to #{limit}")
	end

	def self.list
		if Vars.severspells.length === 0
			Lich::Messaging.msg("speech", "No spells spells registered to keep for spell sever! Use ;severance add {spellnumber}")
			return
		end

		Lich::Messaging.msg("speech", "You are currently preserving the following spells, in order of priority:")
		Vars.severspells.each_with_index{|n, i|
			Lich::Messaging.msg("speech", "#{i} | #{Spell[n].name} (#{n})")
		}

		Lich::Messaging.msg("bold", "!! Important! Only the first #{self.limit()} protected spells will be kept in the event that you have more than #{self.limit()} of them active! !!")
	end

	def self.go(settings)
		@quiet = settings[:quiet]
		@limit = settings[:limit]

		if settings[:daemon]
			Lich::Messaging.msg("speech", "Running in daemon mode, rechecking every #{settings[:delay]} seconds")
			loop do
				self.sever
				sleep(settings[:delay].to_i)
			end
		end

    self.sever
	end

	def self.sever
		if Vars.severspells.length === 0
			Lich::Messaging.msg("speech", "No spells spells registered to keep for spell sever! Use ;severance add {spellnumber}")
			return
		end

		plan = self.plan
		if plan[:removed].empty?
			self.send("You're safely under the limit for Spell Sever")
			return
		end

		Lich::Messaging.msg("speech", "You're over the Spell Sever limit by #{plan[:removed].length} spells...")

		plan[:removed].each {|s|
			Lich::Messaging.msg("bold", "Removing #{s.num}")
			fput("stop #{s.num}")
		}
	end

	def self.check
		plan = self.plan

		unless plan[:threaded].empty?
			Lich::Messaging.msg("speech", "Protected by Mystic Thread:")
			plan[:threaded].each{|s, slot|
				Lich::Messaging.msg("speech", "- #{s.name} (#{s.num}) -- #{slot[:name]}, up to level #{slot[:level]}")
			}
		end

		if plan[:removed].empty?
			Lich::Messaging.msg("speech", "You're safely under the limit for Spell Sever")
			return
		end

		Lich::Messaging.msg("speech", "You're over the Spell Sever limit by #{plan[:removed].length} spells...")
		Lich::Messaging.msg("speech", "The following spells will be preserved:")

		plan[:kept].each{|s|
			Lich::Messaging.msg("speech", "- #{s.name} (#{s.num})")
		}

		Lich::Messaging.msg("bold", "The following spells are at risk of removal by this script!")
		plan[:removed].each{|s|
			dash = Vars.severspells.include?(s.num.to_i) ? '~' : '-'
			Lich::Messaging.msg("bold", "#{dash} #{s.name} (#{s.num})")
		}
	end

	# Mystic Thread ranks, from the ascension ranks Lich records. Lich only records them from
	# ASCENSION LIST (;infomon sync), and each game instance keeps its own, so ranks trained
	# since -- or a character never synced -- read as 0 until the next sync.
	def self.threadRanks(skill)
		(Infomon.get("ascension.#{skill}") rescue 0).to_i
	end

	# The extra spells Spell Sever ignores: one per thread skill with any ranks, each up to its
	# own spell level. Smallest first, so a low level spell doesn't use up a bigger slot.
	def self.threadSlots
		THREAD_SKILLS
			.map {|skill, name| { :name => name, :ranks => self.threadRanks(skill) } }
			.select {|slot| slot[:ranks] > 0 }
			.map {|slot| slot.merge(:level => (THREAD_BASE_LEVEL + THREAD_LEVEL_PER_RANK * slot[:ranks]).floor) }
			.sort_by {|slot| slot[:level] }
	end

	# A spell's level, from its number (1109 -> 9)
	def self.spellLevel(spell)
		spell.num.to_i % 100
	end

	# Fits +spells+ into the thread slots: each slot, smallest first, takes the highest level
	# spell still unplaced that it can hold, which places as many as possible. Returns
	# [[spell, slot]...] and the spells left over (these count toward the limit).
	def self.assignThreads(spells, slots)
		left = spells.dup
		threaded = []
		slots.each {|slot|
			fits = left.select {|s| self.spellLevel(s) <= slot[:level] }
			next if fits.empty?

			s = fits.max_by {|f| self.spellLevel(f) }
			threaded << [s, slot]
			left.delete(s)
		}
		[threaded, left]
	end

	# What happens to each severable spell. In priority order, a spell stays when the spells
	# staying so far can still all fit: the thread slots, then up to the limit. Of those, the
	# ones in a thread slot are ignored by Spell Sever (threaded), the others are kept; the rest
	# are removed.
	def self.plan
		slots = self.threadSlots
		staying = []
		removed = []

		severable.each {|s|
			_, left = self.assignThreads(staying + [s], slots)
			left.length <= self.limit() ? staying << s : removed << s
		}

		threaded, kept = self.assignThreads(staying, slots)
		{ :threaded => threaded, :kept => kept, :removed => removed }
	end

	# Spell is identified as a group effect that is not subject to Spell Sever
	def self._isGroupSpell(spell)
		GROUPSPELLS.include?(spell.num.to_i)
	end

	# Spell is identified as being a short duration buff by number and existence of the cooldown
	def self._isShortDurationGroupSpell(spell)
		SHORTGROUPSPELLS.include?(spell.num.to_i) &&
			Effects::Cooldowns.active?(spell.name)
	end

	def self._isArcane(spell)
		spell.circle.to_i > 16
	end

	# Ignore spells > 50 (cooldowns etc. from spell-list.xml)
	def self._isLichCustomEffect(spell)
		spell.num - (spell.circle.to_i * 100) > 50
	end

	def self.severable
		return Spell.active.select {|s| 
			!s.known? && 
			!_isGroupSpell(s) &&
			!_isShortDurationGroupSpell(s) &&
			!_isArcane(s) &&
			!_isLichCustomEffect(s)
		}
		.sort_by {|s|
			Vars.severspells.include?(s.num.to_i) ? 
				Vars.severspells.index(s.num.to_i) : 
				s.num.to_i + 1000
		}
	end

	def self.send(message)
		Lich::Messaging.msg("bold", message) unless @quiet
	end

	def self.spellNames(numbers)
		numbers.map { |n| Spell[n] ? "#{Spell[n].name} (#{n})" : n.to_s }.join(', ')
	end

	# The rules `severable` and `sever` enforce, in plain language.
	def self.rules(settings)
		limit = settings[:limit] || Vars.severlimit
		source = settings[:limit] ? "--limit override" : "#{$lich_char}#{$scriptname} setlimit"

		Lich::Messaging.msg("bold", "")
		Lich::Messaging.msg("bold", " Spell Sever rules enforced by #{$lich_char}#{$scriptname}")
		Lich::Messaging.msg("bold", "")
		Lich::Messaging.msg("speech", " 1. Limit")
		Lich::Messaging.msg("info",   "    At most #{limit} severable spell#{limit == 1 ? '' : 's'} may stay active (from #{source}).")
		Lich::Messaging.msg("info",   "    Every severable spell past the limit is ended with STOP.")
		slots = self.threadSlots
		if slots.empty?
			Lich::Messaging.msg("info", "    Mystic Thread / Greater Mystic Thread: no ranks recorded by Lich (#{$lich_char}infomon sync if you have some).")
		else
			slots.each {|slot|
				Lich::Messaging.msg("info", "    #{slot[:name]} (#{slot[:ranks]} ranks): 1 more spell of level #{slot[:level]} or lower is ignored, on top of the limit.")
			}
		end
		Lich::Messaging.msg("info",   "")
		Lich::Messaging.msg("speech", " 2. What counts as severable")
		Lich::Messaging.msg("info",   "    An active spell, unless it is one of these, which are never touched:")
		Lich::Messaging.msg("info",   "    - Spells you know yourself")
		Lich::Messaging.msg("info",   "    - Group spells: #{spellNames(GROUPSPELLS)}")
		Lich::Messaging.msg("info",   "    - Short-duration group unlocks while their cooldown is active: #{spellNames(SHORTGROUPSPELLS)}")
		Lich::Messaging.msg("info",   "    - Arcane and miscellaneous circles (spell circle 17 and up)")
		Lich::Messaging.msg("info",   "    - Secondary spell effects like Beacon of Courage, the taunt effect applied to group members by 1608")
		Lich::Messaging.msg("info",   "")
		Lich::Messaging.msg("speech", " 3. Which ones are kept")
		Lich::Messaging.msg("info",   "    Severable spells are ranked, and the top #{limit} #{limit == 1 ? 'is' : 'are'} kept:")
		if Vars.severspells.empty?
			Lich::Messaging.msg("info", "    - Your preserve list first (currently empty; #{$lich_char}#{$scriptname} add {spellnum})")
		else
			Lich::Messaging.msg("info", "    - Your preserve list first, in order: #{spellNames(Vars.severspells)}")
		end
		Lich::Messaging.msg("info",   "    - Then any other severable spell, lowest spell number first")
		Lich::Messaging.msg("info",   "    - In that order, a spell low enough for a free Mystic Thread slot takes it instead of counting toward the limit")
		Lich::Messaging.msg("info",   "")
		Lich::Messaging.msg("info",   " With no preserve list, nothing is removed. #{$lich_char}#{$scriptname} check previews what would be removed.")
	end

	def self.help
	    Lich::Messaging.msg("bold", "")
	    Lich::Messaging.msg("bold", " Severance by Kaetel")
	    Lich::Messaging.msg("bold", "")
	    Lich::Messaging.msg("bold", " #{$lich_char}#{$scriptname} is a script to remove spells at risk for Spell Sever zones, with options to configure a list of spells to preserve.")
	    Lich::Messaging.msg("bold", "")
	    Lich::Messaging.msg("info",   " Basic usage: #{$lich_char}#{$scriptname}")
	    Lich::Messaging.msg("info",   "    This will check your active spells and *STOP* any that are at risk for Spell Sever,")
	    Lich::Messaging.msg("info",   "    except those configured for preservation via #{$lich_char}#{$scriptname} add")
			Lich::Messaging.msg("info",   "    In addition, certain classes of spells will be ignored, including group spells,")
			Lich::Messaging.msg("info",   "    short duration buffs, and arcane/miscelaneous circles that are not subject to Spell Sever.")
			Lich::Messaging.msg("info",   "    Mystic Thread and Greater Mystic Thread ranks each let one more low level spell stay active.")
			Lich::Messaging.msg("info",   "    Their ranks come from Lich: after training them (or on a new character or server),")
			Lich::Messaging.msg("info",   "    run #{$lich_char}infomon sync so they're counted. #{$lich_char}#{$scriptname} rules shows the ranks in use.")
	    Lich::Messaging.msg("info",   "")
	    Lich::Messaging.msg("info",   " Advanced usage: #{$lich_char}#{$scriptname} \{--daemon\} \{--quiet\} \{--delay=5\} \{--limit=2\}")
	    Lich::Messaging.msg("info",   "    --daemon mode will keep the script active in the background, continuing to check")
	    Lich::Messaging.msg("info",   "    every few seconds (5 by default, override with --delay=X)")
	    Lich::Messaging.msg("info",   "    It is recommended that you also utilize --quiet to tone down the output when using")
	    Lich::Messaging.msg("info",   "    this mode.")
			Lich::Messaging.msg("info",   "    --limit will override the default sever limit of 2 spells at runtime.")
	    Lich::Messaging.msg("info",   "")
	    Lich::Messaging.msg("speech",  " Extra commands:")
	    Lich::Messaging.msg("info",   "  help                                     shows this help message")
	    Lich::Messaging.msg("info",   "  check                                    checks your current spells for Spell Sever risk")
	    Lich::Messaging.msg("info",   "  list                                     lists preserved spells")
	    Lich::Messaging.msg("info",   "  rules                                    explains the Spell Sever rules this script enforces")
	    Lich::Messaging.msg("info",   "  add or + {spellnum}                      adds a spell to your preserve list")
	    Lich::Messaging.msg("speech",  "  - Ex: #{$lich_char}#{$scriptname} add 215 OR #{$lich_char}#{$scriptname} + 215")
	    Lich::Messaging.msg("info",   "  rem or - {spellnum}                      removes a spell from your preserve list")
	    Lich::Messaging.msg("speech",  "  - Ex: #{$lich_char}#{$scriptname} rem 215 OR #{$lich_char}#{$scriptname} - 215")
	    Lich::Messaging.msg("info",   "  up {spellnum}                            moves a spell up in priority on your preserve list")
	    Lich::Messaging.msg("speech",  "  - Ex: #{$lich_char}#{$scriptname} up 215")
	    Lich::Messaging.msg("info",   "  set {spell1 spell2 ...spellN}            REPLACES your entire preserve list with the values provided")
	    Lich::Messaging.msg("speech",  "  - Ex: #{$lich_char}#{$scriptname} set 215 211 509 OR #{$lich_char}#{$scriptname} set 215,211,509")
			Lich::Messaging.msg("info",   "  setlimit {limit}                         Sets your default severance limit (currently set to #{Vars.severlimit})")
	    Lich::Messaging.msg("speech",  "  - Ex: #{$lich_char}#{$scriptname} setlimit 1")
	end
end

settings = {
	:quiet => false,
	:daemon => false,
	:delay => 5,
	:limit => nil,
}

Script.current.vars.each_with_index{|var, i|
	if var =~ /--quiet/
		settings[:quiet] = true
		Script.current.vars.delete_at(i)
	end

	if var =~ /--daemon/
		settings[:daemon] = true
		Script.current.vars.delete_at(i)
	end

	if var =~ /--delay=(\d+)/
		settings[:delay] = $1.to_i
		Script.current.vars.delete_at(i)
	end

	if var =~ /--limit=(\d+)/
		settings[:limit] = $1.to_i
		Script.current.vars.delete_at(i)
	end
}

if Script.current.vars[1].nil?
	Severance.go(settings)
elsif Script.current.vars[1].downcase.eql?('help')
	Severance.help
elsif Script.current.vars[1].downcase.eql?('list')
	Severance.list
elsif Script.current.vars[1].downcase.eql?('rules')
	Severance.rules(settings)
elsif Script.current.vars[1].downcase.eql?('check')
	Severance.check
elsif Script.current.vars[1].downcase.eql?('add') || Script.current.vars[1].downcase.eql?('+')
	Severance.add(Script.current.vars[2])
elsif Script.current.vars[1].downcase.eql?('rem') || Script.current.vars[1].downcase.eql?('-')
	Severance.rem(Script.current.vars[2])
elsif Script.current.vars[1].downcase.eql?('up')
	Severance.up(Script.current.vars[2])
elsif Script.current.vars[1].downcase.eql?('set')
	Severance.set(Script.current.vars[2..-1])
elsif Script.current.vars[1].downcase.eql?('setlimit') && Script.current.vars[2] =~ /^\d+$/
	Severance.setLimit(Script.current.vars[2])
else
	Lich::Messaging.msg("bold", "Unknown parameter '#{Script.current.vars[1]}'")
end