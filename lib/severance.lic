=begin
;severance is a script to remove spells at risk for Spell Sever zones, with options to configure a list of spells to preserve.

   original author: Kaetel
        maintainer: Kaetel
              game: gs
              tags: spellsever,spells
           version: 1.0.12

	v1.0.12 (2026-09-03)
		- Added handling for lore unlocked short duration buffs (506, 211, 215, 219) to be ignored for severance
		- Updated to use Lich::Messaging for all output, allowing for better handling of output to streams and windows

	v1.0.11  (2024-07-10)
    - Fixed setlimit handling of values greater than a single digit

  v1.0.10  (2024-07-10)
    - Fixed output of check relative to configurable limit

	v1.0.9  (2024-07-09)
    - Added setlimit and --limit runtime override

  v1.0.8  (2024-02-09)
    - Added 1125

  v1.0.7  (2023-08-23)
    - Added ignore for spell numbers > 50 (cooldowns)

  v1.0.6  (2022-11-10)
    - Added --daemon mode, allowing the script to run in the background and automatically
        sever new spells as necessary
    - Added --quiet mode to support daemon mode and reduce output
    - Added --delay=X to customize daemon check frequency
  v1.0.5  (2022-09-06)
    - Added 1018

  v1.0.4  (2022-08-09)
    - Added `set` command to be able to define the entire priority list in a single command
    - Added examples to help
    - Added 605

  v1.0.3  (2022-08-08)
    - Changed to priority list rather than fixed 2 spell list for protected spells
    - Added `up` command to shift priorty of spells in protected list

  v1.0.2 (2022-07-29)
    - Added 1699

  v1.0.2 (2022-05-20)
    - Added 1605

  v1.0.1 (2022-05-20)
    - Added arcane/miscelaneous circles to the default exclusions

  v1.0.0 (2022-05-20)
    - Initial release

=end

UserVars.severspells ||= []
UserVars.severlimit ||= 2
$scriptname = script.name

module Severance
	# Group spells that are not subject to Spell Sever
	GROUPSPELLS = [
		307, 310, 							# Cleric
		605, 620, 							# Ranger
		1006, 1007, 1018, 1035, # Bard songs
		1213, 1216, 						# Minor Mental
		1125, 									# Empath 
		1605, 1609, 1617, 1618, # Paladin
		1699                    # Beacon of Courage (tautn effect from 1608)
	]
	# Spells that unlock a group buff version of themselves for a short duration.  These are not at risk for Spell Sever, so we will ignore them.
	SHORTGROUPSPELLS = [
		211, 215, 219,	# Major Spiritual lore unlocks
		506, 						# Celerity group
	]

	@quiet = false
	@limit = nil

	def self.limit
		@limit || UserVars.severlimit
	end

	def self.add(n)
		if Spell[n].nil?
			Lich::Messaging.monsterbold("Unknown spell number #{n}")
			return
		elsif UserVars.severspells.include?(n.to_i)
			Lich::Messaging.monsterbold("#{Spell[n.to_i]} (#{n}) is already configured as one of your sever spells")
			return
		end

		Lich::Messaging.msg("speech", "Added #{Spell[n.to_i].name} (#{n}) to your protected spells")
		UserVars.severspells |= [n.to_i]
	end

	def self.rem(n)
		if !UserVars.severspells.include?(n.to_i)
			Lich::Messaging.monsterbold("#{Spell[n.to_i]} (#{n}) is not configured as one of your sever spells")
			return
		end

		Lich::Messaging.msg("speech", "Removed #{Spell[n.to_i].name} (#{n}) from your protected spells")
		UserVars.severspells.delete(n.to_i)
	end

	def self.up(n)
		if !UserVars.severspells.include?(n.to_i)
			Lich::Messaging.monsterbold("#{Spell[n.to_i]} (#{n}) is not configured as one of your sever spells")
			return
		elsif UserVars.severspells.index(n.to_i) == 0
			Lich::Messaging.monsterbold("#{Spell[n.to_i]} (#{n}) is already your top priority spell")
			return
		end

		i = UserVars.severspells.index(n.to_i)
		UserVars.severspells.insert((i - 1), UserVars.severspells.delete_at(i))

		Lich::Messaging.msg("speech", "Moved #{Spell[n.to_i].name} (#{n}) up in priority")
	end

	def self.set(spells)
		toAdd = []
		spells.each{|n|
			if n.include?(',')
				toAdd |= n.split(',').map{|i| i.strip.to_i}
			else
				toAdd |= [n.to_i]
			end
		}

		if UserVars.severspells.length > 0
			Lich::Messaging.msg("speech", "Resetting protected spell list...")
			UserVars.severspells = []
		end

		Lich::Messaging.msg("speech", "Adding new spells...")
		toAdd.each{|s|
			self.add(s)
		}

		Lich::Messaging.msg("speech", "")
		self.list
	end

	def self.setLimit(limit)
		UserVars.severlimit = limit.to_i
		Lich::Messaging.msg("speech", "Updated sever limit to #{limit}")
	end

	def self.list
		if UserVars.severspells.length === 0
			Lich::Messaging.msg("speech", "No spells spells registered to keep for spell sever! Use ;severance add {spellnumber}")
			return
		end

		Lich::Messaging.msg("speech", "You are currently preserving the following spells, in order of priority:")
		UserVars.severspells.each_with_index{|n, i|
			Lich::Messaging.msg("speech", "#{i} | #{Spell[n].name} (#{n})")
		}

		Lich::Messaging.monsterbold("!! Important! Only the first #{self.limit()} protected spells will be kept in the event that you have more than #{self.limit()} of them active! !!")
	end

	def self.go(settings)
		@quiet = settings[:quiet]
		@limit = settings[:limit]

		if settings[:daemon]
			Lich::Messaging.msg("speech", "Running in daemon mode, rechecking every #{settings[:delay]} seconds")
			loop do
				self.sever
				sleep(settings[:delay].to_i)
			end
		end

    self.sever
	end

	def self.sever
		if UserVars.severspells.length === 0
			Lich::Messaging.msg("speech", "No spells spells registered to keep for spell sever! Use ;severance add {spellnumber}")
			return
		elsif severable.length <= self.limit() 
			self.send("You're safely under the limit for Spell Sever")
			return
		end

		Lich::Messaging.msg("speech", "You're over the Spell Sever limit by #{severable.length - self.limit()} spells...")

		severable.each_with_index {|s, i| 
			next if i < self.limit()
			Lich::Messaging.monsterbold("Removing #{s.num}")
			fput("stop #{s.num}")
		}
	end

	def self.check
		severable = Severance.severable

		if severable.length <= self.limit() 
			Lich::Messaging.msg("speech", "You're safely under the limit for Spell Sever")
			return
		end

		Lich::Messaging.msg("speech", "You're over the Spell Sever limit by #{severable.length - self.limit()} spells...")
		Lich::Messaging.msg("speech", "The following spells will be preserved:")

		severable[0..(self.limit() - 1)]
			.each{|s|
				Lich::Messaging.msg("speech", "- #{s.name} (#{s.num})")
			}

		Lich::Messaging.monsterbold("The following spells are at risk of removal by this script!")
		severable[self.limit()..-1]
			.each{|s|
				dash = UserVars.severspells.include?(s.num.to_i) ? '~' : '-'
				Lich::Messaging.monsterbold("#{dash} #{s.name} (#{s.num})")
			}
	end

	# Spell is identified as a group effect that is not subject to Spell Sever
	def self._isGroupSpell(spell)
		GROUPSPELLS.include?(spell.num.to_i)
	end

	# Spell is identified as being a short duration buff by number and existence of the cooldown
	def self._isShortDurationGroupSpell(spell)
		SHORTGROUPSPELLS.include?(spell.num.to_i) &&
			Effects::Cooldowns.active?(spell.name)
	end

	def self._isArcane(spell)
		spell.circle.to_i > 16
	end

	# Ignore spells > 50 (cooldowns etc. from spell-list.xml)
	def self._isLichCustomEffect(spell)
		spell.num - (spell.circle.to_i * 100) > 50
	end

	def self.severable
		return Spell.active.select {|s| 
			!s.known? && 
			!_isGroupSpell(s) &&
			!_isShortDurationGroupSpell(s) &&
			!_isArcane(s) &&
			!_isLichCustomEffect(s)
		}
		.sort_by {|s|
			UserVars.severspells.include?(s.num.to_i) ? 
				UserVars.severspells.index(s.num.to_i) : 
				s.num.to_i + 1000
		}
	end

	def self.send(message)
		Lich::Messaging.msg("bold", message) unless @quiet
	end

	def self.help
	    Lich::Messaging.msg("bold", "")
	    Lich::Messaging.msg("bold", " Severance by Maodan")
	    Lich::Messaging.msg("bold", "")
	    Lich::Messaging.msg("bold", " #{$lich_char}#{$scriptname} is a script to remove spells at risk for Spell Sever zones, with options to configure a list of spells to preserve.")
	    Lich::Messaging.msg("bold", "")
	    Lich::Messaging.msg("info",   " Basic usage: #{$lich_char}#{$scriptname}")
	    Lich::Messaging.msg("info",   "    This will check your active spells and *STOP* any that are at risk for Spell Sever,")
	    Lich::Messaging.msg("info",   "    except those configured for preservation via #{$lich_char}#{$scriptname} add")
			Lich::Messaging.msg("info",   "    In addition, certain classes of spells will be ignored, including group spells,")
			Lich::Messaging.msg("info",   "    short duration buffs, and arcane/miscelaneous circles that are not subject to Spell Sever.")
	    Lich::Messaging.msg("info",   "")
	    Lich::Messaging.msg("info",   " Advanced usage: #{$lich_char}#{$scriptname} \{--daemon\} \{--quiet\} \{--delay=5\} \{--limit=2\}")
	    Lich::Messaging.msg("info",   "    --daemon mode will keep the script active in the background, continuing to check")
	    Lich::Messaging.msg("info",   "    every few seconds (5 by default, override with --delay=X)")
	    Lich::Messaging.msg("info",   "    It is recommended that you also utilize --quiet to tone down the output when using")
	    Lich::Messaging.msg("info",   "    this mode.")
			Lich::Messaging.msg("info",   "    --limit will override the default sever limit of 2 spells at runtime.")
	    Lich::Messaging.msg("info",   "")
	    Lich::Messaging.msg("speech",  " Extra commands:")
	    Lich::Messaging.msg("info",   "  help                                     shows this help message")
	    Lich::Messaging.msg("info",   "  check                                    checks your current spells for Spell Sever risk")
	    Lich::Messaging.msg("info",   "  list                                     lists preserved spells")
	    Lich::Messaging.msg("info",   "  add or + {spellnum}                      adds a spell to your preserve list")
	    Lich::Messaging.msg("speech",  "  - Ex: #{$lich_char}#{$scriptname} add 215 OR #{$lich_char}#{$scriptname} + 215")
	    Lich::Messaging.msg("info",   "  rem or - {spellnum}                      removes a spell from your preserve list")
	    Lich::Messaging.msg("speech",  "  - Ex: #{$lich_char}#{$scriptname} rem 215 OR #{$lich_char}#{$scriptname} - 215")
	    Lich::Messaging.msg("info",   "  up {spellnum}                            moves a spell up in priority on your preserve list")
	    Lich::Messaging.msg("speech",  "  - Ex: #{$lich_char}#{$scriptname} up 215")
	    Lich::Messaging.msg("info",   "  set {spell1 spell2 ...spellN}            REPLACES your entire preserve list with the values provided")
	    Lich::Messaging.msg("speech",  "  - Ex: #{$lich_char}#{$scriptname} set 215 211 509 OR #{$lich_char}#{$scriptname} set 215,211,509")
			Lich::Messaging.msg("info",   "  setlimit {limit}                         Sets your default severance limit (currently set to #{UserVars.severlimit})")
	    Lich::Messaging.msg("speech",  "  - Ex: #{$lich_char}#{$scriptname} setlimit 1")
	end
end

settings = {
	:quiet => false,
	:daemon => false,
	:delay => 5,
	:limit => nil,
}

Script.current.vars.each_with_index{|var, i|
	if var =~ /--quiet/
		settings[:quiet] = true
		Script.current.vars.delete_at(i)
	end

	if var =~ /--daemon/
		settings[:daemon] = true
		Script.current.vars.delete_at(i)
	end

	if var =~ /--delay=(\d+)/
		settings[:delay] = $1.to_i
		Script.current.vars.delete_at(i)
	end

	if var =~ /--limit=(\d+)/
		settings[:limit] = $1.to_i
		Script.current.vars.delete_at(i)
	end
}

if Script.current.vars[1].nil?
	Severance.go(settings)
elsif Script.current.vars[1].downcase.eql?('help')
	Severance.help
elsif Script.current.vars[1].downcase.eql?('list')
	Severance.list
elsif Script.current.vars[1].downcase.eql?('check')
	Severance.check
elsif Script.current.vars[1].downcase.eql?('add') || Script.current.vars[1].downcase.eql?('+')
	Severance.add(Script.current.vars[2])
elsif Script.current.vars[1].downcase.eql?('rem') || Script.current.vars[1].downcase.eql?('-')
	Severance.rem(Script.current.vars[2])
elsif Script.current.vars[1].downcase.eql?('up')
	Severance.up(Script.current.vars[2])
elsif Script.current.vars[1].downcase.eql?('set')
	Severance.set(Script.current.vars[2..-1])
elsif Script.current.vars[1].downcase.eql?('setlimit') && Script.current.vars[2] =~ /^\d+$/
	Severance.setLimit(Script.current.vars[2])
else
	Lich::Messaging.msg("bold", "Unknown parameter '#{Script.current.vars[1]}'")
end