# egticker.lic
# @lich_version 5.0.0
# QUIET
# Start with ;egticker and stop with ;kill egticker.

while (line = get)
  confirmation = line.match(/To confirm that you want this service,\s+TICKLE\s+(.+?)\s+within the next 30 second(?:\(s\)|s)?(?=[.!?\s]|\z)/i)
  next unless confirmation

  noun = confirmation[1].split.last
  next unless noun && noun.match?(/\A[[:alpha:]][[:alnum:]'-]*\z/)
  fput "tickle #{noun}"
end
