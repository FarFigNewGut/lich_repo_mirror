=begin
 ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~

 Title:  PurifyC
 Based on: PurifyL
 Version: 2.2
 Original Date: May 28, 2018
 PurifyC Update: November 4, 2026

 Original Author: Leafiara
 Previous versions by: Aethor, Gibreficul, Shaelun
 PurifyC modifications by: Tenaro

 How to use:
 Have both hands empty and a supply of gems in your unsung container.
 Wear or hold the containers you want PurifyC to use, then start the
 script with:

 ;PurifyC

 On first run, or if a configured container is missing, the container
 setup window opens automatically. You can also open it manually with:

 ;PurifyC setup

 Details:
 Purifies gems in your unsung container, then puts orbs in your orb
 container and non-orbs in your sung container.
 Optional sings to orbs to get a value and places them in a seperate container

 Container settings are configured through the setup window.

 Original PurifyL update history:
 - March 29, 2025: Removed a couple of gems that can't purify to at least 3k
 - March 29, 2025: Cleaned up some redundancies
 - May 7, 2025: Fix for more accurate regex
 - October 7, 2025: Added Sailor's Grief gems
 - January 17, 2026: Update for modern Ruby syntax
 - January 29, 2026: Added new Hive gems post-loot changes

 PurifyC update history:
 - November 4, 2026: 
  -Added a graphical container setup window
  -Added automatic setup when a configured container is missing or unavailable
  -Added manual setup access through ;PurifyC setup.
  -Added PurifyL first-run defaults and exact container selection.
  -Added and option to sing to orbs to get value, this can be skipped
    -You will need a fourth bag to use this option

 If you find any missing gem nouns, let me know! I aim to list all gems
 for completeness, whether they're to be purified or not.

 ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~
=end


VERSION = "2.2"

AUTHOR = "Tenaro"

silence_me


# Open setup explicitly with `;purifyc setup`, or automatically
# when a configured container is missing or no longer available.
require 'json'

UserVars.PurifyC ||= {}
purifyc_setup_manual = script.vars[0].to_s =~ /^setup$/i

# Load saved settings before checking container availability.
purifyc_settings_file = "PurifyC Settings.json"
purifyc_character_settings = {}

begin
  if File.exist?(purifyc_settings_file)
    purifyc_saved_settings = JSON.parse(File.read(purifyc_settings_file))
    purifyc_character_settings = purifyc_saved_settings[checkname] || {}
  end
rescue StandardError => e
  respond "PurifyC: Couldn't read #{purifyc_settings_file}: #{e.message}"
  exit
end

# Preserve the original PurifyL container choices as first-run defaults.
# A saved PurifyC JSON setting takes precedence, followed by existing PurifyC
# UserVars, then the corresponding PurifyL UserVar.
UserVars.PurifyL ||= {}
purifyc_container_keys = %w[unsungcontainer sungcontainer orbcontainer valuedorbcontainer]
purifyc_container_keys.each do |key|
  saved_value = purifyc_character_settings[key]
  legacy_value = UserVars.PurifyC[key.to_sym]
  purifyl_value = UserVars.PurifyL[key.to_sym]
  value = saved_value || legacy_value || purifyl_value
  UserVars.PurifyC[key.to_sym] = value unless value.nil? || value.to_s.empty?

  saved_name = purifyc_character_settings["#{key}_name"]
  legacy_name = UserVars.PurifyC["#{key}_name".to_sym]
  UserVars.PurifyC["#{key}_name".to_sym] = saved_name || legacy_name unless (saved_name || legacy_name).to_s.empty?
end

purifyc_do_not_sing =
  purifyc_character_settings["do_not_sing_to_value_orbs"] == true
purifyc_minimum_orb_value =
  purifyc_character_settings.fetch("minimum_orb_value", 5000).to_i
UserVars.PurifyC[:do_not_sing_to_value_orbs] = purifyc_do_not_sing
UserVars.PurifyC[:minimum_orb_value] = purifyc_minimum_orb_value

purifyc_container_xml = Lich::Util.quiet_command_xml(
  "inv containers",
  /You are wearing|You are holding/
)

purifyc_container_tag = %r{<a exist=(?:'|")(?<id>.*?)(?:'|") noun=(?:'|")(?<noun>.*?)(?:'|")>(?<name>.*?)</a>}
purifyc_containers = []
purifyc_container_xml.each do |line|
  line.scan(purifyc_container_tag) do |id, noun, name|
    purifyc_containers << { "id" => id, "noun" => noun, "name" => name }
  end
end
purifyc_containers.uniq! { |container| container["id"] }
purifyc_containers.sort_by! { |container| container["name"].downcase }
# If an older noun-only PurifyC setting is ambiguous, prefer the original
# PurifyL noun when it identifies exactly one currently worn container.
purifyc_container_keys.each do |key|
  selected_name = UserVars.PurifyC["#{key}_name".to_sym]
  selected_noun = UserVars.PurifyC[key.to_sym]
  noun_matches = purifyc_containers.select { |container| container["noun"] == selected_noun }
  if (selected_name.nil? || selected_name.to_s.empty?) && noun_matches.length != 1
    purifyl_noun = UserVars.PurifyL[key.to_sym]
    purifyl_matches = purifyc_containers.select { |container| container["noun"] == purifyl_noun }
    if purifyl_matches.length == 1
      UserVars.PurifyC[key.to_sym] = purifyl_noun
    end
  end
end

# Resolve a selected container by its full displayed name. Only use the old
# noun-only setting when that noun identifies exactly one worn container.
purifyc_resolve_container = lambda do |key|
  selected_name = UserVars.PurifyC["#{key}_name".to_sym]
  if selected_name && !selected_name.to_s.empty?
    purifyc_containers.find { |container| container["name"] == selected_name }
  else
    selected_noun = UserVars.PurifyC[key]
    matches = purifyc_containers.select { |container| container["noun"] == selected_noun }
    matches.length == 1 ? matches.first : nil
  end
end

purifyc_required_containers = [:unsungcontainer, :sungcontainer, :orbcontainer]
purifyc_required_containers << :valuedorbcontainer unless purifyc_do_not_sing
purifyc_settings_missing = purifyc_required_containers.any? do |key|
  purifyc_resolve_container.call(key).nil?
end

if purifyc_setup_manual || purifyc_settings_missing
  require 'json'

  containers = purifyc_containers

  if containers.empty?
    respond "PurifyC setup: I couldn't find any worn containers. Wear or hold your containers and try again."
    exit
  end

  settings_file = purifyc_settings_file
  character = checkname
  settings = {}

  begin
    settings = JSON.parse(File.read(settings_file)) if File.exist?(settings_file)
  rescue StandardError => e
    respond "PurifyC setup: Couldn't read #{settings_file}: #{e.message}"
    exit
  end

  character_settings = settings[character] || {}
  fields = [
    ["Unsung gems container", "unsungcontainer"],
    ["Sung gems container", "sungcontainer"],
    ["Orb gems container", "orbcontainer"]
  ]

  window = nil
  menus = {}
  status_label = nil
  finished = false
  settings_saved = false

  Gtk.queue do
    window = Gtk::Window.new(:toplevel)
    window.set_title("PurifyC - Container Setup")
    window.set_default_size(470, 300)
    window.set_border_width(12)

    grid = Gtk::Grid.new
    grid.row_spacing = 8
    grid.column_spacing = 12
    window.add(grid)

    grid.attach(Gtk::Label.new("Choose the containers PurifyC should use."), 0, 0, 2, 1)

    fields.each_with_index do |(label_text, key), row|
      label = Gtk::Label.new(label_text)
      label.halign = Gtk::Align::START
      grid.attach(label, 0, row + 1, 1, 1)

      menu = Gtk::ComboBoxText.new
      menu.append_text("-- choose container --")
      containers.each { |container| menu.append_text(container["name"]) }

      selected_name = character_settings["#{key}_name"] || UserVars.PurifyC&.[]("#{key}_name".to_sym)
      selected_noun = character_settings[key] || UserVars.PurifyC&.[](key.to_sym)
      selected_index = containers.index { |container| container["name"] == selected_name } if selected_name
      if selected_index.nil?
        noun_matches = containers.each_index.select { |index| containers[index]["noun"] == selected_noun }
        selected_index = noun_matches.first if noun_matches.length == 1
      end
      if selected_index.nil?
        purifyl_noun = UserVars.PurifyL&.[](key.to_sym)
        noun_matches = containers.each_index.select { |index| containers[index]["noun"] == purifyl_noun }
        selected_index = noun_matches.first if noun_matches.length == 1
      end
      menu.active = selected_index ? selected_index + 1 : 0

      menus[key] = menu
      grid.attach(menu, 1, row + 1, 1, 1)
    end

    do_not_sing_check = Gtk::CheckButton.new("Do not sing to value orbs")
    do_not_sing_check.active = character_settings["do_not_sing_to_value_orbs"] == true
    grid.attach(do_not_sing_check, 0, 4, 2, 1)

    valuedorb_label = Gtk::Label.new("Valued orbs container")
    valuedorb_label.halign = Gtk::Align::START
    grid.attach(valuedorb_label, 0, 5, 1, 1)

    valuedorb_menu = Gtk::ComboBoxText.new
    valuedorb_menu.append_text("-- choose container --")
    containers.each { |container| valuedorb_menu.append_text(container["name"]) }
    selected_valuedorb_name = character_settings["valuedorbcontainer_name"] || UserVars.PurifyC&.[](:valuedorbcontainer_name)
    selected_valuedorb_noun = character_settings["valuedorbcontainer"] || UserVars.PurifyC&.[](:valuedorbcontainer)
    selected_valuedorb_index = containers.index { |container| container["name"] == selected_valuedorb_name } if selected_valuedorb_name
    if selected_valuedorb_index.nil?
      noun_matches = containers.each_index.select { |index| containers[index]["noun"] == selected_valuedorb_noun }
      selected_valuedorb_index = noun_matches.first if noun_matches.length == 1
    end
    valuedorb_menu.active = selected_valuedorb_index ? selected_valuedorb_index + 1 : 0
    menus["valuedorbcontainer"] = valuedorb_menu
    grid.attach(valuedorb_menu, 1, 5, 1, 1)

    minimum_value_label = Gtk::Label.new("Minimum orb value (silver)")
    minimum_value_label.halign = Gtk::Align::START
    grid.attach(minimum_value_label, 0, 6, 1, 1)

    minimum_value_entry = Gtk::Entry.new
    minimum_value_entry.text = character_settings.fetch("minimum_orb_value", 5000).to_s
    minimum_value_entry.width_chars = 12
    grid.attach(minimum_value_entry, 1, 6, 1, 1)

    update_value_controls = lambda do
      if do_not_sing_check.active?
        valuedorb_label.hide
        valuedorb_menu.hide
        minimum_value_entry.sensitive = false
        minimum_value_label.sensitive = false
      else
        valuedorb_label.show
        valuedorb_menu.show
        minimum_value_entry.sensitive = true
        minimum_value_label.sensitive = true
      end
    end
    do_not_sing_check.signal_connect("toggled") { update_value_controls.call }

    status_label = Gtk::Label.new("")
    status_label.halign = Gtk::Align::START
    grid.attach(status_label, 0, 7, 2, 1)

    button_box = Gtk::ButtonBox.new(:horizontal)
    button_box.layout = :end
    save_button = Gtk::Button.new(label: "Save")
    cancel_button = Gtk::Button.new(label: "Cancel")
    button_box.add(save_button)
    button_box.add(cancel_button)
    grid.attach(button_box, 0, 8, 2, 1)

    save_button.signal_connect("clicked") do
      chosen = {}
      missing = false
      do_not_sing = do_not_sing_check.active?

      fields.each do |label_text, key|
        selected_name = menus[key].active_text
        if selected_name.nil? || selected_name == "-- choose container --"
          status_label.text = "Choose a container for each required field before saving."
          missing = true
          break
        end

        container = containers[menus[key].active - 1]
        if container
          chosen[key] = container["noun"]
          chosen["#{key}_name"] = container["name"]
        end
      end

      unless missing || do_not_sing
        selected_name = valuedorb_menu.active_text
        if selected_name.nil? || selected_name == "-- choose container --"
          status_label.text = "Choose a Valued Orbs container, or check 'Do not sing to value orbs'."
          missing = true
        else
          container = containers[valuedorb_menu.active - 1]
          if container
            chosen["valuedorbcontainer"] = container["noun"]
            chosen["valuedorbcontainer_name"] = container["name"]
          end
        end
      end

      threshold_text = minimum_value_entry.text.to_s.strip
      unless do_not_sing
        unless threshold_text.match?(/\A\d+\z/)
          status_label.text = "Minimum orb value must be a whole number of 0 or greater."
          missing = true
        end
      end

      next if missing

      settings[character] ||= {}
      settings[character]["valuedorbcontainer"] ||= UserVars.PurifyC[:valuedorbcontainer]
      settings[character].merge!(chosen)
      settings[character]["do_not_sing_to_value_orbs"] = do_not_sing
      settings[character]["minimum_orb_value"] = do_not_sing ? character_settings.fetch("minimum_orb_value", 5000).to_i : threshold_text.to_i

      begin
        File.open(settings_file, "w") do |file|
          file.write(JSON.pretty_generate(settings))
        end

        UserVars.PurifyC ||= {}
        chosen.each { |key, noun| UserVars.PurifyC[key.to_sym] = noun }
        UserVars.PurifyC[:valuedorbcontainer] = settings[character]["valuedorbcontainer"] if settings[character]["valuedorbcontainer"]
        UserVars.PurifyC[:do_not_sing_to_value_orbs] = do_not_sing
        UserVars.PurifyC[:minimum_orb_value] = settings[character]["minimum_orb_value"]

        settings_saved = true
        status_label.text = "Saved container settings."
        respond "PurifyC setup: Saved container settings."
        window.destroy
      rescue StandardError => e
        status_label.text = "Couldn't save settings: #{e.message}"
        respond "PurifyC setup: Couldn't save settings: #{e.message}"
      end
    end

    cancel_button.signal_connect("clicked") { window.destroy }
    window.signal_connect("destroy") { finished = true }
    window.show_all
    update_value_controls.call
  end

  sleep 0.1 until finished

  # Continue only when required settings point to available containers.
  # The Valued Orbs container is optional when valuation is disabled.
  purifyc_required_after_setup = [:unsungcontainer, :sungcontainer, :orbcontainer]
  purifyc_required_after_setup << :valuedorbcontainer unless UserVars.PurifyC[:do_not_sing_to_value_orbs]

  exit unless purifyc_required_after_setup.all? do |key|
    name = UserVars.PurifyC["#{key}_name".to_sym]
    noun = UserVars.PurifyC[key]
    containers.any? do |container|
      (name && container["name"] == name) ||
        (name.to_s.empty? && container["noun"] == noun && containers.count { |item| item["noun"] == noun } == 1)
    end
  end
end

# Refresh preferences after the setup window may have changed them.
purifyc_do_not_sing = UserVars.PurifyC[:do_not_sing_to_value_orbs] == true
purifyc_minimum_orb_value = UserVars.PurifyC[:minimum_orb_value].to_i



# Move a held gem directly into the exact selected container. `_drag` uses
# the unique item and container IDs from the inventory XML, avoiding noun
# collisions when multiple worn containers share a noun (for example, bags).
purifyc_move_to_container = lambda do |gem_id, key|
  container = purifyc_resolve_container.call(key)
  unless container
    respond "PurifyC: Couldn't uniquely identify the #{key.to_s.sub('container', '')} container. Run ;PurifyC setup."
    exit
  end
  put "_drag ##{gem_id} ##{container['id']}"
  matchtimeout(1, "You put")
end


# These are gem nouns that you think it's worth your time and mana to purify! I drew the line at gems that can be purified to 3k or more at the top end, but if you'd like a higher cutoff, you can take them out and paste them in the $notwastingtime list down below. You could also just delete them, but I like keeping them for reference--a level 15 bard might not be able to get enough extra value out of a mid-range gem, but a level 50 bard might, so it'll be good to be able to add it back in later.

  $gemnouns = ["aetherstone", "alexandrite", "auboraline", "azel", "beryl", "blazestar", "bloodjewel", "bluerock", "caederine", "carnelian", "cinderstone", "despanal", "diamond", "doomstone", "duskjewel", "emerald", "eostone", "faenor", "feystone", "firedrop", "firestone", "galena", "goldstone", "heliotrope", "jacinth", "lichstone", "mekret", "nightstone", "pearl", "prehnite", "rhimar", "riftshard", "riftstone", "rivertear", "roestone", "rosepar", "sandruby", "saewehna", "shadowglass", "smoldereye", "snowstone", "spherine", "tanzanite", "thunderstone", "waterweb", "wraithaline", "wyrdshard"]



# These are individual gem names that you think it's worth your time and mana to purify, but can't be put in $gemnouns because either:
# 1 - Their nouns conflict with other things, e.g. if you put "fang" in $gemnouns instead of "gold fang" and "platinum fang" here, you'd be trying to purify direbear fangs and faeroth fangs.
# 2 - They share nouns with other gems that you might not consider worth it (e.g. moonglae opals are much higher value than white opals) or that are definitely not worth it (e.g. a tangerine wulfenite crystal is good, but a quartz crystal isn't).

  $gemnames = ["aster opal", "azure salt sapphire", "black opal", "black-cored emerald orb", "blackened feystone core", "blue-green glacial core", "blue green lagoon opal", "blue sapphire", "blue shimmarglin sapphire", "blue sky opal", "blue-veined volcanic obsidian", "bluish black razern-bloom", "brilliant lilac glimaerstone", "brilliant wyrm's-tooth amethyst", "cabochon of striated grape jade", "carmine cinnabar stone", "cerulean glimaerstone", "chameleon agate", "chunk of pale blue ice stone", "chunk of snowy white ice stone", "cloud opal", "cloudy alexandrite shard", "craggy orb of coppery blue azurite", "cushion-cut vibrant carmine ruby", "dark blue tempest stone", "dark-forked ivory dendritic agate", "dark ivory aranthium-bloom", "deep blue mermaid's-tear sapphire", "deep blue tide's-heart opal", "dragon's-fang quartz", "dragon's-tear ruby", "dragonfire opal", "dragonsbreath sapphire", "dragonseye sapphire", "droplet of honey amber", "ebon winternight sapphire", "ebon-washed carnelian red ammolite", "faceted teal sapphire", "faceted wyrm's heart sapphire", "fiery gold-flecked sunstone", "flickering snowfire ruby", "fossilized bessho lizard spur", "fragment of pale green-blue aquamarine", "gilt-sprouted icy white quartz", "golden glimaerstone", "golden moonstone", "golden rhimar-bloom", "gold-haloed pale dragonseye sapphire", "gold-suffused resinous honey opal", "green alexandrite stone", "grooved burnt orange sea star", "indigo-cored stormy violet amethyst", "lavender shimmarglin sapphire", "lilac-crested molten gold ametrine", "misty grey deathstone", "misty silver crystalline spiral", "moonglae opal", "nearly black pomegranate red garnet", "nival everfrost shard", "niveous snowdrop", "opaline moonstone", "pale green moonstone", "pastel-hued wintersbite pearl", "peach glimaerstone", "pear-shaped greenish yellow citrine", "pearly grey ice stone", "Phoen's eye topaz", "piece of dusky blue sapphire", "pink sapphire", "plum-flecked ruby zoisite", "polished dark blue amber", "prismatic rose gold fire agate", "purple black thunderhead opal", "rainbow-swept royal blue moonstone", "raw chunk of titian orange sunstone", "red-clouded black moonstone", "red starstone", "red sunstone", "rich cerulean mermaid's-tear sapphire", "rough-edged matte white soulstone", "rutilated frostbite amethyst", "sanguine pyrope teardrop", "scaled indigo ammolite", "scintillating fiery scarlet starstone", "shadow amethyst", "shard of rainbow quartz", "silver-cored vortex stone", "silvery moonstone", "smooth dolphin stone disc", "sparkling ice blue dreamstone", "sylvarraend ruby", "tangerine wulfenite crystal", "thin blade of verdant sea glass", "tigerfang crystal", "twilight blue azurite crystal", "ultramarine glimaerstone", "uncut ruby", "uncut sunstone", "variegated mushroom-hued jasper", "verdigris Kai Toka tradebar", "versicolored sharp crimson crystal", "vinous gigasblood ruby", "vivid cobalt blue spinel", "volcanic blue larimar stone", "white sunstone", "yellow sunstone"]



# These are gem nouns or names that you *don't* think it's worth your time and mana to purify! This list has no functional purpose in the script, but is here for my reference so I know which gems are excluded. It's helpful in case, for example, a future gem is created that has one of these nouns and I need to know that I shouldn't include every gem of that noun, but only that specific gem.

  $notwastingtime = ["agate", "amber", "ambergris", "amethyst", "azurite", "bauxite", "bismuth", "bloodstone", "brilliant red firebird stone", "carbuncle", "chalcedony", "chrysoberyl", "chrysoprase", "coral", "cordierite", "crescent", "dark grey dreamstone fragment", "deathstone", "diopside", "dreamstone", "faenor\-bloom", "feldspar", "fluorite", "fragment", "garnet", "^gem$", "geode", "glacialite", "gypsum", "heliodor", "hematite", "hoarstone", "honey-washed violet water sapphire", "hyacinth", "idocrase", "ivory", "jade", "jasper", "labradorite", "lapis", "lazuli", "obsidian", "onyx", "peridot", "pyrite", "quartz", "quartz crystal", "rainbowed ammolite shard", "rainbow-hued oval abalone shell", "rock crystal", "rust-speckled ivory slipper shell", "scarlet-shot lustrous black bloodstone", "spinel", "^stone$", "starstone", "teardrop of murky sanguine ruby", "tooth", "topaz", "tourmaline", "turquoise", "tusk", "viridine", "wyrmwood", "zircon"]



# Initializing variables and stuff

    time_total = 0
    mytime = Time.now.to_f
    mygems = []
    purified = 0
    orbs = 0
    shattered = 0
  alreadyorbs = 0
  deferredorbs = 0
  smoothercount = 0 

  UserVars.PurifyC ||= {}
  UserVars.PurifyC[:unsungcontainer] = nil if UserVars.PurifyC[:unsungcontainer].nil?
  UserVars.PurifyC[:sungcontainer] = nil if UserVars.PurifyC[:sungcontainer].nil?
  UserVars.PurifyC[:orbcontainer] = nil if UserVars.PurifyC[:orbcontainer].nil?

if script.vars[1] =~ /transfer/
    GameObj.inv.find{|cont| cont.noun =~ /#{script.vars[2]}/}.contents.each{|gem|
if gem.noun =~ /#{$gemnouns.join('|')}/ || gem.name =~ /#{$gemnames.join('|')}/
    put "_drag ##{gem.id} ##{GameObj.inv.find{|targ| targ.noun =~ /#{script.vars[3]}/}.id}" unless gem.name =~ /smooth stone/
    matchtimeout(1, "You put")
    end
    }
    exit
    end

script.vars[0]
pct_boost = 0
totalboost = 0



# The actual script

unless GameObj.right_hand.name =~ /empty/i
    echo "Ya got something in your right hand. Please put that away and then run this script again!"
    exit
    end
    purifyc_unsung = purifyc_resolve_container.call(:unsungcontainer)
    unless purifyc_unsung
      respond "PurifyC: Couldn't uniquely identify your Unsung container. Run ;PurifyC setup."
      exit
    end
    unsung_inventory = GameObj.inv.find { |cont| cont.id.to_s == purifyc_unsung["id"].to_s }
    unless unsung_inventory
      respond "PurifyC: Couldn't access #{purifyc_unsung['name']}. Run ;PurifyC setup."
      exit
    end
    unsung_inventory.contents.each{|gem| mygems.push(gem.id.to_i) if (gem.noun =~ /#{$gemnouns.join('|')}/ || gem.name =~ /#{$gemnames.join('|')}/) && gem.name !~ /smooth stone/}
    howmany = mygems.length

if howmany == 0
  respond "Looks like you have no gems of high value to purify!\n
  (You might have some gems, but by default this script is set up to only purify gems that a capped bard would generally be able to take to at least 3000 silvers if it doesn't turn into an orb along the way. Alternatively, if you're sure you have gems worth purifying, try LOOKing in your #{UserVars.PurifyC[:unsungcontainer]} and then run this script again.)"
  exit
  end

mygems.each{|gem|
if purified + shattered + orbs + alreadyorbs + deferredorbs == 0
    respond "~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~"
    respond "~ PurifyL by Leafiara"
    respond "~ Looks like there are #{mygems.length} gems in your #{UserVars.PurifyC[:unsungcontainer]}!"
  respond "~ (Not counting junky ones we're not purifying.)"
    respond "~ Purified gems will go into your #{UserVars.PurifyC[:sungcontainer]}..."
    respond "~ And orbs will go into your #{UserVars.PurifyC[:orbcontainer]}!"
    respond "~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~"
    start_time = Time.now.to_i
    else
    runtime = Time.now.to_f - mytime
    remaining = howmany - (purified + shattered + orbs + alreadyorbs + deferredorbs)
    avgtime = runtime.round / (purified + shattered + orbs + alreadyorbs + deferredorbs)
    respond "~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~"
    respond "~ PurifyL by Leafiara"
    respond "~ Purified #{purified}, orbified #{orbs}, shattered #{shattered}!"
  respond "~ Sorted #{alreadyorbs} gems that were already orbs."
    respond "~ #{remaining} gems to go!"
    respond "~ Total time #{ "%02d" %((runtime)/60)}:#{ "%02d" % ((runtime)%60)} / #{avgtime} seconds per gem"
    respond "~ Estimated time left: #{ "%02d" %((remaining * avgtime)/60)}:#{ "%02d" % ((remaining * avgtime)%60)}"
  respond "~ #{totalboost}% Total Boost / #{totalboost/(purified + orbs)}% Average Boost" if (purified + orbs) > 0
    respond "~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~"
    end
    waitrt?
    waitcastrt?
    orbed = false
  preorbed = false
    result = "false"
unless Wounds.rhand == 3
    put "_drag ##{gem} right"
    else
    unless GameObj.inv.any? { |item| item.noun =~ /^case$/i }
      respond "PurifyC: No case found for eherbs. Stopping before picking up another gem."
      exit
    end

    start_script("eherbs")
    wait_while{running? "eherbs"}

    if Wounds.rhand == 3
      respond "PurifyC: eherbs did not heal your right hand. Stopping before picking up another gem."
      exit
    end

    put "_drag ##{gem} right"
    end
until result.to_s =~ /what were you|cannot|must be holding|shatter|song misfires/i
    wait_until('Need some mana!') { mana(20) }
    wait_while{muckled?}
    wait_while('Need some healing!') {
      [Wounds.head, Scars.head, Wounds.nerves, Scars.nerves].max >= 2 ||
      ([Wounds.rightHand, Wounds.rightArm, Scars.rightHand, Scars.rightArm].max >= 2 &&
       [Wounds.leftHand, Wounds.leftArm, Scars.leftHand, Scars.leftArm].max >= 2) ||
      [Wounds.rightArm, Wounds.leftArm, Wounds.rightHand, Wounds.leftHand,
       Scars.rightArm, Scars.leftArm, Scars.rightHand, Scars.leftHand].max == 3
    }
    waitrt?
    waitcastrt?
    loop do
      put "prep 1004"
      prep_result = matchwait("Your spellsong is ready.", /Wait (\d+) sec/)

      break if prep_result =~ /Your spellsong is ready/

      wait_seconds = prep_result[/Wait (\d+) sec/, 1].to_i
      sleep(wait_seconds + 1)
    end

    put "sing ##{gem}"
    result = matchwait("turn as the very essence","gem becomes more perfect","shatter","crack","must be holding","what were you","appearing smoother and more pure", "improves somewhat","cannot be", "Sing Roundtime",'Spell Hindrance',"song misfires")



# Below is the message if a gem was already an orb before you sang to it.

if result.to_s =~ /As the gem resonates in response to your voice, you sense that it cannot be purified any further./
  preorbed = "true"
  break



# Below is the message when a gem gets to the maximum value as you sing to it.
# Note: If a gem was already at the max value--in other words, if a very experienced bard had *already* sung to it--then you'd get the same message as the one for already-orbed gems and it would end up in your orbcontainer even if it's not an orb. So be careful to put only unsung gems into your unsungcontainer.

elsif result.to_s =~ /As the gem vibrates slightly in your hand, you sense that it cannot be purified any further./
  purified += 1
    break



# Below are the other messages you can get as you purify.
# It shows the value increase of the gem as you go, with a once-per-gem reminder that
# the percentage is based on max value, not starting value. e.g. if you have a diamond
# that starts at 5000 and maxes at 10000, that would show as a 50% bonus... if you can
# get that far, anyway. A lower level bard who could only get it to 7500 before
# the script stops it as being too risky would see a 25% bonus.

elsif result.to_s =~ /more perfect|what were you|improves somewhat|crack|shatter|must be holding|smoother and more pure in color/
  if result.to_s =~ /smoother and more pure in color/
    smoothercount += 1
  end
  pct_boost += 5
  totalboost += 5
  if pct_boost == 5
    respond " Bonus: +#{pct_boost}% of max value"
  else
    respond " Bonus: +#{pct_boost}%"
  end
  nextline = get
    (orbed = true;break) if nextline =~ /very essence/          # Turned a gem into an orb.



# When a gem shatters, subtract its value increase back out of the total boost in the summary.

if result.to_s =~ /shatter/
  respond " ...if it hadn't blown up, anyway. So close!"
  shattered += 1
  totalboost -= pct_boost
  pct_boost = 0
  wait_while{stunned?}
  break



# It stops singing if you aren't holding a gem or run into a message that means it's
# very risky to keep singing. Usually this means stopping on the second instance of
# the "smoother and more pure in color" message (or, if you only see it once and then
# move on to the "improves somewhat" message, then it'll stop on that), at least until
# high level when you'll instead reach the maximum value message and never see those.

elsif result.to_s =~ /smoother and more pure in color/
  if smoothercount == 2
    purified += 1
    pct_boost = 0
    smoothercount = 0
    break
  end

elsif result.to_s =~ /crack|improves somewhat|What were|cannot|must be holding|song misfires/
    purified += 1
  pct_boost = 0
  smoothercount = 0
    break
    end
    end
    end

if orbed || preorbed
  orb_destination_key = :orbcontainer
  orb_value = nil

  unless purifyc_do_not_sing
    # Newly created and already-existing orbs are valued before being sorted.
    # matchwait already received the gem's Sing Roundtime message.
    # Only wait if that roundtime is still active; do not wait for a new one.
    waitrt?
    waitcastrt?
    fput "speak bard"
    value_result = dothistimeout(
      "loresing #{GameObj.right_hand.noun}, please tell me and tell me true,;What might be your own value?",
      5,
      /^.*?In your best estimation|simply resonates with what you previously learned/
    )
    # The value response precedes the loresing roundtime notification.
    # Wait for that explicit notification, then wait out any active roundtime.
    waitforre(/Roundtime: \d+ sec/i)
    waitrt?
    waitcastrt?
    fput "speak common"

    value_match = value_result.to_s.match(/worth about ([\d,]+) silvers/i)
    if value_match
      orb_value = value_match[1].delete(",").to_i
      if orb_value >= purifyc_minimum_orb_value
        orb_destination_key = :valuedorbcontainer
        respond "PurifyC: Orb valued at #{orb_value} silvers; sending it to Valued Orbs."
      else
        respond "PurifyC: Orb valued at #{orb_value} silvers; sending it to the regular orb container."
      end
    else
      # We cannot safely classify an orb if its value is not returned.
      # Leave it in Unsung so a later run can retry after another orb is sung.
      purifyc_move_to_container.call(gem, :unsungcontainer)
      deferredorbs += 1
      respond "PurifyC: Couldn't determine the value of orb ##{gem}; returned it to Unsung for later valuation."
      pct_boost = 0
      smoothercount = 0
      next
    end
  end

  purifyc_move_to_container.call(gem, orb_destination_key)
  if preorbed
    alreadyorbs += 1
  else
    orbs += 1
  end
  pct_boost = 0
  smoothercount = 0
end

unless GameObj.right_hand.name =~ /empty/i
    purifyc_move_to_container.call(gem, :sungcontainer)
  pct_boost = 0
  smoothercount = 0
    end
    gems = howmany - (purified + shattered + orbs + alreadyorbs + deferredorbs)
    wait_while{stunned?}
    }

if purified + shattered + orbs + alreadyorbs + deferredorbs == 0
    respond "~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~"
    else
    runtime = Time.now.to_f - mytime
    remaining = howmany - (purified + shattered + orbs + alreadyorbs + deferredorbs)
    avgtime = runtime.round / (purified + shattered + orbs + alreadyorbs + deferredorbs)
    respond "~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~"
    respond "~ PurifyL by Leafiara"
    respond "~ Purified #{purified}, orbified #{orbs}, shattered #{shattered}!"
        respond "~ Sorted #{alreadyorbs} gems that were already orbs."
        respond "~ Returned #{deferredorbs} orbs to Unsung for later valuation." if deferredorbs > 0
    respond "~ Total time #{ "%02d" %((runtime)/60)}:#{ "%02d" % ((runtime)%60)} / #{avgtime} seconds per gem"
    respond "~ Estimated time left: #{ "%02d" %((remaining * avgtime)/60)}:#{ "%02d" % ((remaining * avgtime)%60)}"
        respond "~ Total Boost / Average Boost: #{totalboost}% / #{totalboost/(purified + orbs)}%" if (purified + orbs) > 0
    respond "~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~"
end