def commander_main_deck; commander_go("main_deck"); end
def commander_mid_deck; commander_go("mid_deck"); end
def commander_forward_deck; commander_go("forward_deck"); end
def commander_bow; commander_go("bow"); end
def commander_crows_nest; commander_go("crows_nest"); end
def commander_forward_crows_nest; commander_go("forward_crows_nest"); end
def commander_social_room; commander_go("social_room"); end
def commander_mess_hall; commander_go("mess_hall"); end
def commander_crew_quarters; commander_go("crew_quarters"); end
def commander_helm; commander_go("helm"); end
def commander_captains_quarters; commander_go("captains_quarters"); end
def commander_enemy_cargo_hold; commander_go("enemy_cargo_hold"); end
def commander_enemy_main_deck; commander_go("enemy_main_deck"); end
def commander_enemy_mid_deck; commander_go("enemy_mid_deck"); end
def commander_enemy_forward_deck; commander_go("enemy_forward_deck"); end
def commander_enemy_bow; commander_go("enemy_bow"); end
def commander_enemy_crows_nest; commander_go("enemy_crows_nest"); end
def commander_enemy_forward_crows_nest; commander_go("enemy_forward_crows_nest"); end
