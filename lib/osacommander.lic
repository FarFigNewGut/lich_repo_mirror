# Background progress display for the current Task Complete round, used while the commander is busy
# with its own casting (sever spellup). Only prints; commander_task_complete still does the waiting.
def commander_start_task_progress
	commander_stop_task_progress
	crew = (@commander_data["crewsize"] || []).map(&:to_s).map(&:strip).reject(&:empty?).uniq
	return if crew.empty?
	commander_start_task_listener unless (@task_listener && @task_listener.running? rescue false)
	since = $osa_task_round_start || Time.now
	@task_progress = Thread.new do
		begin
			last_count = -1
			last_note = Time.now
			loop do
				reported = ($osa_task_log || []).dup.select { |_name, at| at >= since }.map(&:first)
				done = crew.select { |c| reported.any? { |r| r.casecmp?(c) } }
				missing = crew - done
				if missing.empty?
					respond "--- OSACommander: All #{crew.size} crew reported Task Complete (finishing your own casting)."
					break
				end
				if done.size != last_count || (Time.now - last_note) >= 60
					respond "--- OSACommander: Task Complete #{done.size}/#{crew.size} - waiting on: #{missing.join(', ')}"
					last_count = done.size
					last_note = Time.now
				end
				sleep 1
			end
		rescue StandardError
			nil
		end
	end
end

def commander_stop_task_progress
	@task_progress.kill if @task_progress&.alive?
	@task_progress = nil
end

def commander_task_complete(timeout = 600)
	# Waits until every mustered crew member has reported "Task Complete" for the
	# current round (anything since the commander's last crew-channel order).
	# Shows a running count and who is still outstanding; on timeout, names who
	# never reported and moves on.
	@taskcount = []
	crew = (@commander_data["crewsize"] || []).map(&:to_s).map(&:strip).reject(&:empty?).uniq
	return if crew.empty?
	commander_start_task_listener unless (@task_listener && @task_listener.running? rescue false)
	since = $osa_task_round_start || Time.now
	deadline = Time.now + timeout
	last_count = -1
	last_note = Time.now
	loop do
		reported = ($osa_task_log || []).dup.select { |_name, at| at >= since }.map(&:first)
		done = crew.select { |c| reported.any? { |r| r.casecmp?(c) } }
		@taskcount = done
		missing = crew - done
		break if missing.empty?
		if done.size != last_count || (Time.now - last_note) >= 60
			respond "--- OSACommander: Task Complete #{done.size}/#{crew.size} - waiting on: #{missing.join(', ')}"
			last_count = done.size
			last_note = Time.now
		end
		if Time.now >= deadline
			respond "--- OSACommander: Timed out waiting on: #{missing.join(', ')} - continuing."
			break
		end
		sleep 1
	end
	respond "--- OSACommander: All #{crew.size} crew reported Task Complete." if (crew - @taskcount).empty?
end

def commander_crew_request
		result = matchtimeout 5, /^\[Private\]-GSIV:(.*)\: \"Crewman (.*), Requesting Permission To Come Aboard!"$/
		if result.to_s =~ /^\[Private\]-GSIV:(.*)\: \"Crewman (.*), Requesting Permission To Come Aboard!"$/
			@commander_request.push($2)
			commander_crew_request
		else
			respond "
			No Remaining Crew Requests, Moving On!
			"
		end
end

def format_number(number)
  num_groups = number.to_s.chars.to_a.reverse.each_slice(3)
  num_groups.map(&:join).join(',').reverse
end

def end_of_encounter
	commander_save_to_commander("endbalancecommas", format_number(@commander_data["endbalance"]))
	respond ""
	respond ""
	respond ""
	respond ""
	_respond "\<preset id=\"thought\"\>" + "                             --------------------------------------------------------------------------------" + "\<\/preset\>"
	respond ""
	_respond "\<preset id=\"speech\"\>" + "                                      --* Encounter With #{@commander_data["enemyship"].split(/\b/).map(&:capitalize).join} *--" + "\<\/preset\>"
	respond ""                            
	_respond "\<preset id=\"speech\"\>" + "                                          Time To Board Vessel:" + "\<\/preset\>"
	_respond "\<preset id=\"monster\"\>" + "                                          #{@commander_data["boardingtime"].as_time}" + "\<\/preset\>"
	respond ""  
	_respond "\<preset id=\"speech\"\>" + "                                          Time To Clear Vessel:" + "\<\/preset\>"
	_respond "\<preset id=\"monster\"\>" + "                                          #{@commander_data["clearing_time"]}" + "\<\/preset\>"
	respond ""  
	_respond "\<preset id=\"speech\"\>" + "                                          Total Enemies Defeated This Vessel:" + "\<\/preset\>"
	_respond "\<preset id=\"monster\"\>" + "                                          #{@commander_data["enemy_count"].gsub(/"|\[|\]/, '')}" + "\<\/preset\>"
	respond ""  
	_respond "\<preset id=\"speech\"\>" + "                                          Total Boxes Found This Vessel:" + "\<\/preset\>"
	_respond "\<preset id=\"monster\"\>" + "                                          #{@commander_data["amount_of_boxes"]}" + "\<\/preset\>"
	respond ""  
	_respond "\<preset id=\"speech\"\>" + "                                          Total Silver Made This Vessel:" + "\<\/preset\>"
	_respond "\<preset id=\"monster\"\>" + "                                          #{@commander_data["endbalancecommas"]}" + "\<\/preset\>"
	respond ""
	_respond "\<preset id=\"thought\"\>" + "                             --------------------------------------------------------------------------------" + "\<\/preset\>"
	respond ""
	respond ""
	respond ""
	respond ""
	commander_lnet_crew("Encounter With #{@commander_data["enemyship"].split(/\b/).map(&:capitalize).join} | Time To Board Vessel: #{@commander_data["boardingtime"].as_time}| Time To Clear Vessel: #{@commander_data["clearing_time"]} | Total Enemies Defeated This Vessel: #{@commander_data["enemy_count"].gsub(/"|\[|\]/, '')} | Total Boxes Found This Vessel: #{@commander_data["amount_of_boxes"]} | Total Silver Made This Vessel: #{@commander_data["endbalancecommas"]}")
	if @commander_data["stowaways"]
		fput "whisper ooc group Encounter With #{@commander_data["enemyship"].split(/\b/).map(&:capitalize).join}| Time To Board Vessel: #{@commander_data["boardingtime"].as_time} | Time To Clear Vessel: #{@commander_data["clearing_time"]} | Total Enemies Defeated This Vessel: #{@commander_data["enemy_count"].gsub(/"|\[|\]/, '')} | Total Boxes Found This Vessel: #{@commander_data["amount_of_boxes"]} | Total Silver Made This Vessel: #{@commander_data["endbalancecommas"]}"
	end
end

def enemy_counter
	result = dothistimeout "listen", 10, /\[Enemies Left\: (.*)\]/
		if result.to_s =~ /Enemies Left: (.*)\]/
			commander_save_to_commander("enemy_count", $1)
		end
end

def commander_check_crew
	if @commander_data["crewsize"].nil?
		respond ""
		respond "                       You Must First Perform A Muster                                                               "
		respond ""
	end
	@crew_check = (@crew_check + 1)
	if (@crew_check + (@commander_data["crewsize"] || []).count) > @commander_data["commander_max_crew"]
		LNet.send_message(attr = { 'type' => 'private', 'to' => @crew_request }, "Permission Denied, Im Sorry Shipmate But The Ship Is Too Full Right Now. Try Again Later!")
	else
		LNet.send_message(attr = { 'type' => 'private', 'to' => @crew_request }, "Permission Granted, Come Aboard!")
		# @crew_request is one name (String); only add it if it isn't already on the roster
		commander_save_to_commander("crewsize", @crew_request, push: true) unless (@commander_data["crewsize"] || []).include?(@crew_request)
	end
end

def commander_final_approach
	wait_while {GameObj.pcs.any? {|s| s.status =~ /sitting|^lying|prone|stunned/}}
	commander_main_deck
	waitfor /collide against your/
	wait_while {GameObj.pcs.any? {|s| s.status =~ /sitting|^lying|prone|stunned/}}
	commander_enemy_main_deck
	commander_save_to_commander("helmsman_endtime", Time.now)
	commander_save_to_commander("boardingtime", ((@commander_data["helmsman_endtime"] - @commander_data["helmsman_start_time"])/60))
	commander_checkpoint(3)
	return
end

def commander_final_approach_2
	wait_while {GameObj.pcs.any? {|s| s.status =~ /sitting|^lying|prone|stunned/}}
	commander_enemy_main_deck
	commander_save_to_commander("helmsman_endtime", Time.now)
	commander_save_to_commander("boardingtime", ((@commander_data["helmsman_endtime"] - @commander_data["helmsman_start_time"])/60))
	commander_checkpoint(3)
	return
end

def commander_navigator
	waitrt?
	waitcastrt?
	wait_until { !checkstunned }
	wait_until { !checkwebbed }
	wait_until { !checkbound }
	wait_while { running?("ecure") }
	pause 0.1

	if !commander_osacrew_data['boarding']
		commander_sunk_ship
		return
	end

	$nav_result = nil

	nav_thread = Thread.new do
		loop do
			line = get
			case line
			when /of boarding range!|ways out!|sailing closer!/
				# Ship moved -- turn the wheel again and keep watching
				waitrt?
				wait_while { running?("ecure") }
				fput "turn wheel ship"
			when /\.\.\.wait/
				# Still in RT -- wait and try again
				waitrt?
				wait_while { running?("ecure") }
				fput "turn wheel ship"
			when /in boarding range!|You will be upon the/
				$nav_result = :boarding
				break
			when /Tenebrous Cauldron.  Victory is yours!/
				$nav_result = :victory
				break
			when /The sides of the (.*) collide against your (.*)!/
				$nav_result = :collision
				break
			end
		end
	end

	# Initial turn to get things started
	waitrt?
	wait_while { running?("ecure") }
	fput "turn wheel ship"

	nav_thread.join

	case $nav_result
	when :boarding
		if @warning == true
			commander_final_approach
		end
		waitrt?
		@warning = true
		fput "group open"
		fput "turn wheel ship"
		waitrt?
		pause 0.5
		commander_lnet_crew("Thirty second warning, drop what yer doing and prepare for battle. Here they come!")
		fput "yell Thirty second warning, drop what yer doing and prepare for battle. Here they come!"
		commander_final_approach
	when :victory
		commander_sunk_ship
	when :collision
		commander_final_approach_2
	end
end

def commander_helmsman
	waitrt?
	wait_until { !checkstunned }
	wait_until { !checkwebbed }
	wait_until { !checkbound }
	wait_while { running?("ecure") }

	$helm_result = nil
	$helm_warning_text = nil

	helm_thread = Thread.new do
		loop do
			line = get
			case line
			when /in boarding range!|You will be upon the/
				# Capture the line for the warning then signal
				$helm_result = :boarding
				break
			when /Tenebrous Cauldron.  Victory is yours!/
				$helm_result = :victory
				break
			when /The sides of the (.*) collide against your (.*)!/
				$helm_result = :collision
				break
			end
		end
	end

	# Single turn -- helmsman does not turn again, just waits for outcome
	fput "turn wheel ship"

	helm_thread.join

	case $helm_result
	when :boarding
		if @warning == true
			commander_final_approach
		end
		waitrt?
		pause 0.5
		commander_lnet_crew("Thirty second warning, drop what yer doing and prepare for battle. Here they come!")
		fput "yell Thirty second warning, drop what yer doing and prepare for battle. Here they come!"
		@warning = true
		fput "group open"
		commander_final_approach
	when :victory
		commander_sunk_ship
	when :collision
		commander_final_approach_2
	end
end

def commander_check_role
	commander_checkpoint(2)
	commander_save_to_crew("boarding", true)
	commander_save_to_crew("sunk_ship", false, push: false)
	if @commander_data["cannon_engage"]
		commander_kick_capstan
	elsif @commander_data["helmsman_enabled"]
		commander_navigator
	else
		commander_helmsman
	end
end

def commander_check_balance
	balance_line = Lich::Util.quiet_command("bank acc", /You currently have the following amounts on deposit\:/, end_pattern = /(You currently have (.*) inter-town bank transfer option available.)/, include_end = false ,timeout = 3, silent = true)
	if balance_line.to_s =~ /Total\: ([0-9,]+)/
		@bankbalance = $1.to_s.delete(',').to_i
	end
end

def commander_determine_group_members
	Group.members.map(&:noun)
end

def commander_apply_support
	@supportlist.each do |n, t|
		@support_rec = n
		@support_type = t
		if @support_type == "Blessing"
			waitrt?
			fput "armor blessing #{@support_rec}"
			pause 5
		elsif @support_type == "Reinforcement"
			waitrt?
			fput "armor reinforcement #{@support_rec}"
			pause 5
		elsif @support_type == "Support"
			waitrt?
			fput "armor support #{@support_rec}"
			pause 5
		elsif @support_type == "Casting"
			waitrt?
			fput "armor casting #{@support_rec}"
			pause 5
		elsif @support_type == "Evasion"
			waitrt?
			fput "armor evasion #{@support_rec}"
			pause 5
		elsif @support_type == "Fluidity"
			waitrt?
			fput "armor fluidity #{@support_rec}"
			pause 5
		elsif @support_type == "Stealth"
			waitrt?
			fput "armor stealth #{@support_rec}"
			pause 5
		end
	end
end

def commander_self_armor_spec
	if commander_osacrew_data["my_armor_spec"].to_s.downcase.include? "blessing"
		pause 5
		waitrt?
		fput "armor blessing"
	elsif commander_osacrew_data["my_armor_spec"].to_s.downcase.include? "reinforcement"
		pause 5
		waitrt?
		fput "armor reinforcement"
	elsif commander_osacrew_data["my_armor_spec"].to_s.downcase.include? "support"
		pause 5
		waitrt?
		fput "armor support"
	elsif commander_osacrew_data["my_armor_spec"].to_s.downcase.include? "casting"
		pause 5
		waitrt?
		fput "armor casting"
	elsif commander_osacrew_data["my_armor_spec"].to_s.downcase.include? "evasion"
		pause 5
		waitrt?
		fput "armor evasion"
	elsif commander_osacrew_data["my_armor_spec"].to_s.downcase.include? "fluidity"
		pause 5
		waitrt?
		fput "armor fluidity"
	elsif commander_osacrew_data["my_armor_spec"].to_s.downcase.include? "stealth"
		pause 5
		waitrt?
		fput "armor stealth"
	end
end

def commander_need_mana
	while running?("ewaggle")
		if percentmana < 15
			commander_lnet_crew($mana_message)
			wait_until { percentmana > 15 }
		else
			pause 2
		end
	end
end

def commander_mana_share
	$mana_type = Array.new
	$mana_type.clear
	$my_mana_type = Array.new
	$my_mana_type.clear
	if (Skills.smc >= 24)
		$mana_type.push ("Spiritual")
		$my_mana_type.push ("Spiritual")
	end
	if (Skills.mmc >= 24)
		$mana_type.push ("Mental")
		$my_mana_type.push ("Mental")
	end
	if (Skills.emc >= 24)
		$mana_type.push ("Elemental")
		$my_mana_type.push ("Elemental")
	end
	if $mana_type.count > 1
		$new_mana_type = $mana_type.last()
		$mana_type.delete "#{$mana_type.last()}"
		$mana_type.push ("or #{$new_mana_type}")
	end
	if $mana_type.count.to_i == 3
		$mana_message = "I Need #{$mana_type[0]}, #{$mana_type[1]} #{$mana_type[2]} Mana!"
	end
	if $mana_type.count.to_i == 2
		$mana_message = "I Need #{$mana_type[0]} #{$mana_type[1]} Mana!"
	end
	if $mana_type.count.to_i == 1
		$mana_message = "I Need #{$mana_type[0]} Mana!"
	end
end

# Average minutes left on your active spells (0 with none). Used to decide on an end-of-encounter
# spellup. It used to store this in a copy of osacrew's settings that was thrown away, so the check
# kept reading an old saved value and never called a spellup.
def spellup_time_left
	times = Spell.active.map(&:timeleft).select { |t| t > 0.1 && t <= 250 }
	times.empty? ? 0 : (times.sum / times.size)
end

def commander_spellup_needed?
	threshold_min = commander_osacrew_data["mana_spellup_threshold"].to_i
	threshold_min = 60 if threshold_min == 0
	# timeleft returns minutes in Lich
	times = Spell.active.map(&:timeleft).select { |t| t > 0.1 && t <= 250 }
	avg_time = times.empty? ? 0 : (times.sum / times.count)
	avg_time < threshold_min
end

def commander_spell_up
	commander_call_muster
	if !commander_osacrew_data["medicalofficer"].empty? && @commander_data["use_bread"]
		commander_lnet_crew("Let Us Break Bread Together!")
		waitfor /^\[#{commander_osacrew_data["crew"]}\]-(GSIV:#{commander_osacrew_data["medicalofficer"]}|You): "Bread Is Served!\"/
		pause 1
	end
	commander_lnet_crew("Does Anyone Need Armor Adjustments?")
	pause 4
	commander_lnet_crew("Spells")
	spellup = Lich::Util.quiet_command("mana", /Normal/, end_pattern = /You have used the MANA SPELLUP ability (.*) out of (.*) times for today\./, include_end = true ,timeout = 3, silent = true)
	if spellup.to_s =~ /You have used the MANA SPELLUP ability (.*) out of (.*) times for today\./
		if ($2 == "0") or ($1 == $2 )
			$mana_spellup = false
		else
			$mana_spellup = true
		end
		if !commander_osacrew_data["mana_spellup"]
			$mana_spellup = false
		end
		if $mana_spellup
			if commander_spellup_needed?
				waitrt?
				waitcastrt?
				pause 0.2
				fput "mana spellup"
				pause 3
			end
		end
	end
	spellup
	if commander_osacrew_data["groupspellup"]
		commander_determine_group_members
		if commander_osacrew_data["selfspellup"]
			start_script("ewaggle", ['--start-at=181', '--stop-at=240', Group.members.map(&:noun), 'self'])
		else
			start_script("ewaggle", ['--start-at=181', '--stop-at=240', Group.members.map(&:noun)])
		end
	else
		if commander_osacrew_data["selfspellup"]
			start_script("ewaggle", ['--start-at=181', '--stop-at=240', 'self'])
		end
	end
	@mana_watcher.kill if @mana_watcher&.alive?
	@mana_watcher = Thread.new { commander_need_mana }
	commander_task_complete
	wait_until { !running?("ewaggle") }
	@mana_watcher.kill if @mana_watcher&.alive?
	if commander_osacrew_data["armor_specs"]
		commander_apply_support
		@supportlist.clear
	end
	commander_self_armor_spec
	pause 5
	fput "group open"
	(@commander_data["crewsize"] || []).each{|pc|;fput "hold #{pc}"}
	commander_lnet_crew("Spell Up Completed")
end

def check_for_muster
	$call_muster = false
	(@commander_data["crewsize"] || []).each do |n|
		$call_muster = true if !checkpcs.include? (n)
	end
	checkpcs.each do |n|
		$call_muster = true if !(@commander_data["crewsize"] || []).include? (n)
	end
end

def commander_call_muster
	check_for_muster
	if $call_muster
		commander_save_to_commander("crewsize", [])
		commander_lnet_crew("Quarters! All Hands To Quarters For Muster, Instruction and Inspection!")
		commander_take_muster
		commander_save_to_commander("crewsize", (@commander_data["crewsize"] || []).flatten.uniq)
		crew_count = (@commander_data["crewsize"] || []).count
			crew_count = (@commander_data["crewsize"] || []).count
		commander_lnet_crew("All Present And Accounted For! We Have #{crew_count} Crew Onboard For A Total Compliment of #{crew_count + 1} Personnel!")
		pause 3
	else
		respond ""
		respond " ------ Crewsize Matches All Crew Present, Skipping Muster! ------ "
		respond ""
	end
end

def commander_take_muster
	muster = matchtimeout 6, /Crewman (.*) Reporting For Duty Captain/
	if muster.to_s =~ /Crewman (.*) Reporting For Duty Captain/
		commander_save_to_commander("crewsize", $1.dup, push: true)
		commander_take_muster
	end
end

def commander_begin_balance
	commander_check_balance
	commander_save_to_commander("beginbalance", @bankbalance)
end

def commander_after_balance
	commander_check_balance
	commander_save_to_commander("afterbalance", @bankbalance)
end

def commander_held_box
	return GameObj.right_hand if GameObj.right_hand.id && GameObj.right_hand.type =~ /box/
	return GameObj.left_hand if GameObj.left_hand.id && GameObj.left_hand.type =~ /box/
	nil
end

def commander_held_box_count
	count = 0
	count += 1 if GameObj.right_hand.id && GameObj.right_hand.type =~ /box/
	count += 1 if GameObj.left_hand.id && GameObj.left_hand.type =~ /box/
	count
end

def commander_drop_extra_held_box_for_pool
	return unless commander_held_box_count > 1
	# Keep both boxes in hand. Dropping one here can make the commander return
	# to the ship, pick the same box back up, and loop forever when storage is full.
end

def commander_drop_held_boxes
	fput "drop right" if GameObj.right_hand.id && GameObj.right_hand.type =~ /box/
	fput "drop left" if GameObj.left_hand.id && GameObj.left_hand.type =~ /box/
end

def commander_pool_held_box
	start_script("go2", [commander_osacrew_data["gangplank"]])
	wait_while { running?("go2") }
	start_script("eloot", ['pool'])
	wait_while { running?("eloot") }
	pause 0.5
	commander_main_deck
end

def commander_deliver_held_boxes
	if @commander_data["use_security_officer"]
		start_script("go2", [@commander_data["security_officer_location"]])
		wait_while { running?("go2") }
		give_boxes_to_security_officer
		pause 0.5
		commander_main_deck
	elsif @commander_data["no_script_picking"]
		commander_captains_quarters
		commander_drop_held_boxes
		pause 0.5
		commander_main_deck
	else
		commander_pool_held_box
	end
end

def commander_prepare_held_boxes_for_pool
	return false unless commander_held_box
	unless defined?(Disk) && Disk.mine
		commander_drop_extra_held_box_for_pool
		return :pool
	end

	disk = GameObj[Disk.mine.id]
	unless disk
		commander_drop_extra_held_box_for_pool
		return :pool
	end

	open_result = dothistimeout "open ##{disk.id}", 3, /already open|You open|What were you referring to/
	if open_result.to_s =~ /What were you referring to/
		commander_drop_extra_held_box_for_pool
		return :pool
	end

	stored_any = false
	while (box = commander_held_box)
		put_result = dothistimeout "put ##{box.id} in ##{disk.id}", 5, /You put|won't fit|can't put|closed|What were you referring to|Get what|You need a free hand/
		if put_result.to_s =~ /You put/
			stored_any = true
			pause 0.2
		else
			commander_drop_extra_held_box_for_pool
			return :pool
		end
	end

	stored_any ? :disk : false
end

def commander_left_hand
	if GameObj.left_hand.id.nil?
		return
	else
		if GameObj.left_hand.type =~ /box/
			fput "drop left"
		else 
			multifput "store left", "stow left"
		end
	end
end

def commander_right_hand
	if GameObj.right_hand.id.nil?
		return
	else
		if GameObj.right_hand.type =~ /box/
			fput "drop right"
		else 
			multifput "store right", "stow right"
		end
	end
end

def commander_sell_loot
	# The silver total is measured from this balance, so a resume must not take it again
	unless commander_checkpoint_step?("balance_taken")
		commander_begin_balance
		commander_checkpoint_step("balance_taken")
	end
	if @commander_data["use_security_officer"]
		start_script("eloot", ['start'])
		wait_while { running?("eloot") }
		LNet.send_message(attr = { 'type' => 'private', 'to' => @commander_data["securityofficer"] }, "Your Services Are Requested At #{@commander_data["security_officer_location"]} Crewman")
	end
	commander_have_boxes
	#ELoot.data.settings[:loot_types].push("gem", "skin", "alchemy", "armor", "clothing", "collectible", "jewelry", "uncommon", "scroll", "reagent", "weapon", "wand", "valuable", "lockpick", "magic")
	start_script("go2", [commander_osacrew_data["gangplank"]])
	wait_while { running?("go2") }
	start_script("eloot", ['sell'])
	wait_while { running?("eloot") }
	commander_lnet_crew("Crew, Sell Your Loot!")
	commander_crew_share
end

def give_boxes_to_security_officer
	wait_until { checkpcs.include? (@commander_data["securityofficer"]) }
	commander_drop_held_boxes
	#start_script('foreach', ['box', 'in', 'inventory;get', 'item;move', 'item', 'to', 'ground;sleep', '0.5'])
	#wait_while { running?("foreach") }
	ELoot.find_boxes.each do | box_in_inventory |
		multifput "get ##{box_in_inventory.id}", "drop ##{box_in_inventory.id}"
	end
	if @done_with_sec_off
		LNet.send_message(attr = { 'type' => 'private', 'to' => @commander_data["securityofficer"] }, "That's All Of Them!")
		waitfor /^\[Private\]-GSIV:#{@commander_data["securityofficer"]}\: \"All Set, Captain!"/
		commander_loot_boxes
		commander_loot_silvers
		commander_loot_room
		waitrt?
		pause 0.5
	end
end

def commander_loot_silvers
	boxes = GameObj.loot.find_all{|item| item.type =~ /box/}
	if @commander_data["fossil_charm"]
		boxes.each{|box|
		getsilver = dothistimeout "point my #{@commander_data["charm_adjective"]} charm at ##{box.id}", 5, /^You summon a swarm of/
			if getsilver.to_s =~ /^You summon a swarm of/
				waitrt?
				pause 0.5
			end
		}
	else
		boxes.each{|box| 
		getsilver = dothistimeout "get coins in ##{box.id}", 5, /^You gather the/
			if getsilver.to_s =~ /^You gather the/
				waitrt?
				pause 0.5
			end
		}
	end
end

def commander_loot_boxes
	boxes = GameObj.loot.find_all{|item| item.type =~ /box/}
	boxes.each{|box|
	fput "open ##{box.id}"
	lootmybox = dothistimeout "loot ##{box.id}", 5, /^You search through (.*) and note some interesting treasure but are unable to take any of it|There is no loot inside the (.*)|You search through (.*) and remove (.*) which you promptly stow away./
		if lootmybox.to_s =~ /^You search through (.*) and note some interesting treasure but are unable to take any of it/
			waitrt?
			pause 0.5
			start_script("eloot", ['sell'])
			wait_while { running?("eloot") }
			fput "loot ##{box.id}"
		elsif lootmybox.to_s =~ /^There is no loot inside the (.*)|You search through (.*) and remove (.*) which you promptly stow away./
			waitrt?
			pause 0.5
		end
	}
end	

def commander_loot_room
	loottheroom = dothistimeout "loot room", 3, /^In a desperate attempt to pick up and stow as much treasure as you can manage|With a discerning eye, you gather up what treasure|There is no loot/
	if loottheroom.to_s =~ /^In a desperate attempt to pick up and stow as much treasure as you can manage/
		start_script("eloot")
		wait_while { running?("eloot") }
		start_script("go2", [commander_osacrew_data["gangplank"]])
		wait_while { running?("go2") }
		start_script("eloot", ['sell'])
		wait_while { running?("eloot") }
		commander_main_deck
		commander_loot_room
	elsif loottheroom.to_s =~ /^With a discerning eye, you gather up what treasure|There is no loot/
		waitrt?
		pause 0.5
	end
end

def commander_yes_boxes
	commander_right_hand
	commander_left_hand
	pause 0.5
	if @commander_data["use_security_officer"]
		start_script("go2", [@commander_data["security_officer_location"]])
		wait_while { running?("go2") }
		give_boxes_to_security_officer
	end
	if @commander_data["no_script_picking"]
		commander_captains_quarters
		ELoot.find_boxes.each do | box_in_inventory |
			multifput "get ##{box_in_inventory.id}", "drop ##{box_in_inventory.id}"
		end
	else
		start_script("go2", [commander_osacrew_data["gangplank"]])
		wait_while { running?("go2") }
		start_script("eloot", ['pool'])
		wait_while { running?("eloot") }
	end
	pause 0.5
	commander_main_deck
end

def commander_have_boxes
	result = dothistimeout "loot room", 3, /There is no loot|no space in which to stow it|no room to stow either|leaving .* in your hand/
	if result.to_s =~ /There is no loot/
		@done_with_sec_off = true
	elsif result.to_s =~ /no space in which to stow it|no room to stow either|leaving .* in your hand/
		case commander_prepare_held_boxes_for_pool
		when :disk
			commander_have_boxes
			return
		when :pool
			commander_deliver_held_boxes
			commander_have_boxes
			return
		end
	end
		commander_yes_boxes
	if !@done_with_sec_off
		commander_have_boxes
	end
end

def commander_stowaways
	if @commander_data["stowaways"]
	fput "whisper group #{$whisper_message}"
	#fput "whisper group Please let me know when you're all set"
		echo "
		--------------------------------------------~~~~~~|       Waiting For Party Members           |~~~~~~~~-------------------------------------------------------
                                                  		|                                           |
		--------------------------------------------~~~~~~|  Please Type \"\Yes\"\ When Ready To Continue |~~~~~~~~-------------------------------------------------------
		"
		waitfor "A good positive attitude never hurts."
	end
end

def commander_give_permission
	@commander_request = Array.new
	@crew_check = 0
	commander_crew_request
	if !@commander_request.nil?
		@commander_request.each do |n|
			@crew_request = n
			commander_check_crew
		end
		@commander_request.clear
	end
end

def commander_go_to_handler
	start_script("go2", ["handler"])
	wait_while { running?("go2") }
	if Room.current.location == "Kraken's Fall"
		start_script("go2", ['28950'])
		wait_while { running?("go2") }
	end
end

def commander_check_task
checktask = Lich::Util.quiet_command("osa task", /OSA TASK/, end_pattern = /Expedites your current task cooldown./, include_end = false ,timeout = 3, silent = true)
    if checktask.to_s =~ /You do not currently have a task from the Sea Hag's Roost/
			commander_go_to_handler
			fput "take board"
			pause 0.5
			commander_captains_quarters
			return
	elsif checktask.to_s =~ /You should return to the Sea Hag's Roost to report your success/
		if saturated?
			if commander_osacrew_data["uselte"]
				fput "boost long"
			end
			wait_until {!saturated?}
		end
		commander_go_to_handler
		fput "turn board"
		pause 0.5
		fput "take board"
		pause 0.5
		commander_captains_quarters
		return
	elsif checktask.to_s =~ /Abandons your current task/
		return
	else
		return
    end
end

def commander_crew_share
	commander_checkpoint(9)
	commander_captains_quarters
	commander_task_complete
	commander_check_task
	if (@commander_data["crewsize"] || []).count != 0
		wait_until {(@commander_data["crewsize"] || []).sort! & checkpcs.sort! == (@commander_data["crewsize"] || []).sort!}
		commander_lnet_crew("Task Time!")
		commander_task_complete
	end
	GameObj.pcs.each{|pc|;fput "hold ##{pc.id}"}
	$whisper_message = "We are about to turn in the salvage crate and share loot, please let me know when you are ready to go."
	commander_stowaways
	start_script("go2", ['handler'])
	wait_while { running?("go2") }
	$whisper_message = "Turn in any completed tasks and get a new one. Then, let me know when you're all set."
	commander_stowaways
	fput "stow all"
	commander_start_handler
	start_script("go2", ['bank'])
	wait_while { running?("go2") }
	commander_lnet_crew("Silvers")
	pause 2
	fput "depo all"
	if (@commander_data["share_silvers"])
		if @commander_data["fwi"]
			@bank_room = Room.current
			fput "turn my #{Vars.mapdb_fwi_trinket}"
			wait_until {Room.current != @bank_room}
			start_script("go2", ['bank'])
			wait_while { running?("go2") }
			fput "depo all"
			commander_after_balance
			commander_save_to_commander("endbalance", (@commander_data["afterbalance"].to_i - @commander_data["beginbalance"].to_i)) 
			if @commander_data["endbalance"] > 0
				fput "withdraw #{@commander_data["endbalance"]} silver"
				pause 0.5
			end
			@bank_room = Room.current
			fput "turn my #{Vars.mapdb_fwi_trinket}"
			wait_until {Room.current != @bank_room}
			fput "share all"
			commander_checkpoint(10) # silver is shared; a resume must never share it again
			pause 0.5
			@bank_room = Room.current
			fput "turn my #{Vars.mapdb_fwi_trinket}"
			wait_until {Room.current != @bank_room}
			start_script("go2", ['bank'])
			wait_while { running?("go2") }
			fput "depo all"
			@bank_room = Room.current
			fput "turn my #{Vars.mapdb_fwi_trinket}"
			wait_until {Room.current != @bank_room}
			$whisper_message = "Please deposit your silvers and let me know when you're all set"
			commander_stowaways
		end
		if !@commander_data["fwi"]
			fput "depo all"
			commander_after_balance
			commander_save_to_commander("endbalance", (@commander_data["afterbalance"].to_i - @commander_data["beginbalance"].to_i))
			if @commander_data["endbalance"] > 0
				fput "withdraw #{@commander_data["endbalance"]} silver"
				pause 0.5
			end
			fput "share all"
			commander_checkpoint(10) # silver is shared; a resume must never share it again
			pause 0.5
			fput "depo all"
			$whisper_message = "Please desposit your silvers and let me know when you're all set"
			commander_stowaways
		end
		commander_lnet_crew("Deposit")
	else
		fput "depo all"
		commander_after_balance
		commander_save_to_commander("endbalance", (@commander_data["afterbalance"].to_i - @commander_data["beginbalance"].to_i))
	end
	commander_crew_share_finish
end

# Spellup for a captain sailing without crew: mana spellup (if Use Mana Spellup is on and it is
# needed), then ewaggle on yourself, then your own armor specialization.
def commander_solo_spell_up
	if commander_osacrew_data["mana_spellup"]
		spellup = Lich::Util.quiet_command("mana", /Normal/, /You have used the MANA SPELLUP ability (.*) out of (.*) times for today\./, true, 3, true)
		if spellup.to_s =~ /You have used the MANA SPELLUP ability (.*) out of (.*) times for today\./
			used, allowed = $1, $2
			if allowed != "0" && used != allowed && commander_spellup_needed?
				waitrt?
				waitcastrt?
				pause 0.2
				fput "mana spellup"
				pause 3
			end
		end
	end
	waitrt?
	waitcastrt?
	start_script("ewaggle", ['--start-at=181', '--stop-at=240', 'self'])
	wait_while { running?("ewaggle") }
	commander_self_armor_spec
end

# After the silver is shared: spellup check, encounter stats, then the checkpoint is cleared.
def commander_crew_share_finish
	commander_checkpoint(10) unless commander_checkpoint_data && commander_checkpoint_data["number"].to_i == 10
	pause 2
	commander_captains_quarters
	#do_client ";eloot load"
	avg_left  = spellup_time_left
	threshold = @commander_data["time_left_setting"].to_f
	threshold = 65 if threshold <= 0
	if avg_left <= threshold && (@commander_data["crewsize"] || []).empty?
		respond ""
		respond " ------ Average Spell Duration (#{avg_left.round} min) Is Below Setting (#{threshold.round} min), No Crew Mustered, Spelling Up Yourself ------ "
		respond ""
		commander_solo_spell_up
	elsif avg_left <= threshold
		respond ""
		respond " ------ Average Spell Duration (#{avg_left.round} min) Is Below Setting (#{threshold.round} min), Calling A Spellup ------ "
		respond ""
		commander_spell_up
	else
		respond ""
		respond " ------ Average Spell Duration (#{avg_left.round} min) Is Above Setting (#{threshold.round} min), Skipping Spellup ------ "
		respond ""
	end
	end_of_encounter
	commander_clear_checkpoint
	if (@commander_data["crewsize"] || []).count == 0
		do_client ";force osacrew repairs"
	end
	return
end

def commander_go_gangplank
	result = dothistimeout "go gangplank", 3, /|As you approach the|Where are you trying to go|You make your way across the/
		if result.to_s =~ /As you approach the/
			fput "push gangplank"
			pause 0.5
			move "go gangplank"
			return
		elsif result.to_s =~ /You make your way across the/
			return
		elsif result.to_s =~ /Where are you trying to go?/
			fput "go #{@ship_type.split.first}"
			return
		else
			return
		end
end

def commander_after_raze
	commander_checkpoint(8)
	waitrt?
	commander_helm
	wait_until { commander_osacrew_data["sunk_ship"] }
	if @commander_data["netlauncher"]
		check_for_crate
	end
	commander_helm
	fput "turn wheel port"
	waitfor /The (.*) drifts steadily toward the (.*) port/
	commander_lnet_crew("Moored!")
	waitrt?
	fput "yell Moored!"
	commander_checkpoint_step("moored")
	commander_cargo_hold
	fput "take supply crate"
	multifput "put my crate in wood", "put my crate in balls"
	pause 1
	if (GameObj.left_hand.noun.to_s == "crate") or (GameObj.right_hand.noun.to_s == "crate")
		fput "drop supply crate"
	end
	if (@commander_data["crewsize"] || []).count != 0
		commander_captains_quarters
		pause 1.5
		if @commander_data["stowaways"]
			fput "whisper group I will now sell all the loot and drop our boxes in the locksmith pool. I will return shortly. Please do not depart the ship."
		end
		multifput "disband","group open"
		pause 0.5
	end
	commander_broadcast_location
	commander_sell_loot
end

def commander_raze_it
	commander_checkpoint(7)
	result = dothistimeout "raze", 3, /You grab a nearby|Are you sure you|You cannot raze/
	if result.to_s =~ /You grab a nearby/
		commander_after_raze
	elsif result.to_s =~ /Are you sure you/
		commander_raze_it
	elsif result.to_s =~ /You cannot raze/
		fput "stow all"
		start_script "osacombat"
		pause 3
		commander_save_to_commander("cleanup_type", "raze")
		cleanup_begin_routine
		commander_save_to_commander("cleanup_type", nil)
		commander_raze_it
	else
		commander_raze_it
	end
end

def commander_wait_yell
	fput "group open"
	commander_enemy_main_deck
	commander_save_to_commander("amount_of_boxes", GameObj.loot.count {|item| item.type =~ /box/})
	do_client ";foreach box on ground;drag item;go gangplank;sleep 0.5"
	wait_while { running?("foreach") }
	fput "loot room"
	if (@commander_data["crewsize"] || []).count != 0
		commander_captains_quarters
		commander_task_complete
		$whisper_message = "Next we will sink the enemy ship, please let me know when you're all set"
		commander_stowaways
		GameObj.pcs.each{|pc|;fput "hold ##{pc.id}"}
		commander_enemy_main_deck
	end
	commander_raze_it
end

def commander_hands_full
	commander_enemy_main_deck
	commander_left_hand
	commander_right_hand
	do_client ";foreach box in #{Vars.lootsack};move to ground;sleep 0.5"
	wait_while { running?("foreach") }
	commander_enemy_quarters
end

def get_straggler_boxes
	@commander_data["straggler_boxes"].each do |n|
		@room_with_box = n
		start_script("go2", [@room_with_box])
		wait_while { running?("go2") }
		straggler_boxes = GameObj.loot.find_all{|item| item.type =~ /box/}
		straggler_boxes.each{|box|
			fput "drag #{box}"
			if Room.current.title.to_s.include? "Enemy"
				commander_enemy_main_deck
			else
				commander_main_deck
			end
			if Room.current.title.to_s.include? "Enemy"
				fput "go gangplank"
			end
			fput "drag stop"
			start_script("go2", [@room_with_box]) if !Room.current.tags.include? @room_with_box
			wait_while { running?("go2") }
		}
	end
end
	
def commander_get_treasure
	result = dothistimeout "search pile", 5, /You search around in the|Are you sure you would|You take a moment to|How do you plan|You cannot SEARCH/
		if result.to_s =~ /You search around in the|How do you plan/
			waitrt?
			if (GameObj.left_hand.noun.to_s == "crate") or (GameObj.right_hand.noun.to_s == "crate")
				fput "stow all"
				commander_wait_yell
			else
				commander_hands_full
				commander_get_treasure
			end
		elsif result.to_s =~ /Are you sure you would/
			commander_get_treasure
		elsif result.to_s =~ /You take a moment to/
			commander_wait_yell
		elsif result.to_s =~ /You cannot SEARCH/
			fput "stow all"
			start_script "osacombat"
			pause 3
			commander_save_to_commander("cleanup_type", "spawn")
			cleanup_begin_routine
			commander_save_to_commander("cleanup_type", nil)
			commander_enemy_quarters
			commander_get_treasure
		else
			commander_enemy_quarters
			commander_get_treasure
		end
end

def commander_prep_it
		commander_checkpoint(6)
		move "down"
		fput "drag supply crate"
		move "up"
		waitrt?
		multifput "go gangplank", "go gangplank", "drag supply crate"
		waitrt?
		move "down"
		waitrt?
		fput "drag stop"
		get_straggler_boxes
		commander_save_to_commander("straggler_boxes", Array.new)
		commander_checkpoint_step("crate_moved")
		commander_enemy_quarters
		fput "stow set #{Vars.lootsack}"
		commander_get_treasure
end

def commander_give_coins
	commander_lnet_crew("Silvers")
	pause 1
	fput "depo all"
end

def exp_check
	@capped = false
	@resource = nil
	@resource_total = nil
	@resource_weekly = nil
	exp = Lich::Util.quiet_command("exp", /Level:/, end_pattern = /You mind is (.*)\./, include_end = false ,timeout = 3, silent = true)
	if exp.to_s =~ /Exp to next TP: ([0-9,]+)/
		@capped = true
		@exptntp = $1
	elsif exp.to_s =~ /Exp until lvl: ([0-9,]+)/
		@capped = false
	end
	if exp.to_s =~ /PTPs\/MTPs: ([0-9,]+)\/([0-9,]+)/
		@mtrainingpoints = $2
		@ptrainingpoints = $1
	end
	pause 1
	resource = Lich::Util.quiet_command("resource", /Health: ([0-9,]+)\/([0-9,]+)     Mana: ([0-9,]+)\/([0-9,]+)     Stamina: ([0-9,]+)\/([0-9,]+)     Spirit: ([0-9,]+)\/([0-9,]+)/, end_pattern = /Suffused (.*): ([0-9,]+)/, include_end = true, timeout = 0.5, silent = true)
	if resource.to_s =~ /(Necrotic Energy|Essence|Motes of Tranquility|Devotion|Nature's Grace|Luck Inspiration|Grit|Guile): ([0-9,]+)\/50,000/
		@resource = $1
		@resource_weekly = $2
	end
	if resource.to_s =~ /([0-9,]+)\/200,000/
		@resource_total = $1
	end
	if resource.to_s =~ /(.*) ([0-9,]+)\/200,000/
		@resource_total = $2
	end
	if !@capped && !@resource.nil? && checkname == commander_osacrew_data["commander"]
		respond ""
		respond "                   Your Stats Are:           Health: #{health}/#{maxhealth} | Mana: #{mana}/#{maxmana} | Stamina: #{stamina}/#{maxstamina} | Spirit: #{spirit}/#{maxspirit} | Exp Till Level #{Stats.level.to_i + 1}: #{XMLData.next_level_text.to_i} | State Of Mind: #{checkmind.split(/ |\_/).map(&:capitalize).join(" ")} | Weekly #{@resource}: #{@resource_weekly} | Total #{@resource}: #{@resource_total}"
		respond ""
	end
	if !@capped && @resource.nil? && checkname == commander_osacrew_data["commander"]
		respond ""
		respond "                   Your Stats Are:           Health: #{health}/#{maxhealth} | Mana: #{mana}/#{maxmana} | Stamina: #{stamina}/#{maxstamina} | Spirit: #{spirit}/#{maxspirit} | Exp Till Level #{Stats.level.to_i + 1}: #{XMLData.next_level_text.to_i} | State Of Mind: #{checkmind.split(/ |\_/).map(&:capitalize).join(" ")}"
		respond ""
	end
	if @capped && !@resource.nil? && checkname == commander_osacrew_data["commander"]
		respond ""
		respond "                   Your Stats Are:           Health: #{health}/#{maxhealth} | Mana: #{mana}/#{maxmana} | Stamina: #{stamina}/#{maxstamina} | Spirit: #{spirit}/#{maxspirit} | Exp Till Next TP: #{@exptntp} | #{@ptrainingpoints} PTP\'s | #{@mtrainingpoints} MTP\'s | State Of Mind: #{checkmind.split(/ |\_/).map(&:capitalize).join(" ")} | Weekly #{@resource}: #{@resource_weekly} | Total #{@resource}: #{@resource_total}"
		respond ""
	end
	if @capped && @resource.nil? && checkname == commander_osacrew_data["commander"]
		respond ""
		respond "                   Your Stats Are:           Health: #{health}/#{maxhealth} | Mana: #{mana}/#{maxmana} | Stamina: #{stamina}/#{maxstamina} | Spirit: #{spirit}/#{maxspirit} | Exp Till Next TP: #{@exptntp} | #{@ptrainingpoints} PTP\'s | #{@mtrainingpoints} MTP\'s | State Of Mind: #{checkmind.split(/ |\_/).map(&:capitalize).join(" ")}"
		respond ""
	end
end

def commander_solo_get_underway
	ph_off
	waitrt?
	commander_main_deck
	do_client ";force osacrew underway"
	waitfor /You yell, "Underway!"/
	commander_captains_quarters
	if percentmana <= 84
		respond ""
		respond "          -----------------------------------------------------"
		respond "          |                Waiting For Mana                   |"
		respond "          -----------------------------------------------------"
		respond ""
		wait_until {percentmana >= 85}
	end
	do_client ";foreach food, junk in #{Vars.lootsack};move to bucket;sleep 0.5"
	wait_while { running?("foreach") }
	pause 0.5
	ph_on
end

def commander_get_underway
	ph_off
	waitrt?
	commander_lnet_crew("All Hands Make Ready To Get Underway!")
	fput "yell All Hands Make Preparations For Getting Underway!"
	pause 2
	waitrt?
	waitcastrt?
	echo "Raising Anchor"
	commander_helm
	commander_raise_anchor
	waitrt?
	if @anchor_aweigh
		fput "yell Anchor's Aweigh!"
		@anchor_aweigh = false
	end
	commander_captains_quarters
	commander_task_complete
	if percentmana <= 84
		respond ""
		respond "          -----------------------------------------------------"
		respond "          |                Waiting For Mana                   |"
		respond "          -----------------------------------------------------"
		respond ""
		wait_until {percentmana >= 85}
	end
	do_client ";foreach food, junk in #{Vars.lootsack};move to bucket;sleep 0.5"
	wait_while { running?("foreach") }
	pause 0.5
	GameObj.pcs.each{|pc|;fput "hold ##{pc.id}"}
	multifput "depart","depart"
	commander_lnet_crew("Underway!")
	fput "yell Underway!"
	ph_on
end

def commander_kick_capstan
	# Anchor the ship then watch for the enemy sinking, collision, or out of balls
	commander_helm
	waitrt?
	fput "kick capstan"
	waitrt?

	crew_ch = commander_osacrew_data["crew"].to_s
	$capstan_result = nil
	capstan_thread = Thread.new do
		loop do
			line = get
			case line
			when /Tenebrous Cauldron\.  Victory is yours!/
				$capstan_result = :victory
				break
			when /The sides of the (.*) collide against your (.*)!/
				$capstan_result = :collision
				break
			when /^\[#{Regexp.escape(crew_ch)}\]-GSIV:.*\: \"The Ship Is Out Of Cannon Balls!\"/
				$capstan_result = :out_of_balls
				break
			end
		end
	end

	capstan_thread.join

	case $capstan_result
	when :victory
		commander_sunk_ship
	when :collision
		commander_final_approach_2
	when :out_of_balls
		commander_out_of_balls
	end
end

def commander_out_of_balls
	# Balls depleted during cannon encounter - raise anchor and begin boarding
	respond ""
	respond " ------ Out Of Cannon Balls - Raising Anchor To Begin Boarding ------ "
	respond ""
	commander_helm
	commander_raise_anchor
	waitrt?
	# Now proceed to boarding approach
	if @commander_data["helmsman_enabled"]
		commander_navigator
	else
		commander_helmsman
	end
end

def commander_ship_info
	shipinfo = Lich::Util.quiet_command("ship info #{@ship_type}", /SHIP INFO/, end_pattern = /Captain\'s Chambers Room Style\: (.*)./, include_end = false ,timeout = 3, silent = true)
		if shipinfo.to_s =~ /Ship Name: (.*) Ship Status/
			commander_save_to_commander("commander_ship_name", $1.tr('",', '').chop)
		end
		if shipinfo.to_s =~ /Gangplank Material: (.*) Gangplank Color:/
			if $1.tr('",', '').chop.chop == "Not Set"
				commander_save_to_commander("commander_gangplank", "slender gangplank")
			else
				commander_save_to_commander("commander_gangplank", "#{$1.tr('",', '').chop.chop} gangplank")
			end
		end
	if (!@commander_data["helmsman_enabled"] == nil) or (@commander_data["helmsman_enabled"])
		checkrole = Lich::Util.quiet_command("osa role", /Roles/, end_pattern = /You can change your declared role at the Inking Den of Kraken's Fall./, include_end = false ,timeout = 3, silent = true)
				if checkrole.to_s =~ /Current Role: (.*) Active Bonuses/
					@role = $1.tr('",', '').chop.chop
				end
				if checkrole.to_s =~ /Navigator(.*)Rank\: (.*) Total Experience/
					@rank = $2.tr('",', '').chop.chop
				end
				if (@role == ("Navigator") and @rank == ("Veteran")) or (@role == ("Navigator") and @rank == ("Master"))
					commander_save_to_commander("helmsman_enabled", true, push: false)
				else
					commander_save_to_commander("helmsman_enabled", false, push: false)
				end
	end
	respond "Checking Command Information"
	pause 0.15
	respond "."
	pause 0.25
	respond ".."
	pause 0.35
	respond "... Command Information Saved"
	respond ""
end

def commander_board_ship
	if !commander_osacrew_data["gangplank"].nil? 
		Room[commander_osacrew_data["gangplank"]].tags.delete("myship") if Room[commander_osacrew_data["gangplank"]].tags.include? "myship"
	end
	commander_clear_gangplank
	commander_save_to_crew("gangplank", Room.current.id)
	Room[commander_osacrew_data["gangplank"]].tags.push("myship") if !Room[commander_osacrew_data["gangplank"]].tags.include? "myship"
	commander_map_gangplank
	commander_crows_nest
	fput "ship flag black"
	if (@commander_data["crewsize"] || []).count != 0
		commander_call_muster
	end
	if (@commander_data["crewsize"] || []).count != 0
		commander_get_underway
	else
		commander_solo_get_underway
	end
	waitrt?
	return
end

