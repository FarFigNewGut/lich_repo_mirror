		@combat_data[k] = data[k] if @combat_data.is_a?(Hash)
	end
end

def self.commander_osacommander_data
	path = File.join(DATA_DIR, XMLData.game, Char.name, "osacommander.yaml")
	return {} unless File.exist?(path)
	raw = File.read(path)
	return {} if raw.strip.empty?
	(YAML.safe_load(raw, permitted_classes: [Time, Symbol], aliases: true) || {}).transform_keys(&:to_s)
rescue StandardError
	{}
end

def self.commander_osacrew_data
	path = File.join(DATA_DIR, XMLData.game, Char.name, "osacrew.yaml")
	return {} unless File.exist?(path)
	raw = File.read(path)
	return {} if raw.strip.empty?
	(YAML.safe_load(raw, permitted_classes: [Time, Symbol], aliases: true) || {}).transform_keys(&:to_s)
rescue StandardError
	{}
end

def self.commander_osacombat_data
	path = File.join(DATA_DIR, XMLData.game, Char.name, "osacombat.yaml")
	return {} unless File.exist?(path)
	raw = File.read(path)
	return {} if raw.strip.empty?
	(YAML.safe_load(raw, permitted_classes: [Time, Symbol], aliases: true) || {}).transform_keys(&:to_s)
rescue StandardError
	{}
end

def self.load_commander_yaml
	Settings.load
	dir = File.join(DATA_DIR, XMLData.game, Char.name)
	FileUtils.mkdir_p(dir) unless Dir.exist?(dir)
	path = File.join(dir, "osacommander.yaml")
	data = {}
	File.open(path, File::RDWR | File::CREAT, 0o644) do |file|
		file.flock(File::LOCK_EX)
		raw = file.read
		if raw && !raw.strip.empty?
			data = YAML.safe_load(raw, permitted_classes: [Time, Symbol], aliases: true) || {}
		else
			data = {}
			file.rewind
			file.write(YAML.dump(data))
			file.flush
			file.truncate(file.pos)
		end
	end
	data = data.transform_keys(&:to_s)
	@commander_data = data
	Settings[Char.name]["osa_vars_yaml_file"] = path
	Settings.save
	path
end

commander_save_to_commander("commanderversion", "4.1.9 (November 1, 2026)", push: false)
TITLE = "OSACommander: v. (#{@commander_data["commanderversion"]})"
require "yaml"
require "gtk3"
require "fileutils"
toggle_upstream
self.load_commander_yaml

commander_check_dependencies("OSACommander", [
	{ name: "eloot",           author: "elanthia-online" },
	{ name: "ewaggle",         author: "elanthia-online" },
	{ name: "ecure",           author: "elanthia-online" },
	{ name: "lnet",            author: "elanthia-online" },
	{ name: "osasail_watch",   author: "peggyanne"       },
	{ name: "osacannon_watch", author: "peggyanne"       },
	{ name: "osa_migrate",     author: "peggyanne"       },
])

if commander_osacrew_data["crew"].empty?
	respond "*********** Your Crew Channel Is Not Set, Please Set Your Crew Channel Before Proceeding (If You Do Not Have One Set, Use Your Character\'s First Name) ************"
	exit
end
if commander_osacrew_data["commander"].empty?
	respond "*********** Your Commander Is Not Set, Please Set Your Crew Channel Before Proceeding (If You Do Not Have One, Use Your Character\'s First Name) ************"
	exit
end
@mana_watcher = nil

# Typing "osacommander setup", "osacommander help" or "osacommander checkpoint" (no semicolon)
# while osacommander is running is handled here instead of going to the game.
$osa_commander_hook_name = "osa_commander_typed_commands"
UpstreamHook.remove($osa_commander_hook_name)
$osa_commander_interceptor = proc do |xml|
	next xml unless xml.start_with?('<c>')
	next xml if xml =~ /^<c>_/i
	cmd = xml.sub(/\A<c>/i, '').sub(/<\/c>\z/i, '').strip
	case cmd.downcase
	when 'osacommander setup'
		self.commandersetup
		nil
	when 'osacommander help', 'osacommander ?'
		commander_help_display
		nil
	when 'osacommander checkpoint'
		commander_show_checkpoint
		nil
	else
		xml
	end
end
UpstreamHook.add($osa_commander_hook_name, $osa_commander_interceptor)

before_dying {
	UpstreamHook.remove($osa_commander_hook_name)
	commander_stop_ambush_watch
	@mana_watcher.kill if @mana_watcher&.alive?
	commander_stop_task_progress
	commander_stop_task_listener
	@warning = false
}
@anchor_aweigh = false
@commander_lowered_sail = false
@warning = false
@done_with_sec_off = false
$osa_commander_resuming = false
commander_save_to_commander("cleanup_type", nil) unless variable[1].to_s =~ /^(resume|checkpoint|help)/i
commander_mana_share
commander_start_task_listener
commander_begin_it