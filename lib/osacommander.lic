	fput "pull gangplank"
	commander_lower_sail
	if @lowered_sail
		waitrt?
		fput "yell Mizzen Mast Unfurled"
		@lowered_sail = false
	end
	pause 0.5
	move "east"
	commander_lower_sail
	if @lowered_sail
		waitrt?
		fput "yell Main Mast Unfurled"
