# Enemy ship rooms (all six layouts, since you don't know which you will board). Unchanged from before.
COMMANDER_ENEMY_SHIP_ROOMS = {
	"sloop" => { "enemy_cargo_hold" => 30790, "enemy_main_deck" => 30787, "enemy_crows_nest" => 30791, "enemy_helm" => 30788, "enemy_quarters" => 30789 },
	"brigantine" => { "enemy_cargo_hold" => 30795, "enemy_main_deck" => 30792, "enemy_forward_deck" => 30797, "enemy_crows_nest" => 30796, "enemy_helm" => 30793, "enemy_quarters" => 30794 },
	"carrack" => { "enemy_cargo_hold" => 30269, "enemy_main_deck" => 30266, "enemy_forward_deck" => 30271, "enemy_bow" => 30272, "enemy_crows_nest" => 30270, "enemy_helm" => 30267, "enemy_quarters" => 30268 },
	"galleon" => { "enemy_cargo_hold" => 30801, "enemy_main_deck" => 30798, "enemy_forward_deck" => 30803, "enemy_bow" => 30804, "enemy_crows_nest" => 30802, "enemy_helm" => 30799, "enemy_quarters" => 30800 },
	"frigate" => { "enemy_cargo_hold" => 30808, "enemy_main_deck" => 30805, "enemy_forward_deck" => 30810, "enemy_crows_nest" => 30809, "enemy_helm" => 30806, "enemy_quarters" => 30807 },
	"man o' war" => { "enemy_cargo_hold" => 30781, "enemy_main_deck" => 30778, "enemy_mid_deck" => 30783, "enemy_forward_deck" => 30786, "enemy_bow" => 30784, "enemy_crows_nest" => 30782, "enemy_forward_crows_nest" => 30785, "enemy_helm" => 30779, "enemy_quarters" => 30780 }
}

# Which ship type a room number belongs to, or nil.
def commander_ship_kind_at(room_id)
	id = room_id.to_i
	COMMANDER_SHIPS.each { |kind, ship| return kind if ship[:range].include?(id) }
	nil
end

# The ship we are on, from the room number; ashore it is the last ship mapped, then your own
# ship type from ;osacommander info.
def commander_current_ship_kind
	commander_ship_kind_at(Room.current&.id) || @commander_mapped_ship || @commander_data["commander_ship_type"].to_s.downcase
end

# Tags the rooms of the ship you are on (and the enemy ship rooms), links its main deck to the
# enemy decks over the gangplank, and saves ship_type / ship_map to osacrew.yaml (repairs and
# cleanup read ship_map). Returns at once if this ship is already mapped. Returns the ship type.
def commander_map_ship
	commander_map_enemy_ships
	kind = commander_current_ship_kind
	ship = COMMANDER_SHIPS[kind]
	return kind unless ship
	if @commander_mapped_ship != kind
		ship[:rooms].each do |tag, id|
			Room[id].tags.push(tag) unless Room[id].tags.include?(tag)
		end
		main = Room[ship[:rooms]["main_deck"]]
		COMMANDER_ENEMY_SHIP_ROOMS.each_value do |rooms|
			enemy_main = rooms["enemy_main_deck"].to_s
			next unless main.wayto[enemy_main].nil?
			main.wayto[enemy_main] = StringProc.new("fput \"push gang\";fput \"go gang\"")
			main.timeto[enemy_main] = 0.2
		end
		@commander_mapped_ship = kind
	end
	# Only saved while aboard, and only once per ship (osacrew writes the same values)
	if commander_ship_kind_at(Room.current&.id) == kind && @commander_saved_ship != kind
		@commander_saved_ship = kind
		crew = commander_osacrew_data
		commander_save_to_crew("ship_type", kind) if crew["ship_type"] != kind
		commander_save_to_crew("ship_map", ship[:repair_order]) if crew["ship_map"] != ship[:repair_order]
	end
	kind
end

def commander_map_enemy_ships
	return if @commander_enemy_ships_mapped
	COMMANDER_ENEMY_SHIP_ROOMS.each_value do |rooms|
		rooms.each do |tag, id|
			Room[id].tags.push(tag) unless Room[id].tags.include?(tag)
		end
	end
	@commander_enemy_ships_mapped = true
end

# Walks to a role on the ship you are on (commander_go("helm")), by room number so go2 can't pick
# the same tag on another ship. Enemy rooms still go by tag. If this ship has no such room it says
# so and stays put. Returns false when it could not go.
def commander_go(tag)
	tag = tag.to_s
	kind = commander_map_ship
	ship = COMMANDER_SHIPS[kind]
	if tag.start_with?("enemy_") || ship.nil?
		return true if Room.current&.tags.to_a.include?(tag)
		start_script("go2", [tag])
		wait_while { running?("go2") }
		return true
	end
	room_id = ship[:rooms][tag]
	if room_id.nil?
		respond "--- OSACommander: This #{kind.split(" ").map(&:capitalize).join(" ")} has no #{tag.tr("_", " ")}."
		return false
	end
	return true if Room.current&.id.to_i == room_id
	start_script("go2", [room_id.to_s])
	wait_while { running?("go2") }
	true
end

def commander_map_gangplank
	ship = COMMANDER_SHIPS[@commander_data["commander_ship_type"].to_s.downcase]
	plank = commander_osacrew_data["gangplank"]
	return if ship.nil? || plank.nil? || Room[plank].nil?
	main_id = ship[:rooms]["main_deck"]
	Room[plank].wayto[main_id.to_s] = StringProc.new("gangplank = GameObj.loot.find{|o| o.noun == \"gangplank\" }.id;if !gangplank.nil?;fput \"go #\#{gangplank}\";else;ship = GameObj.loot.find{|o| o.noun =~ /sloop|brigantine|carrack|frigate|galleon|^man/ }.id; if !ship.nil?;fput \"go #\#{ship}\";else;echo \"Couldnt find gangplank or ship\";end;end;")
	Room[plank].timeto[main_id.to_s] = 0.2
	Room[main_id].wayto[plank.to_s] = StringProc.new("fput \"push gang\";fput \"go gang\"")
	Room[main_id].timeto[plank.to_s] = 0.2
end

def commander_clear_gangplank
	plank = commander_osacrew_data["gangplank"]
	return if plank.nil? || Room[plank].nil?
	COMMANDER_SHIPS.each_value do |ship|
		main_id = ship[:rooms]["main_deck"]
		Room[plank].wayto.delete(main_id.to_s)
		Room[plank].timeto.delete(main_id.to_s)
		Room[main_id].wayto.delete(plank.to_s)
		Room[main_id].timeto.delete(plank.to_s)
	end
end


# Shipboard movement: each one walks to that room on the ship you are on (see commander_go).
