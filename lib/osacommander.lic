	if !@commander_data["othersailors"]
		commander_save_to_commander("othersailors", true)
		respond "     *===============================================================================*
					|             *****You Are Now Accepting Outside Scripted Crew*****             |
					*===============================================================================*"
	else
		respond "    Scripted Crew Is Enabled"
	end
end

