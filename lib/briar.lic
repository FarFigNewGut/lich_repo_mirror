## briar.lic
## Raises weapon to activate briar buff every 2 minutes or when influence is available
## Written by Ralkean
## Modify nouns for briar weapon and/or briar accessory as needed

module BriarBuff
  PEER_NOUN          = "grapevine"
  RAISE_NOUN         = "bow"
  BRIAR_INFLUENCE_RX = /Blood Points: (\d+)/
  RAISE_SUCCESS_MSG  = "the briars imbedded in your flesh release their stored blood in a massive pulse of power that you can feel in the core of your very being.  The vines lose all crimson hues, and strength courses through your blood."

  @influence = 0

  def self.check_influence
    res = Lich::Util.quiet_command_xml(
      "peer my #{PEER_NOUN}",
      /output class/,
      /Note: Only items worn or in-hand are listed\./,
      true,
      3
    )
    return @influence unless res.is_a?(Array) && !res.empty?

    res.each do |line|
      if line =~ BRIAR_INFLUENCE_RX
        @influence = $1.to_i
        break
      end
    end

    @influence
  end

  def self.run
    loop do
      wait_while { checkdead }

      loop do
        break if check_influence == 100
        sleep 3
      end

      loop do
        wait_while { GameObj.right_hand.noun != RAISE_NOUN && GameObj.left_hand.noun != RAISE_NOUN }
        waitrt?
        if checkrt == 0
          fput "raise my #{RAISE_NOUN}"
        end
        if matchtimeout 5, RAISE_SUCCESS_MSG
          break
        end
      end

      ## wait for buff to end
      matchtimeout 130, "You no longer look stronger."
    end
  end
end

BriarBuff.run