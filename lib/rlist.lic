=begin
  rlist.lic - copies a color-coded Discord table of your characters'
  profession service bonus, resource and price to the clipboard.

  ;rlist                  refresh this character, then copy the table
  ;rlist <n>              copy part n of a long table (2,000 char limit)
  ;rlist nitro            split at Nitro's 4,000 characters instead
  ;rlist priced           only characters with a price set
  ;rlist norefresh        skip ;resource silent
  ;rlist price <price>    set a price (or: price <name> <price> / clear)
  ;rlist prices           list your prices
  ;rlist help             full help

  Requires ;resource. Clipboard: Windows, Mac and Linux (wl-copy/xclip).

       author: Mara
         game: Gemstone
         tags: resource, profession, service, bonus, discord, alts
      contact: mara.lilly on Discord, @Lillymara on GitHub
    co-author: Claude (Anthropic) - claude.ai/code
      version: 1.8.1

  Changelog:
    1.8.1 (2026-10-20) - Compact header.
    1.8.0 (2026-10-20) - Prices, nitro, priced, numbered parts, half-size
      Discord copy, names/weekly in the game window only.
    1.0.0 (2026-10-19) - Initial release.
=end

def xml_safe(s)
  s.to_s.gsub('&', '&amp;').gsub('<', '&lt;')
end

def show_help
  name = Script.current.name
  # Pad before escaping - placeholders like <id> are literal text, not markup.
  hdr = ->(t) { _respond "<preset id='speech'>#{xml_safe(t)}</preset>" }
  txt = ->(t) { _respond "  #{xml_safe(t)}" }
  gap = -> { _respond " " }
  row = ->(c, d) { _respond "  <preset id='whisper'>#{xml_safe(c.ljust(20))}</preset>#{xml_safe(d)}" }

  hdr.call("#{name} - your profession bonus and resource, for Discord")
  gap.call
  txt.call("Refreshes this character, then copies a color-coded")
  txt.call("table of all your characters to the clipboard.")
  gap.call
  hdr.call("  COMMANDS")
  row.call(";#{name}",           "refresh, then build the table")
  row.call(";#{name} norefresh", "skip ;resource silent")
  row.call(";#{name} <n>",       "copy part n of a long table")
  row.call(";#{name} nitro",     "split at 4,000 (Discord Nitro)")
  row.call(";#{name} priced",    "only characters with a price")
  row.call(";#{name} help",      "show this help")
  gap.call
  hdr.call("  PRICES")
  row.call("price <price>",        "set this character's price")
  row.call("price <name> <price>", "set another character's price")
  row.call("price clear",          "clear it (or: price <name> clear)")
  row.call("prices",               "list the prices you've set")
  txt.call("A price can be any text: 50k, 1m, 250k/day")
  gap.call
  hdr.call("  GOOD TO KNOW")
  txt.call("Run it on each character to add them to the table.")
  txt.call("Names and weekly show here, not in the Discord copy.")
  txt.call("Over 2,000 characters, the copy splits into parts.")
  txt.call("Options combine: ;#{name} priced nitro 2")
  txt.call("Rows are only as fresh as each character's last run.")
  txt.call("Saved as data/resource/discord.txt if the copy fails.")
  txt.call("Needs ;resource (;repository download resource).")
end

args = (variable[1..] || []).compact
options = args.map(&:downcase)

dir = File.join(DATA_DIR, "resource")
filename = File.join(dir, "bonuses.yaml")
prices_file = File.join(dir, "rlist_prices.yaml")
key = "#{XMLData.game}:#{Char.name}"
prices = (File.exist?(prices_file) && YAML.load_file(prices_file)) || {}

if options.first == "prices" || options == ["price"]
  mine = prices.select { |k, _| k.start_with?("#{XMLData.game}:") }
  if mine.empty?
    echo "No prices set. Use ;#{Script.current.name} price <price> on a character."
  else
    mine.sort.each { |k, price| echo "#{k.split(':', 2).last}: #{price}" }
  end
  exit
end

if options.first == "price"
  rest = args[1..]
  saved = (File.exist?(filename) && YAML.load_file(filename)) || {}
  known = saved.values.select { |char| char[:game] == XMLData.game }.map { |char| char[:name].to_s }
  target = rest.size >= 2 && known.find { |name| name.casecmp?(rest.first) }
  rest = rest[1..] if target
  target ||= Char.name
  target_key = "#{XMLData.game}:#{target}"
  price = rest.join(" ").strip
  if price =~ /\A(?:clear|none|-)\z/i
    prices.delete(target_key)
    echo "Cleared #{target}'s price."
  else
    prices[target_key] = price
    echo "#{target}'s price is now #{price}."
  end
  Dir.mkdir(dir) unless File.exist?(dir)
  File.write(prices_file, prices.to_yaml)
  exit
end

# ;rlist 2 copies the second Discord message of a long table, without refreshing
part = 1
if (number = options.find { |opt| opt =~ /\A[1-9]\d*\z/ })
  part = number.to_i
  options = options - [number] + ["norefresh"]
end

nitro = options.include?("nitro")
priced = options.include?("priced")
unknown = options - %w[norefresh nitro priced]
unless unknown.empty?
  echo "Unknown option: #{unknown.join(' ')}" unless unknown.all? { |opt| opt =~ /^(help|\?)$/ }
  show_help
  exit
end

unless options.include?("norefresh")
  # resource.lic crashes saving a character it has never seen, so seed a blank entry first
  saved = (File.exist?(filename) && YAML.load_file(filename)) || {}
  unless saved[key]
    Dir.mkdir(dir) unless File.exist?(dir)
    saved[key] = { :game => XMLData.game, :name => Char.name, :prof => Stats.prof }
    File.write(filename, saved.to_yaml)
  end

  echo "Refreshing #{Char.name}'s saved resource data..."
  unless Script.run("resource", "silent")
    echo "Couldn't run ;resource. Install it with ;repository download resource and try again."
    exit
  end
end

unless File.exist?(filename)
  echo "No saved data found. Run ;resource silent on each character first."
  exit
end

characters = YAML.load_file(filename).values
  .select { |char| char[:game] == XMLData.game }
  .sort_by { |char| [char[:prof].to_s, char[:name].to_s] }
characters.select! { |char| prices.key?("#{char[:game]}:#{char[:name]}") } if priced
if characters.empty?
  echo priced ? "No characters have a price set. Use ;#{Script.current.name} price <price>." : "No characters saved yet."
  exit
end

def bonus_text(bonus)
  return bonus.to_s unless bonus.is_a?(Hash)
  # Monk saves Self/Other; buyers only get the Other bonus
  return bonus["Other"].to_s if bonus.key?("Other")
  bonus.map { |title, value| "#{title} #{value}" }.join(", ")
end

def resource_number(value)
  value.to_s.empty? ? "?" : value.to_s
end

# 143,413 -> 143k (the caps are always 200k total / 50k weekly, so they're left off)
def thousands(value)
  value.to_s.empty? ? "?" : "#{number(value) / 1000}k"
end

def number(value)
  value.to_s.delete(",").to_i
end

# Discord ```ansi colors: 30 gray, 31 red, 32 green, 33 yellow, 34 blue, 35 pink, 36 cyan, 37 white
def total_color(value)
  return "31" if value.to_s.empty?
  amount = number(value)
  amount >= 150_000 ? "1;32" : (amount >= 100_000 ? "33" : "31")
end

def weekly_color(value)
  number(value) >= 50_000 ? "32" : "33"
end

def suffused_color(value)
  number(value) > 0 ? "36" : "30"
end

# Each cell is [text, ansi color]. Columns marked false are game window only:
# buyers don't need names or weekly resource, and leaving them off saves space.
columns = [["Character", false], ["Class", true], ["Bonus", true], ["Resource", true],
           ["Weekly", false], ["Suffused", true], ["Price", true]]
headers = columns.map { |title, _| [title, "1;4;37"] }

rows = characters.map { |char|
  price = prices["#{char[:game]}:#{char[:name]}"].to_s
  [
    [char[:name].to_s, "1;37"],
    [char[:prof].to_s, "34"],
    [bonus_text(char[:bonus]), "1;33"],
    [thousands(char[:total]), total_color(char[:total])],
    [thousands(char[:weekly]), weekly_color(char[:weekly])],
    [resource_number(char[:suffused]), suffused_color(char[:suffused])],
    price.empty? ? ["-", "30"] : [price, "1;35"],
  ]
}

# Discord rejects messages over 2,000 characters (4,000 with Nitro), so long tables are split
DISCORD_LIMIT = nitro ? 4000 : 2000

# Returns the header and each row as lines. The Discord copies use plain
# spacing and only switch color when it changes, since every escape code
# counts against the limit; each code starts with 0 so it resets bold and
# underline too.
table_lines = lambda { |ansi, game_window|
  keep = columns.each_index.select { |i| game_window || columns[i][1] }
  table = ([headers] + rows).map { |row| row.values_at(*keep) }
  widths = table.transpose.map { |column| column.map { |cell| cell[0].length }.max }
  last = nil
  table.map { |row|
    row.each_with_index.map { |(text, color), i|
      padded = (i == row.size - 1) ? text : text.ljust(widths[i] + (game_window ? 0 : 2))
      next padded unless ansi
      code = (color == last) ? "" : "\e[0;#{color}m"
      last = color
      code + padded
    }.join(game_window ? " | " : "")
  }
}

# Splits into messages that each fit the limit and start with the header
discord_messages = lambda { |ansi|
  header, *body = table_lines.call(ansi, false)
  fence = ansi ? "```ansi" : "```"
  wrap = ->(lines) { [fence, header, *lines, "```"].join("\n") }
  messages = [[]]
  body.each { |line|
    messages << [] if messages.last.any? && wrap.call(messages.last + [line]).length > DISCORD_LIMIT
    messages.last << line
  }
  messages.map(&wrap)
}

colored_parts = discord_messages.call(true)
plain_parts = discord_messages.call(false)

colored_file = File.join(dir, "discord.txt")
File.write(colored_file, colored_parts.join("\n\n") + "\n")
File.write(File.join(dir, "discord_plain.txt"), plain_parts.join("\n\n") + "\n")

game_header, *game_rows = table_lines.call(false, true)
divider = game_header.gsub(/[^|]/, "-").gsub("|", "+")
_respond "<output class=\"mono\"/>\n" + xml_safe([game_header, divider, *game_rows].join("\n")).gsub(">", "&gt;") + "\n<output class=\"\"/>"

if part > colored_parts.size
  echo "There are only #{colored_parts.size} part(s)."
  exit
end
colored = colored_parts[part - 1]

def copy_to_clipboard(text)
  commands =
    if Gem.win_platform? then ["clip"]
    elsif RUBY_PLATFORM =~ /darwin/ then ["pbcopy"]
    else ["wl-copy --type text/plain", "xclip -selection clipboard", "xsel --clipboard --input"]
    end
  commands.any? { |cmd|
    begin
      IO.popen(cmd, "w") { |io| io.write(text) }
      $?.success?
    rescue SystemCallError
      false # not installed, try the next one
    end
  }
end

if copy_to_clipboard(colored)
  echo "Colored version copied to your clipboard. Paste it straight into Discord."
  if colored_parts.size > 1
    echo "That's part #{part} of #{colored_parts.size} (Discord's #{nitro ? "4,000 Nitro" : "2,000"} character limit)."
    echo "When it's sent, run ;#{Script.current.name}#{priced ? " priced" : ""}#{nitro ? " nitro" : ""} #{part + 1} for the next one." if part < colored_parts.size
  end
else
  echo "Colored version saved to #{File.expand_path(colored_file)}"
  echo "Open it in a text editor, copy everything, and paste it into Discord."
  echo "It's split into #{colored_parts.size} messages to fit Discord's limit; send each one." if colored_parts.size > 1
  echo "(The Discord copy leaves off names and weekly; the game window shows them.)"
end
