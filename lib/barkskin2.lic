## barkskin2.lic
## This script activates and refreshes Barkskin
## Barkskin will refresh if character is able to cast but idle for prior 2 seconds
## Script won't cast while hidden
## Written by Ralkean

def ableToCast?
	return false if checkrt > 0 || checkcastrt > 0 || checkdead
	return false if stunned? || sleeping? || bound? || webbed?
	return false if Spell[1716].lockout?
	return false if Effects::Debuffs.active?("Silenced") || Effects::Debuffs.active?("Sympathy")
	return false if Effects::Debuffs.active?("Dazed")
	return true
end

loop	{
	if ableToCast?
		sleep 1
		if ableToCast?
			sleep 1
			if ableToCast? and !checkhidden and !Spell[605].active? and !Effects::Cooldowns.active?("Barkskin")
				if (!checkgrouped or Skills.spiritual_lore_blessings < 50) and checkmana >= 5
					put "incant 605"
					sleep 1
				elsif checkmana >= 15
					put "incant 605 evoke"
					sleep 1
				end
				if Spell[605].active?
					sleep 57
				end
			end
		end
	end
	sleep 1
	}