=begin
simple attack script
=end
$a2_140 = {}
friendlist = ["Tollwick", "Elixx", "Llaan", "Faellin", "Arlend", "Dihya", "Marchelle", "Salida", "Tiddlywinx", "Chuco", "Painz", "Anshul", "Zelophehaad", "Demid"]

def get_target
    # Billy 10/16: kill the dangerous ones FIRST -- shared list in data/target_priority.txt (e.g. "steed|shaper")
    pri = (Regexp.new(File.read(File.join($data_dir.to_s, 'target_priority.txt')).strip, Regexp::IGNORECASE) rescue nil)
    GameObj.targets.reject { |npc| npc.status.to_s =~ /dead|gone/ || npc.noun.to_s =~ /^(?:arms?|tentacles?|palpi)$/ }
                   .sort_by { |npc| pri && npc.name.to_s =~ pri ? 0 : 1 }
end
def spellactive()
    # Billy 10/15: "I used to have all that built into the profession attack: standing? Spell.active?"
    # 1) magic-item buffs: rub the orb/coin/statue if CARRIED and the effect is down (any character)
    # Billy 10/16: if I DON'T have the item and a teammate has a SPARE, we share it (data/need_<noun>_<Name>.txt board;
    # a teammate in the room with 2+ hands one over; partner2 auto-accepts).
    items = (GameObj.inv.to_a + GameObj.inv.to_a.flat_map { |c| c.contents.to_a })
    here  = GameObj.pcs.to_a.map(&:noun)
    # Billy 10/16: the heavy quartz ORB is only for CS (casters); STATUE and COIN are for everyone
    caster = Char.prof.to_s =~ /Cleric|Empath|Sorcerer/        # Billy 10/16: orb = cleric, empath, sorcerer only (NOT wizard, NOT bard)
    [[1711, 'orb', /quartz orb/], [1701, 'coin', /gold coin/], [1712, 'statue', /small statue/]].each { |n, noun, pat|
        next if noun == 'orb' && !caster
        mine = items.count { |i| i.name.to_s =~ pat }
        need = File.join($data_dir.to_s, "need_#{noun}_#{Char.name}.txt")
        if mine == 0 then File.write(need, Time.now.to_i.to_s) rescue nil else File.delete(need) rescue nil end
        if mine >= 2   # I have a spare: give one to a teammate in this room who asked
            Dir.glob(File.join($data_dir.to_s, "need_#{noun}_*.txt")).each { |f|
                who = File.basename(f, '.txt').sub("need_#{noun}_", '')
                next if who == Char.name || !here.include?(who)
                waitrt?
                fput "get my #{noun}"; fput "give my #{noun} to #{who}"; sleep 3
                fput "stow my #{noun}" if [GameObj.right_hand, GameObj.left_hand].any? { |h| h.name.to_s =~ pat }
                File.delete(f) rescue nil
                break
            }
        end
    }
    [[1711, 'q orb', /quartz orb/], [1701, 'coin', /gold coin/], [1712, 'statue', /small statue/]].each { |n, noun, pat|
        next if n == 1711 && !caster
        next if Spell[n].active?
        carried = items.any? { |i| i.name.to_s =~ pat }
        next unless carried || Char.name =~ /Demid|Anshul|Chuco|Zelophehaad|Painz/
        waitrt?
        multifput "get my #{noun}", "rub my #{noun}", "stow my #{noun}"
        waitrt?                                       # Billy 10/16: rub EVERY carried item that's down (coin, statue, heavy quartz orb)
    }
    # 1b) Billy 10/16: shadow steeds cast TERROR ("horridly grotesque image ... utter terror") and the girls FLEE,
    #     which split Tiddlywinx off alone and killed her. Voln SYMBOL OF COURAGE counters it -- keep it up always.
    sc = Spell['Symbol of Courage'] rescue nil
    if sc && sc.known? && !sc.active?
        waitrt?; waitcastrt?
        fput 'symbol of courage'
    end
    # 2) profession spells (Billy 10/16): for each spell -- active? next. Not active: REQUIRED? yes -> cast it,
    #    no -> don't worry about it. Runs before hunting (once at start) and on every match.
    #    REQUIRED = true/false per spell. Ranger/Rogue lists by name.
    required = {
      'Cleric'   => { 101=>true, 102=>true, 103=>true, 107=>true, 115=>true, 120=>true, 202=>true, 219=>true,
                      307=>true, 310=>true, 313=>true, 319=>true, 218=>true, 305=>false, 919=>false },   # 218 servant (Billy 10/16)
      'Empath'   => { 101=>true, 102=>true, 103=>true, 107=>true, 115=>true, 120=>true, 202=>true, 219=>true,
                      1109=>true, 1119=>true, 1125=>true, 218=>true },   # 218 servant (Billy 10/16)
      'Sorcerer' => { 101=>true, 102=>true, 103=>true, 107=>true, 115=>true, 120=>true, 401=>true, 406=>true,
                      414=>true, 425=>true, 430=>true, 712=>true },
      'Wizard'   => { 401=>true, 406=>true, 414=>true, 425=>true, 430=>true, 503=>true, 507=>true, 508=>true,
                      509=>true, 513=>true, 520=>true, 905=>true, 913=>true, 920=>true, 919=>false },   # 920 familiar (Billy 10/16)
      'Bard'     => { 'Fortitude Song'=>true, 'Song of Luck'=>true, "Kai's Triumph Song"=>true, 'Song of Valor'=>true,
                      'Singing Sword Song'=>true },
      'Ranger'   => { 'Natural Colors'=>true, 'Resist Elements'=>true, "Phoen's Strength"=>true, 'Self Control'=>true,
                      'Mobility'=>true, "Nature's Touch"=>true, 'Barkskin'=>true, 'Resist Nature'=>true,
                      'Sneaking'=>false },                                         # Billy 10/16: + Barkskin 605, Resist Nature 620
    }
    required.fetch(Char.prof.to_s, {}).each { |n, req|
        next unless Spell[n] && Spell[n].known?
        # Billy 10/16: refresh BEFORE it expires -- recast when under 3 min left (bard songs renew on their own)
        next if Spell[n].active? && (Char.prof.to_s =~ /Bard/ || (Spell[n].timeleft.to_f rescue 99) > 3)
        next unless req                              # not required -> don't worry about it
        next unless Spell[n].affordable? && checkmana - Spell[n].mana_cost >= 30
        next if (Effects::Cooldowns.active?(Spell[n].name) rescue false)   # e.g. 919: never cast into its cooldown
        Spell[n].cast
        waitcastrt?
    }
end
# ---- REQUIREMENTS (Billy 10/16): define everything; before attacking, any requirement not met is fixed automatically ----
def requirements()
    # Billy's order (10/16): checkrt -> checkmind -> standing -> stance -> weapon check -> spellactive -> encumbered
    return if dead?
    # 1. checkrt: no roundtime of any kind (hard/maneuver RT and cast RT)
    waitrt?; waitcastrt?
    # 2. checkmind: full mind = "hey, my mind's full, let's go to town" (once a minute)
    if (percentmind rescue 0).to_i >= 100 && (!$a2_mind || Time.now.to_f - $a2_mind > 60)
        fput "whisper group Hey, my mind's full, let's go to town."
        $a2_mind = Time.now.to_f
    end
    # 3. standing
    stand() if !standing?
    # 3b. group check (Billy 10/16): am I in the group? if not, what room am I in, where is my leader? go join him.
    #     Groups live in data/hunt_groups.txt ("Leader: member member"); the leader writes his room every check.
    # Billy 10/17 "it is about constantly casting": group_check sends GROUP and waits up to 3 s -- that was a delay
    # before EVERY cast. Run it at most every 15 s (always when no creature is up).
    if get_target().empty? || Time.now.to_f - ($a2_gc || 0) > 15
        $a2_gc = Time.now.to_f
        group_check()
    end
    # 4. stance: back to this character's home stance (;vars set home_stance=..., default guarded)
    change_stance((Vars['home_stance'] || 'guarded').to_s)
    # 5. weapon check: shield out (real shields), weapon in hand (bard lance, ranger bow LEFT, casters runestaff)
    rh = GameObj.right_hand.name.to_s
    # shield out: anyone who OWNS a real shield wears it in the left hand (the bard's sung shield is dropped below)
    if Char.prof.to_s !~ /Bard|Ranger/ && GameObj.left_hand.name.to_s !~ /shield|buckler|aegis|targe|pavis|scutum/i
        sh = (GameObj.inv.to_a + GameObj.inv.to_a.flat_map { |c| c.contents.to_a }).find { |i| i.name.to_s =~ /shield|buckler|aegis|targe|pavis|scutum/i }
        fput "get ##{sh.id}" if sh && GameObj.left_hand.id.nil?
    end
    # Billy 10/16 hand check: "oh, stow that and get my bow out" -- anything in hand that isn't this
    # profession's weapon (salve jar, loot, rubbed item) gets stowed BEFORE the weapon check
    keep = { /Bard/ => /lance/i, /Ranger/ => /bow|arrow/i, /Cleric|Empath|Sorcerer|Wizard/ => /runestaff|staff/i }
              .find { |prof, _| Char.prof.to_s =~ prof }&.last
    if keep
        (fput 'stow right'; waitrt?) if !GameObj.right_hand.id.nil? && rh !~ keep
        lh = GameObj.left_hand.name.to_s
        (fput 'stow left'; waitrt?) if !GameObj.left_hand.id.nil? && lh !~ keep && lh !~ /shield|buckler|aegis|targe|pavis|scutum/i
        rh = GameObj.right_hand.name.to_s
    end
    case Char.prof.to_s                                                            # weapon in hand
    when /Bard/
        fput "drop ##{GameObj.left_hand.id}" if GameObj.left_hand.name.to_s =~ /shield|buckler|aegis|targe/i
        (fput 'incant 1012 lance'; waitcastrt?) if rh !~ /lance/i && Spell[1012].affordable?
    when /Ranger/
        unless GameObj.left_hand.name.to_s =~ /bow/i
            bow = (GameObj.inv.to_a + GameObj.inv.to_a.flat_map { |c| c.contents.to_a }).find { |i| i.name.to_s =~ /bow/i }
            fput "get ##{bow.id}" if bow && GameObj.right_hand.name.to_s !~ /bow/i
            fput 'swap' if GameObj.right_hand.name.to_s =~ /bow/i                  # bow lives in the LEFT hand
        end
    when /Cleric|Empath|Sorcerer|Wizard/
        if rh !~ /runestaff|staff/i                                             # Salida's is just a "staff"
            fput 'get my runestaff'
            fput 'get my staff' if GameObj.right_hand.name.to_s !~ /staff/i
        end
    end
    # 6. spellactive: magic items (coin/statue all, orb cleric/empath/sorc) + required profession spells + mana wink
    spellactive()
    # 919 is NOT here: it's "only when needed", and Billy's design for that is the leader BLINKING (partner2)
    if checkmana < 40 && Char.prof.to_s !~ /Rogue|Warrior/ && (!$a2_winked || Time.now.to_f - $a2_winked > 45)
        donor = (%w[Arlend Llaan] & GameObj.pcs.to_a.map(&:noun)).first            # wizard/sorc mana share
        (fput "wink #{donor}"; $a2_winked = Time.now.to_f) if donor
    end
    # 7. encumbered (Billy 10/16): "hey, I'm encumbered, I need to go to town" -> go2 town -> eloot sell -> return to base.
    #    eloot sell started HERE walks to town, sells, and walks back to this room = base. Leave the group first so
    #    nobody gets dragged (the leader disbands); upkeep's group keeper rejoins on return.
    # Billy 10/17: he went to sell MID-FIGHT and eloot stowed his runestaff with mobs alive. Only once the room is CLEAR.
    if (XMLData.encumbrance_value.to_i rescue 0) >= 40 && !Script.running?('eloot') && get_target().empty?
        base = Room.current.id
        fput "whisper group Hey, I'm encumbered, I need to go to town."
        res = dothistimeout('group', 3, /You are leading|You are grouped|not currently in a group/).to_s
        fput(res =~ /You are leading/ ? 'disband' : 'leave') unless res =~ /not currently in a group/
        Script.run('eloot', 'sell')
        Script.run('go2', base.to_s) unless Room.current.id == base
        fput "whisper group Back at base."
    end
end

def group_check()
    lines = (File.read(File.join($data_dir.to_s, 'hunt_groups.txt')).lines rescue [])
    grp = lines.map { |l| l.split(':', 2) }.find { |lead, mem| lead.strip == Char.name || mem.to_s.split.include?(Char.name) }
    return unless grp
    leader = grp[0].strip
    team   = grp[1].to_s.split
    lfile  = File.join($data_dir.to_s, "leader_room_#{leader}.txt")
    here   = GameObj.pcs.to_a.map(&:noun)
    if Char.name == leader
        File.write(lfile, Room.current.id.to_s) rescue nil
        # Billy 10/16: hunting = group OPEN so teammates can always rejoin (closed only in town)
        res = dothistimeout('group', 3, /currently (open|closed)|not currently in a group/).to_s
        fput 'group open' if res =~ /currently closed/
    elsif !here.include?(leader)                                # where is my leader? go to him
        room = (File.read(lfile).to_i rescue 0)
        if room > 0 && Room.current.id != room
            fput "whisper group Lost #{leader}, heading to room #{room}."
            Script.run('go2', room.to_s)
        end
    else                                                        # leader is here: am I in his group?
        res = dothistimeout('group', 3, /You are leading|You are grouped|not currently in a group/).to_s
        fput "join #{leader}" if res =~ /not currently in a group/
    end
end

# Billy 10/16: ROOM CONTROL -- use the crowd-control spells we have. "awake" = still able to fight back.
# Fires when 2+ awake foes OR any priority foe (data/target_priority.txt, e.g. steeds) is awake.
def awake_foes
    get_target().reject { |t| t.status.to_s =~ /lying|prone|sitting|kneeling|webbed|stunned|sleep|immobile|frozen|calm|held/i }
end
def room_control?
    pri = (Regexp.new(File.read(File.join($data_dir.to_s, 'target_priority.txt')).strip, Regexp::IGNORECASE) rescue nil)
    a = awake_foes
    a.length >= 2 || (pri && a.any? { |t| t.name.to_s =~ pri })
end
def cc_cast(n, tgt = nil)
    return false unless Spell[n] && Spell[n].known? && Spell[n].affordable? && checkmana - Spell[n].mana_cost >= 20
    waitrt?; waitcastrt?
    tgt ? Spell[n].cast("##{tgt.id}") : Spell[n].cast
    waitcastrt?
    true
end
def stand(stand_command = nil)
    echo "stand" if $bigshot_debug
    return if (stand_command =~ /^(?:fire|kneel|hide)/i && kneeling? && checkleft =~ /^(?:arbalest|kut'ziko|crossbow|kut'zikokra)$/)

    until (standing?)
      change_stance('defensive')
      fput 'stand'
    end
  end

def change_stance( new_stance, force = true )
        return if Spell[1617].active? || Spell[216].active? || dead?
 
        if( stance() =~ /#{new_stance}/ )
            return
        elsif( checkcastrt() > 0 && new_stance =~ /def/ )
            return if stance() == 'guarded'
        end
 
        if(force)
            result = dothistimeout( "stance #{new_stance}", 3, /You are now in an?|Cast Round Time in effect|You are unable to change/ )
        else
            fput "stance #{new_stance}"
        end
    end
def get_loot()
    # Billy 10/17: eloot stores the weapon to free hands -- never loot while anything is still alive
    Script.run('eloot') if get_target().empty?
end

    
silence_me
requirements()                               # Billy 10/16: every requirement met BEFORE hunting
while(true)
    moblist = get_target()
    # Billy 10/17: "you need to be casting a spell every three seconds no matter what when there are critters in
    # the room" -- don't wait for a friend's attack line. Any live creature here = act NOW, every RT, everyone.
    # Billy 10/17: other people -- "if you see Smokeland or someone else, don't cast and move on". A stranger in the
    # room = their creatures; we hold all casting (the leader's wander moves us on).
    unless (GameObj.pcs.to_a.map(&:noun) - friendlist).empty?
        sleep 1
        next
    end
    target_line = get_target().empty? ? matchtimeout(3, "gestures at","swings a","swings at","fires a","channels at") : nil
    unless target_line
        next if dead? || get_target().empty?
        target_line = "#{Char.name} swings at room"
    end
    friendlist.each do |person|
    if (target_line =~ /#{person} (swings|fires|channels|gestures) (at|a) ./i)
        moblist = get_target()
        requirements()                       # Billy 10/16: requirements before attacking
        if Char.prof =~ /Cleric/
                # Billy 10/15: if creature exists cast 302 / 309 / 319; if more than three, 316 Censure first.
                # SHAPER FIRST. Mana check before every cast (30 reserve).
                stand() if !standing?
                change_stance('guarded')
                spellactive()
                can = proc { |n| Spell[n].known? && Spell[n].affordable? && checkmana - Spell[n].mana_cost >= 30 }
                # docs/spell-study/PLAYBOOK-Tollwick-cleric.md rotation B (capped cleric, 10/17 after wipe #2):
                # 217 Mass Interference (auto-success, every 60 s) -> 316 Censure -> CAST 335 Divine Wrath at 3+
                # -> 309 Condemn -> Bane 302 / 317 finish. Panic: 140 Wall of Force self (+100 DS), INFUSE SPIRIT at 3+.
                if Char.level.to_i >= 100
                    # Billy 10/17, shown at the window vs a 7-8 mob: SPAM 302 BANE every RT, ONE target at a time
                    # (priority first), it lands (CS 517 vs TD ~438) and the plasma crits STUN. 140 Wall of Force on
                    # the groupmate the mob turns on. Every extra spell is a beat without Bane.
                    cc_cast(316) if room_control? && Time.now.to_f - ($a2_316 || 0) > 30 && ($a2_316 = Time.now.to_f)
                    mate = GameObj.pcs.to_a.find { |p| friendlist.include?(p.noun) && p.status.to_s =~ /stun|prone|lying|sitting|kneel|web/ }
                    if mate && can.call(140) && Time.now.to_f - ($a2_140[mate.noun] || 0) > 270
                        waitcastrt?; Spell[140].cast(mate.noun); waitcastrt?; $a2_140[mate.noun] = Time.now.to_f
                    end
                    (waitcastrt?; Spell[140].cast; waitcastrt?) if percenthealth < 50 && can.call(140) && !Spell[140].active?
                    # Billy 10/17: "I used 302/309/316/319" -- 319 Soul Ward kept up, 309 Condemn once per NEW target, then Bane spam
                    (waitcastrt?; Spell[319].cast; waitcastrt?) if Spell[319].known? && !Spell[319].active? && can.call(319)
                    $a2_condemned ||= []
                    t1 = get_target().first
                    # + 317 Divine Fury (Billy 10/17): bonus damage vs STUNNED -- Bane's plasma crits set it up
                    # Billy 10/17: "what matters is spell rotation and using 240/302 for LARGE groups" -- 240 Spirit
                    # Slayer (30 s, no cast RT, +25 CS, free recasts on single-target spells), then Bane spam.
                    big = get_target().length >= 3
                    (waitcastrt?; Spell[240].cast; waitcastrt?) if big && Spell[240].known? && !Spell[240].active? && can.call(240)
                    seq = if big then [302]
                          elsif t1 && !$a2_condemned.include?(t1.id) then [309, 302]
                          elsif t1 && t1.status.to_s =~ /stun/ then [317]
                          else [302] end
                    $a2_condemned << t1.id if t1 && seq.first == 309
                    $a2_condemned.shift while $a2_condemned.length > 30
                else
                    cc_cast(316) if room_control?                 # Billy 10/16: censure the room at 2+ / any steed
                    seq = [309, 302]                              # Billy 10/15: 309 start, 302 follow-up
                    seq << 319 if get_target().length > 1         # 319 only if more join
                end
                seq.each { |n|
                    live = get_target()
                    tgt = live.first                              # get_target is priority-sorted (steeds/shapers first)
                    break unless tgt
                    next unless can.call(n)
                    waitcastrt?
                    Spell[n].cast("##{tgt.id}")
                    waitcastrt?
                }
                change_stance('guarded')
                get_loot()
        elsif Char.prof =~ /Monk/
                #spellactive()
                stand() if !standing?
                change_stance('offensive')
                    if moblist.length >= 3
                        Script.run "combo"
                        fput "jab"
                        waitcastrt?
                        change_stance('defensive')
                        #get_loot()                     
                    elsif moblist.length >= 1 && moblist.length < 3
                        Script.run "combo"
                        fput "jab"
                        waitcastrt?
                        change_stance('defensive')
                        #get_loot() 
                    end
        elsif Char.prof =~ /Empath/ && Vars['support_only'].to_s =~ /yes|on|true/i
                # support empath (Faellin with the littles): NO damage spells, the girls get the kills;
                # healing + stuns stay with pixieheal
                stand() if !standing?
                change_stance('guarded')
        elsif Char.prof =~ /Empath/
                stand() if !standing?
                change_stance('guarded')
                    if moblist.length >= 3
                        Spell[1115].cast if Spell[1115].affordable?
                        waitcastrt?
                        change_stance('guarded')
                        get_loot()
                    elsif moblist.length >= 1 && moblist.length < 3
                        Spell[1106].cast if Spell[1106].affordable?
                        waitcastrt?
                        change_stance('guarded')
                        get_loot()
                    end
        elsif Char.prof =~ /Warrior/
                stand() if !standing?
                change_stance('offensive')
                    if moblist.length >= 3
                        twin = dothistimeout "mstrike target",3, /you swing/ if Char.stamina <= 50
                            if twin !~ /you swing/
                                fput "mstrike target"
                                waitcastrt?
                            end
                        change_stance('defensive')                      
                    elsif moblist.length >= 1 && moblist.length < 3
                        fput "attack"
                        waitcastrt?
                        change_stance('defensive')
                    end
        elsif Char.prof =~ /Bard/
                # Billy 10/16: matched a target -> KILL it. Inside the loop, every pass:
                # shield? drop it -> standing? -> mana -> stamina -> lance out (INCANT 1012 lance) -> attack -> wait RT -> loop
                while (tgt = get_target().first)
                    # 10/16: Marchelle died fighting ALONE after the group moved rooms -- every pass, is my leader still
                    # here? If not, stop fighting and go to him (group_check walks to the leader's room and rejoins).
                    lead = ((File.read(File.join($data_dir.to_s, 'hunt_groups.txt')).lines rescue []).map { |l| l.split(':', 2) }
                             .find { |ld, mem| mem.to_s.split.include?(Char.name) } || [nil])[0].to_s.strip
                    if !lead.empty? && !GameObj.pcs.to_a.map(&:noun).include?(lead)
                        group_check()
                        break
                    end
                    fput "drop ##{GameObj.left_hand.id}" if GameObj.left_hand.name.to_s =~ /shield|buckler|aegis|targe/i
                    stand() if !standing?
                    spellactive()                                   # mana check + songs that dropped
                    if checkstamina < 15 then sleep 2; next end     # stamina check
                    unless GameObj.right_hand.name.to_s =~ /lance/i
                        if Spell[1012].affordable?
                            fput 'incant 1012 lance'
                            waitcastrt?
                        else
                            fput 'wink Arlend' if !$a2_winked || Time.now.to_f - $a2_winked > 30
                            $a2_winked = Time.now.to_f
                            sleep 3
                            next
                        end
                    end
                    (fput 'incant 1005'; waitcastrt?) if room_control? && Spell[1005].known? && Spell[1005].affordable?   # Billy 10/16: Lullabye the room
                    tgt = get_target().first || tgt
                    change_stance('offensive')
                    dothistimeout("attack ##{tgt.id}", 4, /Roundtime|roundtime|What were you|You can't|wait/i)
                    sleep 0.3
                    waitrt?
                    break if dead?
                end
                change_stance('guarded')
                get_loot()
        elsif Char.prof =~ /Wizard/ && Vars['support_only'].to_s =~ /yes|on|true/i
                # support wizard (Arlend with the littles): knock the room down with 410, ZERO kills
                stand() if !standing?
                if room_control? && Spell[410].affordable? && checkmana - Spell[410].mana_cost >= 60
                    waitcastrt?
                    fput 'stance offensive'
                    Spell[410].cast
                    fput 'stance guarded'
                    waitcastrt?
                end
        elsif Char.prof =~ /Wizard/
                # Billy 10/15: 904 is the GO-TO; 917 opens on 3+; 510 fallback; 516 leech below 60% mana.
                # STANCE DANCE (Billy 10/15): offensive ONLY for the cast, straight back to guarded.
                stand() if !standing?
                spellactive()
                can = proc { |n| Spell[n].known? && Spell[n].affordable? && checkmana - Spell[n].mana_cost >= 30 }
                dance = proc { |n|
                    waitrt?; waitcastrt?
                    fput 'stance offensive' unless checkstance =~ /offensive/
                    Spell[n].cast
                    fput 'stance guarded'
                    waitcastrt?
                }
                dance.call(516) if checkmana < (maxmana * 0.6) && can.call(516)
                dance.call(410) if room_control? && can.call(410)        # Billy 10/16: 2+ or a steed = 410 (NOT 435: it makes them swarm)
                if can.call(904)
                    dance.call(904)
                elsif can.call(510)
                    dance.call(510)
                end
                change_stance('guarded')
                get_loot()
        elsif Char.prof =~ /Paladin/
                stand() if !standing?
                #spellactive()
                change_stance('offensive')
                if moblist.length >= 3
                    Spell[1630].cast if Spell[1630].affordable? && !Spell[1630].active?
                    waitcastrt?
                    fput "attack"
                    waitcastrt?
                    change_stance('guarded')
                elsif moblist.length >= 1 && moblist.length < 2
                    fput "mstrike"
                    waitcastrt?
                    change_stance('guarded')
                elsif moblist.length >= 1 && moblist.length < 2
                    Spell[1602].cast if Spell[1602].affordable? && !Spell[1602].active?
                    waitcastrt?
                    fput "attack"
                    waitcastrt?
                    change_stance('guarded')
                end
        elsif Char.prof =~ /Rogue/
                stand() if !standing?
                #spellactive()
                change_stance('offensive')
                if moblist.length >= 5
                    fput "shield throw"
                    waitcastrt?
                    fput "pin down"
                    waitcastrt?
                    fput "mstrike target" if checkstamina > 50
                    waitcastrt?
                    Spell[117].cast if Spell[117].affordable? && !Spell[117].active?
                    fput "cock cross"
                    waitcastrt?
                    fput "fire"
                    waitcastrt?
                    change_stance('guarded')
                    #get_loot()
                elsif moblist.length >= 1 && moblist.length < 5
                    Spell[117].cast if Spell[117].affordable? && !Spell[117].active?
                    fput "cock cross"
                    waitcastrt?
                    fput "fire"
                    waitcastrt?
                    change_stance('guarded')
                    #get_loot()
                end
        elsif Char.prof =~ /Ranger/
                # Billy 10/16: Tangleweed the room; the bow work (aimed shots) is dihyakill via the camp
                stand() if !standing?
                pri = awake_foes.first
                cc_cast(610, pri) if room_control? && pri
                change_stance('guarded')
        elsif Char.prof =~ /Sorcerer/
                stand() if !standing?
                spellactive()
                change_stance('guarded')
                # Billy 10/17: "sorc was using one spell, occasionally grasp" -> PLAYBOOK-Llaan rotation, all <= level 20
                # (Sanctum rule): 709 Grasp kept up at 2+/priority; casters (shaper...) get 719; each new target gets
                # 715 set-up once; then 705 as the main nuke (701 fallback). Every cast TARGETED by id.
                sc = proc { |n, t|
                    ok = Spell[n] && Spell[n].known? && Spell[n].affordable? && checkmana - Spell[n].mana_cost >= 20
                    if ok
                        waitrt?; waitcastrt?
                        t ? Spell[n].cast("##{t.id}") : Spell[n].cast
                        waitcastrt?
                    end
                    ok
                }
                sc.call(709, nil) if room_control? && !Spell[709].active?
                $a2_715 ||= []
                t = get_target().first
                if t
                    done = false
                    done = sc.call(719, t) if t.name.to_s =~ /shaper|sorcer|wizard|shaman|priest|cleric|witch|mage/i
                    if !done && !$a2_715.include?(t.id)
                        $a2_715 << t.id; $a2_715.shift while $a2_715.length > 30
                        done = sc.call(715, t)
                    end
                    done = sc.call(705, t) unless done
                    sc.call(701, t) unless done
                end
                change_stance('guarded')
                get_loot()
    end

end
end
end